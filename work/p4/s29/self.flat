emit_scaled_reg bs i2 v dp:
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    if v > 0
        rx: rx + 4
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + (v + 3) * 8 + nd * 64
    emit(m)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
emit_store_abs bs vr imm:
    rx: 72
    if bs > 0
        rx: rx + 1
    if vr > 0
        rx: rx + 4
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        emit(nd * 64 + (vr + 3) * 8 + 4)
        emit(36)
    if not
        emit(nd * 64 + (vr + 3) * 8 + bs + 3)
    if nd is 1
        emit(imm)
    if nd is 2
        emit4(imm)
emit_store_abs_rax bs imm:
    rx: 72
