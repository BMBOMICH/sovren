word_id s:
    if s is wid_last_s
        return wid_last_r
    if wid_buf is 0
        wid_buf: _sov_heap_alloc(64)
    i: 0
    h: 5381
    go: 1
    as long as go is 1
        if i is 63
            go: 0
        if not
            b: peek_byte(s, i)
            if b < 33
                go: 0
            if not
                dummy: poke_byte(wid_buf, i, b)
                h: h * 33 + b
                i: i + 1
    dummy: poke_byte(wid_buf, i, 0)
    r: intern_kid_h(wid_buf, h, i)
    wid_last_s: s
    wid_last_r: r
    return r


nt_plant p n:
    i: 0
    as long as i < n
        emit(peek_byte(p, i))
        i: i + 1
    leave()
    ret()
    return 1


