strip_span t:
    # transient strip for line buffers: when only leading spaces need
    # trimming (the common shape), return t+indent into the same
    # NUL-terminated line instead of allocating a trimmed copy.
    # Result is read-only and lives exactly as long as the line.
    if t is 0
        return blank
    a: 0
    as long as peek_byte(t, a) is 32
        a: a + 1
    if peek_byte(t, a) is 9
        return strip(t)
    s: t + a
    n: length(s)
    if n is 0
        return s
    if peek_byte(s, n - 1) < 33
        return strip(t)
    return s
sub_into dest src:
    sd: reg_slot(src)
    if sd > 0 - 1
        dd: reg_slot(dest)
        if dd > 0 - 1
            cflush(dest)
            cflush(src)
            emit_addsub_slot(dd, sd, 1)
            return
    loadv(src)
    sl: lsh_find_s(dest)
    if sl is 0
        emit(72)
        emit(41)
        emit(195)
        return
    if sl is 1
        emit(73)
        emit(41)
        emit(196)
        return
    if sl is 2
        emit(73)
        emit(41)
        emit(197)
        return
    if sl is 3
        emit(73)
        emit(41)
        emit(198)
        return
    if sl is 4
        emit(73)
        emit(41)
        emit(199)
        return
    mov_rcx_rax()
    loadv(dest)
    sub_rax_rcx()
    storev(dest)
sub_rax_rcx:
    emit(72)
    emit(41)
    emit(200)
sub_rax_reg sl:
    emit(op_rex_r(sl))
    emit(41)
    emit(192 + op_low3(sl) * 8)
sub_rax_slot sl:
    if sl is 0
        emit(72)
        emit(41)
        emit(195)
        return 0
    if sl is 1
        emit(73)
        emit(41)
        emit(196)
        return 0
    if sl is 2
        emit(73)
        emit(41)
        emit(197)
        return 0
    if sl is 3
        emit(73)
        emit(41)
        emit(198)
        return 0
    if sl is 4
        emit(73)
        emit(41)
        emit(199)
        return 0
    return 0 - 1
swap_op op:
    oid: intern_kid(op)
    if oid is kid_oplt
        return "gt"
    if oid is kid_opgt
        return "lt"
    if oid is kid_ople
        return "ge"
    if oid is kid_opge
        return "le"
    return op
take_use name alias:
    mark: join(" ", join(name, " "))
    if look(used_libs, mark) > 0 - 1
        return blank
    used_libs: join(used_libs, mark)
    chunk: use_one(name)
    if chunk is 0
        print "Error: cannot read library"
        _sov_print(name)
        err_where()
        had_err: 1
        return blank
    if length(alias) > 0
        alias_pairs: join(alias_pairs, join("|", alias))
        chunk: alias_chunk(chunk, alias)
    return chunk

first_wid s:
    # skip leading whitespace, then return word_id at that position
    wgo: 1
    as long as wgo is 1
        wb: peek_byte(s, 0)
        if wb < 33
            if wb is 0
                return 0
            s: s + 1
        if not
            wgo: 0
    return word_id(s)

word_id_at s o:
    wgo: 1
    as long as wgo is 1
        wb: peek_byte(s, o)
        if wb < 33
            if wb is 0
                return 0
            o: o + 1
        if not
            wgo: 0
    return word_id(s + o)
wordchar b:
    if b is 95
        return 1
    if b > 47
        if b < 58
            return 1
    if b > 64
        if b < 91
            return 1
    if b > 96
        if b < 123
            return 1
ren_word old nw text:
    out: blank
    i: 0
    n: length(text)
    q: 0
    ol: length(old)
    as long as i < n
        d: 0
        b: peek_byte(text, i)
        if q is 1
            out: join(out, letter(text, i))
            if b is 34
                q: 0
            d: 1
        if q is 2
            out: join(out, letter(text, i))
            if b is 96
                q: 0
            d: 1
        if d is 0
            if b is 34
                q: 1
                out: join(out, letter(text, i))
                i: i + 1
                d: 1
            if d is 0
                if b is 96
                    q: 2
                    out: join(out, letter(text, i))
                    i: i + 1
                    d: 1
        if d is 0
            pb: 32
            if i > 0
                pb: peek_byte(text, i - 1)
            if wordchar(pb) is 0
                m: 0
                if i + ol <= n
                    if sg_match(text, i, old) is 1
                        ab: 32
                        if i + ol < n
                            ab: peek_byte(text, i + ol)
                        if wordchar(ab) is 0
                            m: 1
                if m is 1
                    out: join(out, nw)
                    i: i + ol
                    d: 1
        if d is 0
            out: join(out, letter(text, i))
            i: i + 1
    return out
topdefs t:
    lst: _sov_list_new()
    lns: lines_of(t)
    i: 0
    n: _sov_list_len(lns)
    as long as i < n
        l: _sov_list_get(lns, i)
        if length(l) > 0
            b0: peek_byte(l, 0)
            if b0 is not 35
                if b0 is not 32
                    if b0 is not 9
                        j: 0
                        w: blank
                        td_ln: length(l)
                        as long as j < td_ln
                            if wordchar(peek_byte(l, j)) is 1
                                w: join(w, letter(l, j))
                                j: j + 1
                            if wordchar(peek_byte(l, j)) is 0
                                j: td_ln
                        cpos: look(l, ":")
                        if cpos > 0
                            if length(w) > 0
                                lst: _sov_list_add(lst, w)
        i: i + 1
    return lst
alias_chunk chunk alias:
    ac_names: topdefs(chunk)
    i: 0
    n: _sov_list_len(ac_names)
    as long as i < n
        nm: _sov_list_get(ac_names, i)
        chunk: ren_word(nm, join(alias, join("__", nm)), chunk)
        i: i + 1
    return chunk
lines_join lst:
    total: 0
    i: 0
    n: _sov_list_len(lst)
    as long as i < n
        total: total + length(_sov_list_get(lst, i)) + 1
        i: i + 1
    buf: _sov_heap_alloc(total + 1)
    pos: 0
    i: 0
    as long as i < n
        ln: _sov_list_get(lst, i)
        k: 0
        lnlen: length(ln)
        as long as k < lnlen
            dset: _sov_set_byte(buf, pos, peek_byte(ln, k))
            pos: pos + 1
            k: k + 1
        dset: _sov_set_byte(buf, pos, 10)
        pos: pos + 1
        i: i + 1
    dset: _sov_set_byte(buf, pos, 0)
    return buf
qualify text alias:
    lns: lines_of(text)
    n: _sov_list_len(lns)
    bt: 0
    acc: _sov_list_new()
    i: 0
    as long as i < n
        ln: _sov_list_get(lns, i)
        m: length(ln)
        al: length(alias)
        res: blank
        j: 0
        q: 0
        as long as j < m
            d: 0
            b: peek_byte(ln, j)
            if bt is 1
                if b is 96
                    bt: 0
                res: join(res, letter(ln, j))
                j: j + 1
                d: 1
            if d is 0
                if b is 96
                    bt: 1
                    res: join(res, letter(ln, j))
                    j: j + 1
                    d: 1
                if d is 0
                    if q is 1
                        if b is 34
                            q: 0
                        res: join(res, letter(ln, j))
                        j: j + 1
                        d: 1
                    if d is 0
                        if b is 34
                            q: 1
                            res: join(res, letter(ln, j))
                            j: j + 1
                            d: 1
            if d is 0
                pb: 32
                if j > 0
                    pb: peek_byte(ln, j - 1)
                if wordchar(pb) is 0
                    m2: 0
                    if j + al + 1 < m
                        if sg_match(ln, j, alias) is 1
                            if peek_byte(ln, j + al) is 46
                                if wordchar(peek_byte(ln, j + al + 1)) is 1
                                    m2: 1
                    if m2 is 1
                        k: j + al + 1
                        w: blank
                        e: k
                        as long as k < m
                            if wordchar(peek_byte(ln, k)) is 1
                                w: join(w, letter(ln, k))
                                k: k + 1
                                e: k
                            if wordchar(peek_byte(ln, k)) is 0
                                k: m
                        res: join(res, join(alias, join("__", w)))
                        j: e
                        d: 1
            if d is 0
                res: join(res, letter(ln, j))
                j: j + 1
        acc: _sov_list_add(acc, res)
        i: i + 1
    return lines_join(acc)
apply_aliases src:
    if length(alias_pairs) is 0
        return src
    i: 0
    n: length(alias_pairs)
    cur: blank
    as long as i < n
        if peek_byte(alias_pairs, i) is 124 is 1
            if length(cur) > 0
                src: qualify(src, cur)
                cur: blank
        if not
            cur: join(cur, letter(alias_pairs, i))
        i: i + 1
    if length(cur) > 0
        src: qualify(src, cur)
    return src
test_rax:
    emit(72)
    emit(133)
    emit(192)
thread_tail st:
    wi: 0
    wi_ln: _sov_list_len(sk_pos)
    as long as wi < wi_ln
        wp: peek_i64(sk_pos, 16 + wi * 8)
        if _sov_list_get(sk_to, wi) is here()
            if wp > st
                if ocget(wp - 1) is 233
                    put(wp, st - (wp + 4))
        wi: wi + 1
    sk_pos: _sov_list_new()
    sk_to: _sov_list_new()
tidy_path s:
    r: unquote(s)
    n: length(r)
    if n > 2
        if peek_byte(r, 1) is 58
            r: cut(r, 2, n)
            n: n - 2
    o: _sov_heap_alloc(n + 1)
    i: 0
    as long as i < n
        b: peek_byte(r, i)
        if b is 92
            b: 47
        dummy: poke_byte(o, i, b)
        i: i + 1
    dummy: poke_byte(o, n, 0)
    return as text o
tname line:
    s: strip(line)
    if is_task_hdr(s) is 1
        s: scut(s, 0, length(s) - 1)
        if _sov_starts_with(s, "task ") is 1
            s: scutr(s, 5)
        wp: look(s, " with ")
        if wp > 0 - 1
            return repl(scut(s, 0, wp), " ", "_")
        sp: look(s, " ")
        if sp > 0 - 1
            return scut(s, 0, sp)
        return s
    rest: scutr(line, 5)
    wp: look(rest, " with ")
    if wp > 0 - 1
        return repl(scut(rest, 0, wp), " ", "_")
    sp: look(rest, " ")
    if sp > 0 - 1
        return repl(scut(rest, 0, sp), " ", "_")
    return repl(rest, " ", "_")
try_count_while cond blines lines li:
    if _sov_list_len(blines) is not 3
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(scut(c0, 0, p), " ", "_")
    lim0: scutr(c0, p + 3)
    lim: repl(lim0, " ", "_")
    if plain_name(iv) is 0
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    l3: strip(_sov_list_get(blines, 2))
    inc_r: join(iv, ": ")
    inc_b: join(iv, " + 1")
    if _sov_str_eq(l3, join(inc_r, inc_b)) is 0
        return 0
    if _sov_starts_with(l1, "if peek_byte(") is 0
        return 0
    if sg_match(l1, length(l1) - 6, ") is 1") is 0
        return 0
    inn: cut(l1, 13, length(l1) - 6)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    base: repl(scut(inn, 0, c1), " ", "_")
    idx2: repl(scutr(inn, c1 + 1), " ", "_")
    if _sov_str_eq(idx2, iv) is 0
        return 0
    if plain_name(base) is 0
        return 0
    tc2: look(l2, ": ")
    if tc2 < 0
        return 0
    cn: repl(scut(l2, 0, tc2), " ", "_")
    if _sov_str_eq(l2, join(cn, join(": ", join(cn, " + 1")))) is 0
        return 0
    if plain_name(cn) is 0
        return 0
    jj: li - 1
    as long as jj >= 0
        pl: strip(_sov_list_get(lines, jj))
        if length(pl) > 0
            if peek_byte(pl, 0) is not 35
                if _sov_str_eq(pl, join(iv, ": 0")) is 0
                    return 0
                jj: jj - 1
                as long as jj >= 0
                    pl2: strip(_sov_list_get(lines, jj))
                    if length(pl2) > 0
                        if peek_byte(pl2, 0) is not 35
                            if _sov_str_eq(pl2, join(cn, ": 0")) is 0
                                return 0
                            jj: 0 - 1
                jj: 0 - 2
        jj: jj - 1
    cflush_all()
    loadv(base)
    mov_rdi_rax()
    if is_imm(lim) is 1
        rax_imm(num_of(lim))
    if not
        expr(lim0)
    mov_rsi_rax()
    chk_mem(1)
    lv: 0
    if is_imm(lim) is 1
        lv: num_of(lim)
    if lv is 0
        lv: lim_source_const(lines, li, lim)
    sse: 0
    if lv > 15
        if lv % 16 is 0
            sse: 1
    if sse is 1
        rax_imm(72340172838076673)
        emit(102)
        emit(72)
        emit(15)
        emit(110)
        emit(200)
        emit(102)
        emit(15)
        emit(108)
        emit(201)
        emit(102)
        emit(15)
        emit(239)
        emit(237)
        emit(102)
        emit(15)
        emit(239)
        emit(255)
        emit(72)
        emit(137)
        emit(241)
        align32()
        st3: here()
        emit(243)
        emit(15)
        emit(111)
        emit(7)
        emit(102)
        emit(15)
        emit(116)
        emit(193)
        emit(102)
        emit(15)
        emit(246)
        emit(197)
        emit(102)
        emit(15)
        emit(212)
        emit(248)
        emit(72)
        emit(131)
        emit(199)
        emit(16)
        emit(72)
        emit(131)
        emit(233)
        emit(16)
        jb3: jne()
        put(jb3, st3 - (jb3 + 4))
        if jb3 < 0
            print "PN2475"
        emit(102)
        emit(72)
        emit(15)
        emit(126)
        emit(250)
        emit(102)
        emit(15)
        emit(112)
        emit(255)
        emit(14)
        emit(102)
        emit(72)
        emit(15)
        emit(126)
        emit(249)
        emit(72)
        emit(1)
        emit(202)
        emit(72)
        emit(137)
        emit(208)
        emit(72)
        emit(199)
        emit(193)
        emit(255)
        emit(0)
        emit(0)
        emit(0)
        emit(49)
        emit(210)
        emit(72)
        emit(247)
        emit(241)
    if not
        emit(72)
        emit(137)
        emit(241)
        xor_rax()
        align32()
        stc2: here()
        emit(128)
        emit(63)
        emit(1)
        emit(15)
        emit(148)
        emit(194)
        emit(15)
        emit(182)
        emit(210)
        emit(72)
        emit(1)
        emit(208)
        emit(72)
        emit(131)
        emit(199)
