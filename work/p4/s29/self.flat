align32:
    # pad with NOPs so here() is 32-byte aligned (here() is congruent
    # to the virtual address mod 32: the first LOAD maps file offset
    # 0 to 0x400000). Call sites sit right after a forward jmp or at
    # fall-through loop entries, so the padding is never on a hot path.
    a32_h: here()
    a32_r: a32_h % 32
    if a32_r is not 0
        a32_n: 32 - a32_r
        a32_i: 0
        as long as a32_i < a32_n
            emit(144)
            a32_i: a32_i + 1
    return 0
emit_fib_iter:
