use_one name:
    tail: join(name, ".sov")
    path: join("library/", tail)
    r: load_file(path)
    if r is not 0
        return splice_inc(r, "library/")
    path: join(self_dir, join("/library/", tail))
    r: load_file(path)
    if r is not 0
        return splice_inc(r, dir_of(path))
    path: join(dirname(self_dir), join("/library/", tail))
    r: load_file(path)
    if r is not 0
        return splice_inc(r, dir_of(path))
    path: join(dirname(dirname(self_dir)), join("/library/", tail))
    r: load_file(path)
    if r is not 0
        return splice_inc(r, dir_of(path))
    return r
