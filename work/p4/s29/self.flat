# bin_mem_ok/bin_memop: `rax <op> name` where name is a plain variable that
# lives in memory (a frame slot past the register homes, or a global) is a
# single instruction (add/sub/imul/and/or/xor/cmp rax,[mem]) instead of the
# old push rax / evaluate / mov rcx,rax / pop rax / op detour.  The predicate
# is side-effect free so callers can decide before emitting any code.
bin_mem_ok_k oid name:
    if bin_rslot(name) > 0 - 1
