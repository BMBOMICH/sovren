emit_nt_sp_inc:
    # native twin of sp_hinc_lim (cx86_p7): rdi=text, rsi=lim (=
    # length(text), so bytes [0,lim) are NUL-free and in-bounds) ->
    # rax 1 iff some line starts (after indent 32/9/13) with `include `.
    # SWAR 8-byte newline skip between line starts; the include test is
    # one qword compare against "include ". All loads stay inside
    # [0,lim). Volatile-only leaf; assembled+diff-verified in
    # scripts/swar_twins.s (550k randomized differential cases).
    emit:
        72 186 10 10 10 10 10 10 10 10 73 184 1 1 1 1
        1 1 1 1 73 185 128 128 128 128 128 128 128 128 76 141
        20 55 73 137 251 77 57 211 115 122 65 15 182 3 60 32
        116 10 60 9 116 6 60 13 116 2 235 5 73 255 195 235
        228 73 141 67 8 76 57 208 119 18 73 139 3 72 185 105
        110 99 108 117 100 101 32 72 57 200 116 76 73 141 67 8
        76 57 208 119 45 73 139 3 72 49 208 72 137 193 76 41
        193 72 247 208 72 33 193 76 33 201 116 16 72 15 188 201
        72 193 233 3 73 1 203 73 255 195 235 153 73 131 195 8
        235 202 77 57 211 115 13 65 15 182 3 73 255 195 60 10
        117 240 235 129 49 192 235 5 184 1 0 0 0
    leave()
    ret()
    return 1

