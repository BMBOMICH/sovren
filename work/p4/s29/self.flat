    emit(77)
    emit(139)
    emit(72)
    emit(8)
    emit3(73, 139, 48)
    emit2(65, 90)
    emit2(65, 91)
    patch(anxt)
    emit3(73, 255, 195)
    emit3(77, 57, 211)
    emit(15)
    emit(140)
    abk: here()
