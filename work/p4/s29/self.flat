fast_ret line:
    if dbg_mode is 1
        return 0
    i: 0
    as long as peek_byte(line, i) is 32
        i: i + 1
    if peek_byte(line, i) is not 114
        return 0
    if peek_byte(line, i + 1) is not 101
        return 0
    if peek_byte(line, i + 2) is not 116
        return 0
    if peek_byte(line, i + 3) is not 117
        return 0
    if peek_byte(line, i + 4) is not 114
        return 0
    if peek_byte(line, i + 5) is not 110
        return 0
    if peek_byte(line, i + 6) is not 32
        return 0
    return fast_ret_do(line, i)
fast_ret_do line i:
    ln: length(line)
    if ln - i < 8
        return 0
    if peek_byte(line, ln - 1) is 32
        return 0
    if peek_byte(line, ln - 1) is 9
        return 0
    if peek_byte(line, ln - 1) is 13
        return 0
    j: i + 7
    k: j
    seen: 0
    prev: 32
    as long as k < ln
        b: peek_byte(line, k)
        if b is not 32
            seen: 1
        if b is 34
            return 0
        if b is 35
            return 0
        if b is 39
            return 0
        if b is 58
            return 0
        if b is 59
            return 0
        if b is 92
            return 0
        if b is 9
            return 0
        if b is 13
            return 0
        if b < 32
            return 0
        if b > 126
            return 0
        if b is 61
            if prev is 43
                return 0
            if prev is 45
                return 0
            if prev is 42
                return 0
            if prev is 47
                return 0
            if prev is 38
                return 0
            if prev is 124
                return 0
            if prev is 94
                return 0
        prev: b
        k: k + 1
    if seen is 0
        return 0
    typ: 0
    if syntax_mode is 1 and line is syntax_stmt_line and syntax_stmt_role is 4 and syntax_stmt_tree is not 0
        typ: syntax_stmt_lower(syntax_stmt_tree)
    if not
        ex: cut(line, j, ln)
        typ: expr(ex)
    if typ is 1
        saw_str: 1
    if in_entry_now is 1
        if sxe_mode is 1
            leave()
            ret()
    if in_entry_now is 1
        if sxe_mode is not 1
            emit3(72, 137, 199)
            emit_sys_num(60)
            emit_sys_do()
    if in_entry_now is 1
