emit_nt_lsh_add:
    # rbx is v.  fast path of lsh_add over the 1048576-slot table:
    # s is nhash(v) and 1048575 forward, ve is keys[s] at lh_tab,
    # ve2 is tags[1048576+s] (tag = lh_gen<<20 | idx+1).  Empty or
    # stale-generation slot inserts here (list_len/list_add calls);
    # a current-generation byte-equal name returns its idx.  lh_tab
    # unset or a full-table walk delegates to lsh_add_full, the
    # verbatim original body.  The shadow warnings in the original
    # sit behind nat_gate is 0 and this twin only fires under it.
    load_glob("lh_tab")
    emit(73)
    emit(137)
    emit(198)
