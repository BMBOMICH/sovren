emit_abi_call argc native:
    sy: argc
    if sy > 7
        sy: 7
    if sy > 6
        emit(65)
        emit(89)
    if sy > 5
        emit(65)
        emit(88)
    if sy > 4
        emit(89)
    if sy > 3
        emit(90)
    if sy > 2
        emit(94)
    if sy > 1
        emit(95)
    pop_rax()
    if argc > 4
        emit(65)
        emit(82)
        emit(73)
        emit(137)
        emit(202)
    if native is 1
        emit(205)
        emit(128)
    if not
        sysc()
    if argc > 4
        emit(65)
        emit(90)

ca_tab: 0
