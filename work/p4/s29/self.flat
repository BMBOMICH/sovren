op_low3 sl:
    return (sl + 3) % 8
op_rex_b sl:
    rx: 72
    if sl > 0
        rx: rx + 1
    return rx
op_rex_r sl:
    rx: 72
    if sl > 0
        rx: rx + 4
    return rx
parse_sq t:
    p: fop3(t)
    if p < 0
        return 0
    if peek_byte(t, p) is 42 is 0
        return 0
    l: scut(t, 0, p)
    r: scutr(t, p + 1)
    if fop3(l) > 0 - 1
        return 0
    if fop3(r) > 0 - 1
        return 0
    if _sov_str_eq(l, r) is 0
        return 0
    if plain_name(l) is 0
        return 0
    if is_imm(l) is 1
        return 0
    sq_name: l
    return 1
patch at:
    put(at, here() - (at + 4))
peek_home e:
    if sg_match(e, length(e) - 4, " * 8") is 0
        return 0 - 1
    head: scut(e, 0, length(e) - 4)
    if name_ok(head) is 0
        return 0 - 1
    return homereg(head)
peek_rax_h h:
    emit(rexx(h))
    emit2(139, 4)
    emit(sibx(h))
peek_reg_h d i:
    rx: 72
    if d > 7
        rx: rx + 4
    if i > 7
        rx: rx + 2
    emit(rx)
    emit(139)
    emit(4 + (d % 8) * 8)
    emit(sibx(i))
pf_movb o:
    emit(138)
    if o is 0
        emit(6)
    if not
        emit(70)
        emit(o)
    emit(136)
    if o is 0
        emit(7)
    if not
        emit(71)
        emit(o)
pf_movdqu o:
    emit3(243, 15, 111)
    if o is 0
        emit(6)
    if not
        if o < 128
            emit(70)
            emit(o)
        if not
            emit(134)
            emit4(o)
    emit3(243, 15, 127)
    if o is 0
        emit(7)
    if not
        if o < 128
            emit(71)
            emit(o)
        if not
            emit(135)
            emit4(o)
pkacc g x v:
    if _sov_starts_with(v, "peek_i64(") is 0
        return 0
    d: 1
    k: 9
    k2: 0 - 1
    pk_ln: length(v)
    as long as k < pk_ln
        b: peek_byte(v, k)
        if b is 40
            d: d + 1
        if b is 41
            d: d - 1
            if d is 0
                if k2 < 0
                    k2: k
        k: k + 1
    if k2 < 0
        return 0
    rest: scutr(v, k2 + 1)
    if peek_byte(rest, 0) is not 43
        return 0
    t2: scutr(rest, 1)
    if length(t2) is 0
        return 0
    inn: cut(v, 9, k2)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    g2: scut(inn, 0, c1)
    if _sov_str_eq(g2, g) is 0
        return 0
    x2: scutr(inn, c1 + 1)
    if _sov_str_eq(x2, x) is 0
        return 0
    pk_t: t2
    return 1
pkpeek t:
    if _sov_starts_with(t, "peek_i64(") is 0
        return 0
    if peek_byte(t, length(t) - 1) is 41 is 0
        return 0
    inn: cut(t, 9, length(t) - 1)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    g2: scut(inn, 0, c1)
    x2: scutr(inn, c1 + 1)
    if name_ok(g2) is 0
        return 0
    if scaled_shape(x2) is 0
        return 0
    pk_g: g2
    pk_x: x2
    return 1
pn_bad: 0
