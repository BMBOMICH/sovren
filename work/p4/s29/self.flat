        emit(72)
        emit(131)
        emit(233)
        emit(1)
        jb2: jne()
        put(jb2, stc2 - (jb2 + 4))
        if jb2 < 0
            print "PN2485"
    storev(cn)
    emit(72)
    emit(137)
    emit(240)
    storev(iv)
    return 1
try_tail_call line:
    # self tail-call: "return F(a, b, ...)" with F the current function.
    # arguments (imm/plain-name only, no side effects) are staged through
    # scratch registers into the parameter homes, then control jumps back
    # to the top of the body (tco_entry).  The frame, saved registers and
    # stack depth are untouched, so the eventual real return restores the
    # original caller's state.  Bail when a try/except frame is open (its
    # handler chain would leak), in canary mode, or in the entry function.
    if fw_on is 1
        return 0
    if in_entry_now is 1
        return 0
    if tco_entry is 0
        return 0
    tci9: 0
    as long as peek_byte(line, tci9) is 32
        tci9: tci9 + 1
    if peek_byte(line, tci9) is not 114
        return 0
    if peek_byte(line, tci9 + 1) is not 101
        return 0
    if peek_byte(line, tci9 + 2) is not 116
        return 0
    if peek_byte(line, tci9 + 3) is not 117
        return 0
    if peek_byte(line, tci9 + 4) is not 114
        return 0
    if peek_byte(line, tci9 + 5) is not 110
        return 0
    if peek_byte(line, tci9 + 6) is not 32
        return 0
    tcln: length(line)
    if peek_byte(line, tcln - 1) is not 41
        return 0
    tclp: cfind1(line, 40)
    if tclp < tci9 + 8
        return 0
    tcns: tci9 + 7
    as long as peek_byte(line, tcns) is 32
        tcns: tcns + 1
    tcne: tclp
    tcd9: 1
    as long as tcd9 is 1
        if tcne <= tcns
            tcd9: 0
        if tcd9 is 1
            if peek_byte(line, tcne - 1) is 32
                tcne: tcne - 1
            if not
                tcd9: 0
    tcnl: length(tco_nm)
    tcok: 0
    if tcne - tcns is tcnl
        tcok: 1
        tck9: 0
        as long as tck9 < tcnl
            tcb1: peek_byte(line, tcns + tck9)
            tcb2: peek_byte(tco_nm, tck9)
            if tcb1 is 32
                tcb1: 95
            if tcb2 is 32
                tcb2: 95
            if tcb1 is not tcb2
                tcok: 0
            tck9: tck9 + 1
    if tcok is 0
        return 0
    tca: split_args(cut(line, tclp + 1, tcln - 1), _sov_list_new())
    tcac: _sov_list_len(tca)
    tcpc: _sov_list_len(tco_ps)
    if tcac is not tcpc
        return 0
    if tcac > 4
        return 0
    if tcac is 0
        return 0
    tcai: 0
    as long as tcai < tcac
        tcag: repl(strip(peek_i64(tca, 16 + tcai * 8)), " ", "_")
        dummy: _sov_list_set(tca, tcai, tcag)
        if is_imm(tcag) is 0
            if plain_name(tcag) is 0
                return 0
        tcai: tcai + 1
    tcbi: 0
    as long as tcbi < _sov_list_len(bk)
        tckk: peek_i64(bk, 16 + tcbi * 8)
        if tckk is kid_try
            return 0
        if tckk is kid_except
            return 0
        tcbi: tcbi + 1
    cflush_all()
    tc_sc: 0

    tcai: 0
    as long as tcai < tcac
        tcag: peek_i64(tca, 16 + tcai * 8)
        tc_pn: repl(peek_i64(tco_ps, 16 + tcai * 8), " ", "_")
        tc_isparm: 0
        tc_pj: 0
        as long as tc_pj < tcpc
            if _sov_str_eq(tcag, repl(peek_i64(tco_ps, 16 + tc_pj * 8), " ", "_")) is 1
                tc_isparm: 1
            tc_pj: tc_pj + 1
        if tc_isparm is 1
            if _sov_str_eq(tcag, tc_pn) is 0
                loadv(tcag)
                if tc_sc is 0
                    emit3(73, 137, 194)
                if tc_sc is 1
                    emit3(73, 137, 195)
                if tc_sc is 2
                    emit3(72, 137, 193)
                if tc_sc is 3
                    emit3(72, 137, 198)
                dummy: _sov_list_set(tca, tcai, 0 - 100 - tc_sc)
                tc_sc: tc_sc + 1
        tcai: tcai + 1
    tcai: 0
    as long as tcai < tcac
        tcag: peek_i64(tca, 16 + tcai * 8)
        tc_pn: repl(peek_i64(tco_ps, 16 + tcai * 8), " ", "_")
        if tcag < 0
            tcsc2: 0 - 100 - tcag
            if tcsc2 is 0
                emit3(76, 137, 208)
            if tcsc2 is 1
                emit3(76, 137, 216)
            if tcsc2 is 2
                emit3(72, 137, 200)
            if tcsc2 is 3
                emit3(72, 137, 240)
            storev(tc_pn)
        if not
            if _sov_str_eq(tcag, tc_pn) is 0
                if is_imm(tcag) is 1
                    rax_imm(num_of(tcag))
                if not
                    loadv(tcag)
                storev(tc_pn)
        tcai: tcai + 1
    emit(233)
    tjb: here()
    emit4(0)
    put(tjb, tco_entry - (tjb + 4))
    return 1

fdx_idxoff s want:
    # constant offset in an `iv * 8`-shaped index (spaces already mapped
    # to _), or -1 when the shape is anything else.
    if _sov_str_eq(s, want) is 1 -> return 0
    p: look(s, "_+_")
    if p < 0 -> return 0 - 1
    lf: cut(s, 0, p)
    rt: cut(s, p + 3, length(s))
    if _sov_str_eq(rt, want) is 1
        if is_imm(lf) is 1 -> return num_of(lf)
    if _sov_str_eq(lf, want) is 1
        if is_imm(rt) is 1 -> return num_of(rt)
    return 0 - 1

try_fp_dot cond blines lines li:
    # bit-exact FP reduction loop: iv from 0 while iv < lim with body
    #   S: f64_add(S, f64_mul(peek_i64(A, iv * 8), peek_i64(B, iv * 8)))
    #   iv: iv + 1
    # accumulator lives in xmm2, pointers r8/r9, counter r11, bound r10.
    if has_vm is 0
        return 0
    if leaf8 is 1
        return 0
    if _sov_list_len(blines) is not 2
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(scut(c0, 0, p), " ", "_")
    lim0: scutr(c0, p + 3)
    lim: repl(lim0, " ", "_")
    if plain_name(iv) is 0
        return 0
    ivsl: lsh_find_s(iv)
    if ivsl < 0
        return 0
    limn: 0
    if is_imm(lim) is 0
        if plain_name(lim) is 0
            return 0
        limn: 1
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    if _sov_str_eq(l2, join(iv, join(": ", join(iv, " + 1")))) is 0
        return 0
    tc: look(l1, ": ")
    if tc < 1
        return 0
    snm: repl(scut(l1, 0, tc), " ", "_")
    if plain_name(snm) is 0
        return 0
    rhs: scutr(l1, tc + 2)
    if _sov_starts_with(rhs, "f64_add(") is 0
        return 0
    if peek_byte(rhs, length(rhs) - 1) is not 41
        return 0
    al: split_args(cut(rhs, 8, length(rhs) - 1), _sov_list_new())
    if _sov_list_len(al) is not 2
        return 0
    g0: repl(strip(peek_i64(al, 16)), " ", "_")
    g1: repl(strip(peek_i64(al, 24)), " ", "_")
    mm: blank
    if _sov_str_eq(g0, snm) is 1
        mm: strip(peek_i64(al, 24))
    if _sov_str_eq(g1, snm) is 1
        mm: strip(peek_i64(al, 16))
    if length(mm) < 10
        return 0
    if _sov_starts_with(mm, "f64_mul(") is 0
        return 0
    if peek_byte(mm, length(mm) - 1) is not 41
        return 0
    ml: split_args(cut(mm, 8, length(mm) - 1), _sov_list_new())
    if _sov_list_len(ml) is not 2
        return 0
    pka: strip(peek_i64(ml, 16))
    pkb: strip(peek_i64(ml, 24))
    if _sov_starts_with(pka, "peek_i64(") is 0
        return 0
    if _sov_starts_with(pkb, "peek_i64(") is 0
        return 0
    ka: split_args(cut(pka, 9, length(pka) - 1), _sov_list_new())
    kb: split_args(cut(pkb, 9, length(pkb) - 1), _sov_list_new())
    if _sov_list_len(ka) is not 2
        return 0
    if _sov_list_len(kb) is not 2
        return 0
    anm: repl(strip(peek_i64(ka, 16)), " ", "_")
    bnm: repl(strip(peek_i64(kb, 16)), " ", "_")
    aidx: repl(strip(peek_i64(ka, 24)), " ", "_")
    bidx: repl(strip(peek_i64(kb, 24)), " ", "_")
    want_idx: join(iv, "_*_8")
    # index may carry a constant header offset (Sovren arrays keep data
    # at +16): accept `iv * 8`, `C + iv * 8`, `iv * 8 + C`; the offsets
    # fold into the base pointers once, outside the loop.
    fdx_ca: fdx_idxoff(aidx, want_idx)
    fdx_cb: fdx_idxoff(bidx, want_idx)
    if fdx_ca < 0
        return 0
    if fdx_cb < 0
        return 0
    if plain_name(anm) is 0
        return 0
    if plain_name(bnm) is 0
        return 0
    if _sov_str_eq(snm, iv) is 1
        return 0
    if _sov_str_eq(anm, iv) is 1
        return 0
    if _sov_str_eq(bnm, iv) is 1
        return 0
    if _sov_str_eq(snm, anm) is 1
        return 0
    if _sov_str_eq(snm, bnm) is 1
        return 0
    if limn is 1
        if _sov_str_eq(lim, snm) is 1
            return 0
        if _sov_str_eq(lim, iv) is 1
            return 0
        if _sov_str_eq(lim, anm) is 1
            return 0
        if _sov_str_eq(lim, bnm) is 1
            return 0
    wind: sg_ind(_sov_list_get(lines, li))
    jj: li - 1
    got0: 0
    seen: 0
    as long as jj >= 0
        if got0 is 0
            rw: _sov_list_get(lines, jj)
            pl: strip(rw)
            if length(pl) > 0
                if peek_byte(pl, 0) is not 35
                    if sg_ind(rw) is not wind
                        jj: 0 - 1
                    if not
                        seen: seen + 1
                        if seen > 4
                            jj: 0 - 1
                        if not
                            if _sov_str_eq(pl, join(iv, ": 0")) is 1
                                got0: 1
                            if not
                                if _sov_starts_with(pl, join(iv, ": ")) is 1
                                    jj: 0 - 1
        jj: jj - 1
    if got0 is 0
        return 0
    cflush_all()
    loadv(anm)
    emit3(73, 137, 192)
    if fdx_ca > 0
        emit3(73, 129, 192)
        emit4(fdx_ca)
    loadv(bnm)
    emit3(73, 137, 193)
    if fdx_cb > 0
        emit3(73, 129, 193)
        emit4(fdx_cb)
    loadv(snm)
    emit(102)
    emit(72)
    emit(15)
    emit(110)
    emit(208)
    if limn is 1
        loadv(lim)
    if not
        rax_imm(num_of(lim))
    emit3(73, 137, 194)
    emit3(77, 133, 210)
    fdx_dsk: jle()
    emit3(69, 49, 219)
    fdx_ok: 0 - 1
    if opt_fastfp is 1
        # --fast-fp: reassociate into 4 accumulator chains (xmm3/4/5 plus
        # xmm2 which starts from S); bits may differ from the ordered sum.
        emit(102)
        emit(15)
        emit(239)
        emit(219)
        emit(102)
        emit(15)
        emit(239)
        emit(228)
        emit(102)
        emit(15)
        emit(239)
        emit(237)
        emit3(76, 137, 210)
        emit(72)
        emit(131)
        emit(234)
        emit(3)
        align32()
        fdx_h4: here()
        fdx_k: 0
        as long as fdx_k < 4
            emit(242)
            emit(67)
            emit(15)
            emit(16)
            if fdx_k is 0
                emit(4)
                emit(216)
            if not
                emit(68)
                emit(216)
                emit(fdx_k * 8)
            emit(242)
            emit(67)
            emit(15)
            emit(89)
            if fdx_k is 0
                emit(4)
                emit(217)
            if not
                emit(68)
                emit(217)
                emit(fdx_k * 8)
            emit(242)
            emit(15)
            emit(88)
            if fdx_k is 0
                emit(216)
            if fdx_k is 1
                emit(224)
            if fdx_k is 2
                emit(232)
            if fdx_k is 3
                emit(208)
            fdx_k: fdx_k + 1
        emit(73)
        emit(131)
        emit(195)
        emit(4)
        emit3(73, 57, 211)
        emit(15)
        emit(140)
        fdx_b4: here()
        emit4(0)
        put(fdx_b4, fdx_h4 - (fdx_b4 + 4))
        # scalar tail into xmm2, then pairwise fold of the side chains
        fdx_ht: here()
        emit3(77, 57, 211)
        fdx_je: jae()
        emit(242)
        emit(67)
        emit(15)
        emit(16)
        emit(4)
        emit(216)
        emit(242)
        emit(67)
        emit(15)
        emit(89)
        emit(4)
        emit(217)
        emit(242)
        emit(15)
        emit(88)
        emit(208)
        emit3(73, 255, 195)
        emit(233)
        fdx_bb: here()
        emit4(0)
        put(fdx_bb, fdx_ht - (fdx_bb + 4))
        patch(fdx_je)
        emit(242)
        emit(15)
        emit(88)
        emit(211)
        emit(242)
        emit(15)
        emit(88)
        emit(229)
        emit(242)
        emit(15)
        emit(88)
        emit(212)
    if not
        # speculative raw run first: spec-ordered plain mulsd/addsd
        # (unrolled 4x, one serial chain in xmm2).  Every divergence
        # between raw SSE and the library spec (NaN payload choice,
        # SNaN quieting, generated-NaN bits) requires a NaN to appear
        # in some product or partial sum -- and a NaN, once in the
        # accumulator, never leaves.  So one comisd on the final sum
        # decides: ordered => the raw walk was step-for-step the spec
        # walk; unordered => rerun from the untouched memory sum with
        # the canonicalizing loop below.  rcx = lim - 3 (group guard).
        emit3(76, 137, 209)
        emit3(72, 131, 233)
        emit(3)
        align32()
        fdx_rh: here()
        emit3(73, 57, 203)
        fdx_rt: jae()
        fdx_k2: 0
        as long as fdx_k2 < 4
            fdx_rg: fdx_k2
            if fdx_k2 > 1
                fdx_rg: fdx_k2 + 1
            emit(242)
            emit(67)
            emit(15)
            emit(16)
            if fdx_k2 is 0
                emit(4)
                emit(216)
            if not
                emit(68 + fdx_rg * 8)
                emit(216)
                emit(fdx_k2 * 8)
            emit(242)
            emit(67)
            emit(15)
            emit(89)
            if fdx_k2 is 0
                emit(4)
                emit(217)
            if not
                emit(68 + fdx_rg * 8)
                emit(217)
                emit(fdx_k2 * 8)
            fdx_k2: fdx_k2 + 1
        emit(242)
        emit(15)
        emit(88)
        emit(208)
        emit(242)
        emit(15)
        emit(88)
        emit(209)
        emit(242)
        emit(15)
        emit(88)
        emit(211)
        emit(242)
        emit(15)
        emit(88)
        emit(212)
        emit(73)
        emit(131)
        emit(195)
        emit(4)
        emit(233)
        fdx_rb: here()
        emit4(0)
        put(fdx_rb, fdx_rh - (fdx_rb + 4))
        patch(fdx_rt)
        fdx_th: here()
        emit3(77, 57, 211)
        fdx_te: jae()
        emit(242)
        emit(67)
        emit(15)
        emit(16)
        emit(4)
        emit(216)
        emit(242)
        emit(67)
        emit(15)
        emit(89)
        emit(4)
        emit(217)
        emit(242)
        emit(15)
        emit(88)
        emit(208)
        emit3(73, 255, 195)
        emit(233)
        fdx_tb: here()
        emit4(0)
        put(fdx_tb, fdx_th - (fdx_tb + 4))
        patch(fdx_te)
        emit3(102, 15, 47)
        emit(210)
        fdx_ok: jnp()
        loadv(snm)
        emit(102)
        emit(72)
        emit(15)
        emit(110)
        emit(208)
        emit3(69, 49, 219)
        # spec-ordered accumulation with the f64 library's NaN
        # canonicalization applied to both the product and the sum
        # (comisd+jnp fast paths; integer fixup reloads operand bits).
        fdx_hd: here()
        emit(242)
        emit(67)
        emit(15)
        emit(16)
        emit(4)
        emit(216)
        emit(242)
        emit(67)
        emit(15)
        emit(89)
        emit(4)
        emit(217)
        emit3(102, 15, 47)
        emit(192)
        fdx_o1: jnp()
        emit3(75, 139, 60)
        emit(216)
        emit3(75, 139, 52)
        emit(217)
        emit_f64_canon_slow()
        emit3(102, 72, 15)
        emit(110)
        emit(192)
        patch(fdx_o1)
        emit3(15, 40, 202)
        emit(242)
        emit(15)
        emit(88)
        emit(208)
        emit3(102, 15, 47)
        emit(210)
        fdx_o2: jnp()
        emit3(102, 72, 15)
        emit(126)
        emit(207)
        emit3(102, 72, 15)
        emit(126)
        emit(198)
        emit_f64_canon_slow()
        emit3(102, 72, 15)
        emit(110)
        emit(208)
        patch(fdx_o2)
        emit3(73, 255, 195)
        emit3(77, 57, 211)
        emit(15)
        emit(140)
        fdx_bk: here()
        emit4(0)
        put(fdx_bk, fdx_hd - (fdx_bk + 4))
    if fdx_ok > 0 - 1
        patch(fdx_ok)
    emit(102)
    emit(72)
    emit(15)
    emit(126)
    emit(208)
    storev(snm)
    emit3(76, 137, 216)
    storev(iv)
    fdx_ejx: jmp()
    patch(fdx_dsk)
    patch(fdx_ejx)
    return 1

licm_out: 0
licm_sln: 0
licm_bad: 0
licm_reads: 0

licm_in set nm:
    n: _sov_list_len(set)
    i: 0
    as long as i < n
        if same(peek_i64(set, 16 + i * 8), nm) is 1
            return 1
        i: i + 1
    return 0

licm_add set nm:
    if licm_in(set, nm) is 0
        set: _sov_list_add(set, nm)
    return set

licm_pure nm:
    if licm_udef(nm) is 1
        return 0
    if same(nm, "peek_i64") is 1
        return 1
    if same(nm, "peek_byte") is 1
        return 1
    if same(nm, "peek_u8") is 1
        return 1
    if same(nm, "peek_i32") is 1
        return 1
    if same(nm, "f64_add") is 1
        return 1
    if same(nm, "f64_mul") is 1
        return 1
    if same(nm, "f64_sub") is 1
        return 1
    if same(nm, "f64_div") is 1
        return 1
    if same(nm, "f64_sqrt") is 1
        return 1
    if same(nm, "f64_from_i64") is 1
        return 1
    if same(nm, "f64_to_i64") is 1
        return 1
    if same(nm, "f64_cmp") is 1
        return 1
    if same(nm, "f64_from_frac") is 1
        return 1
    if same(nm, "_sov_list_get") is 1
        return 1
    if same(nm, "_sov_list_len") is 1
        return 1
    if same(nm, "band") is 1
        return 1
    if same(nm, "bor") is 1
        return 1
    if same(nm, "bxor") is 1
        return 1
    if same(nm, "shl") is 1
        return 1
    if same(nm, "shr") is 1
        return 1
    return 0

licm_scan_expr e:
    # collect identifier reads into licm_reads; set licm_bad on any
    # non-whitelisted call or string literal.
    n: length(e)
    i: 0
    as long as i < n
        b: peek_byte(e, i)
        if b is 34
            licm_bad: 1
            return
        idc: 0
        if b > 64
            if b < 91
                idc: 1
        if b > 96
            if b < 123
                idc: 1
        if b is 95
            idc: 1
        if idc is 1
            j: i + 1
            dn: 0
            as long as dn is 0
                if j >= n
                    dn: 1
                if not
                    c: peek_byte(e, j)
                    okc: 0
                    if c > 64
                        if c < 91
                            okc: 1
                    if c > 96
                        if c < 123
                            okc: 1
                    if c > 47
                        if c < 58
                            okc: 1
                    if c is 95
                        okc: 1
                    if okc is 1
                        j: j + 1
                    if not
                        dn: 1
            nm: cut(e, i, j)
            if j < n
                if peek_byte(e, j) is 40
                    if licm_pure(nm) is 0
                        licm_bad: 1
                        return
                    i: j
                if not
                    licm_reads: licm_add(licm_reads, nm)
                    i: j
            if not
                licm_reads: licm_add(licm_reads, nm)
                i: j
        if not
            i: i + 1

licm_lhs s:
    # stripped assignment LHS name, or "" when not a plain `name: expr`.
    p: look(s, ":")
    if p < 1
        return ""
    if peek_byte(s, p + 1) is not 32
        return ""
    nm: cut(s, 0, p)
    if plain_name(nm) is 0
        return ""
    if is_imm(nm) is 1
        return ""
    return nm

licm_whdr s:
    # condition offset (>0) when s (stripped) is a while header, else 0.
    if look(s, "as long as ") is 0
        return 11
    if look(s, "while ") is 0
        return 6
    if look(s, "do while ") is 0
        return 9
    return 0

licm_one ls sln:
    # Find one hoistable (init-run + invariant inner loop) inside an
    # outer while; on success set licm_out/licm_sln and return 1.
    n: _sov_list_len(ls)
    k: 0
    as long as k < n
        lk: peek_i64(ls, 16 + k * 8)
        spd: 0
        fb: peek_byte(lk, 0)
        as long as fb is 32
            spd: spd + 1
            fb: peek_byte(lk, spd)
        wok: 0
        ls_ok: 0
        if fb is 97
            ls_ok: 1
        if fb is 119
            ls_ok: 1
        if fb is 100
            ls_ok: 1
        if ls_ok is 1
            sk: strip_span(lk)
            wok: licm_whdr(sk)
        if wok > 0
            ocond: cut(sk, wok, length(sk))
            oi: indent_of(lk)
            # outer body extent
            b1: k + 1
            dn: 0
            as long as dn is 0
                if b1 >= n
                    dn: 1
                if not
                    if indent_of(peek_i64(ls, 16 + b1 * 8)) > oi
                        b1: b1 + 1
                    if not
                        dn: 1
            if b1 > k + 2
                lbi: indent_of(peek_i64(ls, 16 + (k + 1) * 8))
                # find inner header at body-base indent
                h: 0 - 1
                coff: 0
                j: k + 1
                as long as j < b1
                    lj: peek_i64(ls, 16 + j * 8)
                    if indent_of(lj) is lbi
                        fb2: peek_byte(lj, lbi)
                        w: 0
                        if fb2 is 97
                            w: licm_whdr(strip_span(lj))
                        if fb2 is 119
                            w: licm_whdr(strip_span(lj))
                        if fb2 is 100
                            w: licm_whdr(strip_span(lj))
                        if w > 0
                            h: j
                            coff: w
                            j: b1
                    j: j + 1
                if h > k + 1
                    # inner body extent
                    e: h + 1
                    dn: 0
                    as long as dn is 0
                        if e >= b1
                            dn: 1
                        if not
                            if indent_of(peek_i64(ls, 16 + e * 8)) > lbi
                                e: e + 1
                            if not
                                dn: 1
                    good: 0
                    if e > h + 1
                        if e < b1
                            good: licm_check(ls, k, ocond, h, coff, e, b1)
                    if good is 1
                        # splice: [0..k) + guard-if + [k+1..e) + [k] +
                        #          [e..n)   (stmt_lns moved in parallel)
                        gsp: ""
                        i: 0
                        as long as i < oi
                            gsp: str_cat(gsp, " ")
                            i: i + 1
                        gl: str_cat(gsp, str_cat("if ", ocond))
                        nl: _sov_list_new()
                        ns: _sov_list_new()
                        i: 0
                        as long as i < k
                            nl: _sov_list_add(nl, peek_i64(ls, 16 + i * 8))
                            ns: _sov_list_add(ns, peek_i64(sln, 16 + i * 8))
                            i: i + 1
                        nl: _sov_list_add(nl, gl)
                        ns: _sov_list_add(ns, peek_i64(sln, 16 + k * 8))
                        i: k + 1
                        as long as i < e
                            nl: _sov_list_add(nl, peek_i64(ls, 16 + i * 8))
                            ns: _sov_list_add(ns, peek_i64(sln, 16 + i * 8))
                            i: i + 1
                        nl: _sov_list_add(nl, lk)
                        ns: _sov_list_add(ns, peek_i64(sln, 16 + k * 8))
                        i: e
                        as long as i < n
                            nl: _sov_list_add(nl, peek_i64(ls, 16 + i * 8))
                            ns: _sov_list_add(ns, peek_i64(sln, 16 + i * 8))
                            i: i + 1
                        licm_out: nl
                        licm_sln: ns
                        return 1
        k: k + 1
    return 0

licm_check ls k ocond h coff e b1:
    # conservatism core. ls body region (k+1..b1): pre (k+1..h),
    # inner (h..e), post (e..b1) -- all straight-line plain assigns,
    # pure calls only, no stores, defs/uses disjoint as required.
    lbi: indent_of(peek_i64(ls, 16 + (k + 1) * 8))
    licm_bad: 0
    pre_vars: _sov_list_new()
    ina: _sov_list_new()
    posta: _sov_list_new()
    hlhs: _sov_list_new()
    hexpr: _sov_list_new()
    # outer cond: no calls at all
    if look(ocond, "(") > 0 - 1
        return 0
    licm_reads: _sov_list_new()
    dummy: licm_scan_expr(ocond)
    oreads: licm_reads
    if licm_bad is 1
        return 0
    # pass 1: shapes + assigned sets; record pre statements
    i: k + 1
    as long as i < h
        li_t: peek_i64(ls, 16 + i * 8)
        s: strip_span(li_t)
        if length(s) is 0
            return 0
        if peek_byte(s, 0) is 35
            return 0
        if indent_of(li_t) is not lbi
            return 0
        nm: licm_lhs(s)
        if length(nm) is 0
            return 0
        pre_vars: licm_add(pre_vars, nm)
        hlhs: _sov_list_add(hlhs, nm)
        hexpr: _sov_list_add(hexpr, cut(s, look(s, ":") + 2, length(s)))
        i: i + 1
    sh: strip_span(peek_i64(ls, 16 + h * 8))
    icond: cut(sh, coff, length(sh))
    i: h + 1
    if i < e
        ii: indent_of(peek_i64(ls, 16 + i * 8))
    as long as i < e
        li_t: peek_i64(ls, 16 + i * 8)
        s: strip_span(li_t)
        if length(s) is 0
            return 0
        if peek_byte(s, 0) is 35
            return 0
        if indent_of(li_t) is not ii
            return 0
        nm: licm_lhs(s)
        if length(nm) is 0
            return 0
        ina: licm_add(ina, nm)
        i: i + 1
    licm_reads: _sov_list_new()
    i: e
    as long as i < b1
        li_t: peek_i64(ls, 16 + i * 8)
        s: strip_span(li_t)
        if length(s) is 0
            return 0
        if peek_byte(s, 0) is 35
            return 0
        if indent_of(li_t) is not lbi
            return 0
        nm: licm_lhs(s)
        if length(nm) is 0
            return 0
        posta: licm_add(posta, nm)
        dummy: licm_scan_expr(cut(s, look(s, ":") + 2, length(s)))
        if licm_bad is 1
            return 0
        i: i + 1
    # every inner-assigned name must be re-initialized in pre
    i: 0
    as long as i < _sov_list_len(ina)
        if licm_in(pre_vars, peek_i64(ina, 16 + i * 8)) is 0
            return 0
        i: i + 1
    # post must not assign any hoisted-region name
    i: 0
    as long as i < _sov_list_len(posta)
        nm: peek_i64(posta, 16 + i * 8)
        if licm_in(pre_vars, nm) is 1
            return 0
        i: i + 1
    # outer cond must not read any hoisted-region name
    i: 0
    as long as i < _sov_list_len(oreads)
        nm: peek_i64(oreads, 16 + i * 8)
        if licm_in(pre_vars, nm) is 1
            return 0
        i: i + 1
    # pass 2: ordered reads in pre.  A read of a hoisted-region name
    # before its defining statement is a cross-iteration input: bail.
    # Reads of names assigned in post are also iteration-varying: bail.
    defd: _sov_list_new()
    licm_reads: _sov_list_new()
    i: 0
    as long as i < _sov_list_len(hexpr)
        b4: _sov_list_len(licm_reads)
        dummy: licm_scan_expr(peek_i64(hexpr, 16 + i * 8))
        if licm_bad is 1
            return 0
        j: b4
        as long as j < _sov_list_len(licm_reads)
            nm: peek_i64(licm_reads, 16 + j * 8)
            if licm_in(posta, nm) is 1
                return 0
            if licm_in(pre_vars, nm) is 1
                if licm_in(defd, nm) is 0
                    return 0
            j: j + 1
        defd: licm_add(defd, peek_i64(hlhs, 16 + i * 8))
        i: i + 1
    # inner cond + body reads: may use any pre-defined name, never posta
    dummy: licm_scan_expr(icond)
    if licm_bad is 1
        return 0
    i: h + 1
    as long as i < e
        s: strip_span(peek_i64(ls, 16 + i * 8))
        dummy: licm_scan_expr(cut(s, look(s, ":") + 2, length(s)))
        if licm_bad is 1
            return 0
        i: i + 1
    i: 0
    as long as i < _sov_list_len(licm_reads)
        nm: peek_i64(licm_reads, 16 + i * 8)
        if licm_in(posta, nm) is 1
            return 0
        i: i + 1
    return 1

licm2_found: 0
licm2_text: 0
licm2_pos: 0
licm2_at: 0
licm2_rhs: 0
licm2_A: 0
licm2_reads: 0

licm_udef nm:
    # 1 when nm is a task defined in the user's own source (so a
    # whitelisted library name may have been redefined with effects).
    ui: nm_lookup(nm)
    if ui < 0
        return 0
    return peek_i64(task_user, 16 + ui * 8)

licm_pure2 nm:
    if licm_pure(nm) is 1
        return 1
    if licm_udef(nm) is 1
        return 0
    if same(nm, "str_find") is 1
        return 1
    if same(nm, "str_len") is 1
        return 1
    if same(nm, "str_eq") is 1
        return 1
    if same(nm, "str_starts") is 1
        return 1
    if same(nm, "str_ends") is 1
        return 1
    if same(nm, "_sov_find_text") is 1
        return 1
    if same(nm, "_sov_strlen") is 1
        return 1
    if same(nm, "_sov_str_eq") is 1
        return 1
    if same(nm, "_sov_starts_with") is 1
        return 1
    if same(nm, "length") is 1
        return 1
    return 0

licm2_match e p:
    # index of the close paren matching the '(' at p (quote-aware), -1.
    n: length(e)
    d: 0
    i: p
    as long as i < n
        b: peek_byte(e, i)
        if b is 34
            i: i + 1
            dn: 0
            as long as dn is 0
                if i >= n
                    dn: 1
                if not
                    c: peek_byte(e, i)
                    if c is 92
                        i: i + 2
                    if not
                        if c is 34
                            i: i + 1
                            dn: 1
                        if not
                            i: i + 1
        if not
            if b is 40
                d: d + 1
                i: i + 1
            if not
                if b is 41
                    d: d - 1
                    if d is 0
                        return i
                    i: i + 1
                if not
                    i: i + 1
    return 0 - 1

licm2_argreads e:
    # collect identifier reads in e into licm2_reads (quote-aware);
    # licm_bad on any non-pure callee.
    n: length(e)
    i: 0
    as long as i < n
        b: peek_byte(e, i)
        if b is 34
            i: i + 1
            dn: 0
            as long as dn is 0
                if i >= n
                    dn: 1
                if not
                    c: peek_byte(e, i)
                    if c is 92
                        i: i + 2
                    if not
                        if c is 34
                            i: i + 1
                            dn: 1
                        if not
                            i: i + 1
        if not
            idc: 0
            if b > 64
                if b < 91
                    idc: 1
            if b > 96
                if b < 123
                    idc: 1
            if b is 95
                idc: 1
            if idc is 1
                j: i + 1
                dn: 0
                as long as dn is 0
                    if j >= n
                        dn: 1
                    if not
                        c: peek_byte(e, j)
                        okc: 0
                        if c > 64
                            if c < 91
                                okc: 1
                        if c > 96
                            if c < 123
                                okc: 1
                        if c > 47
                            if c < 58
                                okc: 1
                        if c is 95
                            okc: 1
                        if okc is 1
                            j: j + 1
                        if not
                            dn: 1
                nm: cut(e, i, j)
                if j < n
                    if peek_byte(e, j) is 40
                        if licm_pure2(nm) is 0
                            licm_bad: 1
                            return
                        i: j
                    if not
                        licm2_reads: licm_add(licm2_reads, nm)
                        i: j
                if not
                    licm2_reads: licm_add(licm2_reads, nm)
                    i: j
            if not
                i: i + 1

licm2_scan e:
    # quote-aware scan of one RHS: licm_bad on any non-pure callee;
    # record the first pure call whose subtree reads avoid licm2_A.
    n: length(e)
    i: 0
    as long as i < n
        b: peek_byte(e, i)
        if b is 34
            i: i + 1
            dn: 0
            as long as dn is 0
                if i >= n
                    dn: 1
                if not
                    c: peek_byte(e, i)
                    if c is 92
                        i: i + 2
                    if not
                        if c is 34
                            i: i + 1
                            dn: 1
                        if not
                            i: i + 1
        if not
            idc: 0
            if b > 64
                if b < 91
                    idc: 1
            if b > 96
                if b < 123
                    idc: 1
            if b is 95
                idc: 1
            if idc is 1
                j: i + 1
                dn: 0
                as long as dn is 0
                    if j >= n
                        dn: 1
                    if not
                        c: peek_byte(e, j)
                        okc: 0
                        if c > 64
                            if c < 91
                                okc: 1
                        if c > 96
                            if c < 123
                                okc: 1
                        if c > 47
                            if c < 58
                                okc: 1
                        if c is 95
                            okc: 1
                        if okc is 1
                            j: j + 1
                        if not
                            dn: 1
                nm: cut(e, i, j)
                if j < n
                    if peek_byte(e, j) is 40
                        if licm_pure2(nm) is 0
                            licm_bad: 1
                            return
                        if licm2_found is 0
                            m: licm2_match(e, j)
                            if m > 0 - 1
                                licm2_reads: _sov_list_new()
                                dummy: licm2_argreads(cut(e, j + 1, m))
                                if licm_bad is 1
                                    return
                                bad2: 0
                                q: 0
                                as long as q < _sov_list_len(licm2_reads)
                                    if licm_in(licm2_A, peek_i64(licm2_reads, 16 + q * 8)) is 1
                                        bad2: 1
                                    q: q + 1
                                if bad2 is 0
                                    licm2_found: 1
                                    licm2_pos: i
                                    licm2_text: cut(e, i, m + 1)
                        i: j
                    if not
                        i: j
                if not
                    i: j
            if not
                i: i + 1

licm2_check ls k ocond b1:
    # straight-line body, pure calls only; sets licm2_at/pos/text.
    lbi: indent_of(peek_i64(ls, 16 + (k + 1) * 8))
    licm_bad: 0
    if look(ocond, "(") > 0 - 1
        return 0
    licm2_A: _sov_list_new()
    hidx: _sov_list_new()
    hrhs: _sov_list_new()
    i: k + 1
    as long as i < b1
        li_t: peek_i64(ls, 16 + i * 8)
        s: strip_span(li_t)
        if length(s) is 0
            return 0
        if peek_byte(s, 0) is 35
            return 0
        if indent_of(li_t) is not lbi
            return 0
        spc: 0
        as long as peek_byte(li_t, spc) is 32
            spc: spc + 1
        if peek_byte(li_t, spc) is 9
            return 0
        nm: licm_lhs(s)
        if length(nm) is 0
            return 0
        licm2_A: licm_add(licm2_A, nm)
        hidx: _sov_list_add(hidx, i)
        hrhs: _sov_list_add(hrhs, cut(s, look(s, ":") + 2, length(s)))
        i: i + 1
    licm2_found: 0
    licm2_at: 0 - 1
    i: 0
    as long as i < _sov_list_len(hrhs)
        dummy: licm2_scan(peek_i64(hrhs, 16 + i * 8))
        if licm_bad is 1
            return 0
        if licm2_found is 1
            if licm2_at < 0
                licm2_at: peek_i64(hidx, 16 + i * 8)
        i: i + 1
    if licm2_found is 0
        return 0
    return 1

licm2_fresh ls:
    tmp: "licm_t"
    n: _sov_list_len(ls)
    try: 0
    as long as try < 40
        seen: 0
        i: 0
        as long as i < n
            if look(peek_i64(ls, 16 + i * 8), tmp) > 0 - 1
                seen: 1
                i: n
            i: i + 1
        if seen is 0
            return tmp
        tmp: str_cat(tmp, "t")
        try: try + 1
    return ""

licm2_one ls sln:
    # hoist one invariant pure call out of an outer while.
    n: _sov_list_len(ls)
    k: 0
    as long as k < n
        lk: peek_i64(ls, 16 + k * 8)
        spd: 0
        fb: peek_byte(lk, 0)
        as long as fb is 32
            spd: spd + 1
            fb: peek_byte(lk, spd)
        wok: 0
        ls_ok: 0
        if fb is 97
            ls_ok: 1
        if fb is 119
            ls_ok: 1
        if fb is 100
            ls_ok: 1
        if ls_ok is 1
            sk: strip_span(lk)
            wok: licm_whdr(sk)
        if wok > 0
            ocond: cut(sk, wok, length(sk))
            oi: indent_of(lk)
            b1: k + 1
            dn: 0
            as long as dn is 0
                if b1 >= n
                    dn: 1
                if not
                    if indent_of(peek_i64(ls, 16 + b1 * 8)) > oi
                        b1: b1 + 1
                    if not
                        dn: 1
            if b1 > k + 1
                if licm2_check(ls, k, ocond, b1) is 1
                    tmp: licm2_fresh(ls)
                    if length(tmp) > 0
                        lbi: indent_of(peek_i64(ls, 16 + (k + 1) * 8))
                        gsp: ""
                        i: 0
                        as long as i < oi
                            gsp: str_cat(gsp, " ")
                            i: i + 1
                        gl: str_cat(gsp, str_cat("if ", ocond))
                        hsp: ""
                        i: 0
                        as long as i < lbi
                            hsp: str_cat(hsp, " ")
                            i: i + 1
                        hl: str_cat(hsp, str_cat(tmp, str_cat(": ", licm2_text)))
                        # rewrite the containing statement positionally
                        orig: peek_i64(ls, 16 + licm2_at * 8)
                        px: 0
                        as long as peek_byte(orig, px) is 32
                            px: px + 1
                        s: strip(orig)
                        cp: look(s, ":") + 2 + licm2_pos
                        ns1: str_cat(cut(s, 0, cp), str_cat(tmp, cut(s, cp + length(licm2_text), length(s))))
                        modl: str_cat(cut(orig, 0, px), ns1)
                        nl: _sov_list_new()
                        ns: _sov_list_new()
                        i: 0
                        as long as i < k
                            nl: _sov_list_add(nl, peek_i64(ls, 16 + i * 8))
                            ns: _sov_list_add(ns, peek_i64(sln, 16 + i * 8))
                            i: i + 1
                        nl: _sov_list_add(nl, gl)
                        ns: _sov_list_add(ns, peek_i64(sln, 16 + k * 8))
                        nl: _sov_list_add(nl, hl)
                        ns: _sov_list_add(ns, peek_i64(sln, 16 + licm2_at * 8))
                        i: k
                        as long as i < n
                            if i is licm2_at
                                nl: _sov_list_add(nl, modl)
                            if not
                                nl: _sov_list_add(nl, peek_i64(ls, 16 + i * 8))
                            ns: _sov_list_add(ns, peek_i64(sln, 16 + i * 8))
                            i: i + 1
                        licm_out: nl
                        licm_sln: ns
                        return 1
        k: k + 1
    return 0

inl2_names: 0
fold_ok: 0
inl2_params: 0
inl2_bodies: 0
inl2_gh: 0
inl2_gcap: 0
inl2_out: 0
inl2_sln: 0
inl2_reads: 0
inl2_cl: 0
inl2_cn: 0
inl2_okm: 0
inl2_okb: 0
inl2_cnci: 1000000000
inl2_mapf: 0
inl2_mapt: 0
inl2_ret: 0
inl2_bad: 0

inl2_idc b:
    r: 0
    if b > 64
        if b < 91
            r: 1
    if b > 96
        if b < 123
            r: 1
    if b is 95
        r: 1
    return r

inl2_idc2 b:
    r: inl2_idc(b)
    if b > 47
        if b < 58
            r: 1
    return r

inl2_wop nm:
    if _sov_str_eq(nm, "is") is 1
        return 1
    if _sov_str_eq(nm, "and") is 1
        return 1
    if _sov_str_eq(nm, "or") is 1
        return 1
    if _sov_str_eq(nm, "not") is 1
        return 1
    if _sov_str_eq(nm, "of") is 1
        return 1
    if _sov_str_eq(nm, "length") is 1
        return 1
    return 0

inl2_purecall nm:
    if _sov_str_eq(nm, "band") is 1
        return 1
    if _sov_str_eq(nm, "bor") is 1
        return 1
    if _sov_str_eq(nm, "bxor") is 1
        return 1
    if _sov_str_eq(nm, "bshl") is 1
        return 1
    if _sov_str_eq(nm, "bshr") is 1
        return 1
    if _sov_str_eq(nm, "bsar") is 1
        return 1
    if _sov_str_eq(nm, "bnot") is 1
        return 1
    if _sov_str_eq(nm, "wrap_add") is 1
        return 1
    if _sov_str_eq(nm, "wrap_sub") is 1
        return 1
    if _sov_str_eq(nm, "wrap_mul") is 1
        return 1
    if _sov_str_eq(nm, "peek_byte") is 1
        return 1
    if _sov_str_eq(nm, "peek_i64") is 1
        return 1
    if _sov_str_eq(nm, "peek_u8") is 1
        return 1
    if _sov_str_eq(nm, "char_at") is 1
        return 1
    if _sov_str_eq(nm, "_sov_strlen") is 1
        return 1
    if _sov_str_eq(nm, "_sov_str_eq") is 1
        return 1
    if _sov_str_eq(nm, "_sov_list_len") is 1
        return 1
    if _sov_str_eq(nm, "_sov_list_get") is 1
        return 1
    if _sov_str_eq(nm, "_sov_find_text") is 1
        return 1
    return 0

inl2_scanreads e:
    # collect value-identifier reads into inl2_reads (deduped via
    # licm_add); any call or string literal sets inl2_bad.
    n: length(e)
    i: 0
    as long as i < n
        b: peek_byte(e, i)
        if b is 34
            inl2_bad: 1
            return
        if inl2_idc(b) is 1
            j: i + 1
            go: 1
            as long as go is 1
                if j >= n
                    go: 0
                if not
                    if inl2_idc2(peek_byte(e, j)) is 1
                        j: j + 1
                    if not
                        go: 0
            nm: cut(e, i, j)
            if j < n
                if peek_byte(e, j) is 40
                    if inl2_purecall(nm) is 0
                        inl2_bad: 1
                        return
                    i: j
                    nm: ""
            if length(nm) > 0
                inl2_reads: licm_add(inl2_reads, nm)
            i: j
        if not
            i: i + 1

inl2_rename e:
    # word-substitute value identifiers via inl2_mapf -> inl2_mapt.
    out: ""
    n: length(e)
    i: 0
    as long as i < n
        b: peek_byte(e, i)
        if inl2_idc(b) is 1
            j: i + 1
            go: 1
            as long as go is 1
                if j >= n
                    go: 0
                if not
                    if inl2_idc2(peek_byte(e, j)) is 1
                        j: j + 1
                    if not
                        go: 0
            nm: cut(e, i, j)
            rep: nm
            mi: 0
            mgo: 1
            as long as mgo is 1
                if mi >= _sov_list_len(inl2_mapf)
                    mgo: 0
                if not
                    if _sov_str_eq(peek_i64(inl2_mapf, 16 + mi * 8), nm) is 1
                        rep: peek_i64(inl2_mapt, 16 + mi * 8)
                        mgo: 0
                    if not
                        mi: mi + 1
            out: str_cat(out, rep)
            i: j
        if not
            out: str_cat(out, cut(e, i, i + 1))
            i: i + 1
    return out

inl2_body_ok cb cps:
    # pure straight-line callee? sets inl2_cl (params+locals),
    # inl2_ret; validates reads against caller capture + globals.
    nl: _sov_list_len(cb)
    if nl < 1
        return 0
    if nl > 12
        return 0
    inl2_cl: _sov_list_new()
    qi: 0
    as long as qi < _sov_list_len(cps)
        inl2_cl: licm_add(inl2_cl, peek_i64(cps, 16 + qi * 8))
        qi: qi + 1
    inl2_reads: _sov_list_new()
    inl2_bad: 0
    inif: 0
    exprs: _sov_list_new()
    k: 0
    as long as k < nl
        ln: peek_i64(cb, 16 + k * 8)
        if cfind1(ln, 9) > 0 - 1
            return 0
        if cfind1(ln, 34) > 0 - 1
            return 0
        s: strip(ln)
        if length(s) is 0
            return 0
        if peek_byte(s, 0) is 35
            return 0
        if k is nl - 1
            if look(s, "return ") is not 0
                return 0
            inl2_ret: scutr(s, 7)
            if length(inl2_ret) is 0
                return 0
            exprs: _sov_list_add(exprs, inl2_ret)
        if not
            if look(s, "return") is 0
                return 0
            sp2: 0
            as long as peek_byte(ln, sp2) is 32
                sp2: sp2 + 1
            nm: licm_lhs(s)
            if length(nm) is 0
                if sp2 is not 4
                    return 0
                if starts(s, "if ") is 0
                    return 0
                if _sov_str_eq(s, "if not") is 1
                    return 0
                exprs: _sov_list_add(exprs, cut(s, 3, length(s)))
                inif: 1
                nm: ""
            if length(nm) > 0
                if sp2 is 4
                    inif: 0
                if not
                    if sp2 is not 8
                        return 0
                    if inif is 0
                        return 0
            if length(nm) > 0
                if set_has(inl2_gh, inl2_gcap, nm) is 1
                    return 0
                inl2_cl: licm_add(inl2_cl, nm)
                exprs: _sov_list_add(exprs, cut(s, look(s, ":") + 2, length(s)))
        k: k + 1
    k: 0
    as long as k < _sov_list_len(exprs)
        dummy: inl2_scanreads(peek_i64(exprs, 16 + k * 8))
        if inl2_bad is 1
            return 0
        k: k + 1
    ri: 0
    as long as ri < _sov_list_len(inl2_reads)
        rn: peek_i64(inl2_reads, 16 + ri * 8)
        ok: 0
        if licm_in(inl2_cl, rn) is 1
            ok: 1
        if inl2_wop(rn) is 1
            ok: 1
        if ok is 0
            if set_has(inl2_gh, inl2_gcap, rn) is 1
                if licm_in(inl2_cn, rn) is 0
                    ok: 1
        if ok is 0
            return 0
        ri: ri + 1
    return 1

inl2_callfind rhs:
    # find the unique call in rhs. Returns b0 (>=0) or -1; sets
    # globals inl2_cnm (name), inl2_cb1 (close-paren index).
    n: length(rhs)
    i: 0
    found: 0
    fb0: 0 - 1
    as long as i < n
        b: peek_byte(rhs, i)
        if inl2_idc(b) is 1
            j: i + 1
            go: 1
            as long as go is 1
                if j >= n
                    go: 0
                if not
                    if inl2_idc2(peek_byte(rhs, j)) is 1
                        j: j + 1
                    if not
                        go: 0
            iscl: 0
            if j < n
                if peek_byte(rhs, j) is 40
                    iscl: 1
            if iscl is 1
                found: found + 1
                if found > 1
                    return 0 - 1
                fb0: i
                inl2_cnm: cut(rhs, i, j)
                d: 1
                q: j + 1
                qp: 1
                inw: 0 - 1
                as long as qp is 1
                    if q >= n
                        qp: 0
                    if not
                        cb2: peek_byte(rhs, q)
                        if cb2 is 40
                            d: d + 1
                        if cb2 is 41
                            d: d - 1
                            if d is 0
                                inw: q
                                qp: 0
                        q: q + 1
                if inw < 0
                    return 0 - 1
                inl2_cb1: inw
                i: inw + 1
            if not
                i: j
        if not
            i: i + 1
    return fb0

inl2_cnm: 0
inl2_cb1: 0

# --- inl2 determinism probe (2026-11-02): env-gated decision trace ---
# Gate: /tmp/sov_inl2log must exist (opened O_WRONLY|O_APPEND, no O_CREAT).
# One line per inl2_one decision (fire&&argo): caller f, site k, callee i,
# callee name n, caller name cn, body ptr cb, body fingerprint
# c = lines*1e12 + total-line-bytes, task_user u, argo a, memo-hit m,
# decision K. Written with ONE write syscall (O_APPEND) so parallel
# parent/child lines interleave without tearing. The trace only peeks
# existing state and writes to its own static buffer: no allocation on
# the decision path, no string-heap churn, decision inputs untouched.
inl2_lfd: 0
inl2_lbuf: 0
inl2_lc: 0
inl2_lnl: 0
inl2_lnb: 0
inl2_lns: 0

inl2_lopen:
    if inl2_lfd is 0
        inl2_lfd: syscall(2, "/tmp/sov_inl2log", 1025, 420, 0)
        if inl2_lfd < 1
            inl2_lfd: 0 - 1
        if inl2_lfd > 0
            inl2_lbuf: _sov_heap_alloc(768)
    return 0

inl2_lp s:
    if inl2_lc > 700
        return 0
    k2: 0
    as long as peek_byte(s, k2) > 0
        poke_byte(inl2_lbuf, inl2_lc, peek_byte(s, k2))
        inl2_lc: inl2_lc + 1
        k2: k2 + 1
    return 0

inl2_lnum v:
    if v < 0
        poke_byte(inl2_lbuf, inl2_lc, 45)
        inl2_lc: inl2_lc + 1
        v: 0 - v
    dv: 1000000000000000
    nz: 0
    as long as dv > 0
        d2: v / dv % 10
        if d2 > 0
            nz: 1
        if nz is 1
            poke_byte(inl2_lbuf, inl2_lc, 48 + d2)
            inl2_lc: inl2_lc + 1
        dv: dv / 10
    if nz is 0
        poke_byte(inl2_lbuf, inl2_lc, 48)
        inl2_lc: inl2_lc + 1
    return 0

inl2_lmeas cb:
    inl2_lnl: _sov_list_len(cb)
    inl2_lnb: 0
    mi: 0
    as long as mi < inl2_lnl
        ln3: peek_i64(cb, 16 + mi * 8)
        if ln3 > 0
            inl2_lnb: inl2_lnb + par_slen(ln3)
        mi: mi + 1
    return 0

inl2_lsum cb:
    return 0

inl2_ldec ci k idx cb argo mhit bok:
    if inl2_lfd < 1
        return 0
    inl2_lc: 0
    inl2_lp("T")
    inl2_lnum(par_child)
    inl2_lp(" f")
    inl2_lnum(ci)
    inl2_lp(" k")
    inl2_lnum(k)
    inl2_lp(" i")
    inl2_lnum(idx)
    inl2_lp(" n")
    nn: peek_i64(names, 16 + idx * 8)
    if nn > 0
        inl2_lp(nn)
    if not
        inl2_lp("0")
    inl2_lp(" cn")
    nc: peek_i64(names, 16 + ci * 8)
    if nc > 0
        inl2_lp(nc)
    if not
        inl2_lp("0")
    inl2_lp(" cb")
    inl2_lnum(cb)
    dummy: inl2_lmeas(cb)
    inl2_lp(" L")
    inl2_lnum(inl2_lnl)
    inl2_lp(" B")
    inl2_lnum(inl2_lnb)
    inl2_lp(" u")
    inl2_lnum(peek_i64(task_user, 16 + idx * 8))
    inl2_lp(" a")
    inl2_lnum(argo)
    inl2_lp(" m")
    inl2_lnum(mhit)
    inl2_lp(" K")
    inl2_lnum(bok)
    poke_byte(inl2_lbuf, inl2_lc, 10)
    inl2_lc: inl2_lc + 1
    syscall(1, inl2_lfd, inl2_lbuf, inl2_lc, 0)
    return 0
# --- end inl2 determinism probe ---

inl2_one ls sln ci:
    # inline the first eligible site; success sets inl2_out/inl2_sln.
    n: _sov_list_len(ls)
    k: 0
    as long as k < n
        lk: peek_i64(ls, 16 + k * 8)
        s: strip_span(lk)
        fire: 0
        if _sov_find_text(s, "(") < 0
            s: ""
        nsp: 0
        as long as peek_byte(lk, nsp) is 32
            nsp: nsp + 1
        if nsp >= 4
            if peek_byte(lk, nsp) is not 32
                if peek_byte(lk, nsp) is not 0
                            dst: licm_lhs(s)
                            kind: 0
                            pre: ""
                            rhs: ""
                            if length(dst) > 0
                                p: look(s, ":")
                                rhs: scutr(s, p + 2)
                            if length(dst) is 0
                                if starts(s, "return ") is 1
                                    kind: 1
                                    pre: "return "
                                    rhs: scutr(s, 7)
                            if length(dst) is 0
                                if kind is 0
                                    if starts(s, "if ") is 1
                                        kind: 2
                                        pre: "if "
                                        rhs: scutr(s, 3)
                            if _sov_find_text(rhs, "spawn ") >= 0
                                rhs: ""
                            if length(rhs) > 0
                                if cfind1(rhs, 34) > 0 - 1
                                    rhs: ""
                                if length(rhs) > 0
                                    b0: inl2_callfind(rhs)
                                    if b0 > 0 - 1
                                        idx: nm_lookup(inl2_cnm)
                                        if idx > 0 - 1
                                            if idx is not ci
                                                if peek_i64(task_user, 16 + idx * 8) is 1
                                                    fire: 1
        if fire is 1
            if inl2_cnci is not ci
                dummy: inl2_mkcn(ls, ci)
                inl2_cnci: ci
            cps: peek_i64(inl2_params, 16 + idx * 8)
            cb: peek_i64(inl2_bodies, 16 + idx * 8)
            lp: look(cut(rhs, b0, length(rhs)), "(") + b0
            argtxt: cut(rhs, lp + 1, inl2_cb1)
            argl: _sov_list_new()
            argl: split_args(argtxt, argl)
            argo: 1
            if _sov_list_len(argl) is not _sov_list_len(cps)
                argo: 0
            ai: 0
            as long as ai < _sov_list_len(argl)
                av: strip(peek_i64(argl, 16 + ai * 8))
                if is_imm(av) is 0
                    if plain_name(av) is 0
                        argo: 0
                ai: ai + 1
            if argo is 1
                bok: 0
                mhit: 0
                if _sov_list_len(inl2_okm) > idx
                    if peek_i64(inl2_okb, 16 + idx * 8) is cb
                        if peek_i64(inl2_okm, 16 + idx * 8) is not 9
                            bok: peek_i64(inl2_okm, 16 + idx * 8)
                            mhit: 1
                if bok is 0
                    bok: inl2_body_ok(cb, cps)
                    if _sov_list_len(inl2_okm) > idx
                        dummy: _sov_list_set(inl2_okm, idx, bok)
                        dummy: _sov_list_set(inl2_okb, idx, cb)
                dummy: inl2_ldec(ci, k, idx, cb, argo, mhit, bok)
                if bok is 1
                    dummy: inl2_body_ok(cb, cps)
                    ind: cut(lk, 0, nsp)
                    base: "zzln"
                    btry: 0
                    bseen: 1
                    as long as bseen is 1
                        bseen: 0
                        i2bi: 0
                        as long as i2bi < n
                            if look(peek_i64(ls, 16 + i2bi * 8), base) > 0 - 1
                                bseen: 1
                            i2bi: i2bi + 1
                        i2bi: 0
                        as long as i2bi < _sov_list_len(cb)
                            if look(peek_i64(cb, 16 + i2bi * 8), base) > 0 - 1
                                bseen: 1
                            i2bi: i2bi + 1
                        if bseen is 1
                            base: str_cat(base, "t")
                            btry: btry + 1
                            if btry > 40
                                return 0
                    inl2_mapf: _sov_list_new()
                    inl2_mapt: _sov_list_new()
                    gen: _sov_list_new()
                    ai: 0
                    as long as ai < _sov_list_len(cps)
                        pn: peek_i64(cps, 16 + ai * 8)
                        inl2_mapf: _sov_list_add(inl2_mapf, pn)
                        inl2_mapt: _sov_list_add(inl2_mapt, strip(peek_i64(argl, 16 + ai * 8)))
                        ai: ai + 1
                    li2: 0
                    as long as li2 < _sov_list_len(inl2_cl)
                        cnm: peek_i64(inl2_cl, 16 + li2 * 8)
                        if licm_in(inl2_mapf, cnm) is 0
                            tn: str_cat(base, "_")
                            tn: str_cat(tn, cnm)
                            inl2_mapf: _sov_list_add(inl2_mapf, cnm)
                            inl2_mapt: _sov_list_add(inl2_mapt, tn)
                        li2: li2 + 1
                    cbl: _sov_list_len(cb)
                    i2bi: 0
                    as long as i2bi < cbl - 1
                        rl2: peek_i64(cb, 16 + i2bi * 8)
                        sp3: 0
                        as long as peek_byte(rl2, sp3) is 32
                            sp3: sp3 + 1
                        ex2: ""
                        if sp3 > 4
                            ex2: cut(rl2, 4, sp3)
                        gen: _sov_list_add(gen, str_cat(ind, str_cat(ex2, inl2_rename(strip(rl2)))))
                        i2bi: i2bi + 1
                    rre: inl2_rename(inl2_ret)
                    nrhs: rre
                    if b0 > 0
                        nrhs: str_cat(cut(rhs, 0, b0), "(")
                        nrhs: str_cat(nrhs, rre)
                        nrhs: str_cat(nrhs, ")")
                        nrhs: str_cat(nrhs, cut(rhs, inl2_cb1 + 1, length(rhs)))
                    if not
                        if inl2_cb1 < length(rhs) - 1
                            nrhs: str_cat("(", rre)
                            nrhs: str_cat(nrhs, ")")
                            nrhs: str_cat(nrhs, cut(rhs, inl2_cb1 + 1, length(rhs)))
                    if kind is 0
                        gl: str_cat(ind, dst)
                        gl: str_cat(gl, ": ")
                    if not
                        gl: str_cat(ind, pre)
                    gl: str_cat(gl, nrhs)
                    gen: _sov_list_add(gen, gl)
                    nl2: _sov_list_new()
                    ns2: _sov_list_new()
                    w: 0
                    as long as w < k
                        nl2: _sov_list_add(nl2, peek_i64(ls, 16 + w * 8))
                        ns2: _sov_list_add(ns2, peek_i64(sln, 16 + w * 8))
                        w: w + 1
                    kln: peek_i64(sln, 16 + k * 8)
                    w: 0
                    as long as w < _sov_list_len(gen)
                        nl2: _sov_list_add(nl2, peek_i64(gen, 16 + w * 8))
                        ns2: _sov_list_add(ns2, kln)
                        w: w + 1
                    w: k + 1
                    as long as w < n
                        nl2: _sov_list_add(nl2, peek_i64(ls, 16 + w * 8))
                        ns2: _sov_list_add(ns2, peek_i64(sln, 16 + w * 8))
                        w: w + 1
                    inl2_out: nl2
                    inl2_sln: ns2
                    return 1
        k: k + 1
    return 0

inl2_mkcn lines ci:
    inl2_cn: _sov_list_new()
    cp: peek_i64(inl2_params, 16 + ci * 8)
    qi: 0
    as long as qi < _sov_list_len(cp)
        inl2_cn: licm_add(inl2_cn, peek_i64(cp, 16 + qi * 8))
        qi: qi + 1
    k: 0
    as long as k < _sov_list_len(lines)
        nm: licm_lhs(strip_span(peek_i64(lines, 16 + k * 8)))
        if length(nm) > 0
            inl2_cn: licm_add(inl2_cn, nm)
        k: k + 1
inl2_scan lines sln ci:
    dummy: inl2_lopen()
    if inl2_okm is 0
        inl2_okm: _sov_list_new()
        inl2_okb: _sov_list_new()
        mi: 0
        as long as mi < _sov_list_len(inl2_bodies)
            inl2_okm: _sov_list_add(inl2_okm, 9)
            inl2_okb: _sov_list_add(inl2_okb, 0)
            mi: mi + 1
    cur: lines
    cs: sln
    ch: 0
    pass: 0
    as long as pass < 32
        if inl2_one(cur, cs, ci) is 1
            cur: inl2_out
            cs: inl2_sln
            ch: 1
        if not
            pass: 32
        pass: pass + 1
    if ch is 1
        inl2_out: cur
        inl2_sln: cs
    return ch
licm_scan lines:
    # repeated single hoists (max 16) until fixpoint.
    if stmt_lns is 0
        return 0
    # Both hoisters open with the same header hunt (first non-blank
    # byte in {a,w,d} + licm_whdr); a body with no loop header makes
    # each of them walk every line for nothing, so settle it once.
    lh_any: 0
    lh_n: _sov_list_len(lines)
    lh_k: 0
    as long as lh_k < lh_n
        if lh_any is 0
            lh_lk: peek_i64(lines, 16 + lh_k * 8)
            lh_sp: 0
            lh_fb: peek_byte(lh_lk, 0)
            as long as lh_fb is 32
                lh_sp: lh_sp + 1
                lh_fb: peek_byte(lh_lk, lh_sp)
            if lh_fb is 97
                if licm_whdr(strip_span(lh_lk)) > 0
                    lh_any: 1
            if lh_fb is 119
                if licm_whdr(strip_span(lh_lk)) > 0
                    lh_any: 1
            if lh_fb is 100
                if licm_whdr(strip_span(lh_lk)) > 0
                    lh_any: 1
        lh_k: lh_k + 1
    if lh_any is 0
        return 0
    cur: lines
    cs: stmt_lns
    ch: 0
    it: 0
    as long as it < 16
        did: 0
        if licm_one(cur, cs) is 1
            cur: licm_out
            cs: licm_sln
            ch: 1
            did: 1
        if did is 0
            if licm2_one(cur, cs) is 1
                cur: licm_out
                cs: licm_sln
                ch: 1
                did: 1
        if did is 0
            it: 16
        it: it + 1
    if ch is 1
        licm_out: cur
        licm_sln: cs
        return 1
    return 0

try_peekscan_while cond blines lines li:
    # partition-scan loop (Hoare quicksort inner walks):
    #   as long as peek_i64(V, C + i * 8) OP P
    #       i: i + 1        (or i - 1)
    # with OP in < <= > >=.  One cmp against [r8+r11*8] per step
    # (V+ C in r8, i in r11, P in r10) instead of the generic walk's
    # arg-register shuffles and push/pop comparison -- ~10 µops per
    # element down to ~3, which is where quicksort spends its life.
    if has_vm is 0
        return 0
    if leaf8 is 1
        return 0
    if _sov_list_len(blines) is not 1
        return 0
    c0: strip(cops(cond))
    op: 0
    pp: look(c0, " <= ")
    if pp > 0 - 1
        op: 2
    if op is 0
        pp: look(c0, " >= ")
        if pp > 0 - 1
            op: 4
    if op is 0
        pp: look(c0, " < ")
        if pp > 0 - 1
            op: 1
    if op is 0
        pp: look(c0, " > ")
        if pp > 0 - 1
            op: 3
    if op is 0
        return 0
    lhs: scut(c0, 0, pp)
    rhsp: pp + 3
    if op is 2
        rhsp: pp + 4
    if op is 4
        rhsp: pp + 4
    rhs: scutr(c0, rhsp)
    if _sov_starts_with(lhs, "peek_i64(") is 0
        return 0
    if peek_byte(lhs, length(lhs) - 1) is not 41
        return 0
    al: split_args(cut(lhs, 9, length(lhs) - 1), _sov_list_new())
    if _sov_list_len(al) is not 2
        return 0
    vnm: repl(strip(peek_i64(al, 16)), " ", "_")
    idx: repl(strip(peek_i64(al, 24)), " ", "_")
    if plain_name(vnm) is 0
        return 0
    pnm: repl(rhs, " ", "_")
    pimm: 0
    if is_imm(pnm) is 1
        pimm: 1
    if pimm is 0
        if plain_name(pnm) is 0
            return 0
    l1: strip(_sov_list_get(blines, 0))
    isep: look(l1, ": ")
    if isep < 1
        return 0
    iv: repl(scut(l1, 0, isep), " ", "_")
    if plain_name(iv) is 0
        return 0
    if lsh_find_s(iv) < 0
        return 0
    step: 0
    if _sov_str_eq(l1, join(iv, join(": ", join(iv, " + 1")))) is 1
        step: 1
    if _sov_str_eq(l1, join(iv, join(": ", join(iv, " - 1")))) is 1
        step: 0 - 1
    if step is 0
        return 0
    csc: fdx_idxoff(idx, join(iv, "_*_8"))
    if csc < 0
        return 0
    if _sov_str_eq(iv, vnm) is 1
        return 0
    if pimm is 0
        if _sov_str_eq(pnm, iv) is 1
            return 0
        if _sov_str_eq(pnm, vnm) is 1
            return 0
    cflush_all()
    loadv(vnm)
    emit3(73, 137, 192)
    if csc > 0
        emit3(73, 129, 192)
        emit4(csc)
    loadv(iv)
    emit3(73, 137, 195)
    if pimm is 1
        rax_imm(num_of(pnm))
    if not
        loadv(pnm)
    emit3(73, 137, 194)
    psc_j: jmp()
    align32()
    psc_hd: here()
    if step is 1
        emit3(73, 255, 195)
    if not
        emit3(73, 255, 203)
    patch(psc_j)
    emit3(79, 59, 20)
    emit(216)
    emit(15)
    if op is 1
        emit(143)
    if op is 2
        emit(141)
    if op is 3
        emit(140)
    if op is 4
        emit(142)
    psc_bk: here()
    emit4(0)
    put(psc_bk, psc_hd - (psc_bk + 4))
    emit3(76, 137, 216)
    storev(iv)
    cpx_p: 0 - 1
    return 1

try_bytecount_while cond blines lines li:
    # SWAR byte counting: iv from 0 while iv < lim with body
    #   if peek_byte(S, iv) is K
    #       cnt: cnt + 1
    #   iv: iv + 1
    # r8=S, r9=cnt, r10=lim, r11=iv, rcx=lim-7, rdx=0x0101.., rsi=broadcast(K).
    if has_vm is 0
        return 0
    if leaf8 is 1
        return 0
    if _sov_list_len(blines) is not 3
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(scut(c0, 0, p), " ", "_")
    lim: repl(scutr(c0, p + 3), " ", "_")
    if plain_name(iv) is 0
        return 0
    if lsh_find_s(iv) < 0
        return 0
    limn: 0
    if is_imm(lim) is 0
        if plain_name(lim) is 0
            return 0
        limn: 1
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    l3: strip(_sov_list_get(blines, 2))
    bq: li + 1
    bq_n: _sov_list_len(lines)
    bq_hav: 0
    bq_i0: 0 - 1
    bq_i1: 0 - 1
    as long as bq < bq_n
        if bq_hav < 2
            rwq: peek_i64(lines, 16 + bq * 8)
            plq: strip(rwq)
            if length(plq) > 0
                if peek_byte(plq, 0) is not 35
                    if bq_hav is 0
                        bq_i0: sg_ind(rwq)
                    if bq_hav is 1
                        bq_i1: sg_ind(rwq)
                    bq_hav: bq_hav + 1
        bq: bq + 1
    if bq_i1 <= bq_i0
        return 0
    if _sov_str_eq(l3, join(iv, join(": ", join(iv, " + 1")))) is 0
        return 0
    if _sov_starts_with(l1, "if peek_byte(") is 0
        return 0
    cp: cfind1(l1, 41)
    if cp < 14
        return 0
    al: split_args(cut(l1, 13, cp), _sov_list_new())
    if _sov_list_len(al) is not 2
        return 0
    snm: repl(strip(peek_i64(al, 16)), " ", "_")
    ix: repl(strip(peek_i64(al, 24)), " ", "_")
    if plain_name(snm) is 0
        return 0
    if _sov_str_eq(ix, iv) is 0
        return 0
    rest: scutr(l1, cp + 1)
    if _sov_starts_with(rest, "is ") is 0
        return 0
    ktxt: scutr(rest, 3)
    if is_imm(ktxt) is 0
        return 0
    bc_kv: num_of(ktxt)
    if bc_kv > 255
        return 0
    tc: look(l2, ": ")
    if tc < 1
        return 0
    cnm: repl(scut(l2, 0, tc), " ", "_")
    if plain_name(cnm) is 0
        return 0
    if _sov_str_eq(scutr(l2, tc + 2), join(cnm, " + 1")) is 0
        return 0
    if _sov_str_eq(cnm, iv) is 1
        return 0
    if _sov_str_eq(cnm, snm) is 1
        return 0
    if _sov_str_eq(snm, iv) is 1
        return 0
    if limn is 1
        if _sov_str_eq(lim, cnm) is 1
            return 0
        if _sov_str_eq(lim, snm) is 1
            return 0
        if _sov_str_eq(lim, iv) is 1
            return 0
    wind: sg_ind(_sov_list_get(lines, li))
    jj: li - 1
    got0: 0
    seen: 0
    as long as jj >= 0
        if got0 is 0
            rw: _sov_list_get(lines, jj)
            pl: strip(rw)
            if length(pl) > 0
                if peek_byte(pl, 0) is not 35
                    if sg_ind(rw) is not wind
                        jj: 0 - 1
                    if not
                        seen: seen + 1
                        if seen > 4
                            jj: 0 - 1
                        if not
                            if _sov_str_eq(pl, join(iv, ": 0")) is 1
                                got0: 1
                            if not
                                if _sov_starts_with(pl, join(iv, ": ")) is 1
                                    jj: 0 - 1
        jj: jj - 1
    if got0 is 0
        return 0
    cflush_all()
    loadv(snm)
    emit3(73, 137, 192)
    loadv(cnm)
    emit3(73, 137, 193)
    if limn is 1
        loadv(lim)
    if not
        rax_imm(num_of(lim))
    emit3(73, 137, 194)
    rax_imm(72340172838076673)
    emit3(72, 137, 194)
    kb: bc_kv
    kb: bor(kb, bshl(kb, 8))
    kb: bor(kb, bshl(kb, 16))
    kb: bor(kb, bshl(kb, 32))
    rax_imm(kb)
    emit3(72, 137, 198)
    emit3(76, 137, 209)
    emit3(72, 131, 233)
    emit(7)
    emit3(69, 49, 219)
    align32()
    bc_hd: here()
    emit3(73, 57, 203)
    bc_ge: jge()
    # exact zero-lane mask: ((x & 0x7F7F..) + 0x7F7F..) | x, inverted.
    # The classic (x - 0x0101..) & ~x form borrows across lanes and
    # false-counts a K^1 byte that follows a K byte in the same qword.
    emit3(75, 139, 4)
    emit(24)
    emit3(72, 49, 240)
    emit3(72, 137, 199)
    emit3(72, 137, 208)
    emit3(72, 193, 224)
    emit(7)
    emit3(72, 41, 208)
    emit3(72, 33, 199)
    emit3(72, 1, 199)
    emit3(75, 139, 4)
    emit(24)
    emit3(72, 49, 240)
    emit3(72, 9, 199)
    emit3(72, 247, 215)
    emit3(72, 137, 208)
    emit3(72, 193, 224)
    emit(7)
    emit3(72, 33, 248)
    emit3(72, 193, 232)
    emit(7)
    emit(72)
    emit(15)
    emit(175)
    emit(194)
    emit3(72, 193, 232)
    emit(56)
    emit3(73, 1, 193)
    chk_ov()
    emit3(73, 131, 195)
    emit(8)
    emit(233)
    bc_bk: here()
    emit4(0)
    put(bc_bk, bc_hd - (bc_bk + 4))
    patch(bc_ge)
    bc_tl: here()
    emit3(77, 57, 211)
    bc_dn: jge()
    emit3(67, 15, 182)
    emit(4)
    emit(24)
    emit(61)
    emit4(bc_kv)
    emit(117)
    bc_sk: here()
    emit(0)
    emit3(73, 255, 193)
    chk_ov()
    dummy: ocset(bc_sk, here() - (bc_sk + 1))
    emit3(73, 255, 195)
    emit(233)
    bc_bk2: here()
    emit4(0)
    put(bc_bk2, bc_tl - (bc_bk2 + 4))
    patch(bc_dn)
    emit3(76, 137, 200)
    storev(cnm)
    emit3(76, 137, 216)
    storev(iv)
    return 1

try_listsum_while cond blines lines li:
    # integer list reduction: iv from 0/1 while iv < lim with body
    #   S: S + list_get(L, iv)        (vec_get/_sov_list_get too)
    #   iv: iv + 1
    # requires lim: list_len(L) (or vec_len) in the pre-window so every
    # access is in bounds (list_get returns the index when out of bounds).
    # L in r8, accumulator r9, lim r10, iv r11; chk_ov per add.
    if has_vm is 0
        return 0
    if leaf8 is 1
        return 0
    if _sov_list_len(blines) is not 2
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(scut(c0, 0, p), " ", "_")
    lim: repl(scutr(c0, p + 3), " ", "_")
    if plain_name(iv) is 0
        return 0
    if lsh_find_s(iv) < 0
        return 0
    if plain_name(lim) is 0
        return 0
    if is_imm(lim) is 1
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    if _sov_str_eq(l2, join(iv, join(": ", join(iv, " + 1")))) is 0
        return 0
    tc: look(l1, ": ")
    if tc < 1
        return 0
    snm: repl(scut(l1, 0, tc), " ", "_")
    if plain_name(snm) is 0
        return 0
    rhs: scutr(l1, tc + 2)
    pfx: join(snm, " + ")
    if _sov_starts_with(rhs, pfx) is 0
        return 0
    ge: scutr(rhs, length(pfx))
    if _sov_starts_with(ge, "list_get(") is 0
        if _sov_starts_with(ge, "_sov_list_get(") is 0
            if _sov_starts_with(ge, "vec_get(") is 0
                return 0
    if peek_byte(ge, length(ge) - 1) is not 41
        return 0
    op: cfind1(ge, 40)
    al: split_args(cut(ge, op + 1, length(ge) - 1), _sov_list_new())
    if _sov_list_len(al) is not 2
        return 0
    lnm: repl(strip(peek_i64(al, 16)), " ", "_")
    ix: repl(strip(peek_i64(al, 24)), " ", "_")
    if plain_name(lnm) is 0
        return 0
    if _sov_str_eq(ix, iv) is 0
        return 0
    if _sov_str_eq(snm, iv) is 1
        return 0
    if _sov_str_eq(snm, lnm) is 1
        return 0
    if _sov_str_eq(snm, lim) is 1
        return 0
    if _sov_str_eq(lnm, iv) is 1
        return 0
    if _sov_str_eq(lnm, lim) is 1
        return 0
    if _sov_str_eq(iv, lim) is 1
        return 0
    ls_iv0: join(iv, ": 0")
    ls_iv1: join(iv, ": 1")
    ls_ln1: join(lim, join(": list_len(", join(lnm, ")")))
    ls_ln2: join(lim, join(": vec_len(", join(lnm, ")")))
    ls_ln3: join(lim, join(": _sov_list_len(", join(lnm, ")")))
    ls_piv: join(iv, ": ")
    ls_plm: join(lim, ": ")
    ls_pls: join(lnm, ": ")
    wind: sg_ind(_sov_list_get(lines, li))
    jj: li - 1
    got0: 0
    gotn: 0
    kval: 0
    seen: 0
    as long as jj >= 0
        if got0 + gotn < 2
            if gotn < 2
                rw: _sov_list_get(lines, jj)
                pl: strip(rw)
                if length(pl) > 0
                    if peek_byte(pl, 0) is not 35
                        if sg_ind(rw) is not wind
                            jj: 0 - 1
                        if not
                            seen: seen + 1
                            if seen > 6
                                jj: 0 - 1
                            if not
                                if _sov_starts_with(pl, ls_pls) is 1
                                    jj: 0 - 1
                                if not
                                    if _sov_str_eq(pl, ls_iv0) is 1
                                        got0: 1
                                    if not
                                        if _sov_str_eq(pl, ls_iv1) is 1
                                            got0: 1
                                            kval: 1
                                        if not
                                            if _sov_starts_with(pl, ls_piv) is 1
                                                jj: 0 - 1
                                    if _sov_str_eq(pl, ls_ln1) is 1
                                        gotn: 1
                                    if not
                                        if _sov_str_eq(pl, ls_ln2) is 1
                                            gotn: 1
                                        if not
                                            if _sov_str_eq(pl, ls_ln3) is 1
                                                gotn: 1
                                            if not
                                                if _sov_starts_with(pl, ls_plm) is 1
                                                    if gotn is 0
                                                        jj: 0 - 1
        if got0 is 1
            if gotn is 1
                jj: 0 - 1
        jj: jj - 1
    if got0 is 0
        return 0
    if gotn is 0
        return 0
    cflush_all()
    loadv(lnm)
    emit3(73, 137, 192)
    loadv(snm)
    emit3(73, 137, 193)
    loadv(lim)
    emit3(73, 137, 194)
    if kval is 0
        emit3(69, 49, 219)
    if not
        emit(73)
        emit(199)
        emit(195)
        emit(1)
        emit(0)
        emit(0)
        emit(0)
    emit3(77, 57, 211)
    ls_ge: jge()
    align32()
    ls_hd: here()
    emit3(79, 3, 140)
    emit(216)
    emit4(16)
    chk_ov()
    emit3(73, 255, 195)
    emit3(77, 57, 211)
    emit(15)
    emit(140)
    ls_bk: here()
    emit4(0)
    put(ls_bk, ls_hd - (ls_bk + 4))
    patch(ls_ge)
    emit3(76, 137, 200)
    storev(snm)
    emit3(76, 137, 216)
    storev(iv)
    return 1

try_append_while cond blines lines li:
    # append loop: iv from 0 while iv < lim with body
    #   L: list_add(L, EXPR)      (or _sov_list_add)
    #   iv: iv + 1
    # list in r8, len in r9, lim in r10, iv in r11. slow path (alloc/grow,
    # incl L == 0) calls the written function name and resyncs.
    if has_vm is 0
        return 0
    if leaf8 is 1
        return 0
    if _sov_list_len(blines) is not 2
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(scut(c0, 0, p), " ", "_")
    lim0: scutr(c0, p + 3)
    lim: repl(lim0, " ", "_")
    if plain_name(iv) is 0
        return 0
    if lsh_find_s(iv) < 0
        return 0
    limn: 0
    if is_imm(lim) is 0
        if plain_name(lim) is 0
            return 0
        limn: 1
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    if _sov_str_eq(l2, join(iv, join(": ", join(iv, " + 1")))) is 0
        return 0
    tc: look(l1, ": ")
    if tc < 1
        return 0
    lnm: repl(scut(l1, 0, tc), " ", "_")
    if plain_name(lnm) is 0
        return 0
    rhs: scutr(l1, tc + 2)
    fnm: blank
    if _sov_starts_with(rhs, "list_add(") is 1
        fnm: "list_add"
    if _sov_starts_with(rhs, "_sov_list_add(") is 1
        fnm: "_sov_list_add"
    if _sov_starts_with(rhs, "vec_push(") is 1
        fnm: "vec_push"
    if length(fnm) is 0
        return 0
    if peek_byte(rhs, length(rhs) - 1) is not 41
        return 0
    fp0: length(fnm) + 1
    al: split_args(cut(rhs, fp0, length(rhs) - 1), _sov_list_new())
    if _sov_list_len(al) is not 2
