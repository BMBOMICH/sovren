    add_rax_rcx()
    storev(acc)
    emit_name_or_imm(lim)
    storev(iv)
    patch(sk)
    if sk < 0
        print "PNSK"
tparams_g th line:
    if th is 0
        return _sov_list_new()
    tpl: tparams(line)
    if _sov_list_len(tpl) > 7
        print "Error: too many parameters (7 max)"
        _sov_print(tname(line))
        had_err: 1
    return tpl
tparams line:
    lst: _sov_list_new()
    s: strip(line)
    if is_task_hdr(s) is 1
        s: scut(s, 0, length(s) - 1)
        if _sov_starts_with(s, "task ") is 1
            s: scutr(s, 5)
        wp: look(s, " with ")
        if wp > 0 - 1
            s: scutr(s, wp + 6)
        if not
            sp: look(s, " ")
            if sp < 0
                return lst
            s: scutr(s, sp + 1)
        p: repl(s, ",", " ")
        p: repl(p, " and ", " ")
        start: 0
        i: 0
        n: length(p)
        one: blank
        as long as i < n
            tp_c: peek_byte(p, i)
            tp_sp: 0
            if tp_c is 32
                tp_sp: 1
            if tp_sp is 1
                one: scut(p, start, i)
            tp_ap: 0
            if tp_sp is 1
                tp_ap: 1
            if length(one) is 0
                tp_ap: 0
            if tp_ap is 1
                lst: _sov_list_add(lst, one)
            if tp_sp is 1
                start: i + 1
            i: i + 1
        one: scut(p, start, n)
        if length(one) > 0
            lst: _sov_list_add(lst, one)
        return lst
    rest: scutr(line, 5)
    wp: look(rest, " with ")
    if wp < 0
        return lst
    p: repl(cut(rest, wp + 6, length(rest)), ",", " and ")
    start: 0
    i: 0
    # tparams: 2nd split loop was dead (i=n after 1st); removed, tail kept
    # dead loop line 2 (placeholder keeps include ranges stable)
    # dead loop line 3 (placeholder keeps include ranges stable)
    # dead loop line 4 (placeholder keeps include ranges stable)
    # dead loop line 5 (placeholder keeps include ranges stable)
    # dead loop line 6 (placeholder keeps include ranges stable)
    # dead loop line 7 (placeholder keeps include ranges stable)
    one: repl(scut(p, start, n), " ", "_")
    if length(one) > 0
        lst: _sov_list_add(lst, one)
    return lst
prep_main names params bodies:
    thin_main: 0
    skip_al: blank
    fib_nm: blank
    fib_drop: 0
    fi: 0
    pm_n: _sov_list_len(names)
    as long as fi < pm_n
        if fi is entry_idx
            if _sov_list_len(_sov_list_get(params, fi)) is 0
                thin_main: 1
            main_params_n: _sov_list_len(_sov_list_get(params, fi))
            skip_al: dead_iota(_sov_list_get(bodies, fi))
        if fiblike(_sov_list_get(names, fi), _sov_list_get(params, fi), _sov_list_get(bodies, fi)) is 1
            fib_nm: _sov_list_get(names, fi)
        fi: fi + 1
    if length(fib_nm) > 0
        fib_drop: 1
        fi: 0
        fd_done: 0
        fd_n: _sov_list_len(names)
        aomark: join("addr_of ", fib_nm)
        as long as fi < fd_n
            if fd_done is 0
                if _sov_str_eq(peek_i64(names, 16 + fi * 8), fib_nm) is 0
                    bln: _sov_list_get(bodies, fi)
                    bi: 0
                    bn2: _sov_list_len(bln)
                    as long as bi < bn2
                        if fd_done is 0
                            if fib_call_var(_sov_list_get(bln, bi), fib_nm) is 1
                                fib_drop: 0
                                fd_done: 1
                                bi: bn2
                            if fd_done is 0
                                if look(_sov_list_get(bln, bi), aomark) > 0 - 1
                                    fib_drop: 0
                                    fd_done: 1
                                    bi: bn2
                        bi: bi + 1
            if fd_done is 1
                fi: fd_n
            fi: fi + 1
    if fib_drop is 1
        fn_names: _sov_list_add(fn_names, fib_nm)
        fn_offs: _sov_list_add(fn_offs, 0)
poke8 p off v:
    x: v
    i: 0
    as long as i < 8
        b: x % 256
        if b < 0
            b: b + 256
        dummy: poke_byte(p, off + i, b)
        x: x / 256
        i: i + 1
dir_of path:
    d: 0 - 1
    i: 0
    do_ln: length(path)
    as long as i < do_ln
        if peek_byte(path, i) is 47 is 1
            d: i
        i: i + 1
    if d < 0
        return "."
    return cut(path, 0, d + 1)
sp_lskip s:
    k: 0
    as long as 1
        b: peek_byte(s, k)
        if b is 32
            k: k + 1
        if not
            if b is 9
                k: k + 1
            if not
                if b is 10
                    k: k + 1
                if not
                    if b is 13
                        k: k + 1
                    if not
                        return s + k
sp_has_include t:
    # 1 iff some line's first non-whitespace bytes are `include ` -- the
    # only shape the long splice path acts on.  length() first: it maps
    # small-int and null "texts" to 0 (the walk below must not touch
    # them), and hands the bounded worker a hard limit so the x86 twin
    # (emit_nt_sp_inc, SWAR) never reads past the allocation.
    lim: length(t)
    if lim is 0
        return 0
    return sp_hinc_lim(t, lim)

sp_hinc_lim t lim:
    # bounded worker for sp_has_include: plain Sovren walk for other
    # backends; on x86 try_native_body plants emit_nt_sp_inc (SWAR).
    i: 0
    as long as i < lim
        j: i
        ws: 1
        as long as ws is 1
            if j >= lim
                ws: 0
            if ws is 1
                b: peek_byte(t, j)
                if b is 32
                    j: j + 1
                if not
                    if b is 9
                        j: j + 1
                    if not
                        if b is 13
                            j: j + 1
                        if not
                            ws: 0
        if j + 8 <= lim
            if peek_i64(t, j) is 2334382437353877097
                return 1
        e: cfind1n(t, i, lim, 10)
        if e < 0
            return 0
        i: e + 1
    return 0

sp_tdepth: 0
sp_slo: 0
sp_shi: 0

sp_find_inc t st lim:
    # line-start index of the next line at/after st whose sp_lskip
    # begins with "include ", or -1 (mirrors pu_find_use's walk).
    i: st
    as long as i < lim
        j: i
        ws: 1
        as long as ws is 1
            if j >= lim
                ws: 0
            if ws is 1
                b: peek_byte(t, j)
                if b is 32
                    j: j + 1
                if not
                    if b is 9
                        j: j + 1
                    if not
                        if b is 13
                            j: j + 1
                        if not
                            ws: 0
        if peek_byte(t, j) is 105
            if peek_byte(t, j + 1) is 110
                if peek_byte(t, j + 2) is 99
                    if peek_byte(t, j + 3) is 108
                        if peek_byte(t, j + 4) is 117
                            if peek_byte(t, j + 5) is 100
                                if peek_byte(t, j + 6) is 101
                                    if peek_byte(t, j + 7) is 32
                                        return i
        e: cfind1n(t, i, lim, 10)
        if e < 0
            return 0 - 1
        i: e + 1
    return 0 - 1

sp_inc_spec t li lnn:
    # If the include line starting at li (lnn = index of its newline
    # or the text length) is the plain form -- unindented, no span
    # numbers, no '#' pin, no '(...)' values -- set sp_slo/sp_shi to
    # the trimmed name span and return 1.  Anything else returns 0
    # and the line-based splice keeps its exact behavior.
    if peek_byte(t, li) is 32
        return 0
    k: li
    ws: 1
    as long as ws is 1
        if k >= lnn
            ws: 0
        if ws is 1
            kb: peek_byte(t, k)
            if kb is 32
                k: k + 1
            if not
                if kb is 9
                    k: k + 1
                if not
                    if kb is 13
                        k: k + 1
                    if not
                        ws: 0
    slo: k + 8
    shi: lnn
    go1: 1
    as long as go1 is 1
        if slo < shi
            if peek_byte(t, slo) < 33
                slo: slo + 1
            if not
                go1: 0
        if not
            go1: 0
    go2: 1
    as long as go2 is 1
        if shi > slo
            if peek_byte(t, shi - 1) < 33
                shi: shi - 1
            if not
                go2: 0
        if not
            go2: 0
    if slo >= shi
        return 0
    q: slo
    as long as q < shi
        qb: peek_byte(t, q)
        if qb is 32
            return 0
        if qb is 40
            return 0
        q: q + 1
    sp_slo: slo
    sp_shi: shi
    return 1

sp_splice_text src base:
    # Textual splice for files whose own include lines are all plain:
    # raw source segments and recursively spliced file texts are
    # joined in one buffer -- the same bytes the line path produces
    # (it rejoins every line with a newline), without splitting every
    # included file into a line list first.  Returns 0 to decline.
    # Single walk: the old code ran sp_find_inc over the whole text
    # twice (a validate pass, then a build pass); the walk now collects
    # [li, lnn, slo, shi] records once, still declining on the first
    # non-plain form BEFORE any file is loaded (the validate pass's
    # exact decision point), then builds from the records.
    sn: length(src)
    rec_li: _sov_list_new()
    rec_lnn: _sov_list_new()
    rec_slo: _sov_list_new()
    rec_shi: _sov_list_new()
    cur: 0
    ag1: 1
    as long as ag1 is 1
        li: sp_find_inc(src, cur, sn)
        if li < 0
            ag1: 0
        if li >= 0
            le: cfind1n(src, li, sn, 10)
            lnn: le
            if le < 0
                lnn: sn
            if sp_inc_spec(src, li, lnn) is 0
                return 0
            rec_li: _sov_list_add(rec_li, li)
            rec_lnn: _sov_list_add(rec_lnn, lnn)
            rec_slo: _sov_list_add(rec_slo, sp_slo)
            rec_shi: _sov_list_add(rec_shi, sp_shi)
            cur: lnn + 1
            if le < 0
                ag1: 0
    segp: _sov_list_new()
    segl: _sov_list_new()
    tot: 0
    seg: 0
    ri: 0
    rn: _sov_list_len(rec_li)
    bg1: 1
    as long as bg1 is 1
        if ri >= rn
            bg1: 0
        if ri < rn
            li: peek_i64(rec_li, 16 + ri * 8)
            lnn: peek_i64(rec_lnn, 16 + ri * 8)
            rslo: peek_i64(rec_slo, 16 + ri * 8)
            rshi: peek_i64(rec_shi, 16 + ri * 8)
            ri: ri + 1
            pname: cut(src, rslo, rshi)
            cp1: pname
            cp2: join(base, pname)
            cp3: join("library/", pname)
            f: load_file(cp1)
            if f is 0
                f: load_file(cp2)
            if f is 0
                f: load_file(cp3)
            if f is 0
                print "Error: include not found:"
                _sov_print(pname)
                err_where()
                had_err: 1
                fail()
            if sp_tdepth > 63
                print "Error: include nesting too deep (cycle?)"
                fail()
            sp_tdepth: sp_tdepth + 1
            inner: splice_inc(f, base)
            sp_tdepth: sp_tdepth - 1
            if li > seg
                segp: _sov_list_add(segp, src + seg)
                segl: _sov_list_add(segl, li - seg)
                tot: tot + li - seg
            inl: length(inner)
            if inl > 0
                segp: _sov_list_add(segp, inner)
                segl: _sov_list_add(segl, inl)
                tot: tot + inl
            if tot > 134217728
                print "Error: include expansion runaway (span includes itself?)"
                _sov_print(pname)
                err_where()
                had_err: 1
                fail()
            seg: lnn + 1
            if lnn >= sn
                seg: sn
    if seg < sn
        segp: _sov_list_add(segp, src + seg)
        segl: _sov_list_add(segl, sn - seg)
        tot: tot + sn - seg
    buf: _sov_heap_alloc(tot + 2)
    w: 0
    ci: 0
    cn: _sov_list_len(segp)
    as long as ci < cn
        cln: peek_i64(segl, 16 + ci * 8)
        dummy: _sov_mem_copy(buf + w, peek_i64(segp, 16 + ci * 8), cln)
        w: w + cln
        ci: ci + 1
    if w > 0
        if peek_byte(buf, w - 1) is not 10
            poke_byte(buf, w, 10)
            w: w + 1
    poke_byte(buf, w, 0)
    return buf

splice_inc src base:
    # include-free sources (the common fresh-build case) pay one anchored
    # probe here instead of the full line-split round trip; the rebuilt
    # buffer the long path returns ends with exactly one newline, so
    # mirror that.  (The old anywhere-substring probe degenerated its
    # Boyer-Moore skip on the needle's trailing space.)
    if sp_has_include(src) is 0
        sn: length(src)
        if sn is 0
            return src
        if peek_byte(src, sn - 1) is 10
            return src
        nlb: _sov_heap_alloc(2)
        d1: _sov_set_byte(nlb, 0, 10)
        d2: _sov_set_byte(nlb, 1, 0)
        return str_cat(src, nlb)
    sp_tx: sp_splice_text(src, base)
    if sp_tx is not 0
        return sp_tx
    b: base
    # one splice asks for the same handful of files thousands of times
    # (the inc/* patchworks): read and split each distinct file once per
    # splice instead of once per include line.  In-run only, like a
    # symbol table; nothing is kept between compilations.
    inc_mp: _sov_list_new()
    inc_mf: _sov_list_new()
    inc_hint_n: 0
    # lines_of already returns the SWAR descriptor list; keep this splice on
    # the fast splitter explicitly (identical records, no per-line copies).
    lst: lines_of_fast(src)
    pass: 0
    pass_count: 0
    go: 1
    as long as go is 1
        go: 0
        pass: pass + 1
        pass_count: pass
        # PS42ek: the pass cap was 8, so a legal acyclic chain nine-plus deep
        # died with a bogus "cycle?" error (the parity harness nests 12).
        # 64 keeps the cycle terminator (a cycle still spins out) and lets
        # real include trees through; chains of eight or fewer never reach
        # the changed branch, so their products are byte-identical.
        if pass > 64
            print "Error: include nesting too deep (cycle?)"
            fail()
        acc: _sov_list_new()
        acc_bytes: 0
        i: 0
        n: _sov_list_len(lst)
        as long as i < n
            line: peek_i64(lst, 16 + i * 8)
            t: sp_lskip(line)
            if _sov_starts_with(t, "include ") is 1
                # no new pass is needed for this line itself; a pass only runs
                # again when a spliced line is itself an include
                spec: scutr(t, 8)
                pname: spec
                from: 0
                nlin: 0
                dgh: 0
                pars: _sov_list_new()
                op: look(spec, "(")
                if op > 0 - 1
                    # values for a shared block: include inc/incNN.sov 4 3 (7 8 9)
                    pars: sg_toks(cut(spec, op + 1, length(spec) - 1))
                    spec: scut(spec, 0, op)
                sp1: look(spec, " ")
                if sp1 > 0 - 1
                    pname: cut(spec, 0, sp1)
                    w2: scutr(spec, sp1 + 1)
                    sp2: look(w2, " ")
                    if sp2 > 0 - 1
                        from: num_of(cut(w2, 0, sp2))
                        rest2: scutr(w2, sp2 + 1)
                        sp3: look(rest2, " ")
                        if sp3 > 0 - 1
                            nlin: num_of(cut(rest2, 0, sp3))
                            dgs: scutr(rest2, sp3 + 1)
                            if peek_byte(dgs, 0) is 35
                                dgh: num_of(cut(dgs, 1, length(dgs)))
                            if peek_byte(dgs, 0) is not 35
                                # older spans pin the hash bare, with no
                                # leading '#': an unchecked pin is how
                                # drifted spans spliced wrong lines silently
                                dgh: num_of(dgs)
                        if not
                            nlin: num_of(rest2)
                    if not
                        nlin: num_of(w2)
                cp1: pname
                cp2: join(b, pname)
                cp3: join("library/", pname)
                fl: 0
                mi: 0
                as long as mi < _sov_list_len(inc_mp)
                    mk: _sov_list_get(inc_mp, mi)
                    if _sov_str_eq(mk, cp1) is 1
                        fl: _sov_list_get(inc_mf, mi)
                    if _sov_str_eq(mk, cp2) is 1
                        fl: _sov_list_get(inc_mf, mi)
                    if _sov_str_eq(mk, cp3) is 1
                        fl: _sov_list_get(inc_mf, mi)
                    mi: mi + 1
                if fl is 0
                    f: load_file(cp1)
                    cp: cp1
                    if f is 0
                        f: load_file(cp2)
                        cp: cp2
                    if f is 0
                        f: load_file(cp3)
                        cp: cp3
                    if f is 0
                        print "Error: include not found:"
                        _sov_print(pname)
                        err_where()
                        had_err: 1
                        fail()
                    fl: lines_of_fast(f)
                    inc_mp: _sov_list_add(inc_mp, cp)
                    inc_mf: _sov_list_add(inc_mf, fl)
                ipc: 0
                as long as peek_byte(line, ipc) is 32
                    ipc: ipc + 1
                ip: cut(line, 0, ipc)
                j: 0
                m: _sov_list_len(fl)
                if nlin > 0
                    if from > 0
                        j: from - 1
                    m: j + nlin
                    if m > _sov_list_len(fl)
                        m: _sov_list_len(fl)
                sj: j
                sm: m
                as long as j < m
                    fj: _sov_list_get(fl, j)
                    fs: sp_lskip(fj)
                    if length(pars) > 0
                        if peek_byte(fs, 0) is not 0
                            fj: sg_psub(fj, pars)
                            fs: sp_lskip(fj)
                    if _sov_starts_with(fs, "include ") is 1
                        go: 1
                    if peek_byte(fs, 0) is not 0
                        if length(ip) > 0
                            fj: join(ip, fj)
                    acc_bytes: acc_bytes + length(fj)
                    if acc_bytes > 134217728
                        # nested indented includes can also blow up by
                        # line LENGTH (indent prefixes accrete per pass)
                        # while the line count stays small: bound bytes
                        print "Error: include expansion runaway (span includes itself?)"
                        _sov_print(pname)
                        err_where()
                        had_err: 1
                        fail()
                    acc: _sov_list_add(acc, fj)
                    if _sov_list_len(acc) > 1048576
                        # a span that includes its own include line
                        # multiplies the text every pass and eats all
                        # memory before the pass cap can speak: bound
                        # the expansion itself, mid-pass, and refuse
                        print "Error: include expansion runaway (span includes itself?)"
                        _sov_print(pname)
                        err_where()
                        had_err: 1
                        fail()
                    j: j + 1
                # pin protocol: a positive pin (with or without '#') is a
                # strict anchor; a negative pin is a tolerant drift-hint:
                # report the found hash (the 9901001 line tools/
                # lineage_repinline.py harvests) but only when it really
                # drifted, and at most twenty times a splice - the old
                # unconditional print made gigabyte logs on big splices
                if dgh > 0
                    if inc_span_hash(fl, sj, sm) is not dgh
                        print "Error: include drifted (edit above a span?):"
                        _sov_print(pname)
                        print from
                        print nlin
                        print inc_span_hash(fl, sj, sm)
                        err_where()
                        had_err: 1
                        fail()
                if dgh < 0
                    hh: inc_span_hash(fl, sj, sm)
                    if hh is not dgh
                        if inc_hint_n < 20
                            print 9901001
                            _sov_print(pname)
                            print from
                            print nlin
                            print hh
                            inc_hint_n: inc_hint_n + 1
            if not
                acc: _sov_list_add(acc, line)
            i: i + 1
        lst: acc
    total: 0
    i: 0
    n: _sov_list_len(lst)
    as long as i < n
        total: total + length(_sov_list_get(lst, i)) + 1
        i: i + 1
    buf: _sov_heap_alloc(total + 1)
    pos: 0
    i: 0
    as long as i < n
        ln: _sov_list_get(lst, i)
        k: 0
        lnlen: length(ln)
        as long as k < lnlen
            dset: _sov_set_byte(buf, pos, peek_byte(ln, k))
            pos: pos + 1
            k: k + 1
        dset: _sov_set_byte(buf, pos, 10)
        pos: pos + 1
        i: i + 1
    dset: _sov_set_byte(buf, pos, 0)
    return buf

# inc_span_hash — deterministic digest of an include span (raw lines a..b-1).
# Used by the "#<digest>" include form so an edit above any span fails the
# build loudly instead of silently splicing the wrong region.
inc_span_hash fl a b:
    h: 7
    i: a
    as long as i < b
        ln: _sov_list_get(fl, i)
        j: 0
        ih_ln: length(ln)
        as long as j < ih_ln
            h: bxor(h * 16777619, peek_byte(ln, j))
            j: j + 1
        i: i + 1
    return h

# dup_check_now — post-parse duplicate-name + arity rejection (see PS9).
# Runs after the deep-cache merge so `names`/`params` are the final lists.
dup_check_now:
    dn: _sov_list_len(names)
    dht: _sov_heap_alloc(16384 * 16)
    di: 0
    as long as di < 16384
        poke_i64(dht, di * 16, 0)
        di: di + 1
    di: 0
    as long as di < dn
        dnm: peek_i64(names, 16 + di * 8)
        dsl: band(nhash(dnm), 16383)
        dfound: 0
        dj: 0
        as long as dj < 16384
            dslot: peek_i64(dht, dsl * 16)
            if dslot is 0
                dj: 16384
            if dfound is 1
                dj: 16384
            if dslot is not 0
                if _sov_str_eq(dslot, dnm) is 1
                    dfound: 1
                if dfound is 0
                    dsl: dsl + 1
                if dsl is 16384
                    dsl: 0
                if dfound is 0
                    dj: dj + 1
        if dfound is 1
            print "Error: two with the same name"
            _sov_print(dnm)
            had_err: 1
        if dfound is 0
            poke_i64(dht, dsl * 16, dnm)
        di: di + 1
    dp2: _sov_list_len(params)
    di: 0
    as long as di < dp2
        dpl: peek_i64(params, 16 + di * 8)
        if _sov_list_len(dpl) > 7
            print "Error: too many parameters (7 max)"
            _sov_print(peek_i64(names, 16 + di * 8))
            had_err: 1
        di: di + 1
    return 0
# auto-built from runtime.sov - base64, no escapes ever appear
rt_b64_cat:
    t: ""
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
    t: join(t, "")
