storev name:
    dhf_s: plog_str(4, name)
    ci: cn_lookup(name)
    if ci > 0 - 1
        cemt: _sov_list_set(cemt, ci, 1)
    i: lsh_find_s(name)
    if i > 0 - 1
        store_loc(i)
        return
    g: gn_lookup(name)
    if g > 0 - 1
        store_glob(name)
        return
    store_loc(slot(name))
strip t:
    if t is 0
        return blank
    return _sov_trim(t)
