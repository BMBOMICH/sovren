    put(jb, st - (jb + 4))
    patch(z)
    if jb < 0
        print "PN2902"
emit_sumsq_closed acc iv lim:
    limn: 0
    if _sov_str_eq(lim, kn) is 1
        if kv > 0
            limn: kv
    if limn is 0
        if length(lim) > 0
            if digitb(peek_byte(lim, 0)) is 1
                if look(lim, " ") < 0
                    limn: num_of(lim)
    if limn < 1
        return
    if limn > 2147483647
        return
    nn: limn
    cc: nn * 2 - 1
