# --- collect_body twin (the walk's per-task body collector): the C port is
# planted from compilers/linux/collect_native.sov (generated from
# tools/native_collect.c) for the self-hosted build; this wrapper is the
# portable fallback for every other program. The _sov_ prefix makes
# walk_range consult nt_will_twin with no sx_force_native line.
cb_tbl: 0
cb_arblk: 0
cb_tbl_init:
    cb_tbl: _sov_heap_alloc(64)
    cb_arblk: _sov_heap_alloc(16)
    poke_i64(cb_arblk, 0, 0)
    poke_i64(cb_arblk, 8, 0)
    poke_i64(cb_tbl, 0, 7)
    poke_i64(cb_tbl, 8, addr_of cb_ir_get)
    poke_i64(cb_tbl, 16, addr_of cb_mode_get)
    poke_i64(cb_tbl, 24, addr_of syntax_block_end)
    poke_i64(cb_tbl, 32, addr_of strip)
    poke_i64(cb_tbl, 40, addr_of nind)
    poke_i64(cb_tbl, 48, addr_of _sov_heap_alloc)
    poke_i64(cb_tbl, 56, addr_of cb_arblk_get)
    return 0
cb_arblk_get:
    return cb_arblk
cb_ir_get:
    return syntax_body_ir
cb_mode_get:
    return syntax_mode
_sov_collect_body lines start bind tbl:
    return collect_body(lines, start, bind)
cops text:
    if cfind1(text, 32) < 0
        return text
    r: text
    if look(text, " is ") > 0 - 1
        r: repl(r, " is not ", " != ")
        r: repl(r, " is ", " == ")
    if look(text, " and ") > 0 - 1
        r: repl(r, " and ", " && ")
    if look(text, " or ") > 0 - 1
        r: repl(r, " or ", " || ")
    return r
cn_dstk: 0
cset name val:
    dhc_x: plog_cset(name, val)
