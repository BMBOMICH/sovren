try_cat_while cond blines lines li:
    # string-builder loop: iv from 0 while iv < lim with body
    #   S: str_cat(S, EXPR)
    #   iv: iv + 1
    # EXPR is a string literal or a plain name != S,iv.  A runtime
    # builder (_sov_sb_new/_sov_sb_add) accumulates with geometric
    # growth, so the loop is O(total bytes) instead of alloc+copy of
    # the whole prefix per iteration (O(n^2)).  r8=builder, r10=lim,
    # r11=iv; the finished string is builder+16.
    if has_vm is 0
        return 0
    if leaf8 is 1
        return 0
    if _sov_list_len(blines) is not 2
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(scut(c0, 0, p), " ", "_")
    lim0: scutr(c0, p + 3)
    lim: repl(lim0, " ", "_")
    if plain_name(iv) is 0
        return 0
    if lsh_find_s(iv) < 0
        return 0
    limn: 0
    if is_imm(lim) is 0
        if plain_name(lim) is 0
            return 0
        limn: 1
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    if _sov_str_eq(l2, join(iv, join(": ", join(iv, " + 1")))) is 0
        return 0
    tc: look(l1, ": ")
    if tc < 1
        return 0
    snm: repl(scut(l1, 0, tc), " ", "_")
    if plain_name(snm) is 0
        return 0
    if _sov_str_eq(snm, iv) is 1
        return 0
    if lsh_find_s(snm) < 0
        return 0
    rhs: scutr(l1, tc + 2)
    if _sov_starts_with(rhs, "str_cat(") is 0
        return 0
    if peek_byte(rhs, length(rhs) - 1) is not 41
        return 0
    al: split_args(cut(rhs, 8, length(rhs) - 1), _sov_list_new())
    if _sov_list_len(al) is not 2
        return 0
    a0: repl(strip(peek_i64(al, 16)), " ", "_")
    if _sov_str_eq(a0, snm) is 0
        return 0
    ex: strip(peek_i64(al, 24))
    exk: 0 - 1
    exl: blank
    if _sov_starts_with(ex, "\"") is 1
        if length(ex) > 1
            if peek_byte(ex, length(ex) - 1) is 34
                exk: 0
                exl: cut(ex, 1, length(ex) - 1)
    if exk < 0
        exn: repl(ex, " ", "_")
        if plain_name(exn) is 1
            if _sov_str_eq(exn, iv) is 0
                if _sov_str_eq(exn, snm) is 1
                    exk: 2
                if not
                    exk: 1
                    exl: exn
    if exk < 0
        return 0
    if limn is 1
        if _sov_str_eq(lim, snm) is 1
            return 0
        if _sov_str_eq(lim, iv) is 1
            return 0
    wind: sg_ind(_sov_list_get(lines, li))
    jj: li - 1
    got0: 0
    seen: 0
    as long as jj >= 0
        if got0 is 0
            rw: _sov_list_get(lines, jj)
            pl: strip(rw)
            if length(pl) > 0
                if peek_byte(pl, 0) is not 35
                    if sg_ind(rw) is not wind
                        jj: 0 - 1
                    if not
                        seen: seen + 1
                        if seen > 4
                            jj: 0 - 1
                        if not
                            if _sov_str_eq(pl, join(iv, ": 0")) is 1
                                got0: 1
                            if not
                                if _sov_starts_with(pl, join(iv, ": ")) is 1
                                    jj: 0 - 1
        jj: jj - 1
    if got0 is 0
        return 0
    cflush_all()
    if limn is 1
        loadv(lim)
    if not
        rax_imm(num_of(lim))
    emit3(73, 137, 194)
    emit3(77, 133, 210)
    cskp: jle()
    loadv(snm)
    emit3(72, 137, 199)
    emit2(65, 82)
    calln("_sov_sb_new")
    emit2(65, 90)
    emit3(73, 137, 192)
    emit3(69, 49, 219)
    align32()
    chd: here()
    if exk is 0
        rax_str(exl)
        emit3(72, 137, 198)
    if exk is 1
        loadv(exl)
        emit3(72, 137, 198)
    if exk is 2
        emit3(73, 141, 112)
        emit(16)
    emit3(76, 137, 199)
    emit2(65, 83)
    emit2(65, 82)
    calln("_sov_sb_add")
    emit2(65, 90)
    emit2(65, 91)
    emit3(73, 137, 192)
    emit3(73, 255, 195)
    emit3(77, 57, 211)
    emit(15)
    emit(140)
    cbk: here()
    emit4(0)
    put(cbk, chd - (cbk + 4))
    emit3(76, 137, 192)
    emit(72)
    emit(131)
    emit(192)
    emit(16)
    storev(snm)
    cp_nm: 0
    cp_pend_kill: 1
    emit3(76, 137, 216)
    storev(iv)
    cej: jmp()
    patch(cskp)
    patch(cej)
    return 1

try_def_peek var rhs:
    if has_vm is 0
        return 0
    if sv_lookup(var) > 0 - 1
        return 0
    dv: homereg(var)
    if dv < 0
        return 0
    q: fop2(rhs, "+", "-")
    if q < 1
        return 0
    if q > length(rhs) - 2
        return 0
    opc: peek_byte(rhs, q)
    if opc is not 43
        if opc is not 45
            return 0
    dl: scut(rhs, 0, q)
    dr: scutr(rhs, q + 1)
    if pkpeek(dl) is 0
        return 0
    dg: pk_g
    dx1: pk_x
    if pkpeek(dr) is 0
        return 0
    if _sov_str_eq(pk_g, dg) is 0
        return 0
    hr: peek_home(pk_x)
    if hr is dv
        return 0
    if hr < 0
        scaled_rdx(pk_x)
        hr: 2
    loadv_rdi(dg)
    hl: peek_home(dx1)
    if hl < 0
        scaled_rsi(dx1)
        hl: 6
    peek_reg_h(dv, hl)
    if opc is 45
        fold_mem_h(43, dv, hr)
    if not
        fold_mem_h(3, dv, hr)
    return 1
try_fill_while cond blines lines li:
    if _sov_list_len(blines) is not 2
        return 0
    c: strip(cops(cond))
    p: look(c, " < ")
    if p < 0
        return 0
    iv: repl(scut(c, 0, p), " ", "_")
    lim0: scutr(c, p + 3)
    lim: repl(lim0, " ", "_")
    if plain_name(iv) is 0
        return 0
    want0: join(iv, ": 0")
    jj: li - 1
    found: 0
    as long as jj >= 0
        pl: strip(_sov_list_get(lines, jj))
        if length(pl) > 0
            if peek_byte(pl, 0) is not 35
                if _sov_starts_with(pl, "use ") is 0
                    if _sov_str_eq(pl, want0) is 1
                        found: 1
                    jj: 0 - 1
        jj: jj - 1
    if found is 0
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    pb1: "poke_byte("
    fl: blank
    if _sov_starts_with(l1, pb1) is 1
        fl: l1
    if _sov_starts_with(l2, pb1) is 1
        fl: l2
    if length(fl) is 0
        return 0
    inc_r: join(iv, join(": ", join(iv, " + 1")))
    bumped: 0
    if _sov_str_eq(l1, inc_r) is 1
        bumped: 1
    if _sov_str_eq(l2, inc_r) is 1
        bumped: 1
    if bumped is 0
        return 0
    if peek_byte(fl, length(fl) - 1) is 41 is 0
        return 0
    inn: cut(fl, 10, length(fl) - 1)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    base: repl(scut(inn, 0, c1), " ", "_")
    rest: cut(inn, c1 + 1, length(inn))
    c2: look(rest, ",")
    if c2 < 0
        return 0
    idx2: repl(scut(rest, 0, c2), " ", "_")
    vvv: scutr(rest, c2 + 1)
    if _sov_str_eq(idx2, iv) is 0
        return 0
    if is_imm(vvv) is 0
        return 0
    vv: num_of(vvv)
    if vv < 0
        return 0
    if vv > 255
        return 0
    if plain_name(base) is 0
        return 0
    cflush_all()
    loadv(base)
    mov_rdi_rax()
    if is_imm(lim) is 1
        rax_imm(num_of(lim))
    if not
        expr(lim0)
    mov_rsi_rax()
    chk_mem(1)
    emit(72)
    emit(137)
    emit(241)
    rax_imm(vv)
    emit(252)
    emit(243)
    emit(170)
    emit(72)
    emit(137)
    emit(240)
    storev(iv)
    return 1
try_lea_arg ag ai:
    p: look(ag, " - ")
    neg: 1
    if p < 0
        p: look(ag, " + ")
        neg: 0
    if p < 0
        return 0
    nm: scut(ag, 0, p)
    cs: scutr(ag, p + 3)
    if plain_name(nm) is 0
        return 0
    if is_imm(cs) is 0
        return 0
    v: num_of(cs)
    if neg is 1
        v: 0 - v
    if v > 127
        return 0
    if v < 0 - 128
        return 0
    if v is 0
        return 0
    sl: reg_slot(nm)
    if sl < 0
        return 0
    cflush(nm)
    emit_lea_arg(ai, sl, v)
    return 1
try_mem name argc m0 m1 m2 i2 v2:
    nid: ik_cached(name)
    if nid is kid_pkb
        if argc is 3
            if m0 > 0 - 1
                if m1 > 0 - 1
                    if m2 > 0 - 1
                        mem_poke_byte_reg(m0, m1, m2)
                        return 1
                    if i2 is 1
                        mem_poke_byte_imm(m0, m1, v2)
                        return 1
    if nid is kid_peb
        if argc is 2
            if m0 > 0 - 1
                if m1 > 0 - 1
                    mem_peek_byte(m0, m1)
                    return 1
    return 0
try_inline_pkb nm ac al:
    # call-site inline for peek_byte in the standard model (self-builds
    # only: nat_gate). exactness: peek_byte is a raw byte read (s[i]);
    # OOB reads hit the zero-filled bump arena exactly as the native does.
    # register contract identical to the call it replaces: rax = result,
    # rax/rcx clobbered (both were call-clobbered anyway).
    if nat_gate is 0
        return 0
    if ac is not 2
        return 0
    if _sov_str_eq(nm, "peek_byte") is 0
        return 0
    a0: _sov_list_get(al, 0)
    a1: _sov_list_get(al, 1)
    if plain_name(a0) is 0
        return 0
    if is_imm(a1) is 1
        v: num_of(a1)
        if v > 0 - 1
            if v < 128
                cflush_globs()
                loadv(a0)
                emit3(15, 182, 64)
                emit(v)
                return 1
        if v > -2147483648
            if v < 2147483647
                cflush_globs()
                loadv(a0)
                emit3(15, 182, 128)
                emit4(v)
                return 1
        return 0
    ap: look(a1, " + ")
    if ap > 0 - 1
        h: scut(a1, 0, ap)
        k2: scutr(a1, ap + 3)
        if plain_name(h) is 1
            if is_imm(k2) is 1
                pk_kv: num_of(k2)
                if pk_kv > 0
                    if pk_kv < 128
                        cflush_globs()
                        loadv(a0)
                        emit3(72, 137, 193)
                        loadv(h)
                        emit3(72, 131, 192)
                        emit(pk_kv)
                        emit3(15, 182, 4)
                        emit(1)
                        return 1
    am: look(a1, " - ")
