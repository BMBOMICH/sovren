emit_nt_intern_kid_n:
    # Volatile-only frameless hit path for intern_kid_n(rdi=s, rsi=n).
    prof_emit("prof_bytes_scanned", 6)
    load_glob("kid_ht")
    test_rax()
    iknd1: jz()
    emit3(73, 137, 192)
    load_glob("kid_slots")
    prof_emit("prof_hash_probes", 0 - 1)
    emit:
        76 141 72 255 184 5 21 0 0 49 201 72 133 246 116 19
        15 182 20 15 72 107 192 33 72 1 208 72 255 193 72 57 241 114 237
        73 137 194 77 33 202 69 49 219 75 139 4 208 72 133 192 116 44
        128 60 48 0 117 24 72 133 246 116 18 49 201 138 20 15 58 20 8
        117 9 72 255 193 72 57 241 114 240 195 73 255 194 77 33 202 73 255 195
        77 57 203 118 203
    # --- run end reached two ways: the empty-slot je (rax = 0, the loaded
    # slot value) or probe exhaustion (rax != 0: the last probed slot was
    # occupied). Distinguish, then take the native insert path only for the
    # empty slot. Assembled/diff-verified in scripts/ik_insert.s. Register
    # map at entry: rdi=s, rsi=n, r8=kid_ht, r9=slots-1, r10=slot. ---
    emit:
        72 133 192
    ikex: jnz()
    # growth check: kcnt*3 > kid_slots -> delegate
    load_glob("kcnt")
    emit:
        72 107 192 3 73 141 81 1 72 57 208
    ikng: jg()
    emit:
        73 137 243
    load_glob("kid_pool")
    emit:
        72 137 194 72 139 10
    load_glob("kid_poolcap")
    emit:
        74 141 116 25 2 72 57 198
    iknp: jg()
    emit:
        72 137 200 72 141 116 2 8
        72 135 254 76 137 217 243 164 198 7 0
        74 141 4 24 72 255 192 72 137 2
        76 41 216 72 255 200 72 141 68 2 8 73 137 195
        79 137 28 208
    load_glob("kcnt")
    emit:
        72 255 192
    store_glob("kcnt")
    emit:
        76 137 216
    emit(195)
    # --- delegate tail: exhaustion (ikex), growth (ikng), pool overflow
    # (iknp) and init (iknd1, kid_ht is 0) tail-jump to the verbatim body. ---
    patch(ikex)
    patch(ikng)
    patch(iknp)
    patch(iknd1)
    emit(233)
    iknj: here()
    emit4(0)
    addp(iknj, "rel", "intern_kid_n_full")
    return 1

emit_nt_intern_kid:
    # fast HIT path of intern_kid (rbx = s after copyargs): djb2 the
    # string, probe the CURRENT table, return the canonical pointer on
    # a str_eq hit.  Every other shape delegates to intern_kid_full,
    # the verbatim Sovren body: kid_ht is 0 (init), empty slot (insert
    # +/- pool growth), probe exhaustion.  Skipping the kgrow check on
    # hits is safe: growth preserves canonical pointers, so a hit here
    # returns exactly what the Sovren body would return after growing.
    # fn_save_n is 5 for the Sovren body, so r12-r15 are free to use.
    # (Replaces the old plant, which hardcoded a fixed 65536-slot table
    # with no growth and none of the kid_slots/kid_poolcap/kcnt upkeep.)
    load_glob("kid_ht")
    test_rax()
    ikd1: jz()
    emit:
        73 137 198
        72 137 222 184 5 21 0 0 49 201
    ikhl: here()
    prof_emit("prof_bytes_scanned", 0 - 1)
    emit:
        15 182 20 14 132 210
    ikdn: jz()
    emit:
        72 107 192 33 72 1 208 72 255 193 233
    iknx: here()
    emit4(0)
    put(iknx, ikhl - (iknx + 4))
    patch(ikdn)
    emit:
        73 137 196
    load_glob("kid_slots")
    emit:
        73 137 197 76 137 234 72 255 202 73 33 212 69 49 255
    ikpb: here()
    prof_emit("prof_hash_probes", 0 - 1)
    emit:
        79 139 4 230 77 133 192
    ikd2: jz()
    emit:
        76 137 199 72 137 222
    calln("_sov_str_eq")
    test_rax()
    ikne: jz()
    emit:
        75 139 4 230
    leave()
    ret()
    patch(ikne)
    # advance block + probe loop backedge
    emit:
        73 255 196 76 137 234 72 255 202 73 33 212 73 255 199 77 57 239 15 140
    emit4(ikpb - (here() + 4))
    # probe-loop exhaustion falls through here -> delegate (never happens;
    # the guard is slots, the load factor is < 1/3, but keep it exact).
    ikexf: jmp()
    # --- native INSERT path (ikd2 = first empty slot; assembled in
    # scripts/ik_insert.s and diff-verified with as/objdump). Growth
    # (kcnt*3 > kid_slots) and pool overflow (off+n+2 > kid_poolcap)
    # still delegate to intern_kid_full, which re-hashes, grows and
    # re-probes the way the Sovren body always did. Register map at
    # entry: rbx=s, r14=kid_ht, r13=kid_slots, r12=slot, r15=guard. ---
    patch(ikd2)
    load_glob("kcnt")
    emit:
        72 107 192 3
        76 57 232
    ikig: jg()
    emit:
        72 49 201
    iknl: here()
    emit:
        15 182 20 11 132 210
    iknz: jz()
    emit:
        72 255 193 233
    iknx2: here()
    emit4(0)
    put(iknx2, iknl - (iknx2 + 4))
    patch(iknz)
    emit:
        73 137 200
    load_glob("kid_pool")
    emit:
        73 137 193 73 139 17
    load_glob("kid_poolcap")
    emit:
        78 141 84 2 2 73 57 194
    ikp1: jg()
    emit:
        78 141 84 10 8 76 137 215 72 137 222 76 137 193
        243 164 198 7 0
        74 141 4 2 72 255 192 73 137 1
        79 137 20 230
    load_glob("kcnt")
    emit:
        72 255 192
    store_glob("kcnt")
    emit:
        76 137 208
    leave()
    ret()
    # --- delegate block: init (ikd1), exhaustion (ikexf), growth (ikig),
    # pool overflow (ikp1) all run the verbatim Sovren body. ---
    patch(ikexf)
    patch(ikig)
    patch(ikp1)
    patch(ikd1)
    emit:
        72 137 223
    calln("intern_kid_full")
    leave()
    ret()
    return 1

