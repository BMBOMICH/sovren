load_file path:
    fd: _sov_open(path, 0)
    if fd < 0
        return 0
    sz: _sov_lseek(fd, 0, 2)
    _sov_lseek(fd, 0, 0)
    if sz < 1
        _sov_close(fd)
        return 0
    buf: _sov_heap_alloc(sz + 1)
    got: _sov_read(fd, buf, sz)
    _sov_close(fd)
    dummy: poke_byte(buf, got, 0)
    return buf
