            emit3(76, 137, 216)
            return
    emit3(72, 139, 133)
    emit4(loc_off(slot))
loadv name:
    if peek_byte(name, 0) is 98
        if word_id(name) is kid_blank
            rax_str("")
            return
    fl_x5: fl_expand(name)
    if peek_byte(fl_x5, 0) is not 0
        dummy: expr(fl_x5)
        return
    cflush(name)
    i: lsh_find_s(name)
    if i > 0 - 1
        load_loc(i)
        return
    g: gn_lookup(name)
    if g > 0 - 1
        load_glob(name)
        return
    print "Error: undeclared name"
    _sov_print(name)
    err_where()
    had_err: 1
    xor_rax()

