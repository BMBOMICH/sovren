M32: 4294967296
M32M: 4294967295
w32 x:
    return band(x, M32M)
wand a b:
    return band(band(a, b), M32M)
wor a b:
    return band(bor(a, b), M32M)
wxor a b:
    return band(bxor(a, b), M32M)
wnot a:
