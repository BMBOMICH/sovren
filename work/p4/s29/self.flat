    if ds > 0
        rx: rx + 1
    ext: 0 - 1
    if kid is kid_wrap_add -> ext: 0
    if kid is kid_opbor -> ext: 1
    if kid is kid_opband -> ext: 4
    if kid is kid_wrap_sub -> ext: 5
    if kid is kid_opbxor -> ext: 6
    if ext > 0 - 1
        emit(rx)
        emit(129)
        emit(192 + ext * 8 + lo)
        emit4(v)
