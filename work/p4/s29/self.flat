try_self_chain var rhs:
    if sv_lookup(var) > 0 - 1
        return 0
    ds: reg_slot(var)
    if ds < 0
        return 0
    # pre-gate: the chain loop's first test needs a '(' in the stripped
    # rhs at index >= 1; without any '(' nothing below can fire, so
    # decline before allocating the op lists and the strip copy.
    if cfind1(rhs, 40) < 1
        return 0
    tsc_ops: _sov_list_new()
    tsc_opr: _sov_list_new()
    cur: strip(rhs)
    ok: 0
    steps: 0
    as long as steps < 8
        steps: steps + 1
        lp: look(cur, "(")
        if lp < 1
            return 0
        if peek_byte(cur, length(cur) - 1) is not 41
            return 0
        if sc_balanced(cur, lp) is 0
            return 0
        nm: scut(cur, 0, lp)
        if plain_name(nm) is 0
            return 0
        kid: intern_kid(nm)
        if sc_allowed(kid) is 0
            return 0
        inside: cut(cur, lp + 1, length(cur) - 1)
        al: _sov_list_new()
        al: split_args(inside, al)
        if _sov_list_len(al) is not 2
            return 0
        a0: strip(peek_i64(al, 16))
        a1: strip(peek_i64(al, 24))
        if _sov_str_eq(repl(a0, " ", "_"), var) is 1
            tsc_ops: _sov_list_add(tsc_ops, kid)
            tsc_opr: _sov_list_add(tsc_opr, a1)
            ok: 1
            steps: 99
        if not
            if _sov_list_len(tsc_ops) is 0
                if _sov_str_eq(repl(a1, " ", "_"), var) is 1
                    if sc_commut(kid) is 1
                        tsc_ops: _sov_list_add(tsc_ops, kid)
                        tsc_opr: _sov_list_add(tsc_opr, a0)
                        ok: 1
                        steps: 99
            if ok is 0
                tsc_ops: _sov_list_add(tsc_ops, kid)
                tsc_opr: _sov_list_add(tsc_opr, a1)
                cur: a0
    if ok is 0
        return 0
    cflush(var)
    ci: _sov_list_len(tsc_ops) - 1
    as long as ci >= 0
        opr: peek_i64(tsc_opr, 16 + ci * 8)
        opk: peek_i64(tsc_ops, 16 + ci * 8)
        dun: 0
        if is_imm(opr) is 1
            dun: sc_emit_op_imm(opk, ds, num_of(opr))
        if dun is 0
            sc_rcx(opr)
            sc_emit_op(opk, ds)
        ci: ci - 1
    return 1
si_ops: 0
si_oprs: 0
si_skip_sp inn p n:
    go: 1
    as long as go is 1
        if p >= n
            go: 0
        if go is 1
            if peek_byte(inn, p) is 32
                p: p + 1
            if not
                go: 0
    return p
si_word_end inn p n:
    go: 1
    as long as go is 1
        if p >= n
            go: 0
        if go is 1
            if wordchar(peek_byte(inn, p)) is 1
                p: p + 1
            if not
                go: 0
    return p
si_opk oc:
    if oc is 42
        return kid_wrap_mul
    if oc is 43
        return kid_wrap_add
    if oc is 45
        return kid_wrap_sub
    return 0
si_is_wrap kid0:
    if kid0 is kid_opband
        return 1
    if kid0 is kid_opbor
        return 1
    if kid0 is kid_opbxor
        return 1
    return 0
si_parse var inn:
    vn: length(var)
    n: length(inn)
    if sg_match(inn, 0, var) is 0
        return 0
    if n is vn
        return 0
    if peek_byte(inn, vn) is not 32
        return 0
    si_ops: _sov_list_new()
    si_oprs: _sov_list_new()
    p: vn
    bad: 0
    sadd: 0
    as long as p < n
        if bad is 1
            p: n
        if p < n
            p: si_skip_sp(inn, p, n)
            if p >= n
                bad: 1
            if bad is 0
                opk: si_opk(peek_byte(inn, p))
                if opk is 0
                    bad: 1
                if bad is 0
                    # flat left-to-right emission is only exact while the
                    # chain never returns to '*' after '+'/'-' (Sovren
                    # infix binds '*' tighter).
                    ism: 0
                    if opk is kid_wrap_mul
                        ism: 1
                    if ism is 1
                        if sadd is 1
                            bad: 1
                    if ism is 0
                        sadd: 1
            if bad is 0
                p: si_skip_sp(inn, p + 1, n)
                q: si_word_end(inn, p, n)
                if q is p
                    bad: 1
                if bad is 0
                    ot: cut(inn, p, q)
                    okv: is_imm(ot)
                    if okv is 0
                        okv: plain_name(ot)
                    if okv is 0
                        bad: 1
                    if bad is 0
                        si_ops: _sov_list_add(si_ops, opk)
                        si_oprs: _sov_list_add(si_oprs, ot)
                        p: q
    if bad is 1
        return 0
    if _sov_list_len(si_ops) is 0
        return 0
