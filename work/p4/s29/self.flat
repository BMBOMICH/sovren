emit_nt_substr:
    emit:
        73 137 250 73 137 243 73 137 209 49 192 73 129 250 0 16
        0 0 118 90 49 201 65 128 60 10 0 116 5 72 255 193
        235 244 77 133 219 121 3 77 49 219 73 57 201 118 3 73
        137 201 77 57 217 115 3 77 137 217 77 137 200 77 41 216
        73 141 120 1 80 65 80 65 82 65 83
    prof_emit("prof_bytes_copied", 0)
    calln("_sov_heap_alloc")
    emit:
        65 91 65 90 65 88 89 73 137 193 75 141 52 26 76 137
        207 76 137 193 243 164 67 198 4 1 0 76 137 200
    leave()
