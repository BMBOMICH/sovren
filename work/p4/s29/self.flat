ca_maybe h0 nm:
    if ca_tab is 0
        ca_seed()
    ix: band(h0, 511)
    as long as peek_i64(ca_tab, ix * 8) is not 0
        if peek_i64(ca_tab, ix * 8) is h0
            return _sov_str_eq(peek_i64(ca_ntab, ix * 8), nm)
        ix: band(ix + 1, 511)
    return 0
ca_nid: 0
call_args name argc direct:
    # Resolve the callee facts from the per-compilation name->facts table.
    # The table is keyed by the canonical interned kid, so a call site that
    # already knows the kid pays one hash probe instead of a symbol-table
    # scan, a delegate-map chase and a C-builtin string compare.
    cfnid: ca_nid
    ca_nid: 0
    if cfnid is 0
        cfnid: intern_kid(name)
    cfs: fsem_slot(cfnid)
    cfv: 0
    cft: 0
    cfc: 0
    if cfs >= 0
        cfv: peek_i64(fsem_val, cfs * 8)
        cft: peek_i64(fsem_tgt, cfs * 8)
        cfc: peek_i64(fsem_cah, cfs * 8)
    car: 0 - 1
    if fsem_key is not 0
        car: band(bshr(cfv, 9), 255)
    if car >= 0
        if car > 0
            if car - 1 is not argc
                print "Error: wrong number of values"
                _sov_print(name)
                err_where()
                had_err: 1
    if not
