emit_nt_list_add:
    # rdi=L rsi=v -> rax=L. L=[cap@0][len@8][items@16]. Volatile regs only.
    emit3(72, 133, 255)
    lanl: jz()
    emit3(72, 139, 71)
    emit3(8, 72, 59)
    emit(7)
    lagr: jae()
    emit3(72, 137, 116)
    emit3(199, 16, 72)
    emit3(255, 192, 72)
    emit3(137, 71, 8)
    emit3(72, 137, 248)
    leave()
    ret()
    patch(lanl)
    emit3(86, 72, 199)
    emit3(199, 80, 0)
    emit2(0, 0)
    calln("_sov_heap_alloc")
    emit3(94, 72, 199)
    emit3(0, 8, 0)
    emit3(0, 0, 72)
    emit3(199, 64, 8)
    emit3(1, 0, 0)
    emit3(0, 72, 137)
    emit2(112, 16)
    leave()
    ret()
    patch(lagr)
    emit3(87, 86, 72)
    emit3(139, 7, 72)
    emit2(133, 192)
    lag1: jnz()
    emit3(184, 4, 0)
    emit2(0, 0)
    patch(lag1)
    emit3(72, 1, 192)
    emit3(80, 72, 141)
    emit3(60, 197, 16)
    emit3(0, 0, 0)
    calln("_sov_heap_alloc")
    emit3(89, 94, 90)
    emit3(72, 137, 8)
    emit3(72, 139, 74)
    emit3(8, 72, 137)
    emit3(72, 8, 80)
    emit3(86, 81, 72)
    emit3(141, 120, 16)
    emit3(72, 141, 114)
    emit3(16, 243, 72)
    emit3(165, 89, 94)
    emit3(88, 72, 137)
    emit3(116, 200, 16)
    emit3(72, 255, 193)
    emit3(72, 137, 72)
    emit(8)
    leave()
    ret()
    return 1

emit_nt_intern:
    calln("intern_fast")
    leave()
    ret()
    return 1
emit_nt_bzero:
    # tiered: <=64B via overlapping qword stores (rep stosb setup
    # dominates at scrub sizes); big via rep stosb. Returns p.
    emit3(73, 137, 250)
    emit3(72, 133, 246)
    bzdn0: jz()
    emit3(72, 131, 254)
    emit(64)
    bzbg: jae()
    xor_rax()
    emit3(72, 131, 254)
    emit(8)
    bzq: jae()
    bzbl: here()
    emit3(72, 255, 206)
    emit3(136, 4, 55)
    emit3(72, 133, 246)
    emit2(15, 133)
    bzbk: here()
    emit4(0)
    put(bzbk, bzbl - (bzbk + 4))
    bzdn: jmp()
    patch(bzq)
    emit3(72, 137, 7)
    emit3(72, 137, 68)
    emit2(55, 248)
    emit3(72, 131, 254)
    emit(17)
    bz2: jae()
    bzdn2: jmp()
    patch(bz2)
    emit3(72, 137, 71)
    emit(8)
    emit3(72, 137, 68)
    emit2(55, 240)
    emit3(72, 131, 254)
    emit(33)
    bz3: jae()
    bzdn3: jmp()
    patch(bz3)
    emit3(72, 137, 71)
    emit(16)
    emit3(72, 137, 68)
    emit2(55, 232)
    emit3(72, 131, 254)
    emit(49)
    bz4: jae()
    bzdn4: jmp()
    patch(bz4)
    emit3(72, 137, 71)
    emit(24)
    emit3(72, 137, 68)
    emit2(55, 224)
    bzdn5: jmp()
    patch(bzbg)
    emit3(72, 137, 241)
    xor_rax()
    emit(243)
    emit(170)
    patch(bzdn0)
    patch(bzdn)
    patch(bzdn2)
    patch(bzdn3)
    patch(bzdn4)
    patch(bzdn5)
    emit3(76, 137, 208)
    leave()
