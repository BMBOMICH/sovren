    if nid is kid_wrap_sub
        if argc is 2
            syntax_call_bin(sx_ctree, sx_cnode, argl, "wsub")
            return 0
    if nid is kid_wrap_mul
        if argc is 2
            syntax_call_bin(sx_ctree, sx_cnode, argl, "wmul")
            return 0
    if nid is kid_opband
        if argc is 2
            syntax_call_bin(sx_ctree, sx_cnode, argl, "band")
            return 0
    if nid is kid_opbor
        if argc is 2
            syntax_call_bin(sx_ctree, sx_cnode, argl, "bor")
            return 0
    if nid is kid_opbxor
        if argc is 2
            syntax_call_bin(sx_ctree, sx_cnode, argl, "bxor")
