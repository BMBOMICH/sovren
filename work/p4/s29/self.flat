fold_bin oid a b:
    fold_ok: 0
    if oid is kid_opadd
        r: wrap_add(a, b)
        if band(bxor(a, r), bxor(b, r)) >= 0
            fold_ok: 1
            return r
        return 0
    if oid is kid_opsub
        r: wrap_sub(a, b)
        if band(bxor(a, b), bxor(a, r)) >= 0
            fold_ok: 1
            return r
        return 0
    if oid is kid_opmul
        aa: a
        if aa < 0
            aa: 0 - aa
        bb: b
        if bb < 0
            bb: 0 - bb
        if aa < 3037000500
            if bb < 3037000500
                fold_ok: 1
                return wrap_mul(a, b)
        return 0
    if oid is kid_opdiv
        if b is 0
            return 0
        if b is 0 - 1
            if a is 0 - 9223372036854775807 - 1
                return 0
        fold_ok: 1
        return a / b
    if oid is kid_opmod
        if b is 0
            return 0
        if b is 0 - 1
            if a is 0 - 9223372036854775807 - 1
                return 0
        fold_ok: 1
        return a % b
    if oid is kid_opband
        fold_ok: 1
        return band(a, b)
    if oid is kid_opbor
        fold_ok: 1
        return bor(a, b)
    if oid is kid_opbxor
        fold_ok: 1
        return bxor(a, b)
    if oid is kid_opbshl
        fold_ok: 1
        return bshl(a, band(b, 63))
    if oid is kid_opbshr
        fold_ok: 1
        return bshr(a, band(b, 63))
    if oid is kid_opbsar
        fold_ok: 1
        return bsar(a, band(b, 63))
    if oid is kid_opwadd
        fold_ok: 1
        return wrap_add(a, b)
    if oid is kid_opwsub
        fold_ok: 1
        return wrap_sub(a, b)
    if oid is kid_opwmul
        fold_ok: 1
        return wrap_mul(a, b)
    return 0

bin L R op:
    return bin_n(L, length(L), R, length(R), op)

bin_n L Ln R Rn op:
    return bin_k(L, Ln, R, Rn, intern_kid(op), 0, 0)

bin_k L Ln R Rn oid sx_tree sx_node:
    as long as Ln > 0
        bn_bb: peek_byte(L, 0)
        if bn_bb is 32 or bn_bb is 9 or bn_bb is 10 or bn_bb is 13
            L: L + 1
            Ln: Ln - 1
        if not
            leave
    as long as Ln > 0
        bn_bb: peek_byte(L, Ln - 1)
        if bn_bb is 32 or bn_bb is 9 or bn_bb is 10 or bn_bb is 13
            Ln: Ln - 1
        if not
            leave
    as long as Rn > 0
        bn_bb: peek_byte(R, 0)
        if bn_bb is 32 or bn_bb is 9 or bn_bb is 10 or bn_bb is 13
            R: R + 1
            Rn: Rn - 1
        if not
            leave
    as long as Rn > 0
        bn_bb: peek_byte(R, Rn - 1)
        if bn_bb is 32 or bn_bb is 9 or bn_bb is 10 or bn_bb is 13
            Rn: Rn - 1
        if not
            leave
    Limm: is_imm_n(L, Ln)
    Rimm: is_imm_n(R, Rn)
    Lb0: 0
    if Ln > 0
        Lb0: peek_byte(L, 0)
    Rb0: 0
    if Rn > 0
        Rb0: peek_byte(R, 0)
    if Limm is 1
        if Rimm is 1
