collect_body lines start bind:
    if syntax_mode > 0
        cb_end: syntax_block_end(lines, start, bind)
        if cb_end >= start
            cb_cnt: cb_end - start
            cb_out: _sov_heap_alloc(16 + (cb_cnt + 1) * 8)
            poke_i64(cb_out, 0, cb_cnt + 1)
            cb_k: 0
            cb_n: peek_i64(syntax_body_ir, 8)
            cb_j: start
            as long as cb_j < cb_end
                if peek_i64(syntax_body_ir, 16 + (cb_n * 9 + cb_j) * 8) is 1
                    cb_raw: peek_i64(lines, 16 + cb_j * 8)
                    cb_s: cb_raw + peek_i64(bt_ind, 16 + cb_j * 8)
                    if peek_i64(bt_tab, 16 + cb_j * 8) is not 0 or peek_i64(bt_tr, 16 + cb_j * 8) is not 0
                        cb_s: strip(cb_raw)
                    poke_i64(cb_out, 16 + cb_k * 8, cb_s)
                    cb_k: cb_k + 1
                cb_j: cb_j + 1
            poke_i64(cb_out, 8, cb_k)
            return cb_out
    out: _sov_list_new()
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: peek_i64(lines, 16 + j * 8)
        s: strip(raw)
        if peek_byte(s, 0) is 0
            j: j + 1
        if not
            if peek_byte(s, 0) is 35
                j: j + 1
            if not
                if nind(raw) > bind
                    out: _sov_list_add(out, s)
                    j: j + 1
                if not
