                if i is n - 1
                    return 1
                return 0
        i: i + 1
    return 0
sc_emit_op kid ds:
    lo: (ds + 3) % 8
    if kid is kid_wrap_mul
        rx: 72
        if ds > 0
            rx: rx + 4
        emit(rx)
        emit2(15, 175)
        emit(192 + lo * 8 + 1)
        return
    rx: 72
    if ds > 0
        rx: rx + 1
    emit(rx)
    if kid is kid_opband
        emit(33)
    if kid is kid_opbor
        emit(9)
    if kid is kid_opbxor
        emit(49)
    if kid is kid_wrap_add
        emit(1)
    if kid is kid_wrap_sub
        emit(41)
    if kid is kid_opbshl
        emit(211)
        emit(224 + lo)
        return
    if kid is kid_opbshr
        emit(211)
        emit(232 + lo)
        return
    if kid is kid_opbsar
        emit(211)
        emit(248 + lo)
        return
    emit(200 + lo)
sc_emit_op_imm kid ds v:
    # op reg_ds, imm32 (or imm8 for shifts) -- skips the rcx constant
    # reload in tight recurrence loops. Returns 0 when the value does
    # not fit the sign-extended imm32 form (caller uses sc_rcx).
    if v > 2147483647
        return 0
    if v < 0 - 2147483648
        return 0
    lo: (ds + 3) % 8
    if kid is kid_wrap_mul
        rxm: 72
        if ds > 0
            rxm: rxm + 5
        emit(rxm)
        emit(105)
        emit(192 + lo * 8 + lo)
        emit4(v)
        return 1
