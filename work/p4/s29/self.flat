                                    cset(var, 0)
                                    emit2(77, 49)
                                    emit(192 + 9 * (zl - 5))
                                    zi: cn_lookup(var)
                                    cemt: _sov_list_set(cemt, zi, 1)
                                    dhf_z2: plog_str(4, var)
                                    drop_str(var)
                                    return
            fa0: peek_byte(rhs, 0)
            fa_go: 0
            if digitb(fa0) is 1
                if cfind1(rhs, 32) < 0
                    if _sov_starts_with(rhs, "0x") is 1
                        rax_imm(num_of(rhs))
                        fa_go: 1
                    if fa_go is 0
                        if _sov_starts_with(rhs, "0b") is 1
                            rax_imm(num_of(rhs))
                            fa_go: 1
                    if fa_go is 0
                        if is_imm(rhs) is 1
                            rax_imm(num_of(rhs))
                            fa_go: 1
            if fa_go is 0
                if look(rhs, " ") < 0
                    if look(rhs, "(") < 0
                        if expr_atom(rhs) is 1
                            if expr_atom_word(rhs) is 1
                                loadv(rhs)
                                fa_go: 1
            if fa_go is 1
                typ: 0
                storev(var)
                drop_str(var)
                return
            cp_ok: 1
            cp_kill: 0
            typ: syntax_stmt_expr(sx_stree, sx_srole, 1, rhs)
            cp_ok: 0
            storev(var)
            if cpx_p > 0 - 1
                cp_nm: var
                cp_ln: cpx_p
                cp_txt: cpx_t
                cp_bid0: cp_bid
                cp_gen0: cp_gen
                cp_dep0: _sov_list_len(bk)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if _sov_starts_with(rhs, "_sov_strlen(") is 1
                if did_stos is 1
                    if kv > 0
                        kn: var
            return
    cp_nm: 0
    if wid is kid_private
        fw_on: 1
        return
    if wid is kid_wipe
            expr(scutr(s, 5))
            mov_rdi_rax()
            emit3(72, 133, 255)
            wsk: jz()
            emit(87)
            used_sl: 1
            calln("_sov_strlen")
            emit3(72, 137, 193)
            emit(95)
            xor_rax()
            emit3(252, 243, 170)
            patch(wsk)
            return
    if wid is kid_join
        if sx_stree is not 0 and sx_srole is 6
            syntax_stmt_lower(sx_stree)
        if not
            expr(scutr(s, 5))
        stmt_join_op()
        return
    if wid is kid_print
            arg: scutr(s, 6)
            if ends_times(arg) is 1
                head: scut(arg, 0, length(arg) - 6)
                sp: find_last_sp(head)
                if sp > 0 - 1
                    do_print_times(scut(head, 0, sp), scutr(head, sp + 1))
                    return
            if length(arg) >= 8
                if sg_match(arg, length(arg) - 8, " as text") is 1
                    expr(cut(arg, 0, length(arg) - 8))
                    mov_rdi_rax()
                    used_pr: 1
                    calln("_sov_print")
                    return
            if length(arg) >= 7
                if sg_match(arg, length(arg) - 7, " as ptr") is 1
                    expr(cut(arg, 0, length(arg) - 7))
                    mov_rdi_rax()
                    used_pr: 1
                    calln("_sov_print")
                    return
            if length(arg) > 1
                if peek_byte(arg, 0) is 34
                    lit: unesc(cut(arg, 1, length(arg) - 1))
                    emit_write_lit(join(lit, "\n"))
                    return
            if _sov_starts_with(arg, "peek_byte(") is 1
                if opt_imm > 0
                    emit_write_lit(i2s(opt_imm))
                    return
            if print_const(arg) is 1
                return
            typ: syntax_stmt_expr(sx_stree, sx_srole, 3, arg)
            mov_rdi_rax()
            if typ is 1
                used_pr: 1
                calln("_sov_print")
            if not
                used_pi: 1
                calln("_sov_print_int")
            return
    if wid is kid_return
        if peek_byte(s, 6) is 0
            if in_entry_now is 1
                if sxe_mode is 1
                    xor_rax()
                    leave()
                    ret()
                if not
                    emit2(49, 255)
                    emit_sys_num(60)
                    emit_sys_do()
                return
            if fw_on is 1
                if no_frame is 0
                    canary_check()
                    xor_rax()
                    restores()
                    frame_wipe()
                    stmt_leave_op()
                    ret()
                    return
            xor_rax()
            leave()
            ret()
            return
    if wid is kid_return
        if peek_byte(s, 6) is 32
            typ: syntax_stmt_expr(sx_stree, sx_srole, 4, s + 7)
            if typ is 1
                saw_str: 1
            if in_entry_now is 1
                if sxe_mode is 1
                    leave()
                    ret()
                if not
                    emit3(72, 137, 199)
                    emit_sys_num(60)
                    emit_sys_do()
                return
            if fw_on is 1
                if no_frame is 0
                    canary_check()
                    emit(80)
                    restores()
                    frame_wipe()
                    emit(88)
                    stmt_leave_op()
                    ret()
                    return
            leave()
            ret()
            return
    if wid is kid_stop
            emit2(49, 255)
            emit_sys_num(60)
            emit_sys_do()
            return
    if wid is kid_leave
            ld: _sov_list_len(bk) - 1
            lfound: 0
            lbad: 0
            as long as ld > 0 - 1
                lkind: peek_i64(bk, 16 + ld * 8)
                if lkind is kid_try
                    lbad: 1
                    ld: 0 - 1
                if not
                    if lkind is kid_except
                        lbad: 1
                        ld: 0 - 1
                    if not
                        if lkind is kid_while
                            lfound: ld + 1
                            ld: 0 - 1
                        if not
                            if lkind is kid_forever
                                lfound: ld + 1
                                ld: 0 - 1
                            if not
                                if lkind is kid_repeat
                                    lfound: ld + 1
                                    ld: 0 - 1
                                if not
                                    ld: ld - 1
            if lbad is 1
                print "Error: leave cannot cross try"
                _sov_print(s)
                err_where()
                had_err: 1
                return
            if lfound is 0
                print "Error: leave needs a loop around it"
                _sov_print(s)
                err_where()
                had_err: 1
                return
            ld: lfound - 1
            cflush_all()
            lx: peek_i64(bx, 16 + ld * 8)
            lx: _sov_list_add(lx, jmp())
            bx: _sov_list_set(bx, ld, lx)
            return
    if look(s, "(") < 0
        print "Error: bad line"
        _sov_print(s)
        err_where()
        had_err: 1
        return
    val_dead: 1
    syntax_stmt_expr(sx_stree, sx_srole, 5, s)
    val_dead: 0

# --- native statement lowering (bw attack phase C): _sov_stmt is the
# twin-planted entry (stmt_native.sov, generated from tools/native/
# native_stmt.c).  body()'s role fast path routes sxf lines here with the
# statement tree/role cursor and st_tbl, a function-pointer table with the
# Sovren ABI; the C port mirrors stmt()'s decision tree for exactly those
# lines and falls back to the interpreted stmt below for everything else
# (bt_ci restored first, so the fallback re-runs the identical path).
# Slot layout: tools/native/native_stmt.c enum, byte offset = 8 * slot.
st_tbl: 0
st_g_tree:
    return syntax_stmt_tree
st_g_role:
    return syntax_stmt_role
st_g_sline:
    return syntax_stmt_line
