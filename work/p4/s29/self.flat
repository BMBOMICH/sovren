            s: peek_i64(dro, 16 + (i) * 8)
            e: clen
            if i + 1 < nr
                e: peek_i64(dro, 16 + (i + 1) * 8)
            # Compact in place: kept ranges only ever move down (cum
            # starts at first_off and ranges ascend), so a forward blit
            # per range replaces the old per-byte list rebuild.
            if cum is not s
                if e > s
                    dummy_dc: _sov_blit(oc + cum, oc + s, e - s)
