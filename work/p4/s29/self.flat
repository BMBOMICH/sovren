    # checked-math trap text from a dead task) otherwise stay in strb
    # forever.  Rebuild the pool from the live str/strrel/str32 patches
    # and remap their vals.  Vals are byte offsets into the pool, so
    # the remap table indexes directly by old offset; copying from
    # each live offset independently also covers suffix-shared strings.
    sg_s1: intern_kid("str")
    sg_s2: intern_kid("strrel")
    sg_s3: intern_kid("str32")
    sg_sl: _sov_buf_len(strb)
    if sg_sl > 0
        sg_map: _sov_list_new()
        sg_i: 0
