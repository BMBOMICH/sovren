pu_nl t a b:
    # newline count in t[a, b) -- SWAR exact mask + bit-clear popcount.
    # (borrow-free form; (x-0x0101)&~x would false-count byte 11 after 10.)
    c: 0
    i: a
    nbc: 72340172838076673 * 10
    as long as i + 8 <= b
        q: peek_i64(t, i)
        xq: bxor(q, nbc)
        m: band(bxor(bor(band(xq, 9187201950435737471) + 9187201950435737471, xq), 0 - 1), 0 - 9187201950435737472)
        as long as m is not 0
            c: c + 1
            m: band(m, m - 1)
        i: i + 8
    as long as i < b
        if peek_byte(t, i) is 10
            c: c + 1
        i: i + 1
    return c

pull_uses pu_src:
    pu_n: length(pu_src)
    pu_i: 0
    pu_ln: 0
    ch: _sov_list_new()
    tot: 0
    as long as pu_i < pu_n
        pu_up: pu_find_use(pu_src, pu_i, pu_n)
        pu_hit: 0
        pu_e: pu_n
        if pu_up < 0
            pu_i: pu_n
        if pu_up >= 0
            pu_ln: pu_ln + pu_nl(pu_src, pu_i, pu_up)
            pu_j: pu_up
            pu_e: cfind1n(pu_src, pu_j, pu_n, 10)
            if pu_e < 0
                pu_e: pu_n
            pu_hit: 1
            if peek_byte(pu_src, pu_j + 3) is 58
                pu_hit: 2
        if pu_hit is 2
            pu_bi: pu_e + 1
            pu_bind: 0
            pu_bk: pu_j
            pu_bkw: 1
            as long as pu_bkw is 1
                if pu_bk <= 0
                    pu_bkw: 0
                if pu_bkw is 1
                    bb: peek_byte(pu_src, pu_bk - 1)
                    if bb is 32
                        pu_bk: pu_bk - 1
                        pu_bind: pu_bind + 1
                    if not
                        if bb is 9
                            pu_bk: pu_bk - 1
                            pu_bind: pu_bind + 1
                        if not
                            if bb is 13
                                pu_bk: pu_bk - 1
                                pu_bind: pu_bind + 1
                            if not
                                pu_bkw: 0
            pu_bgo: 1
            as long as pu_bgo is 1
                if pu_bi >= pu_n
                    pu_bgo: 0
                if pu_bgo is 1
                    pu_bj: pu_bi
                    pu_bws: 1
                    as long as pu_bws is 1
                        if pu_bj >= pu_n
                            pu_bws: 0
                        if pu_bj < pu_n
                            if peek_byte(pu_src, pu_bj) is 32
                                pu_bj: pu_bj + 1
                            if not
                                if peek_byte(pu_src, pu_bj) is 9
                                    pu_bj: pu_bj + 1
                                if not
                                    pu_bws: 0
                    pu_be: cfind1n(pu_src, pu_bj, pu_n, 10)
                    if pu_be < 0
                        pu_be: pu_n
                    if pu_bj is pu_be
                        pu_bgo: 0
                    if pu_bgo is 1
                        if pu_bj - pu_bi <= pu_bind
                            pu_bgo: 0
                    if pu_bgo is 1
                        err_line: pu_ln + 1
                        pu_tail: scut(pu_src, pu_bj, pu_be)
                        pu_sp: look(pu_tail, " as ")
                        pu_chunk: blank
                        if pu_sp > 0 - 1
                            pu_chunk: take_use(scut(pu_tail, 0, pu_sp), scutr(pu_tail, pu_sp + 4))
                        if pu_sp < 0
                            pu_chunk: take_use(pu_tail, "")
                        ch: _sov_list_add(ch, pu_chunk)
                        tot: tot + length(pu_chunk)
                        pu_ln: pu_ln + 1
                    if pu_bgo is 1
                        pu_bi: pu_be + 1
            pu_i: pu_bi - 1
            pu_e: pu_i
        if pu_hit is 1
            err_line: pu_ln + 1
            pu_line: scut(pu_src, pu_j, pu_e)
            pu_tail: scutr(pu_line, 4)
            pu_sp: look(pu_tail, " as ")
            pu_chunk: blank
            if pu_sp > 0 - 1
                pu_chunk: take_use(scut(pu_tail, 0, pu_sp), scutr(pu_tail, pu_sp + 4))
            if pu_sp < 0
                pu_chunk: take_use(pu_tail, "")
            ch: _sov_list_add(ch, pu_chunk)
            tot: tot + length(pu_chunk)
        pu_i: pu_e + 1
        pu_ln: pu_ln + 1
    if tot is 0
        return blank
    buf: _sov_heap_alloc(tot + 1)
    w: 0
    ci: 0
    cn: _sov_list_len(ch)
    as long as ci < cn
        s: peek_i64(ch, 16 + ci * 8)
        kl: length(s)
        dummy: _sov_mem_copy(buf + w, s, kl)
        w: w + kl
        ci: ci + 1
    dummy: poke_byte(buf, w, 0)
    return buf
pure_mul_atom t:
    if plain_name(t) is 0
        return 0
    if is_imm(t) is 1
        return 0
    if homereg(t) < 0
        return 0
    return 1
pure_mul_term t:
    p1: look(t, " * ")
    if p1 < 0
        return 0
    l: scut(t, 0, p1)
    r: scutr(t, p1 + 3)
    if look(l, " ") > 0 - 1
        return 0
    if pure_mul_atom(l) is 0
        return 0
    p2: look(r, " * ")
    if p2 < 0
        if look(r, " ") > 0 - 1
            return 0
        return pure_mul_atom(r)
    l2: scut(r, 0, p2)
    r2: scutr(r, p2 + 3)
    if look(r2, " ") > 0 - 1
        return 0
    if pure_mul_atom(l2) is 0
        return 0
    return pure_mul_atom(r2)
push_rax:
    emit(80)
    push_live: 1
put at n:
    # Walk br_id backwards: the forward version kept overwriting lf/lt on every
    # match and so kept the *last* one; the first match seen from the end is that
    # same entry, and it is normally the one this put is resolving, added to the
    # list a few emissions ago.
    lf: 0
    lt: at
    li: _sov_list_len(br_id)
    as long as li > 0
        li: li - 1
        if peek_i64(br_id, 16 + li * 8) is at
            if peek_i64(br_st, 16 + li * 8) is not 4
                lf: peek_i64(br_st, 16 + li * 8)
                lt: peek_i64(br_at, 16 + li * 8)
                li: 0
    if lf is 1
        if at < 0
            return 0
        v: n + at - lt
        if v < 0
            v: v + 4294967296
        i: 0
        as long as i < 4
            dummy: ocset(lt + i, v % 256)
            v: v / 256
            i: i + 1
        return 0
    if lf is 2
        if at < 0
            return 0
        v: n + at - lt + 4
        if v < 0
            v: v + 256
        dummy: ocset(lt - 1, v % 256)
        return 0
    if lf is 3
        if at < 0
            return 0
        v: n + at - lt + 3
        if v < 0
            v: v + 256
        dummy: ocset(lt, v % 256)
        return 0
    if br_relax(lt, n + at - lt) is 1
        return 0
    if at < 0
        return 0
    v: n + at - lt
    if v < 0
        v: v + 4294967296
    i: 0
    as long as i < 4
        dummy: ocset(lt + i, v % 256)
        v: v / 256
        i: i + 1
raw_scaled e:
    if length(e) < 5
        return 0 - 1
    if sg_match(e, length(e) - 4, " * 8") is 0
        return 0 - 1
    head: scut(e, 0, length(e) - 4)
    if length(head) is 0
        return 0 - 1
    if peek_byte(head, 0) is 40 is 1
        if peek_byte(head, length(head) - 1) is 41 is 0
            return 0 - 1
        inn: scut(head, 1, length(head) - 1)
        pp: look(inn, " + ")
        sg: 1
        if pp < 0
            pp: look(inn, " - ")
            sg: 0 - 1
        if pp < 0
            return 0 - 1
        l2: scut(inn, 0, pp)
        r2: scutr(inn, pp + 3)
        if name_ok(l2) is 0
            return 0 - 1
        if is_imm(r2) is 0
            return 0 - 1
        sl: reg_slot(l2)
        if sl < 0
            return 0 - 1
        kk: sg * num_of(r2) * 8
        if kk > 127
            return 0 - 1
        if kk < 0 - 128
            return 0 - 1
        cflush(l2)
        return sl * 4096 + kk + 128
    if look(head, " + ") > 0 - 1
        return 0 - 1
    if name_ok(head) is 0
        return 0 - 1
    sl: reg_slot(head)
    if sl < 0
        return 0 - 1
    cflush(head)
    return sl * 4096 + 128
