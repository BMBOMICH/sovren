emit_strlen:
    fn_names: _sov_list_add(fn_names, "_sov_strlen")
    fn_offs: _sov_list_add(fn_offs, here())
    dhl0: plog_h0()
    if prof_codegen is 1
        prof_strlen_stub()
        dhlc: plog_h1("_sov_strlen")
        return
    # strlen stub: page-safe SWAR. first block is the aligned word
    # containing ptr with pre-ptr bytes forced to 0xff (aligned 8b loads
    # never cross a page); constants hoisted out of the loop; the nul
    # position comes from bsf on the 0x80 mask, no byte tail loop.
    # ptr <= 0x1000 returns 0 (small ints / null are not strings).
    # clobbers rax rcx rdx rsi r8 r9, same set as the old stub.
    emit3(72, 129, 255)
    emit3(0, 16, 0)
    emit3(0, 118, 101)
    emit3(72, 137, 254)
    emit3(72, 137, 250)
