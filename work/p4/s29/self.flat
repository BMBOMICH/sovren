            nfn_offs: _sov_list_add(nfn_offs, cum)
            dshift: _sov_list_set(dshift, i, cum - s)
            cum: cum + (e - s)
        i: i + 1
    npat_at: _sov_list_new()
    npat_kind: _sov_list_new()
    npat_kid: _sov_list_new()
    npat_val: _sov_list_new()
    npat_line: _sov_list_new()
    # fresh owner window for the rebuild walk (same advancing rule over
    # the unchanged, ascending patch_at; identical owners to the merged
    # pass above without materializing the old downer list)
    ff2: 0
    pp: 0
    as long as pp < pn
        at2: peek_i64(patch_at, 16 + (pp) * 8)
        o: 0 - 1
        if at2 >= first_off
            adv2: 1
            as long as adv2 is 1
                if ff2 + 1 < nr
                    if at2 >= peek_i64(dro, 16 + (ff2 + 1) * 8)
                        ff2: ff2 + 1
                    if not
                        adv2: 0
                if not
                    adv2: 0
            o: ff2
        keep: 0
        ns: at2
        if o is 0 - 1
            keep: 1
        if not
            if peek_i64(dreach, 16 + (o) * 8) is 1
                keep: 1
                ns: ns + peek_i64(dshift, 16 + (o) * 8)
        if keep is 1
            npat_at: _sov_list_add(npat_at, ns)
            npat_kind: _sov_list_add(npat_kind, peek_i64(patch_kind, 16 + (pp) * 8))
            npat_kid: _sov_list_add(npat_kid, peek_i64(patch_kid, 16 + (pp) * 8))
            npat_val: _sov_list_add(npat_val, peek_i64(patch_val, 16 + (pp) * 8))
            npat_line: _sov_list_add(npat_line, peek_i64(patch_line, 16 + (pp) * 8))
        pp: pp + 1
