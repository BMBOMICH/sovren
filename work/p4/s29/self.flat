    if exk < 0
        return 0
    if _sov_str_eq(lnm, iv) is 1
        return 0
    if exk is 2
        if _sov_str_eq(ex, lnm) is 1
            return 0
        if _sov_str_eq(ex, iv) is 1
            return 0
    if limn is 1
        if _sov_str_eq(lim, lnm) is 1
            return 0
        if _sov_str_eq(lim, iv) is 1
            return 0
    wind: sg_ind(_sov_list_get(lines, li))
    jj: li - 1
    got0: 0
    seen: 0
    as long as jj >= 0
        if got0 is 0
            rw: _sov_list_get(lines, jj)
            pl: strip(rw)
            if length(pl) > 0
                if peek_byte(pl, 0) is not 35
                    if sg_ind(rw) is not wind
                        jj: 0 - 1
                    if not
                        seen: seen + 1
                        if seen > 4
                            jj: 0 - 1
                        if not
                            if _sov_str_eq(pl, join(iv, ": 0")) is 1
                                got0: 1
                            if not
                                if _sov_starts_with(pl, join(iv, ": ")) is 1
                                    jj: 0 - 1
        jj: jj - 1
    if got0 is 0
