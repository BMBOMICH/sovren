        ui: ui + 1
dce:
    if had_err is 1
        return
    n: _sov_list_len(fn_names)
    if n < 2
        return
    clen: oc_n
    dro: _sov_list_new()
    dri: _sov_list_new()
    i: 0
    as long as i < n
