        if argc is 2
            if _sov_str_eq(name, "str_cat") is 1
                sf1: strip(peek_i64(argl, 16))
                sf2: strip(peek_i64(argl, 24))
                ok1: 0
                i1: blank
                if is_lit(sf1) is 1
                    i1: cut(sf1, 1, length(sf1) - 1)
                    ok1: 1
                if not
                    if cp_len_of(sf1) > 0 - 1
                        i1: cp_txt_of(sf1)
                        ok1: 1
                ok2: 0
                i2: blank
                if is_lit(sf2) is 1
                    i2: cut(sf2, 1, length(sf2) - 1)
                    ok2: 1
                if not
                    if cp_len_of(sf2) > 0 - 1
                        i2: cp_txt_of(sf2)
                        ok2: 1
                if ok1 is 1
                    if ok2 is 1
                        rax_str(join(i1, i2))
                        return 1
    if is_spawn is 0
        inr: 0 - 1
        if fsem_key is not 0
