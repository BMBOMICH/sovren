lea_ok ag:
    p: look(ag, " - ")
    neg: 1
    if p < 0
        p: look(ag, " + ")
        neg: 0
    if p < 0
        return 0
    nm: scut(ag, 0, p)
    cs: scutr(ag, p + 3)
    if plain_name(nm) is 0
        return 0
    if is_imm(cs) is 0
        return 0
    v: num_of(cs)
    if neg is 1
        v: 0 - v
    if v > 127
        return 0
    if v < 0 - 128
        return 0
    if v is 0
        return 0
    if reg_slot(nm) < 0
        return 0
    return 1
leaf8_scan lines:

    li: 0
    li_ln: _sov_list_len(lines)
    as long as li < li_ln
        s: peek_i64(lines, 16 + li * 8)
        as long as peek_byte(s, 0) is 32
            s: s + 1
        as long as peek_byte(s, 0) is 9
            s: s + 1
        skip: 0
        if peek_byte(s, 0) is 0
            skip: 1
        if peek_byte(s, 0) is 35
            skip: 1
        if skip is 0
            cm: cfind1(s, 35)
            if cm > 0 - 1
                s: cut(s, 0, cm)
            if look(s, "_sov_") > 0 - 1
                return 0
            if look(s, "print") > 0 - 1
                return 0
            if look(s, "syscall") > 0 - 1
                return 0
            if look(s, "raise") > 0 - 1
                return 0
            if cfind1(s, 34) > 0 - 1
                return 0
            if look(s, "length of ") > 0 - 1
                return 0
            wd: word_id(s)
            if wd is kid_wipe
                return 0
            if wd is kid_join
                return 0
            if wd is kid_try
                return 0
            if wd is kid_except
                return 0
            p: 0
            as long as peek_byte(s, p) > 0
                if peek_byte(s, p) is 40
                    q: p
                    go: 1
                    as long as go is 1
                        if q is 0
                            go: 0
                        if not
                            b: peek_byte(s, q - 1)
                            if wordchar(b) is 1
                                q: q - 1
                            if not
                                go: 0
                    tn: p - q
                    ok: 0
                    if tn is 3
                        if sg_match(s, q, "bor") is 1
                            ok: 1
                    if tn is 4
                        if sg_match(s, q, "band") is 1
                            ok: 1
                        if sg_match(s, q, "bxor") is 1
                            ok: 1
                        if sg_match(s, q, "bshl") is 1
                            ok: 1
                        if sg_match(s, q, "bshr") is 1
                            ok: 1
                        if sg_match(s, q, "bsar") is 1
                            ok: 1
                    if tn is 8
                        if sg_match(s, q, "peek_i64") is 1
                            ok: 1
                        if sg_match(s, q, "poke_i64") is 1
                            ok: 1
                        if sg_match(s, q, "wrap_add") is 1
                            ok: 1
                        if sg_match(s, q, "wrap_sub") is 1
                            ok: 1
                        if sg_match(s, q, "wrap_mul") is 1
                            ok: 1
                    if tn is 9
                        if sg_match(s, q, "peek_byte") is 1
                            ok: 1
                        if sg_match(s, q, "poke_byte") is 1
                            ok: 1
                    if tn is 10
                        if sg_match(s, q, "peek_raw64") is 1
                            ok: 1
                        if sg_match(s, q, "poke_raw64") is 1
                            ok: 1
                    if ok is 0
                        return 0
                p: p + 1
        li: li + 1
    return 1
length s:
    if s < 4096
        return 0
    return _sov_strlen(s)
letter t i:

    if letter_tab is 0
        letter_tab: _sov_heap_alloc(512)
        k: 0
        as long as k < 256
            poke_byte(letter_tab, k * 2, k)
