    emit(72)
    emit(137)
    emit(209)
compound s:
    cch_mod: 0
    if cfind1(s, 61) < 0
        return s
    return compound_do(s)
compound_do s:
    i: 0
    n: length(s)
    intext: 0
    as long as i + 1 < n
        c: peek_byte(s, i)
        if c is 34
            if intext is 0
                intext: 1
            if not
                intext: 0
        if intext is 0
            if peek_byte(s, i + 1) is 61
                op: 0
                if c is 43
                    op: 1
                if c is 45
                    op: 1
                if c is 42
                    op: 1
                if c is 47
                    op: 1
                if c is 38
                    op: 1
                if c is 124
                    op: 1
                if c is 94
                    op: 1
                if op is 1
                    lhs: scut(s, 0, i)
                    rhs: scut(s, i + 2, n)
                    if length(lhs) > 0
                        if length(rhs) > 0
                            cch_mod: 1
                            return join(join(lhs, ": "), join(join(lhs, " "), join(join(cut(s, i, i + 1), " "), rhs)))
        i: i + 1
    return s
do_print_one arg:
    if length(arg) > 1
        if peek_byte(arg, 0) is 34
            if peek_byte(arg, length(arg) - 1) is 34 is 1
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
    typ: expr(arg)
    mov_rdi_rax()
    if typ is 1
        used_pr: 1
        calln("_sov_print")
    if not
        used_pi: 1
        calln("_sov_print_int")
    if br_depth is 0
        rax_small: 1
