try_self_infix var rhs:
    # v: <infix chain starting at v> with one optional outer band/bor/bxor.
    # Emitted in-home (gcc shape: imul/add/and on the same register) instead
    # of through rax with a store back -- one less hop on the latency chain
    # for recurrence loops like LCG. Checked ops keep their overflow traps.
    if sv_lookup(var) > 0 - 1
        return 0
    ds: reg_slot(var)
    if ds < 0
        return 0
    inn: strip(rhs)
    wop: 0
    warg: blank
    lp: look(inn, "(")
    if lp > 0
