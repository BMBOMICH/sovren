    i_ln: _sov_list_len(br_at)
    as long as i < i_ln
        if i is not self
            rst: peek_i64(br_st, 16 + i * 8)
            if rst is 4
                rst: 0
            if rst > 0
                e: peek_i64(br_at, 16 + i * 8)
                nb: e + 4
