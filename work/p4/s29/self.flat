    return 0 - 1
repl text old new:
    if _sov_find_text(text, old) < 0
        return text
    return repl_do(text, old, new)
repl_do text old new:
    n: length(text)
    o: length(old)
    gn: length(new)
    if o > 0
        if cfind1(text, 34) < 0
            hits: 0
            p: 0
            as long as p + o <= n
                if sg_match(text, p, old) is 1
                    hits: hits + 1
                    p: p + o
                if not
                    p: p + 1
            r: _sov_heap_alloc(n + hits * gn + 8)
            p: 0
            j: 0
            as long as p < n
                m: 0
                if p + o <= n
                    if sg_match(text, p, old) is 1
                        m: 1
                if m is 1
                    k: 0
                    as long as k + 8 <= gn
                        dummy: poke_i64(r, j, peek_i64(new, k))
                        j: j + 8
                        k: k + 8
                    as long as k < gn
                        dummy: poke_byte(r, j, peek_byte(new, k))
                        j: j + 1
                        k: k + 1
                    p: p + o
                if not
                    dummy: poke_byte(r, j, peek_byte(text, p))
                    j: j + 1
                    p: p + 1
            dummy: poke_byte(r, j, 0)
            return r
    r: _sov_heap_alloc(n + gn + 8)
    p: 0
    j: 0
    ins: 0
    as long as p < n
        b: peek_byte(text, p)
        if ins is 1
            if b is 92
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if p < n
                    poke_byte(r, j, peek_byte(text, p))
                    j: j + 1
                    p: p + 1
            if not
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
            if not
                rp_m: 0
                if p + o <= n
                    rp_m: 1
                rp_k: 0
                as long as rp_k < o
                    if rp_m is 1
                        if peek_byte(text, p + rp_k) is peek_byte(old, rp_k)
                            dummy: 0
                        if not
                            rp_m: 0
                    rp_k: rp_k + 1
                if rp_m is 1
                    k: 0
                    as long as k < gn
                        poke_byte(r, j, peek_byte(new, k))
                        j: j + 1
                        k: k + 1
                    p: p + o
                if rp_m is 0
                    poke_byte(r, j, b)
                    j: j + 1
                    p: p + 1
    poke_byte(r, j, 0)
    return r
