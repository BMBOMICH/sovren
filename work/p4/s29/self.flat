dirname p:
    n: length(p)
    if n is 0
        return "."
    i: n
    as long as i > 0
        i: i - 1
        b: peek_byte(p, i)
        if b is 92
            b: 47
        if b is 47
            if i is 0
                return "/"
            return cut(p, 0, i)
