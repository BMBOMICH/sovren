mem_scaled t:
    if _sov_starts_with(t, "peek_raw64(") is 0
        return 0 - 1
    if peek_byte(t, length(t) - 1) is 41 is 0
        return 0 - 1
    mn: cut(t, 11, length(t) - 1)
    mc: look(mn, ",")
    if mc < 0
        return 0 - 1
    mb: scut(mn, 0, mc)
    mx: scutr(mn, mc + 1)
    if name_ok(mb) is 0
        return 0 - 1
    mbs: reg_slot(mb)
    if mbs < 0
        return 0 - 1
    mq: raw_scaled(mx)
    if mq < 0
        return 0 - 1
    cflush(mb)
    return mbs * 65536 + mq
memabs_scaled t:
    if _sov_starts_with(t, "peek_raw64(") is 0
        return 0 - 1
    if peek_byte(t, length(t) - 1) is 41 is 0
        return 0 - 1
    mn: cut(t, 11, length(t) - 1)
    mc: look(mn, ",")
    if mc < 0
        return 0 - 1
    mb: scut(mn, 0, mc)
    mx: scutr(mn, mc + 1)
    if name_ok(mb) is 0
        return 0 - 1
    mbs: reg_slot(mb)
    if mbs < 0
        return 0 - 1
    if is_imm(mx) is 0
        return 0 - 1
    mi: num_of(mx)
    if mi < 0
        return 0 - 1
    if mi > 2147483647
        return 0 - 1
    cflush(mb)
    return (mbs + 1) * 4294967296 + mi
