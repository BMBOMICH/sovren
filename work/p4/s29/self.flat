fail:
    sys_exit(1)
err_count: 0
err_where:
    # Bound total diagnostics: a source the front end rejects wholesale
    # (e.g. a backend file fed to the wrong compiler) otherwise produces
    # one error per line - hundreds of MB of spew.  200 errors is far
    # past any useful report; abort instead.
    err_count: err_count + 1
    if err_count is 201
        print "Error: too many errors; aborting"
        dummy_ec: syscall(231, 1, 0, 0)
    if err_count > 200
        return
    if length(src_name) > 0
        _sov_print(src_name)
    print err_line
    if length(walk_nm) > 0
        _sov_print(walk_nm)
suggest_name name:
    best: blank
    bn: 0
    si: 0
    as long as si < _sov_list_len(names)
        nm: peek_i64(names, 16 + si * 8)
        hit: 0
        if _sov_starts_with(nm, name) is 1
            hit: 1
        if _sov_starts_with(name, nm) is 1
            if length(nm) > 1
                hit: 1
        if hit is 1
            if length(nm) > bn
                best: nm
                bn: length(nm)
        si: si + 1
    si: 0
    si_ln: _sov_list_len(locals)
    as long as si < si_ln
        nm: peek_i64(locals, 16 + si * 8)
        if _sov_starts_with(nm, name) is 1
            if length(nm) > bn
                best: nm
                bn: length(nm)
        si: si + 1
    si: 0
    si_ln: _sov_list_len(glob_names)
    as long as si < si_ln
        nm: peek_i64(glob_names, 16 + si * 8)
        if _sov_starts_with(nm, name) is 1
            if length(nm) > bn
                best: nm
                bn: length(nm)
        si: si + 1
    if bn > 0
        print "did you mean"
        _sov_print(best)
seed_str_fns:
    str_fns: _sov_list_add(str_fns, "str_cat")
    str_fns: _sov_list_add(str_fns, "str_cut")
    str_fns: _sov_list_add(str_fns, "str_trim")
    str_fns: _sov_list_add(str_fns, "str_join3")
    str_fns: _sov_list_add(str_fns, "_sov_trim")
    str_fns: _sov_list_add(str_fns, "join")
    str_fns: _sov_list_add(str_fns, "strip")
    str_fns: _sov_list_add(str_fns, "cut")
    str_fns: _sov_list_add(str_fns, "repl")
    str_fns: _sov_list_add(str_fns, "letter")
fib_call_var line nm:
    mark: join(nm, "(")
    ln: length(line)
    pos: 0
    as long as pos < ln
        p: look(cut(line, pos, ln), mark)
        if p < 0
            return 0
        p: p + pos
        inn: cut(line, p + length(mark), ln)
        c: look(inn, ")")
        if c < 0
            return 0
        arg: scut(inn, 0, c)
        if is_imm(arg) is 0
            return 1
        if num_of(arg) > 92
            return 1
        pos: p + length(mark) + c + 1
fib_of n:
    if n < 2
        return n
    a: 0
    b: 1
    i: 2
    as long as i <= n
        t: a + b
        a: b
        b: t
        i: i + 1
    return b
fiblike nm ps blines:
    if _sov_str_eq(nm, entry_nm) is 1
        return 0
    if _sov_list_len(ps) is not 1
        return 0
    p: peek_i64(ps, 16)
    if _sov_list_len(blines) is not 3
        return 0
    l1: strip(peek_i64(blines, 16))
    l2: strip(peek_i64(blines, 24))
    l3: strip(peek_i64(blines, 32))
    if _sov_str_eq(l1, join("if ", join(p, " < 2"))) is 0
        return 0
    if _sov_str_eq(l2, join("return ", p)) is 0
        return 0
    want3: join("return ", join(nm, join("(", join(p, " - 1)"))))
    want3b: join(want3, join(" + ", join(nm, join("(", join(p, " - 2)")))))
    if _sov_str_eq(l3, want3b) is 0
        return 0
    return 1
file_ln li:
    n: li + 1
    if n > src_base
        return n - src_base
    return n
find_col text:
    if cfind1(text, 34) < 0
        return cfind1(text, 58)
    return find_col_q(text)
find_col_q text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n
        b: peek_byte(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
            if not
                if b is 58
                    return i
        i: i + 1
    return 0 - 1
find_last_sp text:
    i: length(text) - 1
    as long as i > 0 - 1
        if peek_byte(text, i) is 32 is 1
            return i
        i: i - 1
    return 0 - 1
find_sep text:
    if _sov_find_text(text, ":=") < 0
        return 0 - 1
    return find_sep_do(text)
find_sep_do text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n - 3
        b: peek_byte(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
        if ins is 0
            if sg_match(text, i, " := ") is 1
                return i
        i: i + 1
    return 0 - 1
fold_mem_h oc d i:
    rx: 72
    if d > 7
        rx: rx + 4
    if i > 7
        rx: rx + 2
    emit(rx)
    emit(oc)
    emit(4 + (d % 8) * 8)
    emit(sibx(i))
fold_rax_h oc h:
    emit(rexx(h))
    emit(oc)
    emit(4)
    emit(sibx(h))
fop e op:
    hit: 0 - 1
    if peek_byte(op, 1) is 0
        hit: cfind1(e, peek_byte(op, 0))
    if not
        hit: _sov_find_text(e, op)
    if hit < 0
        return 0 - 1
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    # swar skip: plain chars (not quote/paren/escape/op) advance 8 at a time;
    # skip set is exactly {34, 40, 41, 92, op[0]}, so the walk is unchanged.
    ones: 72340172838076673
    high: 0 - 9187201950435737472
    k34: ones * 34
    k40: ones * 40
    k41: ones * 41
    k92: ones * 92
    kop: ones * peek_byte(op, 0)
    as long as i < n
        sk: 0
        as long as sk is 0
            if i + 8 > n
                sk: 1
            if sk is 0
                q: peek_i64(e, i)
                xq: bxor(q, k34)
                m: band(band(xq - ones, bxor(xq, 0 - 1)), high)
                if m is 0
                    xq: bxor(q, k40)
                    m: band(band(xq - ones, bxor(xq, 0 - 1)), high)
                if m is 0
                    xq: bxor(q, k41)
                    m: band(band(xq - ones, bxor(xq, 0 - 1)), high)
                if m is 0
                    xq: bxor(q, k92)
                    m: band(band(xq - ones, bxor(xq, 0 - 1)), high)
                if m is 0
                    xq: bxor(q, kop)
                    m: band(band(xq - ones, bxor(xq, 0 - 1)), high)
                if m is 0
                    i: i + 8
                if m is not 0
                    sk: 1
        c: peek_byte(e, i)
        if ins is 1
            if c is 92
                i: i + 1
                if i < n
                    i: i + 1
            if not
                if c is 34
                    ins: 0
                i: i + 1
        if not
            if c is 34
                ins: 1
                i: i + 1
            if not
                if c is 40 is 1
                    d: d + 1
                    i: i + 1
                if not
                    if c is 41 is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if sg_match_n(e, i, op, n) is 1
                                f: i
                        i: i + 1
    return f
fopn e op nxt:
    hit: 0 - 1
    if peek_byte(op, 1) is 0
        hit: cfind1(e, peek_byte(op, 0))
    if not
        hit: _sov_find_text(e, op)
    if hit < 0
        return 0 - 1
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: peek_byte(e, i)
        if ins is 1
            if c is 92
                i: i + 1
                if i < n
                    i: i + 1
            if not
                if c is 34
                    ins: 0
                i: i + 1
        if not
            if c is 34
                ins: 1
                i: i + 1
            if not
                if c is 40 is 1
                    d: d + 1
                    i: i + 1
                if not
                    if c is 41 is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if sg_match(e, i, op) is 1
                                fhit: 1
                                if i + length(op) < n
                                    if peek_byte(e, i + length(op)) is peek_byte(nxt, 0)
                                        fhit: 0
                                if i > 0
                                    if peek_byte(e, i - 1) is peek_byte(nxt, 0)
                                        fhit: 0
                                if fhit is 1
                                    f: i
                        i: i + 1
    return f
bitop e p opn wide:
    bin(cut(e, 0, p), cut(e, p + wide, length(e)), opn)
    return 0

bitop_n e en p opn wide:
    bin_k(e, p, e + p + wide, en - p - wide, opn, 0, 0)
    return 0
binary_sign e i:
    p: i - 1
    as long as p >= 0
        b: peek_byte(e, p)
        if b is not 32
            if b is not 9
                leave
