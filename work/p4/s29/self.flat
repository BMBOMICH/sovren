        rx: rx + 1
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        emit(nd * 64 + 4)
        emit(36)
    if not
        emit(nd * 64 + bs + 3)
    if nd is 1
        emit(imm)
    if nd is 2
        emit4(imm)
emit_store_scaled_rax bs i2 dp:
    rx: 72
