dce_refs_of i n ht:
    out: _sov_list_new()
    bl: _sov_list_get(bodies, i)
    lc: _sov_list_len(bl)
    li: 0
    as long as li < lc
        line: _sov_list_get(bl, li)
        lt: str_len(line)
        p: 0
        as long as p < lt
            c: peek_byte(line, p)
            wc: dce_wch(c)
            if wc is 1
                tk: dce_token(line, p, lt)
                p: p + str_len(tk)
                found: dce_htget(ht, tk)
                if found >= 0
                    out: _sov_list_add(out, found)
            if not
                p: p + 1
        li: li + 1
    return out
dce_wch c:
    d1: band(bshr(47 - c, 63), band(bshr(c - 58, 63), 1))
    d2: band(bshr(64 - c, 63), band(bshr(c - 91, 63), 1))
    d3: band(bshr(96 - c, 63), band(bshr(c - 123, 63), 1))
    d4: band(bshr(94 - c, 63), band(bshr(c - 96, 63), 1))
    o1: d1 + d2 - d1 * d2
    o2: o1 + d3 - o1 * d3
    return o2 + d4 - o2 * d4
dce_token line p lt:
    e: p
    as long as e < lt
        if dce_wch(peek_byte(line, e)) is 0
            return prv_cut2(line, p, e - p)
        e: e + 1
    return prv_cut2(line, p, lt - p)
prv_cut2 line p l:
    o: _sov_alloc(l + 2)
    j: 0
    as long as j < l
        poke_byte(o, j, peek_byte(line, p + j))
        j: j + 1
    poke_byte(o, l, 0)
    return as text o
dce_htget ht tk:
    sl: band(nhash(tk), 16383)
    as long as peek_i64(ht, sl * 16) is not 0
        if _sov_str_eq(peek_i64(ht, sl * 16), tk) is 1
            return peek_i64(ht, sl * 16 + 8)
        sl: sl + 1
        if sl is 16384
            sl: 0
    return 0 - 1
dce_word t nm:
    lt: str_len(t)
    ln2: str_len(nm)
    if lt < ln2
        return 0
    i: 0
    as long as i + ln2 <= lt
        aft: peek_byte(t, i + ln2)
        d1: band(bshr(47 - aft, 63), band(bshr(aft - 58, 63), 1))
        d2: band(bshr(64 - aft, 63), band(bshr(aft - 91, 63), 1))
        d3: band(bshr(96 - aft, 63), band(bshr(aft - 123, 63), 1))
        d4: band(bshr(47 - aft, 63), band(bshr(aft - 40, 63), 1))
        o1: d1 + d2 - d1 * d2
        o2: o1 + d3 - o1 * d3
        o3: o2 + d4 - o2 * d4
        bnd: 1
        if i > 0
            bef: peek_byte(t, i - 1)
            e1: band(bshr(47 - bef, 63), band(bshr(bef - 58, 63), 1))
            e2: band(bshr(64 - bef, 63), band(bshr(bef - 91, 63), 1))
            e3: band(bshr(96 - bef, 63), band(bshr(bef - 123, 63), 1))
            f1: e1 + e2 - e1 * e2
            bnd: 1 - (f1 + e3 - f1 * e3)
        hit: band(band(dce_eqat(t, nm, i), bnd), 1 - o3)
        if hit is 1
            return 1
        i: i + 1
    return 0
dce_eqat t nm at:
    ln2: str_len(nm)
    j: 0
    as long as j < ln2
        if peek_byte(t, at + j) is not peek_byte(nm, j)
            return 0
        j: j + 1
    return 1
rpx_nonspace s:
    i: 0
    as long as 1
        b: peek_byte(s, i)
        if b is 0
            return 0 - 1
        if b is not 32
            return i
        i: i + 1
rpp_repeat_prepass:
    f9: 0
    as long as f9 < _sov_list_len(bodies)
        bd: _sov_list_get(bodies, f9)
        bl9: _sov_list_get(body_lns, f9)
        i9: 0
        as long as i9 < _sov_list_len(bd)
            raw: _sov_list_get(bd, i9)
            fs9: rpx_nonspace(raw)
            st9: ""
            if fs9 > 0 - 1
                if _sov_byte_at(raw, fs9) is 114
                    if _sov_byte_at(raw, fs9 + 1) is 101
                        st9: strip(raw)
            if _sov_starts_with(st9, "repeat ") is 1
                ct9: scutr(st9, 7)
                tp9: look(ct9, " times")
                if tp9 > 0 - 1
                    ct9: scut(ct9, 0, tp9)
                if length(ct9) is 0
                    print "Error: repeat needs a count"
                    err_line: _sov_list_get(bl9, i9)
                    err_where()
                    had_err: 1
                if not
                    ri9: rpx_nonspace(raw)
                    pr9: cut(raw, 0, ri9)
                    bi9: _sov_list_len(bd)
                    j9: i9 + 1
                    as long as j9 < bi9
                        r2: _sov_list_get(bd, j9)
                        if length(strip(r2)) > 0
                            if _sov_byte_at(strip(r2), 0) is not 35
                                if rpx_nonspace(r2) <= ri9
                                    bi9: j9
                                    j9: bi9
                        j9: j9 + 1
                    ln9: _sov_list_get(bl9, i9)
                    bp9: join(pr9, "    ")
                    if bi9 > i9 + 1
                        bp9: cut(_sov_list_get(bd, i9 + 1), 0, rpx_nonspace(_sov_list_get(bd, i9 + 1)))
                    rpx_n: rpx_n + 1
                    vn9: str_cat("__rp", rpx_dec(rpx_n))
                    nb: _sov_list_new()
                    nl9: _sov_list_new()
                    nb: _sov_list_add(nb, join(pr9, join(vn9, join(": ", ct9))))
                    nl9: _sov_list_add(nl9, ln9)
                    nb: _sov_list_add(nb, join(pr9, join("as long as ", join(vn9, " > 0"))))
                    nl9: _sov_list_add(nl9, ln9)
                    k9: i9 + 1
                    as long as k9 < bi9
                        nb: _sov_list_add(nb, _sov_list_get(bd, k9))
                        nl9: _sov_list_add(nl9, _sov_list_get(bl9, k9))
                        k9: k9 + 1
                    nb: _sov_list_add(nb, join(bp9, join(vn9, join(": ", join(vn9, " - 1")))))
                    nl9: _sov_list_add(nl9, ln9)
                    bd2: _sov_list_new()
                    bl2: _sov_list_new()
                    h9: 0
                    as long as h9 < i9
                        bd2: _sov_list_add(bd2, _sov_list_get(bd, h9))
                        bl2: _sov_list_add(bl2, _sov_list_get(bl9, h9))
                        h9: h9 + 1
                    h9: 0
                    as long as h9 < _sov_list_len(nb)
                        bd2: _sov_list_add(bd2, _sov_list_get(nb, h9))
                        bl2: _sov_list_add(bl2, _sov_list_get(nl9, h9))
                        h9: h9 + 1
                    h9: bi9
                    as long as h9 < _sov_list_len(bd)
                        bd2: _sov_list_add(bd2, _sov_list_get(bd, h9))
                        bl2: _sov_list_add(bl2, _sov_list_get(bl9, h9))
                        h9: h9 + 1
                    bodies: _sov_list_set(bodies, f9, bd2)
                    body_lns: _sov_list_set(body_lns, f9, bl2)
                    bd: bd2
                    bl9: bl2
                    i9: i9 + 1
            i9: i9 + 1
        f9: f9 + 1
    return 0

# Per-compilation primary text-type dependency graph. This is semantic state,
# not saved/replayed compilation output. Nodes are tasks and scoped variables;
# text literals/casts seed a worklist, reverse edges propagate forward types.
st_need: 0
st_edges: 0
st_done: 0
st_vars: 0
st_ids: 0
st_node kind:
    ix: _sov_list_len(st_need)
    st_need: _sov_list_add(st_need, kind)
    st_edges: _sov_list_add(st_edges, _sov_list_new())
    st_done: _sov_list_add(st_done, 0)
    return ix
st_var name:
    vi: list_idx(st_vars, name)
    if vi >= 0
        return peek_i64(st_ids, 16 + vi * 8)
    ni: st_node(0)
    st_vars: _sov_list_add(st_vars, name)
    st_ids: _sov_list_add(st_ids, ni)
    return ni
st_edge source target:
    cnt: peek_i64(st_need, 16 + target * 8)
    if cnt >= 0
        poke_i64(st_need, 16 + target * 8, cnt + 1)
    if source > 0
        adj: peek_i64(st_edges, 16 + source * 8)
        adj: _sov_list_add(adj, target)
        poke_i64(st_edges, 16 + source * 8, adj)
    return 0
st_expr e0 dep:
    if dep > 32
        return 0
    e: strip(e0)
    en: length(e)
    if is_lit(e) is 1
        return 1
    if starts(e, "as text ") is 1
        return 1
    if starts(e, "as ptr ") is 1
        return 1
    if en > 8
        if sg_match(e, en - 8, " as text") is 1
            return 1
    if en > 7
        if sg_match(e, en - 7, " as ptr") is 1
            return 1
    if en > 1
        if peek_byte(e, 0) is 40
            if licm2_match(e, 0) is en - 1
                return st_expr(cut(e, 1, en - 1), dep + 1)
    if expr_atom(e) is 1
        if digitb(peek_byte(e, 0)) is 1
            return 0
        vi: list_idx(st_vars, e)
        if vi >= 0
            return peek_i64(st_ids, 16 + vi * 8)
        if sg_lookup(e) >= 0
            return 1
        return 0
    lp: cfind1(e, 40)
    if lp > 0
        if licm2_match(e, lp) is en - 1
            nm: scut(e, 0, lp)
            if expr_atom(nm) is 1
                if sf_lookup(nm) >= 0
                    return 1
                fi: nm_lookup(nm)
                if fi >= 0
                    # Identity returns stay parametric: specialize the returned
                    # parameter at this expression, not every call to the task.
                    pk: peek_i64(ret_par, 16 + fi * 8)
                    if pk >= 0
                        args: split_args(cut(e, lp + 1, en - 1), _sov_list_new())
                        if pk < _sov_list_len(args)
                            return st_expr(peek_i64(args, 16 + pk * 8), dep + 1)
                    return fi + 2
    return 0
st_scr_buf: 0
st_scr_cap: 0
st_scratch n:
    # per-function scratch: three slots per body line (line, colon, name)
    if st_scr_cap < n * 24 + 16
        st_scr_buf: _sov_heap_alloc(n * 24 + 16)
        st_scr_cap: n * 24 + 16
    return st_scr_buf
st_build:
    st_need: _sov_list_new()
    st_edges: _sov_list_new()
    st_done: _sov_list_new()
    zz: st_node(0)
    zz: st_node(0)
    fi: 0
    nn: _sov_list_len(names)
    as long as fi < nn
        zz: st_node(0 - 1)
        fi: fi + 1
    fi: 0
    as long as fi < nn
        st_vars: _sov_list_new()
        st_ids: _sov_list_new()
        bl: peek_i64(bodies, 16 + fi * 8)
        ps: peek_i64(params, 16 + fi * 8)
        pi: 0
        as long as pi < _sov_list_len(ps)
            zz: st_var(peek_i64(ps, 16 + pi * 8))
            # A runtime parameter is unknown unless its actual argument is
            # considered at a parametric call site. Do not assume text.
            st_edge(0, zz)
            pi: pi + 1
        bln: _sov_list_len(bl)
        # One line pass feeds both phases: the trimmed line, its colon
        # offset and its assignment-target name are cached per line so
        # the edge phase does not re-strip and re-scan every line.
        st_scr: st_scratch(bln)
        bi: 0
        as long as bi < bln
            line: strip_span(peek_i64(bl, 16 + bi * 8))
            if starts(line, "immutable ") is 1
                line: strip_span(cut(line, 10, length(line)))
            co: find_col(line)
            poke_i64(st_scr, 16 + bi * 24, line)
            poke_i64(st_scr, 24 + bi * 24, co)
            nm: 0
            if co > 0
                nm: cut(line, 0, co)
                if peek_byte(nm, co - 1) < 33
                    nm: strip(nm)
                if expr_atom_word(nm) is 0
                    nm: 0
            poke_i64(st_scr, 32 + bi * 24, nm)
            if nm is not 0
                zz: st_var(nm)
            bi: bi + 1
        bi: 0
        as long as bi < bln
            line: peek_i64(st_scr, 16 + bi * 24)
            co: peek_i64(st_scr, 24 + bi * 24)
            nm: peek_i64(st_scr, 32 + bi * 24)
            if starts(line, "return ") is 1
                st_edge(st_expr(cut(line, 7, length(line)), 0), fi + 2)
            if not
                if co > 0
                    if nm is not 0
                        vn: st_var(nm)
                        st_edge(st_expr(cut(line, co + 1, length(line)), 0), vn)
            bi: bi + 1
        fi: fi + 1
    queue: _sov_list_new()
    queue: _sov_list_add(queue, 1)
    poke_i64(st_done, 24, 1)
    qi: 0
    as long as qi < _sov_list_len(queue)
        ni: peek_i64(queue, 16 + qi * 8)
        adj: peek_i64(st_edges, 16 + ni * 8)
        ai: 0
        as long as ai < _sov_list_len(adj)
            dst: peek_i64(adj, 16 + ai * 8)
            need: peek_i64(st_need, 16 + dst * 8)
            if need > 0
                need: need - 1
                poke_i64(st_need, 16 + dst * 8, need)
            if need <= 0
                if peek_i64(st_done, 16 + dst * 8) is 0
                    poke_i64(st_done, 16 + dst * 8, 1)
                    queue: _sov_list_add(queue, dst)
                    if dst >= 2
                        if dst < nn + 2
                            mark_fn_str(peek_i64(names, 16 + (dst - 2) * 8))
            ai: ai + 1
        qi: qi + 1
    # The semantic result is now in str_fns; graph scratch is not reused by
    # another compilation and no source or emitted artifact is replayed.
    return 0

# --- st_build twin: the C port is planted from compilers/linux/
# stbuild_native.sov (generated from tools/native_stbuild.c) for the
# self-hosted build; this wrapper is the portable fallback. The graph
# helpers (st_node/st_var/st_edge/st_expr/st_scratch/mark_fn_str) stay
# interpreted behind sb_tbl; strip_span/find_col/cut/starts/
# expr_atom_word are fused inside the blob, and its cut copies plus the
# BFS queue live in the persistent sb_arblk arena.
sb_tbl: 0
sb_arblk: 0
sb_tbl_init:
    sb_tbl: _sov_heap_alloc(176)
    sb_arblk: _sov_heap_alloc(16)
    poke_i64(sb_arblk, 0, 0)
    poke_i64(sb_arblk, 8, 0)
    poke_i64(sb_tbl, 0, 20)
    poke_i64(sb_tbl, 8, addr_of sb_names_get)
    poke_i64(sb_tbl, 16, addr_of sb_bodies_get)
    poke_i64(sb_tbl, 24, addr_of sb_params_get)
    poke_i64(sb_tbl, 32, addr_of sb_reset)
    poke_i64(sb_tbl, 40, addr_of st_node)
    poke_i64(sb_tbl, 48, addr_of st_var)
    poke_i64(sb_tbl, 56, addr_of st_edge)
    poke_i64(sb_tbl, 64, addr_of st_expr)
    poke_i64(sb_tbl, 72, addr_of st_scratch)
    poke_i64(sb_tbl, 80, addr_of sb_vars_reset)
    poke_i64(sb_tbl, 88, addr_of sb_need_get)
    poke_i64(sb_tbl, 96, addr_of sb_edges_get)
    poke_i64(sb_tbl, 104, addr_of sb_done_get)
    poke_i64(sb_tbl, 112, addr_of mark_fn_str)
    poke_i64(sb_tbl, 120, addr_of strip)
    poke_i64(sb_tbl, 128, addr_of expr_atom)
    poke_i64(sb_tbl, 136, addr_of find_col_q)
    poke_i64(sb_tbl, 144, addr_of cut)
    poke_i64(sb_tbl, 152, addr_of sb_arblk_get)
    poke_i64(sb_tbl, 160, addr_of _sov_heap_alloc)
    return 0
sb_names_get:
    return names
sb_bodies_get:
    return bodies
sb_params_get:
    return params
sb_reset:
    st_need: _sov_list_new()
    st_edges: _sov_list_new()
    st_done: _sov_list_new()
    return 0
sb_vars_reset:
    st_vars: _sov_list_new()
    st_ids: _sov_list_new()
    return 0
sb_need_get:
    return st_need
sb_edges_get:
    return st_edges
sb_done_get:
    return st_done
sb_arblk_get:
    return sb_arblk
_sov_st_build tbl:
    st_build()
    return 0

# --- dce family twins: the C ports are planted from compilers/linux/
# dstores_native.sov, dlitter_native.sov and dce_native.sov (generated from
# tools/native_dstores.c, native_dlitter.c, native_dce.c) for the
# self-hosted build; these wrappers are the portable fallback.  The graph
# lookups (fn_lookup/gn_lookup) are answered from blob-local first-index
# tables - the answers are hash-independent, and the global caches
# self-heal on next use (fn_sync appends the tail; gn_sync rebuilds on
# shrink), except the compaction-branch fn cache reset, which the
# interpreted dce performs by clearing fn_htcap/fn_sync_hi and which
# dce_pub_fn replicates.  Rebuilt lists live in the persistent dce_arblk
# arena; oc compactions are in-place forward blits (kept bytes only ever
# move down); every patch-table rebuild publishes through dce_pub_patch.
dce_tbl: 0
dce_arblk: 0
dce_tbl_init:
    dce_tbl: _sov_heap_alloc(232)
    dce_arblk: _sov_heap_alloc(16)
    poke_i64(dce_arblk, 0, 0)
    poke_i64(dce_arblk, 8, 0)
    poke_i64(dce_tbl, 0, 28)
    poke_i64(dce_tbl, 8, addr_of dce_g_patch_at)
    poke_i64(dce_tbl, 16, addr_of dce_g_patch_kind)
    poke_i64(dce_tbl, 24, addr_of dce_g_patch_kid)
    poke_i64(dce_tbl, 32, addr_of dce_g_patch_val)
    poke_i64(dce_tbl, 40, addr_of dce_g_patch_line)
    poke_i64(dce_tbl, 48, addr_of dce_g_fn_names)
    poke_i64(dce_tbl, 56, addr_of dce_g_fn_offs)
    poke_i64(dce_tbl, 64, addr_of dce_g_glob_names)
    poke_i64(dce_tbl, 72, addr_of dce_g_br_at)
    poke_i64(dce_tbl, 80, addr_of dce_g_br_st)
    poke_i64(dce_tbl, 88, addr_of dce_g_oc)
    poke_i64(dce_tbl, 96, addr_of dce_g_oc_n)
    poke_i64(dce_tbl, 104, addr_of dce_g_strb)
    poke_i64(dce_tbl, 112, addr_of dce_g_had_err)
    poke_i64(dce_tbl, 120, addr_of dce_g_fib_drop)
    poke_i64(dce_tbl, 128, addr_of dce_g_fib_nm)
    poke_i64(dce_tbl, 136, addr_of dce_g_entry_nm)
    poke_i64(dce_tbl, 144, addr_of dce_g_kid_krel)
    poke_i64(dce_tbl, 152, addr_of dce_g_kid_kfnaddr)
    poke_i64(dce_tbl, 160, addr_of dce_g_kid_kgrel)
    poke_i64(dce_tbl, 168, addr_of dce_g_kid_kglob)
    poke_i64(dce_tbl, 176, addr_of intern_kid)
    poke_i64(dce_tbl, 184, addr_of _sov_heap_alloc)
    poke_i64(dce_tbl, 192, addr_of dce_arblk_get)
    poke_i64(dce_tbl, 200, addr_of dce_pub_ocn)
    poke_i64(dce_tbl, 208, addr_of dce_pub_fn)
    poke_i64(dce_tbl, 216, addr_of dce_pub_patch)
    poke_i64(dce_tbl, 224, addr_of dce_pub_strb)
    return 0
dce_g_patch_at:
    return patch_at
dce_g_patch_kind:
    return patch_kind
dce_g_patch_kid:
    return patch_kid
dce_g_patch_val:
    return patch_val
dce_g_patch_line:
    return patch_line
dce_g_fn_names:
    return fn_names
dce_g_fn_offs:
    return fn_offs
dce_g_glob_names:
    return glob_names
dce_g_br_at:
    return br_at
dce_g_br_st:
    return br_st
dce_g_oc:
    return oc
dce_g_oc_n:
    return oc_n
dce_g_strb:
    return strb
dce_g_had_err:
    return had_err
dce_g_fib_drop:
    return fib_drop
dce_g_fib_nm:
    return fib_nm
dce_g_entry_nm:
    return entry_nm
dce_g_kid_krel:
    return kid_krel
dce_g_kid_kfnaddr:
    return kid_kfnaddr
dce_g_kid_kgrel:
    return kid_kgrel
dce_g_kid_kglob:
    return kid_kglob
dce_arblk_get:
    return dce_arblk
dce_pub_ocn v:
    oc_n: v
    return 0
dce_pub_fn names offs:
    fn_names: names
    fn_offs: offs
    fn_htcap: 0
    fn_sync_hi: 0
    return 0
dce_pub_patch at kind kid val line:
    patch_at: at
    patch_kind: kind
    patch_kid: kid
    patch_val: val
    patch_line: line
    return 0
dce_pub_strb b:
    strb: b
    return 0
_sov_dce tbl:
    dce()
    return 0
_sov_dce_stores tbl:
    dce_stores()
    return 0
_sov_dce_litter tbl:
    dce_litter()
    return 0

# Debug points are ordinary numeric patch records. Every compaction and
# parallel merge already relocates these records; no stale raw PCs survive.
dbg_collect: 0
dbg_active: 0
dbg_tops: 0
tops_users: 0
dbg_decimal v:
    if v is 0
        return "0"
    out: ""
    as long as v > 0
        out: join(cut("0123456789", v % 10, v % 10 + 1), out)
        v: v / 10
    return out
dbg_write path:
    if dbg_collect is 0
        return 0
    out: join("# src_base ", join(dbg_decimal(src_base), "\n"))
    di: 0
    as long as di < _sov_list_len(patch_at)
        if _sov_str_eq(peek_i64(patch_kind, 16 + di * 8), "debug") is 1
            pc: peek_i64(patch_at, 16 + di * 8) + HDR
            ln: peek_i64(patch_val, 16 + di * 8)
            out: join(out, join(dbg_decimal(pc), join(" ", join(dbg_decimal(ln), "\n"))))
        di: di + 1
    if file_write_all(join(path, ".map"), out) is 0
        print "Error: cannot write debug map"
        fail()
    return 0

# Counters are emitted only by an explicitly instrumenting compiler build.
# Ordinary translation emits no probes and normal benchmark binaries stay clean.
prof_codegen: 0
prof_counter_active: 0
prof_bytes_scanned: 0
prof_bytes_copied: 0
prof_allocations: 0
prof_alloc_bytes: 0
prof_hash_probes: 0
prof_fallbacks: 0
prof_emit counter reg:
    if prof_codegen is 0
        return 0
    if gn_lookup("prof_counter_active") < 0
        print "Error: --instrument-compiler requires compiler counter globals"
        fail()
    # Preserve flags and both scratch registers, including the original rax
    # when it is the measured value. No calls or ABI alignment dependencies.
    emit(156)
    emit(80)
    emit2(65, 83)
    load_glob("prof_mode")
    test_rax()
    disabled: jz()
    emit2(72, 184)
    emit8(1)
    store_glob("prof_counter_active")
    load_glob(counter)
    if reg < 0
        emit3(72, 131, 192)
        emit(1)
    if not
        if reg is 0
            emit3(72, 3, 68)
            emit(36)
            emit(8)
        if not
            rex: 72
            if reg >= 8
                rex: 76
            emit3(rex, 1, 192 + (reg % 8) * 8)
    store_glob(counter)
    patch(disabled)
    emit2(65, 91)
    emit(88)
    emit(157)
    return 0
prof_emit_n counter count:
    if prof_codegen is 0
        return 0
    emit(80)
    emit2(72, 184)
    emit8(count)
    prof_emit(counter, 0)
    emit(88)
    return 0

prof_strlen_stub:
    # Same aligned SWAR algorithm as emit_strlen; symbolic branch patches
    # permit probes without stale byte displacements in the original stub.
    emit3(72, 129, 255)
    emit4(4096)
    emit2(15, 134)
    small: here()
    emit4(0)
    emit3(72, 137, 254)
    emit3(72, 137, 250)
    emit3(72, 131, 226)
    emit(248)
    prof_emit_n("prof_bytes_scanned", 8)
    emit3(76, 139, 10)
    emit2(137, 249)
    emit3(131, 225, 7)
    emit3(193, 225, 3)
    emit(184)
    emit4(1)
    emit3(72, 211, 224)
    emit3(72, 255, 200)
    emit3(73, 9, 193)
    emit2(73, 184)
    emit8(0 - 72340172838076673)
    emit2(72, 184)
    emit8(-9187201950435737472)
    first: jmp()
    loop: here()
    prof_emit_n("prof_bytes_scanned", 8)
    emit3(76, 139, 10)
    patch(first)
    emit3(76, 137, 201)
    emit3(76, 1, 193)
    emit3(73, 247, 209)
    emit3(73, 33, 193)
    emit3(73, 33, 201)
    found: jnz()
    emit3(72, 131, 194)
    emit(8)
    back: jmp()
    put(back, loop - (back + 4))
    patch(found)
    emit3(77, 15, 188)
    emit(201)
    emit3(73, 193, 233)
    emit(3)
    emit3(76, 1, 202)
    emit3(72, 137, 208)
    emit3(72, 41, 240)
    ret()
    patch(small)
    xor_rax()
    ret()
    return 0

prof_last: 0
prof_value i:
    if i is 0 -> return prof_bytes_scanned
    if i is 1 -> return prof_bytes_copied
    if i is 2 -> return prof_allocations
    if i is 3 -> return prof_alloc_bytes
    if i is 4 -> return prof_hash_probes
    return prof_fallbacks
prof_key i:
    if i is 0 -> return "bytes_scanned"
    if i is 1 -> return "bytes_copied"
    if i is 2 -> return "allocations"
    if i is 3 -> return "allocation_requested_bytes"
    if i is 4 -> return "hash_probes"
    return "fallbacks"
prof_capture off fresh:
    ci: 0
    as long as ci < 6
        value: prof_value(ci)
        prior: peek_i64(prof_last, ci * 8)
        field: off + 24 + ci * 8
        delta: value - prior
        if fresh is 0
            delta: delta + peek_i64(prof_marks, field)
        poke_i64(prof_marks, field, delta)
        poke_i64(prof_last, ci * 8, value)
        ci: ci + 1
    return 0

# unsafe-module
# Primary expression syntax, migration slice 1. No sx_source-keyed lookup and no
# saved translation results. A sx_tree owns its flat nodes and operand stacks;
# emission receives sx_node indices, never searches text to rediscover a split.
# Initially admitted grammar: decimal/name atoms, parentheses, binary +-*/%.
# Other grammar remains on the existing path until it is explicitly migrated.
syntax_mode: 1
syntax_trees: 0
syntax_nodes: 0
syntax_declines: 0
# Decline-reason census (prof-only): syntax_build pokes the reason, not just 1.
# 1 node-overflow, 2 bad-number, 3 unclosed-string, 4 depth>150, 5 missing-paren,
# 6 unary-minus-nonnumber, 7 unrecognized-primary, 8 string-left-binary,
# 9 trailing-tokens, 10 span-cap
syntax_decline_rc: 0
syntax_decline_note r:
    if prof_mode is 1
        if syntax_decline_rc is 0
            syntax_decline_rc: _sov_heap_alloc(160)
        poke_i64(syntax_decline_rc, (r - 1) * 8, peek_i64(syntax_decline_rc, (r - 1) * 8) + 1)
    return 0
# prof-only capture of declining spans (diagnostics, never consulted for translation)
sx_dbg_txt: 0
sx_dbg_n: 0
syntax_dbg_span sx_source sx_n:
    if prof_mode is not 1 -> return 0
    if sx_dbg_n >= 400 -> return 0
    sx_dbg_n: sx_dbg_n + 1
    sx_line: ""
    sx_i: 0
    as long as sx_i < sx_n
        if sx_i >= 300 -> leave
        sx_c: peek_byte(sx_source, sx_i)
        if sx_c >= 33
            if sx_c <= 126
                sx_line: join(sx_line, cut(sx_source, sx_i, sx_i + 1))
        if sx_c < 33 or sx_c > 126
            sx_line: join(sx_line, "?")
        sx_i: sx_i + 1
    sx_dbg_txt: join(sx_dbg_txt, join(sx_line, "\n"))
    return 0
syntax_native_trees: 0
syntax_prec sx_op:
    if sx_op is 308 -> return 1
    if sx_op is 307 -> return 2
    if sx_op is 124 -> return 3
    if sx_op is 94 -> return 4
    if sx_op is 38 -> return 5
    if sx_op is 300 -> return 6
    if sx_op is 301 -> return 7
    if sx_op is 302 -> return 8
    if sx_op is 303 -> return 9
    if sx_op is 60 -> return 10
    if sx_op is 62 -> return 11
    if sx_op is 306 -> return 12
    if sx_op is 305 -> return 13
    if sx_op is 304 -> return 14
    if sx_op is 43 -> return 15
    if sx_op is 45 -> return 15
    if sx_op is 42 -> return 16
    if sx_op is 47 -> return 16
    if sx_op is 37 -> return 16
    return 0
syntax_word sx_c:
    if sx_c is 95 -> return 1
    if sx_c >= 48
        if sx_c <= 57 -> return 1
    if sx_c >= 65
        if sx_c <= 90 -> return 1
    if sx_c >= 97
        if sx_c <= 122 -> return 1
    return 0
syntax_add sx_tree sx_kind sx_start sx_end sx_left sx_right:
    if sx_kind is 0
        sx_source: peek_i64(sx_tree, 0)
        sx_b: peek_byte(sx_source, sx_start)
        sx_left: sx_start
        sx_right: sx_end
        sx_kind: 265
        if sx_b is 34 -> sx_kind: 266
        if digitb(sx_b) is 1 or sx_b is 45
            sx_kind: 264
            if sx_b is 45
                sx_left: wrap_sub(0, num_of_n(sx_source + sx_start + 1, sx_end - sx_start - 1))
            if not
                sx_left: num_of_n(sx_source + sx_start, sx_end - sx_start)
            sx_right: 0
    sx_count: peek_i64(sx_tree, 16)
    sx_cap: peek_i64(sx_tree, 8)
    sx_cap: sx_cap + sx_cap / 2
    if sx_count > sx_cap
        poke_i64(sx_tree, 104, 1)
        return 0
    sx_rec: sx_tree + 128 + sx_count * 40
    poke_i64(sx_rec, 0, sx_kind)
    poke_i64(sx_rec, 8, sx_start)
    poke_i64(sx_rec, 16, sx_end)
    poke_i64(sx_rec, 24, sx_left)
    poke_i64(sx_rec, 32, sx_right)
    poke_i64(sx_tree, 16, sx_count + 1)
    return sx_count
syntax_next sx_tree:
    sx_source: peek_i64(sx_tree, 0)
    sx_n: peek_i64(sx_tree, 8)
    sx_i: peek_i64(sx_tree, 64)
    as long as sx_i < sx_n
        if peek_byte(sx_source, sx_i) > 32 -> leave
        sx_i: sx_i + 1
    poke_i64(sx_tree, 80, sx_i)
    poke_i64(sx_tree, 72, 0)
    if sx_i is sx_n
        poke_i64(sx_tree, 88, sx_i)
        poke_i64(sx_tree, 64, sx_i)
        return 0
    sx_c: peek_byte(sx_source, sx_i)
    sx_i: sx_i + 1
    sx_kind: sx_c
    if syntax_word(sx_c) is 1
        sx_kind: 1
        if digitb(sx_c) is 1 -> sx_kind: 2
        as long as sx_i < sx_n
            if syntax_word(peek_byte(sx_source, sx_i)) is 0 -> leave
            sx_i: sx_i + 1
        if sx_kind is 2
            sx_a: peek_i64(sx_tree, 80)
            sx_hex: 0
            if sx_i > sx_a + 2
                if peek_byte(sx_source, sx_a) is 48
                    sx_h: peek_byte(sx_source, sx_a + 1)
                    if sx_h is 120 or sx_h is 98 -> sx_hex: 1
            if sx_hex is 0
                as long as sx_a < sx_i
                    if digitb(peek_byte(sx_source, sx_a)) is 0
                        poke_i64(sx_tree, 104, 2)
                    sx_a: sx_a + 1
    if not
        if sx_c is 34
            sx_kind: 3
            sx_closed: 0
            as long as sx_i < sx_n
                sx_b: peek_byte(sx_source, sx_i)
                sx_i: sx_i + 1
                if sx_b is 92
                    if sx_i < sx_n
                        sx_i: sx_i + 1
                    if not
                        leave
                if not
                    if sx_b is 34
                        sx_closed: 1
                        leave
            if sx_closed is 0 -> poke_i64(sx_tree, 104, 3)
        if not
            if sx_i < sx_n
                sx_d: peek_byte(sx_source, sx_i)
                if sx_c is 61 and sx_d is 61 -> sx_kind: 300
                if sx_c is 33 and sx_d is 61 -> sx_kind: 301
                if sx_c is 60 and sx_d is 61 -> sx_kind: 302
                if sx_c is 62 and sx_d is 61 -> sx_kind: 303
                if sx_c is 60 and sx_d is 60 -> sx_kind: 304
                if sx_c is 62 and sx_d is 62 -> sx_kind: 305
                if sx_c is 38 and sx_d is 38 -> sx_kind: 307
                if sx_c is 124 and sx_d is 124 -> sx_kind: 308
                if sx_kind >= 300
                    sx_i: sx_i + 1
                    if sx_kind is 305
                        if sx_i < sx_n
                            if peek_byte(sx_source, sx_i) is 62
                                sx_kind: 306
                                sx_i: sx_i + 1
    poke_i64(sx_tree, 72, sx_kind)
    poke_i64(sx_tree, 88, sx_i)
    poke_i64(sx_tree, 64, sx_i)
    return 0
syntax_expression sx_tree sx_min:
    sx_dep: peek_i64(sx_tree, 96) + 1
    if peek_i64(sx_tree, 104) is not 0 -> return 0
    if sx_dep > 150
        poke_i64(sx_tree, 104, 4)
        return 0
    poke_i64(sx_tree, 96, sx_dep)
    sx_kind: peek_i64(sx_tree, 72)
    sx_start: peek_i64(sx_tree, 80)
    sx_end: peek_i64(sx_tree, 88)
    sx_root: 0
    sx_text: 0
    if sx_kind is 1 or sx_kind is 2 or sx_kind is 3
        sx_root: syntax_add(sx_tree, 0, sx_start, sx_end, 0 - 1, 0 - 1)
        if sx_kind is 3 -> sx_text: 1
        syntax_next(sx_tree)
        if sx_kind is 1
            if peek_i64(sx_tree, 72) is 40
                sx_callee: sx_root
                sx_first: 0 - 1
                sx_last: 0 - 1
                syntax_next(sx_tree)
                if peek_i64(sx_tree, 72) is not 41
                    do forever
                        sx_arg: syntax_expression(sx_tree, 1)
                        if peek_i64(sx_tree, 104) is not 0 -> leave
                        sx_ar: sx_tree + 128 + sx_arg * 40
                        sx_link: syntax_add(sx_tree, 257, peek_i64(sx_ar, 8), peek_i64(sx_ar, 16), sx_arg, 0 - 1)
                        if sx_last is not 0 - 1
                            poke_i64(sx_tree + 128 + sx_last * 40, 32, sx_link)
                        if not
                            sx_first: sx_link
                        sx_last: sx_link
                        if peek_i64(sx_tree, 72) is not 44 -> leave
                        syntax_next(sx_tree)
                if peek_i64(sx_tree, 72) is not 41 -> poke_i64(sx_tree, 104, 5)
                sx_root: syntax_add(sx_tree, 256, sx_start, peek_i64(sx_tree, 88), sx_callee, sx_first)
                poke_i64(sx_tree, 40, peek_i64(sx_tree, 40) + 1)
                syntax_next(sx_tree)
    if not
        if sx_kind is 40
            syntax_next(sx_tree)
            sx_root: syntax_expression(sx_tree, 1)
            if peek_i64(sx_tree, 72) is not 41 -> poke_i64(sx_tree, 104, 5)
            sx_root: syntax_add(sx_tree, 268, sx_start, peek_i64(sx_tree, 88), sx_root, 0 - 1)
            syntax_next(sx_tree)
        if not
            if sx_kind is 45
                syntax_next(sx_tree)
                if peek_i64(sx_tree, 72) is not 2 -> poke_i64(sx_tree, 104, 6)
                sx_root: syntax_add(sx_tree, 0, sx_start, peek_i64(sx_tree, 88), 0 - 1, 0 - 1)
                syntax_next(sx_tree)
            if not
                poke_i64(sx_tree, 104, 7)
    as long as peek_i64(sx_tree, 104) is 0
        sx_prec: syntax_prec(peek_i64(sx_tree, 72))
        if sx_prec is 0 -> leave
        if sx_prec < sx_min -> leave
        if sx_text is 1
            poke_i64(sx_tree, 104, 8)
            leave
        sx_op: peek_i64(sx_tree, 72)
        syntax_next(sx_tree)
        sx_right: syntax_expression(sx_tree, sx_prec + 1)
        sx_lr: sx_tree + 128 + sx_root * 40
        sx_rr: sx_tree + 128 + sx_right * 40
        sx_root: syntax_add(sx_tree, sx_op, peek_i64(sx_lr, 8), peek_i64(sx_rr, 16), sx_root, sx_right)
        poke_i64(sx_tree, 40, peek_i64(sx_tree, 40) + 1)
    poke_i64(sx_tree, 96, sx_dep - 1)
    return sx_root
syntax_reference_build sx_source sx_n sx_tree:
    if sx_n < 1 -> return 0
    if sx_n > 4096 -> return 0
    poke_i64(sx_tree, 0, sx_source)
    poke_i64(sx_tree, 8, sx_n)
    sx_i: 2
    as long as sx_i < 16
        poke_i64(sx_tree, sx_i * 8, 0)
        sx_i: sx_i + 1
    syntax_next(sx_tree)
    sx_root: syntax_expression(sx_tree, 1)
    if peek_i64(sx_tree, 104) is not 0 -> return 0
    if peek_i64(sx_tree, 72) is not 0
        poke_i64(sx_tree, 104, 9)
        return 0
    poke_i64(sx_tree, 48, sx_root)
    return sx_tree
syntax_build sx_source sx_n sx_tree:
    if sx_n < 1 -> return 0
    if sx_n > 4096 -> return 0
    poke_i64(sx_tree, 0, sx_source)
    poke_i64(sx_tree, 8, sx_n)
    sx_i: 2
    as long as sx_i < 16
        poke_i64(sx_tree, sx_i * 8, 0)
        sx_i: sx_i + 1
    syntax_next(sx_tree)
    sx_root: syntax_expression(sx_tree, 1)
    if peek_i64(sx_tree, 104) is not 0 -> return 0
    if peek_i64(sx_tree, 72) is not 0
        poke_i64(sx_tree, 104, 9)
        return 0
    poke_i64(sx_tree, 48, sx_root)
    return sx_tree
syntax_emit sx_tree sx_node:
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_source: peek_i64(sx_tree, 0)
    sx_start: peek_i64(sx_rec, 8)
    sx_end: peek_i64(sx_rec, 16)
    sx_kind: peek_i64(sx_rec, 0)
    if sx_kind is 264
        rax_imm(peek_i64(sx_rec, 24))
        return 0
    if sx_kind is 265
        sx_first: peek_i64(sx_rec, 24)
        sx_last: peek_i64(sx_rec, 32)
        sx_name: intern_kid_n(sx_source + sx_first, sx_last - sx_first)
        if sx_name is kid_blank
            rax_str("")
            return 1
        loadv(sx_name)
        return atom_str_type(sx_name)
    if sx_kind is 266
        sx_first: peek_i64(sx_rec, 24)
        sx_last: peek_i64(sx_rec, 32)
        rax_str(sx_span_alloc(sx_source + sx_first + 1, sx_last - sx_first - 2))
        return 1
    if sx_kind is 268
        return syntax_operand(sx_tree, sx_node, 0, 0, 0)
    if sx_kind is 256 or sx_kind is 259
        return syntax_call(sx_tree, sx_node)
    if sx_kind >= 258 and sx_kind <= 262
