    self: 0 - 1
    busy: 0
    i: 0
    as long as i < _sov_list_len(br_at)
        e: peek_i64(br_at, 16 + i * 8)
        if e is at
            if peek_i64(br_st, 16 + i * 8) is not 4
                self: i
        if peek_i64(br_st, 16 + i * 8) is 0
