name_ok t:
    if plain_name(t) is 1
        if is_imm(t) is 0
            return 1
nind line:

    c: 0
    i: 0
    as long as 1
        b: peek_byte(line, i)
        if b is 0
            return c
        if b is 9
            print "Error: tab indent, use spaces"
            _sov_print(line)
            err_where()
            had_err: 1
            return c
        if b is not 32
            return c
        c: c + 1
        i: i + 1
