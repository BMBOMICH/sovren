expr_call e en name argl is_spawn sx_ctree sx_cnode:
    argc: _sov_list_len(argl)
    nid: 0
    if sx_ctree is not 0
        nid: name
    if not
        nid: intern_kid(name)
    ik_nm_ptr: nid
    ik_nm_kid: nid
