ca_put nm:
    h: 0
    i: 0
    cb: peek_byte(nm, 0)
    as long as cb is not 0
        h: h * 33 + cb
        i: i + 1
        cb: peek_byte(nm, i)
    ix: band(h, 511)
    as long as peek_i64(ca_tab, ix * 8) is not 0
        ix: band(ix + 1, 511)
    dummy: poke_i64(ca_tab, ix * 8, h)
    dummy: poke_i64(ca_ntab, ix * 8, nm)
