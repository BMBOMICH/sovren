@@ -1095,6 +1095,172 @@ emit_nt_rax_imm:
     emit(91)
     ret()
     return 1
+emit_nt_sv_lookup:
+    # Frameless volatile twin of sv_lookup (compiler.sov): the hashed
+    # str_vars index lookup with live-list verify. rdi is nm on entry,
+    # rax the result; rbx is saved (callers keep register-homed values
+    # there), r12-r15 untouched. The svt_sync staleness checks are
+    # inlined (any stale shape falls back to a real svt_sync call, so
+    # the sync/insert/rebuild work stays in one place); set_h's djb2
+    # (mov eax,5381 / imul 33 / add byte, two's-complement wrap ==
+    # the .sov i64 imul), the open-addressed probe loop and both
+    # _sov_str_eq verifies are inlined; the list_find fallbacks of the
+    # stale-hit paths stay calln'd (rare). Sovren comparisons are
+    # signed; the equality and wrap tests used here are sign-safe.
+    emit(83)
+    emit3(72, 137, 251)
+    # guards: str_vars null, list empty
+    load_glob("str_vars")
+    test_rax()
+    svg1: jz()
+    emit3(72, 139, 72)
+    emit(8)
+    emit3(72, 133, 201)
+    svg2: jz()
+    # svt_sync stale checks (all no-op when fresh)
+    load_glob("svt_tbl")
+    test_rax()
+    svs1: jz()
+    load_glob("svt_ptr")
+    emit3(72, 137, 202)
+    load_glob("str_vars")
+    emit3(72, 57, 194)
+    svs2: jne()
+    load_glob("svt_ln")
+    emit3(72, 57, 200)
+    svs3: jne()
+    load_glob("svt_cap")
+    emit3(72, 141, 84)
+    emit(9)
+    emit(2)
+    emit3(72, 57, 208)
+    svs4: jl()
+    patch(svs1)
+    patch(svs2)
+    patch(svs3)
+    patch(svs4)
+    svok: jmp()
+    calln("svt_sync")
+    patch(svok)
+    # probe setup: rsi=svt_tbl rdi=svt_idx r8=svt_cap
+    load_glob("svt_tbl")
+    emit3(72, 137, 198)
+    load_glob("svt_idx")
+    emit3(72, 137, 199)
+    load_glob("svt_cap")
+    emit3(73, 137, 192)
+    # djb2 over rbx (nm)
+    emit(184)
+    emit4(5381)
+    emit3(72, 49, 201)
+    svhl: here()
+    emit3(72, 15, 182)
+    emit(20)
+    emit(11)
+    emit3(72, 133, 210)
+    svh1: jz()
+    emit3(72, 107, 192)
+    emit(33)
+    emit3(72, 1, 208)
+    emit3(72, 255, 193)
+    emit(233)
+    emit4(svhl - (here() + 4))
+    patch(svh1)
+    emit3(73, 255, 200)
+    emit3(76, 33, 192)
+    # probe loop
+    svpl: here()
+    emit3(76, 139, 12)
+    emit(198)
+    emit3(76, 133, 201)
+    svp1: jz()
+    emit3(73, 57, 217)
+    svp2: jne()
+    # pointer hit: verify against the live list, else list_find
+    emit3(73, 137, 195)
+    emit3(76, 139, 20)
+    emit(199)
+    load_glob("str_vars")
+    emit3(74, 57, 116)
+    emit(216)
+    emit(16)
+    svv1: jne()
+    emit3(76, 137, 208)
+    emit(91)
+    ret()
+    # byte-equal hit on the table entry
+    patch(svp2)
+    svq1: here()
+    emit3(73, 15, 182)
+    emit(20)
+    emit(9)
+    emit3(76, 15, 182)
+    emit(20)
+    emit(11)
+    emit3(76, 57, 210)
+    svq2: jne()
+    emit3(72, 133, 210)
+    svq3: jz()
+    emit3(72, 255, 193)
+    emit(233)
+    emit4(svq1 - (here() + 4))
+    patch(svq3)
+    emit3(73, 137, 195)
+    emit3(76, 139, 20)
+    emit(199)
+    load_glob("str_vars")
+    emit3(78, 139, 76)
+    emit(208)
+    emit(16)
+    emit3(73, 57, 217)
+    svv2: jz()
+    svr1: here()
+    emit3(73, 15, 182)
+    emit(20)
+    emit(9)
+    emit3(76, 15, 188)
+    emit(20)
+    emit(11)
+    emit3(76, 57, 218)
+    svr2: jne()
+    emit3(72, 133, 210)
+    svr3: jz()
+    emit3(72, 255, 193)
+    emit(233)
+    emit4(svr1 - (here() + 4))
+    # return svt_ix (r10)
+    patch(svv2)
+    patch(svr3)
+    emit3(76, 137, 208)
+    emit(91)
+    ret()
+    # advance the probe cursor
+    patch(svq2)
+    emit3(72, 255, 192)
+    emit3(76, 57, 192)
+    svp4: jne()
+    emit3(72, 49, 192)
+    patch(svp4)
+    emit(233)
+    emit4(svpl - (here() + 4))
+    # stale-hit fallbacks: list_find(str_vars, nm)
+    patch(svv1)
+    patch(svr2)
+    load_glob("str_vars")
+    emit3(72, 137, 199)
+    emit3(72, 137, 222)
+    calln("list_find")
+    emit(91)
+    ret()
+    # miss
+    patch(svg1)
+    patch(svg2)
+    patch(svp1)
+    emit3(72, 199, 192)
+    emit4(0 - 1)
+    emit(91)
+    ret()
+    return 1
 emit_nt_reg_slot:
