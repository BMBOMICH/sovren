    if str_vars is not svt_ptr
        svt_build()
    if svt_nln < svt_ln
        svt_build()
    if svt_nln * 2 + 2 > svt_cap
        svt_build()
    as long as svt_ln < svt_nln
        svt_s: peek_i64(str_vars, 16 + svt_ln * 8)
        svt_h: set_h(svt_s)
        svt_sl: band(svt_h, svt_cap - 1)
        as long as peek_i64(svt_tbl, svt_sl * 8) is not 0
            svt_sl: svt_sl + 1
            if svt_sl is svt_cap
                svt_sl: 0
        poke_i64(svt_tbl, svt_sl * 8, svt_s)
        poke_i64(svt_idx, svt_sl * 8, svt_ln)
        svt_ln: svt_ln + 1
sv_lookup nm:
    # hashed list_find over str_vars. A hit is verified against the live
    # list because drop_str rewrites an entry to "" in place; a stale hit
    # falls back to the exact linear scan, so the answer is always the
    # list_find answer (first matching index, else -1).
    if str_vars is 0
        return 0 - 1
    if peek_i64(str_vars, 8) is 0
        return 0 - 1
    svt_sync()
    svt_h: set_h(nm)
    svt_sl: band(svt_h, svt_cap - 1)
    as long as 1 is 1
        svt_cur: peek_i64(svt_tbl, svt_sl * 8)
        if svt_cur is 0
            return 0 - 1
        if svt_cur is nm
            svt_ix: peek_i64(svt_idx, svt_sl * 8)
            if peek_i64(str_vars, 16 + svt_ix * 8) is nm
                return svt_ix
            return list_find(str_vars, nm)
        if _sov_str_eq(svt_cur, nm) is 1
            svt_ix: peek_i64(svt_idx, svt_sl * 8)
            svt_lv: peek_i64(str_vars, 16 + svt_ix * 8)
            if svt_lv is nm
                return svt_ix
            if _sov_str_eq(svt_lv, nm) is 1
                return svt_ix
            return list_find(str_vars, nm)
        svt_sl: svt_sl + 1
        if svt_sl is svt_cap
            svt_sl: 0

sglob_names: 0
sgt_tbl: 0
sgt_cap: 0
sgt_idx: 0
sgt_ln: 0
sgt_ptr: 0
sgt_build:
    # fresh empty table sized for the current sglob_names length.
    sgt_cap: 16
    as long as sgt_cap < _sov_list_len(sglob_names) * 2 + 2
        sgt_cap: sgt_cap + sgt_cap
    sgt_tbl: _sov_heap_alloc(sgt_cap * 8)
    sgt_idx: _sov_heap_alloc(sgt_cap * 8)
    dummy: _sov_bzero(sgt_tbl, sgt_cap * 8)
    dummy: _sov_bzero(sgt_idx, sgt_cap * 8)
    sgt_ln: 0
    sgt_ptr: sglob_names
sgt_sync:
    # sglob_names is append-only (string-literal globals found at parse):
    # insert just the new tail entries. Rebuild on first use, when the
    # list object changes, on shrink, or when outgrown.
    sgt_nln: _sov_list_len(sglob_names)
    if sgt_tbl is 0
        sgt_build()
    if sglob_names is not sgt_ptr
        sgt_build()
    if sgt_nln < sgt_ln
        sgt_build()
    if sgt_nln * 2 + 2 > sgt_cap
        sgt_build()
    as long as sgt_ln < sgt_nln
        sgt_s: peek_i64(sglob_names, 16 + sgt_ln * 8)
        sgt_h: set_h(sgt_s)
        sgt_sl: band(sgt_h, sgt_cap - 1)
        as long as peek_i64(sgt_tbl, sgt_sl * 8) is not 0
            sgt_sl: sgt_sl + 1
            if sgt_sl is sgt_cap
                sgt_sl: 0
        poke_i64(sgt_tbl, sgt_sl * 8, sgt_s)
        poke_i64(sgt_idx, sgt_sl * 8, sgt_ln)
        sgt_ln: sgt_ln + 1
sg_lookup nm:
    # index of nm among string-typed globals, else -1. Same answers as
    # list_find(sglob_names, nm) (insert-in-order first-wins).
    if sglob_names is 0
        return 0 - 1
    sgt_sync()
    sgt_h: set_h(nm)
    sgt_sl: band(sgt_h, sgt_cap - 1)
    as long as 1 is 1
        sgt_cur: peek_i64(sgt_tbl, sgt_sl * 8)
        if sgt_cur is 0
            return 0 - 1
        if sgt_cur is nm
            return peek_i64(sgt_idx, sgt_sl * 8)
        if _sov_str_eq(sgt_cur, nm) is 1
            return peek_i64(sgt_idx, sgt_sl * 8)
        sgt_sl: sgt_sl + 1
        if sgt_sl is sgt_cap
            sgt_sl: 0

set_has tbl cap s:
    # 1 when pointer-equal or byte-equal string already slotted; 0 otherwise.
    h: set_h(s)
    sl: band(h, cap - 1)
    as long as 1 is 1
        cur: peek_i64(tbl, sl * 8)
        if cur is 0
            return 0
        if cur is s
            return 1
        if _sov_str_eq(cur, s) is 1
            return 1
        sl: sl + 1
        if sl is cap
            sl: 0

set_add tbl cap s:
    h: set_h(s)
    sl: band(h, cap - 1)
    as long as 1 is 1
        cur: peek_i64(tbl, sl * 8)
        if cur is 0
            dummy: poke_i64(tbl, sl * 8, s)
            return 0
        if cur is s
            return 1
        if _sov_str_eq(cur, s) is 1
            return 1
        sl: sl + 1
        if sl is cap
            sl: 0


set_span_has tbl cap ln a b:
    # set_has over byte span ln[a..b), spaces read as '_' (same djb2
    # as set_h over the repl-normalized name).
    h: 5381
    i: a
    as long as i < b
        cb: peek_byte(ln, i)
        if cb is 32
            cb: 95
        h: h * 33 + cb
        i: i + 1
    sl: band(h, cap - 1)
    as long as 1 is 1
        cur: peek_i64(tbl, sl * 8)
        if cur is 0
            return 0
        if length(cur) is b - a
            eq: 1
            i: 0
            as long as i < b - a
                cb: peek_byte(ln, a + i)
                if cb is 32
                    cb: 95
                if peek_byte(cur, i) is not cb
                    eq: 0
                    i: b - a
                if eq is 1
                    i: i + 1
            if eq is 1
                return 1
        sl: sl + 1
        if sl is cap
            sl: 0

fl_span_new ln a b:
    # epoch dedupe over raw spans; 1 when newly inserted this epoch.
    h: 5381
    i: a
    as long as i < b
        cb: peek_byte(ln, i)
        if cb is 32
            cb: 95
        h: h * 33 + cb
        i: i + 1
    msk: floc_cap - 1
    cs: band(h, msk)
    guard: 0
    as long as guard <= msk
        if peek_i64(floc_ep, cs * 8) is not floc_epoch
            dummy: poke_i64(floc_ep, cs * 8, floc_epoch)
            dummy: poke_i64(floc_ln, cs * 8, ln)
            dummy: poke_i64(floc_a, cs * 8, a)
            dummy: poke_i64(floc_b, cs * 8, b)
            return 1
        ln2: peek_i64(floc_ln, cs * 8)
        a2: peek_i64(floc_a, cs * 8)
        b2: peek_i64(floc_b, cs * 8)
        eq: 1
        if b2 - a2 is not b - a
            eq: 0
        if eq is 1
            i: 0
            as long as i < b - a
                cb: peek_byte(ln, a + i)
                if cb is 32
                    cb: 95
                cb2: peek_byte(ln2, a2 + i)
                if cb2 is 32
                    cb2: 95
                if cb2 is not cb
                    eq: 0
                    i: b - a
                if eq is 1
                    i: i + 1
        if eq is 1
            return 0
        cs: band(cs + 1, msk)
        guard: guard + 1
    return 1

fl_span_newt ln a b:
    # fl_span_new plus a zeroed tally slot on insert, so candidate
    # dedupe and fl_span_tally can share one epoch: whichever probe
    # reaches a span first leaves a correct count base behind.
    h: 5381
    i: a
    as long as i < b
        cb: peek_byte(ln, i)
        if cb is 32
            cb: 95
        h: h * 33 + cb
        i: i + 1
    msk: floc_cap - 1
    cs: band(h, msk)
    guard: 0
    as long as guard <= msk
        if peek_i64(floc_ep, cs * 8) is not floc_epoch
            dummy: poke_i64(floc_ep, cs * 8, floc_epoch)
            dummy: poke_i64(floc_ln, cs * 8, ln)
            dummy: poke_i64(floc_a, cs * 8, a)
            dummy: poke_i64(floc_b, cs * 8, b)
            dummy: poke_i64(floc_c, cs * 8, 0)
            dummy: poke_i64(floc_ce, cs * 8, floc_epoch)
            return 1
        ln2: peek_i64(floc_ln, cs * 8)
        a2: peek_i64(floc_a, cs * 8)
        b2: peek_i64(floc_b, cs * 8)
        eq: 1
        if b2 - a2 is not b - a
            eq: 0
        if eq is 1
            i: 0
            as long as i < b - a
                cb: peek_byte(ln, a + i)
                if cb is 32
                    cb: 95
                cb2: peek_byte(ln2, a2 + i)
                if cb2 is 32
                    cb2: 95
                if cb2 is not cb
                    eq: 0
                    i: b - a
                if eq is 1
                    i: i + 1
        if eq is 1
            # Span already tallied this epoch: a fresh candidate only
            # when its candidate-epoch stamp is stale.  The tally
            # count is never touched here.
            if peek_i64(floc_ce, cs * 8) is floc_epoch
                return 0
            dummy: poke_i64(floc_ce, cs * 8, floc_epoch)
            return 1
        cs: band(cs + 1, msk)
        guard: guard + 1
    return 1

fl_span_tally ln a b w:
    # fl_span_new's probe, accumulating a weight per distinct span.
    ft_h: 5381
    ft_i: a
    as long as ft_i < b
        ft_cb: peek_byte(ln, ft_i)
        if ft_cb is 32
            ft_cb: 95
        ft_h: ft_h * 33 + ft_cb
        ft_i: ft_i + 1
    ft_msk: floc_cap - 1
    ft_cs: band(ft_h, ft_msk)
    ft_g: 0
    as long as ft_g <= ft_msk
        if peek_i64(floc_ep, ft_cs * 8) is not floc_epoch
            dummy: poke_i64(floc_ep, ft_cs * 8, floc_epoch)
            dummy: poke_i64(floc_ln, ft_cs * 8, ln)
            dummy: poke_i64(floc_a, ft_cs * 8, a)
            dummy: poke_i64(floc_b, ft_cs * 8, b)
            dummy: poke_i64(floc_c, ft_cs * 8, w)
            return
        ft_l2: peek_i64(floc_ln, ft_cs * 8)
        ft_a2: peek_i64(floc_a, ft_cs * 8)
        ft_b2: peek_i64(floc_b, ft_cs * 8)
        ft_eq: 1
        if ft_b2 - ft_a2 is not b - a
            ft_eq: 0
        if ft_eq is 1
            ft_i: 0
            as long as ft_i < b - a
                ft_cb: peek_byte(ln, a + ft_i)
                if ft_cb is 32
                    ft_cb: 95
                ft_c2: peek_byte(ft_l2, ft_a2 + ft_i)
                if ft_c2 is 32
                    ft_c2: 95
                if ft_c2 is not ft_cb
                    ft_eq: 0
                    ft_i: b - a
                if ft_eq is 1
                    ft_i: ft_i + 1
        if ft_eq is 1
            dummy: poke_i64(floc_c, ft_cs * 8, peek_i64(floc_c, ft_cs * 8) + w)
            return
        ft_cs: band(ft_cs + 1, ft_msk)
        ft_g: ft_g + 1

fl_span_count ln a b:
    ft_h: 5381
    ft_i: a
    as long as ft_i < b
        ft_cb: peek_byte(ln, ft_i)
        if ft_cb is 32
            ft_cb: 95
        ft_h: ft_h * 33 + ft_cb
        ft_i: ft_i + 1
    ft_msk: floc_cap - 1
    ft_cs: band(ft_h, ft_msk)
    ft_g: 0
    as long as ft_g <= ft_msk
        if peek_i64(floc_ep, ft_cs * 8) is not floc_epoch
            return 0
        ft_l2: peek_i64(floc_ln, ft_cs * 8)
        ft_a2: peek_i64(floc_a, ft_cs * 8)
        ft_b2: peek_i64(floc_b, ft_cs * 8)
        ft_eq: 1
        if ft_b2 - ft_a2 is not b - a
            ft_eq: 0
        if ft_eq is 1
            ft_i: 0
            as long as ft_i < b - a
                ft_cb: peek_byte(ln, a + ft_i)
                if ft_cb is 32
                    ft_cb: 95
                ft_c2: peek_byte(ft_l2, ft_a2 + ft_i)
                if ft_c2 is 32
                    ft_c2: 95
                if ft_c2 is not ft_cb
                    ft_eq: 0
                    ft_i: b - a
                if ft_eq is 1
                    ft_i: ft_i + 1
        if ft_eq is 1
            return peek_i64(floc_c, ft_cs * 8)
        ft_cs: band(ft_cs + 1, ft_msk)
        ft_g: ft_g + 1
    return 0

lord_ins lb_l lb_p lb_v:
    # Insert lb_v at lb_p.  The old shape rebuilt the whole list per
    # insert (a fresh list plus n adds), making lord_build's ordering
    # pass quadratic in allocations; shift the tail in place when
    # the slot is free and keep the rebuild for the grow case.
    li_n: _sov_list_len(lb_l)
    if li_n < peek_i64(lb_l, 0)
        li_i: li_n
        as long as li_i > lb_p
            dummy: poke_i64(lb_l, 16 + li_i * 8, peek_i64(lb_l, 16 + (li_i - 1) * 8))
            li_i: li_i - 1
        dummy: poke_i64(lb_l, 16 + lb_p * 8, lb_v)
        dummy: poke_i64(lb_l, 8, li_n + 1)
        return lb_l
    lb_o: _sov_list_new()
    lb_i: 0
    as long as lb_i < _sov_list_len(lb_l)
        if lb_i is lb_p
            lb_o: _sov_list_add(lb_o, lb_v)
        lb_o: _sov_list_add(lb_o, peek_i64(lb_l, 16 + lb_i * 8))
        lb_i: lb_i + 1
    if lb_p >= _sov_list_len(lb_l)
        lb_o: _sov_list_add(lb_o, lb_v)
    return lb_o

lord_has lb_cl lb_ca lb_cb ln a b:
    lb_k: 0
    as long as lb_k < _sov_list_len(lb_cl)
        lb_l2: peek_i64(lb_cl, 16 + lb_k * 8)
        lb_a2: peek_i64(lb_ca, 16 + lb_k * 8)
        lb_b2: peek_i64(lb_cb, 16 + lb_k * 8)
        lb_eq: 1
        if lb_b2 - lb_a2 is not b - a
            lb_eq: 0
        if lb_eq is 1
            lb_i: 0
            as long as lb_i < b - a
                lb_c1: peek_byte(ln, a + lb_i)
                if lb_c1 is 32
                    lb_c1: 95
                lb_c2: peek_byte(lb_l2, lb_a2 + lb_i)
                if lb_c2 is 32
                    lb_c2: 95
                if lb_c2 is not lb_c1
                    lb_eq: 0
                    lb_i: b - a
                if lb_eq is 1
                    lb_i: lb_i + 1
        if lb_eq is 1
            return 1
        lb_k: lb_k + 1
    return 0

lb_words ln ai lnn w:
    # Word-span tally scan for lord_build: every wordchar run in
    # ln[ai, lnn] whose first byte is not a digit is tallied with
    # weight w.  Written plainly for other backends; on x86
    # try_native_body plants emit_nt_lb_words (same semantics,
    # asm byte scan, fl_span_tally still called per word).
    i: ai
    ws: 0 - 1
    as long as i <= lnn
        ch: 0
        if i < lnn
            ch: peek_byte(ln, i)
        if wordchar(ch) is 1
            if ws < 0
                ws: i
        if not
            if ws > 0 - 1
                if digitb(peek_byte(ln, ws)) is 0
                    fl_span_tally(ln, ws, i, w)
                ws: 0 - 1
        i: i + 1

lord_build lb_fb lb_gh lb_gc lb_fc lb_np:
    # Frequency-ordered list of the body's assigned local names for
    # register-home seeding in walk_range (slot order decides who
    # gets the 5 callee-saved homes).  Words are tallied over the
    # body lines, with occurrences inside as-long-as/while extents
    # (indent stack) weighted 10x.  Returns 0 when every local fits
    # in a home anyway.  Params are pinned by walk_range regardless.
    # The same line pass also counts fn_locs for flor_range (published
    # as lord_fcnt): candidate targets are deduped with fl_span_newt on
    # the tally epoch, so flor needs no second body scan.  The table
    # is guaranteed sized by flor_range before this call.  The
    # register-order sort is still skipped when every local fits.
    floc_epoch: floc_epoch + 1
    lb_fcnt: 0
    lord_fcnt: 0
    lb_cl: _sov_list_new()
    lb_ca: _sov_list_new()
    lb_cb: _sov_list_new()
    lb_stk: _sov_list_new()
    lb_stkn: 0
    lb_n: _sov_list_len(lb_fb)
    lb_j: 0
    as long as lb_j < lb_n
        lb_ln: peek_i64(lb_fb, 16 + lb_j * 8)
        lb_ai: 0
        as long as peek_byte(lb_ln, lb_ai) is 32
            lb_ai: lb_ai + 1
        lb_pop: 1
        as long as lb_pop is 1
            lb_pop: 0
            if lb_stkn > 0
                if peek_i64(lb_stk, 16 + (lb_stkn - 1) * 8) >= lb_ai
                    lb_stkn: lb_stkn - 1
                    dummy: poke_i64(lb_stk, 8, lb_stkn)
                    lb_pop: 1
        lb_hdr: 0
        lb_fb0: peek_byte(lb_ln, lb_ai)
        if lb_fb0 is 97
            if _sov_starts_with(lb_ln + lb_ai, "as long as ") is 1
                lb_hdr: 1
        if lb_fb0 is 119
            if _sov_starts_with(lb_ln + lb_ai, "while ") is 1
                lb_hdr: 1
        if lb_fb0 is 100
            if _sov_starts_with(lb_ln + lb_ai, "do while ") is 1
                lb_hdr: 1
        lb_w: 1
        if lb_stkn > 0
            lb_w: 10
        if lb_hdr is 1
            lb_w: 10
        lb_lnn: length(lb_ln)
        lb_words(lb_ln, lb_ai, lb_lnn, lb_w)
        lb_b0: peek_byte(lb_ln, lb_ai)
        if lb_b0 is not 0
            if lb_b0 is not 35
                if lb_b0 is not 34
                    lb_gc2: find_col(lb_ln)
                    if lb_gc2 > lb_ai
                        if lb_gc2 < lb_lnn - 1
                            lb_eb: lb_gc2
                            lb_dun: 0
                            as long as lb_dun is 0
                                if lb_eb <= lb_ai
                                    lb_dun: 1
                                if lb_dun is 0
                                    if peek_byte(lb_ln, lb_eb - 1) is 32
                                        lb_eb: lb_eb - 1
                                    if not
                                        lb_dun: 1
                            if lb_eb > lb_ai
                                if set_span_has(lb_gh, lb_gc, lb_ln, lb_ai, lb_eb) is 0
                                    if fl_span_newt(lb_ln, lb_ai, lb_eb) is 1
                                        lb_fcnt: lb_fcnt + 1
                                        lb_cl: _sov_list_add(lb_cl, lb_ln)
                                        lb_ca: _sov_list_add(lb_ca, lb_ai)
                                        lb_cb: _sov_list_add(lb_cb, lb_eb)
        if lb_hdr is 1
            lb_stk: _sov_list_add(lb_stk, lb_ai)
            lb_stkn: lb_stkn + 1
        lb_j: lb_j + 1
    lord_fcnt: lb_fcnt
    if lb_fcnt + lb_np < 6
        return 0
    lb_on: _sov_list_new()
    lb_os: _sov_list_new()
    lb_k: 0
    lb_cln: _sov_list_len(lb_cl)
    as long as lb_k < lb_cln
        lb_sc: fl_span_count(peek_i64(lb_cl, 16 + lb_k * 8), peek_i64(lb_ca, 16 + lb_k * 8), peek_i64(lb_cb, 16 + lb_k * 8))
        lb_nm: repl(cut(peek_i64(lb_cl, 16 + lb_k * 8), peek_i64(lb_ca, 16 + lb_k * 8), peek_i64(lb_cb, 16 + lb_k * 8)), " ", "_")
        lb_pos: _sov_list_len(lb_on)
        lb_q: 0
        as long as lb_q < lb_pos
            if peek_i64(lb_os, 16 + lb_q * 8) < lb_sc
                lb_pos: lb_q
                lb_q: _sov_list_len(lb_on)
            lb_q: lb_q + 1
        lb_on: lord_ins(lb_on, lb_pos, lb_nm)
        lb_os: lord_ins(lb_os, lb_pos, lb_sc)
        lb_k: lb_k + 1
    return lb_on

nl_count_lines t:
    # exact replacement for _sov_list_len(lines_of(t)): newline count, plus one
    # when the last byte is not a newline (lines_of_fast's tail rule).  Same
    # SWAR haszero walk as lines_of_fast minus the list materialization.
    n: length(t)
    if n is 0
        return 0
    c: 0
    nlc: 72340172838076673 * 10
    i: 0
    as long as i + 8 <= n
        q: peek_i64(t, i)
        xq: bxor(q, nlc)
        m: band(band(xq - 72340172838076673, bxor(xq, 0 - 1)), -9187201950435737472)
        if m != 0
            j: 0
            as long as j < 8
                if peek_byte(t, i + j) = 10
                    c: c + 1
                j: j + 1
        i: i + 8
    as long as i < n
        if peek_byte(t, i) = 10
            c: c + 1
        i: i + 1
    if peek_byte(t, n - 1) != 10
        c: c + 1
    return c

cfind1n t st lim ch:
    # swar scan for one byte inside [st, lim).  the caller owns the bound, so
    # there is no length() call and no full-string strlen per line.
    if t is 0
        return 0 - 1
    i: st
    nb: ch
    nbc: nb * 72340172838076673
    as long as i + 8 <= lim
        q: peek_i64(t, i)
        xq: bxor(q, nbc)
        m: band(band(xq - 72340172838076673, bxor(xq, 0 - 1)), -9187201950435737472)
        if m is not 0
            j: 0
            as long as j < 8
                if peek_byte(t, i + j) is nb
                    return i + j
                j: j + 1
        i: i + 8
    as long as i < lim
        if peek_byte(t, i) is nb
            return i
        i: i + 1
    return 0 - 1
pd_log a b c d:
    if pd_report is 1
        _sov_print(join(i2s(a), join(",", join(i2s(b), join(",", join(i2s(c), join(",", i2s(d))))))))
    return 0

next_evt s fr lim:
    as long as fr < lim
        b: peek_byte(s, fr)
        if b is 34
            return fr
        if b is 40
            return fr
        if b is 41
            return fr
        if b is 44
            return fr
        if b is 92
            return fr
        fr: fr + 1
    return 0 - 1

cfind1 t ch:
    # swar scan for one byte.  aligned 8-byte reads never cross a page.
    if t is 0
        return 0 - 1
    n: length(t)
    i: 0
    nb: ch
    nbc: nb * 72340172838076673
    as long as i + 8 <= n
        q: peek_i64(t, i)
        xq: bxor(q, nbc)
        m: band(band(xq - 72340172838076673, bxor(xq, 0 - 1)), -9187201950435737472)
        if m is not 0
            b0: band(q, 255)
            if b0 is nb
                return i
            b1: band(bshr(q, 8), 255)
            if b1 is nb
                return i + 1
            b2: band(bshr(q, 16), 255)
            if b2 is nb
                return i + 2
            b3: band(bshr(q, 24), 255)
            if b3 is nb
                return i + 3
            b4: band(bshr(q, 32), 255)
            if b4 is nb
                return i + 4
            b5: band(bshr(q, 40), 255)
            if b5 is nb
                return i + 5
            b6: band(bshr(q, 48), 255)
            if b6 is nb
                return i + 6
            b7: band(bshr(q, 56), 255)
            if b7 is nb
                return i + 7
        i: i + 8
    as long as i < n
        if peek_byte(t, i) is nb
            return i
        i: i + 1
    return 0 - 1
sg_cat6 a b c d e f:
    # concatenate up to six strings into one fresh buffer. the old code
    # chained str_cat, which allocated once per link and recopied every
    # earlier piece into each intermediate result.
    la: length(a)
    lb: length(b)
    lc: length(c)
    ld: length(d)
    le: length(e)
    lf: length(f)
    buf: _sov_heap_alloc(la + lb + lc + ld + le + lf + 1)
    w: 0
    k: 0
    as long as k + 8 <= la
        poke_i64(buf, w, peek_i64(a, k))
        w: w + 8
        k: k + 8
    as long as k < la
        poke_byte(buf, w, peek_byte(a, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= lb
        poke_i64(buf, w, peek_i64(b, k))
        w: w + 8
        k: k + 8
    as long as k < lb
        poke_byte(buf, w, peek_byte(b, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= lc
        poke_i64(buf, w, peek_i64(c, k))
        w: w + 8
        k: k + 8
    as long as k < lc
        poke_byte(buf, w, peek_byte(c, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= ld
        poke_i64(buf, w, peek_i64(d, k))
        w: w + 8
        k: k + 8
    as long as k < ld
        poke_byte(buf, w, peek_byte(d, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= le
        poke_i64(buf, w, peek_i64(e, k))
        w: w + 8
        k: k + 8
    as long as k < le
        poke_byte(buf, w, peek_byte(e, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= lf
        poke_i64(buf, w, peek_i64(f, k))
        w: w + 8
        k: k + 8
    as long as k < lf
        poke_byte(buf, w, peek_byte(f, k))
        w: w + 1
        k: k + 1
    poke_byte(buf, w, 0)
    return buf
sg_cat2 a b:
    la: length(a)
    lb: length(b)
    buf: _sov_heap_alloc(la + lb + 1)
    w: 0
    k: 0
    as long as k + 8 <= la
        dummy: poke_i64(buf, w, peek_i64(a, k))
        w: w + 8
        k: k + 8
    as long as k < la
        dummy: poke_byte(buf, w, peek_byte(a, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= lb
        dummy: poke_i64(buf, w, peek_i64(b, k))
        w: w + 8
        k: k + 8
    as long as k < lb
        dummy: poke_byte(buf, w, peek_byte(b, k))
        w: w + 1
        k: k + 1
    dummy: poke_byte(buf, w, 0)
    return buf
sg_cat3 a b c:
    return sg_cat6(a, b, c, "", "", "")
sg_cat4 a b c d:
    la: length(a)
    lb: length(b)
    lc: length(c)
    ld: length(d)
    buf: _sov_heap_alloc(la + lb + lc + ld + 1)
    w: 0
    k: 0
    as long as k + 8 <= la
        dummy: poke_i64(buf, w, peek_i64(a, k))
        w: w + 8
        k: k + 8
    as long as k < la
        dummy: poke_byte(buf, w, peek_byte(a, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= lb
        dummy: poke_i64(buf, w, peek_i64(b, k))
        w: w + 8
        k: k + 8
    as long as k < lb
        dummy: poke_byte(buf, w, peek_byte(b, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= lc
        dummy: poke_i64(buf, w, peek_i64(c, k))
        w: w + 8
        k: k + 8
    as long as k < lc
        dummy: poke_byte(buf, w, peek_byte(c, k))
        w: w + 1
        k: k + 1
    k: 0
    as long as k + 8 <= ld
        dummy: poke_i64(buf, w, peek_i64(d, k))
        w: w + 8
        k: k + 8
    as long as k < ld
        dummy: poke_byte(buf, w, peek_byte(d, k))
        w: w + 1
        k: k + 1
    dummy: poke_byte(buf, w, 0)
    return buf
sg_cat5 a b c d e:
    return sg_cat6(a, b, c, d, e, "")
sg_match_n t i s tn:
    # the same test as sg_match with the length of t handed in. callers that
    # walk t one position at a time used to pay for length(t) on every
    # iteration, which turned a single scan into a quadratic one.
    if peek_byte(s, 0) is not 0
        if peek_byte(t, i) is not peek_byte(s, 0)
            return 0
    ls: length(s)
    if i + ls > tn
        return 0
    if ls is 0
        return 1
    k: 1
    as long as k < ls
        if peek_byte(t, i + k) is not peek_byte(s, k)
            return 0
        k: k + 1
    return 1
sg_match t i s:
    # reject on the first byte before measuring anything: for a non-empty
    # needle that is the whole answer, and it is what almost every position
    # gets.  An empty needle must still answer 1, so it skips the fast path.
    if peek_byte(s, 0) is not 0
        if peek_byte(t, i) is not peek_byte(s, 0)
            return 0
    ls: length(s)
    if i + ls > length(t)
        return 0
    if ls is 0
        return 1
    k: 1
    as long as k < ls
        if peek_byte(t, i + k) is not peek_byte(s, k)
            return 0
        k: k + 1
    return 1
sg_trim l:
    # strip() twin: same answer, but when the trailing bytes are clean the
    # result is a pointer into l, not a fresh copy (every indented, ws-clean
    # line skips its per-line allocation).  read-only uses only.
    tr_n: length(l)
    tr_t0: 0
    tr_go: 1
    as long as tr_go is 1
        if tr_t0 < tr_n
            if peek_byte(l, tr_t0) < 33
                tr_t0: tr_t0 + 1
            if not
                tr_go: 0
        if not
            tr_go: 0
    if tr_t0 is tr_n
        return l + tr_t0
    tr_t1: tr_n
    tr_go: 1
    as long as tr_go is 1
        if tr_t1 > tr_t0
            if peek_byte(l, tr_t1 - 1) < 33
                tr_t1: tr_t1 - 1
            if not
                tr_go: 0
        if not
            tr_go: 0
    if tr_t1 is tr_n
        return l + tr_t0
    return cut(l, tr_t0, tr_t1)

sg_cmp t:
    if cfind1(t, 61) < 0
        if look(t, " isnt ") < 0
            return t
    if look(t, " = ") < 0
        if look(t, " != ") < 0
            if look(t, " isnt ") < 0
                return t
    i: 0
    ins: 0
    n: length(t)
    as long as i < n
        b: peek_byte(t, i)
        esc: 0
        if b is 92
            esc: 1
        if esc is 1
            i: i + 2
        if not
            q: 0
            if b is 34
                q: 1
            if q is 1
                if ins is 0
                    ins: 1
                if not
                    ins: 0
                i: i + 1
            if not
                hit: 0
                if ins is 0
                    if sg_match(t, i, " isnt ") is 1
                        hit: 1
                        t: str_cat(str_cat(cut(t, 0, i), " is not "), cut(t, i + 6, length(t)))
                        n: length(t)
                        i: i + 8
                    if sg_match(t, i, " != ") is 1
                        hit: 1
                        t: str_cat(str_cat(cut(t, 0, i), " is not "), cut(t, i + 4, length(t)))
                        n: length(t)
                        i: i + 8
                    if not
                        if sg_match(t, i, " = ") is 1
                            hit: 1
                            t: str_cat(str_cat(cut(t, 0, i), " is "), cut(t, i + 3, length(t)))
                            n: length(t)
                            i: i + 4
                if hit is 0
                    i: i + 1
    return t
sg_digits t:
    v: 0
    got: 0
    k: 0
    sdg_ln: length(t)
    as long as k < sdg_ln
        b: peek_byte(t, k)
        dg: 0
        if b > 47
            if b < 58
                dg: 1
        if dg is 0
            k: length(t)
        if not
            v: v * 10 + (b - 48)
            got: 1
        k: k + 1
    if got is 0
        return 0 - 1
    return v
sg_pad3 v:
    d: v
    r: ""
    if d is 0
        r: "0"
    as long as d > 0
        r: join(cut("0123456789", d % 10, d % 10 + 1), r)
        d: d / 10
    if v < 10
        return join("00", r)
    if v < 100
        return join("0", r)
    return r
sg_ind l:
    n: 0
    k: 0
    sid_ln: length(l)
    as long as k < sid_ln
        b: peek_byte(l, k)
        if b is 32
            n: n + 1
        if b is 9
            n: n + 4
        if b is not 32
            if b is not 9
                k: length(l)
        k: k + 1
    return n
sg_sp n:
    if n < 1
        return ""
    return sg_sp_make(n)
sg_sp_make n:
    s: _sov_heap_alloc(n + 1)
    k: 0
    as long as k < n
        poke_byte(s, k, 32)
        k: k + 1
    poke_byte(s, n, 0)
    return s
sg_bare t:
    if peek_byte(t, 0) is 0
        return 0
    k: 0
    as long as 1
        b: peek_byte(t, k)
        if b is 0
            return 1
        if b is 32
            return 0
        k: k + 1
sg_word t:
    c0: peek_byte(t, 0)
    if c0 is 0
        return 0
    ok0: 0
    if c0 is 95
        ok0: 1
    if c0 > 64
        if c0 < 91
            ok0: 1
    if c0 > 96
        if c0 < 123
            ok0: 1
    if ok0 is 0
        return 0
    k: 0
    tn: length(t)
    as long as k < tn
        b: peek_byte(t, k)
        ok: 0
        if b is 95
            ok: 1
        if b > 47
            if b < 58
                ok: 1
        if b > 64
            if b < 91
                ok: 1
        if b > 96
            if b < 123
                ok: 1
        if ok is 0
            return 0
        k: k + 1
    return 1
sg_thresh t:
    if _sov_str_eq(t, "blank") is 1
        return 1
    if length(t) is 0
        return 0
    k: 0
    if peek_byte(t, 0) is 45 is 1
        k: 1
    if k is length(t)
        return 0
    d: 1
    sth_ln: length(t)
    as long as k < sth_ln
        b: peek_byte(t, k)
        if b < 48
            d: 0
        if b > 57
            d: 0
        k: k + 1
    return d
sg_len ls:
    n: 0
    i: 0
    ln: _sov_list_len(ls)
    as long as i < ln
        n: n + length(peek_i64(ls, 16 + i * 8)) + 1
        i: i + 1
    return n
sg_text ls:
    buf: _sov_heap_alloc(sg_len(ls) + 2)
    w: 0
    i: 0
    ll: _sov_list_len(ls)
    as long as i < ll
        ln: peek_i64(ls, 16 + i * 8)
        kl: length(ln)
        dummy: _sov_mem_copy(buf + w, ln, kl)
        w: w + kl
        poke_byte(buf, w, 10)
        w: w + 1
        i: i + 1
    poke_byte(buf, w, 0)
    return buf
sg_wc b:
    ok: 0
    if b is 95
        ok: 1
    if b > 47
        if b < 58
            ok: 1
    if b > 64
        if b < 91
            ok: 1
    if b > 96
        if b < 123
            ok: 1
    return ok
sg_ph t:
    k: 0
    sph_ln: length(t)
    as long as k < sph_ln
        if peek_byte(t, k) is 95
            lp: 1
            rp: 1
            if k > 0
                if sg_wc(_sov_byte_at(t, k - 1)) is 1
                    lp: 0
            if k < length(t) - 1
                if sg_wc(_sov_byte_at(t, k + 1)) is 1
                    rp: 0
            if lp is 1
                if rp is 1
                    return 1
        k: k + 1
sg_sub h nm:
    r: ""
    k: 0
    ssb_ln: length(h)
    as long as k < ssb_ln
        b: peek_byte(h, k)
        ph: 0
        if b is 95
            lp: 1
            rp: 1
            if k > 0
                if sg_wc(_sov_byte_at(h, k - 1)) is 1
                    lp: 0
            if k < length(h) - 1
                if sg_wc(_sov_byte_at(h, k + 1)) is 1
                    rp: 0
            if lp is 1
                if rp is 1
                    ph: 1
        if ph is 1
            r: str_cat(r, nm)
        if ph is 0
            r: str_cat(r, letter(h, k))
        k: k + 1
    return r
sg_unparen t:
    if peek_byte(t, 0) is not 40
        return t
    if length(t) > 1
        if peek_byte(t, length(t) - 1) is 41 is 1
            return cut(t, 1, length(t) - 1)
    return t
sg_stmt t:
    if cfind1(t, 58) < 0
        return 0
    ep: find_col(t)
    if ep > 0 - 1
        if ep < length(t) - 1
            if peek_byte(t, ep + 1) is 32 is 1
                return 1
    return 0
sg_sqok l:
    n: length(l)
    k: 0
    dq: 0
    sq: 0
    as long as k < n
        b: peek_byte(l, k)
        if b is 92
            k: k + 1
        if b is not 92
            if dq is 1
                if b is 34
                    dq: 0
            if not
                if sq is 1
                    if b is 39
                        sq: 0
                if not
                    if b is 35
                        k: n
                    if b is not 35
                        if b is 34
                            dq: 1
                        if b is 39
                            sq: 1
        k: k + 1
    ok: 1
    if dq is 1
        ok: 0
    if sq is 1
        ok: 0
    return ok
sg_sq2 l:
    n: length(l)
    buf: _sov_heap_alloc(n * 2 + 8)
    w: 0
    i: 0
    dq: 0
    sq: 0
    as long as i < n
        c: peek_byte(l, i)
        if dq is 1
            poke_byte(buf, w, c)
            w: w + 1
            if c is 92
                if i + 1 < n
                    poke_byte(buf, w, peek_byte(l, i + 1))
                    w: w + 1
                    i: i + 1
            if c is not 92
                if c is 34
                    dq: 0
        if not
            if sq is 1
                if c is 39
                    poke_byte(buf, w, 34)
                    w: w + 1
                    sq: 0
                if c is not 39
                    if c is 92
                        poke_byte(buf, w, c)
                        w: w + 1
                        if i + 1 < n
                            poke_byte(buf, w, peek_byte(l, i + 1))
                            w: w + 1
                            i: i + 1
                    if c is not 92
                        if c is 34
                            poke_byte(buf, w, 92)
                            w: w + 1
                        poke_byte(buf, w, c)
                        w: w + 1
            if not
                if c is 35
                    as long as i < n
                        poke_byte(buf, w, peek_byte(l, i))
                        w: w + 1
                        i: i + 1
                if c is not 35
                    if c is 34
                        dq: 1
                        poke_byte(buf, w, c)
                        w: w + 1
                    if c is not 34
                        if c is 39
                            poke_byte(buf, w, 34)
                            w: w + 1
                            sq: 1
                        if c is not 39
                            poke_byte(buf, w, c)
                            w: w + 1
        i: i + 1
    poke_byte(buf, w, 0)
    return buf
sg_sqs t:
    ls: lines_of(t)
    out: _sov_list_new()
    k: 0
    kl: _sov_list_len(ls)
    as long as k < kl
        l: peek_i64(ls, 16 + k * 8)
        sok: sg_sqok(l)
        if sok is 1
            out: _sov_list_add(out, sg_sq2(l))
        if sok is 0
            out: _sov_list_add(out, l)
        k: k + 1
    return sg_text(out)
sg_num t:
    n: length(t)
    if n is 0
        return 0
    i: 0
    as long as i < n
        b: peek_byte(t, i)
        if b < 48
            return 0
        if b > 57
            return 0
        i: i + 1
    return 1
sg_toks t:
    out: _sov_list_new()
    n: length(t)
    i: 0
    st: 0 - 1
    nt: 0
    as long as i < n
        c: peek_byte(t, i)
        if c is 32
            if st > 0 - 1
                out: _sov_list_add(out, cut(t, st, i))
                st: 0 - 1
        if c is not 32
            if st < 0
                st: i
        i: i + 1
    if st > 0 - 1
        out: _sov_list_add(out, cut(t, st, n))
    return out
sg_one l:
    # expand one line all the way: new lines made by sg_lists get the same
    # treatment as lines that were written out by hand. the 'name = value'
    # shape is a set, so it is settled before the compare words are touched.
    t: l
    if peek_byte(l, 0) < 33
        t: sg_trim(l)
    if _sov_starts_with(t, "#") is 1
        return l
    eqp: look(t, " = ")
    if eqp > 0 - 1
        hd2: strip(cut(t, 0, eqp))
        if sg_word(hd2) is 1
            return sg_cat4(sg_sp(sg_ind(l)), hd2, ": ", cut(t, eqp + 3, length(t)))
    gen: sg_lists(l)
    if _sov_list_len(gen) > 0
        if _sov_list_len(gen) is 1
            if _sov_str_eq(peek_i64(gen, 16), l) is 1
                return sg_cmp(l)
        out: _sov_list_new()
        gk: 0
        gk_ln: _sov_list_len(gen)
        as long as gk < gk_ln
            out: _sov_list_add(out, sg_one(peek_i64(gen, 16 + gk * 8)))
            gk: gk + 1
        return sg_text(out)
    return sg_cmp(l)
# a call run: one line standing for a whole family of calls.
#   RECV: FN 4 + i: 1 2 3        ->  FN(RECV, 4, 1)  FN(RECV, 5, 2)  FN(RECV, 6, 3)
#   RECV: FN 4 + i, 0: 1 2 3     ->  FN(RECV, 4, 0, 1)  FN(RECV, 5, 0, 2) ...
#   RECV: FN i, 0: 1 2 3         ->  FN(RECV + 0, 0, 1)  FN(RECV + 1, 0, 2) ...
# the address (or the receiver) steps by one for each value on the line.
sg_numt n:
    if n < 1
        return "0"
    buf: _sov_heap_alloc(32)
    w: 30
    v: n
    as long as v > 0
        w: w - 1
        poke_byte(buf, w, 48 + v % 10)
        v: v / 10
    poke_byte(buf, 31, 0)
    return buf + w
sg_run_head t:
    out: _sov_list_new()
    q: look(t, ": ")
    if q < 0
        return out
    recv: strip(cut(t, 0, q))
    rword: recv
    rstart: "0"
    if sg_word(recv) is 0
        ap: look(recv, " + ")
        if ap < 0
            return out
        if sg_word(strip(cut(recv, 0, ap))) is 0
            return out
        if sg_num(strip(cut(recv, ap + 3, length(recv)))) is 0
            return out
        rword: strip(cut(recv, 0, ap))
        rstart: strip(cut(recv, ap + 3, length(recv)))
    rest: cut(t, q + 2, length(t))
    cp: look(rest, ": ")
    if cp < 0
        return out
    head: strip(cut(rest, 0, cp))
    sp1: look(head, " ")
    if sp1 < 0
        return out
    vtext: strip(cut(rest, cp + 2, length(rest)))
    vals: sg_toks(vtext)
    if _sov_list_len(vals) < 2
        return out
    k: 0
    k_ln: _sov_list_len(vals)
    as long as k < k_ln
        if look(peek_i64(vals, 16 + k * 8), " ") > 0 - 1
            return out
        k: k + 1
    out: _sov_list_add(out, recv)
    out: _sov_list_add(out, cut(head, 0, sp1))
    out: _sov_list_add(out, strip(cut(head, sp1 + 1, length(head))))
    out: _sov_list_add(out, vtext)
    out: _sov_list_add(out, rword)
    out: _sov_list_add(out, rstart)
    return out
# reads the stepping argument of a call run.  returns an empty list when the line is not a run.
#   i            receiver steps by 1        (args: RECV + k ...)
#   i * 8        receiver steps by 8
#   4 + i        the address argument starts at 4 and steps by 1
#   16 + 4 * i   starts at 16, steps by 4
# anything after a comma is kept and written into every generated call.
sg_step_expr a:
    shape: 0
    base: 0
    step: 1
    extras: ""
    tail: ""
    if _sov_starts_with(a, "i") is 1
        shape: 2
        tail: strip((a + 1))
        if _sov_starts_with(tail, "*") is 1
            tail: strip((tail + 1))
            cm: look(tail, ",")
            npart: tail
            rest2: ""
            if cm > 0 - 1
                npart: strip(cut(tail, 0, cm))
                rest2: cut(tail, cm, length(tail))
            if sg_num(npart) is 1
                step: str_num(npart)
                tail: rest2
            if not
                shape: 0
    if shape is 0
        ri: look(a, " + ")
        if ri > 0 - 1
            if sg_num(strip(cut(a, 0, ri))) is 1
                base: str_num(strip(cut(a, 0, ri)))
                tail: cut(a, ri + 3, length(a))
                if _sov_starts_with(tail, "i") is 0
                    mt: look(tail, " * i")
                    if mt < 0
                        return _sov_list_new()
                    if sg_num(strip(cut(tail, 0, mt))) is 0
                        return _sov_list_new()
                    step: str_num(strip(cut(tail, 0, mt)))
                    tail: cut(tail, mt + 4, length(tail))
                if not
                    tail: (tail + 1)
                shape: 1
    if shape is 0
        return _sov_list_new()
    tail: strip(tail)
    if length(tail) > 0
        if _sov_starts_with(tail, ",") is 0
            return _sov_list_new()
        extras: tail
    if step < 1
        step: 1
    ok: _sov_list_new()
    ok: _sov_list_add(ok, shape)
    ok: _sov_list_add(ok, base)
    ok: _sov_list_add(ok, step)
    ok: _sov_list_add(ok, extras)
    return ok
sg_run l, out:
    t: strip(l)
    h: sg_run_head(t)
    if _sov_list_len(h) is 0
        return out
    rbase: peek_i64(h, 16)
    rword: peek_i64(h, 48)
    rstart: str_num(peek_i64(h, 56))
    fn: peek_i64(h, 24)
    e: sg_step_expr(peek_i64(h, 32))
    if _sov_list_len(e) is 0
        return out
    shape: peek_i64(e, 16)
    base: peek_i64(e, 24)
    step: peek_i64(e, 32)
    extras: peek_i64(e, 40)
    vals: sg_toks(peek_i64(h, 40))
    sp: sg_sp(sg_ind(l))
    k: 0
    k_ln: _sov_list_len(vals)
    as long as k < k_ln
        at: base + step * k
        line: sg_cat4(sp, fn, "(", "")
        if shape is 2
            line: str_cat(line, str_cat(rword, str_cat(" + ", sg_numt(rstart + at))))
        if shape is 1
            line: str_cat(line, str_cat(rbase, str_cat(", ", sg_numt(at))))
        if length(extras) > 0
            line: str_cat(line, extras)
        line: str_cat(line, str_cat(", ", str_cat(peek_i64(vals, 16 + k * 8), ")")))
        out: _sov_list_add(out, line)
        k: k + 1
    return out
sg_run_count t:
    q1: look(t, ": ")
    if q1 < 0
        return 0
    if _sov_find_text(t + q1 + 2, ": ") < 0
        return 0
    h: sg_run_head(t)
    if _sov_list_len(h) is 0
        return 0
    if _sov_list_len(sg_step_expr(peek_i64(h, 32))) is 0
        return 0
    return _sov_list_len(sg_toks(peek_i64(h, 40))) - 1
sg_lists l:
    # three line-kinds that stand for several lines.
    #   if x = y -> print z          ->  if x = y  +  indented print z
    #   as long as x -> y            ->  same shape
    #   0: STP BOK BBAD RES          ->  STP: 0  BOK: 0  BBAD: 0  RES: 0
    #   m: poke_byte 4 + i: 1 2 3    ->  poke_byte(m, 4, 1) poke_byte(m, 5, 2) ...
    #   see sg_run for the general call run form
    t: l
    if peek_byte(l, 0) < 33
        t: sg_trim(l)
    out: _sov_list_new()
    q1: look(t, ": ")
    if q1 < 0
        return out
    if _sov_find_text(t + q1 + 2, ": ") > 0 - 1
        out: sg_run(l, out)
        if _sov_list_len(out) > 0
            return out
    # precheck: sg_num(left) is 1 only if every left byte is a digit; the
    # trimmed line's first byte decides that without the cut/strip allocs.
    if peek_byte(t, 0) < 48
        return out
    if peek_byte(t, 0) > 57
        return out
    left: strip(cut(t, 0, q1))
    if sg_num(left) is 0
        return out
    right: strip(cut(t, q1 + 2, length(t)))
    toks: sg_toks(right)
    okv: 1
    k: 0
    k_ln: _sov_list_len(toks)
    as long as k < k_ln
        if sg_word(peek_i64(toks, 16 + k * 8)) is 0
            okv: 0
        k: k + 1
    if okv is 0
        return out
    if k_ln < 2
        return out
    sp: sg_sp(sg_ind(l))
    k: 0
    as long as k < k_ln
        out: _sov_list_add(out, sg_cat4(sp, peek_i64(toks, 16 + k * 8), ": ", left))
        k: k + 1
    return out
sg_extra t:
    # how many lines the expansion turns this one line into, minus one. the
    # compiler marks where the user's own file starts by counting lines, so
    # every line the expansion grows has to be counted the same way here.
    ps: t
    np: 1
    # a line with no pack mark cannot split, so skip the byte-walk.
    if _sov_find_text(t, ";;") > 0 - 1
        ps: sg_cuts(t)
        np: _sov_list_len(ps)
    if np > 1
        r: np - 1
        pk: 0
        as long as pk < np
            r: r + sg_extra(peek_i64(ps, 16 + pk * 8))
            pk: pk + 1
        return r
    if sg_arrow(t) is 1
        pp: look(t, " -> ")
        return 1 + sg_extra(strip(cut(t, pp + 4, length(t))))
    e: sg_run_count(t)
    if e > 0
        return e
    cp: look(t, ": ")
    if cp > 0 - 1
        # sg_num(strip(left)) can only be 1 when the first trimmed
        # byte of the left span is a digit; decide that in place
        # instead of paying cut/strip allocations per assignment.
        nb: 0
        nbgo: 1
        as long as nbgo is 1
            nbb: peek_byte(t, nb)
            if nbb is 32
                nb: nb + 1
            if not
                if nbb is 9
                    nb: nb + 1
                if not
                    if nbb is 10
                        nb: nb + 1
                    if not
                        if nbb is 13
                            nb: nb + 1
                        if not
                            nbgo: 0
        if peek_byte(t, nb) > 47
            if peek_byte(t, nb) < 58
                left: strip(cut(t, 0, cp))
                right: strip(cut(t, cp + 2, length(t)))
                if sg_num(left) is 1
                    toks: sg_toks(right)
                    okv: 1
                    k: 0
                    as long as k < _sov_list_len(toks)
                        if sg_word(peek_i64(toks, 16 + k * 8)) is 0
                            okv: 0
                        k: k + 1
                    if okv is 1
                        if _sov_list_len(toks) > 1
                            return _sov_list_len(toks) - 1
    return 0
sg_extra_ls ls:
    ins: 0
    d: 0
    i: 0
    n: _sov_list_len(ls)
    as long as i < n
        l: peek_i64(ls, 16 + i * 8)
        if ins is 0
            # Fast decline (decision-identical): sg_extra can only be
            # nonzero when the line holds a pack mark (';;' or '>', the
            # sg_marks bits), or a ": " whose LHS starts with a digit,
            # or two ": " (run form).  Everything else returns 0
            # without the strip allocation and the four text scans.
            sxl_need: 0
            if band(sg_marks(l), 3) is not 0
                sxl_need: 1
            if sxl_need is 0
                sxl_cp: look(l, ": ")
                if sxl_cp > 0 - 1
                    sxl_nb: 0
                    sxl_go: 1
                    as long as sxl_go is 1
                        sxl_bb: peek_byte(l, sxl_nb)
                        if sxl_bb is 32
                            sxl_nb: sxl_nb + 1
                        if not
                            if sxl_bb is 9
                                sxl_nb: sxl_nb + 1
                            if not
                                sxl_go: 0
                    if peek_byte(l, sxl_nb) > 47
                        if peek_byte(l, sxl_nb) < 58
                            sxl_need: 1
                    if sxl_need is 0
                        if _sov_find_text(l + sxl_cp + 2, ": ") > 0 - 1
                            sxl_need: 1
            if sxl_need is 1
                d: d + sg_extra(strip(l))
        ins: sg_qend(l, ins)
        i: i + 1
    return d
sg_extra_all src:
    ls: lines_of(src)
    return sg_extra_ls(ls)
sg_arrow t:
    # is this line a one-line 'if ...' / 'as long as ...' with a ' -> ' body?
    pp: look(t, " -> ")
    if pp < 0
        return 0
    if length(strip(cut(t, pp + 4, length(t)))) is 0
        return 0
    hd: strip(cut(t, 0, pp))
    if _sov_starts_with(hd, "if ") is 1
        return 1
    if _sov_starts_with(hd, "as long as ") is 1
        return 1
    return 0
sg_qend l inp:
    # where the string state lands after this line: 1 means the line ends
    # inside a quoted string, so the next line is still string text.
    # Without a double quote, escapes cannot change the incoming quote state.
    # cfind1 is a native scan in the self-hosted compiler; avoid per-byte work
    # on the overwhelmingly common quote-free line without changing escapes.
    if cfind1(l, 34) < 0
        return inp
    ins: inp
    i: 0
    n: length(l)
    as long as i < n
        b: peek_byte(l, i)
        if b is 92
            i: i + 1
        if not
            if b is 34
                ins: 1 - ins
        i: i + 1
    return ins
sg_cut_at l start:
    # Next unquoted pack delimiter. start is 0 or just after a previous
    # delimiter, hence quote state starts clear. The compiler has a native
    # twin; this body is the portable reference used by other backends.
    n: length(l)
    k: start
    dq: 0
    sq: 0
    go: 0
    as long as k < n
        b: peek_byte(l, k)
        go: 1
        if b is 92
            go: 0
            k: k + 1
        if go is 1
            if b is 34
                if dq is 1
                    dq: 0
                if not
                    if sq is 0
                        dq: 1
        if go is 1
            if b is 39
                if sq is 1
                    sq: 0
                if not
                    if dq is 0
                        sq: 1
        if go is 1
            if b is 59
                if dq is 0
                    if sq is 0
                        if k + 1 < n
                            if peek_byte(l, k + 1) is 59
                                return k
        k: k + 1
    return 0 - 1
sg_cuts l:
    # Each found delimiter is outside quotes; restarting there preserves
    # the old state machine exactly, including escapes and empty pieces.
    out: _sov_list_new()
    n: length(l)
    start: 0
    k: sg_cut_at(l, start)
    as long as k > 0 - 1
        out: _sov_list_add(out, cut(l, start, k))
        start: k + 2
        k: sg_cut_at(l, start)
    out: _sov_list_add(out, cut(l, start, n))
    return out
sg_starts_at t a p:
    # does the prefix p sit at offset a of t?  scan only, no copies.
    k: 0
    as long as 1
        cp: peek_byte(p, k)
        if cp is 0
            return 1
        if peek_byte(t, a + k) is not cp
            return 0
        k: k + 1
sg_seg s a b ind:
    # sp(ind) + s[a..b) in one allocation: the hot path of the arrow split
    # (indent slice + trimmed piece) without cut/strip intermediates.
    sn: b - a
    buf: _sov_heap_alloc(ind + sn + 1)
    sp2: sg_sp(ind)
    # Both spans already have proven bounds at the arrow split call sites.
    # Copy them in bulk instead of calling peek/poke for every byte.
    if ind > 0
        dummy6: _sov_mem_copy(buf, sp2, ind)
    if sn > 0
        dummy6: _sov_mem_copy(buf + ind, s + a, sn)
    dummy6: poke_byte(buf, ind + sn, 0)
    return buf
sg_exp_push out, l, ind, keep:
    # one line of the long form: a one-line if becomes two lines.  a piece of
    # a packed line is put back at the indent of the line it came from; a line
    # that was not packed is handed on exactly as it was written, so odd
    # spacing still reaches the part of the compiler that judges it.
    if cfind1(l, 62) < 0
        if keep is 1
            out: _sov_list_add(out, l)
            return out
        t: l
        if peek_byte(l, 0) < 33
            t: sg_trim(l)
        out: _sov_list_add(out, sg_cat2(sg_sp(ind), t))
        return out
    t: l
    if peek_byte(l, 0) < 33
        t: sg_trim(l)
    # fused arrow test + split: one ' -> ' probe, bound scans for the two
    # trimmed halves, two single-allocation pieces.  Same verdict as
    # sg_arrow (header must start with 'if ' / 'as long as ', body must not
    # be empty) with the cut/strip round trips gone.
    pp: look(t, " -> ")
    if pp > 0 - 1
        a0: 0
        ah: pp
        as long as a0 < pp
            if peek_byte(t, a0) < 33
                a0: a0 + 1
            if not
                ah: a0
                a0: pp
        a1: pp
        ad: 0
        as long as ad is 0
            if a1 > ah
                if peek_byte(t, a1 - 1) < 33
                    a1: a1 - 1
                if not
                    ad: 1
            if not
                ad: 1
        b0: pp + 4
        bn: length(t)
        bh: b0
        as long as bh < bn
            if peek_byte(t, bh) < 33
                bh: bh + 1
            if not
                b0: bh
                bh: bn
        b1: bn
        ad: 0
        as long as ad is 0
            if b1 > b0
                if peek_byte(t, b1 - 1) < 33
                    b1: b1 - 1
                if not
                    ad: 1
            if not
                ad: 1
        if a1 > ah
            if b1 > b0
            k1: sg_starts_at(t, ah, "if ")
            k2: 0
            if k1 is 0
                k2: sg_starts_at(t, ah, "as long as ")
            if k1 is 1
                out: _sov_list_add(out, sg_seg(t, ah, a1, ind))
                out: _sov_list_add(out, sg_seg(t, b0, b1, ind + 4))
                return out
            if k2 is 1
                out: _sov_list_add(out, sg_seg(t, ah, a1, ind))
                out: _sov_list_add(out, sg_seg(t, b0, b1, ind + 4))
                return out
    if keep is 1
        out: _sov_list_add(out, l)
        return out
    out: _sov_list_add(out, sg_cat2(sg_sp(ind), t))
    return out
u2_conv c:
    # chained one-liner arrows: split each piece once more, in order, the
    # way the old second whole-text pass did.  input list is consumed; the
    # (possibly fresh) result list comes back.
    cn: _sov_list_len(c)
    if cn < 2
        return c
    cx: _sov_list_new()
    ck: 0
    as long as ck < cn
        cp: peek_i64(c, 16 + ck * 8)
        if cfind1(cp, 62) > 0 - 1
            ct: sg_exp_push(_sov_list_new(), cp, sg_ind(cp), 1)
            if _sov_list_len(ct) is 2
                cx: _sov_list_add(cx, peek_i64(ct, 16))
                cx: _sov_list_add(cx, peek_i64(ct, 24))
            if not
                cx: _sov_list_add(cx, cp)
        if not
            cx: _sov_list_add(cx, cp)
        ck: ck + 1
    return cx

sg_exp src:

    # put a packed line back on several lines before anything else looks at
    # the text, so a packed line and the hand-written long form take exactly
    # the same path through the expansion.  'if C -> S' goes back on two lines
    # here as well.
    ls: lines_of(src)
    out: _sov_list_new()
    ins: 0
    i: 0
    n: _sov_list_len(ls)
    as long as i < n
        l: peek_i64(ls, 16 + i * 8)
        if ins is 1
            out: _sov_list_add(out, l)
        if ins is 0
            ps: sg_cuts(l)
            np: _sov_list_len(ps)
            if np is 1
                out: sg_exp_push(out, l, sg_ind(l), 1)
            if np > 1
                pk: 0
                as long as pk < np
                    out: sg_exp_push(out, peek_i64(ps, 16 + pk * 8), sg_ind(l), 0)
                    pk: pk + 1
        ins: sg_qend(l, ins)
        i: i + 1
    return sg_text(out)
sg_marks l:
    # one native-friendly probe pass for the fused expansion walk: which of the
    # three stage-A/B marks does this line hold?  bit 0 = ';;', bit 1 = '>',
    # bit 2 = apostrophe.  The self-hosted compiler replaces this body with
    # hand-written machine code (see emit_nt_sg_marks); this source is the
    # exact same answer for every other build.
    mk: 0
    if cfind1(l, 62) > 0 - 1
        mk: mk + 2
    if cfind1(l, 39) > 0 - 1
        mk: mk + 4
    if look(l, ";;") > 0 - 1
        mk: mk + 1
    return mk

pu_lines src:
    # A source that mentions a compact form is read through cx_read, the only
    # place those forms are understood.  Plain text takes the fusion seam below,
    # so the common case still hands back the pruner's own list untouched.
    if sg_plain(src) is 0
        return cx_read(src)
    # fusion seam: hand back the pruner's own logical-line list when the caller
    # holds the exact text it came from.  the caller gets a FRESH list holding
    # the same line strings (mutation-safe), and the stash is consumed by the
    # serve, so no later caller can ever see a stale pairing.
    if sg_pu_txt is not 0
        if src is sg_pu_txt
            n2: _sov_list_len(sg_pu_ls)
            # Copy the pointer vector, not its strings.  Reserve one spare slot
            # so even an empty result remains a growable, nonzero-capacity list.
            out2: _sov_heap_alloc(24 + n2 * 8)
            poke_i64(out2, 0, n2 + 1)
            poke_i64(out2, 8, n2)
            dummy: _sov_mem_copy(out2 + 16, sg_pu_ls + 16, n2 * 8)
            sg_pu_txt: 0
            sg_pu_ls: 0
            return out2
    return lines_of_fast(src)

zz_nt: 0
zz_ni: 0
zz_ncap: 0
zz_nsync_hi: 0
zz_nsync:
    if zz_ncap is 0
        zz_ncap: 65536
        zz_nt: _sov_heap_alloc(zz_ncap * 8)
        dummy: _sov_bzero(zz_nt, zz_ncap * 8)
    zn: _sov_list_len(names)
    if zz_nsync_hi >= zn
        return 0
    # grow past 50% load; re-insert old slot pointers (identity stable)
    as long as zn * 2 > zz_ncap
        zz_nnh: _sov_heap_alloc(zz_ncap * 16)
        dummy: _sov_bzero(zz_nnh, zz_ncap * 16)
        zz_gi: 0
        as long as zz_gi < zz_ncap
            zz_gs: peek_i64(zz_nt, zz_gi * 8)
            if zz_gs is not 0
                zz_gh: band(nhash(zz_gs), zz_ncap * 2 - 1)
                zz_gg: 1
                as long as zz_gg is 1
                    if peek_i64(zz_nnh, zz_gh * 8) is 0
                        poke_i64(zz_nnh, zz_gh * 8, zz_gs)
                        zz_gg: 0
                    if zz_gg is 1
                        zz_gh: band(zz_gh + 1, zz_ncap * 2 - 1)
            zz_gi: zz_gi + 1
        zz_nt: zz_nnh
        zz_ncap: zz_ncap * 2
    zi: zz_nsync_hi
    as long as zi < zn
        znm: peek_i64(names, 16 + zi * 8)
        zh: band(nhash(znm), zz_ncap - 1)
        zg: 1
        as long as zg is 1
            if peek_i64(zz_nt, zh * 8) is 0
                poke_i64(zz_nt, zh * 8, znm)
                zg: 0
            if zg is 1
                zh: band(zh + 1, zz_ncap - 1)
        zi: zi + 1
    zz_nsync_hi: zn
    return 0
zz_dup nm:
    # interned task-name dup-check: names list stays canonical; this is an
    # ID-style side table kept in sync incrementally (track 1.2)
    dummy: zz_nsync()
    zh: band(nhash(nm), zz_ncap - 1)
    zg: 1
    as long as zg is 1
        zs: peek_i64(zz_nt, zh * 8)
        if zs is 0
            return 0
        if _sov_str_eq(zs, nm) is 1
            return 1
        zh: band(zh + 1, zz_ncap - 1)
    return 0

sp_pu_lines src:
    # Track 1.1: single descriptor pass over the buffer; identical string list
    # out, without the old two-copy line split.  Descriptor arena lives in
    # library/sp.sov's format: [off, len, indent|flags, first].
    if sg_plain(src) is 0
        return cx_read(src)
    if sg_pu_txt is not 0 -> if src is sg_pu_txt
        cb2: cb2 + 1
        n2: _sov_list_len(sg_pu_ls)
        out2: _sov_heap_alloc(24 + n2 * 8)
        poke_i64(out2, 0, n2 + 1)
        poke_i64(out2, 8, n2)
        dummy: _sov_mem_copy(out2 + 16, sg_pu_ls + 16, n2 * 8)
        sg_pu_txt: 0
        sg_pu_ls: 0
        return out2
    r_lf: lines_of_fast(src)
    return r_lf

sg_plain src:
    if look(src, ": ") > 0 - 1
        return 0
    if look(src, " = ") > 0 - 1
        return 0
    if look(src, ";;") > 0 - 1
        return 0
    # != and #: probes cut: != is natively fused, #: never marks expansion
    if look(src, join(" -", "> ")) > 0 - 1
        return 0
    if look(src, " isnt ") > 0 - 1
        return 0
    if look(src, "0:") > 0 - 1
        return 0
    if look(src, "1:") > 0 - 1
        return 0
    if look(src, "2:") > 0 - 1
        return 0
    if look(src, "3:") > 0 - 1
        return 0
    if look(src, "4:") > 0 - 1
        return 0
    if look(src, "5:") > 0 - 1
        return 0
    if look(src, "6:") > 0 - 1
        return 0
    if look(src, "7:") > 0 - 1
        return 0
    if look(src, "8:") > 0 - 1
        return 0
    if look(src, "9:") > 0 - 1
        return 0
    if look(src, "blank:") > 0 - 1
        return 0
    if look(src, "use:") > 0 - 1
        return 0
    if look(src, "print:") > 0 - 1
        return 0
    if look(src, "emit:") > 0 - 1
        return 0
    # emit4:/emit8: contain 4:/8: so the digit probes above already fire
    if look(src, "):") > 0 - 1
        return 0
    q39: _sov_heap_alloc(2)
    poke_byte(q39, 0, 39)
    poke_byte(q39, 1, 0)
    if look(src, q39) > 0 - 1
        return 0
    return 1
cx_probe l:
    # one pass answering what the cx_read fall-through would otherwise
    # learn from sg_lists/sg_cmp's entry probes (several substring finds):
    #   bit0: a ": " occurs          bit1: a second ": " occurs later
    #   bit2: " != " occurs          bit3: " isnt " occurs
    # Scanned over the untrimmed line: occurrences the trimmed view would
    # lose can only sit in trimmed-off trailing space, which reads as a
    # (safe) slow-path vote here, never as a missed rewrite.
    r: 0
    i: 0
    n: length(l)
    as long as i < n
        c: peek_byte(l, i)
        if c is 58
            if peek_byte(l, i + 1) is 32
                if band(r, 1) is 1
                    r: bor(r, 2)
                if not
                    r: bor(r, 1)
        if c is 33
            if i > 0
                if peek_byte(l, i - 1) is 32
                    if peek_byte(l, i + 1) is 61
                        if peek_byte(l, i + 2) is 32
                            r: bor(r, 4)
        if c is 105
            if i > 0
                if peek_byte(l, i - 1) is 32
                    if peek_byte(l, i + 1) is 115
                        if peek_byte(l, i + 2) is 110
                            if peek_byte(l, i + 3) is 116
                                if peek_byte(l, i + 4) is 32
                                    r: bor(r, 8)
        i: i + 1
    return r

cx_info l:
    # One pass over the raw line answering everything loop 2 of cx_read
    # would otherwise learn from sg_trim + length + look(" = ") +
    # cx_probe (four scans plus an allocation), for the plain-line
    # bypass.  Bits: 1 last58 (last >=33 byte is ':'), 2 " = " occurs
    # at/after the indent, 4 first ": ", 8 second ": ", 16 " != ",
    # 32 " isnt ", 64 first trimmed byte is a digit.  The ": "/"!="/"isnt"
    # probes mirror cx_probe over the untrimmed line exactly (over-match
    # in trailing space only ever votes slow-path); " = " is searched in
    # the trimmed coordinate frame (occurrence must start at/after the
    # first >=33 byte), matching look(sg_trim(l)) -- an occurrence whose
    # trailing space sg_trim would cut also only over-matches.
    r: 0
    n: length(l)
    e: n - 1
    e58: 0
    as long as e > 0 - 1
        if e58 is 0
            eb: peek_byte(l, e)
            if eb > 32
                e58: 1
                if eb is 58
                    r: bor(r, 1)
            if not
                e: e - 1
        if e58 is 1
            e: 0 - 1
    lead: 0
    lgo: 1
    as long as lgo is 1
        if lead < n
            if peek_byte(l, lead) < 33
                lead: lead + 1
            if not
                lgo: 0
        if not
            lgo: 0
    if lead < n
        fb: peek_byte(l, lead)
        if fb > 47
            if fb < 58
                r: bor(r, 64)
    i: 0
    as long as i < n
        c: peek_byte(l, i)
        if c is 58
            if peek_byte(l, i + 1) is 32
                if band(r, 4) is 4
                    r: bor(r, 8)
                if not
                    r: bor(r, 4)
        if c is 61
            if i > lead
                if peek_byte(l, i - 1) is 32
                    if peek_byte(l, i + 1) is 32
                        r: bor(r, 2)
        if c is 33
            if i > 0
                if peek_byte(l, i - 1) is 32
                    if peek_byte(l, i + 1) is 61
                        if peek_byte(l, i + 2) is 32
                            r: bor(r, 16)
        if c is 105
            if i > 0
                if peek_byte(l, i - 1) is 32
                    if peek_byte(l, i + 1) is 115
                        if peek_byte(l, i + 2) is 110
                            if peek_byte(l, i + 3) is 116
                                if peek_byte(l, i + 4) is 32
                                    r: bor(r, 32)
        i: i + 1
    return r

cx_read source:
    # The compact forms are part of how a Sovren source is READ, not a stage
    # that runs before parsing: the line splitter hands the parser plain lines.
    # Callers whose text mentions no compact form skip this entirely (sg_plain).

    ls: lines_of(source)
    u_q39: look(source, "'")
    u_qskip: 0
    if u_q39 < 0
        u_qskip: 1
    out: _sov_list_new()
    sls: _sov_list_new()
    u2_scratch: 0
    uqc: 0
    ins: 0
    blk: 0
    bind: 0
    bval: blank
    bfn: blank
    bhd: blank
    btgt: blank
    g3n: 0
    k: 0
    kl: _sov_list_len(ls)
    as long as k < kl
        q: peek_i64(ls, 16 + k * 8)
        sq2v: q
        mkq: sg_marks(q)
        if u_qskip is 0
            if mkq > 3
                sok: sg_sqok(q)
                if sok is 1
                    sq2v: sg_sq2(q)
                    if _sov_str_eq(sq2v, q) is 0
                        uqc: 1
                        mkq: sg_marks(sq2v)
        cxk: 0 - 1
        e0: _sov_list_len(sls)
        if ins is 1
            sls: _sov_list_add(sls, sq2v)
        if not
            mk4: mkq - 4 * (mkq / 4)
            nsc: 0
            if mk4 - 2 * (mk4 / 2) is 0
                nsc: 1
            nar: 0
            if mk4 < 2
                nar: 1
            if nsc is 1
                if nar is 1
                    # Plain-line bypass: with no open block, loop 2 can
                    # only reach `out: add l` unchanged when the line
                    # cannot open a block (last58=0 kills every opener),
                    # holds no " = " rewrite, and satisfies the cxplain
                    # probe conditions.  cx_info answers all of it in
                    # one pass; the line then skips sls and loop 2 (and
                    # its sg_trim/look/cx_probe scans) entirely.
                    cxfast: 0
                    if blk is 0
                        cxi: cx_info(sq2v)
                        cxk: cxi
                        if band(cxi, 51) is 0
                            if band(cxi, 4) is 0
                                cxfast: 1
                            if not
                                if band(cxi, 72) is 0
                                    cxfast: 1
                    if cxfast is 1
                        out: _sov_list_add(out, sq2v)
                    if not
                        sls: _sov_list_add(sls, sq2v)
                if not
                    # u2_c recycled per line: u2_conv/exp_push only read/write
                    # slots up to the length header, so len:=0 reseats it.
                    if u2_scratch is 0
                        u2_scratch: _sov_list_new()
                    u2_c: u2_scratch
                    poke_i64(u2_c, 8, 0)
                    u2_c: sg_exp_push(u2_c, sq2v, sg_ind(sq2v), 1)
                    u2_c: u2_conv(u2_c)
                    u2_k: 0
                    u2_n: _sov_list_len(u2_c)
                    as long as u2_k < u2_n
                        sls: _sov_list_add(sls, peek_i64(u2_c, 16 + u2_k * 8))
                        u2_k: u2_k + 1
            if nsc is 0
                np: 1
                # band(mkq,1)==0  <=>  no ";;" anywhere in the line, hence
                # sg_cuts would return exactly [sq2v] (its quote/escape-aware
                # splitter only ever cuts at those bytes): skip its alloc+scan.
                ps: 0
                if band(mkq, 1) is 1
                    ps: sg_cuts(sq2v)
                    np: _sov_list_len(ps)
                uind: sg_ind(sq2v)
                if u2_scratch is 0
                    u2_scratch: _sov_list_new()
                u2_c: u2_scratch
                poke_i64(u2_c, 8, 0)
                if np is 1
                    u2_c: sg_exp_push(u2_c, sq2v, uind, 1)
                if np > 1
                    pk: 0
                    as long as pk < np
                        u2_c: sg_exp_push(u2_c, peek_i64(ps, 16 + pk * 8), uind, 0)
                        pk: pk + 1
                if nar is 0
                    u2_c: u2_conv(u2_c)
                u2_k: 0
                u2_n: _sov_list_len(u2_c)
                as long as u2_k < u2_n
                    sls: _sov_list_add(sls, peek_i64(u2_c, 16 + u2_k * 8))
                    u2_k: u2_k + 1
        ne: _sov_list_len(sls)
        i: e0
        as long as i < ne
            l: peek_i64(sls, 16 + i * 8)
            t: l
            if peek_byte(l, 0) < 33
                t: sg_trim(l)
            ind: sg_ind(l)
            last58: 0
            # When loop 1 already ran cx_info on this exact line (the
            # blk==0 append above), its bits answer last58 / " = " /
            # cx_probe exactly: bit1 is sg_trim's last-byte test, bit2
            # clear means look(t) misses, bits 4..32 are cx_probe<<2.
            lcxi: 0 - 1
            if i is e0
                lcxi: cxk
            if lcxi < 0
                cxtl: length(t)
                if cxtl > 0
                    if peek_byte(t, cxtl - 1) is 58
                        last58: 1
            if lcxi > 0 - 1
                last58: band(lcxi, 1)
            eqp: 0 - 1
            if lcxi < 0
                eqp: look(t, " = ")
            if lcxi > 0 - 1
                if band(lcxi, 2) is 2
                    eqp: look(t, " = ")
            done: 0
            bl_ok: 0
            if blk > 0
                tn: sg_unparen(t)
                stl: sg_stmt(t)
                if length(t) > 0
                    if ind > bind
                        bl_ok: 1
                if bl_ok is 1
                    if _sov_starts_with(t, "#") is 1
                        bl_ok: 0
                if bl_ok is 1
                    if stl is 0
                        if blk is 1
                            if sg_bare(tn) is 0
                                bl_ok: 0
                        if blk is 3
                            if sg_bare(tn) is 0
                                bl_ok: 0
                        if blk is 5
                            if sg_bare(tn) is 0
                                bl_ok: 0
                if bl_ok is 1
                    if stl is 1
                        done: 1
                        out: _sov_list_add(out, sg_cat2(sg_sp(ind), t))
                if bl_ok is 1
                    if stl is 0
                        done: 1
                        if blk is 1
                            out: _sov_list_add(out, sg_cat4(sg_sp(bind), "use ", tn, ""))
                        if blk is 2
                            tv: sg_toks(tn)
                            tv_ok: 1
                            tz: 0
                            tv_ln: _sov_list_len(tv)
                            as long as tz < tv_ln
                                if sg_num(peek_i64(tv, 16 + tz * 8)) is 0
                                    tv_ok: 0
                                tz: tz + 1
                            if tv_ok is 1
                                tz: 0
                                tz_ln: _sov_list_len(tv)
                                as long as tz < tz_ln
                                    out: _sov_list_add(out, sg_cat5(sg_sp(bind), bfn, "(", peek_i64(tv, 16 + tz * 8), ")"))
                                    tz: tz + 1
                            if tv_ok is 0
                                out: _sov_list_add(out, sg_cat5(sg_sp(bind), bfn, "(", tn, ")"))
                        if blk is 3
                            out: _sov_list_add(out, sg_cat4(sg_sp(bind), tn, ": ", bval))
                            g3n: g3n + 1
                        if blk is 4
                            rv: sg_digits(tn)
                            if rv > 0 - 1
                                out: _sov_list_add(out, str_cat(sg_sp(bind), str_cat(str_cat(bfn, sg_pad3(rv)), str_cat(": \"", str_cat(tn, "\"")))))
                        if blk is 5
                            ph5: sg_ph(bhd)
                            if ph5 is 1
                                out: _sov_list_add(out, sg_cat2(sg_sp(bind), sg_sub(bhd, tn)))
                            if ph5 is 0
                                out: _sov_list_add(out, sg_cat4(sg_sp(bind), tn, ": ", bhd))
                        if blk is 7
                            out: _sov_list_add(out, sg_cat4(sg_sp(bind), "print ", tn, ""))
                        if blk is 6
                            pp6: look(t, " -> ")
                            ea6: t
                            eb6: blank
                            if pp6 > 0 - 1
                                ea6: cut(t, 0, pp6)
                                eb6: cut(t, pp6 + 4, length(t))
                            acc6: sg_cat5(sg_sp(bind), btgt, ": ", bfn, "(")
                            acc6: str_cat(acc6, str_cat(btgt, str_cat(", ", ea6)))
                            if length(eb6) > 0
                                acc6: str_cat(acc6, str_cat(", ", eb6))
                            acc6: str_cat(acc6, ")")
                            out: _sov_list_add(out, acc6)
            if bl_ok is 0
                if blk is 3
                    if g3n < 2
                        print "Error: a value group needs two or more names; write one name directly"
                        fail()
                blk: 0
                if length(t) is 0
                    done: 1
                    out: _sov_list_add(out, l)
                if _sov_starts_with(t, "#") is 1
                    done: 1
                    out: _sov_list_add(out, l)
            if done is 0
                if last58 is 1
                    if _sov_str_eq(t, "use:") is 1
                        done: 1
                        blk: 1
                        bind: ind
                    if _sov_str_eq(t, "print:") is 1
                        done: 1
                        blk: 7
                        bind: ind
                    if _sov_str_eq(t, "emit:") is 1
                        done: 1
                        blk: 2
                        bind: ind
                        bfn: "emit"
                    if _sov_str_eq(t, "emit4:") is 1
                        done: 1
                        blk: 2
                        bind: ind
                        bfn: "emit4"
                    if _sov_str_eq(t, "emit8:") is 1
                        done: 1
                        blk: 2
                        bind: ind
                        bfn: "emit8"
                    if done is 0
                        if length(t) > 1
                            if peek_byte(t, length(t) - 2) is 35
                                hd9: cut(t, 0, length(t) - 2)
                                if length(hd9) > 0
                                    if sg_word(hd9) is 1
                                        if peek_byte(hd9, length(hd9) - 1) is 95
                                            done: 1
                                            blk: 4
                                            bind: ind
                                            bfn: hd9
            if done is 0
                ep: 0 - 1
                if last58 is 1
                    ep: find_col(t)
                if ep > 0 - 1
                    if ep is length(t) - 1
                        hd: strip(cut(t, 0, ep))
                        if sg_num(hd) is 1
                            # numeric task labels (px-generation lineage): a bare
                            # number-colon line whose indented body is statements, not
                            # value-group members.  Additive extension: digit headers
                            # never opened groups before, erroring with g3n=0 closes.
                            done: 1
                            out: _sov_list_add(out, l)
                        if done is 0
                            if sg_thresh(hd) is 1
                                done: 1
                                blk: 3
                                bind: ind
                                bval: hd
                                g3n: 0
            if done is 0
                if last58 is 1
                    hd6: strip(cut(t, 0, length(t) - 1))
                        q6: look(hd6, ": ")
                        if q6 > 0 - 1
                            lt6: strip(cut(hd6, 0, q6))
                            rt6: strip(cut(hd6, q6 + 2, length(hd6)))
                            if sg_word(lt6) is 1
                                if sg_word(rt6) is 1
                                    done: 1
                                    blk: 6
                                    bind: ind
                                    btgt: lt6
                                    bfn: rt6
            if done is 0
                ep5: 0 - 1
                if last58 is 1
                    ep5: find_col(t)
                if ep5 > 0 - 1
                    if ep5 is length(t) - 1
                        hd5: strip(cut(t, 0, ep5))
                        if length(hd5) > 0
                            if sg_bare(hd5) is 1
                                if peek_byte(hd5, length(hd5) - 1) is 41
                                    done: 1
                                    blk: 5
                                    bind: ind
                                    bhd: hd5
            if done is 0
                if eqp > 0 - 1
                    hd2: strip(cut(t, 0, eqp))
                    if sg_word(hd2) is 1
                        done: 1
                        out: _sov_list_add(out, sg_cat4(sg_sp(ind), hd2, ": ", cut(t, eqp + 3, length(t))))
            if done is 0
                if _sov_starts_with(t, "#") is 1
                    out: _sov_list_add(out, l)
                if not
                    cxp: 0
                    if lcxi < 0
                        cxp: cx_probe(l)
                    if lcxi > 0 - 1
                        cxp: band(lcxi, 60) / 4
                    cxplain: 0
                    if eqp < 0
                        if band(cxp, 12) is 0
                            # no " = "/" != "/" isnt ": sg_cmp returns l
                            # itself.  sg_lists can only fire on a second
                            # ": " or a digit-led line; excluded next.
                            if band(cxp, 1) is 0
                                cxplain: 1
                            if not
                                if band(cxp, 2) is 0
                                    if digitb(peek_byte(t, 0)) is 0
                                        cxplain: 1
                    if cxplain is 1
                        out: _sov_list_add(out, l)
                    if not
                        if band(cxp, 1) is 0
                            out: _sov_list_add(out, sg_cmp(l))
                        if not
                            gen: sg_lists(l)
                            if _sov_list_len(gen) > 0
                                gk: 0
                                gk_ln: _sov_list_len(gen)
                                as long as gk < gk_ln
                                    out: _sov_list_add(out, sg_one(peek_i64(gen, 16 + gk * 8)))
                                    gk: gk + 1
                            if _sov_list_len(gen) is 0
                                out: _sov_list_add(out, sg_cmp(l))
            i: i + 1
        ins: sg_qend(sq2v, ins)
        k: k + 1
    if blk is 3
        if g3n < 2
            print "Error: a value group needs two or more names; write one name directly"
            fail()
    return out
sg_pu_txt: 0
sg_pu_ls: 0
u_prep source:
    if look(source, "unsafe:") < 0
        return source
    # Exact second gate, in place (no lines_of allocation): only a line whose
    # first non-blank bytes spell 'unsafe:' can make the rewrite below change
    # anything; an occurrence inside a string or comment makes the byte pass
    # reproduce the text unchanged.  The scan can only over-match (a garbage
    # read past a short line at worst sends us down the original path), never
    # under-match.  Line starts come from a swar newline walk, so a source
    # that merely CONTAINS the text 'unsafe:' (error strings) skips the
    # expensive rewrite path instead of paying a full line split per compile.
    # Same decision as the old per-line forward scan, computed from
    # the occurrences backward: a hit iff some 'unsafe:' is preceded
    # on its line by at most 16 blanks and nothing else (the forward
    # scan's blank-skip stopped after 16, so 17+ blanks never hit).
    up_hit: 0
    up_p: look(source, "unsafe:")
    as long as up_p >= 0
        if up_hit is 0
            up_bk: up_p
            up_nb: 0
            up_go: 1
            as long as up_go is 1
                if up_bk is 0
                    up_go: 0
                if up_go is 1
                    up_bb: peek_byte(source, up_bk - 1)
                    if up_bb is 32
                        up_bk: up_bk - 1
                        up_nb: up_nb + 1
                    if not
                        if up_bb is 9
                            up_bk: up_bk - 1
                            up_nb: up_nb + 1
                        if not
                            up_go: 0
            if up_nb <= 16
                if up_bk is 0
                    up_hit: 1
                if not
                    if peek_byte(source, up_bk - 1) is 10
                        up_hit: 1
        up_rel: look(source + up_p + 1, "unsafe:")
        if up_rel < 0
            up_p: 0 - 1
        if not
            up_p: up_p + 1 + up_rel
    if up_hit is 0
        return source
    n: length(source)
    out: _sov_heap_alloc(n * 2 + 16)
    w: 0
    i: 0
    p_at: 0
    p_ind: 0
    as long as i < n
        l: i
        e: l
        eok: 0
        as long as eok is 0
            if e >= n
                eok: 1
            if eok is 0
                if peek_byte(source, e) is 10
                    eok: 1
            if eok is 0
                e: e + 1
        sind: 0
        k: l
        dok: 0
        as long as dok is 0
            if k >= e
                dok: 1
            if dok is 0
                kb: peek_byte(source, k)
                if kb is 32
                    sind: sind + 1
                    k: k + 1
                if kb is 9
                    sind: sind + 4
                    k: k + 1
                if kb is not 32
                    if kb is not 9
                        dok: 1
        is_u: 0
        if e - k is 7
            if peek_byte(source, k) is 117
                if peek_byte(source, k + 1) is 110
                    if peek_byte(source, k + 2) is 115
                        if peek_byte(source, k + 3) is 97
                            if peek_byte(source, k + 4) is 102
                                if peek_byte(source, k + 5) is 101
                                    if peek_byte(source, k + 6) is 58
                                        is_u: 1
        empty: 0
        if k >= e
            empty: 1
        is_c: 0
        if is_u is 0
            if k < e
                if peek_byte(source, k) is 35
                    is_c: 1
        deind: 0
        if is_u is 1
            p_at: 1
            p_ind: sind
            k2: l
            as long as k2 < k
                _sov_set_byte(out, w, _sov_byte_at(source, k2))
                w: w + 1
                k2: k2 + 1
            _sov_set_byte(out, w, 35)
            w: w + 1
            poke_byte(out, w, 32)
            w: w + 1
            poke_byte(out, w, 117)
            w: w + 1
            poke_byte(out, w, 110)
            w: w + 1
            poke_byte(out, w, 115)
            w: w + 1
            poke_byte(out, w, 97)
            w: w + 1
            poke_byte(out, w, 102)
            w: w + 1
            poke_byte(out, w, 101)
            w: w + 1
            poke_byte(out, w, 45)
            w: w + 1
            poke_byte(out, w, 98)
            w: w + 1
            poke_byte(out, w, 108)
            w: w + 1
            poke_byte(out, w, 111)
            w: w + 1
            poke_byte(out, w, 99)
            w: w + 1
            poke_byte(out, w, 107)
            w: w + 1
            poke_byte(out, w, 10)
            w: w + 1
        if is_u is 0
            if p_at is 1
                if empty is 0
                    if is_c is 0
                        if sind <= p_ind
                            p_at: 0
                        if sind > p_ind
                            deind: 1
        if is_u is 0
            skip: 0
            if deind is 1
                dc: 0
                k3: l
                dok3: 0
                as long as dok3 is 0
                    if dc >= p_ind
                        dok3: 1
                    if k3 >= e
                        dok3: 1
                    if dok3 is 0
                        kb3: peek_byte(source, k3)
                        if kb3 is 32
                            dc: dc + 1
                            k3: k3 + 1
                        if kb3 is 9
                            dc: dc + 4
                            k3: k3 + 1
                        if kb3 is not 32
                            if kb3 is not 9
                                dok3: 1
                skip: k3 - l
            c: l + skip
            as long as c < e
                _sov_set_byte(out, w, _sov_byte_at(source, c))
                w: w + 1
                c: c + 1
            _sov_set_byte(out, w, 10)
            w: w + 1
        i: e + 1
    poke_byte(out, w, 0)
    return out
u_san ln:
    if cfind1(ln, 34) < 0
        return ln
    # blank out the inside of string literals. the old body grew the result
    # with one str_cat per character, which is quadratic in the line length;
    # this writes into one buffer sized from length(ln) up front instead.
    n: length(ln)
    buf: _sov_heap_alloc(n + 1)
    instr: 0
    esc: 0
    usi: 0
    w: 0
    as long as usi < n
        b: peek_byte(ln, usi)
        ob: b
        if b is 92
            if esc is 0
                esc: 1
            if not
                esc: 0
        if not
            if b is 34
                if esc is 0
                    if instr is 0
                        instr: 1
                    if not
                        instr: 0
            esc: 0
        if instr is 1
            ob: 32
        poke_byte(buf, w, ob)
        w: w + 1
        usi: usi + 1
    poke_byte(buf, w, 0)
    return buf
u_scan source:
    # The gate used to be three sequential _sov_find_text probes (peek_/poke_/
    # port_, ~0.7 ms each on a t1-scale source).  One fused pass does it: hunt
    # every 'p' with cfind1n (memchr speed) and byte-check the 4 followers
    # against the three prefixes, discriminating on the second byte.  The
    # predicate is unchanged: a prefix matches here iff it matched before, so
    # the walk still runs exactly when it has a counted token to find.
    # whole-text gate: three native substring probes (peek_ / poke_ / port_)
    # answer exactly what the interpreted every-'p' hunt answered — uskip
    # stays 1 iff the text contains none of the three prefixes — at memmem
    # speed instead of one interpreted step per 'p' in the source.
    uskip: 1
    if look(source, "peek_") > 0 - 1
        uskip: 0
    if look(source, "poke_") > 0 - 1
        uskip: 0
    if look(source, "port_") > 0 - 1
        uskip: 0
    if uskip is 1
        return 0
    us_n: length(source)
    us_i: 0
    # Cursor over source lines instead of a lines_of split: the walk
    # below is already span-based ([toff, tend) peeks bounded by on),
    # so a line is (osl = source + start, on = its length).  Over-reads
    # in sg_starts_at can only hit the newline byte, which no literal
    # contains, so they can never false-match.  The one place needing
    # a terminated string (strip before u_san) cuts the span there.
    si: 0
    smod: 0
    smark: 0
    sbad: 0
    blk_at: 0
    blk_ind: 0
    us_pos: 0
    us_more: 1
    as long as us_more is 1
        us_e: cfind1n(source, us_pos, us_n, 10)
        if us_e < 0
            us_e: us_n
            us_more: 0
        osl: source + us_pos
        on: us_e - us_pos
        # one lead/trail walk replaces strip()+walk: indent units (space=+1,
        # tab=+4) and the trimmed span [toff, tend) - identical answers to
        # strip() (bytes 32/9/10/13) with zero allocations.
        sind: 0
        toff: 0
        ld: 1
        as long as ld is 1
            if toff >= on
                ld: 0
            if not
                cb: peek_byte(osl, toff)
                if cb is 32
                    sind: sind + 1
                    toff: toff + 1
                if not
                    if cb is 9
                        sind: sind + 4
                        toff: toff + 1
                    if not
                        if cb is 10
                            toff: toff + 1
                        if not
                            if cb is 13
                                toff: toff + 1
                            if not
                                ld: 0
        tend: on
        ld: 1
        as long as ld is 1
            if tend <= toff
                ld: 0
            if not
                cb: peek_byte(osl, tend - 1)
                if cb is 32
                    tend: tend - 1
                if not
                    if cb is 9
                        tend: tend - 1
                    if not
                        if cb is 10
                            tend: tend - 1
                        if not
                            if cb is 13
                                tend: tend - 1
                            if not
                                ld: 0
        sln: tend - toff
        blk_new: 0
        if sln is 7
            if sg_starts_at(osl, toff, "unsafe:") is 1
                blk_new: 1
        if blk_new is 1
            blk_at: 1
            blk_ind: sind
        in_blk: 0
        if blk_at is 1
            if sind > blk_ind
                in_blk: 1
            if sind <= blk_ind
                dd: 1
                if blk_new is 1
                    dd: 0
                if sln is 0
                    dd: 0
                if toff < tend
                    if peek_byte(osl, toff) is 35
                        dd: 0
                if dd is 1
                    blk_at: 0
        if sln > 0
            cm: 0
            if peek_byte(osl, toff) is 35
                cm: 1
            if cm is 1
                if sln > 14
                    if sg_starts_at(osl, toff, "# unsafe-module") is 1
                        smod: 1
                if sln is 8
                    if sg_starts_at(osl, toff, "# unsafe") is 1
                        smark: 1
            if cm is 0
                if smod is 0
                    if in_blk is 0
                        if cfind1n(osl, toff, tend, 112) >= 0
                            # The complete source bound is already known. Do not rescan
                            # its NUL terminator for every candidate line.
                            sl: strip(cutn(source, us_pos, us_pos + on, us_n))
                            slc: u_san(sl)
                            uraw: 0
                            ubare: 0
                            # fused probe scan: all six needles start with 'p',
                            # so one cfind1n walk replaces six whole-line look
                            # scans; byte-exact on every needle (bounds per
                            # needle length; reads past bounds never happen
                            # because the terminator NUL matches nothing).
                            us2_n: length(slc)
                            us2_i: 0
                            us2_go: 1
                            as long as us2_go is 1
                                us2_i: cfind1n(slc, us2_i, us2_n, 112)
                                if us2_i < 0
                                    us2_go: 0
                                if not
                                    u2r: 0
                                    u2b: 0
                                    us2_c1: peek_byte(slc, us2_i + 1)
                                    if us2_c1 is 101
                                        if us2_i + 10 <= us2_n
                                            if peek_byte(slc, us2_i + 2) is 101
                                                if peek_byte(slc, us2_i + 3) is 107
                                                    if peek_byte(slc, us2_i + 4) is 95
                                                        if peek_byte(slc, us2_i + 5) is 98
                                                            if peek_byte(slc, us2_i + 6) is 121
                                                                if peek_byte(slc, us2_i + 7) is 116
                                                                    if peek_byte(slc, us2_i + 8) is 101
                                                                        if peek_byte(slc, us2_i + 9) is 40
                                                                            u2r: 1
                                        if us2_i + 8 <= us2_n
                                            if peek_byte(slc, us2_i + 2) is 101
                                                if peek_byte(slc, us2_i + 3) is 107
                                                    if peek_byte(slc, us2_i + 4) is 95
                                                        if peek_byte(slc, us2_i + 5) is 114
                                                            if peek_byte(slc, us2_i + 6) is 97
                                                                if peek_byte(slc, us2_i + 7) is 119
                                                                    u2r: 1
                                                                u2b: 1
                                    if us2_c1 is 111
                                        if us2_i + 10 <= us2_n
                                            if peek_byte(slc, us2_i + 2) is 107
                                                if peek_byte(slc, us2_i + 3) is 101
                                                    if peek_byte(slc, us2_i + 4) is 95
                                                        if peek_byte(slc, us2_i + 5) is 98
                                                            if peek_byte(slc, us2_i + 6) is 121
                                                                if peek_byte(slc, us2_i + 7) is 116
                                                                    if peek_byte(slc, us2_i + 8) is 101
                                                                        if peek_byte(slc, us2_i + 9) is 40
                                                                            u2r: 1
                                        if us2_i + 8 <= us2_n
                                            if peek_byte(slc, us2_i + 2) is 107
                                                if peek_byte(slc, us2_i + 3) is 101
                                                    if peek_byte(slc, us2_i + 4) is 95
                                                        if peek_byte(slc, us2_i + 5) is 114
                                                            if peek_byte(slc, us2_i + 6) is 97
                                                                if peek_byte(slc, us2_i + 7) is 119
                                                                    u2r: 1
                                                                u2b: 1
                                        if us2_i + 8 <= us2_n
                                            if peek_byte(slc, us2_i + 2) is 114
                                                if peek_byte(slc, us2_i + 3) is 116
                                                    if peek_byte(slc, us2_i + 4) is 95
                                                        if peek_byte(slc, us2_i + 5) is 111
                                                            if peek_byte(slc, us2_i + 6) is 117
                                                                if peek_byte(slc, us2_i + 7) is 116
                                                                    u2r: 1
                                                                u2b: 1
                                        if us2_i + 7 <= us2_n
                                            if peek_byte(slc, us2_i + 2) is 114
                                                if peek_byte(slc, us2_i + 3) is 116
                                                    if peek_byte(slc, us2_i + 4) is 95
                                                        if peek_byte(slc, us2_i + 5) is 105
                                                            if peek_byte(slc, us2_i + 6) is 110
                                                                u2r: 1
                                                            u2b: 1
                                    if u2r is 1
                                        uraw: 1
                                    if u2b is 1
                                        ubare: 1
                                    us2_i: us2_i + 1
                            if uraw is 1
                                if smark is 1
                                    uraw: 0
                            if uraw is 1
                                sbad: sbad + 1
                                if ubare is 1
                                    u_bare_total: u_bare_total + 1
                                if u_listing is 1
                                    print "unsafe lint: unmarked raw memory/io line:"
                                    _sov_print(sl)
                smark: 0
        si: si + 1
        us_pos: us_e + 1
    return sbad
nhash s:
    h: 0
    i: 0
    go: 1
    as long as go is 1
        # Eight bytes per step while the qword holds no NUL.  The per-byte chain
        # (h*33 xor b, truncated to 56 bits) is applied in exactly the same
        # order, so the hash value is unchanged; the reads stay 8-aligned
        # because i only advances by 8 on this path.
        q: 0
        if band(s + i, 4095) < 4089
            q: peek_i64(s, i)
        z: band(band(q - 72340172838076673, bxor(q, 0 - 1)), -9187201950435737472)
        if z is 0
            h: band(bxor(h * 33, band(q, 255)), 72057594037927935)
            h: band(bxor(h * 33, band(bshr(q, 8), 255)), 72057594037927935)
            h: band(bxor(h * 33, band(bshr(q, 16), 255)), 72057594037927935)
            h: band(bxor(h * 33, band(bshr(q, 24), 255)), 72057594037927935)
            h: band(bxor(h * 33, band(bshr(q, 32), 255)), 72057594037927935)
            h: band(bxor(h * 33, band(bshr(q, 40), 255)), 72057594037927935)
            h: band(bxor(h * 33, band(bshr(q, 48), 255)), 72057594037927935)
            h: band(bxor(h * 33, band(bshr(q, 56), 255)), 72057594037927935)
            i: i + 8
        if not
            as long as go is 1
                b: peek_byte(s, i)
                if b is 0
                    go: 0
                if not
                    h: bxor(h * 33, b)
                    h: band(h, 72057594037927935)
                    i: i + 1
    # avalanche the low bits. plain djb2 leaves sequential names (fn0, fn1,
    # ...) with sequential hashes, which fill one linear-probe run until new
    # inserts drop off the 64-probe cap and the index silently loses them.
    # an odd multiply plus xor-shift pair scatters them across the table.
    h: band(h, 4294967295)
    h: h * 73244475
    h: bxor(h, bshr(h, 15))
    h: band(h, 4294967295)
    h: h * 73244475
    h: bxor(h, bshr(h, 15))
    return band(h, 72057594037927935)

list_find lst name:
    # plain linear scan over the live list. the first entry that is the same
    # pointer or string-equal wins. no table, no mark, no memo.
    if lst is 0
        return 0 - 1
    n: peek_i64(lst, 8)
    i: 0
    as long as i < n
        s: peek_i64(lst, 16 + i * 8)
        if s is name
            return i
        if _sov_str_eq(s, name) is 1
            return i
        i: i + 1
    return 0 - 1
bsearch_le lst x:
    # greatest i with lst[i] <= x in an ascending list, else -1.
    n: _sov_list_len(lst)
    lo: 0
    hi: n - 1
    best: 0 - 1
    as long as lo <= hi
        mid: (lo + hi) / 2
        mv: peek_i64(lst, 16 + mid * 8)
        if mv <= x
            best: mid
            lo: mid + 1
        if mv > x
            hi: mid - 1
    return best
wbuf: 0
wbuf_flush:
    if wbuf is 0
        return
    if _sov_list_len(wbuf) is 0
        return
    o: sg_text(wbuf)
    print cut(o, 0, length(o) - 1)
    wbuf: _sov_list_new()
list_reuse l:
    if l < 65536
        return _sov_list_new()
    poke_i64(l, 8, 0)
    return l

fn_ht: 0
fn_hti: 0
fn_htcap: 0
fn_hmk:
    if fn_htcap is 0
        fn_htcap: 4096
        fn_ht: _sov_heap_alloc(fn_htcap * 8)
        fn_hti: _sov_heap_alloc(fn_htcap * 8)
        dummy: _sov_bzero(fn_ht, fn_htcap * 8)
        fn_hti: _sov_heap_alloc(fn_htcap * 8)
        dummy: _sov_bzero(fn_hti, fn_htcap * 8)
    return 0
fn_lookup nm:
    # interned fn-name -> index (track 1.2/1.3).  fn_sync bulk-appends any new
    # fn_names tail before probing so every writer stays untouched.
    dummy: fn_sync()
    fh: band(nhash(nm), fn_htcap - 1)
    fgo: 1
    as long as fgo is 1
        fs: peek_i64(fn_ht, fh * 8)
        if fs is 0
            return 0 - 1
        if _sov_str_eq(fs, nm) is 1
            return peek_i64(fn_hti, fh * 8) - 1
        fh: band(fh + 1, fn_htcap - 1)
    return 0 - 1
fn_sync_hi: 0
fn_sync:
    # bulk-sync any names appended to fn_names since the last lookup into the
    # intern table.  writers stay untouched (they append directly); lookups
    # always see every name.  (track 1.2/1.3: name-set membership by integer
    # probe instead of string walks.)
    dummy: fn_hmk()
    fsn: _sov_list_len(fn_names)
    if fn_sync_hi >= fsn
        return 0
    # grow table when the load factor would pass 50%
    as long as fsn * 2 > fn_htcap
        # linear probing under 50% load, so plain rehash keeps order-independent
        # lookups; rebuild into a doubled pair of tables
        fn_nh: _sov_heap_alloc(fn_htcap * 16)
        fn_ni: _sov_heap_alloc(fn_htcap * 16)
        dummy: _sov_bzero(fn_nh, fn_htcap * 16)
        dummy: _sov_bzero(fn_ni, fn_htcap * 16)
        fn_j: 0
        as long as fn_j < fn_htcap
            fn_js: peek_i64(fn_ht, fn_j * 8)
            if fn_js is not 0
                fn_jh: band(nhash(fn_js), fn_htcap * 2 - 1)
                fn_jg: 1
                as long as fn_jg is 1
                    if peek_i64(fn_nh, fn_jh * 8) is 0
                        poke_i64(fn_nh, fn_jh * 8, fn_js)
                        poke_i64(fn_ni, fn_jh * 8, peek_i64(fn_hti, fn_j * 8))
                        fn_jg: 0
                    if fn_jg is 1
                        fn_jh: band(fn_jh + 1, fn_htcap * 2 - 1)
            fn_j: fn_j + 1
        fn_ht: fn_nh
        fn_hti: fn_ni
        fn_htcap: fn_htcap * 2
    fn_i: fn_sync_hi
    as long as fn_i < fsn
        fn_nm: peek_i64(fn_names, 16 + fn_i * 8)
        fn_h: band(nhash(fn_nm), fn_htcap - 1)
        fn_g: 1
        as long as fn_g is 1
            fs: peek_i64(fn_ht, fn_h * 8)
            if fs is 0
                poke_i64(fn_ht, fn_h * 8, fn_nm)
                poke_i64(fn_hti, fn_h * 8, fn_i + 1)
                fn_g: 0
            if fn_g is 1
                if _sov_str_eq(fs, fn_nm) is 1
                    fn_g: 0
                if fn_g is 1
                    fn_h: band(fn_h + 1, fn_htcap - 1)
        fn_i: fn_i + 1
    fn_sync_hi: fsn
    return 0

pd_mktab:
    pd_wt: _sov_heap_alloc(256)
    pd_ti: 0
    as long as pd_ti < 256
        poke_byte(pd_wt, pd_ti, 0)
        pd_ti: pd_ti + 1
    pd_ti: 48
    as long as pd_ti < 58
        poke_byte(pd_wt, pd_ti, 1)
        pd_ti: pd_ti + 1
    pd_ti: 65
    as long as pd_ti < 91
        poke_byte(pd_wt, pd_ti, 1)
        pd_ti: pd_ti + 1
    pd_ti: 97
    as long as pd_ti < 123
        poke_byte(pd_wt, pd_ti, 1)
        pd_ti: pd_ti + 1
    poke_byte(pd_wt, 95, 1)
    return 0
pd_hr pd_hp pd_ha pd_hb:
    pd_hv: 0
    pd_hi: pd_ha
    as long as pd_hi < pd_hb
        pd_hv: bxor(pd_hv * 33, peek_byte(pd_hp, pd_hi))
        pd_hv: band(pd_hv, 72057594037927935)
        pd_hi: pd_hi + 1
    pd_hv: band(pd_hv, 4294967295)
    pd_hv: pd_hv * 73244475
    pd_hv: bxor(pd_hv, bshr(pd_hv, 15))
    pd_hv: band(pd_hv, 4294967295)
    pd_hv: pd_hv * 73244475
    pd_hv: bxor(pd_hv, bshr(pd_hv, 15))
    return band(pd_hv, 72057594037927935)

pd_eqr pd_ep pd_ea pd_eb pd_eq:
    pd_qi: 0
    pd_pi: pd_ea
    as long as pd_pi < pd_eb
        if peek_byte(pd_eq, pd_qi) is 0
            return 0
        if peek_byte(pd_ep, pd_pi) is not peek_byte(pd_eq, pd_qi)
            return 0
        pd_pi: pd_pi + 1
        pd_qi: pd_qi + 1
    if peek_byte(pd_eq, pd_qi) is not 0
        return 0
    return 1

# Avalanche + probe from the pass-B rolling hash.  The per-byte chain and the
# avalanche are exactly pd_hr's, so the probe sees the same hash nhash-based
# puts indexed with; pd_eqr still byte-confirms, so a collision can never
# match.  Digit-leading words never reach here: pass A refuses definitions
# whose first byte is a digit, so such a word could only ever miss.
pd_probe pd_pp pd_pa pd_pb pd_ph:
    pd_ph: band(pd_ph, 4294967295)
    pd_ph: pd_ph * 73244475
    pd_ph: bxor(pd_ph, bshr(pd_ph, 15))
    pd_ph: band(pd_ph, 4294967295)
    pd_ph: pd_ph * 73244475
    pd_ph: bxor(pd_ph, bshr(pd_ph, 15))
    pd_ph: band(pd_ph, 72057594037927935)
    pd_gk: band(pd_ph, pd_cap - 1)
    pd_gg: 1
    as long as pd_gg is 1
        pd_gc: peek_i64(pd_key, pd_gk * 8)
        if pd_gc is 0
            pd_gg: 0
        if pd_gg is 1
            if pd_eqr(pd_pp, pd_pa, pd_pb, pd_gc) is 1
                pd_gg: 2
        if pd_gg is 1
            pd_gk: band(pd_gk + 1, pd_cap - 1)
    if pd_gg is 2
        return peek_i64(pd_val, pd_gk * 8)
    return 0 - 1

pd_get2 pd_bp pd_ba pd_bb:
    pd_gk: band(pd_hr(pd_bp, pd_ba, pd_bb), pd_cap - 1)
    pd_gg: 1
    as long as pd_gg is 1
        pd_gc: peek_i64(pd_key, pd_gk * 8)
        if pd_gc is 0
            pd_gg: 0
        if pd_gg is 1
            if pd_eqr(pd_bp, pd_ba, pd_bb, pd_gc) is 1
                pd_gg: 2
        if pd_gg is 1
            pd_gk: band(pd_gk + 1, pd_cap - 1)
    if pd_gg is 2
        return peek_i64(pd_val, pd_gk * 8)
    return 0 - 1

pd_get pd_gs:
    pd_gk: band(nhash(pd_gs), pd_cap - 1)
    pd_gg: 1
    as long as pd_gg is 1
        pd_gc: peek_i64(pd_key, pd_gk * 8)
        if pd_gc is 0
            pd_gg: 0
        if pd_gg is 1
            if _sov_str_eq(pd_gc, pd_gs) is 1
                pd_gg: 2
        if pd_gg is 1
            pd_gk: band(pd_gk + 1, pd_cap - 1)
    if pd_gg is 2
        return peek_i64(pd_val, pd_gk * 8)
    return 0 - 1

pd_put pd_ps pd_pv:
    pd_pk: band(nhash(pd_ps), pd_cap - 1)
    pd_pg: 1
    as long as pd_pg is 1
        pd_pc: peek_i64(pd_key, pd_pk * 8)
        if pd_pc is 0
            pd_pg: 2
        if pd_pg is 1
            if _sov_str_eq(pd_pc, pd_ps) is 1
                pd_pg: 2
        if pd_pg is 1
            pd_pk: band(pd_pk + 1, pd_cap - 1)
    poke_i64(pd_key, pd_pk * 8, pd_ps)
    poke_i64(pd_val, pd_pk * 8, pd_pv)
    return 0

pd_edge pd_ea pd_eb:
    pd_el: peek_i64(pd_adj, 16 + pd_ea * 8)
    pd_el: _sov_list_add(pd_el, pd_eb)
    # _sov_list_add reallocs past capacity and returns the new list, so the
    # pointer stored in pd_adj has to be written back or every later edge for
    # this node is appended to a list nothing can reach any more.
    poke_i64(pd_adj, 16 + pd_ea * 8, pd_el)
    return 0

# Names the compiled program needs that no source text ever mentions.  The
# backend emits direct calls to most of these by hardcoded literal - addp alone
# has four calln("_sov_list_add") sites - so each occurs exactly once in the
# spliced source, at its own definition, and looks dead.  rt_init is the sharpest
# case: it is the runtime initializer that sets g_argc and g_argv, it is named
# nowhere in the entire tree, and dropping it builds cleanly then segfaults.
pd_roots: "|_|"
pd_r1: "|_sov_thread_exit|_sov_sysnum|_sov_mem_copy|_sov_mem_set|rt_init|_sov_atoi|_sov_bzero|_sov_find_text|_sov_heap_alloc|_sov_list_add|_sov_list_new|_sov_print|_sov_print_int|_sov_str_eq|_sov_strcat|_sov_strlen|_sov_trim|_sov_txt_eq|cfind1|cut|emit|emit2|emit3|emit4|find_col_q|here|intern_ensure|intern_fast|"
pd_r3: "|forever|if|try|while|__pt_c|__pt_i|err_top|err_val|g_canary|heap_ptr|_sov_list_get|_sov_list_len|_sov_starts_with|add_rax_rcx|addp|cmp_rax_rcx|digitb|dir_of|emit8|emit_peek_rax|find_col|find_sep_do|imul_rax_rcx|intern|jae|jb|jg|jge|jl|"
pd_r4: "|jle|jmp|jne|jnz|jz|leave|length|lines_of_fast|list_reuse|look|mov_rax_rcx|mov_rax_rdi|mov_rax_rsi|mov_rcx_rax|mov_rcx_rdx|mov_rcx_rsi|mov_rdi_rax|mov_rsi_rax|name_ok|num_of|oc_here|ocget|ocput|ocset|patch|poke4|poke8|pop_rax|pop_rcx|push_rax|"
pd_r5: "|ret|rexx|same|sg_bare|sg_cat2|sg_cat3|sg_cat4|sg_cat5|sg_cat6|sg_ind|sg_match|sg_sqok|sg_thresh|sg_word|sibx|spawn_emit|starts|sub_rax_rcx|sysc_raw|test_rax|unquote|word_id|wordchar|xor_rax|"

# Diagnostic: extra roots from a file, so the culprit can be bisected without
# rebuilding the compiler for each candidate set.
pd_xtra: 0
# expansion-forced roots, rebuilt per compile from the user's own text: the spawn
# and join expansion produces _sov_thread_* calls that appear nowhere in source,
# so the mention-scan can never keep them on its own.
pd_force: blank
pd_load_xtra:
    if file_exists("/tmp/pdx.txt") is 0
        return 0
    pd_xtra: load_file("/tmp/pdx.txt")
    return 0

pd_rkey: 0
pd_rcap: 0
pd_radd bl:
    # split one '|name|name|...' root blob into the probe table; the names
    # are static, so the table is built once per process, not once per def.
    n: length(bl)
    k: 0
    as long as k < n
        if peek_byte(bl, k) is 124
            j: k + 1
            e: j
            g9: 1
            as long as g9 is 1
                if e < n
                    if peek_byte(bl, e) is not 124
                        e: e + 1
                    if not
                        g9: 0
                if not
                    g9: 0
            if e > j
                nm: cut(bl, j, e)
                hv: band(nhash(nm), pd_rcap - 1)
                g8: 1
                as long as g8 is 1
                    if peek_i64(pd_rkey, hv * 8) is 0
                        g8: 0
                    if not
                        hv: band(hv + 1, pd_rcap - 1)
                poke_i64(pd_rkey, hv * 8, nm)
                k: e
            if not
                k: k + 1
        if not
            k: k + 1
    return 0
pd_mkrtab:
    pd_rcap: 1024
    pd_rkey: _sov_heap_alloc(pd_rcap * 8)
    dummy8: _sov_bzero(pd_rkey, pd_rcap * 8)
    dummy8: pd_radd(pd_r1)
    dummy8: pd_radd(pd_r3)
    dummy8: pd_radd(pd_r4)
    dummy8: pd_radd(pd_r5)
    return 0
pd_isroot pd_rn:
    if pd_force > 0
        if _sov_find_text(pd_force, sg_cat3("|", pd_rn, "|")) > 0 - 1
            return 1
    if pd_rkey is 0
        pd_mkrtab()
    hv: band(nhash(pd_rn), pd_rcap - 1)
    g8: 1
    as long as g8 is 1
        gc8: peek_i64(pd_rkey, hv * 8)
        if gc8 is 0
            return 0
        if _sov_str_eq(gc8, pd_rn) is 1
            return 1
        hv: band(hv + 1, pd_rcap - 1)
    if pd_xtra > 0
        if _sov_find_text(pd_xtra, sg_cat3("|", pd_rn, "|")) > 0 - 1
            return 1
    if pd_force > 0
        if _sov_find_text(pd_force, sg_cat3("|", pd_rn, "|")) > 0 - 1
            return 1
    return 0

pd_uk: 0
pd_umsk: 65535
pd_rt: 0
pd_scan_line pd_sl pd_sc:
    # one line's token walk for the prune: separators skipped, words hashed
    # and probed only when they do not start with a digit.  pd_sc < 0 means
    # top level (mentions root definitions); pd_sc >= 0 means the body of
    # definition pd_sc (mentions record edges and mark the target at once,
    # which is safe because a body is only ever walked after its definition
    # was reached, so the old sweep would have marked the target anyway).
    pd_m: length(pd_sl)
    pd_j: 0
    as long as pd_j < pd_m
        if peek_byte(pd_wt, peek_byte(pd_sl, pd_j)) is 0
            pd_j: pd_j + 1
        if not
            pd_j0: pd_j
            pd_db: peek_byte(pd_sl, pd_j0)
            pd_ez: 0
            if pd_db < 48
                pd_ez: 1
            if pd_db > 57
                pd_ez: 1
            pd_hv2: 0
            pd_w: 1
            # no bounds test inside: every line is NUL-terminated by lines_of
            # and wt[0] is 0, so the word loop stops at the terminator itself.
            as long as pd_w is 1
                if peek_byte(pd_wt, peek_byte(pd_sl, pd_j)) is 0
                    pd_w: 0
                if pd_w is 1
                    if pd_ez is 1
                        pd_hv2: band(bxor(pd_hv2 * 33, peek_byte(pd_sl, pd_j)), 72057594037927935)
                if pd_w is 1
                    pd_j: pd_j + 1
            pd_t: 0 - 1
            if pd_ez is 1
                pd_t: pd_probe(pd_sl, pd_j0, pd_j, pd_hv2)
            if pd_t > 0 - 1
                if pd_sc < 0
                    if peek_byte(pd_mark, pd_t) is 0
                        poke_byte(pd_mark, pd_t, 1)
                    pd_rt: _sov_list_add(pd_rt, pd_t)
                if pd_sc > 0 - 1
                    if peek_byte(pd_mark, pd_t) is 0
                        poke_byte(pd_mark, pd_t, 1)
                        pd_rt: _sov_list_add(pd_rt, pd_t)
    return 0

pd_lines_result text ls:
    # Only publish after the round-trip guard: the parser must see exactly
    # lines_of(text), including empty lines and the trailing-newline rule.
    sg_pu_txt: text
    sg_pu_ls: ls
    return text

prune_dead pd_src pd_lim pd_inf:
    sg_pu_txt: 0
    sg_pu_ls: 0
    # This walk reads source text as task headers plus indented extents.  A
    # source that uses a compact form does not have that shape until the line
    # reader has expanded it, and expanding it here would break the round-trip
    # guard below, so such a source is handed back untouched: the parser reads
    # it through cx_read instead.  Plain sources prune exactly as before.
    if sg_plain(pd_src) is 0
        return pd_src
    # Text of the user's own file, used to decide which definitions belong to
    # the user rather than to the spliced library.  Reading it again is cheap
    # and exact; offset arithmetic is not, because `use` chunks are spliced
    # into src before it is appended to all.
    pd_ut: load_file(pd_inf)
    if pd_ut is 0
        pd_ut: pd_src
    pd_force: blank
    if look(pd_ut, "spawn") > 0 - 1
        pd_force: "|_sov_thread_spawn|_sov_thread_exit|_sov_thread_entry_param|"
    if look(pd_ut, "join") > 0 - 1
        pd_force: join(pd_force, "|_sov_thread_join|")
    if look(pd_src, "_sov_heap_alloc") > 0 - 1
        pd_force: join(pd_force, "|_sov_heap_wipe|")
    # Names the user's own file defines, as one delimited blob.  Testing each
    # candidate against the file text directly costs O(defs x user bytes), which
    # on a 147 KB program is over 100 MB of scanning and swamps the saving.
    # table sized to the user's own def count (4x load headroom, pow2,
    # capped at the original 65536): a 512KB zeroing per compile cost
    # ~0.29 ms on small sources where a 1024-slot table does the same job.
    pd_ul: lines_of(pd_ut)
    pd_uc: 0
    pd_qi: 0
    pd_qln: _sov_list_len(pd_ul)
    as long as pd_qi < pd_qln
        pd_ql: peek_i64(pd_ul, 16 + pd_qi * 8)
        if length(pd_ql) > 1
            if peek_byte(pd_ql, 0) > 32
                if peek_byte(pd_ql, length(pd_ql) - 1) is 58
                    pd_uc: pd_uc + 1
        pd_qi: pd_qi + 1
    pd_ucap: 1024
    as long as pd_ucap < pd_uc * 4
        if pd_ucap >= 65536
            leave
        pd_ucap: pd_ucap * 2
    if pd_ucap > 65536
        pd_ucap: 65536
    pd_umsk: pd_ucap - 1
    pd_uk: _sov_heap_alloc(pd_ucap * 8)
    dummy: _sov_bzero(pd_uk, pd_ucap * 8)
    pd_ui: 0
    as long as pd_ui < _sov_list_len(pd_ul)
        pd_ull: peek_i64(pd_ul, 16 + pd_ui * 8)
        if length(pd_ull) > 1
            if peek_byte(pd_ull, 0) > 32
                if peek_byte(pd_ull, length(pd_ull) - 1) is 58
                pd_usp: look(pd_ull, " ")
                if pd_usp < 0
                    pd_usp: length(pd_ull) - 1
                if pd_usp > 0
                    pd_u_put(cut(pd_ull, 0, pd_usp))
        pd_ui: pd_ui + 1
    if pd_wt is 0
        pd_mktab()
    pd_load_xtra()
    pd_ls: lines_of(pd_src)
    pd_n: _sov_list_len(pd_ls)
    # Round-trip guard: sg_text must reproduce the source byte for byte before
    # it is trusted to reproduce a blanked one.  If the line splitter and the
    # joiner disagree about the trailing newline, pruning is skipped entirely
    # rather than perturbing every build by one byte.
    # sg_text appends one newline per line, so it round-trips only when the
    # summed line lengths plus one byte per line equals the source length.
    # The extent walk below already adds pd_ll + 1 per line into pd_off, so
    # the guard compares that sum after the walk instead of paying a second
    # full pass over the lines just for the check.
    pd_dn: _sov_list_new()
    pd_ds: _sov_list_new()
    pd_de: _sov_list_new()
    pd_rt: _sov_list_new()
    pd_pu: _sov_list_new()
    # PS9 rejection rows: the sweep must REJECT (not silently blank) duplicate
    # task names and >7-parameter headers. This walk is the only stage that
    # still sees every definition twin side by side: the parser downstream
    # only ever sees the pruned text, so any later check is too late.
    # the dup/arity rejections only apply to FLAT sources (no includes):
    # spliced driver trees legitimately shadow same-name tasks across
    # windows, and must keep the absorb behavior. the hash set exists only
    # on this path: a 256KB alloc + 16K-slot zero loop costs ~0.15 ms of
    # page faults on every compile otherwise, eating the int-dispatch win.
    pd_flat: 0
    if look(pd_src + snap_m, "include ") < 0
        pd_flat: 1

    # Definitions and their extents come out of one walk.  A definition's extent
    # is its own line plus the indented or blank lines that follow, ending at the
    # first non-blank column-0 line - which is also the line that opens whatever
    # comes next, so a single forward pass closes one body and opens the next.
    # Scanning each body separately walked the whole source a second time.
    mark("i-pa0")
    mark("PA")
    pd_i: 0
    pd_off: 0
    pd_open: 0
    as long as pd_i < pd_n
        pd_l: peek_i64(pd_ls, 16 + pd_i * 8)
        pd_ll: length(pd_l)
        pd_ib: 0
        if pd_ll is 0
            pd_ib: 1
        if pd_ll > 0
            if peek_byte(pd_l, 0) < 33
                pd_ib: 1
        if pd_open is 1
            if pd_ib is 0
                pd_de: _sov_list_add(pd_de, pd_i)
                pd_open: 0
        pd_d: 0
        if pd_ll > 1
            if peek_byte(pd_l, 0) > 32
            if peek_byte(pd_l, pd_ll - 1) is 58
                pd_d: 1
        if pd_d is 1
            pd_b0: peek_byte(pd_l, 0)
            if pd_b0 > 47
                if pd_b0 < 58
                    pd_d: 0
        if pd_d is 1
            pd_sp: look(pd_l, " ")
            if pd_sp < 0
                pd_sp: pd_ll - 1
            pd_hb: peek_byte(pd_l, 0)
            pd_hk: 0
            if pd_hb > 64
                if pd_hb < 91
                    pd_hk: 1
            if pd_hb > 96
                if pd_hb < 123
                    pd_hk: 1
            if pd_hb is 95
                pd_hk: 1
            if pd_hk is 1
                if pd_flat is 1
                    pd_nc: 0
                    pd_wc: 0
                    as long as pd_wc < pd_ll
                        if peek_byte(pd_l, pd_wc) is 32
                            pd_nc: pd_nc + 1
                        pd_wc: pd_wc + 1
                    if pd_nc > 7
                        print "Error: too many parameters (7 max)"
                        _sov_print(cut(pd_l, 0, pd_ll - 1))
                        had_err: 1
            if pd_sp > 0
                pd_nm: cut(pd_l, 0, pd_sp)
                pd_dn: _sov_list_add(pd_dn, pd_nm)
                pd_ds: _sov_list_add(pd_ds, pd_i)
                pd_lib: 1
                if pd_u_has(pd_nm) is 1
                    pd_lib: 0
                pd_pu: _sov_list_add(pd_pu, pd_lib)
                pd_open: 1
        pd_off: pd_off + pd_ll + 1
        pd_i: pd_i + 1
    if pd_open is 1
        pd_de: _sov_list_add(pd_de, pd_n)
    if pd_off is not length(pd_src)
        if pd_report is 1
            print "BAIL1 roundtrip"
        _sov_print(i2s(pd_off))
        _sov_print(i2s(length(pd_src)))
        return pd_src
    mark("i-pa1")
    pd_nd: _sov_list_len(pd_dn)
    if pd_nd < 2
        if pd_report is 1
            print "BAIL2 nd<2"
        return pd_lines_result(pd_src, pd_ls)
    if _sov_list_len(pd_de) is not pd_nd
        if pd_report is 1
            print "BAIL3 de!=nd"
        _sov_print(i2s(_sov_list_len(pd_de)))
        _sov_print(i2s(pd_nd))
        return pd_lines_result(pd_src, pd_ls)
    # PS9: flat-source duplicate-name rejection. Runs after the walk so the
    # hash table can be sized to the real def count (a fixed 16K-slot table
    # costs ~0.3 ms of page faults on tiny flat compiles). Spliced trees keep
    # the absorb behavior (pd_flat = 0 skips the whole pass).
    if pd_flat is 1
        pd_cap2: 64
        as long as pd_cap2 < pd_nd * 2 + 16
            pd_cap2: pd_cap2 * 2
        pd_sh: _sov_heap_alloc(pd_cap2 * 16)
        pd_zi: 0
        as long as pd_zi < pd_cap2
            poke_i64(pd_sh, pd_zi * 16, 0)
            pd_zi: pd_zi + 1
        pd_zj: 0
        as long as pd_zj < pd_nd
            pd_nm2: peek_i64(pd_dn, 16 + pd_zj * 8)
            pd_hb2: peek_byte(pd_nm2, 0)
            pd_hk2: 0
            if pd_hb2 > 64
                if pd_hb2 < 91
                    pd_hk2: 1
            if pd_hb2 > 96
                if pd_hb2 < 123
                    pd_hk2: 1
            if pd_hb2 is 95
                pd_hk2: 1
            if pd_hk2 is 1
                pd_sl2: band(nhash(pd_nm2), pd_cap2 - 1)
                pd_sg2: 0
                as long as pd_sg2 < pd_cap2
                    pd_sv2: peek_i64(pd_sh, pd_sl2 * 16)
                    if pd_sv2 is 0
                        pd_sg2: pd_cap2
                    if pd_sv2 is not 0
                        if _sov_str_eq(pd_sv2, pd_nm2) is 1
                            print "Error: two with the same name"
                            _sov_print(pd_nm2)
                            had_err: 1
                            pd_sg2: pd_cap2
                        if pd_sg2 is not pd_cap2
                            pd_sl2: pd_sl2 + 1
                        if pd_sl2 is pd_cap2
                            pd_sl2: 0
                        if pd_sg2 is not pd_cap2
                            pd_sg2: pd_sg2 + 1
                if peek_i64(pd_sh, pd_sl2 * 16) is 0
                    poke_i64(pd_sh, pd_sl2 * 16, pd_nm2)
            pd_zj: pd_zj + 1
    # no-op gate: only library defs are ever blanked (user defs are rooted
    # unconditionally).  a source with zero library defs therefore always
    # ends this pass with pd_gone = 0 and returns its input unchanged, so
    # the token walk, the sweep and the table builds can be skipped whole.
    pd_pg: 0
    pd_pz2: 0
    as long as pd_pz2 < pd_nd
        if _sov_list_get(pd_pu, pd_pz2) is 1
            pd_pg: 1
        pd_pz2: pd_pz2 + 1
    if pd_pg is 0
        return pd_lines_result(pd_src, pd_ls)
    pd_cap: 16384
    as long as pd_cap < pd_nd * 2 + 16
        pd_cap: pd_cap * 2
    pd_key: _sov_heap_alloc(pd_cap * 8)
    pd_val: _sov_heap_alloc(pd_cap * 8)
    dummy: _sov_bzero(pd_key, pd_cap * 8)
    pd_j: 0
    as long as pd_j < pd_nd
        pd_put(peek_i64(pd_dn, 16 + pd_j * 8), pd_j)
        pd_j: pd_j + 1
    # pd_adj is gone: with the closure now marked inline by pd_scan_line, the
    # adjacency lists had no reader left; building 2500 of them per compile
    # was pure allocation+append work.
    pd_mark: _sov_heap_alloc(pd_nd + 8)
    dummy: _sov_bzero(pd_mark, pd_nd + 8)
    # The entry task is never mentioned by name either, so it is rooted
    # explicitly; without it the sweep would drop the whole program.
    pd_j: 0
    as long as pd_j < pd_nd
        if pd_isroot(peek_i64(pd_dn, 16 + pd_j * 8)) is 1
            poke_byte(pd_mark, pd_j, 1)
            pd_rt: _sov_list_add(pd_rt, pd_j)
        pd_j: pd_j + 1
    # Definitions from the user's own source are never blanked, and are rooted so
    # that everything they mention survives too.  Pruning them would silently
    # delete diagnostics: an unreachable user function calling an unknown name
    # used to fail the build with "no such task", and blanking its body first
    # makes that error disappear.  The dead code this pass exists to remove is
    # library and runtime code, which is where the win is anyway.
    pd_pz: 0
    as long as pd_pz < pd_nd
        if _sov_list_get(pd_pu, pd_pz) is 0
            poke_byte(pd_mark, pd_pz, 1)
            pd_rt: _sov_list_add(pd_rt, pd_pz)
        pd_pz: pd_pz + 1
    # No roots means this is not a program the sweep understands; leave it alone.
    if _sov_list_len(pd_rt) < 1
        if pd_report is 1
            print "BAIL4 no roots"
        return pd_lines_result(pd_src, pd_ls)
    # ---- pass B: one token walk, collecting roots and edges ---------------
    # A mention is a root when it sits outside every definition body, and an
    # edge from the enclosing definition otherwise.  Attributing a top-level
    # mention to the preceding definition would be unsafe: if that definition
    # is unreachable the mention would never be followed.
    mark("PB")
    # top-level lines only: roots are fully known before the walk (builtin
    # names + the entry + every user definition + top-level mentions), and a body
    # mention can only ever matter when its enclosing definition is itself
    # reached, so dead bodies are skipped whole instead of token-walked.
    pd_cur: 0 - 1
    pd_nxt: 0
    pd_i: 0
    as long as pd_i < pd_n
        pd_l: peek_i64(pd_ls, 16 + pd_i * 8)
        if pd_nxt < pd_nd
            if pd_i is _sov_list_get(pd_ds, pd_nxt)
                pd_cur: pd_nxt
                pd_nxt: pd_nxt + 1
        if pd_cur > 0 - 1
            if pd_i >= _sov_list_get(pd_de, pd_cur)
                pd_cur: 0 - 1
        if pd_cur < 0
            dummy9: pd_scan_line(pd_l, 0 - 1)
        pd_i: pd_i + 1
    # ---- worklist: walk reached bodies breadth-first ----------------------
    pd_qi: 0
    as long as pd_qi < _sov_list_len(pd_rt)
        pd_a: _sov_list_get(pd_rt, pd_qi)
        pd_i2: _sov_list_get(pd_ds, pd_a)
        pd_e2: _sov_list_get(pd_de, pd_a)
        as long as pd_i2 < pd_e2
            pd_l2: peek_i64(pd_ls, 16 + pd_i2 * 8)
            dummy9: pd_scan_line(pd_l2, pd_a)
            pd_i2: pd_i2 + 1
        pd_qi: pd_qi + 1
    # ---- sweep ------------------------------------------------------------
    mark("PS")
    # the sweep is gone: pd_scan_line already marks every target the moment
    # the edge is seen (a body is only walked after its definition was
    # reached, so immediate marking IS the closure), and the worklist in PB
    # walks exactly that closure.  re-sweeping pd_rt x adjacents re-validated
    # ~200k edges against mark bytes that were already 1 — ~10 ms of pure
    # no-op per build.  pd_rt is not read after PE.
    # ---- blank the unreachable bodies -------------------------------------
    if pd_report is 1
        pd_vv: 0
        as long as pd_vv < pd_nd
            _sov_print(join("M|", join(peek_i64(pd_dn, 16 + pd_vv * 8), join(":", i2s(peek_byte(pd_mark, pd_vv))))))
            pd_vv: pd_vv + 1
    pd_bl: _sov_heap_alloc(2)
    poke_byte(pd_bl, 0, 0)
    # dead bodies blank in 512-slot blit chunks: one interpreted call per
    # chunk instead of one list_set per dead line (~15k calls per build).
    pd_src: _sov_heap_alloc(4096)
    pd_f: 0
    as long as pd_f < 512
        dummy9: poke_i64(pd_src, pd_f * 8, pd_bl)
        pd_f: pd_f + 1
    pd_kept: 0
    pd_gone: 0
    pd_zb: 0
    as long as pd_zb < pd_nd
        if peek_byte(pd_mark, pd_zb) is 0
            pd_e: peek_i64(pd_de, 16 + pd_zb * 8)
            pd_k: peek_i64(pd_ds, 16 + pd_zb * 8)
            as long as pd_k < pd_e
                pd_c2: pd_e - pd_k
                if pd_c2 > 512
                    pd_c2: 512
                dummy9: _sov_blit(pd_ls + 16 + pd_k * 8, pd_src, pd_c2 * 8)
                pd_k: pd_k + pd_c2
            pd_gone: pd_gone + 1
        if not
            pd_kept: pd_kept + 1
        pd_zb: pd_zb + 1
    mark("PE")
    if pd_gone is 0
        if pd_report is 1
            print "BAIL5 gone0"
        return pd_lines_result(pd_src, pd_ls)
    if pd_report is 1
        print "prune: kept"
        _sov_print(i2s(pd_kept))
        print "prune: dropped"
        _sov_print(i2s(pd_gone))
    mark("PEx1")
    pd_o: sg_text(pd_ls)
    mark("PEx2")
    if pd_report is 1
        pd_kk: 0
        as long as pd_kk < pd_nd
            if peek_byte(pd_mark, pd_kk) is 0
                _sov_print(peek_i64(pd_dn, 16 + pd_kk * 8))
            pd_kk: pd_kk + 1
    return pd_lines_result(pd_o, pd_ls)
pd_u_put nm:
    h: band(nhash(nm), pd_umsk)
    as long as peek_i64(pd_uk, h * 8) is not 0
        if peek_i64(pd_uk, h * 8) is nm
            return 0
        h: band(h + 1, 65535)
    poke_i64(pd_uk, h * 8, nm)
    return 0
pd_u_has nm:
    h: band(nhash(nm), pd_umsk)
    as long as peek_i64(pd_uk, h * 8) is not 0
        if peek_i64(pd_uk, h * 8) is nm
            return 1
        h: band(h + 1, 65535)
    return 0
delegate_core nm ps bl:
    # 1 when this body is exactly `return T(p1, p2, ...)` forwarding its
    # own params in order to a known same-arity task T -- a pure delegate
    # whose body can be a bare jmp after restoring the saved registers.
    del_target: blank
    if bw_empty is 0
        bw_empty: _sov_list_new()
    bn: _sov_list_len(bl)
    if bn > 3
        return 0
    cnt: 0
    ln: blank
    i9: 0
    as long as i9 < bn
        s9: strip(peek_i64(bl, 16 + i9 * 8))
        if length(s9) > 0
            if peek_byte(s9, 0) is not 35
                cnt: cnt + 1
                ln: s9
        i9: i9 + 1
    if cnt is not 1
        return 0
    if _sov_starts_with(ln, "return ") is 0
        return 0
    e9: strip(cut(ln, 7, length(ln)))
    po: cfind1(e9, 40)
    if po < 1
        return 0
    if peek_byte(e9, length(e9) - 1) is not 41
        return 0
    tn: strip(cut(e9, 0, po))
    if plain_name(tn) is 0
        return 0
    if _sov_str_eq(tn, nm) is 1
        return 0
    ti: nm_lookup(tn)
    if ti < 0
        return 0
    na: _sov_list_len(ps)
    if _sov_list_len(peek_i64(params, 16 + ti * 8)) is not na
        return 0
    ia: cut(e9, po + 1, length(e9) - 1)
    if na is 0
        if length(strip(ia)) is 0
            del_target: tn
            return 1
        return 0
    argl: split_args(ia, _sov_list_new())
    if _sov_list_len(argl) is not na
        return 0
    dg: 1
    k9: 0
    as long as k9 < na
        if _sov_str_eq(strip(peek_i64(argl, 16 + k9 * 8)), peek_i64(ps, 16 + k9 * 8)) is 0
            dg: 0
        k9: k9 + 1
    if dg is 0
        return 0
    del_target: tn
    return 1

delegate_name nm ps bl:
    # walk-level: body can become a bare jmp only when the target has
    # no faster call-site inline (call_args keeps those in the wrapper).
    if delegate_core(nm, ps, bl) is 0
        return 0
    ch: 0
    ci: 0
    as long as peek_byte(del_target, ci) > 0
        ch: ch * 33 + peek_byte(del_target, ci)
        ci: ci + 1
    if ca_maybe(ch, del_target) is 1
        return 0
    return 1

delegate_resolve nm:
    # chase pure-delegate wrappers to their ultimate target (cap 8 hops).
    if del_names is 0
        return nm
    hops: 0
    as long as hops < 8
        di: list_find(del_names, nm)
        if di < 0
            return nm
        nm: peek_i64(del_targets, 16 + di * 8)
        hops: hops + 1
    return nm

build_del_map:
    # precompute (wrapper -> target) pairs from parsed bodies so call
    # sites can emit the target's inline/call directly.
    del_names: _sov_list_new()
    del_targets: _sov_list_new()
    di: 0
    as long as di < _sov_list_len(names)
        dnm: peek_i64(names, 16 + di * 8)
        if delegate_core(dnm, peek_i64(params, 16 + di * 8), peek_i64(bodies, 16 + di * 8)) is 1
            del_names: _sov_list_add(del_names, dnm)
            del_targets: _sov_list_add(del_targets, del_target)
        di: di + 1

fsem_build:
    # Per-compilation name->facts map. One open-addressed table keyed by the
    # canonical interned kid replaces three per-call scans (the symbol
    # table lookup, the delegate-map chase and the C-builtin probe).
    #
    # value layout (64 bits):
    #   bit 0        string function
    #   bits 1..8    ret_par + 1   (0 = no identity return)
    #   bits 9..16   arity + 1     (0 = not a user task)
    #   bits 17..32  inl_set index + 1
    #   bits 33..48  names index + 1
    #   bit 49       known C builtin
    # tgt: interned kid of the delegate target (0 = none)
    # cah: djb2 hash of the resolved target name
    if fsem_key is not 0
        fsem_key: 0
        fsem_val: 0
        fsem_tgt: 0
        fsem_cah: 0
        fsem_cap: 0
    fsem_n: _sov_list_len(names) + _sov_list_len(str_fns) + _sov_list_len(inl_set) + 512
    fsem_cap: 16
    as long as fsem_cap < fsem_n * 2 + 2
        fsem_cap: fsem_cap + fsem_cap
    fsem_key: _sov_heap_alloc(fsem_cap * 8)
    fsem_val: _sov_heap_alloc(fsem_cap * 8)
    fsem_tgt: _sov_heap_alloc(fsem_cap * 8)
    fsem_cah: _sov_heap_alloc(fsem_cap * 8)
    dummy: _sov_bzero(fsem_key, fsem_cap * 8)
    dummy: _sov_bzero(fsem_val, fsem_cap * 8)
    dummy: _sov_bzero(fsem_tgt, fsem_cap * 8)
    dummy: _sov_bzero(fsem_cah, fsem_cap * 8)
    if ca_tab is 0
        ca_seed()
    # C builtins: the hash table already holds every builtin and its hash.
    cbx: 0
    as long as cbx < 512
        cbh: peek_i64(ca_tab, cbx * 8)
        if cbh is not 0
            cbn: peek_i64(ca_ntab, cbx * 8)
            if cbn is not 0
                cbid: intern_kid(cbn)
                dummy: fsem_put(cbid, 562949953421312, 0, cbh)
        cbx: cbx + 1
    # user tasks: arity, identity return, delegate target, inl eligibility.
    fni: 0
    as long as fni < _sov_list_len(names)
        fnnm: peek_i64(names, 16 + fni * 8)
        fnid: intern_kid(fnnm)
        fnv: 0
        fnar: _sov_list_len(peek_i64(params, 16 + fni * 8))
        if fnar > 0
            if fnar < 256
                fnv: bor(fnv, (fnar + 1) * 512)
        fnrp: 0 - 1
        if ret_par is not 0
            if fni < _sov_list_len(ret_par)
                fnrp: peek_i64(ret_par, 16 + fni * 8)
        if fnrp >= 0
            if fnrp < 255
                fnv: bor(fnv, (fnrp + 1) * 2)
        if fni < 65535
            fnv: bor(fnv, (fni + 1) * 8589934592)
        fntgt: 0
        fncah: 0
        fndi: list_find(del_names, fnnm)
        if fndi >= 0
            fntnm: peek_i64(del_targets, 16 + fndi * 8)
            fntgt: intern_kid(fntnm)
            # a delegate target that is itself a C builtin keeps that
            # builtin's hash so the call site skips the probe
            fncah: ca_hash_of(fntnm)
        dummy: fsem_put(fnid, fnv, fntgt, fncah)
        fni: fni + 1
    # string functions: the seed list holds plain literals, later additions
    # hold interned kids; interning both lands them on the same key.
    fsi: 0
    as long as fsi < _sov_list_len(str_fns)
        fsn: peek_i64(str_fns, 16 + fsi * 8)
        if fsn is not 0
            dummy: fsem_put(intern_kid(fsn), 1, 0, 0)
        fsi: fsi + 1
    # inlinable tasks: the set index and the symbol table index.
    fii: 0
    as long as fii < _sov_list_len(inl_set)
        finm: peek_i64(inl_set, 16 + fii * 8)
        if finm is not 0
            fiid: intern_kid(finm)
            fiv: 0
            fifi: nm_lookup(finm)
            if fifi >= 0
                if fifi < 65535
                    fiv: bor(fiv, (fifi + 1) * 8589934592)
            if fii < 65535
                fiv: bor(fiv, (fii + 1) * 131072)
            dummy: fsem_put(fiid, fiv, 0, 0)
        fii: fii + 1
    return 0

ca_hash_of nm:
    # the djb2 hash the C-builtin probe uses, or 0 when nm is not a builtin
    if ca_tab is 0
        ca_seed()
    cah: 0
    cci: 0
    ccg: 1
    as long as ccg is 1
        ccb: peek_byte(nm, cci)
        if ccb is 0
            ccg: 0
        if not
            cah: cah * 33 + ccb
            cci: cci + 1
    cix: band(cah, 511)
    as long as peek_i64(ca_tab, cix * 8) is not 0
        if peek_i64(ca_tab, cix * 8) is cah
            if _sov_str_eq(peek_i64(ca_ntab, cix * 8), nm) is 1
                return cah
        cix: band(cix + 1, 511)
    return 0

tco_allowed tc_lines tc_nm:
    # TCO only for pure tail recursion (used as iteration).  If the body
    # makes any non-tail self-call it is genuine branching recursion: the
    # plain call form runs faster on current hardware (predictor behaves
    # better) and depth is data-bounded, so leave it alone.
    tc_nd: str_cat(tc_nm, "(")
    tc_nn: _sov_list_len(tc_lines)
    tc_i: 0
    tc_tot: 0
    tc_tal: 0
    as long as tc_i < tc_nn
        tc_s: peek_i64(tc_lines, 16 + tc_i * 8)
        tc_i: tc_i + 1
        if tc_s is not 0
            if look(tc_s, tc_nd) > 0 - 1
                tc_tot: tc_tot + 1
                tc_k: 0
                as long as peek_byte(tc_s, tc_k) is 32
                    tc_k: tc_k + 1
                if peek_byte(tc_s, tc_k) is 114
                    if peek_byte(tc_s, tc_k + 1) is 101
                        if peek_byte(tc_s, tc_k + 2) is 116
                            if peek_byte(tc_s, tc_k + 3) is 117
                                if peek_byte(tc_s, tc_k + 4) is 114
                                    if peek_byte(tc_s, tc_k + 5) is 110
                                        if peek_byte(tc_s, tc_k + 6) is 32
                                            if peek_byte(tc_s, length(tc_s) - 1) is 41
                                                tc_tal: tc_tal + 1
    if tc_tal is 0
        return 0
    if tc_tot > tc_tal
        return 0
    return 1
walk_range wa wb:
    fi: wa
    as long as fi < wb
        if prof_mode is 1
            prof_functions: prof_functions + 1
        dbg_active: peek_i64(task_user, 16 + fi * 8)
        walk_nm: peek_i64(names, 16 + fi * 8)
        if fn_lookup(walk_nm) < 0
                fn_names: _sov_list_add(fn_names, walk_nm)
                fn_offs: _sov_list_add(fn_offs, here())
                if dbg_collect is 1
                    if dbg_active is 1
                        addp(here(), "debug", peek_i64(task_lns, 16 + fi * 8))
                par_cfn: fi
                if par_do is 1
                    pe0(50, fi, here(), _sov_list_len(patch_at))
                    pe0(10, fi, 0, 0)
                    pe0(11, fi, 0, 0)
                    dummy: par_sentry()
                locals: _sov_list_new()
                d7: lsh_reset()
                str_vars: _sov_list_new()
                saw_str: 0
                br_depth: 0
                stmt_lns: peek_i64(body_lns, 16 + fi * 8)
                if _sov_list_len(peek_i64(bodies, 16 + fi * 8)) is 0
                    if peek_i64(task_user, 16 + fi * 8) is 1
                        print "Warning: empty"
                        _sov_print(walk_nm)
                        print peek_i64(task_lns, 16 + fi * 8)
                ps: peek_i64(params, 16 + fi * 8)
                pi: 0
                as long as pi < _sov_list_len(ps)
                    d8: lsh_add(peek_i64(ps, 16 + pi * 8))
                    pi: pi + 1
                if fi < _sov_list_len(fn_lord)
                    wl_ord: peek_i64(fn_lord, 16 + fi * 8)
                    if wl_ord is not 0
                        wl_i: 0
                        as long as wl_i < _sov_list_len(wl_ord)
                            d9: slot(peek_i64(wl_ord, 16 + wl_i * 8))
                            wl_i: wl_i + 1
                thin: 0
                if fi is entry_idx
                    if _sov_list_len(ps) is 0
                        thin: 0
                if thin is 1
                    skip_al: dead_iota(peek_i64(bodies, 16 + fi * 8))
                    leaf8: leaf8_scan(tops)
                    stmt_lns: tops_lns
                    body(tops)
                    stmt_lns: _sov_list_get(body_lns, fi)
                    cflush_all()
                    leaf8: 0
                    if _sov_list_len(ps) is 0
                        leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                    body(_sov_list_get(bodies, fi))
                    if saw_str is 1
                        mark_fn_str(walk_nm)
                    emit(49)
                    emit(255)
                    emit(106)
                    emit(60)
                    emit(88)
                    sysc()
                if not
                    fn_save_n: 0
                    fw_on: 0
                    fw_done: 0
                    fw_pos: _sov_list_new()
                    fargs: _sov_list_len(ps)
                    floc: 0
                    if fi < _sov_list_len(fn_locs)
                        floc: peek_i64(fn_locs, 16 + fi * 8)
                    ftot: fargs + floc
                    if ftot > 5
                        ftot: 5
                    fn_save_n: ftot
                    no_frame: 0
                    if fargs + floc < 6
                        if starts(walk_nm, "_sov_") is 0
                            no_frame: 1
                    # Volatile-only native twins read arg regs directly
                    # and save nothing, so for them the rbp frame, the
                    # callee-saved pushes and copyargs are pure overhead
                    # (the twin replaces the Sovren body wholesale).
                    # nt_will_twin is exact: 1 only when try_native_body
                    # will plant the twin, so other programs keep the
                    # framed Sovren body for these same names.
                    nt_fl: 0
                    sx_force_native: 0
                    if _sov_str_eq(walk_nm, "syntax_build") is 1 -> sx_force_native: 1
                    if _sov_str_eq(walk_nm, "syntax_statement_build") is 1 -> sx_force_native: 1
                    if _sov_str_eq(walk_nm, "intern_kid_n") is 1 -> sx_force_native: 1
                    if no_frame is 0 or sx_force_native is 1
                        if nt_will_twin(walk_nm) is 1
                            nt_fl: 1
                            no_frame: 1
                            fn_save_n: 0
                    isfib: fiblike(walk_nm, ps, peek_i64(bodies, 16 + fi * 8))
                    if isfib is 1
                        fn_save_n: 1
                        no_frame: 1
                    can_here: 0
                    cbi: 0
                    as long as cbi < _sov_list_len(peek_i64(bodies, 16 + fi * 8))
                        if _sov_str_eq(strip_span(peek_i64(peek_i64(bodies, 16 + fi * 8), 16 + cbi * 8)), "private") is 1
                            can_here: 1
                        cbi: cbi + 1
                    del_ok: 0
                    if no_frame is 1
                        if nt_fl is 0
                            if can_here is 0
                                if isfib is 0
                                    if fi is not entry_idx
                                        if _sov_list_len(ps) < 7
                                            del_ok: delegate_name(walk_nm, ps, peek_i64(bodies, 16 + fi * 8))
                    leaf8_fn: 0
                    if _sov_list_len(ps) < 8
                        if fargs + floc > 5
                            leaf8_fn: leaf8_scan(peek_i64(bodies, 16 + fi * 8))
                    leaf8: leaf8_fn
                    prolog()
                    if can_here is 1
                        if no_frame is 0
                            if isfib is 0
                                canary_store()
                    if nt_fl is 0
                        copyargs(_sov_list_len(ps))
                    if _sov_str_eq(walk_nm, "_sov_heap_alloc") is 1
                        prof_emit("prof_allocations", 0 - 1)
                        prof_emit("prof_alloc_bytes", 7)
                    if _sov_str_eq(walk_nm, "intern_kid_full") is 1
                        prof_emit("prof_fallbacks", 0 - 1)
                    if _sov_str_eq(walk_nm, "intern_kid_n_full") is 1
                        prof_emit("prof_fallbacks", 0 - 1)
                    if _sov_str_eq(walk_nm, "intern_fast_do") is 1
                        prof_emit("prof_fallbacks", 0 - 1)
                    if isfib is 1
                        emit_fib_iter()
                    if not
                        if fi is entry_idx
                            skip_al: dead_iota(peek_i64(bodies, 16 + fi * 8))
                            if need_priv is 1
                                emit_nodump()
                                emit_canary_seed()
                                emit_crash_install()
                            leaf8: leaf8_scan(tops)
                            stmt_lns: tops_lns
                            entry_start: here()
                            rax_small: 0
                            in_entry_now: 1
                            dbg_tops: 1
                            body(tops)
                            dbg_tops: 0
                            in_entry_now: 0
                            stmt_lns: _sov_list_get(body_lns, fi)
                            cflush_all()
                        leaf8: leaf8_fn
                        if fi is 0
                            mark("W-walk0")
                        if fi is entry_idx
                            in_entry_now: 1
                        if fi is 300
                            mark("Wq1")
                        if fi is 600
                            mark("Wq2")
                        if fi is 900
                            mark("Wq3")
                        if del_ok is 1
                            leave()
                            emit(233)
                            dja: here()
                            emit4(0)
                            addp(dja, "rel", del_target)
                            if sf_lookup(del_target) > 0 - 1
                                saw_str: 1
                        bw_ls: peek_i64(bodies, 16 + fi * 8)
                        if del_ok is 1
                            bw_ls: bw_empty
                        tco_entry: 0
                        if tco_allowed(bw_ls, walk_nm) is 1
                            tco_entry: here()
                        tco_nm: walk_nm
                        tco_ps: ps
                        body(bw_ls)
                        mark("bw")
                        if fi is entry_idx
                            mark("W-entry-done")
                        if fi is entry_idx
                            in_entry_now: 0
                    # Native twins intentionally save no source locals: they
                    # consume argument registers, not the discarded body.
                    if nt_fl is 0
                        if _sov_list_len(locals) < 6
                            if fn_save_n < _sov_list_len(locals)
                                print "Warning: locals"
                                _sov_print(walk_nm)
                                print _sov_list_len(locals)
                                print fn_save_n
                    if saw_str is 1
                        mark_fn_str(walk_nm)
                    if no_frame is 0
                        ns: (_sov_list_len(locals) + 1) * 8
                        if ns < 32
                            ns: 32
                        if _sov_list_len(cd_at) > 0
                            ns: ns + 16
                        put(pro_at, ns)
                        if fw_on is 1
                            if isfib is 0
                                canary_check()
                                xor_rax()
                                restores()
                                frame_wipe()
                                emit(201)
                                ret()
                                fw_done: 1
                            fwi: 0
                            as long as fwi < _sov_list_len(fw_pos)
                                put(peek_i64(fw_pos, 16 + fwi * 8), ns + fn_save_n * 8)
                                fwi: fwi + 1
                        chi: 0
                        as long as chi < _sov_list_len(cd_at)
                            put(peek_i64(cd_at, 16 + chi * 8), 8 - ns - fn_save_n * 8)
                            chi: chi + 1
                        cd_at: 0
                    if fi is entry_idx
                        if sxe_mode is 1
                            xor_rax()
                            rdi_imm(0)
                            rax_imm(60)
                            emit(205)
                            emit(128)
                            ret()
                        if not
                            if need_priv is 1
                                emit_stack_wipe()
                            emit(49)
                            emit(255)
                            if rax_small is 1
                                emit(176)
                                emit(60)
                            if not
                                emit_sys_num(60)
                            emit_sys_do()
                    if not
                        if isfib is 0
                            if fw_done is 0
                                xor_rax()
                                leave()
                                ret()
        fi: fi + 1
    return 0

par_slen s:
    k: 0
    as long as peek_byte(s, k) > 0
        k: k + 1
    return k

pm_note3 s n:
    if pm_ptf is 0
        return 0
    syscall(1, 2, s, par_slen(s), 0)
    c2: 48 + n / 100000 % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    c2: 48 + n / 10000 % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    c2: 48 + n / 1000 % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    c2: 48 + n / 100 % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    c2: 48 + n / 10 % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    c2: 48 + n % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    pm_dbg(" ")
    return 0

pm_ms:
    if pm_tb is 0
        pm_tb: _sov_heap_alloc(64)
    syscall(228, 1, pm_tb, 0)
    return peek_i64(pm_tb, 0) * 1000 + peek_i64(pm_tb, 8) / 1000000


pm_dbg s:
    if pm_vv is 1
        syscall(1, 2, s, par_slen(s), 0)
    return 0

pm_dbci s n:
    if pm_vv is 0
        return 0
    syscall(1, 2, s, par_slen(s), 0)
    c2: 48 + n % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    pm_dbg(" ")
    return 0

pm_dbg3 s n:
    if pm_vv is 0
        return 0
    syscall(1, 2, s, par_slen(s), 0)
    c2: 48 + n / 1000 % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    c2: 48 + n / 100 % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    c2: 48 + n / 10 % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    c2: 48 + n % 10
    poke_byte(pm_dbgc, 0, c2)
    syscall(1, 2, pm_dbgc, 1, 0)
    pm_dbg(" ")
    return 0


sig_seen: 0
sig_epoch: 0
par_sig_calc:
    par_sk: kv
    par_sh: 0
    if kn > 65536
        par_sh: nhash(kn)
    par_sp: 3
    if cn_dstk is not 0
        if sig_seen is not 0
            sig_epoch: sig_epoch + 1
            as long as peek_i64(sig_seen, 8) < peek_i64(cnms, 8)
                sig_seen: _sov_list_add(sig_seen, 0)
            psd_st: cn_dstk + 16
            psd_ns: peek_i64(cn_dstk, 8)
            psd_em: cemt + 16
            psd_nm: cnms + 16
            psd_vl: cvls + 16
            psd_sn: sig_seen + 16
            pci: 0
            as long as pci < psd_ns
                psd_di: peek_i64(psd_st, pci * 8)
                if peek_i64(psd_em, psd_di * 8) is 0
                    if peek_i64(psd_sn, psd_di * 8) is not sig_epoch
                        dummy: poke_i64(psd_sn, psd_di * 8, sig_epoch)
                        par_sp: par_sp + band(nhash(peek_i64(psd_nm, psd_di * 8)) * 2654435761 + peek_i64(psd_vl, psd_di * 8) * 40503, 2305843009213693951)
                        par_sp: band(par_sp, 2305843009213693951)
                pci: pci + 1
    par_si: 5
    imi: 0
    as long as imi < _sov_list_len(im_names)
        par_si: par_si * 33 + nhash(_sov_list_get(im_names, imi))
        par_si: band(par_si, 2305843009213693951)
        imi: imi + 1
    par_si: par_si * 2 + did_stos
    return 0

par_sentry:
    dummy: par_sig_calc()
    poke_i64(pe_10p, 16, par_sk)
    poke_i64(pe_10p, 24, par_sh)
    poke_i64(pe_11p, 16, par_sp)
    poke_i64(pe_11p, 24, par_si)
    return 0

pe0 op fn a b:
    if pe_ok is 1
        if pm_wc + 96 > par_pool + 4194304
            par_err: 1
            pe_ok: 0
        if pe_ok is 1
            poke_i64(pm_wc, 0, op)
            poke_i64(pm_wc, 8, fn)
            poke_i64(pm_wc, 16, a)
            poke_i64(pm_wc, 24, b)
            poke_i64(pm_wc, 32, 0 - 1)
            if op is 50
                pe_10p: pm_wc + 48
                pe_11p: pm_wc + 96
            pm_wc: pm_wc + 48
    return 0

pe1 op a b s:
    if pe_ok is 1
        sl: par_slen(s)
        if pm_sc + sl + 16 > par_pool + 8388608
            par_err: 1
            pe_ok: 0
        if pm_wc + 96 > par_pool + 4194304
            par_err: 1
            pe_ok: 0
        if pe_ok is 1
            poke_i64(pm_wc, 0, op)
            poke_i64(pm_wc, 8, par_cfn)
            poke_i64(pm_wc, 16, a)
            poke_i64(pm_wc, 24, b)
            poke_i64(pm_wc, 32, sl)
            poke_i64(pm_wc, 40, pm_sc - par_pool)
            sk2: 0
            as long as sk2 < sl
                poke_byte(pm_sc, sk2, peek_byte(s, sk2))
                sk2: sk2 + 1
            poke_byte(pm_sc, sl, 0)
            pm_sc: pm_sc + sl + 1
            pm_wc: pm_wc + 48
    return 0

plog_cset num conj:
    if par_do is 1
        pe1(2, conj, 0, num)
    return 0

plog_mark op:
    if par_do is 1
        pe0(op, par_cfn, 0, 0)
    return 0

plog_str op s:
    if par_do is 1
        pe1(op, 0, 0, s)
    return 0

plog_kn nv wp:
    if par_do is 1
        pe1(1, nv, 0, wp)
    return 0

plog_h0:
    if par_do is 1
        par_h0a: here()
    return 0

plog_h1 nm:
    if par_do is 1
        pe1(30, par_h0a, here(), nm)
    return 0

par_intern s:
    r: intern(s)
    if par_do is 1
        pe1(20, r, 0, s)
    return r

par_pkstr k:
    if _sov_str_eq(k, "rel") is 1
        return 1
    if _sov_str_eq(k, "fnaddr") is 1
        return 1
    if _sov_str_eq(k, "grel") is 1
        return 1
    if _sov_str_eq(k, "glob") is 1
        return 1
    if _sov_str_eq(k, "sbss") is 1
        return 1
    return 0

par_cores:
    fd: syscall(2, "/proc/cpuinfo", 0, 0, 0)
    if fd < 0
        return 0
    buf: _sov_heap_alloc(262144)
    n: syscall(0, fd, buf, 262144, 0)
    syscall(3, fd, 0)
    c: 1
    i: 0
    as long as i + 10 < n
        if peek_byte(buf, i) is 112
            if peek_byte(buf, i + 1) is 114
                if peek_byte(buf, i + 2) is 111
                    if peek_byte(buf, i + 3) is 99
                        c: c + 1
                        i: i + 9
        i: i + 1
    return c

par_dup_log:
    fdx: syscall(2, "/tmp/sov_par_k.log", 577, 420, 0)
    if fdx > 0
        syscall(33, fdx, 1, 0)
    return 0

par_setup:
    pm_ptf: 0
    if pm_dbgc is 0
        pm_dbgc: _sov_heap_alloc(64)
    pm_dbg("PS\n")
    if par_kill is 1
        return 0
    pn: 0
    tf2: syscall(2, "/tmp/sov_ptime", 0, 0, 0)
    if tf2 > 2
        syscall(3, tf2, 0)
        pm_ptf: 1
        pm_vv: 1
        pm_t0: pm_ms()
    if dbg_mode is 0
        if prof_mode is 0
            pn: par_cores()
    pm_dbg("PB\n")
    tf: syscall(2, "/tmp/sov_nopar", 0, 0, 0)
    if tf > 2
        syscall(3, tf, 0)
        pn: 0
    if pn > 1
        if _sov_list_len(names) > 127
            pm_dbg("PC0\n")
            par_base0: here()
            par_pat0: _sov_list_len(patch_at)
            par_fn0: _sov_list_len(fn_names)
            par_sf0: _sov_list_len(str_fns)
            par_hi2: _sov_list_len(names) / 2
            # split by cumulative body lines (work), not fn count; the
            # parent also pays the merge, so it takes the larger share.
            psp_tot: 0
            psp_i: 0
            as long as psp_i < _sov_list_len(bodies)
                psp_tot: psp_tot + _sov_list_len(peek_i64(bodies, 16 + psp_i * 8))
                psp_i: psp_i + 1
            psp_tgt: psp_tot * 60 / 100
            psp_acc: 0
            psp_i: 0
            as long as psp_i < _sov_list_len(bodies)
                if psp_acc >= psp_tgt
                    if psp_i > 0
                        if psp_i < _sov_list_len(names)
                            par_hi2: psp_i
                    psp_i: _sov_list_len(bodies)
                if psp_i < _sov_list_len(bodies)
                    psp_acc: psp_acc + _sov_list_len(peek_i64(bodies, 16 + psp_i * 8))
                    psp_i: psp_i + 1
            pm_dbg("PC1\n")
            par_pool: syscall(9, 0, 33554432, 3, 33, 0 - 1, 0)
            pm_dbg("PC2\n")
            if par_pool > 4096
                pm_wc: par_pool + 4096
                pm_sc: par_pool + 4194304
                pe_ok: 1
                pm_dbg("PC3\n")
                pm_t0: pm_ms()
                par_sv_kn: kn
                par_sv_kv: kv
                par_sv_stos: did_stos
                par_sv_im: 0
                if im_names is not 0
                    par_sv_im: _sov_list_new()
                    psv_i: 0
                    as long as psv_i < _sov_list_len(im_names)
                        par_sv_im: _sov_list_add(par_sv_im, peek_i64(im_names, 16 + psv_i * 8))
                        psv_i: psv_i + 1
                pid: syscall(57, 0)
                if pm_ptf is 1
                    pm_tfk: pm_ms()
                    pm_note3("TFK=", pm_tfk  - pm_t0)
                    pm_dbg("\n")
                pm_dbg("PC4\n")
                if pid is 0
                    par_child: 1
                    par_kill: 1
                    par_do: 1
                    walk_lo: par_hi2
                    pm_dbg("K1\n")
                    par_dup_log()
                    zzlog: _sov_list_new()
                    pm_p0: zzlog
                    pm_probe: _sov_list_new()
                    pm_samp: _sov_list_new()
                    pm_sam2: _sov_list_new()
                    zzlog_s: _sov_list_new()
                    parm_cfn: _sov_list_new()
                    parm_off: _sov_list_new()
                    parm_pat: _sov_list_new()
                    pm_dbg("K2\n")
                    return 0
                if pid > 0
                    pm_dbg("PP\n")
                    par_pid0: pid
                    walk_hi: par_hi2
                    par_live: 1
                    return 0
    return 0

par_w8 wc v:
    poke_i64(wc, 0, v)
    return wc + 8

par_wstr wc s:
    if wc + par_slen(s) + 32 > par_pool + 31457280
        par_err: 1
        return wc
    sl: par_slen(s)
    poke_i64(wc, 0, sl)
    wc: wc + 8
    k: 0
    as long as k < sl
        poke_byte(wc, k, peek_byte(s, k))
        k: k + 1
    poke_byte(wc, sl, 0)
    return wc + sl + 1

par_wblk wc src n:
    if wc + n + 16 > par_pool + 31457280
        par_err: 1
        return wc
    k: 0
    as long as k + 8 <= n
        poke_i64(wc, k, peek_i64(src, 16 + k))
        k: k + 8
    as long as k < n
        poke_byte(wc, k, peek_byte(src, 16 + k))
        k: k + 1
    return wc + n

par_wraw wc src off n:
    if wc + n + 16 > par_pool + 31457280
        par_err: 1
        return wc
    k: 0
    as long as k + 8 <= n
        poke_i64(wc, k, peek_i64(src, off + k))
        k: k + 8
    as long as k < n
        poke_byte(wc, k, peek_byte(src, off + k))
        k: k + 1
    return wc + n

par_wsseg wc src i0 n:
    if n < 1
        return wc
    return par_wraw(wc, src, i0 * 8 + 16, n * 8)

par_export:
    blen: here() - par_base0
    npat: _sov_list_len(patch_at) - par_pat0
    nfn: _sov_list_len(fn_names) - par_fn0
    nsf: _sov_list_len(str_fns) - par_sf0
    poke_i64(par_pool, 0, 5784377936601)
    poke_i64(par_pool, 8, blen)
    poke_i64(par_pool, 16, nfn)
    poke_i64(par_pool, 24, npat)
    poke_i64(par_pool, 32, nsf)
    poke_i64(par_pool, 40, _sov_list_len(patch_line) - par_pat0)
    poke_i64(par_pool, 48, used_al + used_pr * 2 + used_sl * 4 + used_eq * 8 + used_pi * 16 + used_tr * 32 + can_used * 64)
    poke_i64(par_pool, 56, entry_start)
    poke_i64(par_pool, 120, pm_wc)
    wc: par_pool + 8388608
    poke_i64(par_pool, 64, wc)
    wc: par_wraw(wc, oc, par_base0, blen)
    poke_i64(par_pool, 72, wc)
    wc: par_wsseg(wc, patch_at, par_pat0, npat)
    wc: par_wsseg(wc, patch_val, par_pat0, npat)
    wc: par_wsseg(wc, patch_line, par_pat0, npat)
    poke_i64(par_pool, 80, wc)
    pi2: 0
    as long as pi2 < npat
        knd: _sov_list_get(patch_kind, par_pat0 + pi2)
        vlu: peek_i64(patch_val, 16 + (par_pat0 + pi2) * 8)
        wf: par_pkstr(knd)
        poke_i64(wc, 0, wf)
        wc: wc + 8
        wc: par_wstr(wc, knd)
        if wf is 1
            wc: par_wstr(wc, vlu)
        pi2: pi2 + 1
    poke_i64(par_pool, 88, wc)
    fi2: 0
    as long as fi2 < nfn
        wc: par_wstr(wc, _sov_list_get(fn_names, par_fn0 + fi2))
        fi2: fi2 + 1
    poke_i64(par_pool, 96, wc)
    si2: 0
    as long as si2 < nsf
        wc: par_wstr(wc, _sov_list_get(str_fns, par_sf0 + si2))
        si2: si2 + 1
    poke_i64(par_pool, 104, wc)
    # String offsets belong to the child's pool, not the parent's.
    # Transfer the current compilation's raw pool with its byte length.
    # The parent re-interns referenced payloads when importing fixups.
    poke_i64(par_pool, 192, wc)
    p0_sl: _sov_buf_len(strb)
    poke_i64(par_pool, 200, p0_sl)
    wc: par_wraw(wc, strb, 16, p0_sl)
    if wc > par_pool + 31457280
        par_err: 1
    return 0

pm_evstr:
    sfl: peek_i64(pm_pes, 0)
    if sfl < 0
        pm_rval: 0
        pm_pes: pm_pes + 8
        return 0
    pm_rval: pm_pes + 8
    pm_pes: pm_pes + 8 + sfl + 1
    return 0

pm_flush_all:
    if cn_dstk is not 0
        pfa_st: cn_dstk + 16
        pfa_n: peek_i64(cn_dstk, 8)
        pfa_em: cemt + 16
        pfa_i: 0
        as long as pfa_i < pfa_n
            dummy: poke_i64(pfa_em, peek_i64(pfa_st, pfa_i * 8) * 8, 1)
            pfa_i: pfa_i + 1
        cn_dstk: _sov_list_new()
    return 0

pm_flush_name nm:
    nx2: cn_lookup(nm)
    if nx2 > 0 - 1
        if _sov_list_get(cemt, nx2) is 0
            cemt: _sov_list_set(cemt, nx2, 1)
    return 0

pm_flush_globs:
    # Child cflush_globs materializes via cflush(nm) per flushed name,
    # which already emitted op4 events; replaying those covers every
    # state change.  Shadowed/non-global entries stay dirty on the
    # stack, matching the child's re-dirty.  (Was: O(globals) scan per
    # event = 212ms of a 230ms merge.)
    return 0

pm_apply op a b s:
    if op is 1
        kn: s
        kv: a
        pm_kn_touched: 1
    if op is 2
        dummy: cset(s, a)
    if op is 3
        pm_flush_all()
    if op is 4
        pm_flush_name(s)
    if op is 5
        pm_flush_globs()
    if op is 6
        im_names: _sov_list_add(im_names, s)
        if par_mg_app is not 0
            par_mg_app: _sov_list_add(par_mg_app, s)
    if op is 7
        did_stos: 1
    if op is 20
        p2: intern(s)
        imap_f: _sov_list_add(imap_f, a)
        imap_t: _sov_list_add(imap_t, p2)
    if op is 30
        pm_ha: _sov_list_add(pm_ha, a)
        pm_hb: _sov_list_add(pm_hb, b)
        pm_hs: _sov_list_add(pm_hs, s)
        pm_hx: _sov_list_add(pm_hx, 0)
    return 0

pm_delta_at x:
    d: 0
    hi3: 0
    as long as hi3 < _sov_list_len(pm_ha)
        if peek_i64(pm_hx, 16 + hi3 * 8) is 1
            if peek_i64(pm_ha, 16 + hi3 * 8) < x
                d: d + peek_i64(pm_hb, 16 + hi3 * 8) - peek_i64(pm_ha, 16 + hi3 * 8)
        hi3: hi3 + 1
    return d

pm_copy clo chi dst0:
    # pm_blob holds child oc from par_base0 on; clo/chi are absolute
    # child oc offsets.
    k: 0
    as long as k + 8 <= chi - clo
        poke_i64(oc, dst0 + k, peek_i64(pm_blob, clo - par_base0 + k))
        k: k + 8
    as long as k < chi - clo
        poke_byte(oc, dst0 + k, peek_byte(pm_blob, clo - par_base0 + k))
        k: k + 1
    return 0

pm_name_read:
    nl2: peek_i64(pm_pfns, 0)
    pm_rval: pm_pfns + 8
    pm_pfns: pm_pfns + 8 + nl2 + 1
    return pm_rval

pm_map_int x:
    mi: 0
    as long as mi < _sov_list_len(imap_f)
        if _sov_list_get(imap_f, mi) is x
            return _sov_list_get(imap_t, mi)
        mi: mi + 1
    return 0 - 1

pm_import_patches plo phi clo cur0:
    bad: 0
    pj: plo
    hj: 0
    hlen: _sov_list_len(pm_ha)
    drun: 0
    as long as pj < phi
        at: peek_i64(pm_ppat, pj * 8)
        vraw: peek_i64(pm_ppv, pj * 8)
        pline: peek_i64(pm_ppl, pj * 8)
        wf: peek_i64(pm_pps, 0)
        klen: peek_i64(pm_pps, 8)
        kptr: pm_pps + 16
        pm_pps: pm_pps + 16 + klen + 1
        if wf is 1
            vlen: peek_i64(pm_pps, 0)
            pm_rval: pm_pps + 8
            pm_pps: pm_pps + 8 + vlen + 1
        adv: 1
        as long as adv is 1
            if hj < hlen
                if peek_i64(pm_hb, 16 + hj * 8) <= at
                    if peek_i64(pm_hx, 16 + hj * 8) is 1
                        drun: drun + peek_i64(pm_hb, 16 + hj * 8) - peek_i64(pm_ha, 16 + hj * 8)
                    hj: hj + 1
                if not
                    adv: 0
            if not
                adv: 0
        exc: 0
        if hj < hlen
            if peek_i64(pm_ha, 16 + hj * 8) <= at
                if peek_i64(pm_hx, 16 + hj * 8) is 1
                    exc: 1
        if exc is 0
            vv: vraw
            if wf is 1
                vv: pm_rval
            p0_isstr: 0
            if _sov_str_eq(kptr, "strrel") is 1
                p0_isstr: 1
            if _sov_str_eq(kptr, "str") is 1
                p0_isstr: 1
            if _sov_str_eq(kptr, "str32") is 1
                p0_isstr: 1
            if p0_isstr is 1
                p0_sl: peek_i64(par_pool, 200)
                if vraw < 0
                    bad: 1
                if vraw >= p0_sl
                    bad: 1
                if vraw >= 0
                    if vraw < p0_sl
                        p0_sb: peek_i64(par_pool, 192)
                        vv: intern_nz(p0_sb + vraw)
            nat: cur0 + (at - clo) - drun
            patch_at: _sov_list_add(patch_at, nat)
            patch_kind: _sov_list_add(patch_kind, kptr)
            if patch_kid is not 0
                patch_kid: _sov_list_add(patch_kid, intern_kid(kptr))
            patch_val: _sov_list_add(patch_val, vv)
            patch_line: _sov_list_add(patch_line, pline)
        pj: pj + 1
    return bad

pm_commit clo chi plo phi:
    pm_cb_fn: _sov_list_len(fn_names)
    pm_cb_pat: _sov_list_len(patch_at)
    cur0: pm_cursor
    as long as oc_n + (chi - clo) + 65536 > oc_cap
        ocgrow()
    pm_main: pm_name_read()
    fn_names: _sov_list_add(fn_names, pm_rval)
    fn_offs: _sov_list_add(fn_offs, cur0)
    pos: clo
    drun: 0
    hj: 0
    as long as hj < _sov_list_len(pm_ha)
        hs2: peek_i64(pm_ha, 16 + hj * 8)
        he2: peek_i64(pm_hb, 16 + hj * 8)
        hn2: peek_i64(pm_hs, 16 + hj * 8)
        if hs2 > pos
            pm_copy(pos, hs2, cur0 + pos - clo - drun)
        if fn_lookup(hn2) < 0
            pm_name_read()
            fn_names: _sov_list_add(fn_names, pm_rval)
            fn_offs: _sov_list_add(fn_offs, cur0 + hs2 - clo - drun)
            pm_copy(hs2, he2, cur0 + hs2 - clo - drun)
        if not
            pm_name_read()
            pm_hx: _sov_list_set(pm_hx, hj, 1)
            drun: drun + he2 - hs2
        pos: he2
        hj: hj + 1
    if pos < chi
        pm_copy(pos, chi, cur0 + pos - clo - drun)
    pm_cursor: cur0 + (chi - clo) - drun
    bad: pm_import_patches(plo, phi, clo, cur0)
    if bad is 1
        pm_rfrom: clo
    poke_i64(par_pool, 184, pm_ms())
    return 0

pm_init:
    if peek_i64(par_pool, 0) is 5784377936601
        pm_blen: peek_i64(par_pool, 8)
        pm_nfn: peek_i64(par_pool, 16)
        pm_npat: peek_i64(par_pool, 24)
        pm_nsf: peek_i64(par_pool, 32)
        pm_bits: peek_i64(par_pool, 48)
        pm_es: peek_i64(par_pool, 56)
        pm_blob: peek_i64(par_pool, 64)
        pm_ppat: peek_i64(par_pool, 72)
        pm_pps: peek_i64(par_pool, 80)
        pm_pfns: peek_i64(par_pool, 88)
        pm_sf: peek_i64(par_pool, 96)
        pm_pev: par_pool + 4096
        pm_nev: peek_i64(par_pool, 120)
        pm_ppv: pm_ppat + pm_npat * 8
        pm_ppl: pm_ppat + pm_npat * 16
        return 1
    return 0

par_merge:
    pm_dbg("M0\n")
    stp: _sov_heap_alloc(64)
    rfrom: 0 - 1
    if par_pid0 > 0
        wp: syscall(61, par_pid0, stp, 0, 0)
        st: peek_i64(stp, 0)
        if st > 0
            rfrom: par_hi2
    par_kb: 0
    fdx: syscall(2, "/tmp/sov_par_k.log", 0, 0, 0)
    if fdx > 0
        nrd: syscall(0, fdx, stp, 8, 0)
        if nrd > 0
            par_kb: fdx
            syscall(8, fdx, 0, 0, 0)
        if not
            syscall(3, fdx, 0)
    pm_dbg("M1\n")
    if rfrom < 0
        ok: pm_init()
        pm_dbg3("PA=", pm_ptf)
        if ok is 0
            rfrom: par_hi2
        pm_dbg3("PM_NP=", pm_np)
        pm_dbg3("PM_NEV=", pm_nev)
    pm_dbg("M2\n")
    if rfrom < 0
        par_bk_kn: kn
        par_bk_kv: kv
        par_bk_stos: did_stos
        par_bk_im: im_names
        par_bk_set: 1
        pm_kn_touched: 0
        par_mg_app: _sov_list_new()
        par_rb_fn: _sov_list_len(fn_names)
        par_rb_pat: _sov_list_len(patch_at)
        par_rb_sf: _sov_list_len(str_fns)
        par_rb_set: 1
        kn: par_sv_kn
        kv: par_sv_kv
        did_stos: par_sv_stos
        if par_sv_im is not 0
            im_names: par_sv_im
    if rfrom < 0
        pm_cursor: oc_n
        pm_rfrom: 0 - 1
        evp: pm_pev
        even: pm_nev
        cdo: 0
        cfn: 0
        cclo: 0
        cpat: 0
        keepg: 1
        as long as evp < even
            if keepg is 1
                op: peek_i64(evp, 0)
                fn2: peek_i64(evp, 8)
                va: peek_i64(evp, 16)
                vb: peek_i64(evp, 24)
                sfl: peek_i64(evp, 32)
                sp: 0
                if sfl > 0 - 1
                    sp: par_pool + peek_i64(evp, 40)
                nx3: evp + 48
                if op is 50
                    if cdo is 1
                        pm_commit(cclo, va, cpat - par_pat0, vb - par_pat0)
                        if pm_rfrom > 0 - 1
                            dummy: poke_i64(fn_names, 8, pm_cb_fn)
                            dummy: poke_i64(fn_offs, 8, pm_cb_fn)
                            dummy: poke_i64(patch_at, 8, pm_cb_pat)
                            dummy: poke_i64(patch_kind, 8, pm_cb_pat)
                            dummy: poke_i64(patch_val, 8, pm_cb_pat)
                            dummy: poke_i64(patch_line, 8, pm_cb_pat)
                            if patch_kid is not 0
                                dummy: poke_i64(patch_kid, 8, pm_cb_pat)
                            rfrom: pm_cfn_prev
                            keepg: 0
                    if keepg is 1
                        # entry validation events must be op10 then op11 for same fn
                        good: 0
                        if peek_i64(evp + 48, 0) is 10
                            if peek_i64(evp + 48, 8) is fn2
                                if peek_i64(evp + 96, 0) is 11
                                    if peek_i64(evp + 96, 8) is fn2
                                        dummy: par_sig_calc()
                                        if par_sk is peek_i64(evp + 48, 16)
                                            if par_sh is peek_i64(evp + 48, 24)
                                                if par_sp is peek_i64(evp + 96, 16)
                                                    if par_si is peek_i64(evp + 96, 24)
                                                        good: 1
                        if good is 0
                            if fn2 < _sov_list_len(names)
                                pm_dbg(peek_i64(names, 16 + fn2 * 8))
                            pm_dbg("\n")
                            rfrom: fn2
                            keepg: 0
                        if good is 1
                            cdo: 1
                            cclo: va
                            cpat: vb
                            pm_cfn_prev: fn2
                            pm_ha: _sov_list_new()
                            pm_hb: _sov_list_new()
                            pm_hs: _sov_list_new()
                            pm_hx: _sov_list_new()
                        evp: evp + 144
                        keepg2: 0
                    if keepg is 0
                        evp: even
                if op is not 50
                    if cdo is 1
                        pm_apply(op, va, vb, sp)
                    evp: nx3
        pm_dbg3("PB=", pm_ptf)
        if keepg is 1
            if cdo is 1
                pm_commit(cclo, pm_blen + par_base0, cpat - par_pat0, pm_npat)
                if pm_rfrom > 0 - 1
                    dummy: poke_i64(fn_names, 8, pm_cb_fn)
                    dummy: poke_i64(fn_offs, 8, pm_cb_fn)
                    dummy: poke_i64(patch_at, 8, pm_cb_pat)
                    dummy: poke_i64(patch_kind, 8, pm_cb_pat)
                    dummy: poke_i64(patch_val, 8, pm_cb_pat)
                    dummy: poke_i64(patch_line, 8, pm_cb_pat)
                    if patch_kid is not 0
                        dummy: poke_i64(patch_kid, 8, pm_cb_pat)
                    rfrom: pm_cfn_prev
        if par_bk_set is 1
            sfj: 0
            as long as sfj < pm_nsf
                sfl2: peek_i64(pm_sf, 0)
                str_fns: _sov_list_add(str_fns, pm_sf + 8)
                pm_sf: pm_sf + 8 + sfl2 + 1
                sfj: sfj + 1
            if band(pm_bits, 1) is 1
                used_al: 1
            if band(pm_bits, 2) is 2
                used_pr: 1
            if band(pm_bits, 4) is 4
                used_sl: 1
            if band(pm_bits, 8) is 8
                used_eq: 1
            if band(pm_bits, 16) is 16
                used_pi: 1
            if band(pm_bits, 32) is 32
                used_tr: 1
            if band(pm_bits, 64) is 64
                can_used: 1
            if pm_es > 0 - 1
                if rfrom < 0
                    entry_start: pm_es
            oc_n: pm_cursor
            if peek_i64(par_pool, 160) is 1
                had_err: 1
    if rfrom < 0
        if par_kb > 0
            go3: 1
            rl3: 0
            as long as go3 is 1
                nb3: syscall(0, par_kb, stp, 48, 0)
                if nb3 > 0
                    syscall(1, 1, stp, nb3, 0)
                    rl3: rl3 + nb3
                    # A nested kid relays into this same shared log
                    # file while reading it: without a hard cap the
                    # relay feeds itself until the disk is full.
                    if rl3 > 1048576
                        go3: 0
                if not
                    go3: 0
    if par_kb > 0
        syscall(3, par_kb, 0)
    syscall(87, "/tmp/sov_par_k.log", 0)
    pm_dbg("M9\n")
    if pm_ptf is 1
        pm_t2: pm_ms()
        pm_note3("T1=", pm_t1)
        pm_note3("T2=", pm_t2)
        pm_dbg("\n")
    if rfrom > 0 - 1
        par_rb_set: 0
        if par_bk_set is 1
            dummy: pm_flush_all()
            if pm_kn_touched is 0
                kn: par_bk_kn
                kv: par_bk_kv
            if par_bk_stos is 1
                did_stos: 1
            im_names: par_bk_im
            if par_mg_app is not 0
                psv_j: 0
                as long as psv_j < _sov_list_len(par_mg_app)
                    im_names: _sov_list_add(im_names, peek_i64(par_mg_app, 16 + psv_j * 8))
                    psv_j: psv_j + 1
            par_bk_set: 0
    return rfrom

flor_range flo fhi gh gcap:
    # Per-function front analyses (inl2/licm body rewrites, fn_locs,
    # frequency homes) for fn range [flo, fhi).  Runs inside the
    # par_again loop so a parallel child pays only for its own range
    # (fn_locs/fn_lord are pre-sized; out-of-range slots stay 0 there
    # and are never read by the walker of the other range).
    fli: flo
    as long as fli < fhi
        fb: peek_i64(bodies, 16 + fli * 8)
        # LICM runs here (before the fn_locs count below) so fresh
        # licm_t* temps are counted in the frame/homereg decision.
        if tk_run is 0
            stmt_lns: peek_i64(body_lns, 16 + fli * 8)
            par_cfn: fli
            if 0 is 1
                dummy: 0
            inl2_names: names
            inl2_params: params
            inl2_bodies: bodies
            inl2_gh: gh
            inl2_gcap: gcap
            if inl2_scan(fb, stmt_lns, fli) is 1
                fb: inl2_out
                bodies: _sov_list_set(bodies, fli, fb)
                body_lns: _sov_list_set(body_lns, fli, inl2_sln)
                stmt_lns: inl2_sln
            if licm_scan(fb) is 1
                fb: licm_out
                bodies: _sov_list_set(bodies, fli, fb)
                body_lns: _sov_list_set(body_lns, fli, licm_sln)
        # fn_locs + frequency homes in one pass: lord_build counts
        # distinct non-global assignment targets (lord_fcnt) while it
        # tallies word frequencies over the same lines, one epoch table.
        fbn: _sov_list_len(fb)
        needcap: 16
        as long as needcap < fbn * 2 + 2
            needcap: needcap + needcap
        if floc_cap < needcap
            floc_ln: _sov_heap_alloc(needcap * 8)
            floc_a: _sov_heap_alloc(needcap * 8)
            floc_b: _sov_heap_alloc(needcap * 8)
            floc_c: _sov_heap_alloc(needcap * 8)
            floc_ep: _sov_heap_alloc(needcap * 8)
            dummy: _sov_bzero(floc_ep, needcap * 8)
            floc_ce: _sov_heap_alloc(needcap * 8)
            dummy: _sov_bzero(floc_ce, needcap * 8)
            floc_cap: needcap
            floc_epoch: 0
        fn_locs: _sov_list_set(fn_locs, fli, 0)
        flv_lord: lord_build(fb, gh, gcap, 0, _sov_list_len(peek_i64(params, 16 + fli * 8)))
        fn_locs: _sov_list_set(fn_locs, fli, lord_fcnt)
        fn_lord: _sov_list_set(fn_lord, fli, flv_lord)
        fli: fli + 1
    return 0

compile source:
    mark("C0")
    # Per-compilation semantic tables. The symbol table is rebuilt from the
    # parsed source below; the fast name->facts map is rebuilt by fsem_build
    # once the symbol table is final.
    fsem_key: 0
    fsem_val: 0
    fsem_tgt: 0
    fsem_cah: 0
    fsem_cap: 0
    dummy: syntax_reset_slabs()
    # Bound stdout for this compilation (see runtime _sov_print_val):
    # ~1 MB of diagnostics max, whatever path prints them.
    g_out_budget: 1048576
    dummy: ocgrow()
    tk2: syscall(2, "/tmp/sov_tklex", 0, 0, 0)
    if tk2 > 2
        syscall(3, tk2, 0)
        if pm_dbgc is 0
            pm_dbgc: _sov_heap_alloc(64)
        pm_ptf: 1
        pm_vv: 1
        tks0: pm_ms()
        tv9: syscall(2, "/tmp/sov_tkverify", 0, 0, 0)
        if tv9 > 2
            syscall(3, tv9, 0)
            tk_vfy: 1
        dummy: tk_lex(lines_of_fast(source))
        tk_run: 1
        tks1: pm_ms()
        pm_note3("TKMS=", tks1 - tks0)
        csum: 0
        ci: 0
        as long as ci < tk_n
            cw: peek_i64(tk_buf, ci * 16 + 8)
            csum: band(csum * 33 + cw, 4294967295)
            if tk_dump is 1
                syscall(1, 2, peek_i64(tk_buf, ci * 16), cw / 256, 0)
                syscall(1, 2, "|", 1, 0)
            ci: ci + 1
        pm_note3("TKN=", tk_n)
        pm_note3("TKC=", csum)
        pm_dbg("\n")
    iota_ptr: blank
    iota_lim: blank
    kn: blank
    kv: 0
    skip_al: blank
    used_al: 0
    used_sl: 0
    used_eq: 0
    used_pr: 0
    used_pi: 0
    used_tr: 0
    did_stos: 0
    thin_main: 0
    has_vm: 0
    need_priv: 0
    saw_str: 0
    str_vars: _sov_list_new()
    str_fns: _sov_list_new()
    sglob_names: _sov_list_new()
    ar_names: _sov_list_new()
    ar_cnt: _sov_list_new()
    fn_locs: _sov_list_new()
    fn_lord: _sov_list_new()
    str_fns: _sov_list_add(str_fns, "cat")
    str_fns: _sov_list_add(str_fns, "strcat")
    str_fns: _sov_list_add(str_fns, "_sov_strcat")
    str_fns: _sov_list_add(str_fns, "sub")
    str_fns: _sov_list_add(str_fns, "trim")
    str_fns: _sov_list_add(str_fns, "ch")
    str_fns: _sov_list_add(str_fns, "_sov_substring")
    seed_str_fns()
    pre_lns: _sov_list_new()
    mark("C0b")
    if dp_e_hit is 0
        pre_lns: sp_pu_lines(source)
    mark("C1")
    nls: pre_lns
    ni: 0
    # private/wipe probe: per-line strip + exact/prefix test (restored simple
    # form; the in-place span walk it replaces read corrupt values and
    # SEGVed on certain heap layouts -- c09b hunt, work/track1/LOG.md)
    nlp: 0
    nl2: 0
    as long as ni < _sov_list_len(nls)
        nlp: peek_i64(nls, 16 + ni * 8)
        nl2: strip_span(nlp)
        if _sov_str_eq(nl2, "private") is 1
            need_priv: 1
        if not
            if _sov_starts_with(nl2, "wipe ") is 1
                need_priv: 1
        ni: ni + 1
    cnms: _sov_list_new()
    sig_seen: _sov_list_new()
    sig_epoch: 0
    cvls: _sov_list_new()
    cemt: _sov_list_new()
    sbss_sizes: _sov_list_new()
    strb: _sov_buf_new()
    str_keys: _sov_list_new()
    str_pos: _sov_list_new()
    fn_names: _sov_list_new()
    fn_offs: _sov_list_new()
    glob_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_kid: _sov_list_new()
    patch_val: _sov_list_new()
    patch_line: _sov_list_new()
    stmt_lns: _sov_list_new()
    body_lns: _sov_list_new()
    task_lns: _sov_list_new()
    task_user: _sov_list_new()
    lns: pre_lns
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    tops_lns: _sov_list_new()
    tops_users: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    # unsafe-module
    # single-pass parse: the old header-counting pre-walk (18 rows) is gone;
    # capacity is over-allocated to the line count + slack. Saves a full
    # is_task_hdr pass over every line on every compile (parse is the largest
    # single phase on the compiler-scale lane).
    pcap: _sov_list_len(lns) + 8
    names_buf: _sov_heap_alloc(16 + pcap * 8)
    poke_i64(names_buf, 0, pcap)
    bodies_buf: _sov_heap_alloc(16 + pcap * 8)
    poke_i64(bodies_buf, 8, 0)
    bodyln_buf: _sov_heap_alloc(16 + pcap * 8)
    poke_i64(bodyln_buf, 8, 0)
    #
    names_n: 0
    li: 0
    ln_n: peek_i64(lns, 8)
    as long as li < ln_n
        raw: peek_i64(lns, 16 + li * 8)
        c0n0: nind(raw)
        s: raw
        th: 0
        if c0n0 is 0
            s: strip(raw)
            if is_task_hdr(s) is 1
                th: 1
        if th is 1
            if in_t is 1
                bodies: _sov_list_add(bodies, cur)
                body_lns: _sov_list_add(body_lns, cur_ln)
            tn: tname(s)
            if zz_dup(tn) is 1
                print "Error: two with the same name"
                _sov_print(tn)
                err_line: file_ln(li)
                err_where()
                had_err: 1
            poke_i64(names_buf, 16 + names_n * 8, tn)
            names_n: names_n + 1
            poke_i64(names_buf, 8, names_n)
            names: names_buf
            params: _sov_list_add(params, tparams_g(th, s))
            tu: 0
            if li + 1 > src_base
                tu: 1
            task_user: _sov_list_add(task_user, tu)
            task_lns: _sov_list_add(task_lns, file_ln(li))
            cur: _sov_list_new()
            cur_ln: _sov_list_new()
            in_t: 1
        if not
            if c0n0 is 0
                gok: 0
                gc: find_col(s)
                if starts(s, "#") is 1
                    gok: 0
                    gc: 0 - 1
                if gc > 0
                    if gc < length(s) - 1
                        gok: 1
                if gok is 1
                    gn: blank
                    if starts(s, "<-- ") is 1
                        rest: cut(s, 4, length(s))
                        t: find_sep(rest)
                        if t > 0 - 1
                            gn: repl(strip(cut(rest, 0, t)), " ", "_")
                    if not
                        gn: repl(strip(cut(s, 0, gc)), " ", "_")
                    if length(gn) > 0
                        if gn_lookup(gn) is 0 - 1
                            glob_names: _sov_list_add(glob_names, gn)
                            sgin9: strip(cut(s, gc + 1, length(s)))
                            if peek_byte(sgin9, 0) is 34
                                if sg_lookup(gn) < 0
                                    sglob_names: _sov_list_add(sglob_names, gn)
                        if not
                            dupok: 1
                            if _sov_str_eq(gn, "heap_ptr") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "heap_end") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "g_slide") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "g_canary") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "g_argc") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "g_argv") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "pie_walk") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "sc_write") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "sc_exit") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "sc_mmap") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "mmap_flags") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "sc_mincore") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "sc_rand") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "sc_nodump") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "sc_sigact") is 1
                                dupok: 0
                            if _sov_str_eq(gn, "M32") is 1
                                dupok: 0
                            if dupok is 1
                                print "Error: duplicate top-level definition"
                                _sov_print(gn)
                                _sov_print(strip(raw))
                                err_line: file_ln(li)
                                print err_line
                                had_err: 1
                        sa: 0
                        if gc + 1 < length(s)
                            grhs: strip(cut(s, gc + 1, length(s)))
                            if _sov_str_eq(repl(grhs, " ", "_"), gn) is 1
                                sa: 1
                        if sa is 0
                            tops: _sov_list_add(tops, raw)
                            tops_lns: _sov_list_add(tops_lns, file_ln(li))
                            if li + 1 > src_base
                                tops_users: _sov_list_add(tops_users, 1)
                            if not
                                tops_users: _sov_list_add(tops_users, 0)
                if gok is 0
                    if length(s) > 0
                        if in_t is 1
                            if starts(s, "use ") is 0
                                if starts(s, "#") is 0
                                    print "Error: a statement inside a task must be indented"
                                    _sov_print(s)
                                    err_line: file_ln(li)
                                    print err_line
                                    had_err: 1
            if not
                if in_t is 1
                    law_handled: 0
                    if starts(s, "law ") is 1
                        law_handled: 1
                        law_body: strip(cut(s, 4, length(s)))
                        law_bln: length(law_body)
                        law_name: "unnamed"
                        law_cond: law_body
                        if _sov_byte_at(law_body, 0) is 34 is 1
                            law_q2: 0
                            law_qi: 1
                            as long as law_qi < law_bln
                                if _sov_byte_at(law_body, law_qi) is 34 is 1
                                    if law_q2 is 0
                                        law_q2: law_qi
                                law_qi: law_qi + 1
                            if law_q2 > 0
                                law_name: cut(law_body, 1, law_q2)
                                law_cond: strip(cut(law_body, law_q2 + 1, law_bln))
                        law_sp: 0 - 1
                        law_ci: 0
                        as long as law_ci < law_bln
                            if _sov_byte_at(law_body, law_ci) is 32 is 1
                                if law_sp < 0
                                    law_sp: law_ci
                            law_ci: law_ci + 1
                        if law_sp > 0
                            law_name: cut(law_body, 0, law_sp)
                            law_cond: strip(cut(law_body, law_sp, law_bln))
                        if length(law_cond) is 0
                            print "Error: law expects a name and a condition"
                            law_handled: 0 - 1
                        law_ind: cut(raw, 0, length(raw) - length(s))
                        law_ln: file_ln(li)
                        cur: _sov_list_add(cur, law_ind)
                        cur_ln: _sov_list_add(cur_ln, law_ln)
                        cur: _sov_list_add(cur, str_cat(law_ind, str_cat("if ", str_cat(law_cond, " is 0"))))
                        cur_ln: _sov_list_add(cur_ln, law_ln)
                        cur: _sov_list_add(cur, str_cat(law_ind, str_cat("    print \"LAW VIOLATED: ", str_cat(law_name, "\""))))
                        cur_ln: _sov_list_add(cur_ln, law_ln)
                        cur: _sov_list_add(cur, str_cat(law_ind, str_cat("    print ", i2s(law_ln))))
                        cur_ln: _sov_list_add(cur_ln, law_ln)
                        if kern_mode is 1
                            cur: _sov_list_add(cur, str_cat(law_ind, "    as long as 1 is 1"))
                            cur_ln: _sov_list_add(cur_ln, law_ln)
                            cur: _sov_list_add(cur, str_cat(law_ind, "        hlt()"))
                            cur_ln: _sov_list_add(cur_ln, law_ln)
                        if kern_mode is 0
                            cur: _sov_list_add(cur, str_cat(law_ind, "    sys_exit(232)"))
                            cur_ln: _sov_list_add(cur_ln, law_ln)
                        if starts(cut(raw, 0, length(raw) - length(s)), "        ") is 1
                            dummy_dp: 0
                    if law_handled is 0
                        cur: _sov_list_add(cur, raw)
                        cur_ln: _sov_list_add(cur_ln, file_ln(li))
        li: li + 1
    if in_t is 1
        bodies: _sov_list_add(bodies, cur)
        body_lns: _sov_list_add(body_lns, cur_ln)
    build_ret_par()
    st_build()
    rpx_tg: rpp_repeat_prepass()
    dce_prune()
    e: _sov_list_len(pre_lns)

    # Entry task selection: `main` is the program entry task.  Programs that
    # do not define main fall back to the first user-defined task below.
    entry_idx: nm_lookup("main")
    entry_nm: blank
    if entry_idx < 0
        ei: 0
        as long as ei < _sov_list_len(names)
            if peek_i64(task_user, 16 + ei * 8) is 1
                entry_idx: ei
                leave
            ei: ei + 1
    if entry_idx < 0
        if _sov_list_len(names) > 0
            entry_idx: 0
        if not
            print "Error: no task to run"
            fail()
    entry_nm: peek_i64(names, 16 + entry_idx * 8)
    want_args: 0
    if look(source, "g_argc") > 0 - 1
        want_args: 1
    if need_priv is 1
        want_args: 1
    has_vm: 0
    if look(source, "task _sov_alloc") > 0 - 1
        has_vm: 1
    if look(source, "_sov_alloc size:") > 0 - 1
        has_vm: 1
    # --unsafe drops the trap checks (overflow, div, memory) from
    # codegen via opt_nochk; it does NOT select has_vm, whose other
    # paths (heap-based print, peek fusions, try_mem) assume the
    # program provides a runtime. checked codegen stays the default;
    # wrap_* builtins cover wrapping arithmetic inside checked mode.
    if unsafe_mode is 1
        opt_nochk: 1
    if dp_e_hit is 0
        prep_main(names, params, bodies)
    gcap: 16
    as long as gcap < _sov_list_len(glob_names) * 2 + 2
        gcap: gcap + gcap
    gh: _sov_heap_alloc(gcap * 8)
    dummy: _sov_bzero(gh, gcap * 8)
    gi: 0
    as long as gi < _sov_list_len(glob_names)
        sgn: peek_i64(glob_names, 16 + gi * 8)
        dummy: set_add(gh, gcap, sgn)
        gi: gi + 1
    pfn_n: _sov_list_len(bodies)
    pfn_b: _sov_heap_alloc(16 + pfn_n * 8 + 64)
    poke_i64(pfn_b, 0, pfn_n + 4)
    poke_i64(pfn_b, 8, pfn_n)
    dummy: _sov_bzero(pfn_b + 16, pfn_n * 8)
    fn_locs: pfn_b
    pfn_b2: _sov_heap_alloc(16 + pfn_n * 8 + 64)
    poke_i64(pfn_b2, 0, pfn_n + 4)
    poke_i64(pfn_b2, 8, pfn_n)
    dummy: _sov_bzero(pfn_b2 + 16, pfn_n * 8)
    fn_lord: pfn_b2
    if has_vm is 1
        glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_start()
        emit_alloc()
        emit_strlen()
        emit_streq()
        emit_print()
        emit_print_int()
        thin_main: 0
    if not
        if thin_main is 0
            emit_start()
        if thin_main is 1
            if sxe_mode is 1
                emit_start()
            if not
                emit_pie_walk()
                emit(233)
                tjmp: here()
                emit4(0)
                addp(tjmp, "rel", entry_nm)
    mark("c0-parsed")
    walk_lo: 0
    walk_hi: _sov_list_len(names)
    par_live: 0
    par_do: 0
    par_child: 0
    dummy: par_setup()
    par_again: 1
    as long as par_again is 1
        par_again: 0
        dummy: flor_range(walk_lo, walk_hi, gh, gcap)
        build_del_map()
        bd0: build_inl_set()
        dummy: fsem_build()
        dummy: walk_range(walk_lo, walk_hi)
        if par_child is 1
            poke_i64(par_pool, 160, band(had_err, 1))
            par_export()
            if par_err is 1
                syscall(60, 99, 0)
            syscall(60, 0, 0)
        if not
            if par_live is 1
                pm_t1: pm_ms()
                pm_note3("T0=", pm_t0)
                par_redo_from: par_merge()
                par_live: 0
                par_do: 0
                if par_redo_from > 0 - 1
                    par_again: 1
                    walk_lo: par_redo_from
                    walk_hi: _sov_list_len(names)
    mark("p-wend")
    if has_vm is 0
        emit_used()
    if can_used is 1
        emit_canary_fail()
    if need_priv is 1
        emit_crash_handler()
    if kern_mode is 1
        emit_tswitch()
    # warn_unused call removed: its only outputs were under a literal `if 0`
    # (never-printed warnings); w_hit/w_built feed nothing else. pure dead pass.
    wbuf_flush()
    pk_sync()
    mark("p-dce")
    if opt_dce is 1
        dce()
    mark("p-stub")
    if sxe_mode is 0
        stub_diet()
    mark("p-post")
    dce_stores()
    dce_litter()
    dce_globals()
emit_tswitch:
    fn_names: _sov_list_add(fn_names, "_t_switch")
    fn_offs: _sov_list_add(fn_offs, here())
    emit(80)
    emit(81)
    emit(82)
    emit(86)
    emit(87)
    emit(65)
    emit(80)
    emit(65)
    emit(81)
    emit(65)
    emit(82)
    emit(65)
    emit(83)
    emit(83)
    emit(85)
    emit(65)
    emit(84)
    emit(65)
    emit(85)
    emit(65)
    emit(86)
    emit(65)
    emit(87)
    emit(72)
    emit(139)
    emit(68)
    emit(36)
    emit(80)
    emit(72)
    emit(137)
    emit(32)
    emit(72)
    emit(139)
    emit(68)
    emit(36)
    emit(88)
    emit(72)
    emit(139)
    emit(32)
    emit(65)
    emit(95)
    emit(65)
    emit(94)
    emit(65)
    emit(93)
    emit(65)
    emit(92)
    emit(93)
    emit(91)
    emit(65)
    emit(91)
    emit(65)
    emit(90)
    emit(65)
    emit(89)
    emit(65)
    emit(88)
    emit(95)
    emit(94)
    emit(90)
    emit(89)
    emit(88)
    emit(195)
stub_diet:
    if had_err is 1
        return
    if want_args is 0
        return
    if need_priv is 1
        return
    # kind dispatch runs on the interned kid pointers; re-intern if the
    # kid list ever diverges from patch_at (same defensive rule as the
    # 5b patch pass in write_elf).
    sd_n: _sov_list_len(patch_at)
    sd_kok: 0
    if patch_kid is not 0
        if _sov_list_len(patch_kid) is sd_n
            sd_kok: 1
    if sd_kok is 0
        patch_kid: _sov_list_new()
        sd_j: 0
        as long as sd_j < sd_n
            patch_kid: _sov_list_add(patch_kid, intern_kid(peek_i64(patch_kind, 16 + sd_j * 8)))
            sd_j: sd_j + 1
    sd_g: intern_kid("glob")
    sd_gr: intern_kid("grel")
    sd_live: 0
    sd_i: 0
    as long as sd_i < sd_n
        sd_at2: peek_i64(patch_at, 16 + sd_i * 8)
        if sd_at2 >= 41
            sd_kd: peek_i64(patch_kid, 16 + sd_i * 8)
            if sd_kd is sd_g
                sd_v: peek_i64(patch_val, 16 + sd_i * 8)
                if _sov_str_eq(sd_v, "g_argc") is 1
                    sd_live: 1
                    sd_i: sd_n
                if _sov_str_eq(sd_v, "g_argv") is 1
                    sd_live: 1
                    sd_i: sd_n
            if sd_kd is sd_gr
                sd_v: peek_i64(patch_val, 16 + sd_i * 8)
                if _sov_str_eq(sd_v, "g_argc") is 1
                    sd_live: 1
                    sd_i: sd_n
                if _sov_str_eq(sd_v, "g_argv") is 1
                    sd_live: 1
                    sd_i: sd_n
        sd_i: sd_i + 1
    if sd_live is 1
        return
    sd_cut_at: 0
    sd_cut: 41
    if main_params_n > 0
        sd_cut_at: 15
        sd_cut: 26
    # in-place compaction of the five parallel patch lists: same kept
    # records in the same order (at<cut_at verbatim, at>=41 shifted by
    # -sd_cut, the [cut_at,41) span dropped), lengths reseated at end.
    sd_w: 0
    sd_i: 0
    as long as sd_i < sd_n
        sd_at: peek_i64(patch_at, 16 + sd_i * 8)
        sd_keep: 0
        sd_na2: sd_at
        if sd_at < sd_cut_at
            sd_keep: 1
        if sd_at >= 41
            sd_keep: 1
            sd_na2: sd_at - sd_cut
        if sd_keep is 1
            if sd_w is not sd_i
                poke_i64(patch_kind, 16 + sd_w * 8, peek_i64(patch_kind, 16 + sd_i * 8))
                poke_i64(patch_kid, 16 + sd_w * 8, peek_i64(patch_kid, 16 + sd_i * 8))
                poke_i64(patch_val, 16 + sd_w * 8, peek_i64(patch_val, 16 + sd_i * 8))
                poke_i64(patch_line, 16 + sd_w * 8, peek_i64(patch_line, 16 + sd_i * 8))
            poke_i64(patch_at, 16 + sd_w * 8, sd_na2)
            sd_w: sd_w + 1
        sd_i: sd_i + 1
    poke_i64(patch_at, 8, sd_w)
    poke_i64(patch_kind, 8, sd_w)
    poke_i64(patch_kid, 8, sd_w)
    poke_i64(patch_val, 8, sd_w)
    poke_i64(patch_line, 8, sd_w)
    # delete the stub bytes with one forward block copy (dst < src)
    # instead of rebuilding the whole code buffer as a byte list.
    dummy: _sov_blit(oc + sd_cut_at, oc + sd_cut_at + sd_cut, oc_n - sd_cut_at - sd_cut)
    oc_n: oc_n - sd_cut
    sd_i: 0
    as long as sd_i < _sov_list_len(fn_offs)
        poke_i64(fn_offs, 16 + sd_i * 8, peek_i64(fn_offs, 16 + sd_i * 8) - sd_cut)
        sd_i: sd_i + 1
    want_args: 0
poke2 p off v:
    dummy: _sov_set_byte(p, off, v % 256)
    dummy: _sov_set_byte(p, off + 1, (v / 256) % 256)
write_elf path:
    if had_err is 1
        return
    if opt_tiny is 1
        if sxe_mode is 0
            HDR: 232
    clen: oc_n
    sl: _sov_buf_len(strb)
    gfoff: HDR + clen
    padto: 4096
    if gfoff < 65536
        padto: 16
    gfoff: gfoff + (padto - gfoff % padto) % padto
    dva: 4096 - gfoff % 4096
    if dva is 4096
        dva: 0
    dva: dva + gfoff % 4096
    if sxe_compact is 1
        if gfoff < 16384
            gfoff: 16384
        if gfoff > 16384
            print "Error: compact SXE program exceeds the 4-page code profile; split the application or build a full profile"
            fail()
    sl8: sl
    as long as sl8 % 8 is not 0
        sl8: sl8 + 1
    str_off: gfoff - HDR
    str_foff: gfoff
    str_addr: BASE + dva + gfoff
    rel_off: gfoff + sl8
    rel_n: 0
    rc_n: _sov_list_len(patch_at)
    rc_kok: 0
    if patch_kid is not 0
        if _sov_list_len(patch_kid) is rc_n
            rc_kok: 1
    rk_fa: 0
    rk_str: 0
    rk_gl: 0
    rk_gw: 0
    rk_gp: 0
    rk_sb: 0
    if rc_kok is 1
        rk_fa: intern_kid("fnaddr")
        rk_str: intern_kid("str")
        rk_gl: intern_kid("glob")
        rk_gw: intern_kid("gwstr_a")
        rk_gp: intern_kid("gwipe_a")
        rk_sb: intern_kid("sbss")
    rc_i: 0
    as long as rc_i < rc_n
        if rc_kok is 1
            rkd: peek_i64(patch_kid, 16 + rc_i * 8)
            if rkd is rk_fa
                rel_n: rel_n + 1
            if rkd is rk_str
                rel_n: rel_n + 1
            if rkd is rk_gl
                rel_n: rel_n + 1
            if rkd is rk_gw
                rel_n: rel_n + 1
            if rkd is rk_gp
                rel_n: rel_n + 1
            if rkd is rk_sb
                rel_n: rel_n + 1
        if rc_kok is 0
            rk: peek_i64(patch_kind, 16 + rc_i * 8)
            if _sov_str_eq(rk, "fnaddr") is 1
                rel_n: rel_n + 1
            if _sov_str_eq(rk, "str") is 1
                rel_n: rel_n + 1
            if _sov_str_eq(rk, "glob") is 1
                rel_n: rel_n + 1
            if _sov_str_eq(rk, "gwstr_a") is 1
                rel_n: rel_n + 1
            if _sov_str_eq(rk, "gwipe_a") is 1
                rel_n: rel_n + 1
            if _sov_str_eq(rk, "sbss") is 1
                rel_n: rel_n + 1
        rc_i: rc_i + 1
    relsz: 8 + rel_n * 8
    glob_off: rel_off + relsz - HDR
    pad: _sov_list_len(glob_names) * 8
    filesz: rel_off + relsz + pad
    flat: _sov_heap_alloc(filesz + 64)
    dummy: _sov_bzero(flat, filesz + 64)
    i: 0
    as long as i + 8 <= 0
        dummy: poke_i64(flat, i, 0)
        i: i + 8
    dummy: _sov_set_byte(flat, 0, 127)
    dummy: _sov_set_byte(flat, 1, 69)
    dummy: _sov_set_byte(flat, 2, 76)
    dummy: _sov_set_byte(flat, 3, 70)
    dummy: _sov_set_byte(flat, 4, 2)
    dummy: _sov_set_byte(flat, 5, 1)
    dummy: _sov_set_byte(flat, 6, 1)
    poke2(flat, 16, 3)
    poke2(flat, 18, 62)
    poke4(flat, 20, 1)
    moff: 0
    if thin_main is 1
        mi: fn_lookup(entry_nm)
        if mi > 0 - 1
            moff: peek_i64(fn_offs, 16 + mi * 8)
    poke8(flat, 24, BASE + HDR)
    poke8(flat, 32, 64)
    poke2(flat, 52, 64)
    poke2(flat, 54, 56)
    poke2(flat, 56, 4)
    if HDR is 232
        poke2(flat, 56, 3)
    poke4(flat, 64, 1)
    poke8(flat, 80, BASE)
    poke8(flat, 88, BASE)
    poke8(flat, 96, gfoff)
    sbtot: 0
    sw: 0
    as long as sw < _sov_list_len(sbss_sizes)
        swv: _sov_list_get(sbss_sizes, sw)
        sbtot: sbtot + 15
        sbtot: sbtot - sbtot % 16
        sbtot: sbtot + swv
        sw: sw + 1
    poke4(flat, 68, 5)
    poke8(flat, 104, gfoff)
    poke8(flat, 112, 4096)
    poke4(flat, 120, 1)
    poke4(flat, 124, 6)
    poke8(flat, 128, gfoff)
    poke8(flat, 136, BASE + dva + gfoff)
    poke8(flat, 144, BASE + dva + gfoff)
    poke8(flat, 152, sl8 + relsz + pad)
    poke8(flat, 160, sl8 + relsz + pad + sbtot)
    poke8(flat, 168, 4096)
    # CET/IBT ELF layout (PS9): ehdr + 4 phdrs end at 288; the GNU property
    # note sits at 288..319; program text starts at HDR=320. phdr[2] is an
    # explicit PT_GNU_STACK (RW, non-exec): without it some kernels grant
    # an executable stack. It replaced a PT_NOTE alias of the property
    # note - the kernel reads IBT state via phdr[3] PT_GNU_PROPERTY, so
    # the alias was redundant; same phdr count, same 320-byte header.
    poke4(flat, 176, 1685382481)
    poke4(flat, 180, 6)
    poke8(flat, 184, 0)
    poke8(flat, 192, 0)
    poke8(flat, 200, 0)
    poke8(flat, 208, 0)
    poke8(flat, 216, 0)
    poke8(flat, 224, 16)
    if HDR is 320
        poke4(flat, 232, 1685382483)
        poke4(flat, 236, 4)
        poke8(flat, 240, 288)
        poke8(flat, 248, BASE + 288)
        poke8(flat, 256, BASE + 288)
        poke8(flat, 264, 32)
        poke8(flat, 272, 32)
        poke8(flat, 280, 8)
        poke4(flat, 288, 4)
        poke4(flat, 292, 16)
        poke4(flat, 296, 5)
        poke_byte(flat, 300, 71)
        poke_byte(flat, 301, 78)
        poke_byte(flat, 302, 85)
        poke_byte(flat, 303, 0)
        poke4(flat, 304, 3221225474)
        poke4(flat, 308, 4)
        poke4(flat, 312, 1)
        poke4(flat, 316, 0)
    i: 0
    dummy: _sov_blit(flat + HDR, oc, clen)
    i: clen
    si: 0
    dummy: _sov_blit(flat + str_foff, strb + 16, sl)
    si: sl
    dummy: i
    glob_addr: BASE + dva + HDR + glob_off
    rel_at: 0
    i: 0
    # intern the patch-kind set once per call; dispatch then runs on ints.
    kg_rel: intern_kid("rel")
    kg_fnaddr: intern_kid("fnaddr")
    kg_str: intern_kid("str")
    kg_strrel: intern_kid("strrel")
    kg_str32: intern_kid("str32")
    kg_sbss: intern_kid("sbss")
    kg_grel: intern_kid("grel")
    kg_glob: intern_kid("glob")
    kg_gwstr_a: intern_kid("gwstr_a")
    kg_gwstr_n: intern_kid("gwstr_n")
    kg_gwipe_a: intern_kid("gwipe_a")
    kg_gwipe_n: intern_kid("gwipe_n")
    kg_rel_a: intern_kid("rel_a")
    kg_rel_n: intern_kid("rel_n")
    kg_rel_l: intern_kid("rel_l")
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        # per-record list_get calls inlined: ~50k records x 2 interpreted calls
        kind: peek_i64(patch_kid, 16 + i * 8)
        val: peek_i64(patch_val, 16 + i * 8)
        if at < 0
            print kind
        if at < 0
            print i
        if kind is kg_rel
            fi: fn_lookup(val)
            if fi > 0 - 1
                tgt: peek_i64(fn_offs, 16 + fi * 8)
                rel: tgt - (at + 4)
                poke4(flat, HDR + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                err_line: _sov_list_get(patch_line, i)
                err_where()
                suggest_name(val)
                had_err: 1
        # first-char dispatch: ~50k records used to run up to 11 full strcmps
        # each; the byte test rejects a whole group for one interpreted step.
        if peek_byte(kind, 0) is 102
            if kind is kg_fnaddr
                fi: fn_lookup(val)
                if fi > 0 - 1
                    poke8(flat, HDR + at, BASE + HDR + _sov_list_get(fn_offs, fi))
                    rel_at: _sov_list_add(rel_at, at)
                if not
                    print "Error: no such task"
                    _sov_print(val)
                    had_err: 1
        if peek_byte(kind, 0) is 115
            if kind is kg_str
                poke8(flat, HDR + at, str_addr + val)
                rel_at: _sov_list_add(rel_at, at)
            if kind is kg_strrel
                poke4(flat, HDR + at, str_addr + val - (BASE + HDR + at + 4))
            if kind is kg_str32
                poke4(flat, HDR + at, str_addr + val)
            if kind is kg_sbss
                bi: _sov_atoi(val)
                baddr: glob_addr + _sov_list_len(glob_names) * 8
                bj: 0
                as long as bj < bi
                    bs: _sov_list_get(sbss_sizes, bj)
                    baddr: baddr + 15
                    baddr: baddr - baddr % 16
                    baddr: baddr + bs
                    bj: bj + 1
                baddr: baddr + 15
                baddr: baddr - baddr % 16
                poke8(flat, HDR + at, baddr)
                rel_at: _sov_list_add(rel_at, at)
        if peek_byte(kind, 0) is 103
            if kind is kg_grel
                gx: gn_lookup(val)
                poke4(flat, HDR + at, glob_addr + gx * 8 - (BASE + HDR + at + 4))
            if kind is kg_glob
                gx: gn_lookup(val)
                poke8(flat, HDR + at, glob_addr + gx * 8)
                rel_at: _sov_list_add(rel_at, at)
            if kind is kg_gwstr_a
                poke8(flat, HDR + at, str_addr)
                rel_at: _sov_list_add(rel_at, at)
            if kind is kg_gwstr_n
                poke4(flat, HDR + at, (sl + 7) / 8)
            if kind is kg_gwipe_a
                poke8(flat, HDR + at, glob_addr)
                rel_at: _sov_list_add(rel_at, at)
            if kind is kg_gwipe_n
                gbytes: _sov_list_len(glob_names) * 8 + sbtot
                poke4(flat, HDR + at, (gbytes + 7) / 8)
        i: i + 1
    mark("5a-flat0")
    if had_err is 1
        return
    if rel_n > 0
        poke8(flat, rel_off, rel_n)
        ri: 0
        as long as ri < rel_n
            poke8(flat, rel_off + 8 + ri * 8, HDR + peek_i64(rel_at, 16 + ri * 8))
            ri: ri + 1
    if 1 is 1
        sxi: 0
        sxi_ln: _sov_list_len(patch_at)
        # patch_kid holds the interned int for every record (built in the
        # first patch pass above); read ints instead of str_eq probes.
        if _sov_list_len(patch_kid) is not sxi_ln
            # defensive: whenever the tables diverge, re-intern on the spot.
            patch_kid: _sov_list_new()
            sxi2: 0
            as long as sxi2 < sxi_ln
                patch_kid: _sov_list_add(patch_kid, intern_kid(peek_i64(patch_kind, 16 + sxi2 * 8)))
                sxi2: sxi2 + 1
        as long as sxi < sxi_ln
            kd3: peek_i64(patch_kid, 16 + sxi * 8)
            if kd3 is kg_rel_a
                poke8(flat, HDR + peek_i64(patch_at, 16 + sxi * 8), BASE + dva + rel_off)
            if kd3 is kg_rel_n
                poke4(flat, HDR + peek_i64(patch_at, 16 + sxi * 8), rel_n)
            if kd3 is kg_rel_l
                poke8(flat, HDR + peek_i64(patch_at, 16 + sxi * 8), gfoff)
            sxi: sxi + 1
    mark("5b-pat")
    gsx: gn_lookup("g_slide")
    if gsx > 0 - 1
        poke8(flat, rel_off + relsz + gsx * 8, glob_addr + gsx * 8)
    if sxe_mode is 1
        sx_data_extra: sbtot + 65536
        if sxe_compact is 1
            sx_data_extra: sbtot
        sx_data_end: 4096 + filesz + sx_data_extra
        sx_rel_off: sx_data_end
        as long as sx_rel_off % 4096 is not 0
            sx_rel_off: sx_rel_off + 1
        sx_rel_len: rel_n * 24
        sx_count: 2
        sx_total: sx_data_end
        if rel_n > 0
            sx_count: 3
            sx_total: sx_rel_off + sx_rel_len
        sx: _sov_heap_alloc(sx_total)
        sxz: 0
        as long as sxz < sx_total
            dummy: _sov_bzero(sx, sx_total)
        sxz: sx_total
            sxz: sxz + 1
        poke8(sx, 0, 4544595)
        poke8(sx, 8, 1)
        poke8(sx, 16, 4096 + HDR)
        poke8(sx, 24, sx_count)
        poke8(sx, 32, 1)
        poke8(sx, 40, 4096)
        poke8(sx, 48, gfoff)
        poke8(sx, 56, 3)
        poke8(sx, 64, 4096 + gfoff)
        poke8(sx, 72, filesz - gfoff + sx_data_extra)
        if rel_n > 0
            poke8(sx, 80, 4)
            poke8(sx, 88, sx_rel_off)
            poke8(sx, 96, sx_rel_len)
        sxi2: 0
        as long as sxi2 < filesz
            dummy: _sov_blit(sx + 4096, flat, filesz)
        sxi2: filesz
            sxi2: sxi2 + 1
        sri: 0
        as long as sri < rel_n
            sat: _sov_list_get(rel_at, sri)
            sval: peek_raw64(flat + HDR + sat, 0)
            poke8(sx, sx_rel_off + sri * 24, 4096 + HDR + sat)
            poke8(sx, sx_rel_off + sri * 24 + 8, 4096 + sval - BASE)
            poke8(sx, sx_rel_off + sri * 24 + 16, 1)
            sri: sri + 1
        w: _sov_write_n(path, sx, sx_total)
        if w is 0
            print "Error: cannot write SXE image"
            fail()
        _sov_chmod(path, 493)
        return
    if kern_mode is 1
        w: _sov_write_n(path, flat, filesz)
        if w is 0
            print "Error: cannot write kernel image"
            fail()
        _sov_chmod(path, 493)
        return
    w: _sov_write_n(path, flat, filesz)
    if w is 0
        print "Error: cannot write output (is it running?)"
        fail()
    if need_priv is 1
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
indent_of t:
    n: length(t)
    i: 0
    w: 0
    as long as i < n
        b: peek_byte(t, i)
        if b is 32
            w: w + 1
        if not
            if b is 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w
strip_trail t:
    n: length(t)
    as long as n > 0
        b: peek_byte(t, n - 1)
        if b is 32
            n: n - 1
        if not
            if b is 9
                n: n - 1
            if not
                return cut(t, 0, n)
    return blank
space_make n:
    s: blank
    i: 0
    as long as i < n
        s: join(s, " ")
        i: i + 1
    return s
fmt_file path:
    s: load_file(path)
    if s is 0
        print "Error: cannot read input"
        fail()
    ls: lines_of(s)
    n2: 0
    n4: 0
    i: 0
    i_ln: _sov_list_len(ls)
    as long as i < i_ln
        ind: indent_of(peek_i64(ls, 16 + i * 8))
        if ind > 1
            if ind % 4 is 0
                n4: n4 + 1
            if not
                n2: n2 + 1
        i: i + 1
    unit: 4
    if n2 > n4
        unit: 2
    i: 0
    out: blank
    i_ln: _sov_list_len(ls)
    as long as i < i_ln
        t: peek_i64(ls, 16 + i * 8)
        t: strip_trail(t)
        ind: indent_of(t)
        if ind > 0
            rest: cut(t, ind, length(t))
            q: ind / unit
            if (ind % unit) * 2 >= unit
                q: q + 1
            if q < 1
                q: 1
            t: join(space_make(q * unit), rest)
        if i is 0
            out: t
        if not
            out: join(join(out, "\n"), t)
        i: i + 1
    mark("5c-prewrite")
    if file_write_all(path, out) is 0
        print "Error: cannot write"
        _sov_print(path)
        fail()
    print "Formatted"
    _sov_print(path)
    return 1
run_prog path argv argc:
    pid: sys_fork()
    if pid is 0
        argv2: _sov_heap_alloc(512)
        poke_i64(argv2, 0, path)
        k: 1
        i: 1
        as long as i < argc
            a: peek_ptr(argv, i)
            keep: 1
            if _sov_str_eq(a, "-o") is 1
                keep: 0
                i: i + 1
            if not
                if _sov_str_eq(a, "--run") is 1
                    keep: 0
                if not
                    if _sov_str_eq(a, "--fmt") is 1
                        keep: 0
                    if not
                        if _sov_str_eq(a, "--debug") is 1
                            keep: 0
                        if not
                            if _sov_str_eq(a, "--flat") is 1
                                keep: 0
                            if _sov_str_eq(a, "--bare") is 1
                                keep: 0
                            if not
                                if _sov_str_eq(a, path) is 1
                                    keep: 0
            if keep is 1
                poke_i64(argv2, k * 8, a)
                k: k + 1
            i: i + 1
        poke_i64(argv2, k * 8, 0)
        sys_exec(path, argv2, 0)
        sys_exit(127)
    w: sys_wait(pid)
    sys_exit(w / 256)
all: 0
bodies: 0
dp_e_hit: 0
fn_locs: 0
lord_fcnt: 0
fn_lord: 0
floc_c: 0
floc_ln: 0
floc_a: 0
floc_b: 0
floc_ep: 0
floc_ce: 0
floc_cap: 0
floc_epoch: 0
params: 0
tco_entry: 0
tco_nm: 0
tco_ps: 0
pd_adj: 0
pd_cap: 0
pd_key: 0
pd_lib: 0
pd_mark: 0
pd_nd: 0
pd_nm: 0
pd_off: 0
pd_pu: 0
pd_pz: 0
pd_report: 0
pd_ui: 0
pd_ul: 0
pd_ull: 0
pd_usp: 0
pd_ut: 0
pd_val: 0
pd_wt: 0
pro_at: 0
prof_buf: 0
prof_t0: 0
snap_a: 0
snap_m: 0
tops: 0
tops_lns: 0

# ---- WP1 in-process phase clock: --prof prints label then microseconds since
#      the previous mark.  syscall 228 is clock_gettime(CLOCK_MONOTONIC).
prof_mode: 0 
now_ns:
    if prof_buf is 0
        prof_buf: _sov_alloc(64)
    dummy: syscall(228, 1, prof_buf, 0, 0, 0, 0)
    s: peek_i64(prof_buf, 0)
    n: peek_i64(prof_buf, 8)
    return s * 1000000000 + n
mark label:
    if prof_mode is 0
        return 0
    t: now_ns()
    if prof_t0 is 0
        prof_t0: t
        if prof_marks is 0
            prof_marks: _sov_heap_alloc(18432)
        if prof_last is 0
            prof_last: _sov_heap_alloc(48)
        ci: 0
        as long as ci < 6
            poke_i64(prof_last, ci * 8, prof_value(ci))
            ci: ci + 1
        return t
    dt: t - prof_t0
    pi: 0
    as long as pi < prof_mark_n
        if _sov_str_eq(peek_i64(prof_marks, pi * 72), label) is 1
            poke_i64(prof_marks, pi * 72 + 8, peek_i64(prof_marks, pi * 72 + 8) + dt)
            poke_i64(prof_marks, pi * 72 + 16, peek_i64(prof_marks, pi * 72 + 16) + 1)
            prof_capture(pi * 72, 0)
            prof_t0: now_ns()
            return t
        pi: pi + 1
    if prof_mark_n >= 256
        print "Error: profile mark table full"
        fail()
    poke_i64(prof_marks, prof_mark_n * 72, label)
    poke_i64(prof_marks, prof_mark_n * 72 + 8, dt)
    poke_i64(prof_marks, prof_mark_n * 72 + 16, 1)
    prof_capture(prof_mark_n * 72, 1)
    prof_mark_n: prof_mark_n + 1
    prof_t0: now_ns()
    return t

prof_marks: 0
prof_mark_n: 0
prof_functions: 0
prof_input_bytes: 0
prof_report:
    if prof_mode is 0
        return 0
    prof_mode: 0
    txt: "{\"schema\":1,\"kind\":\"phase-endpoint-aggregates\",\"marks\":["
    pi: 0
    as long as pi < prof_mark_n
        if pi > 0
            txt: join(txt, ",")
        pl: peek_i64(prof_marks, pi * 72)
        pn: peek_i64(prof_marks, pi * 72 + 8)
        pc: peek_i64(prof_marks, pi * 72 + 16)
        txt: join(txt, "{\"endpoint\":\"")
        txt: join(txt, pl)
        txt: join(txt, "\",\"ns\":")
        txt: join(txt, i2s(pn))
        txt: join(txt, ",\"calls\":")
        txt: join(txt, i2s(pc))
        if prof_counter_active is 1
            txt: join(txt, ",\"counters\":{")
            ci: 0
            as long as ci < 6
                if ci > 0
                    txt: join(txt, ",")
                txt: join(txt, join("\"", join(prof_key(ci), "\":")))
                txt: join(txt, dbg_decimal(peek_i64(prof_marks, pi * 72 + 24 + ci * 8)))
                ci: ci + 1
            txt: join(txt, "}")
        txt: join(txt, "}")
        pi: pi + 1
    txt: join(txt, "],\"input_bytes\":")
    txt: join(txt, i2s(prof_input_bytes))
    txt: join(txt, ",\"functions_visited\":")
    txt: join(txt, i2s(prof_functions))
    txt: join(txt, ",\"emitted_bytes\":")
    txt: join(txt, i2s(oc_n))
    if syntax_mode > 0
        txt: join(txt, ",\"syntax_trees\":")
        txt: join(txt, dbg_decimal(syntax_trees))
        txt: join(txt, ",\"syntax_nodes\":")
        txt: join(txt, dbg_decimal(syntax_nodes))
        txt: join(txt, ",\"syntax_declines\":")
        txt: join(txt, dbg_decimal(syntax_declines))
        txt: join(txt, ",\"syntax_native_trees\":")
        txt: join(txt, dbg_decimal(syntax_native_trees))
        txt: join(txt, ",\"statement_trees\":")
        txt: join(txt, dbg_decimal(syntax_statement_trees))
        txt: join(txt, ",\"statement_native_trees\":")
        txt: join(txt, dbg_decimal(syntax_statement_native_trees))
        txt: join(txt, ",\"statement_nodes\":")
        txt: join(txt, dbg_decimal(syntax_statement_nodes))
        txt: join(txt, ",\"statement_roots_lowered\":")
        txt: join(txt, dbg_decimal(syntax_stmt_roots))
    txt: join(txt, ",\"instrumented\":")
    txt: join(txt, dbg_decimal(prof_counter_active))
    if prof_counter_active is 1
        txt: join(txt, ",\"counters\":{\"bytes_scanned\":")
        txt: join(txt, dbg_decimal(prof_bytes_scanned))
        txt: join(txt, ",\"bytes_copied\":")
        txt: join(txt, dbg_decimal(prof_bytes_copied))
        txt: join(txt, ",\"allocations\":")
        txt: join(txt, dbg_decimal(prof_allocations))
        txt: join(txt, ",\"allocation_requested_bytes\":")
        txt: join(txt, dbg_decimal(prof_alloc_bytes))
        txt: join(txt, ",\"hash_probes\":")
        txt: join(txt, dbg_decimal(prof_hash_probes))
        txt: join(txt, ",\"fallbacks\":")
        txt: join(txt, dbg_decimal(prof_fallbacks))
        txt: join(txt, "},\"counter_scope\":\"native-length-SWAR/vector-loads+native-intern-scans-and-probes;memcpy+native-concat+native-substring-copy-payloads;heap-allocator-entries;intern-slow-path-entries\",\"unavailable_counters\":[]}")
    if not
        txt: join(txt, ",\"unavailable_counters\":[\"bytes_scanned\",\"bytes_copied\",\"allocations\",\"hash_probes\",\"fallbacks\"]}")
    txt: join(txt, "\n")
    syscall(1, 2, txt, length(txt), 0, 0, 0)
    return 0

prv_imm b i n:
    j: i - 16
    as long as j < i
        if j >= 0
            if peek_byte(b, j) is 184
                v: peek_byte(b, j + 1) + peek_byte(b, j + 2) * 256 + peek_byte(b, j + 3) * 65536 + peek_byte(b, j + 4) * 16777216
                if v < 480
                    return v
        j: j + 1
    j: i - 8
    as long as j < i
        if j >= 0
            if peek_byte(b, j) is 176
                if peek_byte(b, j + 1) < 480
                    return peek_byte(b, j + 1)
        j: j + 1
    j: i + 2
    as long as j < i + 24
        if j + 9 < n
            if peek_byte(b, j) is 72
                if peek_byte(b, j + 1) is 184
                    v: peek_byte(b, j + 2) + peek_byte(b, j + 3) * 256 + peek_byte(b, j + 4) * 65536 + peek_byte(b, j + 5) * 16777216
                    if v < 480
                        return v
        j: j + 1
    return 0 - 1
prv_runlen b i n:
    l: 0
    as long as i + l < n
        c: peek_byte(b, i + l)
        if c < 32
            return l
        if c > 126
            return l
        l: l + 1
    return l
prv_chunk b i l:
    o: _sov_alloc(l + 2)
    j: 0
    as long as j < l
        poke_byte(o, j, peek_byte(b, i + j))
        j: j + 1
    poke_byte(o, l, 0)
    return as text o

# ---- cross-module DCE -------------------------------------------------------
# Reachability prune over the collected task lists. Roots = every task the
# user own file defines, plus the runtime allowlist; a task is
# kept when a kept task's source mentions its name at a word boundary (this
# covers direct calls, spawn targets and any address-taken use, because all
# of them spell the name in source). Over-approximation is the safe direction:
# worst case a task is kept that could have been dropped. Never removes code
# semantics: only whole tasks that nothing reachable can reach.
dce_prune:
    # post-parse duplicate rejection moved to the prune_dead def-walk
    # (shared/ccore.sov): the parser only sees pruned text, so this
    # task-level hook can never observe a duplicate. kept as a no-op.
    return 0
    # (old disabled prune body removed; line kept for span stability)
