# unsafe-module
# Compatibility facade for the physically organized native compiler core.
# unsafe-module
_sov_blit dst src n:
    # bulk copy: qword body + byte tail (grammar-safe: no one-line chains)
    i: 0
    as long as i + 8 <= n
        poke_i64(dst, i, peek_i64(src, i))
        i: i + 8
    as long as i < n
        poke_byte(dst, i, peek_byte(src, i))
        i: i + 1
    return 0
pic_in cur a:
    if length(cur) is 0
        return a
    return cur
pic_io cur out a:
    if length(cur) > 0
        return a
    return out
digitb b:
    if b >= 48
        if b <= 57
            return 1
    return 0
hexval s:
    # s like "0x1F" or "0b101" or decimal: returns numeric value.
    # Pure-decimal fast path (the hot case: every numeric atom in the
    # compiler's own source): accumulate while digits last; any other
    # byte (., x, b, -, letters) falls through to the full logic below,
    # so "12.5" -> 0, "0x.." and "-.." keep their exact meanings.
    hv0: peek_byte(s, 0)
    if hv0 > 47
        if hv0 < 58
            hvn: hv0 - 48
            hvi: 1
            hvgo: 1
            as long as hvgo is 1
                hvc: peek_byte(s, hvi)
                if hvc is 0
                    return hvn
                if hvc > 47
                    if hvc < 58
                        hvn: hvn * 10 + hvc - 48
                        hvi: hvi + 1
                    if not
                        hvgo: 0
                if not
                    hvgo: 0
    if cfind1(s, 46) > 0 - 1
        return 0
    n: 0
    i: 0
    if peek_byte(s, 0) is 45
        return 0 - _sov_atoi(cut(s, 1, length(s)))
    if _sov_starts_with(s, "0x") is 1
        i: 2
        hv_ln: length(s)
        as long as i < hv_ln
            c: peek_byte(s, i)
            v: 0 - 1
            if c > 47
                if c < 58
                    v: c - 48
            if v < 0
                if c > 96
                    if c < 103
                        v: c - 87
            if v < 0
                if c > 64
                    if c < 71
                        v: c - 55
            if v < 0
                return n
            n: n * 16 + v
            i: i + 1
        return n
    if _sov_starts_with(s, "0b") is 1
        i: 2
        hv_ln: length(s)
        as long as i < hv_ln
            c: peek_byte(s, i)
            if c is 48
                n: n * 2
            if c is 49
                n: n * 2 + 1
            i: i + 1
        return n
    return _sov_atoi(s)
num_of s:
    return hexval(s)
lines_of_fast source:
    n: length(source)
    if n is 0
        return _sov_list_new()
    flat: _sov_heap_alloc(n + 1)
    lst: _sov_heap_alloc(16 + (n + 1) * 8)
    dummy: poke_i64(lst, 0, n + 1)
    start: 0
    k: 0
    nlc: 72340172838076673 * 10
    i: 0
    # copy and split in one traversal: each qword is stored, then tested for a
    # newline with the usual haszero mask; only a qword that contains one pays
    # the per-byte walk.
    as long as i + 8 <= n
        q: peek_i64(source, i)
        dummy: poke_i64(flat, i, q)
        xq: bxor(q, nlc)
        m: band(band(xq - 72340172838076673, bxor(xq, 0 - 1)), -9187201950435737472)
        if m is not 0
            j: 0
            as long as j < 8
                if peek_byte(flat, i + j) is 10
                    dummy: poke_byte(flat, i + j, 0)
                    dummy: poke_i64(lst, 16 + k * 8, flat + start)
                    k: k + 1
                    start: i + j + 1
                j: j + 1
        i: i + 8
    as long as i < n
        qb: peek_byte(source, i)
        dummy: poke_byte(flat, i, qb)
        if qb is 10
            dummy: poke_byte(flat, i, 0)
            dummy: poke_i64(lst, 16 + k * 8, flat + start)
            k: k + 1
            start: i + 1
        i: i + 1
    dummy: poke_byte(flat, n, 0)
    if start < n
        dummy: poke_i64(lst, 16 + k * 8, flat + start)
        k: k + 1
    dummy: poke_i64(lst, 8, k)
    return lst
set_h s:
    # djb2 over the NUL-terminated bytes (same hash family as word_id).
    h: 5381
    i: 0
    n: length(s)
    as long as i < n
        h: h * 33 + peek_byte(s, i)
        i: i + 1
    return h

gn_tbl: 0
gn_cap: 0
gn_idx: 0
gn_ln: 0
gn_build:
    # fresh empty table sized for the current glob_names length.
    gn_cap: 16
    as long as gn_cap < _sov_list_len(glob_names) * 2 + 2
        gn_cap: gn_cap + gn_cap
    gn_tbl: _sov_heap_alloc(gn_cap * 8)
    gn_idx: _sov_heap_alloc(gn_cap * 8)
    dummy: _sov_bzero(gn_tbl, gn_cap * 8)
    dummy: _sov_bzero(gn_idx, gn_cap * 8)
    gn_ln: 0
gn_sync:
    # glob_names is append-only during a compile: insert just the new tail
    # entries instead of rebuilding the whole index after every growth.
    # Rebuild from scratch on first use, on shrink, or when outgrown.
    gn_nln: _sov_list_len(glob_names)
    if gn_tbl is 0
        gn_build()
    if gn_nln < gn_ln
        gn_build()
    if gn_nln * 2 + 2 > gn_cap
        gn_build()
    as long as gn_ln < gn_nln
        gn_s: peek_i64(glob_names, 16 + gn_ln * 8)
        gn_h: set_h(gn_s)
        gn_sl: band(gn_h, gn_cap - 1)
        as long as peek_i64(gn_tbl, gn_sl * 8) is not 0
            gn_sl: gn_sl + 1
            if gn_sl is gn_cap
                gn_sl: 0
        poke_i64(gn_tbl, gn_sl * 8, gn_s)
        poke_i64(gn_idx, gn_sl * 8, gn_ln)
        gn_ln: gn_ln + 1
gn_lookup nm:
    # open-addressed index lookup over glob_names.  Same answer as the
    # linear scan (first matching index, else -1): entries are inserted
    # in list order, so among equal names the lowest index probes first.
    if glob_names is 0
        return 0 - 1
    gn_sync()
    gn_h: set_h(nm)
    gn_sl: band(gn_h, gn_cap - 1)
    as long as 1 is 1
        gn_cur: peek_i64(gn_tbl, gn_sl * 8)
        if gn_cur is 0
            return 0 - 1
        if gn_cur is nm
            return peek_i64(gn_idx, gn_sl * 8)
        if _sov_str_eq(gn_cur, nm) is 1
            return peek_i64(gn_idx, gn_sl * 8)
        gn_sl: gn_sl + 1
        if gn_sl is gn_cap
            gn_sl: 0

