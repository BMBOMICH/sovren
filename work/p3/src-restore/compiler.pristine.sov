dce_refs_of i n ht:
    out: _sov_list_new()
    bl: _sov_list_get(bodies, i)
    lc: _sov_list_len(bl)
    li: 0
    as long as li < lc
        line: _sov_list_get(bl, li)
        lt: str_len(line)
        p: 0
        as long as p < lt
            c: peek_byte(line, p)
            wc: dce_wch(c)
            if wc is 1
                tk: dce_token(line, p, lt)
                p: p + str_len(tk)
                found: dce_htget(ht, tk)
                if found >= 0
                    out: _sov_list_add(out, found)
            if not
                p: p + 1
        li: li + 1
    return out
dce_wch c:
    d1: band(bshr(47 - c, 63), band(bshr(c - 58, 63), 1))
    d2: band(bshr(64 - c, 63), band(bshr(c - 91, 63), 1))
    d3: band(bshr(96 - c, 63), band(bshr(c - 123, 63), 1))
    d4: band(bshr(94 - c, 63), band(bshr(c - 96, 63), 1))
    o1: d1 + d2 - d1 * d2
    o2: o1 + d3 - o1 * d3
    return o2 + d4 - o2 * d4
dce_token line p lt:
    e: p
    as long as e < lt
        if dce_wch(peek_byte(line, e)) is 0
            return prv_cut2(line, p, e - p)
        e: e + 1
    return prv_cut2(line, p, lt - p)
prv_cut2 line p l:
    o: _sov_alloc(l + 2)
    j: 0
    as long as j < l
        poke_byte(o, j, peek_byte(line, p + j))
        j: j + 1
    poke_byte(o, l, 0)
    return as text o
dce_htget ht tk:
    sl: band(nhash(tk), 16383)
    as long as peek_i64(ht, sl * 16) is not 0
        if _sov_str_eq(peek_i64(ht, sl * 16), tk) is 1
            return peek_i64(ht, sl * 16 + 8)
        sl: sl + 1
        if sl is 16384
            sl: 0
    return 0 - 1
dce_word t nm:
    lt: str_len(t)
    ln2: str_len(nm)
    if lt < ln2
        return 0
    i: 0
    as long as i + ln2 <= lt
        aft: peek_byte(t, i + ln2)
        d1: band(bshr(47 - aft, 63), band(bshr(aft - 58, 63), 1))
        d2: band(bshr(64 - aft, 63), band(bshr(aft - 91, 63), 1))
        d3: band(bshr(96 - aft, 63), band(bshr(aft - 123, 63), 1))
        d4: band(bshr(47 - aft, 63), band(bshr(aft - 40, 63), 1))
        o1: d1 + d2 - d1 * d2
        o2: o1 + d3 - o1 * d3
        o3: o2 + d4 - o2 * d4
        bnd: 1
        if i > 0
            bef: peek_byte(t, i - 1)
            e1: band(bshr(47 - bef, 63), band(bshr(bef - 58, 63), 1))
            e2: band(bshr(64 - bef, 63), band(bshr(bef - 91, 63), 1))
            e3: band(bshr(96 - bef, 63), band(bshr(bef - 123, 63), 1))
            f1: e1 + e2 - e1 * e2
            bnd: 1 - (f1 + e3 - f1 * e3)
        hit: band(band(dce_eqat(t, nm, i), bnd), 1 - o3)
        if hit is 1
            return 1
        i: i + 1
    return 0
dce_eqat t nm at:
    ln2: str_len(nm)
    j: 0
    as long as j < ln2
        if peek_byte(t, at + j) is not peek_byte(nm, j)
            return 0
        j: j + 1
    return 1
rpx_nonspace s:
    i: 0
    as long as 1
        b: peek_byte(s, i)
        if b is 0
            return 0 - 1
        if b is not 32
            return i
        i: i + 1
rpp_repeat_prepass:
    f9: 0
    as long as f9 < _sov_list_len(bodies)
        bd: _sov_list_get(bodies, f9)
        bl9: _sov_list_get(body_lns, f9)
        i9: 0
        as long as i9 < _sov_list_len(bd)
            raw: _sov_list_get(bd, i9)
            fs9: rpx_nonspace(raw)
            st9: ""
            if fs9 > 0 - 1
                if _sov_byte_at(raw, fs9) is 114
                    if _sov_byte_at(raw, fs9 + 1) is 101
                        st9: strip(raw)
            if _sov_starts_with(st9, "repeat ") is 1
                ct9: strip(cut(st9, 7, length(st9)))
                tp9: look(ct9, " times")
                if tp9 > 0 - 1
                    ct9: strip(cut(ct9, 0, tp9))
                if length(ct9) is 0
                    print "Error: repeat needs a count"
                    err_line: _sov_list_get(bl9, i9)
                    err_where()
                    had_err: 1
                if not
                    ri9: rpx_nonspace(raw)
                    pr9: cut(raw, 0, ri9)
                    bi9: _sov_list_len(bd)
                    j9: i9 + 1
                    as long as j9 < bi9
                        r2: _sov_list_get(bd, j9)
                        if length(strip(r2)) > 0
                            if _sov_byte_at(strip(r2), 0) is not 35
                                if rpx_nonspace(r2) <= ri9
                                    bi9: j9
                                    j9: bi9
                        j9: j9 + 1
                    ln9: _sov_list_get(bl9, i9)
                    bp9: join(pr9, "    ")
                    if bi9 > i9 + 1
                        bp9: cut(_sov_list_get(bd, i9 + 1), 0, rpx_nonspace(_sov_list_get(bd, i9 + 1)))
                    rpx_n: rpx_n + 1
                    vn9: str_cat("__rp", rpx_dec(rpx_n))
                    nb: _sov_list_new()
                    nl9: _sov_list_new()
                    nb: _sov_list_add(nb, join(pr9, join(vn9, join(": ", ct9))))
                    nl9: _sov_list_add(nl9, ln9)
                    nb: _sov_list_add(nb, join(pr9, join("as long as ", join(vn9, " > 0"))))
                    nl9: _sov_list_add(nl9, ln9)
                    k9: i9 + 1
                    as long as k9 < bi9
                        nb: _sov_list_add(nb, _sov_list_get(bd, k9))
                        nl9: _sov_list_add(nl9, _sov_list_get(bl9, k9))
                        k9: k9 + 1
                    nb: _sov_list_add(nb, join(bp9, join(vn9, join(": ", join(vn9, " - 1")))))
                    nl9: _sov_list_add(nl9, ln9)
                    bd2: _sov_list_new()
                    bl2: _sov_list_new()
                    h9: 0
                    as long as h9 < i9
                        bd2: _sov_list_add(bd2, _sov_list_get(bd, h9))
                        bl2: _sov_list_add(bl2, _sov_list_get(bl9, h9))
                        h9: h9 + 1
                    h9: 0
                    as long as h9 < _sov_list_len(nb)
                        bd2: _sov_list_add(bd2, _sov_list_get(nb, h9))
                        bl2: _sov_list_add(bl2, _sov_list_get(nl9, h9))
                        h9: h9 + 1
                    h9: bi9
                    as long as h9 < _sov_list_len(bd)
                        bd2: _sov_list_add(bd2, _sov_list_get(bd, h9))
                        bl2: _sov_list_add(bl2, _sov_list_get(bl9, h9))
                        h9: h9 + 1
                    bodies: _sov_list_set(bodies, f9, bd2)
                    body_lns: _sov_list_set(body_lns, f9, bl2)
                    bd: bd2
                    bl9: bl2
                    i9: i9 + 1
            i9: i9 + 1
        f9: f9 + 1
    return 0

# Per-compilation primary text-type dependency graph. This is semantic state,
# not saved/replayed compilation output. Nodes are tasks and scoped variables;
# text literals/casts seed a worklist, reverse edges propagate forward types.
st_need: 0
st_edges: 0
st_done: 0
st_vars: 0
st_ids: 0
st_node kind:
    ix: _sov_list_len(st_need)
    st_need: _sov_list_add(st_need, kind)
    st_edges: _sov_list_add(st_edges, _sov_list_new())
    st_done: _sov_list_add(st_done, 0)
    return ix
st_var name:
    vi: list_idx(st_vars, name)
    if vi >= 0
        return peek_i64(st_ids, 16 + vi * 8)
    ni: st_node(0)
    st_vars: _sov_list_add(st_vars, name)
    st_ids: _sov_list_add(st_ids, ni)
    return ni
st_edge source target:
    cnt: peek_i64(st_need, 16 + target * 8)
    if cnt >= 0
        poke_i64(st_need, 16 + target * 8, cnt + 1)
    if source > 0
        adj: peek_i64(st_edges, 16 + source * 8)
        adj: _sov_list_add(adj, target)
        poke_i64(st_edges, 16 + source * 8, adj)
    return 0
st_expr e0 dep:
    if dep > 32
        return 0
    e: strip(e0)
    en: length(e)
    if is_lit(e) is 1
        return 1
    if starts(e, "as text ") is 1
        return 1
    if starts(e, "as ptr ") is 1
        return 1
    if en > 8
        if sg_match(e, en - 8, " as text") is 1
            return 1
    if en > 7
        if sg_match(e, en - 7, " as ptr") is 1
            return 1
    if en > 1
        if peek_byte(e, 0) is 40
            if licm2_match(e, 0) is en - 1
                return st_expr(cut(e, 1, en - 1), dep + 1)
    if expr_atom(e) is 1
        if digitb(peek_byte(e, 0)) is 1
            return 0
        vi: list_idx(st_vars, e)
        if vi >= 0
            return peek_i64(st_ids, 16 + vi * 8)
        if sg_lookup(e) >= 0
            return 1
        return 0
    lp: cfind1(e, 40)
    if lp > 0
        if licm2_match(e, lp) is en - 1
            nm: strip(cut(e, 0, lp))
            if expr_atom(nm) is 1
                if sf_lookup(nm) >= 0
                    return 1
                fi: nm_lookup(nm)
                if fi >= 0
                    # Identity returns stay parametric: specialize the returned
                    # parameter at this expression, not every call to the task.
                    pk: peek_i64(ret_par, 16 + fi * 8)
                    if pk >= 0
                        args: split_args(cut(e, lp + 1, en - 1), _sov_list_new())
                        if pk < _sov_list_len(args)
                            return st_expr(peek_i64(args, 16 + pk * 8), dep + 1)
                    return fi + 2
    return 0
st_build:
    st_need: _sov_list_new()
    st_edges: _sov_list_new()
    st_done: _sov_list_new()
    zz: st_node(0)
    zz: st_node(0)
    fi: 0
    nn: _sov_list_len(names)
    as long as fi < nn
        zz: st_node(0 - 1)
        fi: fi + 1
    fi: 0
    as long as fi < nn
        st_vars: _sov_list_new()
        st_ids: _sov_list_new()
        bl: peek_i64(bodies, 16 + fi * 8)
        ps: peek_i64(params, 16 + fi * 8)
        pi: 0
        as long as pi < _sov_list_len(ps)
            zz: st_var(peek_i64(ps, 16 + pi * 8))
            # A runtime parameter is unknown unless its actual argument is
            # considered at a parametric call site. Do not assume text.
            st_edge(0, zz)
            pi: pi + 1
        bi: 0
        as long as bi < _sov_list_len(bl)
            line: strip(peek_i64(bl, 16 + bi * 8))
            if starts(line, "immutable ") is 1
                line: strip(cut(line, 10, length(line)))
            co: find_col(line)
            if co > 0
                nm: strip(cut(line, 0, co))
                if expr_atom_word(nm) is 1
                    zz: st_var(nm)
            bi: bi + 1
        bi: 0
        as long as bi < _sov_list_len(bl)
            line: strip(peek_i64(bl, 16 + bi * 8))
            if starts(line, "immutable ") is 1
                line: strip(cut(line, 10, length(line)))
            if starts(line, "return ") is 1
                st_edge(st_expr(cut(line, 7, length(line)), 0), fi + 2)
            if not
                co: find_col(line)
                if co > 0
                    nm: strip(cut(line, 0, co))
                    if expr_atom_word(nm) is 1
                        vn: st_var(nm)
                        st_edge(st_expr(cut(line, co + 1, length(line)), 0), vn)
            bi: bi + 1
        fi: fi + 1
    queue: _sov_list_new()
    queue: _sov_list_add(queue, 1)
    poke_i64(st_done, 24, 1)
    qi: 0
    as long as qi < _sov_list_len(queue)
        ni: peek_i64(queue, 16 + qi * 8)
        adj: peek_i64(st_edges, 16 + ni * 8)
        ai: 0
        as long as ai < _sov_list_len(adj)
            dst: peek_i64(adj, 16 + ai * 8)
            need: peek_i64(st_need, 16 + dst * 8)
            if need > 0
                need: need - 1
                poke_i64(st_need, 16 + dst * 8, need)
            if need <= 0
                if peek_i64(st_done, 16 + dst * 8) is 0
                    poke_i64(st_done, 16 + dst * 8, 1)
                    queue: _sov_list_add(queue, dst)
                    if dst >= 2
                        if dst < nn + 2
                            mark_fn_str(peek_i64(names, 16 + (dst - 2) * 8))
            ai: ai + 1
        qi: qi + 1
    # The semantic result is now in str_fns; graph scratch is not reused by
    # another compilation and no source or emitted artifact is replayed.
    return 0

# Debug points are ordinary numeric patch records. Every compaction and
# parallel merge already relocates these records; no stale raw PCs survive.
dbg_collect: 0
dbg_active: 0
dbg_tops: 0
tops_users: 0
dbg_decimal v:
    if v is 0
        return "0"
    out: ""
    as long as v > 0
        out: join(cut("0123456789", v % 10, v % 10 + 1), out)
        v: v / 10
    return out
dbg_write path:
    if dbg_collect is 0
        return 0
    out: join("# src_base ", join(dbg_decimal(src_base), "\n"))
    di: 0
    as long as di < _sov_list_len(patch_at)
        if _sov_str_eq(peek_i64(patch_kind, 16 + di * 8), "debug") is 1
            pc: peek_i64(patch_at, 16 + di * 8) + HDR
            ln: peek_i64(patch_val, 16 + di * 8)
            out: join(out, join(dbg_decimal(pc), join(" ", join(dbg_decimal(ln), "\n"))))
        di: di + 1
    if file_write_all(join(path, ".map"), out) is 0
        print "Error: cannot write debug map"
        fail()
    return 0

# Counters are emitted only by an explicitly instrumenting compiler build.
# Ordinary translation emits no probes and normal benchmark binaries stay clean.
prof_codegen: 0
prof_counter_active: 0
prof_bytes_scanned: 0
prof_bytes_copied: 0
prof_allocations: 0
prof_alloc_bytes: 0
prof_hash_probes: 0
prof_fallbacks: 0
prof_emit counter reg:
    if prof_codegen is 0
        return 0
    if gn_lookup("prof_counter_active") < 0
        print "Error: --instrument-compiler requires compiler counter globals"
        fail()
    # Preserve flags and both scratch registers, including the original rax
    # when it is the measured value. No calls or ABI alignment dependencies.
    emit(156)
    emit(80)
    emit2(65, 83)
    load_glob("prof_mode")
    test_rax()
    disabled: jz()
    emit2(72, 184)
    emit8(1)
    store_glob("prof_counter_active")
    load_glob(counter)
    if reg < 0
        emit3(72, 131, 192)
        emit(1)
    if not
        if reg is 0
            emit3(72, 3, 68)
            emit(36)
            emit(8)
        if not
            rex: 72
            if reg >= 8
                rex: 76
            emit3(rex, 1, 192 + (reg % 8) * 8)
    store_glob(counter)
    patch(disabled)
    emit2(65, 91)
    emit(88)
    emit(157)
    return 0
prof_emit_n counter count:
    if prof_codegen is 0
        return 0
    emit(80)
    emit2(72, 184)
    emit8(count)
    prof_emit(counter, 0)
    emit(88)
    return 0

prof_strlen_stub:
    # Same aligned SWAR algorithm as emit_strlen; symbolic branch patches
    # permit probes without stale byte displacements in the original stub.
    emit3(72, 129, 255)
    emit4(4096)
    emit2(15, 134)
    small: here()
    emit4(0)
    emit3(72, 137, 254)
    emit3(72, 137, 250)
    emit3(72, 131, 226)
    emit(248)
    prof_emit_n("prof_bytes_scanned", 8)
    emit3(76, 139, 10)
    emit2(137, 249)
    emit3(131, 225, 7)
    emit3(193, 225, 3)
    emit(184)
    emit4(1)
    emit3(72, 211, 224)
    emit3(72, 255, 200)
    emit3(73, 9, 193)
    emit2(73, 184)
    emit8(0 - 72340172838076673)
    emit2(72, 184)
    emit8(-9187201950435737472)
    first: jmp()
    loop: here()
    prof_emit_n("prof_bytes_scanned", 8)
    emit3(76, 139, 10)
    patch(first)
    emit3(76, 137, 201)
    emit3(76, 1, 193)
    emit3(73, 247, 209)
    emit3(73, 33, 193)
    emit3(73, 33, 201)
    found: jnz()
    emit3(72, 131, 194)
    emit(8)
    back: jmp()
    put(back, loop - (back + 4))
    patch(found)
    emit3(77, 15, 188)
    emit(201)
    emit3(73, 193, 233)
    emit(3)
    emit3(76, 1, 202)
    emit3(72, 137, 208)
    emit3(72, 41, 240)
    ret()
    patch(small)
    xor_rax()
    ret()
    return 0

prof_last: 0
prof_value i:
    if i is 0 -> return prof_bytes_scanned
    if i is 1 -> return prof_bytes_copied
    if i is 2 -> return prof_allocations
    if i is 3 -> return prof_alloc_bytes
    if i is 4 -> return prof_hash_probes
    return prof_fallbacks
prof_key i:
    if i is 0 -> return "bytes_scanned"
    if i is 1 -> return "bytes_copied"
    if i is 2 -> return "allocations"
    if i is 3 -> return "allocation_requested_bytes"
    if i is 4 -> return "hash_probes"
    return "fallbacks"
prof_capture off fresh:
    ci: 0
    as long as ci < 6
        value: prof_value(ci)
        prior: peek_i64(prof_last, ci * 8)
        field: off + 24 + ci * 8
        delta: value - prior
        if fresh is 0
            delta: delta + peek_i64(prof_marks, field)
        poke_i64(prof_marks, field, delta)
        poke_i64(prof_last, ci * 8, value)
        ci: ci + 1
    return 0

include syntax.sov

include statements.sov
