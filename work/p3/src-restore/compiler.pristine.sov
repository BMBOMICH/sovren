# pad line: keeps the user first line off the last chunk line
# pad line: keeps the user first line off the last chunk line
# unsafe-module
# unsafe-module
main argc argv:
    mark("z-first")
    if argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail()
    inf: blank
    outf: blank
    i: 1
    as long as i < argc
        arg: peek_ptr(argv, i)
        if _sov_str_eq(arg, "--bare") is 1
            bare_mode: 1
        if not
            if _sov_str_eq(arg, "--run") is 1
                run_mode: 1
            if not
                if _sov_str_eq(arg, "--fmt") is 1
                    fmt_mode: 1
                if not
                            if _sov_str_eq(arg, "--plain") is 1
                                opt_peep: 0
                            if not
                                if _sov_str_eq(arg, "-o") is 1
                                    i: i + 1
                                    if i < argc
                                        outf: peek_ptr(argv, i)
                                if not
                                    if starts(arg, "--") is 0
                                        if _sov_str_eq(arg, "build") is 0
                                            outf: pic_io(inf, outf, arg)
                                        if _sov_str_eq(arg, "build") is 0
                                            inf: pic_in(inf, arg)
        i: i + 1
    # Dead-task elimination is sound (PL-01) and, after the in-place
    # compaction rewrite, free - so it is on by default (PL-04: small
    # outputs without needing --release).  --no-dce restores the old
    # keep-everything build for debugging.
    opt_dce: 1
    i2: 1
    as long as i2 < argc
        a2: peek_ptr(argv, i2)
        flag_ok: 0
        if _sov_str_eq(a2, "--kernel") is 1
            kern_mode: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--release") is 1
            opt_dce: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--no-dce") is 1
            opt_dce: 0
            flag_ok: 1
        if _sov_str_eq(a2, "--tiny") is 1
            opt_tiny: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--unsafe") is 1
            unsafe_mode: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--fast-fp") is 1
            opt_fastfp: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--sxe") is 1
            sxe_mode: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--flat") is 1
            flat_mode: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--instrument-compiler") is 1
            prof_codegen: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--syntax-reference") is 1
            syntax_mode: 2
            flag_ok: 1
        if _sov_str_eq(a2, "--legacy-syntax") is 1
            syntax_mode: 0
            flag_ok: 1
        if _sov_str_eq(a2, "--syntax-tree") is 1
            syntax_mode: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--debug") is 1
            dbg_collect: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--prof") is 1
            prof_mode: 1
            flag_ok: 1
        if _sov_str_eq(a2, "--sxe-compact") is 1
            sxe_mode: 1
            sxe_compact: 1
            flag_ok: 1
        # flags the first loop already applied; accepted here so the unknown-flag
        # check below cannot reject them.
        if _sov_str_eq(a2, "--bare") is 1
            flag_ok: 1
        if _sov_str_eq(a2, "--run") is 1
            flag_ok: 1
        if _sov_str_eq(a2, "--fmt") is 1
            flag_ok: 1
        if _sov_str_eq(a2, "--plain") is 1
            flag_ok: 1
        # older-generation cache-control flags the gate still passes;
        # this generation has no anchor/learning caches, so accept as no-ops.
        if _sov_str_eq(a2, "--no-ac") is 1
            flag_ok: 1
        if _sov_str_eq(a2, "--no-learn") is 1
            flag_ok: 1
        if flag_ok is 0
            if starts(a2, "--") is 1
                print "Error: unknown flag"
                _sov_print(a2)
                fail()
        i2: i2 + 1
    if length(inf) is 0
        print "Error: no input"
        fail()
    if fmt_mode is 1
        fmt_file(inf)
        sys_exit(0)
    if length(outf) is 0
        d: look(inf, ".sov")
        if d > 0 - 1
            outf: cut(inf, 0, d)
        if not
            outf: join(inf, ".out")
    src_name: inf
    mark("f0-src")
    print "Compiling"
    _sov_print(inf)
    src: load_file(inf)
    if src is 0
        print "Error: cannot read input"
        fail()
    if prof_mode is 1
        prof_input_bytes: length(src)
    src: splice_inc(src, dir_of(inf))
    pf_buf: _sov_heap_alloc(4096)
    pf_n: syscall(89, "/proc/self/exe", pf_buf, 4095, 0)
    if pf_n > 0
        pf_z: _sov_set_byte(pf_buf, pf_n, 0)
        self_dir: dirname(pf_buf)
    mark("pre-u")
    # the first pull's used_libs/alias_pairs side effects are reset below and
    # its text is discarded, so the phase ran the identical fixpoint twice;
    # one pull chain (after the pad splice) yields the same extra.
    mark("sug")
    nl: _sov_heap_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    src: join(join("# pad line: keeps the user first line off the last chunk line", nl), src)
    mark("f3-sug")
    used_libs: blank
    alias_pairs: blank
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
        mark("pu")
    src: apply_aliases(src)
    mark("aa")
    if length(extra) > 0
        src: join(extra, src)
    need: 0
    mmap_sz: 12582912
    # runtime.sov splice triggers: any _sov_* runtime call (atoi, alloc,
    # list, buf, ...) or raw peek_/poke_ intrinsic needs the runtime
    # text; a missed trigger links the call to a trap stub.
    if need is 0
        if look(src, "_sov_") > 0 - 1
            need: 1
    if need is 0
        if look(src, "load_file") > 0 - 1
            need: 1
    if need is 0
        if look(src, "peek_") > 0 - 1
            need: 1
    if need is 0
        if look(src, "poke_") > 0 - 1
            need: 1
    if need is 0
        if look(src, "spawn ") > 0 - 1
            need: 1
    if need is 0
        if look(src, "join ") > 0 - 1
            need: 1
    rt: blank
    if bare_mode is 1
        need: 0
    if need is 1
        mmap_sz: 1073741824
        rt: load_file("runtime.sov")
        if rt is 0
            rt: load_file("linux/runtime.sov")
        if rt is 0
            rt: load_file(join(self_dir, "/runtime.sov"))
        if rt is 0
            rt: load_file(join(self_dir, "/../runtime.sov"))
        if rt is 0
            rt: load_file(join(dirname(dirname(self_dir)), "/runtime.sov"))
        if rt is 0
            rt: rt_baked_text()
        if sxe_mode is 1
            rt: repl(rt, "syscall(186, 0, 0, 0, 0, 0, 0)", "0 - 38")
        if kern_mode is 1
            rt: repl(rt, "syscall(186, 0, 0, 0, 0, 0, 0)", "0 - 38")
    mark("1-rt-loaded")
    src_base: 1
    sxs_rt: lines_of_fast(rt)
    src_base: src_base + nl_count_lines(rt)
    src_base: src_base + sg_extra_ls(sxs_rt)
    sxs_ex: lines_of_fast(extra)
    src_base: src_base + nl_count_lines(extra)
    src_base: src_base + sg_extra_ls(sxs_ex)
    nl: _sov_heap_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    all: join(rt, nl)
    src_base: src_base + 1
    if need is 1
        all: join(all, nl)
        all: join(all, join("_sov_thread_exit:", nl))
        if sxe_mode is 1
            all: join(all, join("    sovcall(60, 0, 0, 0, 0, 0)", nl))
        if not
            all: join(all, join("    syscall(60, 0, 0, 0, 0, 0, 0)", nl))
        all: join(all, join("    return 0 - 1", nl))
        src_base: src_base + 4
    mark("2-all-spliced")
    if unsafe_mode is 1
        u_listing: 1
    u_bare_total: 0
    u_note: u_scan(src)
    if u_bare_total > 0
        if unsafe_mode is 0
            print "Error: raw memory/io access denied by default; use checked primitives (library/sbuf.sov) or mark reviewed low-level code: # unsafe-module file stamp, unsafe: block, per-line # unsafe, or --unsafe"
            fail()
    if u_note > 0
        print "note: compiler sees raw memory/io sites without unsafe markers; library/sbuf.sov covers checked buffers (count follows)"
        print u_note
    src: u_prep(src)
    snap_a: length(all)
    all: join(all, src)
    snap_m: length(all) - length(src)
    mark("3-scanned")
    # expansion is applied per-part at load (rt above, chunks in take_use, src above)
    if flat_mode is 1
        # --flat: write the program the compiler would parse, includes put back
        # and expansion applied, then stop. handy for tools that read source text.
        flat_ok: file_write_all(outf, all)
        if flat_ok is 0
            print "Error: cannot write flattened source"
        if flat_ok is 0
            sys_exit(1)
        print "Wrote"
        _sov_print(outf)
        sys_exit(0)
    pd_out2: prune_dead(all, snap_m, inf)
    compile(pd_out2)
    mark("4-compiled")
    write_elf(outf)
    if had_err is 1
        fail()
    dbg_write(outf)
    print "Wrote"
    _sov_print(outf)
    mark("z-end")
    prof_report()
    if run_mode is 1
        run_prog(outf, argv, argc)
    sys_exit(0)

