use cx86
use rt_baked
is_mac:
    return 0
is_rel:
    return 1
win_rare:
    return 0
stmt_reset_small:
    rax_small: 0
stmt_mark_print:
    if br_depth is 0
        rax_small: 1
stmt_join_op:
    mov_rdi_rax()
    calln("_sov_thread_join")
stmt_leave_op:
    
    emit(201)
try_sbss var rhs:
    if in_entry_now is 1
        if br_depth is 0
            if _sov_byte_at(rhs, length(rhs) - 1) is 41 is 1
                inn: strip(cut(rhs, 11, length(rhs) - 1))
                asz: 0
                if _sov_str_eq(inn, kn) is 1
                    if kv > 0
                        asz: kv
                if asz is 0
                    if length(inn) > 0
                        if digitb(_sov_byte_at(inn, 0)) is 1
                            if look(inn, " ") < 0
                                asz: _sov_atoi(inn)
                if asz > 0
                    emit(72)
                    emit(184)
                    sa: here()
                    emit8(0)
                    addp(sa, "sbss", i2s(_sov_list_len(sbss_sizes)))
                    sbss_sizes: _sov_list_add(sbss_sizes, asz)
                    storev(var)
                    return 1
plat_used:
    return 0
rng_hash buf a e:
    h: 5381
    k: a
    as long as k < e
        h: band(bxor(h * 33, peek_byte(buf, k)), 72057594037927935)
        k: k + 1
    return h
rng_eq buf a1 b1 a2 b2:
    if b1 - a1 is not b2 - a2
        return 0
    k: 0
    as long as k < b1 - a1
        if peek_byte(buf, a1 + k) is not peek_byte(buf, a2 + k)
            return 0
        k: k + 1
    return 1
tab_get buf a e:
    h: rng_hash(buf, a, e)
    k: band(h, 16383)
    val: 0 - 1
    t: 0
    go: 1
    as long as go is 1
        es: peek_i64(ht, k * 32)
        if es is 0
            go: 0
        if not
            eq: rng_eq(buf, es - 1, peek_i64(ht, k * 32 + 8), a, e)
            if eq is 1
                val: peek_i64(ht, k * 32 + 24)
                go: 0
            if not
                k: band(k + 1, 16383)
        t: t + 1
        if t > 16383
            go: 0
    return val
tab_put buf a e v:
    h: rng_hash(buf, a, e)
    k: band(h, 16383)
    added: 0
    t: 0
    go: 1
    as long as go is 1
        es: peek_i64(ht, k * 32)
        if es is 0
            dummy: poke_i64(ht, k * 32, a + 1)
            dummy: poke_i64(ht, k * 32 + 8, e)
            dummy: poke_i64(ht, k * 32 + 16, h)
            dummy: poke_i64(ht, k * 32 + 24, v)
            added: 1
            tab_n: tab_n + 1
            go: 0
        if not
            eq: rng_eq(buf, es - 1, peek_i64(ht, k * 32 + 8), a, e)
            if eq is 1
                go: 0
            if not
                k: band(k + 1, 16383)
        t: t + 1
        if t > 16383
            go: 0
    return added
plat_canary:
    if can_used is 1
        emit_canary_fail()
leave_reload:
    return 0
canary_die:
    emit(191)
    emit4(101)
    if sxe_mode is 1
        rax_imm(60)
        emit(205)
        emit(128)
        return 0
    emit(176)
    emit(60)
    sysc()
spawn_arg ai:
    if ai is 0
        mov_rdi_rax()
    if ai is 1
        mov_rsi_rax()
    if ai is 2
        emit(72)
        emit(137)
        emit(194)
    if ai is 3
        mov_rcx_rax()
    if ai is 4
        emit(73)
        emit(137)
        emit(192)
    if ai is 5
        emit(73)
        emit(137)
        emit(193)
spawn_finish name:
    emit(76)
    emit(137)
    emit(200)
    emit(73)
    emit(137)
    emit(194)
    emit(77)
    emit(137)
    emit(193)
    emit(73)
    emit(137)
    emit(200)
    emit(72)
    emit(137)
    emit(209)
    emit(72)
    emit(137)
    emit(242)
    emit(72)
    emit(137)
    emit(254)
    emit(72)
    emit(191)
    fn_at: here()
    emit8(0)
    addp(fn_at, "fnaddr", name)
    calln("_sov_thread_spawn")
    return 0
