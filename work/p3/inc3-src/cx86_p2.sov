emit_nt_intern_kid_n:
    # Volatile-only frameless hit path for intern_kid_n(rdi=s, rsi=n).
    prof_emit("prof_bytes_scanned", 6)
    load_glob("kid_ht")
    test_rax()
    iknd1: jz()
    emit3(73, 137, 192)
    load_glob("kid_slots")
    prof_emit("prof_hash_probes", 0 - 1)
    emit:
        76 141 72 255 184 5 21 0 0 49 201 72 133 246 116 19
        15 182 20 15 72 107 192 33 72 1 208 72 255 193 72 57 241 114 237
        73 137 194 77 33 202 69 49 219 75 139 4 208 72 133 192 116 44
        128 60 48 0 117 24 72 133 246 116 18 49 201 138 20 15 58 20 8
        117 9 72 255 193 72 57 241 114 240 195 73 255 194 77 33 202 73 255 195
        77 57 203 118 203
    patch(iknd1)
