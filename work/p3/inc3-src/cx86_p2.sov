    iknj: here()
    emit4(0)
    addp(iknj, "rel", "intern_kid_n_full")
    return 1

emit_nt_intern_kid:
    # fast HIT path of intern_kid (rbx = s after copyargs): djb2 the
    # string, probe the CURRENT table, return the canonical pointer on
    # a str_eq hit.  Every other shape delegates to intern_kid_full,
    # the verbatim Sovren body: kid_ht is 0 (init), empty slot (insert
    # +/- pool growth), probe exhaustion.  Skipping the kgrow check on
    # hits is safe: growth preserves canonical pointers, so a hit here
    # returns exactly what the Sovren body would return after growing.
    # fn_save_n is 5 for the Sovren body, so r12-r15 are free to use.
    # (Replaces the old plant, which hardcoded a fixed 65536-slot table
    # with no growth and none of the kid_slots/kid_poolcap/kcnt upkeep.)
    load_glob("kid_ht")
    test_rax()
    ikd1: jz()
    emit:
        73 137 198
        72 137 222 184 5 21 0 0 49 201
    ikhl: here()
    prof_emit("prof_bytes_scanned", 0 - 1)
    emit:
        15 182 20 14 132 210
    ikdn: jz()
    emit:
        72 107 192 33 72 1 208 72 255 193 233
    iknx: here()
    emit4(0)
    put(iknx, ikhl - (iknx + 4))
    patch(ikdn)
    emit:
        73 137 196
    load_glob("kid_slots")
    emit:
        73 137 197 76 137 234 72 255 202 73 33 212 69 49 255
    ikpb: here()
    prof_emit("prof_hash_probes", 0 - 1)
    emit:
        79 139 4 230 77 133 192
    ikd2: jz()
    emit:
        76 137 199 72 137 222
    calln("_sov_str_eq")
    test_rax()
    ikne: jz()
    emit:
        75 139 4 230
    leave()
    ret()
    patch(ikne)
    emit:
        73 255 196 76 137 234 72 255 202 73 33 212 73 255 199 77 57 239 15 140
    emit4(ikpb - (here() + 4))
    patch(ikd1)
    patch(ikd2)
    emit:
        72 137 223
    calln("intern_kid_full")
    leave()
    ret()
    return 1

