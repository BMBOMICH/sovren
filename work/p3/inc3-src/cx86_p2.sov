emit_nt_lsh_find:
    # rbx is v, the name string.  fast path of lsh_find_s:
    #   locals and lh_tab nonzero, probe the 1048576-slot open table:
    #   s is nhash(v) and 1048575 forward, ve is keys[s], ve2 is tags[1048576+s]
    #   hit requires ve2 / 1048576 is lh_gen, then ve is v or str_eq(ve, v)
    # slow shapes (locals is 0, lh_tab is 0 build case, table full walk)
    # delegate to lsh_find_full which owns the original body verbatim.
    load_glob("locals")
    test_rax()
