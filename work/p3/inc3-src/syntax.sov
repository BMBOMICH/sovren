# unsafe-module
# Primary expression syntax, migration slice 1. No sx_source-keyed lookup and no
# saved translation results. A sx_tree owns its flat nodes and operand stacks;
# emission receives sx_node indices, never searches text to rediscover a split.
# Initially admitted grammar: decimal/name atoms, parentheses, binary +-*/%.
# Other grammar remains on the existing path until it is explicitly migrated.
syntax_mode: 1
syntax_trees: 0
syntax_nodes: 0
syntax_declines: 0
syntax_native_trees: 0
syntax_prec sx_op:
    if sx_op is 308 -> return 1
    if sx_op is 307 -> return 2
    if sx_op is 124 -> return 3
    if sx_op is 94 -> return 4
    if sx_op is 38 -> return 5
    if sx_op is 300 -> return 6
    if sx_op is 301 -> return 7
    if sx_op is 302 -> return 8
    if sx_op is 303 -> return 9
    if sx_op is 60 -> return 10
    if sx_op is 62 -> return 11
    if sx_op is 306 -> return 12
    if sx_op is 305 -> return 13
    if sx_op is 304 -> return 14
    if sx_op is 43 -> return 15
    if sx_op is 45 -> return 15
    if sx_op is 42 -> return 16
    if sx_op is 47 -> return 16
    if sx_op is 37 -> return 16
    return 0
syntax_word sx_c:
    if sx_c is 95 -> return 1
    if sx_c >= 48
        if sx_c <= 57 -> return 1
    if sx_c >= 65
        if sx_c <= 90 -> return 1
    if sx_c >= 97
        if sx_c <= 122 -> return 1
    return 0
syntax_add sx_tree sx_kind sx_start sx_end sx_left sx_right:
    if sx_kind is 0
        sx_source: peek_i64(sx_tree, 0)
        sx_b: peek_byte(sx_source, sx_start)
        sx_left: sx_start
        sx_right: sx_end
        sx_kind: 265
        if sx_b is 34 -> sx_kind: 266
        if digitb(sx_b) is 1 or sx_b is 45
            sx_kind: 264
            if sx_b is 45
                sx_left: wrap_sub(0, num_of_n(sx_source + sx_start + 1, sx_end - sx_start - 1))
            if not
                sx_left: num_of_n(sx_source + sx_start, sx_end - sx_start)
            sx_right: 0
    sx_count: peek_i64(sx_tree, 16)
    if sx_count > peek_i64(sx_tree, 8)
        poke_i64(sx_tree, 104, 1)
        return 0
    sx_rec: sx_tree + 128 + sx_count * 40
    poke_i64(sx_rec, 0, sx_kind)
    poke_i64(sx_rec, 8, sx_start)
    poke_i64(sx_rec, 16, sx_end)
    poke_i64(sx_rec, 24, sx_left)
    poke_i64(sx_rec, 32, sx_right)
    poke_i64(sx_tree, 16, sx_count + 1)
    return sx_count
syntax_next sx_tree:
    sx_source: peek_i64(sx_tree, 0)
    sx_n: peek_i64(sx_tree, 8)
    sx_i: peek_i64(sx_tree, 64)
    as long as sx_i < sx_n
        if peek_byte(sx_source, sx_i) > 32 -> leave
        sx_i: sx_i + 1
    poke_i64(sx_tree, 80, sx_i)
    poke_i64(sx_tree, 72, 0)
    if sx_i is sx_n
        poke_i64(sx_tree, 88, sx_i)
        poke_i64(sx_tree, 64, sx_i)
        return 0
    sx_c: peek_byte(sx_source, sx_i)
    sx_i: sx_i + 1
    sx_kind: sx_c
    if syntax_word(sx_c) is 1
        sx_kind: 1
        if digitb(sx_c) is 1 -> sx_kind: 2
        as long as sx_i < sx_n
            if syntax_word(peek_byte(sx_source, sx_i)) is 0 -> leave
            sx_i: sx_i + 1
        if sx_kind is 2
            sx_a: peek_i64(sx_tree, 80)
            sx_hex: 0
            if sx_i > sx_a + 2
                if peek_byte(sx_source, sx_a) is 48
                    sx_h: peek_byte(sx_source, sx_a + 1)
                    if sx_h is 120 or sx_h is 98 -> sx_hex: 1
            if sx_hex is 0
                as long as sx_a < sx_i
                    if digitb(peek_byte(sx_source, sx_a)) is 0 -> poke_i64(sx_tree, 104, 1)
                    sx_a: sx_a + 1
    if not
        if sx_c is 34
            sx_kind: 3
            sx_closed: 0
            as long as sx_i < sx_n
                sx_b: peek_byte(sx_source, sx_i)
                sx_i: sx_i + 1
                if sx_b is 92
                    if sx_i < sx_n
                        sx_i: sx_i + 1
                    if not
                        leave
                if not
                    if sx_b is 34
                        sx_closed: 1
                        leave
            if sx_closed is 0 -> poke_i64(sx_tree, 104, 1)
        if not
            if sx_i < sx_n
                sx_d: peek_byte(sx_source, sx_i)
                if sx_c is 61 and sx_d is 61 -> sx_kind: 300
                if sx_c is 33 and sx_d is 61 -> sx_kind: 301
                if sx_c is 60 and sx_d is 61 -> sx_kind: 302
                if sx_c is 62 and sx_d is 61 -> sx_kind: 303
                if sx_c is 60 and sx_d is 60 -> sx_kind: 304
                if sx_c is 62 and sx_d is 62 -> sx_kind: 305
                if sx_c is 38 and sx_d is 38 -> sx_kind: 307
                if sx_c is 124 and sx_d is 124 -> sx_kind: 308
                if sx_kind >= 300
                    sx_i: sx_i + 1
                    if sx_kind is 305
                        if sx_i < sx_n
                            if peek_byte(sx_source, sx_i) is 62
                                sx_kind: 306
                                sx_i: sx_i + 1
    poke_i64(sx_tree, 72, sx_kind)
    poke_i64(sx_tree, 88, sx_i)
    poke_i64(sx_tree, 64, sx_i)
    return 0
syntax_expression sx_tree sx_min:
    sx_dep: peek_i64(sx_tree, 96) + 1
    if peek_i64(sx_tree, 104) is 1 -> return 0
    if sx_dep > 150
        poke_i64(sx_tree, 104, 1)
        return 0
    poke_i64(sx_tree, 96, sx_dep)
    sx_kind: peek_i64(sx_tree, 72)
    sx_start: peek_i64(sx_tree, 80)
    sx_end: peek_i64(sx_tree, 88)
    sx_root: 0
    sx_text: 0
    if sx_kind is 1 or sx_kind is 2 or sx_kind is 3
        sx_root: syntax_add(sx_tree, 0, sx_start, sx_end, 0 - 1, 0 - 1)
        if sx_kind is 3 -> sx_text: 1
        syntax_next(sx_tree)
        if sx_kind is 1
            if peek_i64(sx_tree, 72) is 40
                sx_callee: sx_root
                sx_first: 0 - 1
                sx_last: 0 - 1
                syntax_next(sx_tree)
                if peek_i64(sx_tree, 72) is not 41
                    do forever
                        sx_arg: syntax_expression(sx_tree, 1)
                        if peek_i64(sx_tree, 104) is 1 -> leave
                        sx_ar: sx_tree + 128 + sx_arg * 40
                        sx_link: syntax_add(sx_tree, 257, peek_i64(sx_ar, 8), peek_i64(sx_ar, 16), sx_arg, 0 - 1)
                        if sx_last is not 0 - 1
                            poke_i64(sx_tree + 128 + sx_last * 40, 32, sx_link)
                        if not
                            sx_first: sx_link
                        sx_last: sx_link
                        if peek_i64(sx_tree, 72) is not 44 -> leave
                        syntax_next(sx_tree)
                if peek_i64(sx_tree, 72) is not 41 -> poke_i64(sx_tree, 104, 1)
                sx_root: syntax_add(sx_tree, 256, sx_start, peek_i64(sx_tree, 88), sx_callee, sx_first)
                poke_i64(sx_tree, 40, peek_i64(sx_tree, 40) + 1)
                syntax_next(sx_tree)
    if not
        if sx_kind is 40
            syntax_next(sx_tree)
            sx_root: syntax_expression(sx_tree, 1)
            if peek_i64(sx_tree, 72) is not 41 -> poke_i64(sx_tree, 104, 1)
            sx_root: syntax_add(sx_tree, 268, sx_start, peek_i64(sx_tree, 88), sx_root, 0 - 1)
            syntax_next(sx_tree)
        if not
            if sx_kind is 45
                syntax_next(sx_tree)
                if peek_i64(sx_tree, 72) is not 2 -> poke_i64(sx_tree, 104, 1)
                sx_root: syntax_add(sx_tree, 0, sx_start, peek_i64(sx_tree, 88), 0 - 1, 0 - 1)
                syntax_next(sx_tree)
            if not
                poke_i64(sx_tree, 104, 1)
    as long as peek_i64(sx_tree, 104) is 0
        sx_prec: syntax_prec(peek_i64(sx_tree, 72))
        if sx_prec is 0 -> leave
        if sx_prec < sx_min -> leave
        if sx_text is 1
            poke_i64(sx_tree, 104, 1)
            leave
        sx_op: peek_i64(sx_tree, 72)
        syntax_next(sx_tree)
        sx_right: syntax_expression(sx_tree, sx_prec + 1)
        sx_lr: sx_tree + 128 + sx_root * 40
        sx_rr: sx_tree + 128 + sx_right * 40
        sx_root: syntax_add(sx_tree, sx_op, peek_i64(sx_lr, 8), peek_i64(sx_rr, 16), sx_root, sx_right)
        poke_i64(sx_tree, 40, peek_i64(sx_tree, 40) + 1)
    poke_i64(sx_tree, 96, sx_dep - 1)
    return sx_root
syntax_reference_build sx_source sx_n sx_tree:
    if sx_n < 1 -> return 0
    if sx_n > 4096 -> return 0
    poke_i64(sx_tree, 0, sx_source)
    poke_i64(sx_tree, 8, sx_n)
    sx_i: 2
    as long as sx_i < 16
        poke_i64(sx_tree, sx_i * 8, 0)
        sx_i: sx_i + 1
    syntax_next(sx_tree)
    sx_root: syntax_expression(sx_tree, 1)
    if peek_i64(sx_tree, 104) is 1 -> return 0
    if peek_i64(sx_tree, 72) is not 0 -> return 0
    poke_i64(sx_tree, 48, sx_root)
    return sx_tree
syntax_build sx_source sx_n sx_tree:
    if sx_n < 1 -> return 0
    if sx_n > 4096 -> return 0
    poke_i64(sx_tree, 0, sx_source)
    poke_i64(sx_tree, 8, sx_n)
    sx_i: 2
    as long as sx_i < 16
        poke_i64(sx_tree, sx_i * 8, 0)
        sx_i: sx_i + 1
    syntax_next(sx_tree)
    sx_root: syntax_expression(sx_tree, 1)
    if peek_i64(sx_tree, 104) is 1 -> return 0
    if peek_i64(sx_tree, 72) is not 0 -> return 0
    poke_i64(sx_tree, 48, sx_root)
    return sx_tree
syntax_emit sx_tree sx_node:
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_source: peek_i64(sx_tree, 0)
    sx_start: peek_i64(sx_rec, 8)
    sx_end: peek_i64(sx_rec, 16)
    sx_kind: peek_i64(sx_rec, 0)
    if sx_kind is 264
        rax_imm(peek_i64(sx_rec, 24))
        return 0
    if sx_kind is 265
        sx_first: peek_i64(sx_rec, 24)
        sx_last: peek_i64(sx_rec, 32)
        sx_name: intern_kid_n(sx_source + sx_first, sx_last - sx_first)
        if sx_name is kid_blank
            rax_str("")
            return 1
        loadv(sx_name)
        return atom_str_type(sx_name)
    if sx_kind is 266
        sx_first: peek_i64(sx_rec, 24)
        sx_last: peek_i64(sx_rec, 32)
        rax_str(sx_span_alloc(sx_source + sx_first + 1, sx_last - sx_first - 2))
        return 1
    if sx_kind is 268
        return syntax_operand(sx_tree, sx_node, 0, 0, 0)
    if sx_kind is 256 or sx_kind is 259
        return syntax_call(sx_tree, sx_node)
    if sx_kind >= 258 and sx_kind <= 262
        return syntax_prefix(sx_tree, sx_node)
    if sx_kind is 0
        return expr_span(sx_source + sx_start, sx_end - sx_start)
    sx_left: peek_i64(sx_rec, 24)
    sx_right: peek_i64(sx_rec, 32)
    sx_lr: sx_tree + 128 + sx_left * 40
    sx_rr: sx_tree + 128 + sx_right * 40
    sx_ls: peek_i64(sx_lr, 8)
    sx_rs: peek_i64(sx_rr, 8)
    if sx_kind is 307 or sx_kind is 308
        syntax_operand(sx_tree, sx_node, 0, 0, 0)
        test_rax()
        sx_j1: 0
        if sx_kind is 307 -> sx_j1: jz()
        if sx_kind is 308 -> sx_j1: jnz()
        syntax_operand(sx_tree, sx_node, 1, 0, 0)
        test_rax()
        sx_j2: 0
        if sx_kind is 307 -> sx_j2: jz()
        if sx_kind is 308 -> sx_j2: jnz()
        if sx_kind is 307 -> rax_imm(1)
        if sx_kind is 308 -> xor_rax()
        sx_j3: jmp()
        patch(sx_j1)
        patch(sx_j2)
        if sx_kind is 307 -> xor_rax()
        if sx_kind is 308 -> rax_imm(1)
        patch(sx_j3)
        return 0
    sx_oid: kid_opadd
    if sx_kind is 124 -> sx_oid: kid_opbor
    if sx_kind is 94 -> sx_oid: kid_opbxor
    if sx_kind is 38 -> sx_oid: kid_opband
    if sx_kind is 300 -> sx_oid: kid_opeq
    if sx_kind is 301 -> sx_oid: kid_opne
    if sx_kind is 302 -> sx_oid: kid_ople
    if sx_kind is 303 -> sx_oid: kid_opge
    if sx_kind is 60 -> sx_oid: kid_oplt
    if sx_kind is 62 -> sx_oid: kid_opgt
    if sx_kind is 306 -> sx_oid: kid_opbshr
    if sx_kind is 305 -> sx_oid: kid_opbsar
    if sx_kind is 304 -> sx_oid: kid_opbshl
    if sx_kind is 45 -> sx_oid: kid_opsub
    if sx_kind is 42 -> sx_oid: kid_opmul
    if sx_kind is 47 -> sx_oid: kid_opdiv
    if sx_kind is 37 -> sx_oid: kid_opmod
    return bin_k(sx_source + sx_ls, peek_i64(sx_lr, 16) - sx_ls, sx_source + sx_rs, peek_i64(sx_rr, 16) - sx_rs, sx_oid, sx_tree, sx_node)
syntax_operand sx_tree sx_node sx_side sx_source sx_n:
    if sx_tree is 0 -> return expr_span(sx_source, sx_n)
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_child: peek_i64(sx_rec, 24 + sx_side * 8)
    if peek_i64(sx_rec, 0) is 256 or peek_i64(sx_rec, 0) is 259
        sx_link: peek_i64(sx_rec, 32)
        if sx_side is 1
            sx_link: peek_i64(sx_tree + 128 + sx_link * 40, 32)
        sx_child: peek_i64(sx_tree + 128 + sx_link * 40, 24)
    sx_rec: sx_tree + 128 + sx_child * 40
    ex_depth: ex_depth + 1
    if ex_depth > 150
        if had_err is 0
            print "Error: expression too long, split it up"
            err_where()
            had_err: 1
        ex_depth: ex_depth - 1
        xor_rax()
        return 0
    sx_result: syntax_emit(sx_tree, sx_child)
    ex_depth: ex_depth - 1
    return sx_result
syntax_try sx_source sx_n:
    if sx_n < 1 -> return 0
    if sx_n > 4096 -> return 0
    sx_old: syntax_storage
    sx_cap: syntax_storage_cap
    sx_mark: syntax_storage_used
    sx_need: 128 + (sx_n + 1) * 64
    if syntax_storage is 0
        syntax_storage: _sov_heap_alloc(1048576)
        syntax_storage_cap: 1048576
        syntax_storage_used: 0
    if syntax_storage_used + sx_need > syntax_storage_cap
        syntax_storage: _sov_heap_alloc(1048576)
        syntax_storage_cap: 1048576
        syntax_storage_used: 0
    sx_buffer: syntax_storage + syntax_storage_used
    syntax_storage_used: syntax_storage_used + sx_need
    sx_tree: 0
    if syntax_mode is 2
        sx_tree: syntax_reference_build(sx_source, sx_n, sx_buffer)
    if not
        sx_tree: syntax_build(sx_source, sx_n, sx_buffer)
    if sx_tree is 0
        syntax_release(sx_old, sx_cap, sx_mark)
        if prof_mode is 1
            syntax_declines: syntax_declines + 1
        return 0
    if prof_mode is 1
        syntax_trees: syntax_trees + 1
        if peek_i64(sx_tree, 56) is 86042493933125
            syntax_native_trees: syntax_native_trees + 1
        syntax_nodes: syntax_nodes + peek_i64(sx_tree, 16)
    syntax_type: syntax_emit(sx_tree, peek_i64(sx_tree, 48))
    syntax_release(sx_old, sx_cap, sx_mark)
    return 1

# Allocation reuse only: active tree ownership is stack-scoped. Returning from
# syntax_try discards every node; no source key or previous parse is retained.
syntax_storage: 0
syntax_storage_cap: 0
syntax_storage_used: 0
syntax_release sx_old sx_cap sx_mark:
    if sx_old is not 0
        syntax_storage: sx_old
        syntax_storage_cap: sx_cap
    syntax_storage_used: sx_mark
    return 0
include syntax_native.sov

syntax_span_slab: 0
syntax_span_cap: 0
syntax_span_used: 0
syntax_arg_pool: 0
syntax_arg_cap: 0
syntax_arg_used: 0
sx_dec_str: 0
syntax_reset_slabs:
    if syntax_span_slab is not 0
        syntax_span_used: 0
    syntax_arg_used: 0
    return 0
sx_dec_init:
    sx_dec_str: _sov_heap_alloc(2048)
    sx_dbuf: _sov_heap_alloc(1024)
    sx_doff: 0
    sx_di: 0
    as long as sx_di < 256
        sx_dp: sx_dbuf + sx_doff
        poke_i64(sx_dec_str, sx_di * 8, sx_dp)
        if sx_di >= 100
            poke_byte(sx_dp, 0, 48 + sx_di / 100)
            poke_byte(sx_dp, 1, 48 + (sx_di / 10) % 10)
            poke_byte(sx_dp, 2, 48 + sx_di % 10)
            poke_byte(sx_dp, 3, 0)
            sx_doff: sx_doff + 4
        if not
            if sx_di >= 10
                poke_byte(sx_dp, 0, 48 + sx_di / 10)
                poke_byte(sx_dp, 1, 48 + sx_di % 10)
                poke_byte(sx_dp, 2, 0)
                sx_doff: sx_doff + 3
            if not
                poke_byte(sx_dp, 0, 48 + sx_di)
                poke_byte(sx_dp, 1, 0)
                sx_doff: sx_doff + 2
        sx_di: sx_di + 1
    return 0
sx_span_alloc sx_ptr sx_len:
    if sx_len <= 0 -> return ""
    if syntax_span_slab is 0 or syntax_span_used + sx_len + 1 > syntax_span_cap
        sx_ncap: 524288
        if sx_len + 16 > sx_ncap -> sx_ncap: sx_len + 4096
        syntax_span_slab: _sov_heap_alloc(sx_ncap)
        syntax_span_cap: sx_ncap
        syntax_span_used: 0
    sx_dst: syntax_span_slab + syntax_span_used
    syntax_span_used: syntax_span_used + sx_len + 1
    _sov_memcpy(sx_dst, sx_ptr, sx_len)
    poke_byte(sx_dst, sx_len, 0)
    return sx_dst
sx_arg_str sx_source sx_child:
    sx_ck: peek_i64(sx_child, 0)
    sx_cs: peek_i64(sx_child, 8)
    sx_cn: peek_i64(sx_child, 16) - sx_cs
    if sx_ck is 265
        return intern_kid_n(sx_source + sx_cs, sx_cn)
    if sx_ck is 264
        sx_cv: peek_i64(sx_child, 24)
        if sx_cv >= 0 and sx_cv < 256
            if sx_cn is 1 or (sx_cn <= 3 and peek_byte(sx_source, sx_cs) > 48)
                if sx_dec_str is 0 -> sx_dec_init()
                return peek_i64(sx_dec_str, sx_cv * 8)
    return sx_span_alloc(sx_source + sx_cs, sx_cn)
syntax_arg_release sx_old sx_cap sx_mark:
    if sx_old is not 0
        syntax_arg_pool: sx_old
        syntax_arg_cap: sx_cap
    syntax_arg_used: sx_mark
    return 0

syntax_type: 0
syntax_call sx_tree sx_node:
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_source: peek_i64(sx_tree, 0)
    sx_start: peek_i64(sx_rec, 8)
    sx_end: peek_i64(sx_rec, 16)
    sx_nr: sx_tree + 128 + peek_i64(sx_rec, 24) * 40
    sx_ns: peek_i64(sx_nr, 8)
    sx_name: intern_kid_n(sx_source + sx_ns, peek_i64(sx_nr, 16) - sx_ns)
    sx_link: peek_i64(sx_rec, 32)
    if sx_name is kid_const and peek_i64(sx_rec, 0) is not 259
        if sx_end - sx_start > 7
            if sx_link is not 0 - 1
                sx_ar0: sx_tree + 128 + sx_link * 40
                if peek_i64(sx_ar0, 32) is 0 - 1
                    sx_ch0: sx_tree + 128 + peek_i64(sx_ar0, 24) * 40
                    if ceval(sx_arg_str(sx_source, sx_ch0)) is 1
                        rax_imm(cval)
                        return 0
            print "Error: const: not a compile-time number"
            err_where()
            had_err: 1
            xor_rax()
            return 0
    sx_argc: 0
    sx_scan: sx_link
    as long as sx_scan is not 0 - 1
        sx_argc: sx_argc + 1
        sx_scan: peek_i64(sx_tree + 128 + sx_scan * 40, 32)
    sx_aold: syntax_arg_pool
    sx_acap: syntax_arg_cap
    sx_amark: syntax_arg_used
    sx_aneed: 16 + sx_argc * 8
    if syntax_arg_pool is 0
        syntax_arg_pool: _sov_heap_alloc(65536)
        syntax_arg_cap: 65536
        syntax_arg_used: 0
    if syntax_arg_used + sx_aneed > syntax_arg_cap
        sx_anew: 65536
        if sx_aneed > sx_anew -> sx_anew: sx_aneed + 4096
        syntax_arg_pool: _sov_heap_alloc(sx_anew)
        syntax_arg_cap: sx_anew
        syntax_arg_used: 0
    sx_args: syntax_arg_pool + syntax_arg_used
    syntax_arg_used: syntax_arg_used + sx_aneed
    poke_i64(sx_args, 0, sx_argc)
    poke_i64(sx_args, 8, sx_argc)
    sx_ai: 0
    as long as sx_link is not 0 - 1
        sx_ar: sx_tree + 128 + sx_link * 40
        sx_child: sx_tree + 128 + peek_i64(sx_ar, 24) * 40
        poke_i64(sx_args, 16 + sx_ai * 8, sx_arg_str(sx_source, sx_child))
        sx_ai: sx_ai + 1
        sx_link: peek_i64(sx_ar, 32)
    sx_spawn: 0
    if peek_i64(sx_rec, 0) is 259 -> sx_spawn: 1
    sx_res: expr_call(0, sx_end - sx_start, sx_name, sx_args, sx_spawn, sx_tree, sx_node)
    syntax_arg_release(sx_aold, sx_acap, sx_amark)
    return sx_res
syntax_call_operand sx_tree sx_node sx_index sx_text:
    if sx_tree is 0 -> return expr(sx_text)
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_link: peek_i64(sx_rec, 32)
    sx_i: 0
    as long as sx_i < sx_index
        sx_link: peek_i64(sx_tree + 128 + sx_link * 40, 32)
        sx_i: sx_i + 1
    sx_child: peek_i64(sx_tree + 128 + sx_link * 40, 24)
    ex_depth: ex_depth + 1
    if ex_depth > 150
        if had_err is 0
            print "Error: expression too long, split it up"
            err_where()
            had_err: 1
        ex_depth: ex_depth - 1
        xor_rax()
        return 0
    sx_result: syntax_emit(sx_tree, sx_child)
    ex_depth: ex_depth - 1
    return sx_result
syntax_call_bin sx_tree sx_node sx_args sx_opname:
    sx_l: peek_i64(sx_args, 16)
    sx_r: peek_i64(sx_args, 24)
    if sx_tree is 0 -> return bin(sx_l, sx_r, sx_opname)
    return bin_k(sx_l, length(sx_l), sx_r, length(sx_r), intern_kid(sx_opname), sx_tree, sx_node)

syntax_call_text sx_tree sx_node:
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_source: peek_i64(sx_tree, 0)
    sx_start: peek_i64(sx_rec, 8)
    return sx_span_alloc(sx_source + sx_start, peek_i64(sx_rec, 16) - sx_start)
syntax_prefix sx_tree sx_node:
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_kind: peek_i64(sx_rec, 0)
    sx_source: peek_i64(sx_tree, 0)
    sx_child: peek_i64(sx_rec, 24)
    sx_lr: sx_tree + 128 + sx_child * 40
    sx_text: sx_arg_str(sx_source, sx_lr)
    if sx_kind is 258
        sx_rr: sx_tree + 128 + peek_i64(sx_rec, 32) * 40
        sx_index: sx_arg_str(sx_source, sx_rr)
        return expr_index(sx_text, sx_index, sx_tree, sx_node)
    if sx_kind is 262
        emit2(72, 184)
        sx_at: here()
        emit8(0)
        addp(sx_at, "fnaddr", sx_text)
        return 0
    if sx_kind is 260
        sx_known: cp_len_of(sx_text)
        if sx_known > 0 - 1
            rax_imm(sx_known)
            return 0
    syntax_operand(sx_tree, sx_node, 0, 0, 0)
    if sx_kind is 261 -> return 1
    mov_rdi_rax()
    used_sl: 1
    calln("_sov_strlen")
    return 0
syntax_fuse sx_source sx_inverse:
    sx_n: length(sx_source)
    if sx_n < 1 -> return 0 - 1
    if sx_n > 4096 -> return 0 - 1
    sx_old: syntax_storage
    sx_cap: syntax_storage_cap
    sx_mark: syntax_storage_used
    sx_need: 128 + (sx_n + 1) * 64
    if syntax_storage is 0
        syntax_storage: _sov_heap_alloc(1048576)
        syntax_storage_cap: 1048576
        syntax_storage_used: 0
    if syntax_storage_used + sx_need > syntax_storage_cap
        syntax_storage: _sov_heap_alloc(1048576)
        syntax_storage_cap: 1048576
        syntax_storage_used: 0
    sx_buffer: syntax_storage + syntax_storage_used
    syntax_storage_used: syntax_storage_used + sx_need
    sx_tree: syntax_build(sx_source, sx_n, sx_buffer)
    if sx_tree is 0
        syntax_release(sx_old, sx_cap, sx_mark)
        return 0 - 1
    if prof_mode is 1
        syntax_trees: syntax_trees + 1
        syntax_nodes: syntax_nodes + peek_i64(sx_tree, 16)
        if peek_i64(sx_tree, 56) is 86042493933125
            syntax_native_trees: syntax_native_trees + 1
    sx_jump: syntax_fuse_tree(sx_tree, sx_inverse)
    syntax_release(sx_old, sx_cap, sx_mark)
    return sx_jump
syntax_fuse_tree sx_tree sx_inverse:
    sx_source: peek_i64(sx_tree, 0)
    sx_node: peek_i64(sx_tree, 48)
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_kind: peek_i64(sx_rec, 0)
    sx_op: blank
    if sx_kind is 300 -> sx_op: "eq"
    if sx_kind is 301 -> sx_op: "ne"
    if sx_kind is 302 -> sx_op: "le"
    if sx_kind is 303 -> sx_op: "ge"
    if sx_kind is 60 -> sx_op: "lt"
    if sx_kind is 62 -> sx_op: "gt"
    sx_jump: 0 - 1
    if length(sx_op) > 0 and peek_i64(sx_tree, 120) is 0
        sx_lr: sx_tree + 128 + peek_i64(sx_rec, 24) * 40
        sx_rr: sx_tree + 128 + peek_i64(sx_rec, 32) * 40
        sx_lk: peek_i64(sx_lr, 0)
        sx_rk: peek_i64(sx_rr, 0)
        sx_ls: peek_i64(sx_lr, 8)
        sx_rs: peek_i64(sx_rr, 8)
        sx_lln: peek_i64(sx_lr, 16) - sx_ls
        sx_rln: peek_i64(sx_rr, 16) - sx_rs
        if sx_lk is 256 or sx_lk is 259
            fuse_operand(sx_tree, sx_node, 0, 0)
            if sx_rk is 264 and is_imm_n(sx_source + sx_rs, sx_rln) is 1
                cmp_rax_imm(peek_i64(sx_rr, 24))
                return fuse_jcc(sx_op, sx_inverse)
            push_rax()
            fuse_operand(sx_tree, sx_node, 1, 0)
            mov_rcx_rax()
            pop_rax()
            cmp_rax_rcx()
            return fuse_jcc(sx_op, sx_inverse)
        if sx_lk is 265 and sx_rk is 264
            if is_imm_n(sx_source + sx_rs, sx_rln) is 1
                sx_left: intern_kid_n(sx_source + sx_ls, sx_lln)
                sx_sl: bin_rslot(sx_left)
                if sx_sl > 0 - 1
                    cflush(sx_left)
                    cmp_reg_imm(sx_sl, peek_i64(sx_rr, 24))
                if not
                    fuse_operand(sx_tree, sx_node, 0, sx_left)
                    cmp_rax_imm(peek_i64(sx_rr, 24))
                return fuse_jcc(sx_op, sx_inverse)
        sx_left: 0
        if sx_lk is 265
            sx_left: intern_kid_n(sx_source + sx_ls, sx_lln)
        if not
            sx_left: sx_source + sx_ls
            if peek_byte(sx_source, sx_ls + sx_lln) is not 0
                sx_left: sx_span_alloc(sx_source + sx_ls, sx_lln)
        sx_right: 0
        if sx_rk is 265
            sx_right: intern_kid_n(sx_source + sx_rs, sx_rln)
        if not
            sx_right: sx_source + sx_rs
            if peek_byte(sx_source, sx_rs + sx_rln) is not 0
                sx_right: sx_span_alloc(sx_source + sx_rs, sx_rln)
        sx_jump: fuse_cmp_operands(sx_left, sx_right, sx_op, sx_inverse, sx_tree, sx_node)
    if not
        # Match the ordinary expr(cond) depth entry when fusion declines.
        ex_depth: ex_depth + 1
        syntax_emit(sx_tree, sx_node)
        ex_depth: ex_depth - 1
        test_rax()
        if sx_inverse is 1 -> sx_jump: jz()
        if sx_inverse is 0 -> sx_jump: jnz()
    return sx_jump

syntax_fx_parse sx_text sx_tree sx_node:
    if sx_tree is 0 -> return fx_parse(sx_text)
    sx_rec: sx_tree + 128 + sx_node * 40
    if peek_i64(sx_rec, 0) is not 256 -> return 0
    sx_src: peek_i64(sx_tree, 0)
    sx_name: sx_tree + 128 + peek_i64(sx_rec, 24) * 40
    sx_start: peek_i64(sx_name, 8)
    fx_pk: intern_kid_n(sx_src + sx_start, peek_i64(sx_name, 16) - sx_start)
    fx_al: _sov_list_new()
    sx_link: peek_i64(sx_rec, 32)
    as long as sx_link is not 0 - 1
        sx_ar: sx_tree + 128 + sx_link * 40
        sx_child: sx_tree + 128 + peek_i64(sx_ar, 24) * 40
        fx_al: _sov_list_add(fx_al, sx_arg_str(sx_src, sx_child))
        sx_link: peek_i64(sx_ar, 32)
    fx_ac: _sov_list_len(fx_al)
    return 1
syntax_fx_child sx_tree sx_node sx_side:
    sx_rec: sx_tree + 128 + sx_node * 40
    sx_link: peek_i64(sx_rec, 32)
    if sx_side is 1 -> sx_link: peek_i64(sx_tree + 128 + sx_link * 40, 32)
    return peek_i64(sx_tree + 128 + sx_link * 40, 24)
syntax_fx_ok_child sx_tree sx_node sx_side sx_text sx_k:
    if sx_tree is 0 -> return fx_ok(sx_text, sx_k)
    return fx_ok_ir(sx_text, sx_k, sx_tree, syntax_fx_child(sx_tree, sx_node, sx_side))
syntax_fx_emit_child sx_tree sx_node sx_side sx_text sx_k:
    if sx_tree is 0 -> return fx_emit(sx_text, sx_k)
    return fx_emit_ir(sx_text, sx_k, sx_tree, syntax_fx_child(sx_tree, sx_node, sx_side))
syntax_fx_leaf sx_text sx_tree sx_node:
    if sx_tree is 0 -> return fx_leaf_rax(sx_text)
    sx_rec: sx_tree + 128 + sx_node * 40
    if peek_i64(sx_rec, 0) is 264
        rax_imm(peek_i64(sx_rec, 24))
        return 1
    if peek_i64(sx_rec, 0) is 265
        loadv(sx_text)
        return 1
    ex_depth: ex_depth + 1
    if ex_depth > 150
        if had_err is 0
            print "Error: expression too long, split it up"
            err_where()
            had_err: 1
        ex_depth: ex_depth - 1
        xor_rax()
        return 0
    sx_result: syntax_emit(sx_tree, sx_node)
    ex_depth: ex_depth - 1
    return sx_result
