+#!/usr/bin/env python3
+"""Conservative source review tripwire, not a semantic proof of no caching.
+Flags additions/changes to cache-like definitions and sidecar literals against
+an explicit upstream inventory. Removing an inventoried construct is allowed.
+Canonical symbol/string interning is not translation-result caching.
+"""
+import argparse,hashlib,json,re
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+TOKEN=re.compile(r'\b\w*(?:cache|memo(?:iz\w*|(?=_|\b))|replay|prebuilt)\w*\b|\b(?:wid_last_\w+|ik_last_\w+|ml_cut_\w+)\b',re.I)
+EXT=re.compile(r'\.(?:ac(?:\.bin)?|lsug|sug|plk|deepoc|state_o)\b|\.prebuilt\b')
+def inventory(root):
+ result={}
+ files=[root/'runtime.sov',root/'compilers/linux/compiler.sov',*sorted((root/'compilers/shared').glob('*.sov'))]
+ for p in files:
+  text=p.read_text();rel=str(p.relative_to(root));lines=text.splitlines(keepends=True)
+  starts=[i for i,l in enumerate(lines) if l and not l[0].isspace() and re.match(r'\w+(?:\s+\w+)*:\s*(?:#.*)?$',l.strip())]
+  for j,start in enumerate(starts):
+   stop=starts[j+1] if j+1<len(starts) else len(lines)
+   code=''.join(l.split('#',1)[0] for l in lines[start:stop]);hits=TOKEN.findall(code)
+   if hits:
+    key=rel+'::'+lines[start].strip().split(':')[0]
+    result[key]={'sha256':hashlib.sha256(code.encode()).hexdigest(),'tokens':sorted(set(hits))}
+  # Strings are intentionally included: source spellings of persistent output
+  # sidecars should require review even if they occur only in flag diagnostics.
+  literals=sorted(set(EXT.findall('\n'.join(l.split('#',1)[0] for l in lines))))
+  if literals:result[rel+'::sidecar-literals']={'literals':literals}
+ return result
+if __name__=='__main__':
+ ap=argparse.ArgumentParser();ap.add_argument('--inventory-root');ap.add_argument('--baseline',default=str(ROOT/'tools/no_cache_inventory.json'));a=ap.parse_args()
+ current=inventory(Path(a.inventory_root) if a.inventory_root else ROOT)
+ if a.inventory_root:
+  print(json.dumps({'schema':1,'note':'Existing upstream constructs: inventory, not endorsement of result caching. Changes require explicit review.','constructs':current},indent=2));raise SystemExit()
+ baseline=json.loads(Path(a.baseline).read_text())['constructs'];bad=[k for k,v in current.items() if baseline.get(k)!=v]
+ if bad:
+  print('NO-CACHE REVIEW REQUIRED: '+', '.join(bad));raise SystemExit(1)
+ print(f'no-cache source tripwire OK ({len(current)} inherited constructs unchanged; no new sidecar literals)')
