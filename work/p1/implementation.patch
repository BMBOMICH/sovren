+# Per-compilation primary text-type dependency graph. This is semantic state,
+# not saved/replayed compilation output. Nodes are tasks and scoped variables;
+# text literals/casts seed a worklist, reverse edges propagate forward types.
+st_need: 0
+st_edges: 0
+st_done: 0
+st_vars: 0
+st_ids: 0
+st_node kind:
+    ix: _sov_list_len(st_need)
+    st_need: _sov_list_add(st_need, kind)
+    st_edges: _sov_list_add(st_edges, _sov_list_new())
+    st_done: _sov_list_add(st_done, 0)
+    return ix
+st_var name:
+    vi: list_idx(st_vars, name)
+    if vi >= 0
+        return peek_i64(st_ids, 16 + vi * 8)
+    ni: st_node(0)
+    st_vars: _sov_list_add(st_vars, name)
+    st_ids: _sov_list_add(st_ids, ni)
+    return ni
+st_edge source target:
+    cnt: peek_i64(st_need, 16 + target * 8)
+    if cnt >= 0
+        poke_i64(st_need, 16 + target * 8, cnt + 1)
+    if source > 0
+        adj: peek_i64(st_edges, 16 + source * 8)
+        adj: _sov_list_add(adj, target)
+        poke_i64(st_edges, 16 + source * 8, adj)
+    return 0
+st_expr e0 dep:
+    if dep > 32
+        return 0
+    e: strip(e0)
+    en: length(e)
+    if is_lit(e) is 1
+        return 1
+    if starts(e, "as text ") is 1
+        return 1
+    if starts(e, "as ptr ") is 1
+        return 1
+    if en > 8
+        if sg_match(e, en - 8, " as text") is 1
+            return 1
+    if en > 7
+        if sg_match(e, en - 7, " as ptr") is 1
+            return 1
+    if en > 1
+        if peek_byte(e, 0) is 40
+            if licm2_match(e, 0) is en - 1
+                return st_expr(cut(e, 1, en - 1), dep + 1)
+    if expr_atom(e) is 1
+        if digitb(peek_byte(e, 0)) is 1
+            return 0
+        vi: list_idx(st_vars, e)
+        if vi >= 0
+            return peek_i64(st_ids, 16 + vi * 8)
+        if sg_lookup(e) >= 0
+            return 1
+        return 0
+    lp: cfind1(e, 40)
+    if lp > 0
+        if licm2_match(e, lp) is en - 1
+            nm: strip(cut(e, 0, lp))
+            if expr_atom(nm) is 1
+                if sf_lookup(nm) >= 0
+                    return 1
+                fi: nm_lookup(nm)
+                if fi >= 0
+                    # Identity returns stay parametric: specialize the returned
+                    # parameter at this expression, not every call to the task.
+                    pk: peek_i64(ret_par, 16 + fi * 8)
+                    if pk >= 0
+                        args: split_args(cut(e, lp + 1, en - 1), _sov_list_new())
+                        if pk < _sov_list_len(args)
+                            return st_expr(peek_i64(args, 16 + pk * 8), dep + 1)
+                    return fi + 2
+    return 0
+st_build:
+    st_need: _sov_list_new()
+    st_edges: _sov_list_new()
+    st_done: _sov_list_new()
+    zz: st_node(0)
+    zz: st_node(0)
+    fi: 0
+    nn: _sov_list_len(names)
+    as long as fi < nn
+        zz: st_node(0 - 1)
+        fi: fi + 1
+    fi: 0
+    as long as fi < nn
+        st_vars: _sov_list_new()
+        st_ids: _sov_list_new()
+        bl: peek_i64(bodies, 16 + fi * 8)
+        ps: peek_i64(params, 16 + fi * 8)
+        pi: 0
+        as long as pi < _sov_list_len(ps)
+            zz: st_var(peek_i64(ps, 16 + pi * 8))
+            # A runtime parameter is unknown unless its actual argument is
+            # considered at a parametric call site. Do not assume text.
+            st_edge(0, zz)
+            pi: pi + 1
+        bi: 0
+        as long as bi < _sov_list_len(bl)
+            line: strip(peek_i64(bl, 16 + bi * 8))
+            if starts(line, "immutable ") is 1
+                line: strip(cut(line, 10, length(line)))
+            co: find_col(line)
+            if co > 0
+                nm: strip(cut(line, 0, co))
+                if expr_atom_word(nm) is 1
+                    zz: st_var(nm)
+            bi: bi + 1
+        bi: 0
+        as long as bi < _sov_list_len(bl)
+            line: strip(peek_i64(bl, 16 + bi * 8))
+            if starts(line, "immutable ") is 1
+                line: strip(cut(line, 10, length(line)))
+            if starts(line, "return ") is 1
+                st_edge(st_expr(cut(line, 7, length(line)), 0), fi + 2)
+            if not
+                co: find_col(line)
+                if co > 0
+                    nm: strip(cut(line, 0, co))
+                    if expr_atom_word(nm) is 1
+                        vn: st_var(nm)
+                        st_edge(st_expr(cut(line, co + 1, length(line)), 0), vn)
+            bi: bi + 1
+        fi: fi + 1
+    queue: _sov_list_new()
+    queue: _sov_list_add(queue, 1)
+    poke_i64(st_done, 24, 1)
+    qi: 0
+    as long as qi < _sov_list_len(queue)
+        ni: peek_i64(queue, 16 + qi * 8)
+        adj: peek_i64(st_edges, 16 + ni * 8)
+        ai: 0
+        as long as ai < _sov_list_len(adj)
+            dst: peek_i64(adj, 16 + ai * 8)
+            need: peek_i64(st_need, 16 + dst * 8)
+            if need > 0
+                need: need - 1
+                poke_i64(st_need, 16 + dst * 8, need)
+            if need <= 0
+                if peek_i64(st_done, 16 + dst * 8) is 0
+                    poke_i64(st_done, 16 + dst * 8, 1)
+                    queue: _sov_list_add(queue, dst)
+                    if dst >= 2
