+                            mark_fn_str(peek_i64(names, 16 + (dst - 2) * 8))
+            ai: ai + 1
+        qi: qi + 1
+    # The semantic result is now in str_fns; graph scratch is not reused by
+    # another compilation and no source or emitted artifact is replayed.
+    return 0
+
+# Debug points are ordinary numeric patch records. Every compaction and
+# parallel merge already relocates these records; no stale raw PCs survive.
+dbg_collect: 0
+dbg_active: 0
+dbg_tops: 0
+tops_users: 0
+dbg_decimal v:
+    if v is 0
+        return "0"
+    out: ""
+    as long as v > 0
+        out: join(cut("0123456789", v % 10, v % 10 + 1), out)
+        v: v / 10
+    return out
+dbg_write path:
+    if dbg_collect is 0
+        return 0
+    out: join("# src_base ", join(dbg_decimal(src_base), "\n"))
+    di: 0
+    as long as di < _sov_list_len(patch_at)
+        if _sov_str_eq(peek_i64(patch_kind, 16 + di * 8), "debug") is 1
+            pc: peek_i64(patch_at, 16 + di * 8) + HDR
+            ln: peek_i64(patch_val, 16 + di * 8)
+            out: join(out, join(dbg_decimal(pc), join(" ", join(dbg_decimal(ln), "\n"))))
+        di: di + 1
+    if file_write_all(join(path, ".map"), out) is 0
+        print "Error: cannot write debug map"
+        fail()
