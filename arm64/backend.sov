# backend.sov — AArch64 back end for Sovren
# Replaces the x86-64 code generator. Register map:
#   x0  value register (was rax)      x1  second operand (was rcx)
#   x19..x23  locals 0..4             x29 frame pointer, x30 link
#   x9,x10..x15  scratch              x8  syscall number
# Every instruction is 4 bytes, little endian.

emitw w:
    v: w
    if v < 0
        v: v + 4294967296
    emit(v % 256)
    emit((v / 256) % 256)
    emit((v / 65536) % 256)
    emit((v / 16777216) % 256)

movz_x d imm sh:
    emitw(3531603968 + sh * 2097152 + (imm % 65536) * 32 + d)

movk_x d imm sh:
    emitw(4068474880 + sh * 2097152 + (imm % 65536) * 32 + d)

set_reg d n:
    v: n
    if v < 0
        v: v + 18446744073709551616
    movz_x(d, v % 65536, 0)
    p1: (v / 65536) % 65536
    if p1 is not 0
        movk_x(d, p1, 1)
    p2: (v / 4294967296) % 65536
    if p2 is not 0
        movk_x(d, p2, 2)
    p3: (v / 281474976710656) % 65536
    if p3 is not 0
        movk_x(d, p3, 3)

rax_imm n:
    set_reg(0, n)

rdi_imm n:
    set_reg(1, n)

# mov xD, xS   (orr xD, xzr, xS)
mov_reg d s:
    emitw(2852127712 + s * 65536 + d)

# str x0,[sp,#-16]!
push_rax:
    emitw(4162785248)

# ldr xN,[sp],#16
pop_reg n:
    emitw(4165011424 + n)

pop_rax:
    pop_reg(0)

pop_rcx:
    pop_reg(1)

ret:
    emitw(3596551104)

xor_rax:
    emitw(2854159328)

mov_rdi_rax:
    mov_reg(1, 0)

mov_rsi_rax:
    mov_reg(2, 0)

mov_rcx_rax:
    mov_reg(1, 0)

mov_rax_rdi:
    mov_reg(0, 1)

add_rax_rcx:
    emitw(2332098560)

sub_rax_rcx:
    emitw(3405840384)

imul_rax_rcx:
    emitw(2600565760)

# x0 = x0 / x1
sdiv_rax_rcx:
    emitw(2596342784)

# x0 = x0 % x1   (sdiv x2,x0,x1 ; msub x0,x2,x1,x0)
mod_rax_rcx:
    emitw(2596342786)
    emitw(2600566848)

cmp_rax_rcx:
    emitw(3942711327)

test_rax:
    emitw(4043309087)

setcc op:
    if same(op, "eq") is 1
        emitw(2594117600)
        return
    if same(op, "ne") is 1
        emitw(2594113504)
        return
    if same(op, "lt") is 1
        emitw(2594154464)
        return
    if same(op, "gt") is 1
        emitw(2594166752)
        return
    if same(op, "le") is 1
        emitw(2594162656)
        return
    if same(op, "ge") is 1
        emitw(2594158560)
        return

loc_reg slot:
    return 19 + slot

# ldr xD,[x29,#off]
# ldur xD,[x29,#-off]   off is a positive byte count
ldr_fp d off:
    n: 512 - off
    emitw(4164944800 + n * 4096 + d)

# str xS,[x29,#off]
# stur xS,[x29,#-off]
str_fp s off:
    n: 512 - off
    emitw(4160750496 + n * 4096 + s)

load_loc slot:
    if slot < 5
        mov_reg(0, loc_reg(slot))
        return
    ldr_fp(0, (slot - 5) * 8 + 8)

store_loc slot:
    if slot < 5
        mov_reg(loc_reg(slot), 0)
        return
    str_fp(0, (slot - 5) * 8 + 8)

# globals: address built with movz+movk+movk, patched as glob64
load_glob name:
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", name)
    emitw(4181721376)

store_glob name:
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", name)
    emitw(4177527072)

calln name:
    at: here()
    emitw(2483027968)
    addp(at, "rel26", name)

jmp:
    at: here()
    emitw(335544320)
    return at

# b.eq — taken when the previous cmp set Z (value was zero)
jz:
    at: here()
    emitw(1409286144)
    return at

jnz:
    at: here()
    emitw(1409286145)
    return at

# b.hs — unsigned greater-or-equal, used by bounds checks
jae:
    at: here()
    emitw(1409286146)
    return at

# stp x29,x30,[sp,#-16]! ; mov x29,sp ; sub sp,sp,#N (patched)
prolog:
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    pro_at: here()
    emitw(3506439167)

# ldp x29,x30,[sp],#16
leave:
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)

copyargs n:
    i: 0
    as long as i < n
        if i < 5
            mov_reg(loc_reg(i), i)
        if not
            str_fp(i, (i - 5) * 8 + 8)
        i: i + 1

sysc:
    emitw(3556769793)

# ---- memory access ----

# ldrb w0,[x0,x1]
ldrb_x0_x0x1:
    emitw(945907712)

# strb w2,[x0,x1]
strb_x2_x0x1:
    emitw(941713410)

# ldr x0,[x0,x1]
ldr_x0_x0x1:
    emitw(4167133184)

# str x2,[x0,x1]
str_x2_x0x1:
    emitw(4162938882)

# ldur x9,[x0,#-8]  — read the allocation length header
ldur_len:
    emitw(4167008265)

# cmp x1,x9  — index against length
cmp_idx_len:
    emitw(3943235647)

chk_mem extra:
    if has_vm is 1
        return
    used_tr: 1
    cbz_at: here()
    emitw(3019898880)
    addp(cbz_at, "cbz_trap", 0)
    ldur_len()
    if extra is 1
        cmp_idx_len()
        at: here()
        emitw(1409286146)
        addp(at, "b19_trap", 0)
    if not
        emitw(2432704513)
        emitw(3943235647)
        at: here()
        emitw(1409286146)
        addp(at, "b19_trap", 0)

chk_zrcx:
    if has_vm is 1
        return
    used_tr: 1
    at: here()
    emitw(3019898881)
    addp(at, "cbz_trap", 1)

# write(1, str, n) with a literal
emit_write_lit s:
    n: length(s)
    set_reg(0, 1)
    off: intern_nz(s)
    at: here()
    movz_x(1, 0, 0)
    movk_x(1, 0, 1)
    movk_x(1, 0, 2)
    addp(at, "str64", off)
    set_reg(2, n)
    set_reg(8, 64)
    sysc()

# mmap(0, sz, RW, PRIVATE|ANON, -1, 0) -> x0
emit_mmap:
    set_reg(0, 0)
    set_reg(1, mmap_sz)
    set_reg(2, 3)
    set_reg(3, 34)
    emitw(2457862148)
    set_reg(5, 0)
    set_reg(8, 222)
    sysc()

emit_mmap_k n:
    set_reg(0, 0)
    set_reg(1, n + 2097152)
    set_reg(2, 3)
    set_reg(3, 34)
    emitw(2457862148)
    set_reg(5, 0)
    set_reg(8, 222)
    sysc()

# _start: x0 = argc from [sp], x1 = argv = sp+8
emit_start:
    emitw(4181722080)
    emitw(2432705505)
    at: here()
    emitw(2483027968)
    addp(at, "rel26", "main")
    set_reg(0, 0)
    set_reg(8, 93)
    sysc()

emit_trap_stub:
    fn_names: _sov_list_add(fn_names, "_sov_trap")
    fn_offs: _sov_list_add(fn_offs, here())
    emit_write_lit("trap\n")
    set_reg(0, 1)
    set_reg(8, 93)
    sysc()
