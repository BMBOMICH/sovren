# patch_arm64.sov — AArch64 branch patching
# x86 writes a flat 32-bit offset. ARM packs the offset into instruction bits:
#   b / bl   : 26-bit word offset in bits 0..25   (top byte 0x14 / 0x94)
#   b.cond   : 19-bit word offset in bits 5..23   (top byte 0x54)
# Offsets are in words (bytes / 4), signed, relative to the branch itself.

# read the 4 bytes already emitted at `at`
oc_word at:
    b0: _sov_list_get(oc, at)
    b1: _sov_list_get(oc, at + 1)
    b2: _sov_list_get(oc, at + 2)
    b3: _sov_list_get(oc, at + 3)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

oc_set_word at v:
    x: v
    if x < 0
        x: x + 4294967296
    oc: _sov_list_set(oc, at, x % 256)
    oc: _sov_list_set(oc, at + 1, (x / 256) % 256)
    oc: _sov_list_set(oc, at + 2, (x / 65536) % 256)
    oc: _sov_list_set(oc, at + 3, (x / 16777216) % 256)
    return 0

# byte offset -> signed word offset
word_off delta:
    d: delta / 4
    return d

# put a 26-bit offset into a b / bl already at `at`
put26 at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    d: word_off(delta)
    if d < 0
        d: d + 67108864
    base: top * 16777216
    oc_set_word(at, base + (d % 67108864))
    return 0

# put a 19-bit offset into a b.cond already at `at`
put19 at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    cond: w % 32
    d: word_off(delta)
    if d < 0
        d: d + 524288
    base: top * 16777216
    oc_set_word(at, base + (d % 524288) * 32 + cond)
    return 0

# ARM version of `put`: choose by instruction type
put_arm at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    if top is 84
        put19(at, delta)
        return 0
    put26(at, delta)
    return 0

# ARM version of `patch`: branch at `at` jumps to the current position
patch_arm at:
    put_arm(at, here() - at)
    return 0
