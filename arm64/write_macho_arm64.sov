write_elf path:
    if had_err is 1
        return
    clen: _sov_list_len(oc)
    sl: _sov_buf_len(strb)
    str_off: clen
    if _sov_list_len(glob_names) > 0
        as long as str_off % 8 is not 0
            oc: _sov_list_add(oc, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(glob_names) * 8
    hdr: 368
    filesz: hdr + clen + sl + pad
    vmsz: filesz
    as long as vmsz % 4096 is not 0
        vmsz: vmsz + 1
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    poke4(flat, 0, 4277009103)
    poke4(flat, 4, 16777228)
    poke4(flat, 8, 0)
    poke4(flat, 12, 2)
    poke4(flat, 16, 3)
    poke4(flat, 20, 328)
    poke4(flat, 24, 1)
    poke4(flat, 32, 25)
    poke4(flat, 36, 72)
    dummy: _sov_set_byte(flat, 40, 95)
    dummy: _sov_set_byte(flat, 41, 95)
    dummy: _sov_set_byte(flat, 42, 80)
    dummy: _sov_set_byte(flat, 43, 65)
    dummy: _sov_set_byte(flat, 44, 71)
    dummy: _sov_set_byte(flat, 45, 69)
    dummy: _sov_set_byte(flat, 46, 90)
    dummy: _sov_set_byte(flat, 47, 69)
    dummy: _sov_set_byte(flat, 48, 82)
    dummy: _sov_set_byte(flat, 49, 79)
    poke8(flat, 64, 4294967296)
    poke4(flat, 104, 25)
    poke4(flat, 108, 72)
    dummy: _sov_set_byte(flat, 112, 95)
    dummy: _sov_set_byte(flat, 113, 95)
    dummy: _sov_set_byte(flat, 114, 84)
    dummy: _sov_set_byte(flat, 115, 69)
    dummy: _sov_set_byte(flat, 116, 88)
    dummy: _sov_set_byte(flat, 117, 84)
    poke8(flat, 128, 4294967296)
    poke8(flat, 136, vmsz)
    poke8(flat, 152, filesz)
    poke4(flat, 160, 7)
    poke4(flat, 164, 7)
    poke4(flat, 176, 5)
    poke4(flat, 180, 184)
    poke4(flat, 184, 4)
    poke4(flat, 188, 42)
    poke8(flat, 320, 4294967296 + hdr)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, hdr + i, _sov_list_get(oc, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, hdr + str_off + si, _sov_buf_at(strb, si))
        si: si + 1
    str_addr: 4294967296 + hdr + str_off
    glob_addr: 4294967296 + hdr + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_val, i)
        if same(kind, "rel") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: tgt - (at + 4)
                poke4(flat, hdr + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "str") is 1
            poke8(flat, hdr + at, str_addr + val)
        if same(kind, "str32") is 1
            poke4(flat, hdr + at, str_addr + val)
        if same(kind, "ripstr") is 1
            poke4(flat, hdr + at, str_off + val - at - 4)
        if same(kind, "glob") is 1
            gx: idx(glob_names, val)
            poke8(flat, hdr + at, glob_addr + gx * 8)
        i: i + 1
    if had_err is 1
        return
    _sov_write_n(path, flat, filesz)
    _sov_chmod(path, 493)