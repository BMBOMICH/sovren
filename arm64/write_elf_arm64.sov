write_elf path:
    if had_err is 1
        return
    clen: _sov_list_len(oc)
    sl: _sov_buf_len(strb)
    str_off: clen
    if _sov_list_len(glob_names) > 0
        as long as str_off % 8 is not 0
            oc: _sov_list_add(oc, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(glob_names) * 8
    filesz: HDR + clen + sl + pad
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    dummy: _sov_set_byte(flat, 0, 127)
    dummy: _sov_set_byte(flat, 1, 69)
    dummy: _sov_set_byte(flat, 2, 76)
    dummy: _sov_set_byte(flat, 3, 70)
    dummy: _sov_set_byte(flat, 4, 2)
    dummy: _sov_set_byte(flat, 5, 1)
    dummy: _sov_set_byte(flat, 6, 1)
    poke2(flat, 16, 2)
    poke2(flat, 18, 183)
    poke4(flat, 20, 1)
    moff: 0
    if thin_main is 1
        mi: idx(fn_names, "main")
        if mi > 0 - 1
            moff: _sov_list_get(fn_offs, mi)
    poke8(flat, 24, BASE + HDR + moff)
    poke8(flat, 32, 64)
    poke2(flat, 52, 64)
    poke2(flat, 54, 56)
    poke2(flat, 56, 1)
    poke4(flat, 64, 1)
    poke4(flat, 68, 7)
    poke8(flat, 80, BASE)
    poke8(flat, 88, BASE)
    poke8(flat, 96, filesz)
    poke8(flat, 104, filesz + 65536)
    poke8(flat, 112, 4096)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, HDR + i,  _sov_list_get(oc, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, HDR + str_off + si, _sov_buf_at(strb, si))
        si: si + 1
    str_addr: BASE + HDR + str_off
    glob_addr: BASE + HDR + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_val, i)
        if same(kind, "rel") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: tgt - (at + 4)
                poke4(flat, HDR + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "str") is 1
            poke8(flat, HDR + at, str_addr + val)
        if same(kind, "str32") is 1
            poke4(flat, HDR + at, str_addr + val)
        if same(kind, "glob") is 1
            gx: idx(glob_names, val)
            poke8(flat, HDR + at, glob_addr + gx * 8)
        i: i + 1
    if had_err is 1
        return
    _sov_write_n(path, flat, filesz)
    _sov_chmod(path, 493)