# backend2.sov — remaining AArch64 emitters
# Every raw word below was produced by an encoder and confirmed with a
# disassembler; the runtime helpers were then executed on an emulated ARM64 CPU.

inc_var name:
    loadv(name)
    rdi_imm(1)
    add_rax_rcx()
    storev(name)

dec_var name:
    loadv(name)
    rdi_imm(1)
    sub_rax_rcx()
    storev(name)

add_into dest src:
    loadv(dest)
    push_rax()
    loadv(src)
    mov_rcx_rax()
    pop_rax()
    add_rax_rcx()
    storev(dest)

add_imm name n:
    loadv(name)
    rdi_imm(n)
    add_rax_rcx()
    storev(name)

jle:
    at: here()
    emitw(1409286157)
    return at

jb:
    at: here()
    emitw(1409286147)
    return at

chk_ov:
    return

emit_nodump:
    return

# x86 string-instruction fast paths have no AArch64 form.
# Returning 0 makes the caller emit an ordinary loop instead.
emit_rep_movs dst src iv lim:
    return 0

emit_rep_stos ptr iv lim:
    return 0

try_opt_while cond blines:
    return 0

emit_sum_closed acc iv lim:
    return 0

# ---- runtime helpers ----

# x0 = pointer, returns the length in x0
emit_strlen:
    fn_names: _sov_list_add(fn_names, "_sov_strlen")
    fn_offs: _sov_list_add(fn_offs, here())
    mov_reg(9, 0)
    set_reg(0, 0)
    top: here()
    emitw(945842475)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432697344)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_arm(ex, here() - ex)
    ret()

# x0, x1 = two pointers, returns 1 when the text matches
emit_streq:
    fn_names: _sov_list_add(fn_names, "_sov_str_eq")
    fn_offs: _sov_list_add(fn_offs, here())
    mov_reg(9, 0)
    mov_reg(10, 1)
    set_reg(11, 0)
    top: here()
    emitw(2332754220)
    emitw(2332754253)
    emitw(960496014)
    emitw(960496047)
    emitw(1796145631)
    ne: here()
    emitw(1409286145)
    emitw(1895825887)
    eq: here()
    emitw(1409286144)
    emitw(2432697707)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_arm(ne, here() - ne)
    set_reg(0, 0)
    ret()
    put_arm(eq, here() - eq)
    set_reg(0, 1)
    ret()

# x0 = pointer, writes the text then a newline
emit_print:
    fn_names: _sov_list_add(fn_names, "_sov_print")
    fn_offs: _sov_list_add(fn_offs, here())
    # a value under 65536 is not a real address. reading from it
    # would crash, so hand it to the number printer instead.
    emitw(4047519775)
    hi: here()
    emitw(1409286146)
    used_pi: 1
    calln("_sov_print_int")
    ret()
    put_arm(hi, here() - hi)
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    mov_reg(19, 0)
    mov_reg(9, 19)
    set_reg(20, 0)
    top: here()
    emitw(2333344042)
    emitw(960495947)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432698004)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_arm(ex, here() - ex)
    set_reg(0, 1)
    mov_reg(1, 19)
    mov_reg(2, 20)
    set_reg(8, 64)
    sysc()
    set_reg(0, 1)
    nl_at: here()
    movz_x(1, 0, 0)
    movk_x(1, 0, 1)
    movk_x(1, 0, 2)
    addp(nl_at, "str64", intern_nz("\n"))
    set_reg(2, 1)
    set_reg(8, 64)
    sysc()
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)
    ret()

# x0 = number, writes it in decimal then a newline
emit_print_int:
    fn_names: _sov_list_add(fn_names, "_sov_print_int")
    fn_offs: _sov_list_add(fn_offs, here())
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    emitw(3506488319)
    mov_reg(9, 0)
    set_reg(21, 0)
    emitw(4043309375)
    ng: here()
    emitw(1409286154)
    set_reg(21, 1)
    emitw(3406365673)
    put_arm(ng, here() - ng)
    emitw(2432746474)
    set_reg(11, 10)
    emitw(3506439498)
    emitw(956301643)
    set_reg(12, 10)
    d: here()
    emitw(2597062957)
    emitw(2601297326)
    emitw(2432745934)
    emitw(3506439498)
    emitw(956301646)
    mov_reg(9, 13)
    emitw(4043309375)
    bn: here()
    emitw(1409286145)
    put_arm(bn, d - bn)
    emitw(4043309759)
    ns: here()
    emitw(1409286144)
    emitw(3506439498)
    set_reg(11, 45)
    emitw(956301643)
    put_arm(ns, here() - ns)
    set_reg(0, 1)
    mov_reg(1, 10)
    emitw(2432746466)
    emitw(3406430274)
    set_reg(8, 64)
    sysc()
    emitw(2432746495)
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)
    ret()

# x0 = size, returns a pointer with an 8 byte length header behind it
emit_alloc:
    fn_names: _sov_list_add(fn_names, "_sov_alloc")
    fn_offs: _sov_list_add(fn_offs, here())
    mov_reg(13, 0)
    gl: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(gl, "glob64", "heap_ptr")
    emitw(4181721386)
    emitw(4043309407)
    nz: here()
    emitw(1409286145)
    emit_mmap()
    mov_reg(10, 0)
    put_arm(nz, here() - nz)
    emitw(4177527117)
    emitw(2432704843)
    emitw(2332885356)
    emitw(2432703884)
    emitw(2457727372)
    gs: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(gs, "glob64", "heap_ptr")
    emitw(4177527084)
    mov_reg(0, 11)
    ret()
