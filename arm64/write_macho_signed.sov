write_elf path:
    if had_err is 1
        return
    clen: _sov_list_len(oc)
    sl: _sov_buf_len(strb)
    str_off: clen
    if _sov_list_len(glob_names) > 0
        as long as str_off % 8 is not 0
            oc: _sov_list_add(oc, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(glob_names) * 8
    hdr: 384
    codelim: hdr + clen + sl + pad
    as long as codelim % 16 is not 0
        codelim: codelim + 1
    npages: codelim / 4096
    if codelim % 4096 is not 0
        npages: npages + 1
    cd_len: 88 + npages * 32
    sig_len: 12 + 8 + cd_len
    filesz: codelim + sig_len
    vmsz: filesz
    as long as vmsz % 4096 is not 0
        vmsz: vmsz + 1
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    poke4(flat, 0, 4277009103)
    poke4(flat, 4, 16777228)
    poke4(flat, 8, 0)
    poke4(flat, 12, 2)
    poke4(flat, 16, 4)
    poke4(flat, 20, 344)
    poke4(flat, 24, 1)
    poke4(flat, 32, 25)
    poke4(flat, 36, 72)
    dummy: _sov_set_byte(flat, 40, 95)
    dummy: _sov_set_byte(flat, 41, 95)
    dummy: _sov_set_byte(flat, 42, 80)
    dummy: _sov_set_byte(flat, 43, 65)
    dummy: _sov_set_byte(flat, 44, 71)
    dummy: _sov_set_byte(flat, 45, 69)
    dummy: _sov_set_byte(flat, 46, 90)
    dummy: _sov_set_byte(flat, 47, 69)
    dummy: _sov_set_byte(flat, 48, 82)
    dummy: _sov_set_byte(flat, 49, 79)
    poke8(flat, 64, 4294967296)
    poke4(flat, 104, 25)
    poke4(flat, 108, 72)
    dummy: _sov_set_byte(flat, 112, 95)
    dummy: _sov_set_byte(flat, 113, 95)
    dummy: _sov_set_byte(flat, 114, 84)
    dummy: _sov_set_byte(flat, 115, 69)
    dummy: _sov_set_byte(flat, 116, 88)
    dummy: _sov_set_byte(flat, 117, 84)
    poke8(flat, 128, 4294967296)
    poke8(flat, 136, vmsz)
    poke8(flat, 152, filesz)
    poke4(flat, 160, 7)
    poke4(flat, 164, 7)
    poke4(flat, 176, 5)
    poke4(flat, 180, 184)
    poke4(flat, 184, 4)
    poke4(flat, 188, 42)
    poke8(flat, 320, 4294967296 + hdr)
    poke4(flat, 360, 29)
    poke4(flat, 364, 16)
    poke4(flat, 368, codelim)
    poke4(flat, 372, sig_len)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, hdr + i, _sov_list_get(oc, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, hdr + str_off + si, _sov_buf_at(strb, si))
        si: si + 1
    str_addr: 4294967296 + hdr + str_off
    glob_addr: 4294967296 + hdr + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_val, i)
        if same(kind, "rel26") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: (tgt - at) / 4
                if rel < 0
                    rel: rel + 67108864
                poke4(flat, hdr + at, 2483027968 + (rel % 67108864))
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "b26") is 1
            poke4(flat, hdr + at, 335544320 + (val % 67108864))
        if same(kind, "glob64") is 1
            gx: idx(glob_names, val)
            ga: glob_addr + gx * 8
            poke4(flat, hdr + at, 3531603968 + (ga % 65536) * 32 + 9)
            poke4(flat, hdr + at + 4, 4070572032 + ((ga / 65536) % 65536) * 32 + 9)
            poke4(flat, hdr + at + 8, 4072669184 + ((ga / 4294967296) % 65536) * 32 + 9)
        if same(kind, "str64x0") is 1
            sa: str_addr + val
            poke4(flat, hdr + at, 3531603968 + (sa % 65536) * 32)
            poke4(flat, hdr + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32)
            poke4(flat, hdr + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32)
        if same(kind, "str64") is 1
            sa: str_addr + val
            poke4(flat, hdr + at, 3531603968 + (sa % 65536) * 32 + 1)
            poke4(flat, hdr + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32 + 1)
            poke4(flat, hdr + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32 + 1)
        if same(kind, "cbz_trap") is 1
            ti: idx(fn_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(fn_offs, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, hdr + at, 3019898880 + (rl % 524288) * 32 + val)
        if same(kind, "b19_trap") is 1
            ti: idx(fn_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(fn_offs, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, hdr + at, 1409286144 + (rl % 524288) * 32 + 2)
        if same(kind, "rel") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: tgt - (at + 4)
                poke4(flat, hdr + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "str") is 1
            poke8(flat, hdr + at, str_addr + val)
        if same(kind, "str32") is 1
            poke4(flat, hdr + at, str_addr + val)
        if same(kind, "ripstr") is 1
            poke4(flat, hdr + at, str_off + val - at - 4)
        if same(kind, "glob") is 1
            gx: idx(glob_names, val)
            poke8(flat, hdr + at, glob_addr + gx * 8)
        i: i + 1
    if had_err is 1
        return
    sig: codelim
    poke4be(flat, sig, 4208856256)
    poke4be(flat, sig + 4, sig_len)
    poke4be(flat, sig + 8, 1)
    poke4be(flat, sig + 12, 0)
    poke4be(flat, sig + 16, 20)
    cd: sig + 20
    poke4be(flat, cd, 4208856066)
    poke4be(flat, cd + 4, cd_len)
    poke4be(flat, cd + 8, 132096)
    poke4be(flat, cd + 12, 2)
    poke4be(flat, cd + 16, 88)
    poke4be(flat, cd + 20, 44)
    poke4be(flat, cd + 24, 0)
    poke4be(flat, cd + 28, npages)
    poke4be(flat, cd + 32, codelim)
    dummy: _sov_set_byte(flat, cd + 36, 32)
    dummy: _sov_set_byte(flat, cd + 37, 2)
    dummy: _sov_set_byte(flat, cd + 38, 0)
    dummy: _sov_set_byte(flat, cd + 39, 12)
    poke4be(flat, cd + 40, 0)
    so_name("sovren", flat, cd + 44)
    pg: 0
    as long as pg < npages
        plen: 4096
        if (pg * 4096) + 4096 > codelim
            plen: codelim - (pg * 4096)
        ph: sha256_bytes(flat + pg * 4096, plen)
        hj: 0
        as long as hj < 8
            hv: peek_i64(ph, hj * 8)
            poke4be(flat, cd + 88 + pg * 32 + hj * 4, hv)
            hj: hj + 1
        pg: pg + 1
    _sov_write_n(path, flat, filesz)
    _sov_chmod(path, 493)
poke4be p at v:
    x: v
    if x < 0
        x: x + 4294967296
    dummy: _sov_set_byte(p, at, (x / 16777216) % 256)
    dummy: _sov_set_byte(p, at + 1, (x / 65536) % 256)
    dummy: _sov_set_byte(p, at + 2, (x / 256) % 256)
    dummy: _sov_set_byte(p, at + 3, x % 256)
    return 0

so_name s flat at:
    i: 0
    as long as i < length(s)
        dummy: _sov_set_byte(flat, at + i, _sov_byte_at(s, i))
        i: i + 1
    dummy: _sov_set_byte(flat, at + i, 0)
    return 0
