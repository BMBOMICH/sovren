# dist.sov — the whole repository as one compressed file.
#
# The tree is mostly text: 318 .sov files, a few notes. The compiled
# compilers are rebuilt from that text by bootstrap, so a download
# only needs the text. dist packs every text file into one lz2r
# stream; the stream unpacks back into the same bytes, and check
# proves it byte for byte before anything ships.
#
#   sovren dist.sov -o dist && ./dist pack    -> /tmp/sov-dist.szv
#   ./dist check                               -> unpack + verify
#
# paths are taken with one str_cut per line: one cut beats a
# str_at + str_chr + str_cat round trip per byte.

use lz2
use run
use file
use string
use num
use mem
use arg

DIST_OUT: "/tmp/sov-dist.szv"
DIST_DIR: "/tmp/sov-dist-out"
DIST_CAP: 16777216

# which files make up the repository
dist_manifest:
    return run_sh("find . -type f -not -path './scratch/*' -not -path './.git/*' | grep -E '[.](sov|md|yml|txt)$' | sed 's|^\\./||' | sort")

# where the next newline sits, end of string counts as one
dist_eol buf k cap:
    e: k
    as long as e < cap
        if peek_byte(buf, e) is 10
            return e
        e: e + 1
    return cap

# append text bytes, return the new write head
dist_str buf w s:
    i: 0
    as long as i < str_len(s)
        poke_byte(buf, w + i, peek_byte(s, i))
        i: i + 1
    return w + str_len(s)

# walk the manifest, call dist_one for each line
dist_walk cb:
    man: dist_manifest()
    if str_len(man) < 2
        print "no files found"
        return 0
    cap: str_len(man)
    k: 0
    files: 0
    as long as k < cap
        e: dist_eol(man, k, cap)
        if e > k
            path: str_cut(man, k, e)
            files: files + 1
            if cb is 1
                dummy: dist_add(path)
            if not
                dummy: dist_note(path)
        k: e + 1
    print "files walked:"
    print files
    return 1

ARC: 0
W: 0
FILES: 0

dist_add path:
    d: file_read_all(path)
    n: file_size(path)
    if n < 1
        n: str_len(d)
    W: dist_str(ARC, W, "F ")
    W: dist_num(W, n)
    W: dist_str(ARC, W, " ")
    W: dist_str(ARC, W, path)
    poke_byte(ARC, W, 10)
    W: W + 1
    i: 0
    as long as i < n
        poke_byte(ARC, W, peek_byte(d, i))
        W: W + 1
        i: i + 1
    FILES: FILES + 1
    return 0

dist_num w v:
    t: num_text(v)
    i: 0
    as long as i < str_len(t)
        poke_byte(ARC, w, peek_byte(t, i))
        w: w + 1
        i: i + 1
    return w

dist_note path:
    d: file_read_all(path)
    n: file_size(path)
    if n < 1
        n: str_len(d)
    i: 0
    as long as i < n
        poke_byte(ARC, W, peek_byte(d, i))
        W: W + 1
        i: i + 1
    poke_byte(ARC, W, 10)
    W: W + 1
    return 0

dist_pack:
    ARC: mem_new(DIST_CAP)
    W: 0
    FILES: 0
    W: dist_str(ARC, W, "DIST1\n")
    if dist_walk(1) is 0
        return 0
    W: dist_str(ARC, W, "E\n")
    print "text bytes:"
    print W
    packed: lz2r_pack(ARC, W)
    ps: lz2r_plen(packed)
    if file_write_bytes(DIST_OUT, packed, ps) is 0
        print "write failed"
        return 0
    print "dist bytes:"
    print ps
    if ps < 850000
        print "UNDER 850KB"
    return 1

dist_check:
    d: file_read_all(DIST_OUT)
    if file_size(DIST_OUT) < 9
        print "no dist: run pack first"
        return 0
    txt: lz2r_unpack(d)
    if str_eq(str_cut(txt, 0, 6), "DIST1\n") is 0
        print "not a dist stream"
        return 0
    dummy: run_sh(str_cat("rm -rf ", DIST_DIR))
    cap: str_len(txt)
    k: 6
    files: 0
    bad: 0
    as long as k < cap
        if peek_byte(txt, k) is 69
            k: cap
        if not
            if peek_byte(txt, k) is not 70
                print "corrupt archive"
                return 0
            if not
                k: k + 2
                ln: 0
                more: 1
                as long as more is 1
                    c: peek_byte(txt, k)
                    if c is 32
                        more: 0
                    if not
                        ln: ln * 10 + c - 48
                        k: k + 1
                k: k + 1
                e: dist_eol(txt, k, cap)
                path: str_cut(txt, k, e)
                k: e + 1
                d2: mem_new(ln + 16)
                i: 0
                as long as i < ln
                    poke_byte(d2, i, peek_byte(txt, k + i))
                    i: i + 1
                k: k + ln
                dir: file_dirname(path)
                if str_len(dir) > 0
                    if str_eq(dir, path) is 0
                        dummy: run_sh(str_cat("mkdir -p ", str_cat(DIST_DIR, str_cat("/", dir))))
                q: str_cat(DIST_DIR, str_cat("/", path))
                if file_write_bytes(q, d2, ln) is 0
                    print "write failed: "
                    print path
                    bad: 1
                if not
                    a: file_size(path)
                    b: file_size(q)
                    same: 1
                    if a is not b
                        same: 0
                    if not
                        fa: file_read_all(path)
                        fb: file_read_all(q)
                        i: 0
                        as long as i < a
                            if peek_byte(fa, i) is not peek_byte(fb, i)
                                same: 0
                            i: i + 1
                    if same is 0
                        print "differs: "
                        print path
                        bad: 1
                files: files + 1
    print "files verified:"
    print files
    if bad is 1
        print "DIST BROKEN"
        return 0
    print "DIST IDENTICAL"
    return 1

main:
    mode: arg_at(1)
    if str_eq(mode, "check") is 1
        return dist_check()
    return dist_pack()
