use testrun
bo_fail: 0
include inc/inc01.sov 186 10 #-314320874600849607
    return 1
bo_wipe src:
    # PURGED: no artifact/state sidecars exist. Kept as an explicit no-op so
    # the four callers stay unchanged; never reintroduce persisted state.
    dummy: 0
    return 0
bo_step name src flag committed:
    out: str_cat('/tmp/sov-boot-', name)
    if bo_det = 1
        mk: tr_shell(str_cat('cat $(dirname ', str_cat(src, ')/.build-failed 2>/dev/null')))
        if str_empty(mk) = 0 -> print str_cat('skip ', name)
            return 0
        dummy: bo_wipe(src)
    if str_empty(flag) = 1 -> msg: tr_build(src, out) ;; if not -> msg: tr_build_for(src, out, flag)
    if str_has(msg, 'Error') = 1 -> print str_cat('FAIL ', name)
        print msg ;; bo_fail: bo_fail + 1
        return 0
    if bo_det = 1
        dummy: bo_wipe(src)
        out2: str_cat(out, '-det')
    if str_has(msg, 'Error') = 1 -> print str_cat('FAIL ', name)
        print msg ;; bo_fail: bo_fail + 1
        return 0
    if bo_det = 1
        out2: str_cat(out, '-det')
        if str_empty(flag) = 1 -> msg: tr_build(src, out2) ;; if not -> msg: tr_build_for(src, out2, flag)
        if str_has(msg, 'Error') = 1 -> print str_cat('FAIL ', name)
            print msg ;; bo_fail: bo_fail + 1
            return 0
        if bytes_same(out, out2) = 1 -> print str_cat('ok ', name)
            return 0
        print str_cat('FAIL ', name) ;; print '  rebuild not deterministic'
        bo_fail: bo_fail + 1
        return 0
    if bytes_same(committed, out) = 1 -> print str_cat('ok ', name)
        return 0
    print str_cat('FAIL ', name) ;; print '  rebuilt bytes differ from the committed binary'
    bo_fail: bo_fail + 1
bo_p0:
    bo_step('linux', 'compilers/linux/compiler.sov', blank, 'compilers/linux/compiler')
    bo_step('macos', 'compilers/apple/macos/compiler.sov', blank, 'compilers/apple/macos/compiler')
    bo_step('macos-arm64', 'compilers/apple/macos-arm64/compiler.sov', blank, 'compilers/apple/macos-arm64/compiler')
    bo_step('windows', 'compilers/windows/compiler.sov', blank, 'compilers/windows/compiler')
    bo_step('linux-arm64', 'compilers/linux/arm64/compiler.sov', blank, 'compilers/linux/arm64/compiler')
    bo_step('windows-store', 'compilers/windows/store/compiler.sov', blank, 'compilers/windows/store/compiler')
    return 0

bo_p1:
    bo_step('linux-arm64-so', 'compilers/linux/arm64-shared-object/compiler.sov', blank, 'compilers/linux/arm64-shared-object/compiler')
    bo_step('android', 'compilers/android/compiler.sov', blank, 'compilers/android/compiler')
    bo_step('ios', 'compilers/apple/ios/compiler.sov', blank, 'compilers/apple/ios/compiler')
    return 0

bo_p2:
    bo_step('tvos', 'compilers/apple/tvos/compiler.sov', blank, 'compilers/apple/tvos/compiler')
    bo_step('watchos', 'compilers/apple/watchos/compiler.sov', blank, 'compilers/apple/watchos/compiler')
    bo_step('visionos', 'compilers/apple/visionos/compiler.sov', blank, 'compilers/apple/visionos/compiler')
    bo_step('ios-simulator', 'compilers/apple/ios-simulator/compiler.sov', blank, 'compilers/apple/ios-simulator/compiler')
    bo_step('tvos-simulator', 'compilers/apple/tvos-simulator/compiler.sov', blank, 'compilers/apple/tvos-simulator/compiler')
    bo_step('watchos-simulator', 'compilers/apple/watchos-simulator/compiler.sov', blank, 'compilers/apple/watchos-simulator/compiler')
    bo_step('visionos-simulator', 'compilers/apple/visionos-simulator/compiler.sov', blank, 'compilers/apple/visionos-simulator/compiler')
    bo_step('android-so', 'compilers/android/shared-object/compiler.sov', blank, 'compilers/android/shared-object/compiler')
    bo_step('wasi', 'compilers/webassembly/webassembly-system-interface/compiler.sov', blank, 'compilers/webassembly/webassembly-system-interface/compiler')
    bo_step('wasm32', 'compilers/webassembly/wasm32-unknown-unknown/compiler.sov', blank, 'compilers/webassembly/wasm32-unknown-unknown/compiler')
    bo_step('wasm32-simd', 'compilers/webassembly/wasm32-single-instruction-multiple-data/compiler.sov', blank, 'compilers/webassembly/wasm32-single-instruction-multiple-data/compiler')
    bo_step('wasm64', 'compilers/webassembly/wasm64-memory64/compiler.sov', blank, 'compilers/webassembly/wasm64-memory64/compiler')
    bo_step('wasm32-threads', 'compilers/webassembly/wasm32-threads-atomics/compiler.sov', blank, 'compilers/webassembly/wasm32-threads-atomics/compiler')
    bo_step('wasm32-browser', 'compilers/webassembly/browser/compiler.sov', blank, 'compilers/webassembly/browser/compiler')
    bo_step('wasm32-emscripten', 'compilers/webassembly/emscripten/compiler.sov', blank, 'compilers/webassembly/emscripten/compiler')
    bo_step('wasm32-edge', 'compilers/webassembly/edge/compiler.sov', blank, 'compilers/webassembly/edge/compiler')
    bo_step('wasm-component', 'compilers/webassembly/component-model/compiler.sov', blank, 'compilers/webassembly/component-model/compiler')
    bo_step('wat', 'compilers/webassembly/webassembly-text/compiler.sov', blank, 'compilers/webassembly/webassembly-text/compiler')
    return 0

bo_p3:
    bo_step('freebsd', 'compilers/operating-systems/freebsd/compiler.sov', blank, 'compilers/operating-systems/freebsd/compiler')
    bo_step('netbsd', 'compilers/operating-systems/netbsd/compiler.sov', blank, 'compilers/operating-systems/netbsd/compiler')
    bo_step('openbsd', 'compilers/operating-systems/openbsd/compiler.sov', blank, 'compilers/operating-systems/openbsd/compiler')
    bo_step('dragonfly', 'compilers/operating-systems/dragonfly/compiler.sov', blank, 'compilers/operating-systems/dragonfly/compiler')
    bo_step('illumos', 'compilers/operating-systems/illumos/compiler.sov', blank, 'compilers/operating-systems/illumos/compiler')
    bo_step('haiku', 'compilers/operating-systems/haiku/compiler.sov', blank, 'compilers/operating-systems/haiku/compiler')
    bo_step('redox', 'compilers/operating-systems/redox/compiler.sov', blank, 'compilers/operating-systems/redox/compiler')
    bo_step('qnx', 'compilers/operating-systems/qnx/compiler.sov', blank, 'compilers/operating-systems/qnx/compiler')
    bo_step('serenityos', 'compilers/operating-systems/serenityos/compiler.sov', blank, 'compilers/operating-systems/serenityos/compiler')
    bo_step('menuetos', 'compilers/operating-systems/menuetos/compiler.sov', blank, 'compilers/operating-systems/menuetos/compiler')
    bo_step('sovrenos', 'compilers/operating-systems/sovrenos/compiler.sov', blank, 'compilers/operating-systems/sovrenos/compiler')
    return 0

bo_p4:
    bo_step('arm64e', 'compilers/apple/arm64e/compiler.sov', blank, 'compilers/apple/arm64e/compiler')
    bo_step('arm64_32', 'compilers/apple/arm64_32/compiler.sov', blank, 'compilers/apple/arm64_32/compiler')
    return 0

bo_p5:
    bo_step('launcher', 'launcher.sov', blank, 'sovren')
    bo_step('launcher-win', 'launcher.sov', '--windows', 'sovren.exe')
    bo_step('debugger', 'tools/debug.sov', blank, 'sovren-dbg')
    return 0

bo_det: 1
main:
    tr_use('./sovren')
    if bo_det = 1
        dummy: bo_wipe('compilers/linux/compiler.sov')
        msg: tr_build('compilers/linux/compiler.sov', '/tmp/sov-boot-d1')
        if str_has(msg, 'Error') = 1 -> print 'FAIL seed determinism'
            print msg ;; bo_fail: bo_fail + 1
        dummy: bo_wipe('compilers/linux/compiler.sov')
        msg: tr_build('compilers/linux/compiler.sov', '/tmp/sov-boot-d2')
        if str_has(msg, 'Error') = 1 -> print 'FAIL seed determinism (second build)'
            print msg ;; bo_fail: bo_fail + 1
        if bytes_same('/tmp/sov-boot-d1', '/tmp/sov-boot-d2') = 1 -> print 'ok seed determinism (driver lineage)'
            if not -> print 'FAIL seed determinism (rebuild differs)'
                bo_fail: bo_fail + 1
        sz: tr_shell('t=$(du -scb compilers/shared compilers/linux library/inc runtime.sov bootstrap.sov launcher.sov 2>/dev/null | tail -1 | cut -f1); echo core-bytes=$t; test "$t" -le 8000000 && echo ok-budget || echo OVER-BUDGET')
        print sz
        if str_has(sz, 'OVER-BUDGET') = 1 -> print 'FAIL size budget (active core grew past 8 MB - bloat tripwire)'
            bo_fail: bo_fail + 1
        bo_p0()
        bo_p1()
        bo_p2()
        bo_p3()
        bo_p4()
        bo_p5()
        print ''
        if bo_fail = 0 -> print 'bootstrap clean (driver lineage)'
            return 0
        print num_text(bo_fail) + ' bootstrap step(s) failed'
        return 1
    msg: tr_build('compilers/linux/compiler.sov', '/tmp/sov-boot-g3')
    if str_has(msg, 'Error') = 1 -> print 'FAIL seed fixed point'
        print msg ;; bo_fail: bo_fail + 1
    include inc/px00.sov 3737 4 (m2 g3 g4 m2 g4 m2)
        include inc/px00.sov 3737 4 (m3 g4 g5 m3 g5 m3)
            if not -> if bytes_same('/tmp/sov-boot-g3', '/tmp/sov-boot-g4') = 1
                    if bytes_same('/tmp/sov-boot-g4', '/tmp/sov-boot-g5') = 1 -> print 'ok seed fixed point (g3 == g4 == g5)'
                    if not -> print 'FAIL seed fixed point (g4 differs)'
                        bo_fail: bo_fail + 1
                if not -> print 'FAIL seed fixed point (g3 differs)'
                    bo_fail: bo_fail + 1
    bo_p0()
    bo_p1()
    bo_p2()
    bo_p3()
    bo_p4()
    bo_p5()
    print ''
    if bo_fail = 0 -> print 'bootstrap clean'
        return 0
    print num_text(bo_fail) + ' bootstrap step(s) failed'
    return 1

