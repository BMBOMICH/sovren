# bootstrap.sov — the whole tree, from one seed.
#
# Every committed compiler and launcher is a build artifact. This
# program rebuilds all of them from source, using only
# compilers/linux/compiler as the seed, and byte-compares each
# result against what is committed. It also re-proves the x86
# fixed point: the seed compiler builds itself twice, and all
# three must be identical byte for byte.
#
#   ./sovren bootstrap.sov
#
# When it ends with "bootstrap clean", the repository is
# reproducible: source + one 211 KB seed = everything else.

use testrun

bo_fail: 0

# two files, byte for byte
bytes_same a b:
    na: file_size(a)
    nb: file_size(b)
    if na is not nb
        return 0
    da: file_read_all(a)
    db: file_read_all(b)
    i: 0
    as long as i < na
        if _sov_byte_at(da, i) is not _sov_byte_at(db, i)
            return 0
        i: i + 1
    return 1

# rebuild one artifact and prove it is the committed one
bo_step name src flag committed:
    out: str_cat("/tmp/sov-boot-", name)
    if str_empty(flag) is 1
        msg: tr_build(src, out)
    if not
        msg: tr_build_for(src, out, flag)
    if str_has(msg, "Error") is 1
        print str_cat("FAIL ", name)
        print msg
        bo_fail: bo_fail + 1
        return 0
    if bytes_same(committed, out) is 1
        print str_cat("ok ", name)
        return 0
    print str_cat("FAIL ", name)
    print "  rebuilt bytes differ from the committed binary"
    bo_fail: bo_fail + 1
    return 0

main:
    tr_use("./sovren")

    # the seed proves itself first: build it, then let the fresh
    # build build itself again - all three must be identical
    msg: tr_build("compilers/linux/compiler.sov", "/tmp/sov-boot-g3")
    if str_has(msg, "Error") is 1
        print "FAIL seed fixed point"
        print msg
        bo_fail: bo_fail + 1
    if not
        m2: as text tr_shell("/tmp/sov-boot-g3 compilers/linux/compiler.sov -o /tmp/sov-boot-g4 2>&1")
        if str_has(m2, "Error") is 1
            print "FAIL seed fixed point (g4)"
            print m2
            bo_fail: bo_fail + 1
        if not
            m3: as text tr_shell("/tmp/sov-boot-g4 compilers/linux/compiler.sov -o /tmp/sov-boot-g5 2>&1")
            if str_has(m3, "Error") is 1
                print "FAIL seed fixed point (g5)"
                print m3
                bo_fail: bo_fail + 1
            if not
                if bytes_same("/tmp/sov-boot-g3", "/tmp/sov-boot-g4") is 1
                    if bytes_same("/tmp/sov-boot-g4", "/tmp/sov-boot-g5") is 1
                        print "ok seed fixed point (g3 == g4 == g5)"
                    if not
                        print "FAIL seed fixed point (g4 differs)"
                        bo_fail: bo_fail + 1
                if not
                    print "FAIL seed fixed point (g3 differs)"
                    bo_fail: bo_fail + 1

    # every other committed binary, rebuilt from source
    bo_step("linux", "compilers/linux/compiler.sov", blank, "compilers/linux/compiler")
    bo_step("macos", "compilers/macos/compiler.sov", blank, "compilers/macos/compiler")
    bo_step("windows", "compilers/windows/compiler.sov", blank, "compilers/windows/compiler")
    bo_step("android", "compilers/android/compiler.sov", blank, "compilers/android/compiler")
    bo_step("ios", "compilers/ios/compiler.sov", blank, "compilers/ios/compiler")
    bo_step("android-so", "compilers/android-so/compiler-so.sov", blank, "compilers/android-so/compiler-so")
    bo_step("launcher", "launcher.sov", blank, "sovren")
    bo_step("launcher-win", "launcher.sov", "--windows", "sovren.exe")
    bo_step("debugger", "tools/debug.sov", blank, "sovren-dbg")

    print ""
    if bo_fail is 0
        print "bootstrap clean"
        return 0
    print num_text(bo_fail) + " bootstrap step(s) failed"
    return 1
