bo_det: 1
main:
    tr_use('./sovren')
    if bo_det = 1
        dummy: bo_wipe('compilers/linux/compiler.sov')
        msg: tr_build('compilers/linux/compiler.sov', '/tmp/sov-boot-d1')
        if str_has(msg, 'Error') = 1 -> print 'FAIL seed determinism'
            print msg ;; bo_fail: bo_fail + 1
        dummy: bo_wipe('compilers/linux/compiler.sov')
        msg: tr_build('compilers/linux/compiler.sov', '/tmp/sov-boot-d2')
        if str_has(msg, 'Error') = 1 -> print 'FAIL seed determinism (second build)'
            print msg ;; bo_fail: bo_fail + 1
        if bytes_same('/tmp/sov-boot-d1', '/tmp/sov-boot-d2') = 1 -> print 'ok seed determinism (driver lineage)'
            if not -> print 'FAIL seed determinism (rebuild differs)'
                bo_fail: bo_fail + 1
        sz: tr_shell('t=$(du -scb compilers/shared compilers/linux library/inc runtime.sov bootstrap.sov launcher.sov 2>/dev/null | tail -1 | cut -f1); echo core-bytes=$t; test "$t" -le 8000000 && echo ok-budget || echo OVER-BUDGET')
        print sz
        if str_has(sz, 'OVER-BUDGET') = 1 -> print 'FAIL size budget (active core grew past 8 MB - bloat tripwire)'
            bo_fail: bo_fail + 1
        bo_p0()
        bo_p1()
        bo_p2()
        bo_p3()
        bo_p4()
        bo_p5()
        print ''
        if bo_fail = 0 -> print 'bootstrap clean (driver lineage)'
            return 0
        print num_text(bo_fail) + ' bootstrap step(s) failed'
        return 1
    msg: tr_build('compilers/linux/compiler.sov', '/tmp/sov-boot-g3')
    if str_has(msg, 'Error') = 1 -> print 'FAIL seed fixed point'
        print msg ;; bo_fail: bo_fail + 1
    include inc/px00.sov 3737 4 (m2 g3 g4 m2 g4 m2)
        include inc/px00.sov 3737 4 (m3 g4 g5 m3 g5 m3)
            if not -> if bytes_same('/tmp/sov-boot-g3', '/tmp/sov-boot-g4') = 1
                    if bytes_same('/tmp/sov-boot-g4', '/tmp/sov-boot-g5') = 1 -> print 'ok seed fixed point (g3 == g4 == g5)'
                    if not -> print 'FAIL seed fixed point (g4 differs)'
                        bo_fail: bo_fail + 1
                if not -> print 'FAIL seed fixed point (g3 differs)'
                    bo_fail: bo_fail + 1
    bo_p0()
    bo_p1()
    bo_p2()
    bo_p3()
    bo_p4()
    bo_p5()
    print ''
    if bo_fail = 0 -> print 'bootstrap clean'
        return 0
    print num_text(bo_fail) + ' bootstrap step(s) failed'
    return 1

