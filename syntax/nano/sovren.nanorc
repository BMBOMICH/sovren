# Sovren colors for nano
# Copy to ~/.nano/sovren.nanorc and add to ~/.nanorc:
#   include "~/.nano/sovren.nanorc"

syntax "sovren" "\.sov$"
comment "#"
color brightwhite start="\"" end="\""
color cyan "\<(return|if|times|stop|use|wipe|private|print|and|or|is|not|blank)\>"
color cyan "as long as"
color cyan "if not"
color magenta "==|!=|<=|>=|&&|\|\|"
color magenta "[+\-*/%<>=:]"
color green "\<(syscall|peek_byte|peek_i64|peek_ptr|poke_byte|poke_i64)\>"
color yellow "\<[0-9]+\>"
color brightblack "#.*"
