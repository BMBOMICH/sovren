put_sub_sp at n:
    v: n
    if v < 0
        v: 0
    oc_set_word(at, 3506439167 + (v % 4096) * 1024)
    return 0

# bit32.sov — 32-bit word helpers (pure Sovren)

M32: 4294967296

w32 x:
    r: x % M32
    if r < 0
        r: r + M32
    return r

wand a b:
    r: 0
    p: 1
    x: w32(a)
    y: w32(b)
    i: 0
    as long as i < 32
        if x % 2 is 1
            if y % 2 is 1
                r: r + p
        x: x / 2
        y: y / 2
        p: p * 2
        i: i + 1
    return r

wor a b:
    r: 0
    p: 1
    x: w32(a)
    y: w32(b)
    i: 0
    as long as i < 32
        da: x % 2
        db: y % 2
        if da is 1
            r: r + p
        if not
            if db is 1
                r: r + p
        x: x / 2
        y: y / 2
        p: p * 2
        i: i + 1
    return r

wxor a b:
    r: 0
    p: 1
    x: w32(a)
    y: w32(b)
    i: 0
    as long as i < 32
        da: x % 2
        db: y % 2
        if da is not db
            r: r + p
        x: x / 2
        y: y / 2
        p: p * 2
        i: i + 1
    return r

wnot a:
    return w32(4294967295 - w32(a))

shr a n:
    r: w32(a)
    i: 0
    as long as i < n
        r: r / 2
        i: i + 1
    return r

shl a n:
    r: w32(a)
    i: 0
    as long as i < n
        r: w32(r * 2)
        i: i + 1
    return r

rotr a n:
    return wor(shr(a, n), shl(a, 32 - n))

wadd a b:
    return w32(w32(a) + w32(b))

# sha256.sov — real SHA-256 in pure Sovren

sha_ch x y z:
    return wxor(wand(x, y), wand(wnot(x), z))

sha_maj x y z:
    return wxor(wxor(wand(x, y), wand(x, z)), wand(y, z))

sha_bs0 x:
    return wxor(wxor(rotr(x, 2), rotr(x, 13)), rotr(x, 22))

sha_bs1 x:
    return wxor(wxor(rotr(x, 6), rotr(x, 11)), rotr(x, 25))

sha_ss0 x:
    return wxor(wxor(rotr(x, 7), rotr(x, 18)), shr(x, 3))

sha_ss1 x:
    return wxor(wxor(rotr(x, 17), rotr(x, 19)), shr(x, 10))

sha_k i:
