tname line:
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            return repl(strip(cut(s, 0, wp)), " ", "_")
        sp: look(s, " ")
        if sp > 0 - 1
            return strip(cut(s, 0, sp))
        return s
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp > 0 - 1
        return repl(strip(cut(rest, 0, wp)), " ", "_")
    sp: look(rest, " ")
    if sp > 0 - 1
        return repl(strip(cut(rest, 0, sp)), " ", "_")
    return repl(rest, " ", "_")
tparams line:
    lst: _sov_list_new()
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            s: strip(cut(s, wp + 6, length(s)))
        if not
            sp: look(s, " ")
            if sp < 0
                return lst
            s: strip(cut(s, sp + 1, length(s)))
        p: repl(s, ",", " ")
        p: repl(p, " and ", " ")
        start: 0
        i: 0
        n: length(p)
        as long as i < n
            if same(letter(p, i), " ") is 1
                one: strip(cut(p, start, i))
                if length(one) > 0
                    lst: _sov_list_add(lst, one)
                start: i + 1
            i: i + 1
        one: strip(cut(p, start, n))
        if length(one) > 0
            lst: _sov_list_add(lst, one)
        return lst
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp < 0
        return lst
    p: repl(cut(rest, wp + 6, length(rest)), ",", " and ")
    start: 0
    i: 0
    n: length(p)
    as long as i < n
        if starts(cut(p, i, n), " and ") is 1
            one: repl(strip(cut(p, start, i)), " ", "_")
            if length(one) > 0
                lst: _sov_list_add(lst, one)
            start: i + 5
            i: i + 5
        if not
            i: i + 1
    one: repl(strip(cut(p, start, n)), " ", "_")
    if length(one) > 0
        lst: _sov_list_add(lst, one)
    return lst
dead_iota lines:
    an: blank
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        if starts(s, "<-- ") is 1
            if look(s, "_sov_alloc(") > 0 - 1
                rest: cut(s, 4, length(s))
                t: find_sep(rest)
                if t > 0 - 1
                    an: repl(strip(cut(rest, 0, t)), " ", "_")
        i: i + 1
    if length(an) is 0
        return blank
    hits: 0
    ok: 1
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        mark: join(an, ",")
        hit: 0
        if look(s, mark) > 0 - 1
            hit: 1
        if starts(s, join("<-- ", an)) is 1
            hit: 1
        if hit is 1
            hits: hits + 1
            good: 0
            if look(s, "_sov_alloc(") > 0 - 1
                good: 1
            if look(s, "poke_i64(") > 0 - 1
                good: 1
            if look(s, "peek_i64(") > 0 - 1
                good: 1
            if good is 0
                ok: 0
        i: i + 1
    if ok is 0
        return blank
    if hits < 3
        return blank
    return an
i2s n:
    r: ""
    v: n
    if v is 0
        return "0\n"
    as long as v > 0
        d: v % 10
        r: join(cut("0123456789", d, d + 1), r)
        v: v / 10
    return join(r, "\n")
intern_nz s:
    s: unesc(s)
    i: 0
    as long as i < _sov_list_len(str_keys)
        if same(_sov_list_get(str_keys, i), s) is 1
            return _sov_list_get(str_pos, i)
        i: i + 1
    off: _sov_buf_len(strb)
    k: 0
    as long as k < length(s)
        strb: _sov_buf_u8(strb, _sov_byte_at(s, k))
        k: k + 1
    str_keys: _sov_list_add(str_keys, s)
    str_pos: _sov_list_add(str_pos, off)
    return off
# windows hands back argv[0] wrapped in quotes, as a drive path with
# backslashes. turn it into the plain form the file calls understand.
tidy_path s:
    r: unquote(s)
    n: length(r)
    # drop a leading drive letter such as Z:
    if n > 2
        if _sov_byte_at(r, 1) is 58
            r: cut(r, 2, n)
            n: n - 2
    # backslash to slash
    o: _sov_alloc(n + 1)
    i: 0
    as long as i < n
        b: _sov_byte_at(r, i)
        if b is 92
            b: 47
        dummy: _sov_set_byte(o, i, b)
        i: i + 1
    dummy: _sov_set_byte(o, n, 0)
    return as text o

unquote s:
    n: length(s)
    if n < 2
        return s
    if _sov_byte_at(s, 0) is not 34
        return s
    e: n
    if _sov_byte_at(s, n - 1) is 34
        e: n - 1
    return cut(s, 1, e)
dirname p:
    n: length(p)
    if n is 0
        return "."
    i: n
    as long as i > 0
        i: i - 1
        b: _sov_byte_at(p, i)
        # windows writes paths with a backslash
        if b is 92
            b: 47
        if b is 47
            if i is 0
                return "/"
            return cut(p, 0, i)
    return "."
emit_used:
    if used_al is 1
        if idx(glob_names, "heap_ptr") is 0 - 1
            glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_alloc()
    if used_pr is 1
        used_sl: 1
    if used_sl is 1
        emit_strlen()
    if used_eq is 1
        emit_streq()
    if used_pr is 1
        emit_print()
    if used_pi is 1
        emit_print_int()
    if used_tr is 1
        emit_trap_stub()
prep_main names params bodies:
    thin_main: 0
    skip_al: blank
    fi: 0
    as long as fi < _sov_list_len(names)
        if same(_sov_list_get(names, fi), "main") is 1
            if _sov_list_len(_sov_list_get(params, fi)) is 0
                thin_main: 1
            skip_al: dead_iota(_sov_list_get(bodies, fi))
        fi: fi + 1
compile source:
    oc: _sov_list_new()
    iota_ptr: blank
    iota_lim: blank
    kn: blank
    kv: 0
    skip_al: blank
    used_al: 0
    used_sl: 0
    used_eq: 0
    used_pr: 0
    used_pi: 0
    used_tr: 0
    did_stos: 0
    thin_main: 0
    has_vm: 0
    need_priv: 0
    saw_str: 0
    str_vars: _sov_list_new()
    str_fns: _sov_list_new()
    ar_names: _sov_list_new()
    ar_cnt: _sov_list_new()
    str_fns: _sov_list_add(str_fns, "cat")
    str_fns: _sov_list_add(str_fns, "strcat")
    str_fns: _sov_list_add(str_fns, "_sov_strcat")
    str_fns: _sov_list_add(str_fns, "sub")
    str_fns: _sov_list_add(str_fns, "trim")
    str_fns: _sov_list_add(str_fns, "ch")
    str_fns: _sov_list_add(str_fns, "_sov_substring")
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) is 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") is 0
                    if starts(pre_t, "use ") is 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c is length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") is 1
                                            pre_in: 0
                                        if not
                                            if pre_in is 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
                                    # seven values is the most a job can
                                    # take. more used to compile and then
                                    # go wrong while running.
                                    if pre_na > 7
                                        print "Error: a job takes at most seven values"
                                        _sov_print(pre_cur)
                                        print pre_na
                                        had_err: 1
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, pre_na)
                                if not
                                    pre_cur: pre_h
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, 0)
            if not
                pre_t2: strip(pre_l)
                if starts(pre_t2, "return ") is 1
                    pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                    if starts(pre_r, "as text ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if length(pre_r) > 0
                        if _sov_byte_at(pre_r, 0) is 34
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                        if not
                            if same(pre_r, "blank") is 1
                                if length(pre_cur) > 0
                                    mark_fn_str(pre_cur)
        pre_i: pre_i + 1
    # a job that hands back another job's answer is a text job too,
    # whatever order the jobs were written in. Keep going round until
    # nobody new is marked, so forward references work as well as
    # backward ones.
    changed: 1
    as long as changed is 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) is 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") is 0
                        if starts(pre_t, "use ") is 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c is length(pre_t) - 1
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    if starts(pre_t2, "return ") is 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(str_fns, pre_cur) < 0
                            if starts(pre_r, "as text ") is 0
                                if length(pre_r) > 0
                                    if _sov_byte_at(pre_r, 0) is not 34
                                        if same(pre_r, "blank") is 0
                                            pre_lp: look(pre_r, "(")
                                            if pre_lp > 0
                                                pre_f: strip(cut(pre_r, 0, pre_lp))
                                                if idx(str_fns, pre_f) > 0 - 1
                                                    mark_fn_str(pre_cur)
                                                    changed: 1
            pre_i: pre_i + 1
    if look(source, "wipe ") > 0 - 1
        need_priv: 1
    if look(source, "private") > 0 - 1
        need_priv: 1
    cnms: _sov_list_new()
    cvls: _sov_list_new()
    cemt: _sov_list_new()
    strb: _sov_buf_new()
    str_keys: _sov_list_new()
    str_pos: _sov_list_new()
    fn_names: _sov_list_new()
    fn_offs: _sov_list_new()
    glob_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_val: _sov_list_new()
    patch_line: _sov_list_new()
    stmt_lns: _sov_list_new()
    body_lns: _sov_list_new()
    task_lns: _sov_list_new()
    task_user: _sov_list_new()
    lns: lines_of(source)
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    li: 0
    as long as li < _sov_list_len(lns)
        raw: _sov_list_get(lns, li)
        s: strip(raw)
        th: 0
        if is_task_hdr(s) is 1
            th: 1
        if th is 1
            if in_t is 1
                bodies: _sov_list_add(bodies, cur)
                body_lns: _sov_list_add(body_lns, cur_ln)
            tn: tname(s)
            if idx(names, tn) > 0 - 1
                print "Error: two with the same name"
                _sov_print(tn)
                err_line: file_ln(li)
                print err_line
                had_err: 1
            names: _sov_list_add(names, tn)
            params: _sov_list_add(params, tparams(s))
            tu: 0
            if li + 1 > src_base
                tu: 1
            task_user: _sov_list_add(task_user, tu)
            task_lns: _sov_list_add(task_lns, file_ln(li))
            cur: _sov_list_new()
            cur_ln: _sov_list_new()
            in_t: 1
        if not
            if nind(raw) is 0
                gok: 0
                gc: find_col(s)
                if gc > 0
                    if gc < length(s) - 1
                        gok: 1
                if gok is 1
                    gn: blank
                    if starts(s, "<-- ") is 1
                        rest: cut(s, 4, length(s))
                        t: find_sep(rest)
                        if t > 0 - 1
                            gn: repl(strip(cut(rest, 0, t)), " ", "_")
                    if not
                        gn: repl(strip(cut(s, 0, gc)), " ", "_")
                    if length(gn) > 0
                        if idx(glob_names, gn) is 0 - 1
                            glob_names: _sov_list_add(glob_names, gn)
                        tops: _sov_list_add(tops, raw)
            if not
                if in_t is 1
                    cur: _sov_list_add(cur, raw)
                    cur_ln: _sov_list_add(cur_ln, file_ln(li))
        li: li + 1
    if in_t is 1
        bodies: _sov_list_add(bodies, cur)
        body_lns: _sov_list_add(body_lns, cur_ln)
    has_vm: 0
    if look(source, "task _sov_alloc") > 0 - 1
        has_vm: 1
    if look(source, "_sov_alloc size:") > 0 - 1
        has_vm: 1
    prep_main(names, params, bodies)
    if has_vm is 1
        glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_start()
        emit_alloc()
        emit_strlen()
        emit_streq()
        emit_print()
        emit_print_int()
        thin_main: 0
    if not
        if thin_main is 0
            emit_start()
    fi: 0
    as long as fi < _sov_list_len(names)
        nm: _sov_list_get(names, fi)
        if idx(fn_names, nm) < 0
                fn_names: _sov_list_add(fn_names, nm)
                fn_offs: _sov_list_add(fn_offs, here())
                locals: _sov_list_new()
                str_vars: _sov_list_new()
                saw_str: 0
                stmt_lns: _sov_list_get(body_lns, fi)
                if _sov_list_len(_sov_list_get(bodies, fi)) is 0
                    if _sov_list_get(task_user, fi) is 1
                        print "Warning: empty"
                        _sov_print(nm)
                        print _sov_list_get(task_lns, fi)
                ps: _sov_list_get(params, fi)
                pi: 0
                as long as pi < _sov_list_len(ps)
                    locals: _sov_list_add(locals, _sov_list_get(ps, pi))
                    pi: pi + 1
                thin: 0
                if same(nm, "main") is 1
                    if _sov_list_len(ps) is 0
                        thin: 0
                if thin is 1
                    skip_al: dead_iota(_sov_list_get(bodies, fi))
                    if need_priv is 1
                        emit_nodump()
                    body(tops)
                    cflush_all()
                    body(_sov_list_get(bodies, fi))
                    if saw_str is 1
                        mark_fn_str(nm)
                    set_reg(0, 0)
                    set_reg(8, 93)
                    sysc()
                if not
                    prolog()
                    copyargs(_sov_list_len(ps))
                    if same(nm, "main") is 1
                        skip_al: dead_iota(_sov_list_get(bodies, fi))
                        if need_priv is 1
                            emit_nodump()
                        body(tops)
                        cflush_all()
                    body(_sov_list_get(bodies, fi))
                    if saw_str is 1
                        mark_fn_str(nm)
                    ns: 64
                    if _sov_list_len(locals) > 5
                        ns: (_sov_list_len(locals) - 5) * 8 + 64
                        as long as ns % 16 is not 0
                            ns: ns + 8
                    put_sub_sp(pro_at, ns)
                    if same(nm, "main") is 1
                        set_reg(0, 0)
                        set_reg(8, 93)
                        sysc()
                    if not
                        xor_rax()
                        leave()
                        ret()
        fi: fi + 1
    if has_vm is 0
        emit_used()
    warn_unused()
warn_unused:
    ui: 0
    as long as ui < _sov_list_len(names)
        nm: _sov_list_get(names, ui)
        do_w: 0
        if length(nm) > 0
            if same(nm, "main") is 0
                if starts(nm, "_sov_") is 0
                    if _sov_list_get(task_user, ui) is 1
                        do_w: 1
        if do_w is 1
            used: 0
            uj: 0
            as long as uj < _sov_list_len(patch_kind)
                if same(_sov_list_get(patch_kind, uj), "rel") is 1
                    if same(_sov_list_get(patch_val, uj), nm) is 1
                        used: 1
                uj: uj + 1
            if used is 0
                print "Warning: never used"
                _sov_print(nm)
                print _sov_list_get(task_lns, ui)
        ui: ui + 1
poke4 p off v:
    x: v
    if x < 0
        x: x + 4294967296
    i: 0
    as long as i < 4
        dummy: _sov_set_byte(p, off + i, x % 256)
        x: x / 256
        i: i + 1
poke8 p off v:
    x: v
    i: 0
    as long as i < 8
        b: x % 256
        if b < 0
            b: b + 256
        dummy: _sov_set_byte(p, off + i, b)
        x: x / 256
        i: i + 1
write_elf path:
    if had_err is 1
        return
    clen: _sov_list_len(oc)
    sl: _sov_buf_len(strb)
    str_off: clen
    if _sov_list_len(glob_names) > 0
        as long as str_off % 8 is not 0
            oc: _sov_list_add(oc, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(glob_names) * 8
    hdr: 384
    codelim: hdr + clen + sl + pad
    as long as codelim % 16 is not 0
        codelim: codelim + 1
    npages: codelim / 4096
    if codelim % 4096 is not 0
        npages: npages + 1
    cd_len: 88 + npages * 32
    sig_len: 12 + 8 + cd_len
    filesz: codelim + sig_len
    vmsz: filesz
    as long as vmsz % 4096 is not 0
        vmsz: vmsz + 1
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    poke4(flat, 0, 4277009103)
    poke4(flat, 4, 16777228)
    poke4(flat, 8, 0)
    poke4(flat, 12, 2)
    poke4(flat, 16, 4)
    poke4(flat, 20, 344)
    poke4(flat, 24, 1)
    poke4(flat, 32, 25)
    poke4(flat, 36, 72)
    dummy: _sov_set_byte(flat, 40, 95)
    dummy: _sov_set_byte(flat, 41, 95)
    dummy: _sov_set_byte(flat, 42, 80)
    dummy: _sov_set_byte(flat, 43, 65)
    dummy: _sov_set_byte(flat, 44, 71)
    dummy: _sov_set_byte(flat, 45, 69)
    dummy: _sov_set_byte(flat, 46, 90)
    dummy: _sov_set_byte(flat, 47, 69)
    dummy: _sov_set_byte(flat, 48, 82)
    dummy: _sov_set_byte(flat, 49, 79)
    poke8(flat, 64, 4294967296)
    poke4(flat, 104, 25)
    poke4(flat, 108, 72)
    dummy: _sov_set_byte(flat, 112, 95)
    dummy: _sov_set_byte(flat, 113, 95)
    dummy: _sov_set_byte(flat, 114, 84)
    dummy: _sov_set_byte(flat, 115, 69)
    dummy: _sov_set_byte(flat, 116, 88)
    dummy: _sov_set_byte(flat, 117, 84)
    poke8(flat, 128, 4294967296)
    poke8(flat, 136, vmsz)
    poke8(flat, 152, filesz)
    poke4(flat, 160, 7)
    poke4(flat, 164, 7)
    poke4(flat, 176, 5)
    poke4(flat, 180, 184)
    poke4(flat, 184, 4)
    poke4(flat, 188, 42)
    poke8(flat, 320, 4294967296 + hdr)
    poke4(flat, 360, 29)
    poke4(flat, 364, 16)
    poke4(flat, 368, codelim)
    poke4(flat, 372, sig_len)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, hdr + i, _sov_list_get(oc, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, hdr + str_off + si, _sov_buf_at(strb, si))
        si: si + 1
    str_addr: 4294967296 + hdr + str_off
    glob_addr: 4294967296 + hdr + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_val, i)
        if same(kind, "rel26") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: (tgt - at) / 4
                if rel < 0
                    rel: rel + 67108864
                poke4(flat, hdr + at, 2483027968 + (rel % 67108864))
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "b26") is 1
            poke4(flat, hdr + at, 335544320 + (val % 67108864))
        if same(kind, "glob64") is 1
            gx: idx(glob_names, val)
            ga: glob_addr + gx * 8
            poke4(flat, hdr + at, 3531603968 + (ga % 65536) * 32 + 9)
            poke4(flat, hdr + at + 4, 4070572032 + ((ga / 65536) % 65536) * 32 + 9)
            poke4(flat, hdr + at + 8, 4072669184 + ((ga / 4294967296) % 65536) * 32 + 9)
        if same(kind, "fnaddr64") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                fa: 4294967296 + hdr + _sov_list_get(fn_offs, fi)
                poke4(flat, hdr + at, 3531603968 + (fa % 65536) * 32)
                poke4(flat, hdr + at + 4, 4070572032 + ((fa / 65536) % 65536) * 32)
                poke4(flat, hdr + at + 8, 4072669184 + ((fa / 4294967296) % 65536) * 32)
                poke4(flat, hdr + at + 12, 4074766336 + ((fa / 281474976710656) % 65536) * 32)
            if not
                print "Error: no such task"
                _sov_print(val)
                had_err: 1
        if same(kind, "str64x0") is 1
            sa: str_addr + val
            poke4(flat, hdr + at, 3531603968 + (sa % 65536) * 32)
            poke4(flat, hdr + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32)
            poke4(flat, hdr + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32)
        if same(kind, "str64") is 1
            sa: str_addr + val
            poke4(flat, hdr + at, 3531603968 + (sa % 65536) * 32 + 1)
            poke4(flat, hdr + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32 + 1)
            poke4(flat, hdr + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32 + 1)
        if same(kind, "cbz_trap") is 1
            ti: idx(fn_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(fn_offs, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, hdr + at, 3019898880 + (rl % 524288) * 32 + val)
        if same(kind, "b19_trap") is 1
            ti: idx(fn_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(fn_offs, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, hdr + at, 1409286144 + (rl % 524288) * 32 + 2)
        if same(kind, "rel") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: tgt - (at + 4)
                poke4(flat, hdr + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "str") is 1
            poke8(flat, hdr + at, str_addr + val)
        if same(kind, "str32") is 1
            poke4(flat, hdr + at, str_addr + val)
        if same(kind, "ripstr") is 1
            poke4(flat, hdr + at, str_off + val - at - 4)
        if same(kind, "glob") is 1
            gx: idx(glob_names, val)
            poke8(flat, hdr + at, glob_addr + gx * 8)
        i: i + 1
    if had_err is 1
        return
    sig: codelim
    poke4be(flat, sig, 4208856256)
    poke4be(flat, sig + 4, sig_len)
    poke4be(flat, sig + 8, 1)
    poke4be(flat, sig + 12, 0)
    poke4be(flat, sig + 16, 20)
    cd: sig + 20
    poke4be(flat, cd, 4208856066)
    poke4be(flat, cd + 4, cd_len)
    poke4be(flat, cd + 8, 132096)
    poke4be(flat, cd + 12, 2)
    poke4be(flat, cd + 16, 88)
    poke4be(flat, cd + 20, 44)
    poke4be(flat, cd + 24, 0)
    poke4be(flat, cd + 28, npages)
    poke4be(flat, cd + 32, codelim)
    dummy: _sov_set_byte(flat, cd + 36, 32)
    dummy: _sov_set_byte(flat, cd + 37, 2)
    dummy: _sov_set_byte(flat, cd + 38, 0)
    dummy: _sov_set_byte(flat, cd + 39, 12)
    poke4be(flat, cd + 40, 0)
    so_name("sovren", flat, cd + 44)
    pg: 0
    as long as pg < npages
        plen: 4096
        if (pg * 4096) + 4096 > codelim
            plen: codelim - (pg * 4096)
        ph: _sov_alloc(64)
        sha256_bytes(flat + pg * 4096, plen, ph)
        hj: 0
        as long as hj < 8
            hv: peek_i64(ph, hj * 8)
            poke4be(flat, cd + 88 + pg * 32 + hj * 4, hv)
            hj: hj + 1
        pg: pg + 1
    _sov_write_n(path, flat, filesz)
    _sov_chmod(path, 493)
poke4be p at v:
    x: v
    if x < 0
        x: x + 4294967296
    dummy: _sov_set_byte(p, at, (x / 16777216) % 256)
    dummy: _sov_set_byte(p, at + 1, (x / 65536) % 256)
    dummy: _sov_set_byte(p, at + 2, (x / 256) % 256)
    dummy: _sov_set_byte(p, at + 3, x % 256)
    return 0

so_name s flat at:
    i: 0
    as long as i < length(s)
        dummy: _sov_set_byte(flat, at + i, _sov_byte_at(s, i))
        i: i + 1
    dummy: _sov_set_byte(flat, at + i, 0)
    return 0
use_one name:
    tail: join(name, ".sov")
    path: join("library/", tail)
    r: load_file(path)
    if r is not 0
        return r
    # not in this folder, so look beside the compiler
    path: join(self_dir, join("/library/", tail))
    r: load_file(path)
    if r is not 0
        return r
    # the compiler binary usually sits one level down, in linux/ or
    # windows/, with library/ next to that folder
    path: join(self_dir, join("/../library/", tail))
    return load_file(path)
take_use name:
    mark: join(" ", join(name, " "))
    if look(used_libs, mark) > 0 - 1
        return blank
    used_libs: join(used_libs, mark)
    chunk: use_one(name)
    if chunk is 0
        print "Error: cannot read library"
        _sov_print(name)
        print err_line
        had_err: 1
        return blank
    return chunk
pull_uses src:
    out: blank
    lns: lines_of(src)
    i: 0
    n: _sov_list_len(lns)
    as long as i < n
        line: strip(_sov_list_get(lns, i))
        if starts(line, "use ") is 1
            err_line: i + 1
            out: join(out, take_use(strip(cut(line, 4, length(line)))))
        i: i + 1
    return out
main argc argv:
    # remember where this compiler lives, so its library and runtime
    # are found no matter which folder you run it from
    self_dir: dirname(tidy_path(peek_ptr(argv, 0)))
    if argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, no C, no Python"
        fail()
    inf: blank
    outf: blank
    i: 1
    as long as i < argc
        arg: peek_ptr(argv, i)
        if same(arg, "--bare") is 1
            bare_mode: 1
        if not
            if same(arg, "-o") is 1
                i: i + 1
                if i < argc
                    outf: peek_ptr(argv, i)
            if not
                if same(arg, "build") is 0
                    inf: arg
        i: i + 1
    if length(inf) is 0
        print "Error: no input"
        fail()
    if length(outf) is 0
        d: look(inf, ".sov")
        if d > 0 - 1
            outf: cut(inf, 0, d)
        if not
            outf: join(inf, ".out")
    print "Compiling"
    _sov_print(inf)
    src: load_file(inf)
    if src is 0
        print "Error: cannot read input"
        fail()
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    src: join(join("# pad line so main is not first", nl), src)
    used_libs: blank
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    need: 0
    mmap_sz: 12582912
    if look(src, "_sov_list") > 0 - 1
        need: 1
    if look(src, "load_file") > 0 - 1
        need: 1
    if look(src, "_sov_buf") > 0 - 1
        need: 1
    if look(src, "_sov_alloc") > 0 - 1
        need: 1
    if look(src, "_sov_set_byte") > 0 - 1
        need: 1
    if look(src, "peek_byte") > 0 - 1
        need: 1
    if look(src, "poke_byte") > 0 - 1
        need: 1
    rt: blank
    if bare_mode is 1
        need: 0
    if need is 1
        mmap_sz: 1073741824
        rt: load_file("runtime.sov")
        if rt is 0
            rt: load_file("linux/runtime.sov")
        if rt is 0
            rt: load_file(join(self_dir, "/runtime.sov"))
        if rt is 0
            rt: load_file(join(self_dir, "/../runtime.sov"))
        if rt is 0
            print "Error: cannot read runtime"
            fail()
    src_base: 1
    if length(rt) > 0
        src_base: src_base + _sov_list_len(lines_of(rt))
    if length(extra) > 0
        src_base: src_base + _sov_list_len(lines_of(extra))
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    all: join(rt, nl)
    src_base: src_base + 1
    all: join(all, src)
    compile(all)
    write_elf(outf)
    if had_err is 1
        fail()
    print "Wrote"
    _sov_print(outf)
load_file path:
    fd: _sov_open(path, 0)
    if fd < 0
        return 0
    sz: _sov_lseek(fd, 0, 2)
    _sov_lseek(fd, 0, 0)
    if sz < 1
        _sov_close(fd)
        return 0
    buf: _sov_alloc(sz + 1)
    got: _sov_read(fd, buf, sz)
    _sov_close(fd)
    dummy: _sov_set_byte(buf, got, 0)
    return buf

# backend.sov — AArch64 back end for Sovren
# Replaces the x86-64 code generator. Register map:
#   x0  value register (was rax)      x1  second operand (was rcx)
#   x19..x23  locals 0..4             x29 frame pointer, x30 link
#   x9,x10..x15  scratch              x8  syscall number
# Every instruction is 4 bytes, little endian.

emitw w:
    v: w
    if v < 0
        v: v + 4294967296
    emit(v % 256)
    emit((v / 256) % 256)
    emit((v / 65536) % 256)
    emit((v / 16777216) % 256)

movz_x d imm sh:
    emitw(3531603968 + sh * 2097152 + (imm % 65536) * 32 + d)

movk_x d imm sh:
    emitw(4068474880 + sh * 2097152 + (imm % 65536) * 32 + d)

set_reg d n:
    v: n
    if v < 0
        v: v + 18446744073709551616
    movz_x(d, v % 65536, 0)
    p1: (v / 65536) % 65536
    if p1 is not 0
        movk_x(d, p1, 1)
    p2: (v / 4294967296) % 65536
    if p2 is not 0
        movk_x(d, p2, 2)
    p3: (v / 281474976710656) % 65536
    if p3 is not 0
        movk_x(d, p3, 3)

rax_imm n:
    set_reg(0, n)

rdi_imm n:
    set_reg(1, n)

# mov xD, xS   (orr xD, xzr, xS)
mov_reg d s:
    emitw(2852127712 + s * 65536 + d)

# str x0,[sp,#-16]!
push_rax:
    emitw(4162785248)

# ldr xN,[sp],#16
pop_reg n:
    emitw(4165011424 + n)

pop_rax:
    pop_reg(0)

ret:
    emitw(3596551104)

xor_rax:
    emitw(2854159328)

mov_rdi_rax:
    mov_reg(1, 0)

mov_rcx_rax:
    mov_reg(1, 0)

add_rax_rcx:
    emitw(2332098560)

sub_rax_rcx:
    emitw(3405840384)

imul_rax_rcx:
    emitw(2600565760)

# x0 = x0 / x1
sdiv_rax_rcx:
    emitw(2596342784)

# x0 = x0 % x1   (sdiv x2,x0,x1 ; msub x0,x2,x1,x0)
mod_rax_rcx:
    emitw(2596342786)
    emitw(2600566848)

cmp_rax_rcx:
    emitw(3942711327)

test_rax:
    emitw(4043309087)

setcc op:
    if same(op, "eq") is 1
        emitw(2594117600)
        return
    if same(op, "ne") is 1
        emitw(2594113504)
        return
    if same(op, "lt") is 1
        emitw(2594154464)
        return
    if same(op, "gt") is 1
        emitw(2594166752)
        return
    if same(op, "le") is 1
        emitw(2594162656)
        return
    if same(op, "ge") is 1
        emitw(2594158560)
        return

loc_reg slot:
    return 19 + slot

# ldr xD,[x29,#off]
# ldur xD,[x29,#-off]   off is a positive byte count
ldr_fp d off:
    n: 512 - off
    emitw(4164944800 + n * 4096 + d)

# str xS,[x29,#off]
# stur xS,[x29,#-off]
str_fp s off:
    n: 512 - off
    emitw(4160750496 + n * 4096 + s)

load_loc slot:
    if slot < 5
        mov_reg(0, loc_reg(slot))
        return
    ldr_fp(0, (slot - 5) * 8 + 8)

store_loc slot:
    if slot < 5
        mov_reg(loc_reg(slot), 0)
        return
    str_fp(0, (slot - 5) * 8 + 8)

# globals: address built with movz+movk+movk, patched as glob64
load_glob name:
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", name)
    emitw(4181721376)

store_glob name:
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", name)
    emitw(4177527072)

calln name:
    at: here()
    emitw(2483027968)
    addp(at, "rel26", name)

jmp:
    at: here()
    emitw(335544320)
    return at

# b.eq — taken when the previous cmp set Z (value was zero)
jz:
    at: here()
    emitw(1409286144)
    return at

jnz:
    at: here()
    emitw(1409286145)
    return at

# b.hs — unsigned greater-or-equal, used by bounds checks
# stp x29,x30,[sp,#-16]! ; mov x29,sp ; sub sp,sp,#N (patched)
prolog:
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    pro_at: here()
    emitw(3506439167)

# ldp x29,x30,[sp],#16
leave:
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)

copyargs n:
    i: 0
    as long as i < n
        if i < 5
            mov_reg(loc_reg(i), i)
        if not
            str_fp(i, (i - 5) * 8 + 8)
        i: i + 1

sysc:
    emitw(3556769793)

# ---- memory access ----

# ldrb w0,[x0,x1]
ldrb_x0_x0x1:
    emitw(945907712)

# strb w2,[x0,x1]
strb_x2_x0x1:
    emitw(941713410)

# ldr x0,[x0,x1]
ldr_x0_x0x1:
    emitw(4167133184)

# str x2,[x0,x1]
str_x2_x0x1:
    emitw(4162938882)

# ldur x9,[x0,#-8]  — read the allocation length header
ldur_len:
    emitw(4167008265)

# cmp x1,x9  — index against length
cmp_idx_len:
    emitw(3943235647)

chk_mem extra:
    if has_vm is 1
        return
    used_tr: 1
    cbz_at: here()
    emitw(3019898880)
    addp(cbz_at, "cbz_trap", 0)
    ldur_len()
    if extra is 1
        cmp_idx_len()
        at: here()
        emitw(1409286146)
        addp(at, "b19_trap", 0)
    if not
        emitw(2432704513)
        emitw(3943235647)
        at: here()
        emitw(1409286146)
        addp(at, "b19_trap", 0)

chk_zrcx:
    if has_vm is 1
        return
    used_tr: 1
    at: here()
    emitw(3019898881)
    addp(at, "cbz_trap", 1)

# write(1, str, n) with a literal
emit_write_lit s:
    n: length(s)
    set_reg(0, 1)
    off: intern_nz(s)
    at: here()
    movz_x(1, 0, 0)
    movk_x(1, 0, 1)
    movk_x(1, 0, 2)
    addp(at, "str64", off)
    set_reg(2, n)
    set_reg(8, 64)
    sysc()

# mmap(0, sz, RW, PRIVATE|ANON, -1, 0) -> x0
emit_mmap:
    set_reg(0, 0)
    set_reg(1, mmap_sz)
    set_reg(2, 3)
    set_reg(3, 34)
    emitw(2457862148)
    set_reg(5, 0)
    set_reg(8, 222)
    sysc()

emit_mmap_k n:
    set_reg(0, 0)
    set_reg(1, n + 2097152)
    set_reg(2, 3)
    set_reg(3, 34)
    emitw(2457862148)
    set_reg(5, 0)
    set_reg(8, 222)
    sysc()

# _start: x0 = argc from [sp], x1 = argv = sp+8
emit_start:
    emitw(4181722080)
    emitw(2432705505)
    at: here()
    emitw(2483027968)
    addp(at, "rel26", "main")
    set_reg(0, 0)
    set_reg(8, 93)
    sysc()

emit_trap_stub:
    fn_names: _sov_list_add(fn_names, "_sov_trap")
    fn_offs: _sov_list_add(fn_offs, here())
    emit_write_lit("trap\n")
    set_reg(0, 1)
    set_reg(8, 93)
    sysc()
# patch_arm64.sov — AArch64 branch patching
# x86 writes a flat 32-bit offset. ARM packs the offset into instruction bits:
#   b / bl   : 26-bit word offset in bits 0..25   (top byte 0x14 / 0x94)
#   b.cond   : 19-bit word offset in bits 5..23   (top byte 0x54)
# Offsets are in words (bytes / 4), signed, relative to the branch itself.

# read the 4 bytes already emitted at `at`
oc_word at:
    b0: _sov_list_get(oc, at)
    b1: _sov_list_get(oc, at + 1)
    b2: _sov_list_get(oc, at + 2)
    b3: _sov_list_get(oc, at + 3)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

oc_set_word at v:
    x: v
    if x < 0
        x: x + 4294967296
    oc: _sov_list_set(oc, at, x % 256)
    oc: _sov_list_set(oc, at + 1, (x / 256) % 256)
    oc: _sov_list_set(oc, at + 2, (x / 65536) % 256)
    oc: _sov_list_set(oc, at + 3, (x / 16777216) % 256)
    return 0

# byte offset -> signed word offset
word_off delta:
    d: delta / 4
    return d

# put a 26-bit offset into a b / bl already at `at`
put26 at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    d: word_off(delta)
    if d < 0
        d: d + 67108864
    base: top * 16777216
    oc_set_word(at, base + (d % 67108864))
    return 0

put19 at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    cond: w % 32
    d: word_off(delta)
    if d < 0
        d: d + 524288
    base: top * 16777216
    oc_set_word(at, base + (d % 524288) * 32 + cond)
    return 0

# ARM version of `put`: choose by instruction type
put_arm at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    if top is 84
        put19(at, delta)
        return 0
    put26(at, delta)
    return 0

# a forward patch: to wherever the code is now. This is its own
# little job on purpose: calling here() inside the arguments of
# put_arm loses the first answer.
put_here at:
    delta: here() - at
    put_arm(at, delta)
    return 0

# ARM version of `patch`: branch at `at` jumps to the current position
# backend2.sov — remaining AArch64 emitters
# Every raw word below was produced by an encoder and confirmed with a
# disassembler; the runtime helpers were then executed on an emulated ARM64 CPU.

inc_var name:
    loadv(name)
    rdi_imm(1)
    add_rax_rcx()
    storev(name)

dec_var name:
    loadv(name)
    rdi_imm(1)
    sub_rax_rcx()
    storev(name)

add_into dest src:
    loadv(dest)
    push_rax()
    loadv(src)
    mov_rcx_rax()
    pop_rax()
    add_rax_rcx()
    storev(dest)

add_imm name n:
    loadv(name)
    rdi_imm(n)
    add_rax_rcx()
    storev(name)

chk_ov:
    return

emit_nodump:
    return

# x86 string-instruction fast paths have no AArch64 form.
# Returning 0 makes the caller emit an ordinary loop instead.
try_opt_while cond blines:
    return 0

# ---- runtime helpers ----

# x0 = pointer, returns the length in x0
emit_strlen:
    fn_names: _sov_list_add(fn_names, "_sov_strlen")
    fn_offs: _sov_list_add(fn_offs, here())
    mov_reg(9, 0)
    set_reg(0, 0)
    top: here()
    emitw(945842475)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432697344)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ex)
    ret()

# x0, x1 = two pointers, returns 1 when the text matches
emit_streq:
    fn_names: _sov_list_add(fn_names, "_sov_str_eq")
    fn_offs: _sov_list_add(fn_offs, here())
    mov_reg(9, 0)
    mov_reg(10, 1)
    set_reg(11, 0)
    top: here()
    emitw(2332754220)
    emitw(2332754253)
    emitw(960496014)
    emitw(960496047)
    emitw(1796145631)
    ne: here()
    emitw(1409286145)
    emitw(1895825887)
    eq: here()
    emitw(1409286144)
    emitw(2432697707)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ne)
    set_reg(0, 0)
    ret()
    put_here(eq)
    set_reg(0, 1)
    ret()

# x0 = pointer, writes the text then a newline
emit_print:
    fn_names: _sov_list_add(fn_names, "_sov_print")
    fn_offs: _sov_list_add(fn_offs, here())
    # a value under 65536 is not a real address. reading from it
    # would crash, so hand it to the number printer instead.
    emitw(4047519775)
    hi: here()
    emitw(1409286146)
    used_pi: 1
    calln("_sov_print_int")
    ret()
    put_arm(hi, here() - hi)
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    mov_reg(19, 0)
    mov_reg(9, 19)
    set_reg(20, 0)
    top: here()
    emitw(2333344042)
    emitw(960495947)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432698004)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ex)
    set_reg(0, 1)
    mov_reg(1, 19)
    mov_reg(2, 20)
    set_reg(8, 64)
    sysc()
    set_reg(0, 1)
    nl_at: here()
    movz_x(1, 0, 0)
    movk_x(1, 0, 1)
    movk_x(1, 0, 2)
    addp(nl_at, "str64", intern_nz("\n"))
    set_reg(2, 1)
    set_reg(8, 64)
    sysc()
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)
    ret()

# x0 = number, writes it in decimal then a newline
emit_print_int:
    fn_names: _sov_list_add(fn_names, "_sov_print_int")
    fn_offs: _sov_list_add(fn_offs, here())
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    emitw(3506488319)
    mov_reg(9, 0)
    set_reg(21, 0)
    emitw(4043309375)
    ng: here()
    emitw(1409286154)
    set_reg(21, 1)
