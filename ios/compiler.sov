            print err_line
            had_err: 1
            return c
        if same(letter(line, i), " ") is 1
            c: c + 1
        if not
            return c
        i: i + 1
    return c
bk: 0
bi: 0
bj: 0
bs: 0
be: 0
br: 0
popblk:
    last: _sov_list_len(bk) - 1
    k: _sov_list_get(bk, last)
    if same(k, "while") is 1
        st: _sov_list_get(bs, last)
        at: jmp()
        put_arm(at, st - at)
        patch(_sov_list_get(bj, last))
    if not
        if same(k, "forever") is 1
            st: _sov_list_get(bs, last)
            at: jmp()
            put_arm(at, st - at)
        if not
            if same(k, "repeat") is 1
                rs: _sov_list_get(br, last)
