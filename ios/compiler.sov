                                                        load_glob("err_top")
                                                        mov_reg(9, 0)
                                                        emitw(4181723424)
                                                        store_glob("err_top")
                                                        emitw(2432746495)
                                                        tb: here()
                                                        emitw(335544320)
                                                        bs: _sov_list_set(bs, last, tb)
                                                        put_here(_sov_list_get(br, last))
                                                        load_glob("err_val")
                                                        store_loc(slot(ev))
                                                        bk: _sov_list_add(bk, "except")
                                                        bi: _sov_list_add(bi, ind)
                                                        bj: _sov_list_add(bj, 0)
                                                        bs: _sov_list_add(bs, 0)
                                                        be: _sov_list_add(be, _sov_list_new())
                                                        br: _sov_list_add(br, 0)
                                                    if not
                                                        print "Error: except without try"
                                                        _sov_print(s)
                                                        print err_line
                                                        had_err: 1
                                                if not
                                                    print "Error: except without try"
                                                    _sov_print(s)
                                                    print err_line
                                                    had_err: 1
                                            if not
                                                if starts(s, "raise ") is 1
