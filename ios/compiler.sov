        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    j: j + 1
                if not
                    return j
    return j
body lines:
    n: _sov_list_len(lines)
    i: 0
    bk: _sov_list_new()
    bi: _sov_list_new()
    bj: _sov_list_new()
    bs: _sov_list_new()
    be: _sov_list_new()
    br: _sov_list_new()
    as long as i < n
        raw: _sov_list_get(lines, i)
        s: strip(raw)
        err_line: i + 1
        if _sov_list_len(stmt_lns) > i
            err_line: _sov_list_get(stmt_lns, i)
        ind: nind(raw)
        if length(s) is 0
            i: i + 1
        if not
            if starts(s, "#") is 1
                i: i + 1
            if not
                isel: 0
                if same(s, "if not") is 1
                    isel: 1
                if starts(s, "except") is 1
                    isel: 1
                popgo: 1
                as long as popgo is 1
                    if _sov_list_len(bk) is 0
                        popgo: 0
                    if not
                        last: _sov_list_len(bk) - 1
                        if ind > _sov_list_get(bi, last)
                            popgo: 0
                        if not
                            stay: 0
                            if isel is 1
                                if ind is _sov_list_get(bi, last)
                                    if same(_sov_list_get(bk, last), "if") is 1
                                        stay: 1
                                    if same(_sov_list_get(bk, last), "try") is 1
                                        stay: 1
                            if stay is 1
                                popgo: 0
                            if not
                                popblk()
                loop_ok: 0
                if bad_eq(s) is 1
                    s: "if 0"
                if starts(s, "as long as ") is 1
                    s: join("while ", strip(cut(s, 11, length(s))))
                    loop_ok: 1
                if starts(s, "if ") is 1
                    if same(s, "if not") is 0
                        if starts(s, "if not ") is 0
                            expr(cut(s, 3, length(s)))
                            test_rax()
                            z: jz()
                            bk: _sov_list_add(bk, "if")
                            bi: _sov_list_add(bi, ind)
                            bj: _sov_list_add(bj, z)
                            bs: _sov_list_add(bs, 0)
                            be: _sov_list_add(be, _sov_list_new())
                            br: _sov_list_add(br, 0)
                        if not
                            stmt(s)
                    if not
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                if not
                    if same(s, "\x00__removed_and_if_not") is 1
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                    if not
                        if starts(s, "do while ") is 1
                            bln: collect_body(lines, i + 1, ind)
                            if try_opt_while(cut(s, 9, length(s)), bln) is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                            if not
                                cflush_all()
                                st: here()
                                z: emit_cmp_jge(cut(s, 9, length(s)))
                                if z is 0 - 1
                                    expr(cut(s, 9, length(s)))
                                    test_rax()
                                    z: jz()
                                bk: _sov_list_add(bk, "while")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, st)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                        if not
                            if loop_ok is 1
                                bln: collect_body(lines, i + 1, ind)
                                if try_opt_while(cut(s, 6, length(s)), bln) is 1
                                    i: skip_body(lines, i + 1, ind)
                                    i: i - 1
                                if not
                                    cflush_all()
                                    st: here()
                                    z: emit_cmp_jge(cut(s, 6, length(s)))
                                    if z is 0 - 1
                                        expr(cut(s, 6, length(s)))
                                        test_rax()
                                        z: jz()
                                    bk: _sov_list_add(bk, "while")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, z)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                            if not
                                if same(s, "do forever") is 1
                                    st: here()
                                    bk: _sov_list_add(bk, "forever")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, 0 - 1)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                if not
                                    if starts(s, "\x00__removed_repeat ") is 1
                                        cflush_all()
                                        tmp: cut(s, 7, length(s))
                                        tp: look(tmp, " times")
                                        if tp > 0 - 1
                                            tmp: cut(tmp, 0, tp)
                                        expr(tmp)
                                        cn: "__rep_c"
                                        inn: "__rep_i"
                                        storev(cn)
                                        xor_rax()
                                        storev(inn)
                                        rs: idx(locals, inn)
                                        cs: idx(locals, cn)
                                        st: here()
                                        load_loc(rs)
                                        push_rax()
                                        load_loc(cs)
                                        mov_rcx_rax()
                                        pop_rax()
                                        cmp_rax_rcx()
                                        setcc("lt")
                                        test_rax()
                                        z: jz()
                                        bk: _sov_list_add(bk, "repeat")
                                        bi: _sov_list_add(bi, ind)
                                        bj: _sov_list_add(bj, z)
                                        bs: _sov_list_add(bs, st)
                                        be: _sov_list_add(be, _sov_list_new())
                                        br: _sov_list_add(br, rs)
                                    if not
                                        if same(s, "try") is 1
                                            cflush_all()
                                            if idx(glob_names, "err_top") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_top")
                                            if idx(glob_names, "err_val") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_val")
                                            # the frame: the old error top, the frame
                                            # pointer, the stack, and where the handler
                                            # starts
                                            emitw(2432697321)
                                            emitw(4162785257)
                                            load_glob("err_top")
                                            emitw(4162785248)
                                            ta: here()
                                            emitw(268435466)
                                            emitw(4162785258)
                                            emitw(2432697321)
                                            mov_reg(0, 9)
                                            store_glob("err_top")
                                            bk: _sov_list_add(bk, "try")
                                            bi: _sov_list_add(bi, ind)
                                            bj: _sov_list_add(bj, 0)
                                            bs: _sov_list_add(bs, 0)
                                            be: _sov_list_add(be, _sov_list_new())
                                            br: _sov_list_add(br, ta)
                                        if not
