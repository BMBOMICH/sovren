            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            if length(rhs) > 0
                if digit(letter(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        nv: _sov_atoi(rhs)
                        cset(var, nv)
                        if nv > 0
                            kn: var
                            kv: nv
                        drop_str(var)
                        if has_vm is 0
