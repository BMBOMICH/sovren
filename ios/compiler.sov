                                                    emitw(4181723424)
                                                    store_glob("err_top")
                                                    emitw(4181725501)
                                                    emitw(4181727530)
                                                    emitw(2432696671)
                                                    emitw(4181721386)
                                                    emitw(3592356160)
                                                    put_here(zz)
