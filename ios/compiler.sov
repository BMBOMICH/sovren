str_pos: 0
fn_names: 0
fn_offs: 0
glob_names: 0
patch_at: 0
patch_kind: 0
patch_val: 0
patch_line: 0
locals: 0
src_base: 0
had_err: 0
ex_depth: 0
bare_mode: 0
stmt_lns: 0
body_lns: 0
task_lns: 0
task_user: 0
names: 0
BASE: 4194304
HDR: 120
opt_imm: 0
opt_src: 0
iota_ptr: 0
iota_lim: 0
mmap_sz: 1073741824
used_libs: blank
err_line: 0
kn: blank
kv: 0
pro_at: 0
skip_al: blank
used_al: 0
self_dir: 0
used_sl: 0
used_eq: 0
used_pr: 0
used_pi: 0
did_stos: 0
thin_main: 0
has_vm: 0
need_priv: 0
used_tr: 0
cnms: 0
cvls: 0
cemt: 0
str_vars: 0
str_fns: 0
ar_names: 0
ar_cnt: 0
saw_str: 0
length s:
    return _sov_strlen(s)
same a b:
    return _sov_str_eq(a, b)
starts t p:
    return _sov_starts_with(t, p)
look t s:
    return _sov_find_text(t, s)
cut t a b:
    return _sov_substring(t, a, b)
join a b:
    return _sov_strcat(a, b)
strip t:
    return _sov_trim(t)
letter t i:
    return _sov_char_at(t, i)
emit n:
    x: n % 256
    if x < 0
        x: x + 256
    oc: _sov_list_add(oc, x)
here:
    return _sov_list_len(oc)
addp at kind val:
    patch_at: _sov_list_add(patch_at, at)
    patch_kind: _sov_list_add(patch_kind, kind)
    patch_val: _sov_list_add(patch_val, val)
    patch_line: _sov_list_add(patch_line, err_line)
fail:
    syscall(60, 1, 0, 0, 0, 0, 0)
file_ln li:
    n: li + 1
    if n > src_base
        return n - src_base
    return n
idx lst name:
    i: 0
    as long as i < _sov_list_len(lst)
        if same(_sov_list_get(lst, i), name) is 1
            return i
        i: i + 1
    return 0 - 1
unesc s:
    n: length(s)
    r: _sov_alloc(n + 1)
    j: 0
    i: 0
    as long as i < n
        b: _sov_byte_at(s, i)
        if b is 92
            if i + 1 < n
                nxt: _sov_byte_at(s, i + 1)
                out: nxt
                if nxt is 110
                    out: 10
                if not
                    if nxt is 116
                        out: 9
                    if not
                        if nxt is 114
                            out: 13
                dummy: _sov_set_byte(r, j, out)
                j: j + 1
                i: i + 2
            if not
                dummy: _sov_set_byte(r, j, b)
                j: j + 1
                i: i + 1
        if not
            dummy: _sov_set_byte(r, j, b)
            j: j + 1
            i: i + 1
    dummy: _sov_set_byte(r, j, 0)
    return r
intern s:
    s: unesc(s)
    i: 0
    as long as i < _sov_list_len(str_keys)
        if same(_sov_list_get(str_keys, i), s) is 1
            return _sov_list_get(str_pos, i)
        i: i + 1
    off: _sov_buf_len(strb)
    k: 0
    as long as k < length(s)
        strb: _sov_buf_u8(strb, _sov_byte_at(s, k))
        k: k + 1
    strb: _sov_buf_u8(strb, 0)
    str_keys: _sov_list_add(str_keys, s)
    str_pos: _sov_list_add(str_pos, off)
    return off
slot name:
    i: idx(locals, name)
    if i > 0 - 1
        return i
    locals: _sov_list_add(locals, name)
    return _sov_list_len(locals) - 1
cset name val:
    ci: idx(cnms, name)
    if ci > 0 - 1
        cvls: _sov_list_set(cvls, ci, val)
        cemt: _sov_list_set(cemt, ci, 0)
        return
    cnms: _sov_list_add(cnms, name)
    cvls: _sov_list_add(cvls, val)
    cemt: _sov_list_add(cemt, 0)
cflush name:
    ci: idx(cnms, name)
    if ci < 0
        return
    if _sov_list_get(cemt, ci) is 1
        return
    rax_imm(_sov_list_get(cvls, ci))
    cemt: _sov_list_set(cemt, ci, 1)
    if idx(locals, name) < 0
        if idx(glob_names, name) > 0 - 1
            store_glob(name)
            return
    store_loc(slot(name))
cflush_all:
    i: 0
    as long as i < _sov_list_len(cnms)
        if _sov_list_get(cemt, i) is 0
            cflush(_sov_list_get(cnms, i))
        i: i + 1
loadv name:
    cflush(name)
    g: idx(glob_names, name)
    if g > 0 - 1
        if idx(locals, name) < 0
            load_glob(name)
            return
    i: idx(locals, name)
    if i > 0 - 1
        load_loc(i)
        return
    if g > 0 - 1
        load_glob(name)
        return
    print "Error: no such name"
    _sov_print(name)
    print err_line
    had_err: 1
    load_loc(slot(name))
storev name:
    ci: idx(cnms, name)
    if ci > 0 - 1
        cemt: _sov_list_set(cemt, ci, 1)
    g: idx(glob_names, name)
    if g > 0 - 1
        if idx(locals, name) < 0
            store_glob(name)
            return
    i: idx(locals, name)
    if i > 0 - 1
        store_loc(i)
        return
    if g > 0 - 1
        store_glob(name)
        return
    store_loc(slot(name))
mark_str name:
    if idx(str_vars, name) < 0
        str_vars: _sov_list_add(str_vars, name)
drop_str name:
    di: idx(str_vars, name)
    if di > 0 - 1
        str_vars: _sov_list_set(str_vars, di, "")
mark_fn_str name:
    if idx(str_fns, name) < 0
        str_fns: _sov_list_add(str_fns, name)
patch at:
    put_here(at)
rax_str s:
    at: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    addp(at, "str64x0", intern(s))
repl text old new:
    n: length(text)
    o: length(old)
    gn: length(new)
    r: _sov_alloc(n + gn + 8)
    p: 0
    j: 0
    ins: 0
    as long as p < n
        b: _sov_byte_at(text, p)
        if ins is 1
            if b is 92
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if p < n
                    poke_byte(r, j, _sov_byte_at(text, p))
                    j: j + 1
                    p: p + 1
            if not
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
            if not
                if starts(cut(text, p, n), old) is 1
                    k: 0
                    as long as k < gn
                        poke_byte(r, j, _sov_byte_at(new, k))
                        j: j + 1
                        k: k + 1
                    p: p + o
                if not
                    poke_byte(r, j, b)
                    j: j + 1
                    p: p + 1
    poke_byte(r, j, 0)
    return r
bad_eq s:
    ep: fop(s, "=")
    if ep > 0
        if same(letter(s, ep - 1), "=") is 1
            print "Error: use is, not =="
            _sov_print(s)
            print err_line
            had_err: 1
            return 1
        if same(letter(s, ep - 1), "!") is 1
            print "Error: use is not, not !="
            _sov_print(s)
            print err_line
            had_err: 1
            return 1
    return 0
cops text:
    r: text
    r: repl(r, " is not ", " != ")
    r: repl(r, " and ", " && ")
    r: repl(r, " or ", " || ")
    r: repl(r, " is ", " == ")
    return r
fop3 e:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
            i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if same(c, "*") is 1
                                f: i
                            if not
                                if same(c, "/") is 1
                                    f: i
                                if not
                                    if same(c, "%") is 1
                                        f: i
                        i: i + 1
    return f
fop2 e a b:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
            i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if same(c, a) is 1
                                f: i
                            if not
                                if same(c, b) is 1
                                    f: i
                        i: i + 1
    return f
fop e op:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
                if i < n
                    i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
                i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if starts(cut(e, i, n), op) is 1
                                f: i
                        i: i + 1
    return f
find_sep text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n - 3
        b: _sov_byte_at(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
        if ins is 0
            if same(cut(text, i, i + 4), " := ") is 1
                return i
        i: i + 1
    return 0 - 1
find_col text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n
        b: _sov_byte_at(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
            if not
                if b is 58
                    return i
        i: i + 1
    return 0 - 1
is_task_hdr s:
    n: length(s)
    if n < 2
        return 0
    if peek_byte(s, 0) is 35
        return 0
    if peek_byte(s, n - 1) is 58
        return 1
    return 0
ends_times s:
    if length(s) < 6
        return 0
    if same(cut(s, length(s) - 6, length(s)), " times") is 1
        return 1
    return 0
find_last_sp text:
    i: length(text) - 1
    as long as i > 0 - 1
        if same(letter(text, i), " ") is 1
            return i
        i: i - 1
    return 0 - 1
do_print_one arg:
    if length(arg) > 1
        if _sov_byte_at(arg, 0) is 34
            if same(letter(arg, length(arg) - 1), "\"") is 1
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
    typ: expr(arg)
    mov_rdi_rax()
    if typ is 1
        used_pr: 1
        calln("_sov_print")
    if not
        used_pi: 1
        calln("_sov_print_int")
do_print_times what nstr:
    expr(nstr)
    storev("__pt_c")
    xor_rax()
    storev("__pt_i")
    st: here()
    loadv("__pt_i")
    push_rax()
    loadv("__pt_c")
    mov_rcx_rax()
    pop_rax()
    cmp_rax_rcx()
    setcc("lt")
    test_rax()
    z: jz()
    do_print_one(what)
    inc_var("__pt_i")
    jb: jmp()
    put_arm(jb, st - jb)
    patch(z)
digit c:
    b: _sov_byte_at(c, 0)
    if b >= 48
        if b <= 57
            return 1
    return 0
bin L R op:
    expr(L)
    push_rax()
    expr(R)
    mov_rcx_rax()
    pop_rax()
    if same(op, "add") is 1
        add_rax_rcx()
        chk_ov()
        return
    if same(op, "sub") is 1
        sub_rax_rcx()
        chk_ov()
        return
    if same(op, "mul") is 1
        imul_rax_rcx()
        chk_ov()
        return
    if same(op, "div") is 1
        chk_zrcx()
        sdiv_rax_rcx()
        return
    if same(op, "mod") is 1
        chk_zrcx()
        mod_rax_rcx()
        return
    cmp_rax_rcx()
    setcc(op)
call_args name argc:
    if argc is 1
        pop_rax()
        mov_reg(0, 0)
    if not
        if argc is 2
            pop_reg(1)
            pop_rax()
        if not
            if argc is 3
                pop_reg(2)
                pop_reg(1)
                pop_rax()
            if not
                if argc is 4
                    pop_reg(3)
                    pop_reg(2)
                    pop_reg(1)
                    pop_rax()
                if not
                    if argc is 5
                        pop_reg(4)
                        pop_reg(3)
                        pop_reg(2)
                        pop_reg(1)
                        pop_rax()
                    if not
                        if argc is 6
                            pop_reg(5)
                            pop_reg(4)
                            pop_reg(3)
                            pop_reg(2)
                            pop_reg(1)
                            pop_rax()
                        if not
                            if argc is 7
                                pop_reg(6)
                                pop_reg(5)
                                pop_reg(4)
                                pop_reg(3)
                                pop_reg(2)
                                pop_reg(1)
                                pop_rax()
    if same(name, "_sov_alloc") is 1
        used_al: 1
    if same(name, "_sov_strlen") is 1
        used_sl: 1
    if same(name, "_sov_str_eq") is 1
        used_eq: 1
    if same(name, "cfunc") is 1
        # x0 holds the address, x1..x6 the arguments. C wants the
        # arguments in x0..x5, so shift them down and call.
        mov_reg(9, 0)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        emitw(3594453280)
        return
    if same(name, "syscall") is 1
        mov_reg(8, 0)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        sysc()
        return
    if same(name, "hlt") is 1
        emitw(3573751935)
        return
    if same(name, "cli") is 1
        emitw(3573760735)
        return
    if same(name, "sti") is 1
        emitw(3573760767)
        return
    if same(name, "peek_raw8") is 1
        ldrb_x0_x0x1()
        return
    if same(name, "peek_raw64") is 1
        ldr_x0_x0x1()
        return
    if same(name, "poke_raw8") is 1
        strb_x2_x0x1()
        return
    if same(name, "poke_raw64") is 1
        str_x2_x0x1()
        return
    if same(name, "peek_byte") is 1
        chk_mem(1)
        ldrb_x0_x0x1()
        return
    if same(name, "peek_i64") is 1
        chk_mem(8)
        ldr_x0_x0x1()
        return
    if same(name, "peek_ptr") is 1
        chk_mem(8)
        ldr_x0_x0x1()
        return
    if same(name, "poke_byte") is 1
        chk_mem(1)
        strb_x2_x0x1()
        return
    if same(name, "poke_i64") is 1
        chk_mem(8)
        str_x2_x0x1()
        return
    calln(name)
expr e0:
    ex_depth: ex_depth + 1
    if ex_depth > 150
        if had_err is 0
            print "Error: expression too long, split it up"
            print err_line
            had_err: 1
        ex_depth: ex_depth - 1
        xor_rax()
        return 0
    t: expr_body(e0)
    ex_depth: ex_depth - 1
    return t

expr_body e0:
    e: strip(e0)
    if length(e) is 0
        xor_rax()
        return 0
    if length(e) > 0
        if _sov_byte_at(e, 0) is 34
            if length(e) > 1
                rax_str(cut(e, 1, length(e) - 1))
                return 1
            rax_str("")
            return 1
    if starts(e, "as text ") is 1
        expr(cut(e, 8, length(e)))
        return 1
    # addr_of name -- where a job lives, so a C library can call back
    if starts(e, "addr_of ") is 1
        aat: here()
        movz_x(0, 0, 0)
        movk_x(0, 0, 1)
        movk_x(0, 0, 2)
        movk_x(0, 0, 3)
        addp(aat, "fnaddr64", strip(cut(e, 8, length(e))))
        return 0
    if starts(e, "length of ") is 1
        expr(cut(e, 10, length(e)))
        mov_rdi_rax()
        used_sl: 1
        calln("_sov_strlen")
        return 0
    e: strip(cops(e))
    p: fop(e, "||")
    if p > 0 - 1
        expr(cut(e, 0, p))
        test_rax()
        a: jnz()
        expr(cut(e, p + 2, length(e)))
        test_rax()
        b: jnz()
        xor_rax()
        d: jmp()
        patch(a)
        patch(b)
        rax_imm(1)
        patch(d)
        return 0
    p: fop(e, "&&")
    if p > 0 - 1
        expr(cut(e, 0, p))
        test_rax()
        a: jz()
        expr(cut(e, p + 2, length(e)))
        test_rax()
        b: jz()
        rax_imm(1)
        d: jmp()
        patch(a)
        patch(b)
        xor_rax()
        patch(d)
        return 0
    p: fop(e, "==")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "eq")
        return 0
    p: fop(e, "!=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "ne")
        return 0
    p: fop(e, "<=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "le")
        return 0
    p: fop(e, ">=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "ge")
        return 0
    p: fop(e, "<")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "lt")
        return 0
    p: fop(e, ">")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "gt")
        return 0
    p: fop2(e, "+", "-")
    if p > 0
        if same(letter(e, p), "+") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "add")
            return 0
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "sub")
        return 0
    if p is 0
        if same(letter(e, p), "+") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "add")
            return 0
    p: fop3(e)
    if p > 0 - 1
        o: letter(e, p)
        if same(o, "*") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "mul")
            return 0
        if same(o, "/") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "div")
            return 0
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "mod")
        return 0
    if same(e, "blank") is 1
        rax_str("")
        return 1
    if length(e) > 0
        if _sov_byte_at(e, 0) is 34
            rax_str(cut(e, 1, length(e) - 1))
            return 1
    if starts(e, "(") is 1
        if same(letter(e, length(e) - 1), ")") is 1
            expr(cut(e, 1, length(e) - 1))
            return 0
    lp: look(e, "(")
    if lp > 0
        if same(letter(e, length(e) - 1), ")") is 1
            name: strip(cut(e, 0, lp))
            inside: cut(e, lp + 1, length(e) - 1)
            argc: 0
            if length(strip(inside)) > 0
                depth: 0
                ins: 0
                start: 0
                i: 0
                ilen: length(inside)
                as long as i < ilen
                    c: letter(inside, i)
                    if ins is 1
                        if _sov_byte_at(inside, i) is 92
                            i: i + 1
                        if not
                            if _sov_byte_at(inside, i) is 34
                                ins: 0
                    if not
                        if _sov_byte_at(inside, i) is 34
                            ins: 1
                        if not
                            if same(c, "(") is 1
                                depth: depth + 1
                            if not
                                if same(c, ")") is 1
                                    depth: depth - 1
                                if not
                                    if same(c, ",") is 1
                                        if depth is 0
                                            expr(cut(inside, start, i))
                                            push_rax()
                                            argc: argc + 1
                                            start: i + 1
                    i: i + 1
                expr(cut(inside, start, ilen))
                push_rax()
                argc: argc + 1
            axi: idx(ar_names, name)
            if axi > 0 - 1
                if _sov_list_get(ar_cnt, axi) is not argc
                    print "Error: wrong number of values"
                    _sov_print(name)
                    print err_line
                    had_err: 1
            call_args(name, argc)
            if same(name, "cat") is 1
                return 1
            if same(name, "strcat") is 1
                return 1
