            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    out: _sov_list_add(out, s)
                    j: j + 1
                if not
                    return out
    return out
skip_body lines start bind:
    j: start
    n: _sov_list_len(lines)
