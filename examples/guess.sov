# guess.sov — I think of a number, you find it

use input
use rand
use num
use sys

main:
    print "I am thinking of a number from 1 to 100."
    print "You have 7 tries."
    secret: rand_range(1, 100)
    tries: 0
    won: 0
    as long as tries < 7
        left: 7 - tries
        write_out("Tries left: ")
        write_out(num_text(left))
        write_out(" > ")
        g: input_num()
        tries: tries + 1
        if g is secret
            write_out("Correct! You got it in ")
            write_out(num_text(tries))
            print " tries."
            won: 1
            tries: 7
        if not
            if g < secret
                print "Too low."
            if not
                print "Too high."
    if won is 0
        write_out("Out of tries. It was ")
        print secret
