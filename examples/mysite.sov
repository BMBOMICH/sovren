# mysite.sov — a whole page, written by Sovren. Run it, then open
# mysite.html: every tag on it was printed by this program, never
# typed by hand.
#
#   ./sovren mysite.sov -o mysite && ./mysite
#
use site

main:
    site_new("My site")
    site_back("linen")
    site_color("navy")
    site_size(36)
    site_big("Hello")
    site_rule()
    site_size(20)
    site_color("black")
    site_heading(1, "About me")
    site_p("This whole page was written by a Sovren program.")
    site_heading(2, "Things I like")
    site_bullets("music|books|making pages")
    site_heading(2, "Get in touch")
    site_input("your name")
    site_position(40, 160)
    site_color("white")
    site_fill("navy")
    site_button("Send")
    site_position(40, 220)
    site_color("navy")
    site_go("https://example.com", "A link")
    site_image("https://example.com/pic.png", "a picture")
    site_save("mysite.html")
    print "wrote mysite.html"
