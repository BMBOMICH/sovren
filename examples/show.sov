# show.sov — every word in one place
# read BOOK.md to learn them
# run: ./sovren show.sov -o /tmp/show

add a b:
    return a + b

main:
    # a comment starts with #

    # a box holds a number or letters
    a: 3
    b: 7
    print a
    print b
    print a + b

    # quotes mean letters
    print "hello"

    # blank is empty letters
    s: blank

    # math: * / % come before + -
    print 2 + 3 * 4
    print (2 + 3) * 4
    print 8 / 2
    print 7 % 3

    # a job
    print add(40, 2)

    # if and its other side
    if a + b > 5
        print "big"
    if not
        print "small"

    # is, is not, and, or
    if a is 3 and b is not 4
        print "both"

    # a loop
    i: 0
    as long as i < 3
        print i
        i: i + 1

    # print the same line more than once
    print "loop" 2 times
