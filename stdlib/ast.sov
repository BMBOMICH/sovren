struct Token {
    kind:     int
    str_val:  string
    int_val:  int
    float_val: float
    line:     int
    col:      int
}

task token_new(kind: int, line: int, col: int) -> Token {
    return Token {
        kind:     kind,
        str_val:  "",
        int_val:  0,
        float_val: 0.0,
        line:     line,
        col:      col
    }
}

task token_with_str(kind: int, str_val: string, line: int, col: int) -> Token {
    return Token {
        kind:     kind,
        str_val:  str_val,
        int_val:  0,
        float_val: 0.0,
        line:     line,
        col:      col
    }
}

task token_with_int(kind: int, int_val: int, line: int, col: int) -> Token {
    return Token {
        kind:     kind,
        str_val:  "",
        int_val:  int_val,
        float_val: 0.0,
        line:     line,
        col:      col
    }
}

task token_with_float(kind: int, float_val: float, line: int, col: int) -> Token {
    return Token {
        kind:     kind,
        str_val:  "",
        int_val:  0,
        float_val: float_val,
        line:     line,
        col:      col
    }
}

task token_kind_name(kind: int) -> string {
    check kind == TOK_EOF { return "EOF" }
    check kind == TOK_NEWLINE { return "NEWLINE" }
    check kind == TOK_INTEGER { return "INTEGER" }
    check kind == TOK_FLOAT { return "FLOAT" }
    check kind == TOK_STRING { return "STRING" }
    check kind == TOK_IDENTIFIER { return "IDENTIFIER" }
    check kind == TOK_SET { return "SET" }
    check kind == TOK_TASK { return "TASK" }
    check kind == TOK_CHECK { return "CHECK" }
    check kind == TOK_LOOP { return "LOOP" }
    check kind == TOK_RETURN { return "RETURN" }
    check kind == TOK_STRUCT { return "STRUCT" }
    check kind == TOK_ENUM { return "ENUM" }
    check kind == TOK_MATCH { return "MATCH" }
    check kind == TOK_PLUS { return "PLUS" }
    check kind == TOK_MINUS { return "MINUS" }
    check kind == TOK_STAR { return "STAR" }
    check kind == TOK_SLASH { return "SLASH" }
    check kind == TOK_ASSIGN { return "ASSIGN" }
    check kind == TOK_EQUAL { return "EQUAL" }
    check kind == TOK_LPAREN { return "LPAREN" }
    check kind == TOK_RPAREN { return "RPAREN" }
    check kind == TOK_LBRACE { return "LBRACE" }
    check kind == TOK_RBRACE { return "RBRACE" }
    check kind == TOK_COMMA { return "COMMA" }
    check kind == TOK_DOT { return "DOT" }
    check kind == TOK_COLON { return "COLON" }
    check kind == TOK_ARROW { return "ARROW" }
    return "UNKNOWN"
}

struct VecToken {
    data:     ptr
    length:   int
    capacity: int
}

const TOKEN_SIZE = 48

task vectok_new() -> VecToken {
    return VecToken {
        data:     alloc(4, TOKEN_SIZE),
        length:   0,
        capacity: 4
    }
}

task vectok_push(v: VecToken, tok: Token) -> VecToken {
    check v.length >= v.capacity {
        set new_cap = v.capacity * 2
        set new_data = alloc(new_cap, TOKEN_SIZE)
        override {
            memcpy(new_data, v.data, v.length * TOKEN_SIZE)
        }
        free v.data
        v.data = new_data
        v.capacity = new_cap
    }
    
    set base = ptr_offset(v.data, v.length * TOKEN_SIZE)
    override {
        ptr_set_int(base, 0, tok.kind)
        ptr_set_int(base, 1, tok.str_val)
        ptr_set_int(base, 2, tok.int_val)
        ptr_set_int(base, 4, tok.line)
        ptr_set_int(base, 5, tok.col)
    }
    v.length = v.length + 1
    return v
}

task vectok_get(v: VecToken, index: int) -> Token {
    assert(index >= 0 and index < v.length, "VecToken index out of bounds")
    set base = ptr_offset(v.data, index * TOKEN_SIZE)
    set tok = Token {
        kind:      0,
        str_val:   "",
        int_val:   0,
        float_val: 0.0,
        line:      0,
        col:       0
    }
    override {
        tok.kind = ptr_get_int(base, 0)
        tok.str_val = ptr_get_int(base, 1)
        tok.int_val = ptr_get_int(base, 2)
        tok.line = ptr_get_int(base, 4)
        tok.col = ptr_get_int(base, 5)
    }
    return tok
}

task vectok_len(v: VecToken) -> int {
    return v.length
}

task vectok_free(v: VecToken) {
    free v.data
}

const TYPE_INT      = 1
const TYPE_FLOAT    = 2
const TYPE_BOOL     = 3
const TYPE_STRING   = 4
const TYPE_VOID     = 5
const TYPE_PTR      = 6
const TYPE_ARRAY    = 7
const TYPE_STRUCT   = 8
const TYPE_ENUM     = 9
const TYPE_FUNC     = 10
const TYPE_GENERIC  = 11
const TYPE_INT8     = 12
const TYPE_INT16    = 13
const TYPE_INT64    = 14
const TYPE_UINT8    = 15
const TYPE_UINT16   = 16
const TYPE_UINT32   = 17
const TYPE_UINT64   = 18

struct TypeInfo {
    kind:      int
    name:      string
    inner:     ptr
    size:      int
}

task type_new(kind: int) -> TypeInfo {
    return TypeInfo {
        kind:  kind,
        name:  "",
        inner: null,
        size:  -1
    }
}

task type_named(kind: int, name: string) -> TypeInfo {
    return TypeInfo {
        kind:  kind,
        name:  name,
        inner: null,
        size:  -1
    }
}

task type_ptr(inner: ptr) -> TypeInfo {
    return TypeInfo {
        kind:  TYPE_PTR,
        name:  "",
        inner: inner,
        size:  -1
    }
}

task type_array(inner: ptr, size: int) -> TypeInfo {
    return TypeInfo {
        kind:  TYPE_ARRAY,
        name:  "",
        inner: inner,
        size:  size
    }
}

task type_to_string(t: TypeInfo) -> string {
    check t.kind == TYPE_INT { return "int" }
    check t.kind == TYPE_FLOAT { return "float" }
    check t.kind == TYPE_BOOL { return "bool" }
    check t.kind == TYPE_STRING { return "string" }
    check t.kind == TYPE_VOID { return "void" }
    check t.kind == TYPE_INT8 { return "int8" }
    check t.kind == TYPE_INT16 { return "int16" }
    check t.kind == TYPE_INT64 { return "int64" }
    check t.kind == TYPE_UINT8 { return "uint8" }
    check t.kind == TYPE_UINT16 { return "uint16" }
    check t.kind == TYPE_UINT32 { return "uint32" }
    check t.kind == TYPE_UINT64 { return "uint64" }
    check t.kind == TYPE_PTR { return "ptr" }
    check t.kind == TYPE_STRUCT or t.kind == TYPE_ENUM or t.kind == TYPE_GENERIC {
        return t.name
    }
    return "unknown"
}

