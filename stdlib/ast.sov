struct Expr {
    kind:       int
    int_val:    int
    float_val:  float
    bool_val:   bool
    str_val:    string
    op:         int
    left:       ptr
    right:      ptr
    callee:     string
    args:       ptr
    type_info:  ptr
    line:       int
    col:        int
}

task expr_int(val: int, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_INT)
        ptr_set_int(e, 1, val)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

task expr_float(val: float, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_FLOAT)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

task expr_bool(val: bool, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    set v = 0
    check val { v = 1 }
    override {
        ptr_set_int(e, 0, EXPR_BOOL)
        ptr_set_int(e, 3, v)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

