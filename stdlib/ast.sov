struct Stmt {
    kind:        int
    name:        string
    expr:        ptr
    expr2:       ptr
    block:       ptr
    else_block:  ptr
    params:      ptr
    return_type: ptr
    type_info:   ptr
    is_sensitive: bool
    is_inline:   bool
    is_async:    bool
    is_extern:   bool
    line:        int
    col:         int
}

task stmt_var_decl(name: string, type_info: ptr, init: ptr, is_sensitive: bool, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_VAR_DECL)
        ptr_set_int(s, 1, name)
        ptr_set_int(s, 2, init)
        ptr_set_int(s, 7, type_info)
        ptr_set_int(s, 8, is_sensitive)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

task stmt_const_decl(name: string, init: ptr, line: int, col: int) -> ptr {
