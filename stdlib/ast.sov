task expr_kind(e: ptr) -> int {
    check e == null { return 0 }
    override {
        return ptr_get_int(e, 0)
    }
    return 0
}

task expr_get_int(e: ptr) -> int {
    override {
        return ptr_get_int(e, 1)
    }
    return 0
}

task expr_get_str(e: ptr) -> string {
    override {
        return ptr_get_int(e, 4)
    }
    return ""
}

task expr_get_op(e: ptr) -> int {
    override {
        return ptr_get_int(e, 5)
    }
    return 0
}

task expr_get_left(e: ptr) -> ptr {
    override {
        return ptr_get_int(e, 6)
    }
    return null
}

task expr_get_right(e: ptr) -> ptr {
    override {
        return ptr_get_int(e, 7)
    }
    return null
}

task expr_get_callee(e: ptr) -> string {
    override {
        return ptr_get_int(e, 8)
    }
    return ""
}

task expr_get_args(e: ptr) -> ptr {
    override {
        return ptr_get_int(e, 9)
    }
    return null
}

task expr_get_line(e: ptr) -> int {
    override {
        return ptr_get_int(e, 10)
    }
    return 0
}

task expr_get_col(e: ptr) -> int {
    override {
        return ptr_get_int(e, 11)
    }
    return 0
}

task expr_get_name(e: ptr) -> string {
    return expr_get_str(e)
}

task expr_get_operand(e: ptr) -> ptr {
    return expr_get_left(e)
}

task expr_get_object(e: ptr) -> ptr {
    return expr_get_left(e)
}

task expr_get_field(e: ptr) -> string {
    return expr_get_str(e)
}

task expr_get_array(e: ptr) -> ptr {
    return expr_get_left(e)
}

task expr_get_index(e: ptr) -> ptr {
    return expr_get_right(e)
}

task expr_get_type_name(e: ptr) -> string {
    return expr_get_str(e)
}

task expr_get_cast_type(e: ptr) -> string {
    return expr_get_callee(e)
}

task params_count(p: ptr) -> int {
    check p == null { return 0 }
    override { return ptr_get_int(p, 4) }
    return 0
}

task params_get(p: ptr, index: int) -> ptr {
    check p == null { return null }
    set data = 0
    set length = 0
    override { 
        data = ptr_get_int(p, 0)
        length = ptr_get_int(p, 4)
    }
    check index >= 0 and index < length { return null }
    set base = ptr_offset(data, index * 16)
    return base
}

task param_get_name(param: ptr) -> string {
    override { return ptr_get_int(param, 0) }
    return ""
}

task param_get_type(param: ptr) -> string {
    set ti = 0
    override { ti = ptr_get_int(param, 8) }
    check ti != 0 {
        set kind = 0
        override { kind = ptr_get_int(ti, 0) }
        check kind == TYPE_INT { return "int" }
        check kind == TYPE_FLOAT { return "float" }
        check kind == TYPE_BOOL { return "bool" }
        check kind == TYPE_STRING { return "string" }
        check kind == TYPE_INT8 { return "int8" }
        check kind == TYPE_INT16 { return "int16" }
        check kind == TYPE_INT64 { return "int64" }
        check kind == TYPE_UINT8 { return "uint8" }
        check kind == TYPE_UINT16 { return "uint16" }
        check kind == TYPE_UINT32 { return "uint32" }
        check kind == TYPE_UINT64 { return "uint64" }
        set name = 0
        override { name = ptr_get_int(ti, 8) }
        check name != 0 { return name }
    }
    return ""
}

task args_count(args: ptr) -> int {
    check args == null { return 0 }
    set len = 0
    override { len = ptr_get_int(args, 1) }
    return len
}

task args_get(args: ptr, index: int) -> ptr {
    check args == null { return null }
    set len = 0
    set data = 0
    override { 
        data = ptr_get_int(args, 0)
        len = ptr_get_int(args, 1)
    }
    check index >= 0 and index < len { return null }
    set result = 0
    override { result = ptr_get_int(data, index) }
    return result
}

task block_stmt_count(block: ptr) -> int {
    check block == null { return 0 }
    set len = 0
    override { len = ptr_get_int(block, 1) }
    return len
}

task block_get_stmt(block: ptr, index: int) -> ptr {
    check block == null { return null }
    set len = 0
    set data = 0
    override { 
        data = ptr_get_int(block, 0)
        len = ptr_get_int(block, 1)
    }
    check index >= 0 and index < len { return null }
    set result = 0
    override { result = ptr_get_int(data, index) }
    return result
}

struct VecExpr {
    data:     ptr
    length:   int
    capacity: int
}

task vecexpr_new() -> VecExpr {
    return VecExpr {
        data:     alloc(4, 8),
        length:   0,
        capacity: 4
    }
}

task vecexpr_push(v: VecExpr, e: ptr) -> VecExpr {
    check v.length >= v.capacity {
        set new_cap = v.capacity * 2
        set new_data = alloc(new_cap, 8)
        override {
            memcpy(new_data, v.data, v.length * 8)
        }
        free v.data
        v.data = new_data
        v.capacity = new_cap
    }
    override {
        ptr_set_int(v.data, v.length, e)
    }
    v.length = v.length + 1
    return v
}

task vecexpr_get(v: VecExpr, index: int) -> ptr {
    assert(index >= 0 and index < v.length, "VecExpr index out of bounds")
    override {
        return ptr_get_int(v.data, index)
    }
    return null
}

task vecexpr_len(v: VecExpr) -> int {
    return v.length
}

task vecexpr_free(v: VecExpr) {
    free v.data
}

