task stmt_kind(s: ptr) -> int {
    check s == null { return 0 }
    override {
        return ptr_get_int(s, 0)
    }
    return 0
}

task stmt_get_name(s: ptr) -> string {
    override {
        return ptr_get_int(s, 1)
    }
    return ""
}

task stmt_get_expr(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 2)
    }
    return null
}

task stmt_get_expr2(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 3)
    }
    return null
}

task stmt_get_block(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 4)
    }
    return null
}

task stmt_get_else_block(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 5)
    }
    return null
}

task stmt_get_params(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 6)
    }
    return null
}

task stmt_get_return_type(s: ptr) -> string {
    set ti = 0
    override { ti = ptr_get_int(s, 7) }
    check ti != 0 {
        set kind = 0
        override { kind = ptr_get_int(ti, 0) }
        check kind == TYPE_INT { return "int" }
        check kind == TYPE_FLOAT { return "float" }
        check kind == TYPE_BOOL { return "bool" }
        check kind == TYPE_STRING { return "string" }
        check kind == TYPE_VOID { return "void" }
        check kind == TYPE_INT8 { return "int8" }
        check kind == TYPE_INT16 { return "int16" }
        check kind == TYPE_INT64 { return "int64" }
        check kind == TYPE_UINT8 { return "uint8" }
        check kind == TYPE_UINT16 { return "uint16" }
        check kind == TYPE_UINT32 { return "uint32" }
        check kind == TYPE_UINT64 { return "uint64" }
        return ""
    }
    return ""
}

task stmt_get_type(s: ptr) -> string {
    return stmt_get_return_type(s)
}

task stmt_get_condition(s: ptr) -> ptr {
    return stmt_get_expr(s)
}

task stmt_get_then_block(s: ptr) -> ptr {
    return stmt_get_block(s)
}

task stmt_get_loop_var(s: ptr) -> string {
    return stmt_get_name(s)
}

task stmt_get_start_expr(s: ptr) -> ptr {
    return stmt_get_expr(s)
}

task stmt_get_end_expr(s: ptr) -> ptr {
    return stmt_get_expr2(s)
}

task stmt_is_sensitive(s: ptr) -> bool {
    set val = 0
    override { val = ptr_get_int(s, 8) }
    return val != 0
}

struct VecStmt {
    data:     ptr
    length:   int
    capacity: int
}

task vecstmt_new() -> VecStmt {
    return VecStmt {
        data:     alloc(8, 8),
        length:   0,
        capacity: 8
    }
}

task vecstmt_push(v: VecStmt, s: ptr) -> VecStmt {
    check v.length >= v.capacity {
        set new_cap = v.capacity * 2
        set new_data = alloc(new_cap, 8)
        override {
            memcpy(new_data, v.data, v.length * 8)
        }
        free v.data
        v.data = new_data
        v.capacity = new_cap
    }
    override {
        ptr_set_int(v.data, v.length, s)
    }
    v.length = v.length + 1
    return v
}

task vecstmt_get(v: VecStmt, index: int) -> ptr {
    assert(index >= 0 and index < v.length, "VecStmt index out of bounds")
    override {
        return ptr_get_int(v.data, index)
    }
    return null
}

task vecstmt_len(v: VecStmt) -> int {
    return v.length
}

task vecstmt_free(v: VecStmt) {
    free v.data
}

struct Param {
    name:      string
    type_info: ptr
}

struct VecParam {
    data:     ptr
    length:   int
    capacity: int
}

task vecparam_new() -> VecParam {
    return VecParam {
        data:     alloc(4, 16),
        length:   0,
        capacity: 4
    }
}

task vecparam_push(v: VecParam, name: string, type_info: ptr) -> VecParam {
    check v.length >= v.capacity {
        set new_cap = v.capacity * 2
        set new_data = alloc(new_cap, 16)
        override {
            memcpy(new_data, v.data, v.length * 16)
        }
        free v.data
        v.data = new_data
        v.capacity = new_cap
    }
    override {
        ptr_set_int(v.data, v.length * 2, name)
        ptr_set_int(v.data, v.length * 2 + 1, type_info)
    }
    v.length = v.length + 1
    return v
}

task vecparam_get_name(v: VecParam, index: int) -> string {
    assert(index >= 0 and index < v.length, "VecParam index out of bounds")
    override {
        return ptr_get_int(v.data, index * 2)
    }
    return ""
}

task vecparam_get_type(v: VecParam, index: int) -> ptr {
    assert(index >= 0 and index < v.length, "VecParam index out of bounds")
    override {
        return ptr_get_int(v.data, index * 2 + 1)
    }
    return null
}

task vecparam_len(v: VecParam) -> int {
    return v.length
}

task vecparam_free(v: VecParam) {
    free v.data
}

struct Program {
    statements: VecStmt
    filename:   string
}

task program_new(filename: string) -> Program {
    return Program {
        statements: vecstmt_new(),
        filename:   filename
    }
}

task program_add_stmt(p: Program, s: ptr) -> Program {
    p.statements = vecstmt_push(p.statements, s)
    return p
}

task program_stmt_count(p: Program) -> int {
    return vecstmt_len(p.statements)
}

task program_get_stmt(p: Program, index: int) -> ptr {
    return vecstmt_get(p.statements, index)
}

task program_free(p: Program) {
    vecstmt_free(p.statements)
}
