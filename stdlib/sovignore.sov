task sovignore_load() -> VecStr {
    set patterns = vecstr_new()
    set content = file_read_all(".sovignore")
    check content == null or str_len(content) == 0 { return patterns }

    set lines = str_split(content, "\n")
    set n = vecstr_len(lines)
    loop i from 0 to n - 1 {
        set line = str_trim(vecstr_get(lines, i))
        check str_len(line) == 0 or str_char_at(line, 0) == 35 { continue }
        patterns = vecstr_push(patterns, line)
    }
    return patterns
}

task sovignore_matches(pattern: string, path: string) -> bool {
    check str_ends_with(pattern, "/") {
        return str_starts_with(path, pattern)
    }

    check str_starts_with(pattern, "*.") {
        set ext = str_substr(pattern, 1, str_len(pattern) - 1)
        return str_ends_with(path, ext)
    }

    check str_starts_with(pattern, "*/") {
        return str_contains(path, str_substr(pattern, 1, str_len(pattern) - 1))
    }

    check str_contains(pattern, "*") {
        set parts = str_split(pattern, "*")
        set pos = 0
        set n = vecstr_len(parts)
        loop i from 0 to n - 1 {
            set part = vecstr_get(parts, i)
            check str_len(part) == 0 { continue }
            set found = str_find_from(path, part, pos)
            check found < 0 { return false }
            pos = found + str_len(part)
        }
        return true
    }

    return str_eq(path, pattern)
}

task sovignore_should_ignore(path: string) -> bool {
    set patterns = sovignore_load()
    set n = vecstr_len(patterns)
    loop i from 0 to n - 1 {
        set pattern = vecstr_get(patterns, i)
        check sovignore_matches(pattern, path) { return true }
    }
    return false
}
