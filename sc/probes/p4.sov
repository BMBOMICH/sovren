f2 x y:
    return x * 100 + y
f6 a b c d e f:
    return a + b + c + d + e + f
g x y:
    return x - y
h x:
    return x + 1
fib n:
    if n < 2 -> return n
    return fib(n - 1) + fib(n - 2)
main:
    print f2(1, 2)
    print f6(1, 2, 3, 4, 5, 6)
    print g(h(1), 2)
    print g(2, h(1))
    print f2(fib(5), f2(1, 2))
    print f2(3, fib(6))
