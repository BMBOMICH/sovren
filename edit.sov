# edit.sov — a small full screen text editor, written in Sovren.
# Proof that the libraries are enough to build Sovren Code.
#
#   arrows  move          typing  inserts
#   ctrl-s  save          ctrl-q  quit
#   enter   split line    backspace joins

use tui
use key
use file
use list
use string
use num
use arg

rows: 0
dirty: 0
cx: 1
cy: 1
top: 0
fname: blank

load path:
    rows: list_new()
    d: file_read_all(path)
    if d is 0
        rows: list_add(rows, "")
        return 1
    n: str_len(d)
    if n is 0
        rows: list_add(rows, "")
        return 1
    start: 0
    i: 0
    as long as i < n
        if peek_byte(d, i) is 10
            rows: list_add(rows, str_cut(d, start, i))
            start: i + 1
        i: i + 1
    if start < n
        rows: list_add(rows, str_cut(d, start, n))
    if list_len(rows) is 0
        rows: list_add(rows, "")
    return 1

save path:
    out: ""
    i: 0
    as long as i < list_len(rows)
        out: str_cat(out, as text list_get(rows, i))
        out: str_cat(out, "\n")
        i: i + 1
    file_write_all(path, out)
    dirty: 0
    return 1

draw:
    h: tui_rows() - 1
    tui_goto(1, 1)
    i: 0
    as long as i < h
        tui_clear_line()
        ln: top + i
        if ln < list_len(rows)
            write_out(as text list_get(rows, ln))
        write_out("\n")
        i: i + 1
    tui_goto(tui_rows(), 1)
    tui_reverse()
    tui_clear_line()
    bar: str_cat(" ", fname)
    if dirty is 1
        bar: str_cat(bar, " *")
    bar: str_cat(bar, "  line ")
    bar: str_cat(bar, num_text(top + cy))
    bar: str_cat(bar, "  ctrl-s save  ctrl-q quit")
    write_out(bar)
    tui_reset()
    tui_goto(cy, cx)
    return 1

cur_line:
    ln: top + cy - 1
    if ln < list_len(rows)
        return as text list_get(rows, ln)
    return as text ""

set_line s:
    ln: top + cy - 1
    rows: list_set(rows, ln, s)
    dirty: 1
    return 1

insert_ch c:
    s: cur_line()
    p: _sov_alloc(2)
    poke_byte(p, 0, c)
    poke_byte(p, 1, 0)
    n: str_len(s)
    a: str_cut(s, 0, cx - 1)
    b: str_cut(s, cx - 1, n)
    set_line(str_cat(str_cat(a, as text p), b))
    cx: cx + 1
    return 1

backspace:
    s: cur_line()
    if cx > 1
        n: str_len(s)
        a: str_cut(s, 0, cx - 2)
        b: str_cut(s, cx - 1, n)
        set_line(str_cat(a, b))
        cx: cx - 1
    return 1

newline:
    s: cur_line()
    n: str_len(s)
    ln: top + cy - 1
    a: str_cut(s, 0, cx - 1)
    b: str_cut(s, cx - 1, n)
    rows: list_set(rows, ln, a)
    rows: list_ins(rows, ln + 1, b)
    dirty: 1
    cx: 1
    cy: cy + 1
    return 1

main:
    fname: "untitled.txt"
    if arg_count() > 1
        fname: as text arg_at(1)
    load(fname)
    key_raw_on()
    tui_enter()
    tui_clear()
    going: 1
    as long as going is 1
        draw()
        c: key_read()
        if c is 17
            going: 0
        if c is 19
            save(fname)
        if c is 13
            newline()
        if c is 10
            newline()
        if c is 127
            backspace()
        if c is 8
            backspace()
        if c is 27
            k1: key_read()
            k2: key_read()
            if k2 is 65
                if cy > 1
                    cy: cy - 1
            if k2 is 66
                if top + cy < list_len(rows)
                    cy: cy + 1
            if k2 is 67
                cx: cx + 1
            if k2 is 68
                if cx > 1
                    cx: cx - 1
        if c > 31
            if c < 127
                insert_ch(c)
    tui_leave()
    tui_show()
    print "bye"
