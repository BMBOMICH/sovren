# make a page, then open mysite.html in a browser
use site

main:
    site_new("My site")
    site_back("linen")
    site_color("navy")
    site_size(36)
    site_big("Hello")
    site_size(20)
    site_color("black")
    site_say("This page was made with Sovren.")
    site_position(40, 160)
    site_color("white")
    site_fill("navy")
    site_button("Click")
    site_position(40, 220)
    site_color("navy")
    site_go("https://example.com", "A link")
    site_save("mysite.html")
    print "wrote mysite.html"
