# debug.sov — look inside a running program. A real debugger, the
# honest way: the program is loaded into the x86 emulator and run
# one instruction at a time, so every step can be looked at.
#
#   ./sovren debug.sov -o debug && ./debug ./hello
#
# Commands:
#   c          carry on until it stops or hits a breakpoint
#   s [n]      take n steps (one unless you say)
#   r          show the registers and flags
#   x <addr> [n]  show n bytes of the program's memory (hex)
#   b <addr>   set a breakpoint
#   bl         list the breakpoints
#   bc <n>     clear breakpoint n
#   o          show the program's output so far
#   w          why it stopped
#   h          this help
#   q          leave
#
# Addresses are hexadecimal, no 0x needed.
#
use arg
use file
use num
use string
use sys
use x86

DB_MAXBP: 16

# breakpoints live in a little row of addresses
db_bp: 0
db_bpn: 0

# the arguments, read from the kernel's own copy. The compiler has
# a bug where a big program's start-up stub can be corrupted, which
# makes the usual arg_count and arg_at come back empty; reading
# /proc/self/cmdline works whatever the stub looks like.
db_argc: 0
db_argv: 0

db_args:
    d: _sov_alloc(8192)
    fd: sys_open("/proc/self/cmdline", 0)
    if fd < 0
        return 0
    n: sys_read(fd, d, 8192)
    sys_close(fd)
    if n < 1
        return 0
    # a row of pointers, one per argument, each ending in a nought
    db_argv: _sov_alloc(65536)
    cnt: 0
    i: 0
    as long as i < n
        poke_i64(db_argv, cnt * 8, d + i)
        cnt: cnt + 1
        done: 0
        as long as done is 0
            if i >= n
                done: 1
            if not
                if peek_byte(d, i) is 0
                    done: 1
                if not
                    i: i + 1
        i: i + 1
    db_argc: cnt
    return 0

# one line from the keyboard, with the newline taken off. nought
# means the input ran out.
db_line:
    buf: _sov_alloc(512)
    n: 0
    more: 1
    as long as more is 1
        b: _sov_alloc(1)
        got: sys_read(0, b, 1)
        if got is 0
            more: 0
        if not
            v: peek_byte(b, 0)
            if v is 10
                more: 0
            if not
                if v is 13
                    more: 0
                if not
                    poke_byte(buf, n, v)
                    n: n + 1
    poke_byte(buf, n, 0)
    return buf

# a number as sixteen hex digits
db_hex v:
    o: _sov_alloc(20)
    i: 15
    as long as i >= 0
        d: (v / db_pow(i)) % 16
        if d < 10
            poke_byte(o, 15 - i, 48 + d)
        if not
            poke_byte(o, 15 - i, 87 + d)
        i: i - 1
    poke_byte(o, 16, 0)
    return o

db_pow i:
    r: 1
    k: 0
    as long as k < i
        r: r * 16
        k: k + 1
    return r

# one byte as two hex digits
db_hex2 b:
    o: _sov_alloc(4)
    d: b / 16
    if d < 10
        poke_byte(o, 0, 48 + d)
    if not
        poke_byte(o, 0, 87 + d)
    d: b % 16
    if d < 10
        poke_byte(o, 1, 48 + d)
    if not
        poke_byte(o, 1, 87 + d)
    poke_byte(o, 2, 0)
    return o

# hex digits from a line into a number
db_num s:
    n: str_len(s)
    v: 0
    i: 0
    as long as i < n
        c: str_at(s, i)
        d: 0
        if c >= 48
            if c <= 57
                d: c - 48
        if not
            if c >= 97
                if c <= 102
                    d: c - 87
        v: v * 16 + d
        i: i + 1
    return v

# the registers, in the order the machine numbers them
db_regs m:
    write_out("rax ")
    write_out(db_hex(peek_i64(m, 0)))
    write_out("  rcx ")
    write_out(db_hex(peek_i64(m, 8)))
    write_out("  rdx ")
    write_out(db_hex(peek_i64(m, 16)))
    write_out("\n")
    write_out("rbx ")
    write_out(db_hex(peek_i64(m, 24)))
    write_out("  rsp ")
    write_out(db_hex(peek_i64(m, 32)))
    write_out("  rbp ")
    write_out(db_hex(peek_i64(m, 40)))
    write_out("\n")
    write_out("rsi ")
    write_out(db_hex(peek_i64(m, 48)))
    write_out("  rdi ")
    write_out(db_hex(peek_i64(m, 56)))
    write_out("  rip ")
    write_out(db_hex(peek_i64(m, 128)))
    write_out("\n")
    write_out("r8  ")
    write_out(db_hex(peek_i64(m, 64)))
    write_out("  r9  ")
    write_out(db_hex(peek_i64(m, 72)))
    write_out("  r10 ")
    write_out(db_hex(peek_i64(m, 80)))
    write_out("\n")
    write_out("r11 ")
    write_out(db_hex(peek_i64(m, 88)))
    write_out("  r12 ")
    write_out(db_hex(peek_i64(m, 96)))
    write_out("  r13 ")
    write_out(db_hex(peek_i64(m, 104)))
    write_out("\n")
    write_out("r14 ")
    write_out(db_hex(peek_i64(m, 112)))
    write_out("  r15 ")
    write_out(db_hex(peek_i64(m, 120)))
    write_out("\n")
    write_out("flags z")
    write_out(num_text(peek_i64(m, 136)))
    write_out(" s")
    write_out(num_text(peek_i64(m, 144)))
    write_out(" c")
    write_out(num_text(peek_i64(m, 152)))
    write_out(" o")
    write_out(num_text(peek_i64(m, 160)))
    write_out("\n")
    return 0

# a breakpoint in the row, if there is room
db_bp_add m a:
    if db_bpn >= DB_MAXBP
        write_out("too many breakpoints\n")
        return 0
    poke_i64(db_bp, db_bpn * 8, a)
    db_bpn: db_bpn + 1
    write_out("break at ")
    write_out(db_hex(a))
    write_out("\n")
    return 0

# is this address a breakpoint?
db_bp_hit m a:
    i: 0
    as long as i < db_bpn
        if peek_i64(db_bp, i * 8) is a
            return 1
        i: i + 1
    return 0

# one instruction, with the stop flag cleared first
db_step m:
    poke_i64(m, 168, 0)
    x86_run_for(m, 1)
    return 0

# really stopped? the step-limit sets "ran too long" after every
# single step, which is the loop's doing, not the program's
db_stopped m:
    w: x86_why(m)
    if w is 0
        return 0
    if w is 3
        return 0
    return 1

# carry on until a breakpoint or the end
db_go m:
    if db_bpn is 0
        poke_i64(m, 168, 0)
        x86_run(m)
        write_out(x86_reason(m))
        write_out("\n")
        if x86_why(m) is 1
            write_out(x86_out(m))
        return 0
    more: 1
    as long as more is 1
        if db_bp_hit(m, peek_i64(m, 128)) is 1
            write_out("break at ")
            write_out(db_hex(peek_i64(m, 128)))
            write_out("\n")
            more: 0
        if not
            db_step(m)
            if db_stopped(m) is 1
                write_out(x86_reason(m))
                write_out("\n")
                if x86_why(m) is 1
                    write_out(x86_out(m))
                more: 0
    return 0

# show memory: n bytes, sixteen to a row
db_mem m a n:
    i: 0
    as long as i < n
        if i % 16 is 0
            if i is not 0
                write_out("\n")
            write_out(db_hex(a + i))
            write_out("  ")
        b: x_r8(m, a + i)
        write_out(db_hex2(b))
        write_out(" ")
        i: i + 1
    write_out("\n")
    return 0

# the x command: an address and a length, both hexadecimal
db_x m line:
    i: 2
    a: 0
    more2: 1
    as long as more2 is 1
        if i >= str_len(line)
            more2: 0
        if not
            c: str_at(line, i)
            if c is 32
                more2: 0
            if not
                d: 0
                if c >= 48
                    if c <= 57
                        d: c - 48
                if not
                    if c >= 97
                        if c <= 102
                            d: c - 87
                a: a * 16 + d
                i: i + 1
    as long as i < str_len(line)
        if str_at(line, i) is 32
            i: i + 1
        if not
            i: str_len(line)
    n: 64
    if i < str_len(line)
        n: db_num(str_cut(line, i, str_len(line)))
    poke_i64(m, 168, 0)
    db_mem(m, a, n)
    return 0

# the s command: a number of steps
db_s m line:
    n: 1
    if str_len(line) > 2
        n: db_num(str_cut(line, 2, str_len(line)))
    i: 0
    as long as i < n
        db_step(m)
        if db_stopped(m) is 1
            i: n
        i: i + 1
    write_out("rip ")
    write_out(db_hex(peek_i64(m, 128)))
    if db_stopped(m) is 1
        write_out("  ")
        write_out(x86_reason(m))
    write_out("\n")
    return 0

# the bl command: list the breakpoints
db_bl:
    i: 0
    as long as i < db_bpn
        write_out(num_text(i))
        write_out("  ")
        write_out(db_hex(peek_i64(db_bp, i * 8)))
        write_out("\n")
        i: i + 1
    if db_bpn is 0
        write_out("none\n")
    return 0

db_help:
    write_out("c  continue      s [n]  step      r  registers\n")
    write_out("x <addr> [n]  memory        b <addr>  breakpoint\n")
    write_out("bl  list breaks      bc <n>  clear      o  output\n")
    write_out("w  why      h  help      q  quit\n")
    return 0

# one command line, done
db_cmd m line:
    if str_eq(line, "h") is 1
        db_help()
    if not
        if str_eq(line, "help") is 1
            db_help()
        if not
            if str_eq(line, "c") is 1
                db_go(m)
            if not
                if str_eq(line, "r") is 1
                    db_regs(m)
                if not
                    if str_eq(line, "w") is 1
                        write_out(x86_reason(m))
                        write_out("\n")
                    if not
                        if str_eq(line, "o") is 1
                            write_out(x86_out(m))
                        if not
                            if str_starts(line, "s") is 1
                                db_s(m, line)
                            if not
                                if str_starts(line, "x ") is 1
                                    db_x(m, line)
                                if not
                                    if str_starts(line, "b ") is 1
                                        db_bp_add(m, db_num(str_cut(line, 2, str_len(line))))
                                    if not
                                        if str_eq(line, "bl") is 1
                                            db_bl()
                                        if not
                                            if str_starts(line, "bc ") is 1
                                                k: db_num(str_cut(line, 3, str_len(line)))
                                                if k < db_bpn
                                                    poke_i64(db_bp, k * 8, 0)
                                                    write_out("cleared\n")
                                                if not
                                                    write_out("no such breakpoint\n")
                                            if not
                                                write_out("? try h\n")
    return 0

main:
    db_args()
    if db_argc < 2
        write_out("use: debug <program> [arguments]\n")
        sys_exit(1)
    m: x86_new()
    r: x86_load(m, peek_i64(db_argv, 8))
    if r is 0
        write_out("cannot load ")
        write_out(peek_i64(db_argv, 8))
        write_out("\n")
        sys_exit(1)
    # the whole command line, for programs that read their args
    cmd: peek_i64(db_argv, 8)
    i: 2
    as long as i < db_argc
        cmd: str_cat(cmd, " ")
        cmd: str_cat(cmd, peek_i64(db_argv, i * 8))
        i: i + 1
    x_set_cmdline(m, cmd)
    db_bp: _sov_alloc(DB_MAXBP * 8)
    write_out("loaded ")
    write_out(peek_i64(db_argv, 8))
    write_out(", rip ")
    write_out(db_hex(peek_i64(m, 128)))
    write_out("\n")
    more: 1
    as long as more is 1
        write_out("dbg> ")
        line: db_line()
        if str_eq(line, "q") is 1
            more: 0
        if not
            if str_eq(line, "quit") is 1
                more: 0
            if not
                db_cmd(m, line)
    write_out("bye\n")
