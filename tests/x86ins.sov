t_badop:
    m: new_at()
    # a byte that means nothing
    put(m, 0, 6)
    go(m, 1)
    return is_eq("an unknown instruction stops it", x86_why(m), 2)

t_oob:
    m: new_at()
    x_setr(m, 3, 0)
    # mov rax, [rbx] with rbx nowhere near the block
    put(m, 0, 72)
    put(m, 1, 139)
    put(m, 2, 3)
    go(m, 3)
    return is_eq("reaching outside memory stops it", x86_why(m), 6)

t_divzero:
    m: new_at()
    x_setr(m, 0, 1)
    x_setr(m, 2, 0)
    x_setr(m, 3, 0)
    put(m, 0, 72)
    put(m, 1, 247)
    put(m, 2, 243)
    go(m, 3)
    return is_eq("dividing by nothing stops it", x86_why(m), 5)

