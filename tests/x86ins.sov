# the whole of AES-128, from the FIPS-197 example: the key is
# 000102030405060708090a0b0c0d0e0f and the plaintext is
# 00112233445566778899aabbccddeeff, and the answer everyone knows is
# 69c4e0d86a7b0430d8cdb78070b4c55a. The round keys come from
# aeskeygenassist and the rounds from aesenc, so this checks that the
# pieces fit together exactly the way the standard says.
t_aes_fips197:
    m: new_at()
    x_xset(m, 1, 506097522914230528, 1084818905618843912)
    x_xset(m, 5, 8603657889541918976, 0 - 4822678189205112)
    # store key[0], then expand the ten round keys
    x_w64(m, X_AT + 4096, x_xlo(m, 1))
    x_w64(m, X_AT + 4104, x_xhi(m, 1))
    round: 1
    as long as round < 11
        rcon: 1
        i9: 0
        as long as i9 < round - 1
            rcon: x_gf_mul(rcon, 2)
            i9: i9 + 1
        poke_i64(m, 360, 1)
        poke_i64(m, 376, 1)
        x_aeskeygenassist(m, 0, 2, rcon)
        w0: x_and(x_xlo(m, 1), 4294967295)
        w1: x_shr64(x_xlo(m, 1), 32)
        w2: x_and(x_xhi(m, 1), 4294967295)
        w3: x_shr64(x_xhi(m, 1), 32)
        t3: x_shr64(x_xhi(m, 2), 32)
        n0: x_xor(w0, t3)
        n1: x_xor(w1, n0)
        n2: x_xor(w2, n1)
        n3: x_xor(w3, n2)
        x_xset(m, 1, x_or(n0, x_shl64(n1, 32)), x_or(n2, x_shl64(n3, 32)))
        x_w64(m, X_AT + 4096 + round * 16, x_xlo(m, 1))
        x_w64(m, X_AT + 4104 + round * 16, x_xhi(m, 1))
        round: round + 1
    # the eleven rounds of encryption
    k0lo: x_r64(m, X_AT + 4096)
    k0hi: x_r64(m, X_AT + 4104)
    s0: x_xlo(m, 5)
    s1: x_xhi(m, 5)
    x_xset(m, 5, x_xor(s0, k0lo), x_xor(s1, k0hi))
    round: 1
    as long as round < 10
        klo: x_r64(m, X_AT + 4096 + round * 16)
        khi: x_r64(m, X_AT + 4104 + round * 16)
        x_xset(m, 6, klo, khi)
        poke_i64(m, 360, 1)
        poke_i64(m, 376, 6)
        x_aesenc(m, 0, 5)
        round: round + 1
    klo: x_r64(m, X_AT + 4096 + 160)
    khi: x_r64(m, X_AT + 4104 + 160)
    x_xset(m, 6, klo, khi)
    poke_i64(m, 360, 1)
    poke_i64(m, 376, 6)
    x_aesenclast(m, 0, 5)
    if x_xlo(m, 5) is not 3460026112562742377
        return bad("aes fips197 ct lo", x_xlo(m, 5), 3460026112562742377)
    if x_xhi(m, 5) is not 6540832429114379736
        return bad("aes fips197 ct hi", x_xhi(m, 5), 6540832429114379736)
    # and back again: the equivalent inverse cipher
    klo: x_r64(m, X_AT + 4096 + 160)
    khi: x_r64(m, X_AT + 4104 + 160)
    s0: x_xlo(m, 5)
    s1: x_xhi(m, 5)
    x_xset(m, 5, x_xor(s0, klo), x_xor(s1, khi))
    round: 9
    as long as round >= 1
        klo: x_r64(m, X_AT + 4096 + round * 16)
        khi: x_r64(m, X_AT + 4104 + round * 16)
        x_xset(m, 6, klo, khi)
        poke_i64(m, 360, 1)
        poke_i64(m, 376, 6)
        x_aesimc(m, 0, 6)
        poke_i64(m, 360, 1)
        poke_i64(m, 376, 6)
        x_aesdec(m, 0, 5)
        round: round - 1
    klo: x_r64(m, X_AT + 4096)
    khi: x_r64(m, X_AT + 4104)
    x_xset(m, 6, klo, khi)
    poke_i64(m, 360, 1)
    poke_i64(m, 376, 6)
    x_aesdeclast(m, 0, 5)
    if x_xlo(m, 5) is not 8603657889541918976
        return bad("aes roundtrip pt lo", x_xlo(m, 5), 8603657889541918976)
