        imm: x_s8(m, q)
        x_rset(m, x_md_reg(m), sz, a * imm)
        poke_i64(m, 160, 0)
        poke_i64(m, 152, 0)
        x_set_rip(m, q + 1)
        return 1
    if b is 192 -> return x_shift_ins(m, p, rex, 1, 0)
    if b is 193 -> return x_shift_ins(m, p, rex, sz, 0)
    if b is 208 -> return x_shift_ins(m, p, rex, 1, 1)
    if b is 209 -> return x_shift_ins(m, p, rex, sz, 1)
    if b is 210 -> return x_shift_ins(m, p, rex, 1, 2)
    if b is 211 -> return x_shift_ins(m, p, rex, sz, 2)
    if b is 246 -> return x_grp3(m, p, rex, 1)
    if b is 247 -> return x_grp3(m, p, rex, sz)
    if b is 254 -> return x_grp5(m, p, rex, 1)
    if b is 255 -> return x_grp5(m, p, rex, sz)
    if b >= 112
        if b <= 127
            d: x_s8(m, p)
            if x_cond(m, b - 112) is 1
                x_set_rip(m, p + 1 + d)
                return 1
            x_set_rip(m, p + 1)
            return 1
    if b is 227
        d: x_s8(m, p)
        if x_reg(m, 1) is 0
            x_set_rip(m, p + 1 + d)
            return 1
        x_set_rip(m, p + 1)
        return 1
    if b is 232
        d: x_s32(m, p)
        x_push(m, p + 4)
        x_set_rip(m, p + 4 + d)
        return 1
    if b is 233
        d: x_s32(m, p)
        x_set_rip(m, p + 4 + d)
        return 1
    if b is 235
        d: x_s8(m, p)
        x_set_rip(m, p + 1 + d)
        return 1
    if b is 15 -> return x_step_0f(m, p, rex, sz)
    poke_i64(m, 168, 2)
    poke_i64(m, 232, p - 1)
    return 0

x_shift_ins m p rex wsz mode:
    q: 0
    cnt: 1
    nq: 0
    if mode is 0
        q: x_modrm(m, p, rex, 1)
        cnt: band(x_r8(m, q), 63)
        nq: q + 1
    if mode is 1
        q: x_modrm(m, p, rex, 0)
        cnt: 1
        nq: q
    if mode is 2
        q: x_modrm(m, p, rex, 0)
        cnt: band(x_reg(m, 1), 63)
        nq: q
    if cnt is 0
        x_set_rip(m, nq)
        return 1
    sop: x_md_reg(m) % 8
    v: x_rm_get(m, wsz)
    r: v
    if sop is 4 -> r: bshl(v, cnt)
    if sop is 5 -> r: bshr(x_mask(v, wsz), cnt)
    if sop is 7 -> r: bsar(x_sval(v, wsz), cnt)
    if sop is 0
        bits: wsz * 8
        c: cnt % bits
        uv: x_mask(v, wsz)
        r: bor(bshl(uv, c), bshr(uv, bits - c))
    if sop is 1
        bits: wsz * 8
        c: cnt % bits
        uv: x_mask(v, wsz)
        r: bor(bshr(uv, c), bshl(uv, bits - c))
    x_rm_set(m, wsz, r)
    x_set_zs(m, r, wsz)
    x_set_rip(m, nq)
    return 1

x_grp3 m p rex wsz:
    subop: (x_r8(m, p) / 8) % 8
    if subop < 2
        if wsz is 1
            q: x_modrm(m, p, rex, 1)
            x_alu(m, 4, x_rm_get(m, 1), x_r8(m, q), 1)
            x_set_rip(m, q + 1)
            return 1
        q: x_modrm(m, p, rex, 4)
        x_alu(m, 4, x_rm_get(m, wsz), x_s32(m, q), wsz)
        x_set_rip(m, q + 4)
        return 1
    q: x_modrm(m, p, rex, 0)
    v: x_rm_get(m, wsz)
    if subop is 2
        x_rm_set(m, wsz, bxor(v, 0 - 1))
        x_set_rip(m, q)
        return 1
    if subop is 3
        r: x_alu(m, 5, 0, v, wsz)
        x_rm_set(m, wsz, r)
        x_set_rip(m, q)
        return 1
    if subop is 4
        a: x_rget(m, 0, wsz)
        x_rset(m, 0, wsz, a * v)
        x_rset(m, 2, wsz, 0)
        poke_i64(m, 160, 0)
        poke_i64(m, 152, 0)
        x_set_rip(m, q)
        return 1
    if subop is 5
        a: x_sval(x_rget(m, 0, wsz), wsz)
        dv: x_sval(v, wsz)
        x_rset(m, 0, wsz, a * dv)
        x_rset(m, 2, wsz, 0)
        poke_i64(m, 160, 0)
        poke_i64(m, 152, 0)
        x_set_rip(m, q)
        return 1
    dv: x_sval(v, wsz)
    if dv is 0
        poke_i64(m, 168, 5)
        return 0
    a: x_sval(x_rget(m, 0, wsz), wsz)
    quo: a / dv
    rem: a - quo * dv
    x_rset(m, 0, wsz, quo)
    x_rset(m, 2, wsz, rem)
    x_set_rip(m, q)
    return 1

x_grp5 m p rex wsz:
    q: x_modrm(m, p, rex, 0)
    subop: x_md_reg(m) % 8
    if subop is 0
        ocf: peek_i64(m, 152)
        r: x_alu(m, 0, x_rm_get(m, wsz), 1, wsz)
        poke_i64(m, 152, ocf)
        x_rm_set(m, wsz, r)
        x_set_rip(m, q)
        return 1
    if subop is 1
        ocf: peek_i64(m, 152)
        r: x_alu(m, 5, x_rm_get(m, wsz), 1, wsz)
        poke_i64(m, 152, ocf)
        x_rm_set(m, wsz, r)
        x_set_rip(m, q)
        return 1
    if subop is 2
        tgt: x_rm_get(m, 8)
        x_push(m, q)
        x_set_rip(m, tgt)
        return 1
    if subop is 4
        tgt: x_rm_get(m, 8)
        x_set_rip(m, tgt)
        return 1
    if subop is 6
        v: x_rm_get(m, 8)
        x_push(m, v)
        x_set_rip(m, q)
        return 1
    poke_i64(m, 168, 2)
    return 0

x_step_0f m p rex sz:
    b2: x_r8(m, p)
    p: p + 1
    if b2 is 5 -> return x_syscall(m, p)
    if b2 >= 128
        if b2 <= 143
            d: x_s32(m, p)
            if x_cond(m, b2 - 128) is 1
                x_set_rip(m, p + 4 + d)
                return 1
            x_set_rip(m, p + 4)
            return 1
    if b2 >= 144
        if b2 <= 159
            q: x_modrm(m, p, rex, 0)
            x_rm_set(m, 1, x_cond(m, b2 - 144))
            x_set_rip(m, q)
            return 1
    if b2 >= 64
        if b2 <= 79
            q: x_modrm(m, p, rex, 0)
            v: x_rm_get(m, sz)
            if x_cond(m, b2 - 64) is 1 -> x_rset(m, x_md_reg(m), sz, v)
            x_set_rip(m, q)
            return 1
    if b2 is 175
        q: x_modrm(m, p, rex, 0)
        a: x_sval(x_rget(m, x_md_reg(m), sz), sz)
        bb: x_sval(x_rm_get(m, sz), sz)
        r: a * bb
        x_rset(m, x_md_reg(m), sz, r)
        poke_i64(m, 160, 0)
        poke_i64(m, 152, 0)
        x_set_rip(m, q)
        return 1
    if b2 is 182
        q: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), sz, x_rm_get(m, 1))
        x_set_rip(m, q)
        return 1
    if b2 is 183
        q: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), sz, x_rm_get(m, 2))
        x_set_rip(m, q)
        return 1
    if b2 is 190
        q: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), sz, x_sval(x_rm_get(m, 1), 1))
        x_set_rip(m, q)
        return 1
    if b2 is 177
        q: x_modrm(m, p, rex, 0)
        cur: x_rm_get(m, sz)
        acc: x_rget(m, 0, sz)
        if cur is acc
            poke_i64(m, 136, 1)
            x_rm_set(m, sz, x_rget(m, x_md_reg(m), sz))
        if not
            poke_i64(m, 136, 0)
            x_rset(m, 0, sz, cur)
        x_set_rip(m, q)
        return 1
    if b2 is 193
        q: x_modrm(m, p, rex, 0)
        a: x_rm_get(m, sz)
        bb: x_rget(m, x_md_reg(m), sz)
        x_rset(m, x_md_reg(m), sz, a)
        x_rm_set(m, sz, x_alu(m, 0, a, bb, sz))
        x_set_rip(m, q)
        return 1
    if b2 >= 200
        if b2 <= 207
            r: (b2 - 200) + band(rex, 1) * 8
            v: x_reg(m, r)
            b0: band(v, 255)
            b1: band(bshr(v, 8), 255)
            b2v: band(bshr(v, 16), 255)
            b3: band(bshr(v, 24), 255)
            b4: band(bshr(v, 32), 255)
            b5: band(bshr(v, 40), 255)
            b6: band(bshr(v, 48), 255)
            b7: band(bshr(v, 56), 255)
            sv: bor(bor(bshl(b0, 56), bshl(b1, 48)), bor(bshl(b2v, 40), bshl(b3, 32)))
            sv: bor(sv, bor(bor(bshl(b4, 24), bshl(b5, 16)), bor(bshl(b6, 8), b7)))
            x_setr(m, r, sv)
            x_set_rip(m, p)
            return 1
    poke_i64(m, 168, 2)
    poke_i64(m, 232, p - 2)
    return 0

x86_run_for m limit:
    n: 0
    going: 1
    as long as going is 1
        if n >= limit
            poke_i64(m, 168, 3)
            going: 0
        if not
            going: x_step(m)
            n: n + 1
    return peek_i64(m, 168)

x86_run m:
    return x86_run_for(m, 20000000)
