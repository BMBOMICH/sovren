    poke_i64(m, 240, X_LINUX)
    sp: lo + X_MEM - 65536
    x_perm_set(m, sp - 61440, 65536, 6)
    x_w64(m, sp, 1)
    x_set_sp(m, sp)
    poke_i64(m, 248, lo + 16777216)
    x_set_rip(m, entry)
    return 1

x_check_fault m:
    if peek_i64(m, 168) is 0 -> return 0
