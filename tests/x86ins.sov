            syscall(318, rb, 8, 0)
            rv: peek_i64(rb, 0)
            if rv < 0 -> rv: 0 - rv
            slide: ((rv % 511) + 1) * 4096
            lo: lo + slide
    poke_i64(m, 216, lo)
    poke_i64(m, 240, X_WIN)
    x_rebase(m)
    gb: peek_i64(m, 176)
    _sov_mem_copy(gb, d, 512)
    x_perm_set(m, lo, 4096, 4)
    poke_byte(gb, 512, 112)
    poke_byte(gb, 513, 0)
    i: 0
    as long as i < nsec
        so: pe + 24 + 240 + i * 40
        vsz: x_u32d(d, so + 8)
        va: x_u32d(d, so + 12)
        rsz: x_u32d(d, so + 16)
        rptr: x_u32d(d, so + 20)
        sch: x_u32d(d, so + 36)
        _sov_mem_copy(gb + va, d + rptr, rsz)
        msz: vsz
