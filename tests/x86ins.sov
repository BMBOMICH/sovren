    x_perm_set(m, sp - 61440, 65536, 6)
    x_w64(m, sp, 1)
    x_set_sp(m, sp)
    poke_i64(m, 248, base + 16777216)
    x_set_rip(m, base + entry)
    return 1

x86_load m path:
    d: file_read_all(path)
