            if go_rel is 1
                pg_rva: x_u32d(gb, rel_rva + pos)
                bsz: x_u32d(gb, rel_rva + pos + 4)
                if bsz < 8 -> go_rel: 0
                if go_rel is 1
                    ej: 0
                    ecnt: (bsz - 8) / 2
