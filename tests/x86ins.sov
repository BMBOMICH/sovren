# unsafe-module
use file
use string
use lz2

X_MEM: 100663296
X_OUT: 65536
X_LINUX: 1
X_MAC: 2
X_WIN: 3
X_STUB: 2147418112
x_gb_pool: 0

x_and a b:
    return band(a, b)
x_or a b:
    return bor(a, b)
x_xor a b:
    return bxor(a, b)
x_lo v:
    return band(v, 4294967295)
x_hiu v:
    return band(bshr(v, 32), 4294967295)
x_and32 a b:
    return band(band(a, b), 4294967295)

x_ult a b:
    if a >= 0
        if b < 0 -> return 1
        if a < b -> return 1
        return 0
    if b >= 0 -> return 0
    if a < b -> return 1
    return 0

x_mask v sz:
    if sz is 1 -> return band(v, 255)
    if sz is 2 -> return band(v, 65535)
    if sz is 4 -> return band(v, 4294967295)
    return v

x_sval v sz:
    if sz is 1
        u: band(v, 255)
        if u >= 128 -> return u - 256
        return u
    if sz is 2
        u: band(v, 65535)
        if u >= 32768 -> return u - 65536
        return u
    if sz is 4
        u: band(v, 4294967295)
        if u >= 2147483648 -> return u - 4294967296
        return u
    return v

x86_new:
    m: _sov_alloc(1024)
    if x_gb_pool is 0 -> x_gb_pool: _sov_alloc(X_MEM)
    if not
        _sov_mem_set(x_gb_pool, 0, 262144)
        _sov_mem_set(x_gb_pool + X_MEM - 131072, 0, 131072)
    gb: x_gb_pool
    pt: _sov_alloc(X_MEM / 4096)
    out: _sov_alloc(X_OUT)
    err: _sov_alloc(X_OUT)
    xv: _sov_alloc(512)
    yv: _sov_alloc(128)
    poke_i64(m, 176, gb)
    poke_i64(m, 184, X_MEM)
    poke_i64(m, 192, out)
    poke_i64(m, 296, err)
    poke_i64(m, 488, xv)
    poke_i64(m, 624, yv)
    poke_i64(m, 664, pt)
    poke_i64(m, 320, 5583457307299373056)
    return m

x_base m:
    return peek_i64(m, 176)
x_low m:
    return peek_i64(m, 216)
x_rip m:
    return peek_i64(m, 128)
x_set_rip m v:
    poke_i64(m, 128, v)
x_sp m:
    return peek_i64(m, 32)
x_set_sp m v:
    poke_i64(m, 32, v)
x_reg m r:
    return peek_i64(m, r * 8)
x_setr m r v:
    poke_i64(m, r * 8, v)
x_rebase m:
    poke_i64(m, 704, peek_i64(m, 176) - peek_i64(m, 216))
x_here m a:
    return peek_i64(m, 704) + a

x86_state_q m at:
    return peek_i64(m, at)
x86_state_w m at v:
    poke_i64(m, at, v)
x86_why m:
    return peek_i64(m, 168)
x86_code m:
    return peek_i64(m, 208)
x86_bad m:
    return peek_i64(m, 232)
x86_out m:
    return as text peek_i64(m, 192)
x86_err m:
    return as text peek_i64(m, 296)
x86_reason m:
    return as text "fault"
x86_feature_1_used m:
    return peek_i64(m, 328)

x86_perm_at m a:
    off: a - peek_i64(m, 216)
    if off < 0 -> return 0
    if off >= peek_i64(m, 184) -> return 0
    return peek_byte(peek_i64(m, 664), off / 4096)

x_perm_set m a len perm:
    if len <= 0 -> return 0
    lo: peek_i64(m, 216)
    pt: peek_i64(m, 664)
    npages: peek_i64(m, 184) / 4096
    p0: (a - lo) / 4096
    p1: (a + len - 1 - lo) / 4096
    if p0 < 0 -> p0: 0
    if p1 >= npages -> p1: npages - 1
    p: p0
    as long as p <= p1
        poke_byte(pt, p, perm)
        p: p + 1
    return 0

x86_peek_q m a:
    off: a - peek_i64(m, 216)
    if off < 0 -> return 0
    if off > peek_i64(m, 184) - 8 -> return 0
    return peek_i64(peek_i64(m, 176), off)

x_r8 m a:
    off: a - peek_i64(m, 216)
    if off < 0
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0
    if off >= peek_i64(m, 184)
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0
    return peek_byte(peek_i64(m, 176), off)

x_r16 m a:
    off: a - peek_i64(m, 216)
    if off < 0
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0
    if off > peek_i64(m, 184) - 2
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0
    return peek_raw16(peek_i64(m, 176) + off, 0)

x_r32 m a:
    off: a - peek_i64(m, 216)
    if off < 0
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0
    if off > peek_i64(m, 184) - 4
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0
    return peek_raw32(peek_i64(m, 176) + off, 0)

x_r64 m a:
    off: a - peek_i64(m, 216)
    if off < 0
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0
    if off > peek_i64(m, 184) - 8
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0
    return peek_i64(peek_i64(m, 176), off)

x_s8 m a:
    return x_sval(x_r8(m, a), 1)
x_s32 m a:
    return x_sval(x_r32(m, a), 4)

x_chk_w m a sz:
    off: a - peek_i64(m, 216)
    if off < 0
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0 - 1
    if off > peek_i64(m, 184) - sz
        poke_i64(m, 168, 6)
        poke_i64(m, 232, a)
        return 0 - 1
    pv: peek_byte(peek_i64(m, 664), off / 4096)
    if band(pv, 2) is 0
        poke_i64(m, 168, 7)
        poke_i64(m, 232, a)
        return 0 - 1
    return off

x_w8 m a v:
    off: x_chk_w(m, a, 1)
    if off < 0 -> return 0
    poke_byte(peek_i64(m, 176), off, band(v, 255))
    return 0

x_w16 m a v:
    off: x_chk_w(m, a, 2)
    if off < 0 -> return 0
    poke_raw16(peek_i64(m, 176) + off, 0, band(v, 65535))
    return 0

x_w32 m a v:
    off: x_chk_w(m, a, 4)
    if off < 0 -> return 0
    poke_raw32(peek_i64(m, 176) + off, 0, band(v, 4294967295))
    return 0

x_w64 m a v:
    off: x_chk_w(m, a, 8)
    if off < 0 -> return 0
    poke_i64(peek_i64(m, 176), off, v)
    return 0

x_rget m r sz:
    v: peek_i64(m, r * 8)
    return x_mask(v, sz)

x_rset m r sz v:
    if sz is 8
        poke_i64(m, r * 8, v)
        return 0
    if sz is 4
        poke_i64(m, r * 8, band(v, 4294967295))
        return 0
    old: peek_i64(m, r * 8)
    if sz is 2
        poke_i64(m, r * 8, bor(band(old, 0 - 65536), band(v, 65535)))
        return 0
    poke_i64(m, r * 8, bor(band(old, 0 - 256), band(v, 255)))
    return 0

x_push m v:
    sp: x_sp(m) - 8
    x_set_sp(m, sp)
    x_w64(m, sp, v)

x_pop m:
    sp: x_sp(m)
    v: x_r64(m, sp)
    x_set_sp(m, sp + 8)
    return v

x_md_reg m:
    return peek_i64(m, 384)

x_modrm m p rex imm_sz:
    md: x_r8(m, p)
    p: p + 1
    mod: md / 64
    reg: (md / 8) % 8 + band(bshr(rex, 2), 1) * 8
    rm_low: md % 8
    rm: rm_low + band(rex, 1) * 8
    poke_i64(m, 384, reg)
    if mod is 3
        poke_i64(m, 368, 1)
        poke_i64(m, 376, rm)
        return p
    poke_i64(m, 368, 0)
    addr: 0
    if rm_low is 4
        sib: x_r8(m, p)
        p: p + 1
        sc: bshl(1, sib / 64)
        ix: (sib / 8) % 8 + band(bshr(rex, 1), 1) * 8
        br_low: sib % 8
        br: br_low + band(rex, 1) * 8
        if mod is 0
            if br_low is 5
                addr: x_s32(m, p)
                p: p + 4
            if not -> addr: x_reg(m, br)
        if not -> addr: x_reg(m, br)
        if ix is not 4 -> addr: addr + x_reg(m, ix) * sc
    if not
        if mod is 0
            if rm_low is 5
                d32: x_s32(m, p)
                p: p + 4
                poke_i64(m, 376, p + imm_sz + d32)
                return p
            addr: x_reg(m, rm)
        if not -> addr: x_reg(m, rm)
    if mod is 1
        addr: addr + x_s8(m, p)
        p: p + 1
    if mod is 2
        addr: addr + x_s32(m, p)
        p: p + 4
    poke_i64(m, 376, addr)
    return p

x_rm_get m sz:
    if peek_i64(m, 368) is 1 -> return x_rget(m, peek_i64(m, 376), sz)
    a: peek_i64(m, 376)
    if sz is 1 -> return x_r8(m, a)
    if sz is 2 -> return x_r16(m, a)
    if sz is 4 -> return x_r32(m, a)
    return x_r64(m, a)

x_rm_set m sz v:
    if peek_i64(m, 368) is 1 -> return x_rset(m, peek_i64(m, 376), sz, v)
    a: peek_i64(m, 376)
    if sz is 1 -> return x_w8(m, a, v)
    if sz is 2 -> return x_w16(m, a, v)
    if sz is 4 -> return x_w32(m, a, v)
    return x_w64(m, a, v)

x_set_zs m r sz:
    mval: x_mask(r, sz)
    if mval is 0 -> poke_i64(m, 136, 1)
    if not -> poke_i64(m, 136, 0)
    sval: x_sval(r, sz)
    if sval < 0 -> poke_i64(m, 144, 1)
    if not -> poke_i64(m, 144, 0)

x_alu m op a b sz:
    ua: x_mask(a, sz)
    ub: x_mask(b, sz)
    sa: x_sval(a, sz)
    sb: x_sval(b, sz)
    if op is 0
        r: ua + ub
        x_set_zs(m, r, sz)
        cf: 0
        if sz is 8 -> cf: x_ult(r, ua)
        if not
            if x_mask(r, 8) >= bshl(1, sz * 8) -> cf: 1
        poke_i64(m, 152, cf)
        sr: x_sval(r, sz)
        ov: 0
        if (sa < 0) is (sb < 0)
            if (sr < 0) is not (sa < 0) -> ov: 1
        poke_i64(m, 160, ov)
        return x_mask(r, sz)
    if op is 5
        r: ua - ub
        x_set_zs(m, r, sz)
        cf: x_ult(ua, ub)
        poke_i64(m, 152, cf)
        sr: x_sval(r, sz)
        ov: 0
        if (sa < 0) is not (sb < 0)
            if (sr < 0) is not (sa < 0) -> ov: 1
        poke_i64(m, 160, ov)
        return x_mask(r, sz)
    if op is 7
        x_alu(m, 5, a, b, sz)
        return ua
    r: 0
    if op is 1 -> r: bor(ua, ub)
    if op is 4 -> r: band(ua, ub)
    if op is 6 -> r: bxor(ua, ub)
    x_set_zs(m, r, sz)
    poke_i64(m, 152, 0)
    poke_i64(m, 160, 0)
    return x_mask(r, sz)

x_cond m cc:
    if cc is 0 -> return peek_i64(m, 160)
    if cc is 1 -> return 1 - peek_i64(m, 160)
    if cc is 2 -> return peek_i64(m, 152)
    if cc is 3 -> return 1 - peek_i64(m, 152)
    if cc is 4 -> return peek_i64(m, 136)
    if cc is 5 -> return 1 - peek_i64(m, 136)
    if cc is 6
        if peek_i64(m, 152) is 1 -> return 1
        return peek_i64(m, 136)
    if cc is 7
        if peek_i64(m, 152) is 0
            if peek_i64(m, 136) is 0 -> return 1
        return 0
    if cc is 8 -> return peek_i64(m, 144)
    if cc is 9 -> return 1 - peek_i64(m, 144)
    if cc is 12
        if peek_i64(m, 144) is not peek_i64(m, 160) -> return 1
        return 0
    if cc is 13
        if peek_i64(m, 144) is peek_i64(m, 160) -> return 1
        return 0
    if cc is 14
        if peek_i64(m, 136) is 1 -> return 1
        if peek_i64(m, 144) is not peek_i64(m, 160) -> return 1
        return 0
    if cc is 15
        if peek_i64(m, 136) is 0
            if peek_i64(m, 144) is peek_i64(m, 160) -> return 1
        return 0
    return 0

x_say m p n:
    o: peek_i64(m, 192)
    used: peek_i64(m, 200)
    i: 0
    as long as i < n
        if used < X_OUT - 2
            poke_byte(o, used, x_r8(m, p + i))
            used: used + 1
        i: i + 1
    poke_byte(o, used, 0)
    poke_i64(m, 200, used)

x_give m sz:
    top: peek_i64(m, 248)
    if top is 0 -> top: peek_i64(m, 216) + 16777216
    nsz: sz
    if nsz < 4096 -> nsz: 4096
    if nsz % 4096 is not 0 -> nsz: nsz + 4096 - (nsz % 4096)
    if top + nsz > peek_i64(m, 216) + X_MEM - 1048576 -> return 0
    _sov_mem_set(peek_i64(m, 176) + (top - peek_i64(m, 216)), 0, nsz)
    x_perm_set(m, top, nsz, 6)
    poke_i64(m, 248, top + nsz)
    return top

x_cstr m a:
    b: _sov_alloc(512)
    i: 0
    go: 1
    as long as go is 1
        if i >= 510 -> go: 0
        if go is 1
            c: x_r8(m, a + i)
            if c is 0 -> go: 0
            if go is 1
                poke_byte(b, i, c)
                i: i + 1
    poke_byte(b, i, 0)
    return as text b

x_syscall m nx:
    os: peek_i64(m, 240)
    if os is X_WIN
        poke_i64(m, 168, 4)
        return 0
    nr: x_reg(m, 0)
    a0: x_reg(m, 7)
    a1: x_reg(m, 6)
    a2: x_reg(m, 2)
    if os is X_MAC
        if nr < 33554432
            poke_i64(m, 168, 4)
            return 0
        mnr: nr - 33554432
        if mnr is 4 -> nr: 1
        if mnr is 1 -> nr: 60
        if mnr is 3 -> nr: 0
        if mnr is 5 -> nr: 2
        if mnr is 6 -> nr: 3
        if mnr is 197 -> nr: 9
        if mnr is 74 -> nr: 10
        if mnr is 73 -> nr: 11
        if mnr is 46 -> nr: 13
        if mnr is 78 -> nr: 27
        if mnr is 186 -> nr: 28
        if mnr is 195 -> nr: 160
        if mnr is 500 -> nr: 318
        if mnr is 283 -> nr: 318
    if nr is 1
        if a0 <= 2
            x_say(m, a1, a2)
            x_setr(m, 0, a2)
            x_set_rip(m, nx)
            return 1
        r: syscall(1, a0, x_here(m, a1), a2)
        x_setr(m, 0, r)
        x_set_rip(m, nx)
        return 1
    if nr is 0
        if a0 >= 3
            r: syscall(0, a0, x_here(m, a1), a2)
            x_setr(m, 0, r)
            x_set_rip(m, nx)
            return 1
        x_setr(m, 0, 0)
        x_set_rip(m, nx)
        return 1
    if nr is 2
        pstr: x_cstr(m, a0)
        r: syscall(2, pstr, a1, a2)
        x_setr(m, 0, r)
        x_set_rip(m, nx)
        return 1
    if nr is 3
        if a0 >= 3 -> syscall(3, a0)
        x_setr(m, 0, 0)
        x_set_rip(m, nx)
        return 1
    if nr is 60
        poke_i64(m, 208, a0)
        poke_i64(m, 168, 1)
        return 0
    if nr is 231
        poke_i64(m, 208, a0)
        poke_i64(m, 168, 1)
        return 0
    if nr is 9
        x_setr(m, 0, x_give(m, a1))
        x_set_rip(m, nx)
        return 1
    if nr is 10
        pv: x86_perm_at(m, a0)
        if pv is 0
            x_setr(m, 0, 0 - 12)
            x_set_rip(m, nx)
            return 1
        x_perm_set(m, a0, a1, a2)
        x_setr(m, 0, 0)
        x_set_rip(m, nx)
        return 1
    if nr is 27
        pv: x86_perm_at(m, a0)
        if band(pv, 2) is 0
            x_setr(m, 0, 0 - 12)
            x_set_rip(m, nx)
            return 1
        x_setr(m, 0, 0)
        x_set_rip(m, nx)
        return 1
    if nr is 318
        x_w64(m, a0, 88172645463325252)
        if os is X_MAC -> x_setr(m, 0, 0)
        if not -> x_setr(m, 0, a1)
        x_set_rip(m, nx)
        return 1
    if nr is 13
        if a1 is not 0 -> poke_i64(m, 400, x_r64(m, a1))
        x_setr(m, 0, 0)
        x_set_rip(m, nx)
        return 1
    x_setr(m, 0, 0)
    x_set_rip(m, nx)
    return 1

x_win_id nm:
    if _sov_str_eq(nm, "GetStdHandle") is 1 -> return 0
    if _sov_str_eq(nm, "WriteFile") is 1 -> return 1
    if _sov_str_eq(nm, "ReadFile") is 1 -> return 2
    if _sov_str_eq(nm, "CreateFileA") is 1 -> return 3
    if _sov_str_eq(nm, "CloseHandle") is 1 -> return 4
    if _sov_str_eq(nm, "VirtualAlloc") is 1 -> return 5
    if _sov_str_eq(nm, "ExitProcess") is 1 -> return 6
    if _sov_str_eq(nm, "GetCommandLineA") is 1 -> return 7
    if _sov_str_eq(nm, "SetFilePointerEx") is 1 -> return 8
    if _sov_str_eq(nm, "GetConsoleMode") is 1 -> return 9
    if _sov_str_eq(nm, "SetConsoleMode") is 1 -> return 10
    if _sov_str_eq(nm, "LoadLibraryA") is 1 -> return 11
    if _sov_str_eq(nm, "GetProcAddress") is 1 -> return 12
    if _sov_str_eq(nm, "VirtualQuery") is 1 -> return 13
    if _sov_str_eq(nm, "CreateThread") is 1 -> return 14
    if _sov_str_eq(nm, "WaitForSingleObject") is 1 -> return 15
    if _sov_str_eq(nm, "ExitThread") is 1 -> return 16
    if _sov_str_eq(nm, "CreateProcessA") is 1 -> return 17
    if _sov_str_eq(nm, "GetExitCodeProcess") is 1 -> return 18
    if _sov_starts_with(nm, "SystemFunction036") is 1 -> return 19
    if _sov_starts_with(nm, "AddVectoredExceptionHandler") is 1 -> return 20
    return 21

x_win_api m id:
    rcx: x_reg(m, 1)
    rdx: x_reg(m, 2)
    r8: x_reg(m, 8)
    r9: x_reg(m, 9)
    sp: x_sp(m)
    if id is 0
        h: 1
        if band(rcx, 4294967295) is 4294967286 -> h: 0
        if band(rcx, 4294967295) is 4294967285 -> h: 1
        if band(rcx, 4294967295) is 4294967284 -> h: 2
        x_setr(m, 0, h)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 1
        if rcx <= 2
            x_say(m, rdx, r8)
            if r9 is not 0 -> x_w32(m, r9, r8)
            x_setr(m, 0, 1)
            x_set_rip(m, x_pop(m))
            return 1
        nw: syscall(1, rcx, x_here(m, rdx), r8)
        if r9 is not 0 -> x_w32(m, r9, nw)
        x_setr(m, 0, 1)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 2
        nr: 0
        if rcx >= 3 -> nr: syscall(0, rcx, x_here(m, rdx), r8)
        if r9 is not 0 -> x_w32(m, r9, nr)
        x_setr(m, 0, 1)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 3
        pstr: x_cstr(m, rcx)
        disp: x_r32(m, sp + 40)
        fl: 0
        if disp is 2 -> fl: 578
        fd: syscall(2, pstr, fl, 420)
        x_setr(m, 0, fd)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 4
        if rcx >= 3
            if rcx < 1000 -> syscall(3, rcx)
        x_setr(m, 0, 1)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 5
        x_setr(m, 0, x_give(m, rdx))
        x_set_rip(m, x_pop(m))
        return 1
    if id is 6
        poke_i64(m, 208, rcx)
        poke_i64(m, 168, 1)
        return 0
    if id is 7
        x_setr(m, 0, peek_i64(m, 216) + 512)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 8
        np: syscall(8, rcx, rdx, r9)
        if r8 is not 0 -> x_w64(m, r8, np)
        x_setr(m, 0, 1)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 9
        if rdx is not 0 -> x_w32(m, rdx, 7)
        x_setr(m, 0, 1)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 10
        x_setr(m, 0, 1)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 11
        x_setr(m, 0, 1)
        x_set_rip(m, x_pop(m))
        return 1
    if id is 12
        nm: x_cstr(m, rdx)
        wid: x_win_id(nm)
