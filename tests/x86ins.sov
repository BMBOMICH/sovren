x_u32d d at:
    return peek_raw32(d + at, 0)

x86_load_pe m d fszn:
    if fszn < 512 -> return 0
    pe: peek_byte(d, 60) + peek_byte(d, 61) * 256
    if pe + 264 > fszn -> return 0
    ch_flags: peek_byte(d, pe + 22)
    dll_ch: peek_byte(d, pe + 24 + 70)
    if band(ch_flags, 1) is not 0
        if band(dll_ch, 64) is not 0 -> return 0
    nsec: peek_byte(d, pe + 6) + peek_byte(d, pe + 7) * 256
    imgsz: x_u32d(d, pe + 24 + 56)
    i: 0
    as long as i < nsec
        so: pe + 24 + 240 + i * 40
        vsz: x_u32d(d, so + 8)
        va: x_u32d(d, so + 12)
        rsz: x_u32d(d, so + 16)
        rptr: x_u32d(d, so + 20)
        if rptr + rsz > fszn -> return 0
        if va + vsz > imgsz -> return 0
        if va + rsz > imgsz -> return 0
        i: i + 1
    lo: peek_i64(d, pe + 24 + 24)
    slide: 0
    rel_rva: x_u32d(d, pe + 24 + 152)
    rel_sz: x_u32d(d, pe + 24 + 156)
    if band(dll_ch, 64) is not 0
        if rel_sz > 0
