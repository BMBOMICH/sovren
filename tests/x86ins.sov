    x_set_rip(m, lo + ep)
    return 1

x86_load_macho m d fszn:
    if fszn < 32 -> return 0
    ncmds: x_u32d(d, 16)
    szcmds: x_u32d(d, 20)
    if 32 + szcmds > fszn -> return 0
    if ncmds < 2 -> return 0
    if ncmds > 64 -> return 0
    has_sig: 0
    base: 0
    entry: 0
    o: 32
    ci: 0
    as long as ci < ncmds
        if o + 8 > fszn -> return 0
        cmd: x_u32d(d, o)
        csz: x_u32d(d, o + 4)
        if csz < 8 -> return 0
        if o + csz > 32 + szcmds -> return 0
        if cmd is 29 -> has_sig: 1
        if cmd is 25
            vm: peek_i64(d, o + 24)
            vms: peek_i64(d, o + 32)
            fo: peek_i64(d, o + 40)
            fsz: peek_i64(d, o + 48)
            ip: x_u32d(d, o + 60)
            if fo + fsz > fszn -> return 0
            if vms < fsz -> return 0
            if ip is not 0
