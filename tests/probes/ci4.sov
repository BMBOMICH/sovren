# ci4 - the fused leaf8 compare through as-long-as loop edges
# (inv 1 jumps): counters in slots 5, 6, 7, 8 with distinct
# strides and stop values, print-free, folded by main.
ci4a:
    n0: 2
    n1: 4
    n2: 8
    n3: 16
    n4: 32
    n5: 0
    n6: 0
    as long as n5 < 400
        n5: n5 + 1
        n6: n6 + 7
    return n6 * 1000 + n5

ci4b:
    m0: 12
    m1: 24
    m2: 36
    m3: 48
    m4: 60
    m5: 72
    m6: 84
    m7: 300
    m8: 5
    as long as m7 > 150
        m7: m7 - 3
    as long as m8 <= -5
        m8: m8 + 1
    return m7 * 10 + m8

print ci4a()
print ci4b()
