# ph3 - the pass-61 folds with both indices at home: no rsi, no
# rdx staging anywhere - L peek and folded R sub/add address the
# registers directly. sub checked in both operand orders.
use sys

b: 0

b: _sov_alloc(640)
poke_i64(b, 8, 70)
poke_i64(b, 16, 30)
i: 1
j: 2
d: peek_i64(b, j * 8) - peek_i64(b, i * 8)
print d
s: peek_i64(b, j * 8) + peek_i64(b, i * 8)
print s
d2: peek_i64(b, i * 8) - peek_i64(b, j * 8)
print d2
