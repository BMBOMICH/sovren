# ci3 - leaf8 slots 5-8 vs 64-bit immediates: the value does not
# fit the sign-extended imm32 form, so the compare becomes
# movabs rcx + cmp r-slot, rcx. mirrored order folded in.
ci3:
    n0: 9
    n1: 19
    n2: 29
    n3: 39
    n4: 49
    n5: 2147483648
    n6: -2147483649
    n7: 9223372036854775806
    n8: -9223372036854775806
    r: 0
    if n5 > 2147483647
        r: r + 1
    if n5 is 2147483648
        r: r + 10
    if n6 < -2147483648
        r: r + 100
    if n6 is -2147483649
        r: r + 1000
    if n7 is 9223372036854775806
        r: r + 10000
    if n7 < 9223372036854775807
        r: r + 100000
    if -9223372036854775807 < n8
        r: r + 1000000
    if n8 is not -9223372036854775806
        r: r + 10000000
    return r

main:
    print ci3()
