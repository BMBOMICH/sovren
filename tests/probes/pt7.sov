# pt7 - expression position: the same poke used as a value - the
# tvd contract keeps the base-pointer return (mov_rax_rdi). lock
# mirrors pd2's shape: assigned value 71+2*6, then +1 = 84.
use sys

v: 0

main:
    v: _sov_alloc(640)
    poke_i64(v, 8, 71)
    i: 1
    a: 2
    b: 6
    q: poke_i64(v, i * 8, peek_i64(v, i * 8) + a * b)
    print peek_i64(v, 8)
    print peek_i64(v, 8) + 1
