use sys
leaf9:
    a: 1
    b: 2
    c: 3
    d: 4
    e: 5
    f: 6
    g: 7
    h: 8
    i: 9
    k: 0
    as long as k < 3
        a: a + 1
        b: b + 1
        c: c + 1
        d: d + 1
        e: e + 1
        f: f + 1
        g: g + 1
        h: h + 1
        i: i + 1
        k: k + 1
    return a + b + c + d + e + f + g + h + i
print leaf9()
