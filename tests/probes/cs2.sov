# name > scaled peek, both outcomes (gt arm)
main:
    arr: _sov_alloc(8000)
    r: 5
    poke_raw64(arr, r * 8, 0 - 12)
    v: 0 - 5
    if v > peek_raw64(arr, r * 8)
        print 201
    if not
        print 202
    v: 0 - 12
    if v > peek_raw64(arr, r * 8)
        print 203
    if not
        print 204
    v: 0 - 20
    if v > peek_raw64(arr, r * 8)
        print 205
    if not
        print 206
