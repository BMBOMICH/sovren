# sa5 - decline: e rides the leaf8-only home (local 6 of a leaf)
# and the gate takes slots 0-4 only. byte-identical binary.
use sys

g: 0

lf:
    a: peek_i64(g, 0)
    b: peek_i64(g, 8)
    c: peek_i64(g, 16)
    d: peek_i64(g, 24)
    f: peek_i64(g, 32)
    e: peek_i64(g, 40)
    s: a * a + b * b + e * e
    return s

g: _sov_alloc(64)
poke_i64(g, 0, 2)
poke_i64(g, 8, 3)
poke_i64(g, 16, 5)
poke_i64(g, 24, 7)
poke_i64(g, 32, 13)
poke_i64(g, 40, 11)
print lf()
