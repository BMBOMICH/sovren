# dp7 - allowed alias: the L index is the target; one load reads
# the old value before the home dies. the arm fires (row67 has
# the (13,13) pair).
use sys

g: 0

main:
    g: _sov_alloc(640)
    poke_i64(g, 16, 83)
    poke_i64(g, 8, 29)
    i: 1
    j: 2
    j: peek_i64(g, j * 8) - peek_i64(g, i * 8)
    print j
    print j + 2
