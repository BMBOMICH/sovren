# sa3 - decline: atom c lives past the slots (frame local 6);
# the old rcx-accumulator arm runs, binary byte-identical.
# 4+64+100 = 168, +1+3+6+11 = 189.
use sys

g: 0

main:
    g: _sov_alloc(128)
    poke_i64(g, 0, 2)
    poke_i64(g, 8, 8)
    poke_i64(g, 16, 10)
    poke_i64(g, 24, 11)
    a: peek_i64(g, 0)
    b: peek_i64(g, 8)
    u: 1
    v: 3
    w: 6
    c: peek_i64(g, 16)
    s: a * a + b * b + c * c
    print s + u + v + w + peek_i64(g, 24)
