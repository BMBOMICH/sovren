# gd1 - the folded R index as a pure GLOBAL: scaled_rdx's loadv_rdx
# takes the direct rip load (pass 64), both fold ops.
use sys

b: 0
gi: 1

b: _sov_alloc(640)
poke_i64(b, 8, 11)
poke_i64(b, 16, 22)
j: 2
d: peek_i64(b, j * 8) - peek_i64(b, gi * 8)
print d
s: peek_i64(b, j * 8) + peek_i64(b, gi * 8)
print s
