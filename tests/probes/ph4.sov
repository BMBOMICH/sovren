# ph4 - (i + k) * 8 indices: peek_home declines (not a plain atom),
# the scaled_rsi fallback builds the same bytes as the previous
# compiler - the whole binary must stay byte-identical.
use sys

b: 0

main:
    b: _sov_alloc(640)
    poke_i64(b, 16, 77)
    i: 1
    d: peek_i64(b, (i + 1) * 8)
    print d
    poke_i64(b, (i + 1) * 8, 88)
    print peek_i64(b, (i + 1) * 8)
    print d + 11
