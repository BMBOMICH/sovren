# dp1 - def-fusion: "v: peek_i64(g, x * 8) - peek_i64(g, y * 8)"
# lands straight in v's slot home, sub keeps operand order. d is
# pre-assigned (the hot-temporary idiom) and fires; e and f are
# first assignments (local does not exist yet) and take pass 61.
use sys

g: 0

g: _sov_alloc(640)
poke_i64(g, 8, 41)
poke_i64(g, 16, 73)
poke_i64(g, 24, 17)
a: 1
b: 2
c: 3
d: 0
d: peek_i64(g, b * 8) - peek_i64(g, a * 8)
print d
e: peek_i64(g, c * 8) - peek_i64(g, b * 8)
print e
f: peek_i64(g, a * 8) - peek_i64(g, c * 8)
print f
