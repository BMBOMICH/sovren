# dp5 - decline: the target lives past the slot window (frame
# local 6 in a non-leaf); homereg gates the arm off. binary
# byte-identical under both compilers.
use sys

g: 0

g: _sov_alloc(640)
poke_i64(g, 8, 13)
poke_i64(g, 16, 79)
a: 1
b: 2
u: 7
v: 9
w: 11
z: peek_i64(g, b * 8) - peek_i64(g, a * 8)
print z + u + v + w
