include inc/px00.sov 2760 6 (kpci kpci)
main:
    nodes: _sov_alloc(KPCI_NODE_STRIDE * 8)
    if kpci_nodes_init(nodes, 8) != 1 -> bad('init')
    if kpci_node_set(nodes, 8, 0, 16, 0 - 1, 0) != 1 -> bad('root endpoint')
    if kpci_node_set(nodes, 8, 1, 24, 0 - 1, KPCI_NODE_BRIDGE) != 1 -> bad('root bridge')
    if kpci_node_set(nodes, 8, 2, 264, 1, 0) != 1 -> bad('first child')
    if kpci_node_set(nodes, 8, 3, 265, 1, 0) != 1 -> bad('second child')
    if kpci_group_key(nodes, 8, 0) != 16 -> bad('root key')
    if kpci_group_key(nodes, 8, 2) != 24 -> bad('non-ACS bridge key')
    if kpci_same_group(nodes, 8, 2, 3) != 1 -> bad('non-ACS descendants split')
    if kpci_node_set(nodes, 8, 4, 32, 0 - 1, KPCI_NODE_BRIDGE + KPCI_NODE_ACS) != 1 -> bad('ACS bridge')
    if kpci_node_set(nodes, 8, 5, 520, 4, 0) != 1 -> bad('ACS child')
    if kpci_node_set(nodes, 8, 6, 40, 4, KPCI_NODE_BRIDGE) != 1 -> bad('downstream switch')
    if kpci_node_set(nodes, 8, 7, 776, 6, 0) != 1 -> bad('nested child')
    if kpci_group_key(nodes, 8, 5) != 520 -> bad('ACS endpoint key')
    if kpci_group_key(nodes, 8, 7) != 40 -> bad('nested non-ACS key')
    if kpci_same_group(nodes, 8, 5, 7) != 0 -> bad('ACS groups merged')
    scope: _sov_alloc(160) ;; poke_raw64(scope, 0, 1)
    scope + 8: poke_raw64 i * 16, 0: 0 2 ;; scope + 32: poke_raw8 i, 0: 24 8
    if kpci_scope_resolve(nodes, 8, scope) != 2 -> bad('endpoint scope resolution')
    if kpci_scope_matches(nodes, 8, scope, 264) != 1 -> bad('endpoint scope match')
    if kpci_scope_matches(nodes, 8, scope, 265) != 0 -> bad('endpoint scope overmatch')
    poke_raw64(scope, 0, 2) ;; poke_raw64(scope + 24, 0, 1)
    if kpci_scope_matches(nodes, 8, scope, 265) != 1 -> bad('subhierarchy scope match')
    poke_raw64(scope, 0, 3)
    if kpci_scope_matches(nodes, 8, scope, 265) != 0 - 2 -> bad('non-PCI scope accepted')
    poke_raw64(scope, 0, 1) ;; poke_raw64(scope + 24, 0, 2)
    poke_raw8(scope + 33, 0, 255)
    if kpci_scope_resolve(nodes, 8, scope) != 0 - 1 -> bad('missing scope path accepted')
    if kpci_node_set(nodes, 8, 7, 900, 0 - 1, 0) != 0 -> bad('duplicate slot accepted')
    malformed: _sov_alloc(KPCI_NODE_STRIDE * 2)
    if kpci_nodes_init(malformed, 2) != 1 -> bad('malformed init')
    if kpci_node_set(malformed, 2, 1, 9, 1, 0) != 0 -> bad('forward parent accepted')
    if kpci_node_set(malformed, 2, 0, 9, 0 - 1, 0) != 1 -> bad('malformed root')
    if kpci_node_set(malformed, 2, 1, 9, 0 - 1, 0) != 0 -> bad('duplicate requester accepted')
    print 'kpci OK'
