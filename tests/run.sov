    r: cr_build('tests/hello.sov', out, '--riscv32')
    if r != 0 -> cr_bad('could not build the riscv32 test binary')
        return 0
    d: file_read_all(out)
    ok: 0
    if ap_le32(d, 0) = 1179403647 -> ok: 1
        if ap_le32(d, 16) != 15925250 -> ok: 0
    if ok = 1 -> cr_ok('target--riscv32')
    if not -> cr_bad('target--riscv32')
    return 0
