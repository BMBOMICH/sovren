# ---- a window program must not hang when the screen goes away ----
ck_win_hang:
    xvfb: cr_which("Xvfb")
    if xvfb is 0
        return 0
    d: 84
    disp: ""
    as long as d < 87
        sock: str_cat("/tmp/.X11-unix/X", num_text(d))
        lock: str_cat("/tmp/.X", num_text(d))
        lock: str_cat(lock, "-lock")
        if file_exists(sock) is 0
            if file_exists(lock) is 0
                args: _sov_alloc(40)
                poke_i64(args, 0, xvfb)
                p1: str_cat(":", num_text(d))
                poke_i64(args, 8, p1)
                poke_i64(args, 16, "-screen")
                poke_i64(args, 24, "0 320x240x24")
                poke_i64(args, 32, "-nolisten")
                poke_i64(args, 40, "tcp")
                poke_i64(args, 48, 0)
                cr_mode: 0
                cr_tout: 0
                cr_go(xvfb, args, 0)
                xvfbpid: cr_lastpid
                k: 0
                as long as k < 8
                    if file_exists(sock) is 1
                        disp: str_cat(":", num_text(d))
                        k: 8
                    if not
                        k: k + 1
                        ts: _sov_alloc(16)
                        poke_i64(ts, 0, 0)
                        poke_i64(ts, 8, 100000000)
                        sys_nanosleep(ts)
                if str_len(disp) > 0
                    d: 87
        d: d + 1
    if str_len(disp) is 0
        return 0
    src: cr_line("", "use win")
    src: cr_line(src, "use time")
    src: cr_line(src, "main:")
    src: cr_line(src, "    w: win_open(200, 150, \"hangcheck\")")
    src: cr_line(src, "    if w is 0")
    src: cr_line(src, "        print \"nodisplay\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    i: 0")
    src: cr_line(src, "    as long as i < 300")
    src: cr_line(src, "        win_fill(w, 0, 0, 200, 150, WIN_RED)")
    src: cr_line(src, "        win_flush(w)")
    src: cr_line(src, "        if win_alive(w) is 0")
    src: cr_line(src, "            print \"noticed\"")
    src: cr_line(src, "            stop")
    src: cr_line(src, "        sleep_ms(100)")
    src: cr_line(src, "        i: i + 1")
    src: cr_line(src, "    print \"ranout\"")
    file_write_all("/tmp/sov-hang.sov", src)
    r: cr_build("/tmp/sov-hang.sov", "/tmp/sov-hang", "")
    if r is not 0
        cr_bad("could not build the hang check")
        return 0
    envp: cr_disp_env(disp)
    a: _sov_alloc(16)
    poke_i64(a, 0, "/tmp/sov-hang")
    poke_i64(a, 8, 0)
    cr_run("/tmp/sov-hang", a, envp, 25)
    proc_kill(xvfbpid)
    if str_has(cr_out, "noticed") is 1
        cr_ok("window-notices-a-dead-screen")
    if not
        cr_bad("window-notices-a-dead-screen")
    return 0

# ---- reaching the rest of Windows ----
ck_win_imports:
    py: cr_which("python3")
    if py is 0
        return 0
    cr_build("tests/hello.sov", "/tmp/sov-imp.exe", "--windows")
    s: "import struct\n"
    s: str_cat(s, "d = open('/tmp/sov-imp.exe','rb').read()\n")
    s: str_cat(s, "pe = struct.unpack_from('<I', d, 0x3c)[0]\n")
    s: str_cat(s, "imp = struct.unpack_from('<I', d, pe+24+112+8)[0]\n")
    s: str_cat(s, "so = pe+24+240\n")
    s: str_cat(s, "vs, va, rs, ra = struct.unpack_from('<IIII', d, so+8)\n")
    s: str_cat(s, "def rd(rva, n): return d[ra+(rva-va):ra+(rva-va)+n]\n")
    s: str_cat(s, "ilt, ts, fc, nm, iat = struct.unpack_from('<IIIII', rd(imp, 20), 0)\n")
    s: str_cat(s, "names = []\n")
    s: str_cat(s, "j = 0\n")
    s: str_cat(s, "while True:\n")
    s: str_cat(s, "    v = struct.unpack_from('<Q', rd(iat+j*8, 8))[0]\n")
    s: str_cat(s, "    if v == 0: break\n")
    s: str_cat(s, "    names.append(rd(v+2, 24).split(b'\\0')[0].decode())\n")
    s: str_cat(s, "    j += 1\n")
    s: str_cat(s, "print(' '.join(names))\n")
    file_write_all("/tmp/sov-imp.py", s)
    args: _sov_alloc(16)
    poke_i64(args, 0, py)
    poke_i64(args, 8, "/tmp/sov-imp.py")
    poke_i64(args, 16, 0)
    cr_run(py, args, 0, 60)
    if str_has(cr_out, "LoadLibraryA") is 1
        if str_has(cr_out, "GetProcAddress") is 1
            cr_ok("windows-can-reach-other-libraries")
        if not
            cr_bad("windows-can-reach-other-libraries")
    if not
        cr_bad("windows-can-reach-other-libraries")
    return 0

# the window library must build for Windows and say honestly that
