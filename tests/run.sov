ck_arm64e:
    out: '/tmp/sov-arm64e'
    r: cr_build('tests/hello.sov', out, '--arm64e')
    if r != 0 -> cr_bad('could not build the arm64e test binary')
        return 0
    d: file_read_all(out)
    oke: 0
    if ap_le32(d, 0) = 4277009103 -> oke: 1
        if ap_le32(d, 4) != 16777228 -> oke: 0
        if ap_le32(d, 8) != 2 -> oke: 0
    if oke = 1 -> cr_ok('target--arm64e')
    if not -> cr_bad('target--arm64e')
    return 0
