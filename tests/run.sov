    poke_byte(exp, 2, 51)
    poke_byte(exp, 3, 59)
    poke_byte(exp, 4, 53)
    poke_byte(exp, 5, 72)
    poke_byte(exp, 6, 0)
    if cr_eqs(cr_trim(cr_out), exp) is 1
        cr_ok("tui-goto")
    if not
        cr_bad("tui-goto")
# every other example must stop on its own with nothing to read
ck_examples:
    i: 0
    names: _sov_alloc(64)
    poke_i64(names, 0, "tests/hello.sov")
    poke_i64(names, 8, 0)
    as long as i < 1
        ex: peek_i64(names, i * 8)
        r: cr_build(ex, "/tmp/sov-ex", "")
        if r is 0
            a: _sov_alloc(16)
            poke_i64(a, 0, "/tmp/sov-ex")
            poke_i64(a, 8, 0)
            cr_run_dev("/tmp/sov-ex", a, 0, 25)
            if cr_rc is 0
                cr_ok(ex)
            if not
                cr_bad(ex)
        i: i + 1
    return 0

