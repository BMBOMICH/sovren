# tests/run.sov — the whole check battery, written in Sovren.
#
# Build every check
# program, run the two emulators, run a real C program on one of
# them, draw on a screen when there is one, and report. It is all
# Sovren now. What still runs underneath is only the same tools
# any check must use: gcc to build a C program, python3 to read a
# PE import table, Xvfb to make a screen where there is none.
#
#   ./sovren tests/run.sov -o /tmp/sov-run && /tmp/sov-run
#
# Each check prints ok, FAIL or skip and the run ends with a
# summary and a useful exit code.
#
use arg
use file
use num
use proc
use string
use sys
use aes
use gcm
use tls
use json
use x25519

# ---- how it reports ----
cr_pass: 0
cr_fail: 0
cr_skipn: 0

cr_ok name:
    write_out("ok ")
    write_out(name)
    write_out("\n")
    cr_pass: cr_pass + 1
    return 0

cr_bad name:
    write_out("FAIL ")
    write_out(name)
    write_out("\n")
    cr_fail: cr_fail + 1
    return 0

cr_skip name:
    write_out("skip ")
    write_out(name)
    write_out("\n")
    cr_skipn: cr_skipn + 1
    return 0

# is this tool around? looked up by a few likely homes
cr_which name:
    p: str_cat("/usr/bin/", name)
    if file_exists(p) is 1
        return p
    p: str_cat("/usr/local/bin/", name)
    if file_exists(p) is 1
        return p
    p: str_cat("/bin/", name)
    if file_exists(p) is 1
        return p
    return 0

# ---- running one thing, with stdin, output and a timeout ----
# The caller sets cr_mode (0 inherit, 1 feed, 2 devnull), cr_data
# (the bytes to feed) and cr_tout (seconds before the watchdog
# kills it). The output lands in cr_out and the exit code in cr_rc;
# 124 means the watchdog caught it.

cr_mode: 0
cr_data: ""
cr_tout: 120
cr_out: ""
cr_rc: 0

# the low thirty-two bits of a pipe, which carries the two file
# numbers side by side
cr_pr fds:
    return peek_i64(fds, 0) % 4294967296

cr_pw fds:
    return peek_i64(fds, 0) / 4294967296

cr_go path args envp:
    if file_exists("/tmp/cr-timeout") is 1
        file_delete("/tmp/cr-timeout")
    cr_out: ""
    opf: _sov_alloc(16)
    sys_pipe(opf)
    ipf: 0
    if cr_mode is 1
        ipf: _sov_alloc(16)
        sys_pipe(ipf)
    pid: proc_fork()
    if pid is 0
        sys_dup2(cr_pw(opf), 1)
        sys_close(cr_pr(opf))
        if cr_mode is 1
            sys_dup2(cr_pr(ipf), 0)
            sys_close(cr_pw(ipf))
        if not
            if cr_mode is 2
                nf: sys_open("/dev/null", 0)
                sys_dup2(nf, 0)
                sys_close(nf)
        sys_exec(path, args, envp)
        sys_exit(127)
    sys_close(cr_pw(opf))
    wr: 0
    if cr_mode is 1
        sys_close(cr_pr(ipf))
        wr: proc_fork()
        if wr is 0
            n: str_len(cr_data)
            sys_write(cr_pw(ipf), cr_data, n)
            sys_close(cr_pw(ipf))
            sys_exit(0)
        sys_close(cr_pw(ipf))
    if cr_tout is 0
        # a server: it is meant to keep running, so take its pid and
        # do not wait for it or read what it writes
        sys_close(cr_pr(opf))
        cr_rc: 0
        cr_lastpid: pid
        return 0
    wd: 0
    if cr_tout > 0
        wd: proc_fork()
        if wd is 0
            # wake once a second: when the child is gone, leave at
            # once; when the time is up, mark it and kill it
            i: 0
            as long as i < cr_tout
                ts: _sov_alloc(16)
                poke_i64(ts, 0, 1)
                poke_i64(ts, 8, 0)
                sys_nanosleep(ts)
                if sys_kill(pid, 0) is not 0
                    sys_exit(0)
                i: i + 1
            file_write_all("/tmp/cr-timeout", "1")
            proc_kill9(pid)
            sys_exit(0)
    out: ""
    buf: _sov_alloc(8192)
    more: 1
    as long as more is 1
        n: sys_read(cr_pr(opf), buf, 8192)
        if n <= 0
            more: 0
        if not
            poke_byte(buf, n, 0)
            t: as text buf
            out: str_cat(out, t)
    sys_close(cr_pr(opf))
    # wait4 wants a place to put the status; sys_wait passes none
    # and comes back with the pid instead
    stp: _sov_alloc(8)
    syscall(61, pid, stp, 0, 0, 0, 0)
    st: peek_i64(stp, 0)
    if wr is not 0
        syscall(61, wr, stp, 0, 0, 0, 0)
    if wd is not 0
        syscall(61, wd, stp, 0, 0, 0, 0)
    code: (st / 256) % 256
    if st % 256 is not 0
        code: 128 + st % 256
    if file_exists("/tmp/cr-timeout") is 1
        code: 124
        file_delete("/tmp/cr-timeout")
    cr_rc: code
    cr_out: out
    cr_lastpid: pid
    return code

# a plain run: inherit stdin, capture stdout
cr_run path args envp tout:
    cr_mode: 0
    cr_tout: tout
    return cr_go(path, args, envp)

# run with a fixed string fed to stdin
cr_run_in path args envp data tout:
    cr_mode: 1
    cr_data: data
    cr_tout: tout
    return cr_go(path, args, envp)

# run with nothing to read
cr_run_dev path args envp tout:
    cr_mode: 2
    cr_tout: tout
    return cr_go(path, args, envp)

# build one source with the launcher
cr_build src out flag:
    args: _sov_alloc(64)
    poke_i64(args, 0, "./sovren")
    poke_i64(args, 8, src)
    poke_i64(args, 16, "-o")
    poke_i64(args, 24, out)
    if str_len(flag) > 0
        poke_i64(args, 32, flag)
        poke_i64(args, 40, 0)
    if not
        poke_i64(args, 32, 0)
    cr_run("./sovren", args, 0, 120)
    return cr_rc

# run a built program
cr_bin path tout:
    args: _sov_alloc(16)
    poke_i64(args, 0, path)
    poke_i64(args, 8, 0)
    cr_run(path, args, 0, tout)
    return cr_rc

# one line of a program: source plus a newline
cr_line src s:
    return str_cat(str_cat(src, s), "\n")

# two files the same, byte for byte
cr_same a b:
    if file_size(a) is not file_size(b)
        return 0
    n: file_size(a)
    d1: file_read_all(a)
    d2: file_read_all(b)
    i: 0
    as long as i < n
        if peek_byte(d1, i) is not peek_byte(d2, i)
            return 0
        i: i + 1
    return 1

# every byte except newlines, for the outputs that end one per line
cr_flat s:
    n: str_len(s)
    o: _sov_alloc(n + 1)
    j: 0
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 10
            i: i + 1
        if not
            if c is 13
                i: i + 1
            if not
                poke_byte(o, j, c)
                j: j + 1
                i: i + 1
    poke_byte(o, j, 0)
    return o

# two strings the same, byte for byte
cr_eqs a b:
    if str_len(a) is not str_len(b)
        return 0
    n: str_len(a)
    i: 0
    as long as i < n
        if peek_byte(a, i) is not peek_byte(b, i)
            return 0
        i: i + 1
    return 1

# a string with a trailing newline taken off
cr_trim s:
    n: str_len(s)
    if n > 0
        if peek_byte(s, n - 1) is 10
            return str_cut(s, 0, n - 1)
    return s

# ---------------------------------------------------------------
# the checks
# ---------------------------------------------------------------

# ---- the Sovren suite ----
ck_all:
    r: cr_build("tests/all.sov", "/tmp/sov-all", "")
    if r is 0
        cr_bin("/tmp/sov-all", 300)
        if cr_rc is 0
            cr_ok("the Sovren suite")
        if not
            cr_bad("the Sovren suite")
    if not
        cr_bad("could not build tests/all.sov")
    return 0

# ---- the arm emulator, against the C one ----
ck_arm_emu:
    r: cr_build("tests/arm64/run.sov", "/tmp/sov-armrun", "")
    if r is not 0
        cr_bad("could not build tests/arm64/run.sov")
        return 0
    src: cr_line("", "main:")
    src: cr_line(src, "    print 5 * 3 / 2")
    file_write_all("/tmp/sov-ea.sov", src)
    cr_build("/tmp/sov-ea.sov", "/tmp/sov-arm.bin", "--android")
    cr_bin("/tmp/sov-armrun", 300)
    g: cr_trim(cr_out)
    if str_eq(g, "7") is 1
        cr_ok("arm-emulator-in-sovren")
    if not
        cr_bad("arm-emulator-in-sovren")
    src: cr_line("", "use sha256")
    src: cr_line(src, "main:")
    src: cr_line(src, "    print sha256_hex(\"abc\")")
    file_write_all("/tmp/sov-ea2.sov", src)
    cr_build("/tmp/sov-ea2.sov", "/tmp/sov-arm.bin", "--android")
    cr_bin("/tmp/sov-armrun", 300)
    g: cr_trim(cr_out)
    if str_eq(g, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") is 1
        cr_ok("arm-emulator-sha256")
    if not
        cr_bad("arm-emulator-sha256")
    return 0

# ---- AArch64 encodings and the back end ----
ck_arm64:
    r: cr_build("tests/arm64/verify.sov", "/tmp/sov-verify", "")
    if r is 0
        cr_bin("/tmp/sov-verify", 120)
        if str_has(cr_out, "every encoding is right") is 1
            cr_ok("arm64-encodings")
        if not
            cr_bad("arm64-encodings")
    if not
        cr_bad("could not build tests/arm64/verify.sov")
    r: cr_build("tests/arm64/test.sov", "/tmp/sov-armtest", "")
    if r is 0
        cr_bin("/tmp/sov-armtest", 120)
        if str_has(cr_out, "the ARM back end is right") is 1
            cr_ok("arm64-codegen")
        if not
            cr_bad("arm64-codegen")
    if not
        cr_bad("could not build tests/arm64/test.sov")
    src: cr_line("", "main:")
    src: cr_line(src, "    print 5 * 3 / 2")
    file_write_all("/tmp/sov-so.sov", src)
    cr_build("/tmp/sov-so.sov", "/tmp/sov-so.so", "--android-so")
    r: cr_build("tests/arm64/runso.sov", "/tmp/sov-runso", "")
    if r is 0
        cr_bin("/tmp/sov-runso", 300)
        g: cr_flat(cr_out)
        if str_eq(g, "77") is 1
            cr_ok("so-exports")
        if not
            cr_bad("so-exports")
    if not
        cr_bad("could not build tests/arm64/runso.sov")
    return 0

# ---- the iOS signature needs a second, independent sha256 ----
ck_ios:
    r: cr_build("tests/hello.sov", "/tmp/sov-ios.bin", "--ios")
    if r is not 0
        cr_bad("could not build the ios test binary")
        return 0
    r: cr_build("tests/arm64/check_sig.sov", "/tmp/sov-csig", "")
    if r is not 0
        cr_bad("could not build tests/arm64/check_sig.sov")
        return 0
    a: _sov_alloc(24)
    poke_i64(a, 0, "/tmp/sov-csig")
    poke_i64(a, 8, "/tmp/sov-ios.bin")
    poke_i64(a, 16, 0)
    cr_run("/tmp/sov-csig", a, 0, 60)
    if cr_rc is 0
        cr_ok("ios-code-signature")
    if not
        cr_bad("ios-code-signature")
    return 0

# ---- the x86 emulator, instruction by instruction ----
ck_x86ins:
    r: cr_build("tests/x86ins.sov", "/tmp/sov-x86ins", "")
    if r is 0
        cr_bin("/tmp/sov-x86ins", 120)
        if str_has(cr_out, "every instruction is right") is 1
            cr_ok("x86-instructions")
        if not
            cr_bad("x86-instructions")
    if not
        cr_bad("could not build tests/x86ins.sov")
    return 0

# ---- a real C program, built by gcc, run on the emulator ----
ck_cprog:
    gcc: cr_which("gcc")
    if gcc is 0
        cr_skip("a real C program (no gcc)")
        return 0
    c: "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n"
    c: str_cat(c, "static int cmp(const void *a, const void *b) { return *(int*)a - *(int*)b; }\n")
    c: str_cat(c, "int main(void) {\n")
    c: str_cat(c, "    int *a = malloc(sizeof(int) * 50);\n")
    c: str_cat(c, "    for (int i = 0; i < 50; i++) a[i] = (i * 7919) % 1000;\n")
    c: str_cat(c, "    qsort(a, 50, sizeof(int), cmp);\n")
    c: str_cat(c, "    printf(\"%d %d\\n\", a[0], a[49]);\n")
    c: str_cat(c, "    char *s = malloc(256);\n")
    c: str_cat(c, "    snprintf(s, 256, \"%s|%d|%x\", \"fmt\", 42, 255);\n")
    c: str_cat(c, "    printf(\"%s %zu\\n\", s, strlen(s));\n")
    c: str_cat(c, "    long long b = 1;\n")
    c: str_cat(c, "    for (int i = 0; i < 20; i++) b *= 3;\n")
    c: str_cat(c, "    printf(\"%lld\\n\", b);\n")
    c: str_cat(c, "    free(a); free(s);\n")
    c: str_cat(c, "    return 0;\n}\n")
    file_write_all("/tmp/sov-cprog.c", c)
    args: _sov_alloc(40)
    poke_i64(args, 0, gcc)
    poke_i64(args, 8, "-static")
    poke_i64(args, 16, "-O2")
    poke_i64(args, 24, "-o")
    poke_i64(args, 32, "/tmp/sov-cprog")
    poke_i64(args, 40, "/tmp/sov-cprog.c")
    poke_i64(args, 48, 0)
    cr_run(gcc, args, 0, 120)
    if cr_rc is not 0
        cr_skip("a real C program (gcc cannot build static)")
        return 0
    ck_emu_driver()
    cr_bin("/tmp/sov-cprog", 60)
    nat: cr_out
    args: _sov_alloc(16)
    poke_i64(args, 0, "/tmp/sov-runc")
    poke_i64(args, 8, "/tmp/sov-cprog")
    poke_i64(args, 16, 0)
    cr_run("/tmp/sov-runc", args, 0, 300)
    if str_eq(nat, cr_out) is 1
        cr_ok("x86-runs-a-real-c-program")
    if not
        cr_bad("x86-runs-a-real-c-program")
    return 0

# the tiny emulator driver, built once
ck_emu_driver:
    src: cr_line("", "use x86")
    src: cr_line(src, "use arg")
    src: cr_line(src, "main:")
    src: cr_line(src, "    m: x86_new()")
    src: cr_line(src, "    if x86_load(m, arg_at(1)) is 0")
    src: cr_line(src, "        print \"cannot load\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    x86_run(m)")
    src: cr_line(src, "    write_out(x86_out(m))")
    src: cr_line(src, "    write_err(x86_reason(m))")
    file_write_all("/tmp/sov-runc.sov", src)
    cr_build("/tmp/sov-runc.sov", "/tmp/sov-runc", "")
    return 0

# ---- a C program that uses decimals ----
ck_fp:
    gcc: cr_which("gcc")
    if gcc is 0
        cr_skip("decimals in C (no gcc)")
        return 0
    c: "#include <stdio.h>\nint main(void) {\n"
    c: str_cat(c, "    double v[] = {1.0, 2.5, -3.75, 0.1, 1e10, 1e-10, 123456.789};\n")
    c: str_cat(c, "    double s = 0, p = 1;\n")
    c: str_cat(c, "    for (int i = 0; i < 7; i++) { s += v[i]; p *= v[i]; }\n")
    c: str_cat(c, "    printf(\"sum=%.10f\\nprod=%.10e\\n\", s, p);\n")
    c: str_cat(c, "    for (int i = 0; i < 5; i++) printf(\"%d:%.4f \", i, (double)i / 7.0);\n")
    c: str_cat(c, "    printf(\"\\n\");\n")
    c: str_cat(c, "    printf(\"big=%.3e small=%.3e\\n\", 1e300 * 1e5, 1e-300 / 1e5);\n")
    c: str_cat(c, "    printf(\"cast=%d %d %lld\\n\", (int)3.99, (int)-3.99, (long long)1e15);\n")
    c: str_cat(c, "    printf(\"cmp %d %d %d\\n\", 1.5 < 2.5, 1.5 == 1.5, 3.0 > 4.0);\n")
    c: str_cat(c, "    double a = 0.1, b = 0.2;\n")
    c: str_cat(c, "    printf(\"tenths=%.17g exact=%d\\n\", a + b, (a + b) == 0.3);\n")
    c: str_cat(c, "    return 0;\n}\n")
    file_write_all("/tmp/sov-fp.c", c)
    args: _sov_alloc(40)
    poke_i64(args, 0, gcc)
    poke_i64(args, 8, "-static")
    poke_i64(args, 16, "-O2")
    poke_i64(args, 24, "-o")
    poke_i64(args, 32, "/tmp/sov-fp")
    poke_i64(args, 40, "/tmp/sov-fp.c")
    poke_i64(args, 48, 0)
    cr_run(gcc, args, 0, 120)
    if cr_rc is not 0
        cr_skip("decimals in C (gcc cannot build static)")
        return 0
    cr_bin("/tmp/sov-fp", 60)
    nat: cr_out
    args: _sov_alloc(16)
    poke_i64(args, 0, "/tmp/sov-runc")
    poke_i64(args, 8, "/tmp/sov-fp")
    poke_i64(args, 16, 0)
    cr_run("/tmp/sov-runc", args, 0, 300)
    if str_eq(nat, cr_out) is 1
        cr_ok("x86-decimals-match-the-real-thing")
    if not
        cr_bad("x86-decimals-match-the-real-thing")
    return 0

# ---- the window libraries, on a made screen when there is one ----
ck_windows_gui:
    xvfb: cr_which("Xvfb")
    if xvfb is 0
        cr_skip("the window libraries (no screen to draw on)")
        return 0
    d: 77
    disp: ""
    as long as d < 82
        lock: str_cat("/tmp/.X", num_text(d))
        lock: str_cat(lock, "-lock")
        sock: str_cat("/tmp/.X11-unix/X", num_text(d))
        if file_exists(lock) is 0
            if file_exists(sock) is 0
                args: _sov_alloc(40)
                poke_i64(args, 0, xvfb)
                p1: str_cat(":", num_text(d))
                poke_i64(args, 8, p1)
                poke_i64(args, 16, "-screen")
                poke_i64(args, 24, "0 640x480x24")
                poke_i64(args, 32, "-nolisten")
                poke_i64(args, 40, "tcp")
                poke_i64(args, 48, 0)
                cr_mode: 0
                cr_tout: 0
                cr_go(xvfb, args, 0)
                xvfbpid: cr_lastpid
                k: 0
                as long as k < 8
                    if file_exists(sock) is 1
                        disp: str_cat(":", num_text(d))
                        k: 8
                    if not
                        k: k + 1
                        ts: _sov_alloc(16)
                        poke_i64(ts, 0, 0)
                        poke_i64(ts, 8, 100000000)
                        sys_nanosleep(ts)
                if str_len(disp) > 0
                    d: 82
        d: d + 1
    if str_len(disp) is 0
        cr_skip("the window libraries (no screen to draw on)")
        return 0
    envp: cr_disp_env(disp)
    ck_win_draw(envp, disp)
    ck_win_game(envp, disp)
    ck_win_ui(envp, disp)
    proc_kill(xvfbpid)
    return 0

# the environment a window program wants
cr_disp_env disp:
    e: _sov_alloc(64)
    p1: str_cat("DISPLAY=", disp)
    poke_i64(e, 0, p1)
    poke_i64(e, 8, "PATH=/usr/bin:/bin")
    poke_i64(e, 16, "HOME=/tmp")
    poke_i64(e, 24, 0)
    return e

# one window program: opens, draws, finishes
ck_win_draw envp disp:
    src: cr_line("", "use win")
    src: cr_line(src, "use time")
    src: cr_line(src, "main:")
    src: cr_line(src, "    w: win_open(320, 240, \"sovrencheck\")")
    src: cr_line(src, "    if w is 0")
    src: cr_line(src, "        print \"nodisplay\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    i: 0")
    src: cr_line(src, "    as long as i < 30")
    src: cr_line(src, "        win_fill(w, 0, 0, 320, 240, WIN_WHITE)")
    src: cr_line(src, "        win_fill(w, 20, 20, 80, 60, WIN_RED)")
    src: cr_line(src, "        win_box(w, 140, 20, 90, 60, WIN_BLUE)")
    src: cr_line(src, "        win_line(w, 10, 200, 300, 160, WIN_GREEN)")
    src: cr_line(src, "        win_text(w, 20, 120, \"sovren\", WIN_BLACK)")
    src: cr_line(src, "        win_flush(w)")
    src: cr_line(src, "        sleep_ms(100)")
    src: cr_line(src, "        i: i + 1")
    src: cr_line(src, "    print \"drew\"")
    file_write_all("/tmp/sov-win.sov", src)
    r: cr_build("/tmp/sov-win.sov", "/tmp/sov-win", "")
    if r is not 0
        cr_bad("could not build the window check")
        return 0
    cr_run("/tmp/sov-win", args1(), envp, 60)
    if str_has(cr_out, "drew") is 1
        cr_ok("window-finishes")
    if not
        cr_bad("window-finishes")
    cr_ok("window-opens")
    imp: cr_which("import")
    if imp is 0
        cr_skip("looking at the screen (no import)")
        return 0
    a2: _sov_alloc(40)
    poke_i64(a2, 0, imp)
    poke_i64(a2, 8, "-window")
    poke_i64(a2, 16, "root")
    poke_i64(a2, 24, "/tmp/sov-w.bmp")
    poke_i64(a2, 32, 0)
    cr_run(imp, a2, envp, 60)
    if file_exists("/tmp/sov-w.bmp") is 0
        cr_bad("capturing the screen")
        return 0
    b: file_read_all("/tmp/sov-w.bmp")
    got: 1
    if cr_bmp_has(b, 255, 0, 0) is 0
        got: 0
    if cr_bmp_has(b, 0, 0, 255) is 0
        got: 0
    if cr_bmp_has(b, 0, 255, 0) is 0
        got: 0
    if got is 1
        cr_ok("the red, blue and green reached the screen")
    if not
        cr_bad("the red, blue and green reached the screen")
    return 0

args1:
    a: _sov_alloc(16)
    poke_i64(a, 0, "/tmp/sov-win")
    poke_i64(a, 8, 0)
    return a

# the game loop must keep proper time
ck_win_game envp disp:
    src: cr_line("", "use game")
    src: cr_line(src, "use num")
    src: cr_line(src, "use time")
    src: cr_line(src, "main:")
    src: cr_line(src, "    g: game_new(200, 150, \"g\")")
    src: cr_line(src, "    if g is 0")
    src: cr_line(src, "        print \"nodisplay\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    game_speed(g, 50)")
    src: cr_line(src, "    t0: time_ms()")
    src: cr_line(src, "    n: 0")
    src: cr_line(src, "    as long as n < 50")
    src: cr_line(src, "        game_step(g)")
    src: cr_line(src, "        game_clear(g, WIN_BLACK)")
    src: cr_line(src, "        game_rect(g, n, 40, 10, 10, WIN_RED)")
    src: cr_line(src, "        game_show(g)")
    src: cr_line(src, "        n: n + 1")
    src: cr_line(src, "    el: time_ms() - t0")
    src: cr_line(src, "    if el > 800")
    src: cr_line(src, "        if el < 1400")
    src: cr_line(src, "            print \"paced\"")
    file_write_all("/tmp/sov-game.sov", src)
    r: cr_build("/tmp/sov-game.sov", "/tmp/sov-game", "")
    if r is not 0
        cr_bad("could not build the game check")
        return 0
    a: _sov_alloc(16)
    poke_i64(a, 0, "/tmp/sov-game")
    poke_i64(a, 8, 0)
    cr_run("/tmp/sov-game", a, envp, 40)
    if str_has(cr_out, "paced") is 1
        cr_ok("game-loop-keeps-time")
    if not
        cr_bad("game-loop-keeps-time")
    return 0

# the widgets: a form with a button and a box to type in
