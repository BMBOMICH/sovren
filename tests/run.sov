        return 0
    cr_build('tests/hello.sov', '/tmp/sov-hn.exe', '--windows')
    if cr_same('/tmp/hello-emu.exe', '/tmp/sov-hn.exe') = 1 -> cr_ok('windows compiler in the emulator, byte for byte')
    if not -> cr_bad('windows compiler in the emulator, byte for byte')
    include inc/px00.sov 1311 5 (16 wrun hello emu exe wrun 120)
    if str_has(cr_out, 'Hello from Sovren') = 1 -> cr_ok('the exe built inside the emulator runs')
    if not -> cr_bad('the exe built inside the emulator runs')
cr_le16 p i:
    return peek_byte(p, i) + peek_byte(p, i + 1) * 256
cr_le32 p i:
    return peek_byte(p, i) + peek_byte(p, i + 1) * 256 + peek_byte(p, i + 2) * 65536 + peek_byte(p, i + 3) * 16777216
cr_bmp_has b r g bl:
    if b = 0 -> return 0 ;; po: cr_le32(b, 10)
    w: cr_le32(b, 18) ;; h: cr_le32(b, 22)
    bpp: cr_le16(b, 28) ;; if bpp != 24 -> if bpp != 32
            return 0
    bypp: bpp / 8 ;; rowsz: w * bypp
    as long as rowsz % 4 != 0 -> rowsz: rowsz + 1 ;; up: 1
    if h < 0 -> h: 0 - h
        up: 0
    y: 0 ;; as long as y < h -> x: 0
        as long as x < w -> yy: y
            if up = 1 -> yy: h - 1 - y ;; o: po + yy * rowsz + x * bypp
            if peek_byte(b, o + 2) = r -> if peek_byte(b, o + 1) = g
                    if peek_byte(b, o) = bl -> return 1
            x: x + 1
        y: y + 1
cr_hex buf s:
    n: str_len(s)
    include inc/inc02.sov 1481 3
    as long as i < n -> hi: cr_nib(peek_byte(s, i))
        include inc/px01.sov 276 4 (cr_nib buf j j 1 i i 2)
    return j
cr_nib c:
    if c >= 48 -> if c <= 57
            return c - 48
    if c >= 97 -> return c - 87 ;; if c >= 65 -> return c - 55
cr_byteeq a b n:
    include inc/px00.sov 320 4 (n a b)
    return 1
ck_crypto:
    _sov_alloc(16):
        include inc/px00.sov 6 4 (kb pb cb xb)
    cr_hex(kb, '000102030405060708090a0b0c0d0e0f')
    cr_hex(pb, '00112233445566778899aabbccddeeff')
    rk: _sov_alloc(176) ;; ae_expand(kb, rk)
    ae_enc_block(rk, pb, cb)
    cr_hex(xb, '69c4e0d86a7b0430d8cdb78070b4c55a')
    if cr_byteeq(cb, xb, 16) = 1 -> cr_ok('aes-128 matches the NIST vector')
    if not -> cr_bad('aes-128 matches the NIST vector')
    ae_dec_block(rk, cb, xb)
    if cr_byteeq(xb, pb, 16) = 1 -> cr_ok('aes-128 decrypts its own ciphertext')
    if not -> cr_bad('aes-128 decrypts its own ciphertext')
    gk: _sov_alloc(16)
    include inc/px01.sov 1396 4 (giv _sov_alloc 12 ga _sov_alloc 20 _sov_alloc 16 gp)
        gc ;; gx
    cr_hex(gk, '000102030405060708090a0b0c0d0e0f')
    cr_hex(giv, '000102030405060708090a0b')
    cr_hex(ga, 'feedfacedeadbeeffeedfacedeadbeefabaddad2')
    cr_hex(gp, 'd9313225f88406e5a55909c5aff5269a')
    gm_enc(gk, giv, ga, 20, gp, 16, gc)
    cr_hex(gx, '4a5d95eb9e9ff1b1ee8b684f99565692')
    if cr_byteeq(gc, gx, 16) = 1 -> cr_ok('gcm ciphertext matches the vector')
    if not -> cr_bad('gcm ciphertext matches the vector')
    cr_hex(gx, 'a66c4727f9c541175b33b673b0d32c7b')
    if cr_byteeq(gm_tag, gx, 16) = 1 -> cr_ok('gcm tag matches the vector')
    if not -> cr_bad('gcm tag matches the vector')
    ps: _sov_alloc(48) ;; pd: _sov_alloc(64)
    include inc/px00.sov 663 5 (po 32 48 ps 171 i 0)
    as long as i < 64 -> poke_byte(pd, i, 205)
        i: i + 1
    tl_n: 12
    tl_prf(po, ps, 48, 'PRF testvector', 14, pd, 64)
    cr_hex(gx, '670b6682a396647c92e554f0')
    if cr_byteeq(po, gx, 12) = 1 -> cr_ok('the PRF matches the RFC 5246 vector')
    if not -> cr_bad('the PRF matches the RFC 5246 vector')
    rb: _sov_alloc(64)
    cr_hex(kb, '0104070a0d101316191c1f2225282b2e')
    cr_hex(xb, '070b0d11')
    cr_hex(pb, '02070c11161b20252a2f34393e43484d')
    tl_seq_c: 1 ;; tl_rec_enc(rb, 23, pb, 16, kb, xb)
    rl: tl_clen
    cr_hex(cb, '1703030028000000000000000131be80774d7b3752af457288f889b2fadabe1291cc4c4315febd60a65a832050')
    if rl = 45 -> if cr_byteeq(rb, cb, 45) = 1
            cr_ok('the record layer matches the vector')
        if not -> cr_bad('the record layer matches the vector')
    if not -> cr_bad('the record layer matches the vector')
    js: "{\"a\":1,\"b\":[10,20,{\"c\":\"x\"}],\"d\":\"hi\"}"
    v: json_at_num(js, 'a')
    if v = 1 -> cr_ok('json numbers by path')
    if not -> cr_bad('json numbers by path')
    v: json_len(js, 'b')
    if v = 3 -> cr_ok('json array lengths by path')
    if not -> cr_bad('json array lengths by path')
    s: json_at(js, 'b[2].c')
    if str_eq(s, 'x') = 1 -> cr_ok('json deep paths')
    if not -> cr_bad('json deep paths')
    _sov_alloc(32):
        xa ;; xb
        xo
    cr_hex(xa, 'a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4')
    cr_hex(xb, 'e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c')
    x19(xo, xa, xb)
    cr_hex(xb, 'c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552')
    if cr_byteeq(xo, xb, 32) = 1 -> cr_ok('x25519 matches the RFC vector')
    if not -> cr_bad('x25519 matches the RFC vector')
    cr_hex(xa, '77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a')
    cr_hex(xb, '5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb')
    i: 0 ;; as long as i < 32 -> poke_byte(xo, i, 0)
        i: i + 1
    poke_byte(xo, 0, 9) ;; x19(xo, xa, xo)
    cr_hex(xb, '8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a')
    if cr_byteeq(xo, xb, 32) = 1 -> cr_ok('x25519 key agreement matches the RFC')
    if not -> cr_bad('x25519 key agreement matches the RFC')
ck_load p:
    fd: sys_open(p, 0)
    if fd < 0 -> return 0
    buf: _sov_alloc(65536)
    n: syscall(0, fd, buf, 65535, 0, 0, 0)
    sys_close(fd)
    return wasm_load(buf, n)

ck_one nm fn a b c d want:
    p: str_cat(str_cat('tests/wasm/', nm), '.wasm')
    h: ck_load(p)
    if h = 0 -> return 1
    r: wasm_call(h, fn, a, b, c, d)
    if r != want -> return 1
    if wasm_trap(h) != 0 -> return 1
    return 0

ck_wasm:
    bad: 0
    bad: bad + ck_one('add', 'add', 2, 3, 0, 0, 5)
    bad: bad + ck_one('add', 'add', 0 - 2, 3, 0, 0, 1)
    bad: bad + ck_one('fib', 'fib', 10, 0, 0, 0, 55)
    bad: bad + ck_one('fib', 'fib', 20, 0, 0, 0, 6765)
    bad: bad + ck_one('ctrl', 'sum10', 0, 0, 0, 0, 55)
    bad: bad + ck_one('ctrl', 'mx', 7, 9, 0, 0, 9)
    bad: bad + ck_one('ctrl', 'sel', 1, 2, 5, 0, 1)
    bad: bad + ck_one('ctrl', 'dvs', 0 - 7, 2, 0, 0, 0 - 3)
    bad: bad + ck_one('ops', 'divu', 0 - 1, 16, 0, 0, 268435455)
    bad: bad + ck_one('ops', 'remu', 0 - 1, 4096, 0, 0, 4095)
    bad: bad + ck_one('ops', 'extu', 0 - 5, 0, 0, 0, 4294967291)
    bad: bad + ck_one('ops', 'tee', 21, 0, 0, 0, 42)
    bad: bad + ck_one('ops', 'drop1', 9, 8, 0, 0, 8)
    bad: bad + ck_one('mem', 'st', 287454020, 0, 0, 0, 287454020)
    bad: bad + ck_one('mem', 'st8', 300, 0, 0, 0, 44)
    bad: bad + ck_one('mem', 'ld16', 0, 0, 0, 0, 4660)
    bad: bad + ck_one('mem', 'grw', 2, 0, 0, 0, 1)
    bad: bad + ck_one('mem', 'grw', 0 - 1, 0, 0, 0, 0 - 1)
    if bad = 0 -> cr_ok('wasm interpreter battery')
    if not -> cr_bad('wasm interpreter battery')
    return 0

ck_wasi:
    h: ck_load('tests/wasm/hello.wasm')
    if h = 0 -> cr_bad('wasi fd_write round')
        return 0
    dummy: wasm_call(h, '_start', 0, 0, 0, 0)
    if wasm_trap(h) = 1 -> if wasm_exit_code(h) = 7 -> cr_ok('wasi fd_write round')
    if not -> cr_bad('wasi fd_write round')
    file_write_all('/tmp/sov-wasi-src.sov', "main:\n    print ''\n    return 7\n")
    r: cr_build('/tmp/sov-wasi-src.sov', '/tmp/sov-wasi-gen.wasm', '--wasi')
    if r != 0 -> cr_bad('wasi compiler target')
        return 0
    h2: ck_load('/tmp/sov-wasi-gen.wasm')
    if h2 = 0 -> cr_bad('wasi compiler target')
        return 0
    dummy: wasm_call(h2, '_start', 0, 0, 0, 0)
    if wasm_trap(h2) = 1 -> if wasm_exit_code(h2) = 7 -> cr_ok('wasi compiler target')
    if not -> cr_bad('wasi compiler target')
    file_write_all('/tmp/sov-wasi-subset.sov', "main:\n    x: 10 ;; y: 20\n    z: x + y ;; print z\n    if z > 15 -> print ''\n    if not -> print ''\n    print '' 2 times\n")
    r: cr_build('/tmp/sov-wasi-subset.sov', '/tmp/sov-wasi-subset.wasm', '--wasi')
    if r != 0 -> cr_bad('wasi compiler subset')
        return 0
    h3: ck_load('/tmp/sov-wasi-subset.wasm')
    if h3 = 0 -> cr_bad('wasi compiler subset')
        return 0
    dummy: wasm_call(h3, '_start', 0, 0, 0, 0)
    if wasm_trap(h3) = 0 -> cr_ok('wasi compiler subset')
    if not -> cr_bad('wasi compiler subset')
    file_write_all('/tmp/sov-wasi-loop.sov', "main:\n    x: 0\n    as long as x < 3 -> x: x + 1\n    return x\n")
    r: cr_build('/tmp/sov-wasi-loop.sov', '/tmp/sov-wasi-loop.wasm', '--wasi')
    if r != 0 -> cr_bad('wasi compiler loop')
        return 0
    h4: ck_load('/tmp/sov-wasi-loop.wasm')
    if h4 = 0 -> cr_bad('wasi compiler loop')
        return 0
    dummy: wasm_call(h4, '_start', 0, 0, 0, 0)
    if wasm_trap(h4) = 1 -> if wasm_exit_code(h4) = 3 -> cr_ok('wasi compiler loop')
    if not -> cr_bad('wasi compiler loop')
    return 0

cr_atoi s:
    v: 0 ;; n: str_len(s)
    i: 0 ;; as long as i < n -> v: v * 10 + peek_byte(s, i) - 48
        i: i + 1
    return v
main:
    sh: 0 ;; ns: 1
    ac: arg_count() ;; if ac > 1 -> sh: cr_atoi(as text arg_at(1))
    if ac > 2 -> ns: cr_atoi(as text arg_at(2)) ;; ci: 0
    include inc/px00.sov 107 6 (ck_all ck_arm_emu)
    include inc/px00.sov 107 6 (ck_arm64 ck_ios)
    include inc/px00.sov 107 6 (ck_x86ins ck_emu_driver)
    include inc/px00.sov 107 6 (ck_cprog ck_fp)
    include inc/px00.sov 107 6 (ck_windows_gui ck_win_hang)
    include inc/px00.sov 107 6 (ck_win_imports ck_ww)
    include inc/px00.sov 107 6 (ck_nodisp ck_telegram)
    include inc/px00.sov 107 6 (ck_wine ck_editor)
    include inc/px00.sov 107 6 (ck_examples ck_targets)
    include inc/px00.sov 107 6 (ck_exemac ck_wincomp_emu)
    include inc/px00.sov 107 6 (ck_selfhost ck_alllibs)
    include inc/px00.sov 107 6 (ck_nowarn ck_longdouble)
    include inc/px00.sov 107 6 (ck_fuzz ck_crypto)
    include inc/px00.sov 107 6 (ck_apple ck_apple_none)
    include inc/px00.sov 107 6 (ck_wasm ck_wasi)
    write_out('[shard ') ;; write_out(num_text(sh))
    write_out(' of ') ;; write_out(num_text(ns))
    write_out('] ') ;; write_out(num_text(cr_pass))
    write_out(' passed, ')
    include inc/px00.sov 842 6 (cr_fail failed cr_skipn skipped cr_fail all checks)
    write_out("some checks failed\n")
    sys_exit(1)

