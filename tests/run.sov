ck_win_imports:
    py: cr_which('python3')
    if py = 0 -> return 0
    cr_build('tests/hello.sov', '/tmp/sov-imp.exe', '--windows')
    s: "import struct\n"
    s: str_cat(s, "d = open('/tmp/sov-imp.exe','rb').read()\n")
    s: str_cat(s, "pe = struct.unpack_from('<I', d, 0x3c)[0]\n")
    s: str_cat(s, "imp = struct.unpack_from('<I', d, pe+24+112+8)[0]\n")
    s: str_cat(s, "so = pe+24+240\n")
    s: str_cat(s, "nsec = struct.unpack_from('<H', d, pe+6)[0]\n")
    s: str_cat(s, "sects = []\n")
    s: str_cat(s, "for k in range(nsec):\n")
    s: str_cat(s, "    vs, va, rs, ra = struct.unpack_from('<IIII', d, so+k*40+8)\n")
    s: str_cat(s, "    sects.append((vs, va, rs, ra))\n")
    s: str_cat(s, "def rd(rva, n):\n")
    s: str_cat(s, "    for vs, va, rs, ra in sects:\n")
    s: str_cat(s, "        if va <= rva < va + max(vs, rs):\n")
    s: str_cat(s, "            off = ra + (rva - va)\n")
    s: str_cat(s, "            return d[off:off+n]\n")
    s: str_cat(s, "    return b''\n")
    s: str_cat(s, "ilt, ts, fc, nm, iat = struct.unpack_from('<IIIII', rd(imp, 20), 0)\n")
    s: str_cat(s, "names = []\n")
    s: str_cat(s, "j = 0\n")
    s: str_cat(s, "while True:\n")
    s: str_cat(s, "    v = struct.unpack_from('<Q', rd(iat+j*8, 8))[0]\n")
    s: str_cat(s, "    if v == 0: break\n")
    s: str_cat(s, "    names.append(rd(v+2, 24).split(b'\\0')[0].decode())\n")
    s: str_cat:
        "    j += 1\n"
        "print(' '.join(names))\n"
    file_write_all('/tmp/sov-imp.py', s)
    args: _sov_alloc(24) ;; poke_i64(args, 0, py)
    poke_i64(args, 8, '/tmp/sov-imp.py')
    poke_i64(args, 16, 0) ;; cr_run(py, args, 0, 60)
    if str_has(cr_out, 'LoadLibraryA') = 1 -> if str_has(cr_out, 'GetProcAddress') = 1
            cr_ok('windows-can-reach-other-libraries')
        if not -> cr_bad('windows-can-reach-other-libraries')
    if not -> cr_bad('windows-can-reach-other-libraries')
include inc/px00.sov 1884 4 (ck_ww window sys)
