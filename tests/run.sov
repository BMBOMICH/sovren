# ---- the compiler must reproduce itself, byte for byte ----
ck_selfhost:
    r: cr_build("compilers/linux/compiler.sov", "/tmp/sov-g1", "")
    if r is not 0
        cr_bad("self-host byte for byte")
        return 0
    a: _sov_alloc(32)
    poke_i64(a, 0, "/tmp/sov-g1")
    poke_i64(a, 8, "compilers/linux/compiler.sov")
    poke_i64(a, 16, "-o")
    poke_i64(a, 24, "/tmp/sov-g2")
    poke_i64(a, 32, 0)
    cr_run("/tmp/sov-g1", a, 0, 300)
    poke_i64(a, 0, "/tmp/sov-g2")
    poke_i64(a, 24, "/tmp/sov-g3")
    cr_run("/tmp/sov-g2", a, 0, 300)
    if cr_same("compilers/linux/compiler", "/tmp/sov-g3") is 1
        cr_ok("self-host byte for byte")
    if not
        cr_bad("self-host byte for byte")
    return 0

# ---- every library must build on every target ----
cr_issov nm:
    n: _sov_strlen(nm)
    if n < 5
        return 0
    if peek_byte(nm, n - 4) is 46
        if peek_byte(nm, n - 3) is 115
            if peek_byte(nm, n - 2) is 111
                if peek_byte(nm, n - 1) is 118
                    return 1
    return 0

ck_lib_one nm tgt:
    base: str_cut(nm, 0, _sov_strlen(nm) - 4)
    src: str_cat("use ", base)
    src: str_cat(src, "\nmain:\n    print 1\n")
    file_write_all("/tmp/sov-L.sov", src)
    r: cr_build("/tmp/sov-L.sov", "/tmp/sov-L.bin", tgt)
    if r is 0
        return 0
    write_out("  FAIL ")
    write_out(base)
    write_out(" ")
    write_out(tgt)
    write_out("\n")
    return 1

ck_alllibs:
    fd: sys_open("library", 65536)
    if fd < 0
        cr_bad("open library dir")
        return 0
    buf: _sov_alloc(65536)
    fail: 0
    tot: 0
    more: 1
    as long as more is 1
        n: syscall(217, fd, buf, 65536, 0, 0, 0)
        if n <= 0
            more: 0
        if not
            off: 0
            as long as off < n
                reclen: peek_byte(buf, off + 16) + peek_byte(buf, off + 17) * 256
                typ: peek_byte(buf, off + 18)
                nm: buf + off + 19
                if typ is 8
                    if cr_issov(nm) is 1
                        tot: tot + 1
                        if tot % 25 is 0
                            write_out("  built ")
                            write_out(num_text(tot))
                            write_out(" libraries so far\n")
                        fail: fail + ck_lib_one(nm, "")
                        fail: fail + ck_lib_one(nm, "--windows")
                        fail: fail + ck_lib_one(nm, "--mac")
                        fail: fail + ck_lib_one(nm, "--android")
                        fail: fail + ck_lib_one(nm, "--ios")
                        fail: fail + ck_lib_one(nm, "--android-so")
                off: off + reclen
    sys_close(fd)
    write_out(num_text(tot))
    write_out(" libraries, ")
    write_out(num_text(fail))
    write_out(" build failures\n")
    if fail is 0
        cr_ok("every library on every target")
    if not
        cr_bad("every library on every target")
    return 0

# ---- no compiler may warn ----
ck_nowarn:
    names: _sov_alloc(64)
    poke_i64(names, 0, "linux")
    poke_i64(names, 8, "windows")
    poke_i64(names, 16, "mac")
    poke_i64(names, 24, "android")
    poke_i64(names, 32, "ios")
    poke_i64(names, 40, 0)
    i: 0
    as long as i < 5
        d: peek_i64(names, i * 8)
        src: str_cat(d, "/compiler.sov")
        r: cr_build(src, "/tmp/sov-cw", "")
        if r is not 0
            cr_bad(str_cat(d, " builds clean"))
        if not
            if str_has(cr_out, "Warning") is 1
                cr_bad(str_cat(d, " builds clean"))
            if not
                cr_ok(str_cat(d, " builds clean"))
        i: i + 1
    return 0

# ---- long double, on the processor written in Sovren ----
ck_longdouble:
    gcc: cr_which("gcc")
    if gcc is 0
        cr_skip("long double (no gcc)")
        return 0
    c: "#include <stdio.h>\nstatic long double f(long double a, long double b){ return a*b + a/b; }\nint main(void){\n"
    c: str_cat(c, "    long double x = 3.5L, y = 1.25L;\n")
    c: str_cat(c, "    printf(\"%.10Lf\\n\", f(x, y));\n")
    c: str_cat(c, "    printf(\"%.10Lf\\n\", x + y);\n")
    c: str_cat(c, "    printf(\"%.10Lf\\n\", x * x * x);\n")
    c: str_cat(c, "    return 0;\n}\n")
    file_write_all("/tmp/sov-ld.c", c)
    a: _sov_alloc(48)
    poke_i64(a, 0, gcc)
    poke_i64(a, 8, "-static")
    poke_i64(a, 16, "-O1")
    poke_i64(a, 24, "-o")
    poke_i64(a, 32, "/tmp/sov-ld")
    poke_i64(a, 40, "/tmp/sov-ld.c")
    poke_i64(a, 48, 0)
    cr_run(gcc, a, 0, 120)
    if cr_rc is not 0
        cr_skip("long double (gcc cannot build static)")
        return 0
    cr_bin("/tmp/sov-ld", 20)
    nat: cr_out
    a2: _sov_alloc(16)
    poke_i64(a2, 0, "/tmp/sov-runc")
    poke_i64(a2, 8, "/tmp/sov-ld")
    poke_i64(a2, 16, 0)
    cr_run("/tmp/sov-runc", a2, 0, 120)
    if str_eq(nat, cr_out) is 1
        cr_ok("long double on the emulated cpu")
    if not
        cr_bad("long double on the emulated cpu")
    return 0

# ---- the exe and the Mac binary, run in the Sovren emulators ----
ck_exemac:
    cr_build("tests/windows-run.sov", "/tmp/sov-wrun", "")
    cr_build("tests/macos-run.sov", "/tmp/sov-mrun", "")
    cr_build("tests/hello.sov", "/tmp/sov-h.exe", "--windows")
    cr_build("tests/hello.sov", "/tmp/sov-h.mac", "--mac")
    a: _sov_alloc(16)
    poke_i64(a, 0, "/tmp/sov-wrun")
    poke_i64(a, 8, "/tmp/sov-h.exe")
    poke_i64(a, 16, 0)
    cr_run("/tmp/sov-wrun", a, 0, 120)
    w: cr_out
    poke_i64(a, 0, "/tmp/sov-mrun")
    poke_i64(a, 8, "/tmp/sov-h.mac")
    cr_run("/tmp/sov-mrun", a, 0, 120)
    m: cr_out
    if str_has(w, "Hello from Sovren") is 1
        if str_has(m, "Hello from Sovren") is 1
            if str_eq(w, m) is 1
                cr_ok("exe and Mac binary, same words, in Sovren")
                return 0
    cr_bad("exe and Mac binary, same words, in Sovren")
    return 0

# ---- sovren.exe, run inside the Sovren emulator ----
ck_wincomp_emu:
    src: cr_line("", "use x86")
    src: cr_line(src, "use string")
    src: cr_line(src, "main:")
    src: cr_line(src, "    m: x86_new()")
    src: cr_line(src, "    if x86_load(m, \"sovren.exe\") is 0")
    src: cr_line(src, "        print \"cannot load sovren.exe\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    x_set_cmdline(m, \"sovren.exe hello.sov -o /tmp/hello-emu.exe\")")
    src: cr_line(src, "    x86_run_for(m, 500000000)")
    src: cr_line(src, "    write_out(x86_out(m))")
    src: cr_line(src, "    write_out(x86_err(m))")
    src: cr_line(src, "    print x86_reason(m)")
    file_write_all("/tmp/sov-emub.sov", src)
    r: cr_build("/tmp/sov-emub.sov", "/tmp/sov-emub", "")
    if r is not 0
        cr_bad("windows compiler in the emulator")
        return 0
    cr_bin("/tmp/sov-emub", 400)
    if str_has(cr_out, "Wrote") is 0
        cr_bad("windows compiler in the emulator")
        return 0
    if str_has(cr_out, "done") is 0
        cr_bad("windows compiler in the emulator")
        return 0
    if file_exists("/tmp/hello-emu.exe") is 0
        cr_bad("windows compiler in the emulator (no exe)")
        return 0
    cr_build("tests/hello.sov", "/tmp/sov-hn.exe", "--windows")
    if cr_same("/tmp/hello-emu.exe", "/tmp/sov-hn.exe") is 1
        cr_ok("windows compiler in the emulator, byte for byte")
    if not
        cr_bad("windows compiler in the emulator, byte for byte")
    a: _sov_alloc(16)
    poke_i64(a, 0, "/tmp/sov-wrun")
    poke_i64(a, 8, "/tmp/hello-emu.exe")
    poke_i64(a, 16, 0)
    cr_run("/tmp/sov-wrun", a, 0, 120)
    if str_has(cr_out, "Hello from Sovren") is 1
        cr_ok("the exe built inside the emulator runs")
    if not
        cr_bad("the exe built inside the emulator runs")
    return 0

# two files the same, byte for byte (already defined) — these are the
# little-endian reads a BMP wants, and a search for one colour
cr_le16 p i:
    return peek_byte(p, i) + peek_byte(p, i + 1) * 256

cr_le32 p i:
    return peek_byte(p, i) + peek_byte(p, i + 1) * 256 + peek_byte(p, i + 2) * 65536 + peek_byte(p, i + 3) * 16777216

# is the colour (r,g,b) anywhere in a BMP?
cr_bmp_has b r g bl:
    if b is 0
        return 0
    po: cr_le32(b, 10)
    w: cr_le32(b, 18)
    h: cr_le32(b, 22)
    bpp: cr_le16(b, 28)
    if bpp is not 24
        if bpp is not 32
            return 0
    bypp: bpp / 8
    rowsz: w * bypp
    as long as rowsz % 4 is not 0
        rowsz: rowsz + 1
    up: 1
    if h < 0
        h: 0 - h
        up: 0
    y: 0
    as long as y < h
        x: 0
        as long as x < w
            yy: y
            if up is 1
                yy: h - 1 - y
            o: po + yy * rowsz + x * bypp
            if peek_byte(b, o + 2) is r
                if peek_byte(b, o + 1) is g
                    if peek_byte(b, o) is bl
                        return 1
            x: x + 1
        y: y + 1
    return 0

# ---- the cryptography answers the standard vectors ----

# hex text into a buffer; the byte count comes back
cr_hex buf s:
    n: str_len(s)
    i: 0
    j: 0
    as long as i < n
        hi: cr_nib(peek_byte(s, i))
        lo: cr_nib(peek_byte(s, i + 1))
        poke_byte(buf, j, hi * 16 + lo)
        j: j + 1
        i: i + 2
    return j

cr_nib c:
    if c >= 48
        if c <= 57
            return c - 48
    if c >= 97
        return c - 87
    if c >= 65
        return c - 55
    return 0

cr_byteeq a b n:
    i: 0
    as long as i < n
        if peek_byte(a, i) is not peek_byte(b, i)
            return 0
        i: i + 1
    return 1

ck_crypto:
    # AES-128, the NIST C.1 vector
    kb: _sov_alloc(16)
    pb: _sov_alloc(16)
    cb: _sov_alloc(16)
    xb: _sov_alloc(16)
    cr_hex(kb, "000102030405060708090a0b0c0d0e0f")
    cr_hex(pb, "00112233445566778899aabbccddeeff")
    rk: _sov_alloc(176)
    ae_expand(kb, rk)
    ae_enc_block(rk, pb, cb)
    cr_hex(xb, "69c4e0d86a7b0430d8cdb78070b4c55a")
    if cr_byteeq(cb, xb, 16) is 1
        cr_ok("aes-128 matches the NIST vector")
    if not
        cr_bad("aes-128 matches the NIST vector")
    ae_dec_block(rk, cb, xb)
    if cr_byteeq(xb, pb, 16) is 1
        cr_ok("aes-128 decrypts its own ciphertext")
    if not
        cr_bad("aes-128 decrypts its own ciphertext")
    # AES-128-GCM, the vector checked against pycryptodome
    gk: _sov_alloc(16)
    giv: _sov_alloc(12)
    ga: _sov_alloc(20)
    gp: _sov_alloc(16)
    gc: _sov_alloc(16)
    gx: _sov_alloc(16)
    cr_hex(gk, "000102030405060708090a0b0c0d0e0f")
    cr_hex(giv, "000102030405060708090a0b")
    cr_hex(ga, "feedfacedeadbeeffeedfacedeadbeefabaddad2")
    cr_hex(gp, "d9313225f88406e5a55909c5aff5269a")
    gm_enc(gk, giv, ga, 20, gp, 16, gc)
    cr_hex(gx, "4a5d95eb9e9ff1b1ee8b684f99565692")
    if cr_byteeq(gc, gx, 16) is 1
        cr_ok("gcm ciphertext matches the vector")
    if not
        cr_bad("gcm ciphertext matches the vector")
    cr_hex(gx, "a66c4727f9c541175b33b673b0d32c7b")
    if cr_byteeq(gm_tag, gx, 16) is 1
        cr_ok("gcm tag matches the vector")
    if not
        cr_bad("gcm tag matches the vector")
    # the PRF, the RFC 5246 vector
    ps: _sov_alloc(48)
    pd: _sov_alloc(64)
    po: _sov_alloc(32)
    i: 0
    as long as i < 48
        poke_byte(ps, i, 171)
        i: i + 1
    i: 0
    as long as i < 64
        poke_byte(pd, i, 205)
        i: i + 1
    tl_n: 12
    tl_prf(po, ps, 48, "PRF testvector", 14, pd, 64)
    cr_hex(gx, "670b6682a396647c92e554f0")
    if cr_byteeq(po, gx, 12) is 1
        cr_ok("the PRF matches the RFC 5246 vector")
    if not
        cr_bad("the PRF matches the RFC 5246 vector")
    # the record layer: one encrypted record, byte for byte
    rb: _sov_alloc(64)
    cr_hex(kb, "0104070a0d101316191c1f2225282b2e")
    cr_hex(xb, "070b0d11")
    cr_hex(pb, "02070c11161b20252a2f34393e43484d")
    tl_seq_c: 1
    tl_rec_enc(rb, 23, pb, 16, kb, xb)
    rl: tl_clen
    cr_hex(cb, "1703030028000000000000000131be80774d7b3752af457288f889b2fadabe1291cc4c4315febd60a65a832050")
    if rl is 45
        if cr_byteeq(rb, cb, 45) is 1
            cr_ok("the record layer matches the vector")
        if not
            cr_bad("the record layer matches the vector")
    if not
        cr_bad("the record layer matches the vector")
    # json paths, deep into arrays and objects
    js: "{\"a\":1,\"b\":[10,20,{\"c\":\"x\"}],\"d\":\"hi\"}"
    v: json_at_num(js, "a")
    if v is 1
        cr_ok("json numbers by path")
    if not
        cr_bad("json numbers by path")
    v: json_len(js, "b")
    if v is 3
        cr_ok("json array lengths by path")
    if not
        cr_bad("json array lengths by path")
    s: json_at(js, "b[2].c")
    if str_eq(s, "x") is 1
        cr_ok("json deep paths")
    if not
        cr_bad("json deep paths")
    # X25519, the RFC 7748 vectors
    xa: _sov_alloc(32)
    xb: _sov_alloc(32)
    xo: _sov_alloc(32)
    cr_hex(xa, "a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4")
    cr_hex(xb, "e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")
    x19(xo, xa, xb)
    cr_hex(xb, "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552")
    if cr_byteeq(xo, xb, 32) is 1
        cr_ok("x25519 matches the RFC vector")
    if not
        cr_bad("x25519 matches the RFC vector")
    # the RFC key agreement: X25519(a, 9) and the shared secret.
    # every byte of the base point is cleared: xo is reused from the
    # vector above, and a leftover last byte would quietly change
    # the point.
    cr_hex(xa, "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
    cr_hex(xb, "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb")
    i: 0
    as long as i < 32
        poke_byte(xo, i, 0)
        i: i + 1
    poke_byte(xo, 0, 9)
    x19(xo, xa, xo)
    cr_hex(xb, "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a")
    if cr_byteeq(xo, xb, 32) is 1
        cr_ok("x25519 key agreement matches the RFC")
    if not
        cr_bad("x25519 key agreement matches the RFC")
    return 0

