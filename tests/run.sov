include inc/inc05.sov 1125 3
    aes
    gcm
    tls
    json
0:
    cr_pass: 0
    cr_fail: 0
    cr_skipn: 0
    sh: 0
ns: 1 ;; ci: 0
use wasm
cr_ok name:
    write_out('ok ') ;; write_out(name)
    write_out("\n")
    cr_pass: cr_pass + 1
cr_bad name:
    include inc/inc03.sov 1475 3
    cr_fail: cr_fail + 1
cr_skip name:
    include inc/inc04.sov 1387 3
    cr_skipn: cr_skipn + 1
cr_which name:
    p: str_cat('/usr/bin/', name)
    if file_exists(p) = 1 -> return p
    p: str_cat('/usr/local/bin/', name)
    if file_exists(p) = 1 -> return p
    p: str_cat('/bin/', name)
    if file_exists(p) = 1 -> return p ;; return 0
cr_mode: 0
cr_data: ''
cr_tout: 120
cr_out: ''
cr_rc: 0
include inc/px00.sov 548 4 (cr_pr cr_pw)
cr_go path args envp:
    if file_exists('/tmp/cr-timeout') = 1 -> file_delete('/tmp/cr-timeout')
    cr_out: ''
    opf: _sov_alloc(16) ;; sys_pipe(opf)
    ipf: 0 ;; if cr_mode = 1 -> ipf: _sov_alloc(16)
        sys_pipe(ipf)
    pid: proc_fork() ;; if pid = 0 -> sys_dup2(cr_pw(opf), 1)
        sys_close(cr_pr(opf)) ;; if cr_mode = 1 -> sys_dup2(cr_pr(ipf), 0)
            sys_close(cr_pw(ipf))
        if not -> if cr_mode = 2
                nf: sys_open('/dev/null', 0)
                sys_dup2(nf, 0) ;; sys_close(nf)
        sys_exec(path, args, envp) ;; sys_exit(127)
    sys_close(cr_pw(opf)) ;; wr: 0
    if cr_mode = 1 -> sys_close(cr_pr(ipf))
        wr: proc_fork() ;; if wr = 0 -> n: str_len(cr_data)
            sys_write(cr_pw(ipf), cr_data, n) ;; sys_close(cr_pw(ipf))
            sys_exit(0)
        sys_close(cr_pw(ipf))
    if cr_tout = 0 -> sys_close(cr_pr(opf))
        cr_rc: 0 ;; cr_lastpid: pid
        return 0
    wd: 0 ;; if cr_tout > 0 -> wd: proc_fork()
        if wd = 0 -> i: 0
            as long as i < cr_tout -> ts: _sov_alloc(16)
                ts: poke_i64 0 + 8 * i: 1 0 ;; sys_nanosleep(ts)
                if sys_kill(pid, 0) != 0 -> sys_exit(0) ;; i: i + 1
            file_write_all('/tmp/cr-timeout', '1')
            proc_kill9(pid) ;; sys_exit(0)
    include inc/inc03.sov 1478 3
    as long as more = 1 -> n: sys_read(cr_pr(opf), buf, 8192)
        if n <= 0 -> more: 0 ;; if not -> poke_byte(buf, n, 0)
            t: as text buf ;; out: str_cat(out, t)
    sys_close(cr_pr(opf)) ;; stp: _sov_alloc(8)
    syscall(61, pid, stp, 0, 0, 0, 0) ;; st: peek_i64(stp, 0)
    if wr != 0 -> syscall(61, wr, stp, 0, 0, 0, 0) ;; if wd != 0 -> syscall(61, wd, stp, 0, 0, 0, 0)
    code: (st / 256) % 256 ;; if st % 256 != 0 -> code: 128 + st % 256
    if file_exists('/tmp/cr-timeout') = 1 -> code: 124
        file_delete('/tmp/cr-timeout')
    cr_rc: code ;; cr_out: out
    cr_lastpid: pid ;; return code
include inc/px01.sov 1716 4 (cr_run 0)
cr_run_in path args envp data tout:
    cr_mode: 1 ;; cr_data: data
    cr_tout: tout ;; return cr_go(path, args, envp)
include inc/px01.sov 1716 4 (cr_run_dev 2)
cr_build src out flag:
    args: _sov_alloc(64)
    poke_i64(args, 0, './sovren')
    poke_i64(args, 8, src) ;; if str_len(flag) > 0 -> poke_i64(args, 16, flag)
        poke_i64(args, 24, '-o')
        args: poke_i64 32 + 8 * i: out 0
    if not -> poke_i64(args, 16, '-o')
        args: poke_i64 24 + 8 * i: out 0
    cr_run('./sovren', args, 0, 120)
    return cr_rc
cr_bin path tout:
    args: _sov_alloc(16) ;; args: poke_i64 0 + 8 * i: path 0
    cr_run(path, args, 0, tout) ;; return cr_rc
cr_line src s:
    return str_cat(str_cat(src, s), "\n")
cr_same a b:
    if file_size(a) != file_size(b) -> return 0 ;; n: file_size(a)
    d1: file_read_all(a) ;; d2: file_read_all(b)
    include inc/px00.sov 320 4 (n d1 d2)
    return 1
cr_flat s:
    n: str_len(s) ;; o: _sov_alloc(n + 1)
    include inc/px00.sov 207 4 (0 j i i n c peek_byte s i)
        if c = 10 -> i: i + 1 ;; if not -> if c = 13
                i: i + 1
            if not -> poke_byte(o, j, c)
                j: j + 1 ;; i: i + 1
    poke_byte(o, j, 0) ;; return o
cr_eqs a b:
    if str_len(a) != str_len(b) -> return 0 ;; n: str_len(a)
    include inc/px00.sov 320 4 (n a b)
    return 1
cr_file_has p needle:
    fd: sys_open(p, 0)
    if fd < 0 -> return 0
    n: file_size(p)
    buf: _sov_alloc(n + 1)
    got: syscall(0, fd, buf, n, 0, 0, 0)
    sys_close(fd)
    if got < 0 -> return 0
    m: str_len(needle)
    if m = 0 -> return 1
    i: 0
    as long as i + m <= got -> j: 0
        ok: 1
        as long as j < m -> if peek_byte(buf, i + j) != peek_byte(needle, j) -> ok: 0
                leave
            j: j + 1
        if ok = 1 -> return 1
        i: i + 1
    return 0
cr_file_has_u32 p val:
    fd: sys_open(p, 0)
    if fd < 0 -> return 0
    n: file_size(p)
    buf: _sov_alloc(n + 1)
    got: syscall(0, fd, buf, n, 0, 0, 0)
    sys_close(fd)
    if got < 4 -> return 0
    b0: val & 255
    b1: (val / 256) & 255
    b2: (val / 65536) & 255
    b3: (val / 16777216) & 255
    i: 0
    as long as i + 4 <= got -> if peek_byte(buf, i) = b0
            if peek_byte(buf, i + 1) = b1 -> if peek_byte(buf, i + 2) = b2
                    if peek_byte(buf, i + 3) = b3 -> return 1
        i: i + 1
    return 0
cr_trim s:
    n: str_len(s) ;; if n > 0 -> if peek_byte(s, n - 1) = 10
            return str_cut(s, 0, n - 1)
    return s
ck_all:
    r: cr_build('tests/all.sov', '/tmp/sov-all', '')
    if r = 0 -> cr_bin('/tmp/sov-all', 300)
        if cr_rc = 0 -> cr_ok('the Sovren suite')
        if not -> cr_bad('the Sovren suite')
    if not -> cr_bad('could not build tests/all.sov')
ck_arm_emu:
    r: cr_build('tests/arm64/run.sov', '/tmp/sov-armrun', '')
    if r != 0 -> cr_bad('could not build tests/arm64/run.sov')
        return 0
    src: cr_line('', 'main:')
    src: cr_line(src, '    print 5 * 3 / 2')
    include inc/px01.sov 1721 4 (ea ea)
    if str_eq(g, '7') = 1 -> cr_ok('arm-emulator-in-sovren')
    if not -> cr_bad('arm-emulator-in-sovren')
    include inc/inc04.sov 317 4
    include inc/px01.sov 1721 4 (ea2 ea2)
    if str_eq(g, 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad') = 1 -> cr_ok('arm-emulator-sha256')
    if not -> cr_bad('arm-emulator-sha256')
ck_arm64:
    r: cr_build('tests/arm64/verify.sov', '/tmp/sov-verify', '')
    if r = 0 -> cr_bin('/tmp/sov-verify', 120)
        if str_has(cr_out, 'every encoding is right') = 1 -> cr_ok('arm64-encodings')
        if not -> cr_bad('arm64-encodings')
    if not -> cr_bad('could not build tests/arm64/verify.sov')
    r: cr_build('tests/arm64/test.sov', '/tmp/sov-armtest', '')
    if r = 0 -> cr_bin('/tmp/sov-armtest', 120)
        if str_has(cr_out, 'the ARM back end is right') = 1 -> cr_ok('arm64-codegen')
        if not -> cr_bad('arm64-codegen')
    if not -> cr_bad('could not build tests/arm64/test.sov')
    src: cr_line('', 'main:')
    src: cr_line(src, '    print 5 * 3 / 2')
    file_write_all('/tmp/sov-so.sov', src)
    cr_build('/tmp/sov-so.sov', '/tmp/sov-so.so', '--android-so')
    r: cr_build('tests/arm64/runso.sov', '/tmp/sov-runso', '')
    if r = 0 -> cr_bin('/tmp/sov-runso', 300)
        g: cr_flat(cr_out)
        if str_eq(g, '77') = 1 -> cr_ok('so-exports')
        if not -> cr_bad('so-exports')
    if not -> cr_bad('could not build tests/arm64/runso.sov')
ck_ios:
    r: cr_build('tests/hello.sov', '/tmp/sov-ios.bin', '--ios')
    if r != 0 -> cr_bad('could not build the ios test binary')
        return 0
    r: cr_build('tests/arm64/check_sig.sov', '/tmp/sov-csig', '')
    if r != 0 -> cr_bad('could not build tests/arm64/check_sig.sov')
        return 0
    include inc/px00.sov 1311 5 (24 csig sov ios bin csig 60)
    if cr_rc = 0 -> cr_ok('ios-code-signature')
    if not -> cr_bad('ios-code-signature')
ap_le32 p i:
    return peek_byte(p, i) + peek_byte(p, i + 1) * 256 + peek_byte(p, i + 2) * 65536 + peek_byte(p, i + 3) * 16777216
ap_got_plat: 0
ap_got_off: 0
ap_got_sig: 0
ap_got_ent: 0
ap_walk d:
    ncmds: ap_le32(d, 16)
    off: 32
    i: 0
    ap_got_plat: 0 - 1
    ap_got_sig: 0 - 1
    ap_got_ent: 0 - 1
    as long as i < ncmds -> cmd: ap_le32(d, off)
        sz: ap_le32(d, off + 4)
        if sz < 8 -> leave
        if cmd = 50 -> ap_got_plat: ap_le32(d, off + 8)
        if cmd = 29 -> ap_got_sig: ap_le32(d, off + 8)
        if cmd = 2147483688 -> ap_got_ent: ap_le32(d, off + 8)
        off: off + sz
        i: i + 1
    ap_got_off: off
ap_check tgt plat:
    out: str_cat('/tmp/sov-apple-', tgt)
    r: cr_build('tests/hello.sov', out, str_cat('--', tgt))
    if r != 0 -> cr_bad(str_cat('apple-platform ', tgt))
        return 0
    d: file_read_all(out)
    if d = 0 -> cr_bad(str_cat('apple-platform ', tgt))
        return 0
    dummy: ap_walk(d)
    ok: 1
    if ap_le32(d, 4) != 16777228 -> ok: 0
    if ap_got_plat != plat -> ok: 0
    if ap_got_off != 32 + ap_le32(d, 20) -> ok: 0
    if ap_got_ent != ap_got_off -> ok: 0
    if ap_got_sig < 0 -> ok: 0
    if ok = 1 -> cr_ok(str_cat('apple-platform ', tgt))
    if not -> cr_bad(str_cat('apple-platform ', tgt))
    return 0
ck_apple:
    dummy: ap_check('ios', 2)
    dummy: ap_check('ipados', 2)
    dummy: ap_check('tvos', 3)
    dummy: ap_check('watchos', 4)
    dummy: ap_check('visionos', 11)
    dummy: ap_check('ios-simulator', 7)
    dummy: ap_check('tvos-simulator', 8)
    dummy: ap_check('watchos-simulator', 9)
    dummy: ap_check('visionos-simulator', 12)
    return 0
ck_apple_none:
    return 0
ck_x86ins:
    r: cr_build('tests/x86ins.sov', '/tmp/sov-x86ins', '')
    if r = 0 -> cr_bin('/tmp/sov-x86ins', 120)
        if str_has(cr_out, 'every instruction is right') = 1 -> cr_ok('x86-instructions')
        if not -> cr_bad('x86-instructions')
    if not -> cr_bad('could not build tests/x86ins.sov')
ck_cprog:
    gcc: cr_which('gcc')
    if gcc = 0 -> cr_skip('a real C program (no gcc)')
        return 0
    c: "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n"
    c: str_cat(c, "static int cmp(const void *a, const void *b) { return *(int*)a - *(int*)b; }\n")
    c: str_cat(c, "int main(void) {\n")
    c: str_cat(c, "    int *a = malloc(sizeof(int) * 50);\n")
    c: str_cat(c, "    for (int i = 0; i < 50; i++) a[i] = (i * 7919) % 1000;\n")
    c: str_cat(c, "    qsort(a, 50, sizeof(int), cmp);\n")
    c: str_cat(c, "    printf(\"%d %d\\n\", a[0], a[49]);\n")
    c: str_cat(c, "    char *s = malloc(256);\n")
    c: str_cat(c, "    snprintf(s, 256, \"%s|%d|%x\", \"fmt\", 42, 255);\n")
    c: str_cat(c, "    printf(\"%s %zu\\n\", s, strlen(s));\n")
    c: str_cat(c, "    long long b = 1;\n")
    c: str_cat(c, "    for (int i = 0; i < 20; i++) b *= 3;\n")
    c: str_cat(c, "    printf(\"%lld\\n\", b);\n")
    c: str_cat:
        "    free(a); free(s);\n"
        "    return 0;\n}\n"
    file_write_all('/tmp/sov-cprog.c', c)
    include inc/inc03.sov 1336 5
    include inc/px00.sov 1879 4 (args cprog args cprog args args)
    if cr_rc != 0 -> cr_skip('a real C program (gcc cannot build static)')
        return 0
    ck_emu_driver()
    cr_bin('/tmp/sov-cprog', 60)
    include inc/inc04.sov 1441 3
    include inc/px01.sov 1726 4 (cprog runs a real c program)
    if not -> cr_bad('x86-runs-a-real-c-program')
include inc/px00.sov 1884 4 (ck_emu_driver x86 arg)
    src: cr_line(src, '    m: x86_new()')
    src: cr_line(src, '    if x86_load(m, arg_at(1)) is 0')
    src: cr_line:
        "        print \"cannot load\""
        '        stop'
        '    x86_run(m)'
        '    write_out(x86_out(m))'
        '    write_err(x86_reason(m))'
    file_write_all('/tmp/sov-runc.sov', src)
    cr_build('/tmp/sov-runc.sov', '/tmp/sov-runc', '')
ck_fp:
    gcc: cr_which('gcc')
    if gcc = 0 -> cr_skip('decimals in C (no gcc)')
        return 0
    c: "#include <stdio.h>\nint main(void) {\n"
    c: str_cat(c, "    double v[] = {1.0, 2.5, -3.75, 0.1, 1e10, 1e-10, 123456.789};\n")
    c: str_cat(c, "    double s = 0, p = 1;\n")
    c: str_cat(c, "    for (int i = 0; i < 7; i++) { s += v[i]; p *= v[i]; }\n")
    c: str_cat(c, "    printf(\"sum=%.10f\\nprod=%.10e\\n\", s, p);\n")
    c: str_cat(c, "    for (int i = 0; i < 5; i++) printf(\"%d:%.4f \", i, (double)i / 7.0);\n")
    c: str_cat(c, "    printf(\"\\n\");\n")
    c: str_cat(c, "    printf(\"big=%.3e small=%.3e\\n\", 1e300 * 1e5, 1e-300 / 1e5);\n")
    c: str_cat(c, "    printf(\"cast=%d %d %lld\\n\", (int)3.99, (int)-3.99, (long long)1e15);\n")
    c: str_cat(c, "    printf(\"cmp %d %d %d\\n\", 1.5 < 2.5, 1.5 == 1.5, 3.0 > 4.0);\n")
    c: str_cat(c, "    double a = 0.1, b = 0.2;\n")
    c: str_cat(c, "    printf(\"tenths=%.17g exact=%d\\n\", a + b, (a + b) == 0.3);\n")
    c: str_cat(c, "    return 0;\n}\n")
    file_write_all('/tmp/sov-fp.c', c)
    include inc/inc03.sov 1336 5
    include inc/px00.sov 1879 4 (args fp args fp args args)
    if cr_rc != 0 -> cr_skip('decimals in C (gcc cannot build static)')
        return 0
    cr_bin('/tmp/sov-fp', 60)
    include inc/inc04.sov 1441 3
    include inc/px01.sov 1726 4 (fp decimals match the real thing)
    if not -> cr_bad('x86-decimals-match-the-real-thing')
ck_windows_gui:
    xvfb: cr_which('Xvfb')
    if xvfb = 0 -> cr_skip('the window libraries (no screen to draw on)')
        return 0
    d: 77
    disp: ''
    as long as d < 82 -> lock: str_cat('/tmp/.X', num_text(d))
        lock: str_cat(lock, '-lock')
        sock: str_cat('/tmp/.X11-unix/X', num_text(d))
        if file_exists(lock) = 0 -> if file_exists(sock) = 0
                include inc/inc03.sov 1341 5
                poke_i64(args, 24, '0 640x480x24')
                include inc/inc05.sov 905 4
                if str_len(disp) > 0 -> d: 82
        d: d + 1
    if str_len(disp) = 0 -> cr_skip('the window libraries (no screen to draw on)')
        return 0
    envp: cr_disp_env(disp) ;; ck_win_draw(envp, disp)
    ck_win_game(envp, disp) ;; ck_win_ui(envp, disp)
    proc_kill(xvfbpid)
cr_disp_env disp:
    e: _sov_alloc(64)
    p1: str_cat('DISPLAY=', disp)
    poke_i64(e, 0, p1)
    poke_i64(e, 8, 'PATH=/usr/bin:/bin')
    poke_i64(e, 16, 'HOME=/tmp')
    poke_i64(e, 24, 0) ;; return e
ck_win_draw envp disp:
    include inc/inc04.sov 1444 3
    src: cr_line(src, "    w: win_open(320, 240, \"sovrencheck\")")
    include inc/inc04.sov 325 4
    src: cr_line(src, '    as long as i < 30')
    src: cr_line(src, '        win_fill(w, 0, 0, 320, 240, WIN_WHITE)')
    src: cr_line(src, '        win_fill(w, 20, 20, 80, 60, WIN_RED)')
    src: cr_line(src, '        win_box(w, 140, 20, 90, 60, WIN_BLUE)')
    src: cr_line(src, '        win_line(w, 10, 200, 300, 160, WIN_GREEN)')
    src: cr_line(src, "        win_text(w, 20, 120, \"sovren\", WIN_BLACK)")
    src: cr_line(src, '        win_flush(w)')
    src: cr_line(src, '        sleep_ms(100)')
    src: cr_line(src, '        i: i + 1')
    src: cr_line(src, "    print \"drew\"")
    include inc/px00.sov 1115 4 (win win win window)
    cr_run('/tmp/sov-win', args1(), envp, 60)
    if str_has(cr_out, 'drew') = 1 -> cr_ok('window-finishes')
    if not -> cr_bad('window-finishes')
    cr_ok('window-opens')
    imp: cr_which('import')
    if imp = 0 -> cr_skip('looking at the screen (no import)')
        return 0
    a2: _sov_alloc(40) ;; poke_i64(a2, 0, imp)
    poke_i64(a2, 8, '-window')
    poke_i64(a2, 16, 'root')
    poke_i64(a2, 24, '/tmp/sov-w.bmp')
    poke_i64(a2, 32, 0) ;; cr_run(imp, a2, envp, 60)
    if file_exists('/tmp/sov-w.bmp') = 0 -> cr_bad('capturing the screen')
        return 0
    b: file_read_all('/tmp/sov-w.bmp')
    got: 1 ;; if cr_bmp_has(b, 255, 0, 0) = 0 -> got: 0
    if cr_bmp_has(b, 0, 0, 255) = 0 -> got: 0 ;; if cr_bmp_has(b, 0, 255, 0) = 0 -> got: 0
    if got = 1 -> cr_ok('the red, blue and green reached the screen')
    if not -> cr_bad('the red, blue and green reached the screen')
args1:
    a: _sov_alloc(16)
    poke_i64(a, 0, '/tmp/sov-win')
    poke_i64(a, 8, 0) ;; return a
ck_win_game envp disp:
    src: cr_line('', 'use game')
    src: cr_line(src, 'use num')
    include inc/px00.sov 2781 6 (g game_new 200 150 g g)
    src: cr_line(src, '    game_speed(g, 50)')
    src: cr_line(src, '    t0: time_ms()')
    src: cr_line(src, '    n: 0')
    src: cr_line(src, '    as long as n < 50')
    src: cr_line(src, '        game_step(g)')
    src: cr_line(src, '        game_clear(g, WIN_BLACK)')
    src: cr_line(src, '        game_rect(g, n, 40, 10, 10, WIN_RED)')
    src: cr_line(src, '        game_show(g)')
    src: cr_line(src, '        n: n + 1')
    src: cr_line(src, '    el: time_ms() - t0')
    src: cr_line:
        '    if el > 800'
        '        if el < 1400'
        "            print \"paced\""
    include inc/px00.sov 1115 4 (game game game game)
    include inc/px00.sov 1889 4 (game game 40)
    if str_has(cr_out, 'paced') = 1 -> cr_ok('game-loop-keeps-time')
    if not -> cr_bad('game-loop-keeps-time')
ck_win_ui envp disp:
    src: cr_line('', 'use ui')
    include inc/px00.sov 2781 6 (u ui_new 300 200 form u)
    src: cr_line(src, "    ui_label(u, 20, 16, \"name\")")
    src: cr_line(src, '    e: ui_entry(u, 20, 40, 260, 28)')
    src: cr_line(src, "    b: ui_button(u, 20, 90, 100, 32, \"Go\")")
    src: cr_line(src, "    c: ui_check(u, 20, 140, \"keep me\")")
    src: cr_line(src, "    ui_set_text(u, e, \"Elxan\")")
    src: cr_line(src, '    ui_tick(u, c, 1)')
    src: cr_line(src, '    i: 0')
    src: cr_line(src, '    as long as i < 20')
    src: cr_line(src, '        ui_draw(u)')
    src: cr_line(src, '        sleep_ms(100)')
    src: cr_line(src, '        i: i + 1')
    src: cr_line(src, "    print \"form drawn\"")
    include inc/px00.sov 1115 4 (ui ui ui widget)
    include inc/px00.sov 1889 4 (ui ui 60)
    if str_has(cr_out, 'form drawn') = 1 -> cr_ok('widgets-draw')
    if not -> cr_bad('widgets-draw')
ck_win_hang:
    xvfb: cr_which('Xvfb')
    if xvfb = 0 -> return 0 ;; d: 84
    disp: ''
    as long as d < 87 -> sock: str_cat('/tmp/.X11-unix/X', num_text(d))
        lock: str_cat('/tmp/.X', num_text(d))
        lock: str_cat(lock, '-lock')
        if file_exists(sock) = 0 -> if file_exists(lock) = 0
                include inc/inc03.sov 1341 5
                poke_i64(args, 24, '0 320x240x24')
                include inc/inc05.sov 905 4
                if str_len(disp) > 0 -> d: 87
        d: d + 1
    if str_len(disp) = 0 -> return 0
    include inc/inc04.sov 1444 3
    src: cr_line(src, "    w: win_open(200, 150, \"hangcheck\")")
    include inc/inc04.sov 325 4
    src: cr_line(src, '    as long as i < 300')
    src: cr_line(src, '        win_fill(w, 0, 0, 200, 150, WIN_RED)')
    src: cr_line(src, '        win_flush(w)')
