    src: cr_line(src, "        print \"noscreen\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    print window_which(w)")
    src: cr_line(src, "    window_shut(w)")
    file_write_all("/tmp/sov-ww.sov", src)
    r: cr_build("/tmp/sov-ww.sov", "/tmp/sov-ww.exe", "--windows")
    if r is 0
        cr_ok("window-library-builds-for-windows")
    if not
        cr_bad("window-library-builds-for-windows")
    r: cr_build("/tmp/sov-ww.sov", "/tmp/sov-ww", "")
    if r is 0
        cr_bin("/tmp/sov-ww", 20)
        g: cr_trim(cr_out)
        if str_eq(g, "noscreen") is 1
            cr_ok("window-library-honest-with-no-screen")
        if not
            cr_bad("window-library-honest-with-no-screen")
    return 0

