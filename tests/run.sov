main:
    ck_all()
    ck_arm_emu()
    ck_arm64()
    ck_ios()
    ck_x86ins()
    ck_emu_driver()
    ck_cprog()
    ck_fp()
    ck_windows_gui()
    ck_win_hang()
    ck_win_imports()
    ck_ww()
    ck_nodisp()
    ck_telegram()
    ck_wine()
    ck_editor()
    ck_examples()
    ck_targets()
    ck_exemac()
    ck_wincomp_emu()
    ck_selfhost()
    ck_alllibs()
    ck_nowarn()
    ck_longdouble()
    ck_fuzz()
    ck_crypto()
    write_out(num_text(cr_pass))
    write_out(" passed, ")
    write_out(num_text(cr_fail))
    write_out(" failed, ")
    write_out(num_text(cr_skipn))
    write_out(" skipped\n")
    if cr_fail is 0
        write_out("all checks passed\n")
        sys_exit(0)
    write_out("some checks failed\n")
    sys_exit(1)
