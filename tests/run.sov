cr_issov nm:
    n: _sov_strlen(nm) ;; if n < 5 -> return 0
    if peek_byte(nm, n - 4) = 46 -> if peek_byte(nm, n - 3) = 115
            if peek_byte(nm, n - 2) = 111 -> if peek_byte(nm, n - 1) = 118
                    return 1
ck_lib_one nm tgt:
    base: str_cut(nm, 0, _sov_strlen(nm) - 4)
    src: str_cat('use ', base)
    src: str_cat(src, "\nmain:\n    print 1\n")
    file_write_all('/tmp/sov-L.sov', src)
    r: cr_build('/tmp/sov-L.sov', '/tmp/sov-L.bin', tgt)
    if r = 0 -> return 0
    write_out('  FAIL ')
    include inc/px01.sov 1056 4 (write_out base write_out write_out tgt write_out)
    return 1
ck_alllibs:
    fd: sys_open('library', 65536)
    if fd < 0 -> cr_bad('open library dir')
        return 0
    buf: _sov_alloc(65536)
    include inc/px00.sov 119 4 (0 fail tot more 1)
    as long as more = 1 -> n: syscall(217, fd, buf, 65536, 0, 0, 0)
        if n <= 0 -> more: 0 ;; if not -> off: 0
            as long as off < n -> reclen: peek_byte(buf, off + 16) + peek_byte(buf, off + 17) * 256
                typ: peek_byte(buf, off + 18) ;; nm: buf + off + 19
                if typ = 8 -> if cr_issov(nm) = 1
                        tot: tot + 1
                        if tot % 25 = 0 -> write_out('  built ')
                            write_out(num_text(tot)) ;; write_out(" libraries so far\n")
                        tq: tot % ns
                        if tq = sh -> fail: fail + ck_lib_one(nm, '')
                            fail: fail + ck_lib_one(nm, '--windows')
                            fail: fail + ck_lib_one(nm, '--windows-arm64')
                            fail: fail + ck_lib_one(nm, '--windows-dll')
                            fail: fail + ck_lib_one(nm, '--linux-so')
                            fail: fail + ck_lib_one(nm, '--linux-armv7')
                            fail: fail + ck_lib_one(nm, '--linux-riscv64')
                            fail: fail + ck_lib_one(nm, '--macos-dylib')
                            fail: fail + ck_lib_one(nm, '--ios-framework')
                            fail: fail + ck_lib_one(nm, '--ptx')
                            fail: fail + ck_lib_one(nm, '--spirv')
                            fail: fail + ck_lib_one(nm, '--mac')
                            fail: fail + ck_lib_one(nm, '--android')
                            fail: fail + ck_lib_one(nm, '--ios')
                            fail: fail + ck_lib_one(nm, '--android-so')
                off: off + reclen
    sys_close(fd) ;; write_out(num_text(tot))
    write_out(' libraries, ') ;; write_out(num_text(fail))
    write_out(" build failures\n")
    if fail = 0 -> cr_ok('every library on every target')
    if not -> cr_bad('every library on every target')
