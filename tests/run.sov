# ---- the bot libraries, against a service we run ourselves ----
ck_telegram:
    r: cr_build("tests/tgsrv.sov", "/tmp/sov-tgsrv", "")
    if r is not 0
        cr_bad("could not build the telegram server")
        return 0
    a: _sov_alloc(16)
    poke_i64(a, 0, "/tmp/sov-tgsrv")
    poke_i64(a, 8, 0)
    cr_mode: 0
    cr_tout: 0
    cr_go("/tmp/sov-tgsrv", a, 0)
    srvpid: cr_lastpid
    ts: _sov_alloc(16)
    poke_i64(ts, 0, 0)
    poke_i64(ts, 8, 300000000)
    sys_nanosleep(ts)
    src: cr_line("", "use telegram")
    src: cr_line(src, "use num")
    src: cr_line(src, "use sys")
    src: cr_line(src, "main:")
    src: cr_line(src, "    t: tg_new(\"test:token\")")
    src: cr_line(src, "    tg_base(t, \"http://127.0.0.1:8877\")")
    src: cr_line(src, "    if str_eq(tg_me(t), \"sovren_test_bot\") is 0")
    src: cr_line(src, "        print \"bad-me\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    n: tg_poll(t)")
    src: cr_line(src, "    if n is not 1")
    src: cr_line(src, "        print \"bad-count\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    if str_eq(tg_text(t, 0), \"hello bot\") is 0")
    src: cr_line(src, "        print \"bad-text\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    if tg_chat(t, 0) is not 999")
    src: cr_line(src, "        print \"bad-chat\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    if tg_say(t, 999, \"hi back\") is not 1")
    src: cr_line(src, "        print \"bad-send\"")
    src: cr_line(src, "        stop")
    src: cr_line(src, "    print \"telegram-ok\"")
    file_write_all("/tmp/sov-tg.sov", src)
    r: cr_build("/tmp/sov-tg.sov", "/tmp/sov-tg", "")
    if r is 0
        cr_bin("/tmp/sov-tg", 30)
        if str_has(cr_out, "telegram-ok") is 1
            cr_ok("telegram-bot")
        if not
            cr_bad("telegram-bot")
    if not
        cr_bad("could not build the telegram check")
    proc_kill9(srvpid)
    return 0

# ---- Windows, under wine when it is there ----
ck_wine:
    wine: cr_which("wine")
    if wine is 0
        cr_skip("windows (apt install wine)")
        return 0
    envp: _sov_alloc(48)
    poke_i64(envp, 0, "WINEDEBUG=-all")
    poke_i64(envp, 8, "WINEPREFIX=/tmp/cr-wp")
    poke_i64(envp, 16, "PATH=/usr/bin:/bin")
    poke_i64(envp, 24, "HOME=/tmp")
    poke_i64(envp, 32, 0)
    mk: cr_which("mkdir")
    if mk is not 0
        a: _sov_alloc(16)
        poke_i64(a, 0, mk)
        poke_i64(a, 8, "-p")
        poke_i64(a, 16, "/tmp/cr-wp")
        poke_i64(a, 24, 0)
        cr_run(mk, a, 0, 30)
    src: cr_line("", "main:")
    src: cr_line(src, "    print 5 * 3 / 2")
    file_write_all("/tmp/sov-w1.sov", src)
    cr_build("/tmp/sov-w1.sov", "/tmp/sov-w1.exe", "--windows")
    cr_wine_run(wine, "/tmp/sov-w1.exe", envp)
    if str_eq(cr_trim(cr_out), "7") is 1
        cr_ok("windows-run")
    if not
        cr_bad("windows-run")
    src: cr_line("", "add a b:")
    src: cr_line(src, "    return a + b")
    src: cr_line(src, "")
    src: cr_line(src, "main:")
    src: cr_line(src, "    print add(40, 2)")
    file_write_all("/tmp/sov-w2.sov", src)
    cr_build("/tmp/sov-w2.sov", "/tmp/sov-w2.exe", "--windows")
    cr_wine_run(wine, "/tmp/sov-w2.exe", envp)
    if str_eq(cr_trim(cr_out), "42") is 1
        cr_ok("windows-job")
    if not
        cr_bad("windows-job")
    src: cr_line("", "use sha256")
    src: cr_line(src, "main:")
    src: cr_line(src, "    print sha256_hex(\"abc\")")
    file_write_all("/tmp/sov-w3.sov", src)
    cr_build("/tmp/sov-w3.sov", "/tmp/sov-w3.exe", "--windows")
    cr_wine_run(wine, "/tmp/sov-w3.exe", envp)
    if str_eq(cr_trim(cr_out), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") is 1
        cr_ok("windows-sha256")
    if not
        cr_bad("windows-sha256")
    # sovren.exe must build itself, byte for byte
    cr_build("compilers/windows/compiler.sov", "/tmp/sov-selfw.exe", "--windows")
    a: _sov_alloc(24)
    poke_i64(a, 0, "/tmp/sov-selfw.exe")
    poke_i64(a, 8, "compilers/windows/compiler.sov")
    poke_i64(a, 16, "-o")
    poke_i64(a, 24, "/tmp/sov-selfw2.exe")
    poke_i64(a, 32, 0)
    cr_run(wine, a, envp, 400)
    if file_exists("/tmp/sov-selfw2.exe") is 1
        if cr_same("/tmp/sov-selfw.exe", "/tmp/sov-selfw2.exe") is 1
            cr_ok("windows-self-host")
        if not
            cr_bad("windows-self-host")
    if not
        cr_bad("windows-self-host")
    return 0

cr_wine_run wine exe envp:
    a: _sov_alloc(16)
    poke_i64(a, 0, wine)
    poke_i64(a, 8, exe)
    poke_i64(a, 16, 0)
    cr_run(wine, a, envp, 120)
    return cr_rc

