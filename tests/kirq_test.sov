# unsafe-module
use kirq
bad m:
    print m
    badn: badn + 1
main:
    capacity: 256 ;; table: _sov_alloc(KIRQ_HEADER_SIZE + capacity * KIRQ_STRIDE)
    if kirq_init(table, capacity, 48, 223) != 1 -> bad('init')
    if kirq_init(table, capacity, 31, 223) != 0 -> bad('exception range')
    if kirq_reserve(table, capacity, 128, 1) != 1 -> bad('reserve syscall')
    if kirq_reserve(table, capacity, 128, 1) != 0 -> bad('double reserve')
    vector: kirq_allocate(table, capacity, 6, 11)
    if vector != 48 -> bad('first vector')
    generation: kirq_generation(table, capacity, vector)
    if generation < 1 -> bad('generation')
    if kirq_owner(table, capacity, vector) != 6 -> bad('owner')
    if kirq_source(table, capacity, vector) != 11 -> bad('source')
    if kirq_enter(table, capacity, vector, generation + 1, 6) != 0 -> bad('stale enter')
    if kirq_enter(table, capacity, vector, generation, 7) != 0 -> bad('wrong owner enter')
    if kirq_enter(table, capacity, vector, generation, 6) != 1 -> bad('enter')
    if kirq_count(table, capacity, vector) != 1 -> bad('count')
    if kirq_inflight(table, capacity, vector) != 1 -> bad('inflight')
    if kirq_mask(table, capacity, vector, generation, 6) != 1 -> bad('mask')
    if kirq_enter(table, capacity, vector, generation, 6) != 0 -> bad('masked enter')
    if kirq_release(table, capacity, vector, generation, 6) != 0 -> bad('busy release')
    if kirq_leave(table, capacity, vector, generation, 6) != 1 -> bad('leave')
    if kirq_leave(table, capacity, vector, generation, 6) != 0 -> bad('leave underflow')
    if kirq_unmask(table, capacity, vector, generation, 6) != 1 -> bad('unmask')
    if kirq_pending(table, capacity, vector) != 1 -> bad('pending')
    if kirq_release(table, capacity, vector, generation, 6) != 0 -> bad('pending release')
    if kirq_enter(table, capacity, vector, generation, 6) != 1 -> bad('second enter')
    if kirq_leave(table, capacity, vector, generation, 6) != 1 -> bad('second leave')
    if kirq_enter(table, capacity, vector, generation, 6) != 1 -> bad('third enter')
    if kirq_leave(table, capacity, vector, generation, 6) != 1 -> bad('third leave')
    if kirq_drain_pending(table, capacity, vector, generation, 6, 0) != 0 - 1 -> bad('invalid drain budget')
    if kirq_drain_pending(table, capacity, vector, generation + 1, 6, 2) != 0 -> bad('stale drain')
    if kirq_drain_pending(table, capacity, vector, generation, 6, 2) != 2 -> bad('bounded drain')
    if kirq_pending(table, capacity, vector) != 1 -> bad('drain remainder')
    if kirq_release(table, capacity, vector, generation, 6) != 0 -> bad('release with remainder')
    if kirq_drain_pending(table, capacity, vector, generation, 6, 16) != 1 -> bad('final drain')
    if kirq_release(table, capacity, vector, generation + 1, 6) != 0 -> bad('stale release')
    if kirq_release(table, capacity, vector, generation, 6) != 1 -> bad('release')
    if kirq_state(table, capacity, vector) != KIRQ_FREE -> bad('free state')
    reused: kirq_allocate(table, capacity, 5, 19)
    if reused != vector -> bad('reuse vector')
    if kirq_generation(table, capacity, reused) = generation -> bad('reuse generation')
    if kirq_active_count(table, capacity) != 1 -> bad('active count')
    claimed: kirq_claim(table, capacity, 54, 8, 14)
    if claimed != 54 -> bad('exact claim')
    if kirq_claim(table, capacity, 54, 9, 15) != 0 -> bad('double exact claim')
    claimed_generation: kirq_generation(table, capacity, claimed)
    if kirq_quiesce_release(table, capacity, claimed, claimed_generation, 9, 8, 8) != 0 -> bad('wrong owner quiesce')
    if kirq_enter(table, capacity, claimed, claimed_generation, 8) != 1 -> bad('quiesce enter')
    if kirq_quiesce_release(table, capacity, claimed, claimed_generation, 8, 8, 1) != 0 -> bad('inflight quiesce')
    if kirq_leave(table, capacity, claimed, claimed_generation, 8) != 1 -> bad('quiesce leave')
    if kirq_quiesce_release(table, capacity, claimed, claimed_generation, 8, 8, 8) != 1 -> bad('exact quiesce release')
    if kirq_active_count(table, capacity) != 1 -> bad('exact active count')
    print 'kirq OK'
