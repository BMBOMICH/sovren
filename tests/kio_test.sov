# unsafe-module
use kio
bad m:
    print m
    badn: badn + 1
main:
    _sov_alloc(KIO_REQ_STRIDE):
        include inc/px00.sov 6 4 (r1 r2 r3 r4)
        r5 ;; r6
        r7
    if kio_req_init(r1) != 1 -> bad('request init')
    if kio_req_init(r2) != 1 -> bad('request init 2')
    if kio_req_init(r3) != 1 -> bad('request init 3')
    if kio_req_init(r4) != 1 -> bad('request init 4')
    if kio_req_init(r5) != 1 -> bad('request init 5')
    if kio_req_init(r6) != 1 -> bad('request init 6')
    if kio_req_init(r7) != 1 -> bad('request init 7')
    if kio_req_set_retry_limit(r3, 1) != 1 -> bad('retry limit')
    if kio_req_prepare(r1, 0, 1, 4096, 512, 100) != 0 -> bad('zero owner accepted')
    if kio_req_prepare(r1, 7, 1, 0, 512, 100) != 0 -> bad('null transfer accepted')
    if kio_req_prepare(r1, 7, 1, 4096, 512, 100) != 1 -> bad('prepare')
    if kio_req_prepare(r2, 7, 2, 8192, 256, 0) != 1 -> bad('prepare 2')
    if kio_req_prepare(r3, 7, 3, 12288, 128, 50) != 1 -> bad('prepare 3')
    include inc/inc04.sov 1012 3
    if kio_queue_push(queue, r1) != 1 -> bad('queue push')
    if kio_queue_push(queue, r1) != 0 -> bad('duplicate queue')
    if kio_queue_push(queue, r2) != 1 -> bad('queue push 2')
    if kio_queue_push(queue, r3) != 0 -> bad('queue overflow')
    if kio_queue_remove(queue, r1) != 1 -> bad('queue remove')
    if kio_queue_count(queue) != 1 -> bad('queue remove count')
    if kio_queue_pop(queue) != r2 -> bad('queue pop')
    if kio_req_activate(r2, 8) != 0 -> bad('wrong-owner activation')
    if kio_req_activate(r2, 7) != 1 -> bad('activation')
    if kio_req_complete(r2, 7, 0, 257) != 0 -> bad('completion overflow')
    if kio_req_complete(r2, 7, 0, 256) != 1 -> bad('completion')
    if kio_req_state(r2) != KIO_REQ_DONE -> bad('completion state')
    if kio_req_cancel(r1, 8) != 0 -> bad('wrong-owner cancel')
    if kio_req_cancel(r1, 7) != 1 -> bad('cancel')
    if kio_req_status(r1) != 0 - 125 -> bad('cancel status')
    if kio_req_prepare(r4, 7, 4, 16384, 512, 0) != 1 -> bad('active cancel prepare')
    if kio_req_activate(r4, 7) != 1 -> bad('active cancel activate')
    if kio_req_cancel(r4, 7) != 1 -> bad('active cancel request')
    if kio_req_state(r4) != KIO_REQ_ACTIVE -> bad('active cancel retired early')
    if kio_req_cancel_pending(r4) != 1 -> bad('active cancel not pending')
    if kio_req_cancel_ack(r4, 8, 0) != 0 -> bad('wrong-owner cancel ack')
    if kio_req_cancel_ack(r4, 7, 128) != 1 -> bad('active cancel ack')
    if kio_req_state(r4) != KIO_REQ_CANCELLED -> bad('active cancel state')
    if kio_req_transferred(r4) != 128 -> bad('active cancel partial count')
    if kio_req_prepare(r5, 7, 5, 20480, 64, 0) != 1 -> bad('late cancel prepare')
    if kio_req_activate(r5, 7) != 1 -> bad('late cancel activate')
    if kio_req_cancel(r5, 7) != 1 -> bad('late cancel request')
    if kio_req_complete(r5, 7, 0, 64) != 1 -> bad('completion race winner')
    if kio_req_cancel_state(r5) != KIO_CANCEL_TOO_LATE -> bad('late cancel disposition')
    if kio_req_cancel_ack(r5, 7, 0) != 0 -> bad('late cancel acknowledged')
    if kio_req_prepare(r6, 7, 6, 24576, 512, 50) != 1 -> bad('active timeout prepare')
    if kio_req_activate(r6, 7) != 1 -> bad('active timeout activate')
    if kio_req_timeout(r6, 7, 49) != 0 -> bad('active early timeout')
    if kio_req_timeout(r6, 7, 50) != 1 -> bad('active timeout request')
    if kio_req_state(r6) != KIO_REQ_ACTIVE -> bad('active timeout retired early')
    if kio_req_timeout_pending(r6) != 1 -> bad('active timeout not pending')
    if kio_req_cancel(r6, 7) != 0 -> bad('timeout accepted cancel')
    if kio_req_timeout_ack(r6, 8, 0) != 0 -> bad('wrong-owner timeout ack')
    if kio_req_timeout_ack(r6, 7, 64) != 1 -> bad('active timeout ack')
    if kio_req_state(r6) != KIO_REQ_TIMED_OUT -> bad('active timeout state')
    if kio_req_transferred(r6) != 64 -> bad('active timeout partial count')
    if kio_req_prepare(r7, 7, 7, 28672, 64, 50) != 1 -> bad('late timeout prepare')
    if kio_req_activate(r7, 7) != 1 -> bad('late timeout activate')
    if kio_req_timeout(r7, 7, 50) != 1 -> bad('late timeout request')
    if kio_req_complete(r7, 7, 0, 64) != 1 -> bad('timeout completion race winner')
    if kio_req_timeout_state(r7) != KIO_TIMEOUT_TOO_LATE -> bad('late timeout disposition')
    if kio_req_timeout_ack(r7, 7, 0) != 0 -> bad('late timeout acknowledged')
    if kio_req_timeout(r3, 7, 49) != 0 -> bad('early timeout')
    if kio_req_timeout(r3, 7, 50) != 1 -> bad('timeout')
    if kio_req_status(r3) != 0 - 110 -> bad('timeout status')
    if kio_req_retry(r3, 7, 80) != 1 -> bad('retry')
    if kio_req_activate(r3, 7) != 1 -> bad('retry activate')
    if kio_req_complete(r3, 7, 0 - 5, 0) != 1 -> bad('failed completion')
    if kio_req_retry(r3, 7, 90) != 0 -> bad('retry budget')
    if kio_dma_valid(4096, 4096, 4096, 4096, 4294967295) != 1 -> bad('valid dma')
    if kio_dma_valid(4097, 4096, 4096, 0, 4294967295) != 0 -> bad('unaligned dma')
    if kio_dma_valid(61440, 8192, 4096, 65536, 4294967295) != 0 -> bad('cross-boundary dma')
    if kio_dma_valid(4294963200, 8192, 4096, 0, 4294967295) != 0 -> bad('dma overflow')
    limits: _sov_alloc(KIO_DMA_LIMITS_STRIDE) ;; mapping: _sov_alloc(KIO_DMA_MAP_STRIDE)
    if kio_dma_limits_init(limits, 3, 4096, 4294967295) != 0 -> bad('dma limits alignment')
    if kio_dma_limits_init(limits, 64, 4096, 4294967295) != 1 -> bad('dma limits')
    if kio_dma_map_init(mapping) != 1 -> bad('dma map init')
    map_generation: kio_dma_map_generation(mapping)
    if kio_dma_map(mapping, 7, 4096, 512, KIO_DMA_FROM_DEVICE, limits) != 1 -> bad('dma map')
    if kio_dma_device_address(mapping) != 4096 -> bad('identity dma device address')
    if kio_dma_map(mapping, 7, 8192, 512, KIO_DMA_FROM_DEVICE, limits) != 0 -> bad('double dma map')
    if kio_dma_device_begin(mapping, 8) != 0 -> bad('dma wrong owner begin')
    if kio_dma_device_begin(mapping, 7) != 1 -> bad('dma device begin')
    if kio_dma_map_init(mapping) != 0 -> bad('dma reinit while owned')
    if kio_dma_unmap(mapping, 7) != 0 -> bad('dma unmap while owned')
    if kio_dma_device_end(mapping, 7, 513) != 0 -> bad('dma transfer overflow')
    if kio_dma_device_end(mapping, 7, 128) != 1 -> bad('dma device end')
    if kio_dma_map_state(mapping) != KIO_DMA_COMPLETE -> bad('dma complete state')
    if kio_dma_map_transferred(mapping) != 128 -> bad('dma transferred')
    if kio_dma_unmap(mapping, 8) != 0 -> bad('dma wrong owner unmap')
    if kio_dma_unmap(mapping, 7) != 1 -> bad('dma unmap')
    if kio_dma_map_state(mapping) != KIO_DMA_FREE -> bad('dma free state')
    if kio_dma_map_address(mapping) != 0 -> bad('dma address clear')
    if kio_dma_device_address(mapping) != 0 -> bad('dma device address clear')
    if kio_dma_map_init(mapping) != 1 -> bad('dma map reinit')
    if kio_dma_map_generation(mapping) != map_generation + 1 -> bad('dma map generation')
    if kio_dma_map(mapping, 7, 8192, 256, KIO_DMA_BIDIRECTIONAL, limits) != 1 -> bad('persistent dma map')
    if kio_dma_device_reclaim(mapping, 7, 0) != 0 -> bad('dma reclaim before device')
    if kio_dma_device_begin(mapping, 7) != 1 -> bad('persistent dma begin')
    if kio_dma_device_reclaim(mapping, 8, 64) != 0 -> bad('dma reclaim wrong owner')
    if kio_dma_device_reclaim(mapping, 7, 257) != 0 -> bad('dma reclaim overflow')
    if kio_dma_device_reclaim(mapping, 7, 64) != 1 -> bad('dma reclaim')
    if kio_dma_map_state(mapping) != KIO_DMA_MAPPED -> bad('dma reclaim mapped state')
    if kio_dma_map_transferred(mapping) != 64 -> bad('dma reclaim transferred')
    if kio_dma_device_begin(mapping, 7) != 1 -> bad('persistent dma repeat begin')
    if kio_dma_device_reclaim(mapping, 7, 128) != 1 -> bad('persistent dma repeat reclaim')
    if kio_dma_unmap(mapping, 7) != 1 -> bad('persistent dma unmap')
    if kio_dma_map_init(mapping) != 1 -> bad('translated dma reinit')
    if kio_dma_map_pair(mapping, 7, 0, 4096, 64, KIO_DMA_TO_DEVICE, limits) != 0 -> bad('translated dma null cpu address')
    if kio_dma_map_pair(mapping, 7, KIO_MAX_I64 - 31, 4096, 64, KIO_DMA_TO_DEVICE, limits) != 0 -> bad('translated dma cpu overflow')
    if kio_dma_map_pair(mapping, 7, 16384, 4097, 64, KIO_DMA_TO_DEVICE, limits) != 0 -> bad('translated dma alignment')
    if kio_dma_map_pair(mapping, 7, 16384, 4096, 64, KIO_DMA_TO_DEVICE, limits) != 1 -> bad('translated dma map')
    if kio_dma_map_address(mapping) != 16384 -> bad('translated dma cpu address')
    if kio_dma_device_address(mapping) != 4096 -> bad('translated dma device address')
    if kio_dma_unmap(mapping, 7) != 1 -> bad('translated dma unmap')
    sg: _sov_alloc(KIO_SG_STRIDE) ;; sg_entries: _sov_alloc(KIO_SG_ENTRY_STRIDE * 2)
    if kio_sg_init(sg, sg_entries, 2) != 1 -> bad('sg init')
    if kio_sg_add(sg, 4096, 256, 64, 4096, 4294967295) != 1 -> bad('sg add')
    if kio_sg_add(sg, 8192, 256, 64, 4096, 4294967295) != 1 -> bad('sg add second')
    if kio_sg_add(sg, 12288, 1, 1, 0, 4294967295) != 0 -> bad('sg overflow')
    if kio_sg_count(sg) != 2 -> bad('sg count')
    if kio_sg_total(sg) != 512 -> bad('sg total')
    if kio_sg_address(sg, 1) != 8192 -> bad('sg address')
    if kio_sg_length(sg, 0) != 256 -> bad('sg length')
    if kio_sg_address(sg, 2) != 0 -> bad('sg bounds')
    ring: _sov_alloc(KIO_RING_STRIDE) ;; descriptors: _sov_alloc(32)
    if kio_ring_init(ring, descriptors, 2, 16) != 1 -> bad('ring init')
    if kio_ring_reserve(ring) != descriptors -> bad('ring reserve')
    if kio_ring_reserve(ring) != 0 -> bad('double reserve')
    include inc/px01.sov 1676 4 (kio_ring_commit commit kio_ring_reserve reserve kio_ring_commit commit kio_ring_reserve full)
    if kio_ring_consumer(ring) != descriptors -> bad('ring consumer')
    include inc/px01.sov 1676 4 (kio_ring_release release kio_ring_consumer consumer kio_ring_release release kio_ring_phase phase)
    if kio_ring_reserve(ring) != descriptors -> bad('ring wrap')
    if kio_ring_abort(ring) != 1 -> bad('ring abort')
    if kio_ring_count(ring) != 0 -> bad('ring abort count')
    ctl: _sov_alloc(KIO_CTL_STRIDE)
    if kio_ctl_init(ctl, 1) != 1 -> bad('controller init')
    epoch: kio_ctl_epoch(ctl)
    if kio_ctl_quiesce(ctl, 9) != 1 -> bad('quiesce')
    if kio_ctl_reset(ctl) != 1 -> bad('reset')
    if kio_ctl_recover(ctl) != 1 -> bad('recover')
    if kio_ctl_online(ctl) != 1 -> bad('online')
    if kio_ctl_epoch(ctl) != epoch + 1 -> bad('recovery epoch')
    if kio_ctl_reset(ctl) != 0 -> bad('reset budget')
    if kio_ctl_state(ctl) != KIO_CTL_FAILED -> bad('failed controller state')
    print 'kio OK'
