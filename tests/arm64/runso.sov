# runso.sov — run one exported name out of a Sovren shared library.
#
#   ./sovren tests/arm64/runso.sov -o /tmp/runso && /tmp/runso
#
# Reads /tmp/sov-so.so and runs the two names a Sovren .so gives out,
# so the checks can prove the exports really work.
#
# Standalone runner for arm64 shared-object tests.

use arm
use string

rs_one name:
    m: arm_new()
    if arm_load_so(m, "/tmp/sov-so.so") is 0
        print "cannot read /tmp/sov-so.so"
        return 0
    a: arm_symbol(m, name)
    if a is 0
        write_out("no such name: ")
        print as text name
        return 0
    arm_set_pc(m, a)
    arm_run(m)
    write_out(arm_out(m))
    return 1

main:
    rs_one("sovren_main")
    rs_one("Java_com_sovren_Native_run")
