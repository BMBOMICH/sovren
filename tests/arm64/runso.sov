include inc/px00.sov 234 4 (use arm string rs_one name)
    m: arm_new()
    if arm_load_so(m, '/tmp/sov-so.so') = 0 -> print 'cannot read /tmp/sov-so.so'
        return 0
    a: arm_symbol(m, name)
    if a = 0 -> write_out('no such name: ')
        print as text name ;; return 0
    arm_set_pc(m, a) ;; arm_run(m)
    write_out(arm_out(m)) ;; return 1
main:
    rs_one('sovren_main')
    rs_one('Java_com_sovren_Native_run')
