# test.sov — build programs for ARM and run them on the emulator.
#
#   ./sovren tests/arm64/test.sov -o /tmp/armtest && /tmp/armtest
#
# The emulator is library/arm.sov, so this checks the ARM back end
# end to end with nothing but Sovren.
#
# Standalone arm64 test driver.

use arm
use testrun
use file
use string
use num

at_pass: 0
at_fail: 0

# build for ARM, run on the emulator, compare
at_t name src want:
    file_write_all("/tmp/sov-at.sov", src)
    msg: tr_build_for("/tmp/sov-at.sov", "/tmp/sov-at.bin", "--android")
    if str_has(msg, "Error") is 1
        write_out("FAIL ")
        write_out(as text name)
        print "  it did not compile"
        at_fail: at_fail + 1
        return 0
    m: arm_new()
    if arm_load(m, "/tmp/sov-at.bin") is 0
        write_out("FAIL ")
        write_out(as text name)
        print "  could not read what was built"
        at_fail: at_fail + 1
        return 0
    why: arm_run(m)
    got: str_trim(arm_out(m))
    if str_eq(got, want) is 1
        write_out("ok   ")
        print as text name
        at_pass: at_pass + 1
        return 1
    write_out("FAIL ")
    write_out(as text name)
    write_out("  got [")
    write_out(got)
    write_out("]  want [")
    write_out(want)
    print "]"
    at_fail: at_fail + 1
    return 0

tr_use("./sovren")
print "building for ARM and running on the Sovren emulator"
print ""

at_t("a number", "main:\n    print 42\n", "42")
at_t("arithmetic", "main:\n    print 2 + 3 * 4\n    print 100 / 5\n    print 7 % 3\n", "14\n20\n1")
at_t("brackets", "main:\n    print (2 + 3) * 4\n", "20")
at_t("negative", "main:\n    print 0 - 42\n", "-42")
at_t("text", "main:\n    print \"hello arm\"\n", "hello arm")
at_t("a box", "main:\n    x: 10\n    x: x + 1\n    print x\n", "11")
at_t("if", "main:\n    if 3 > 2\n        print \"yes\"\n", "yes")
at_t("if not", "main:\n    if 1 > 2\n        print \"no\"\n    if not\n        print \"else\"\n", "else")
at_t("and", "main:\n    if 1 is 1 and 2 is 2\n        print \"both\"\n", "both")
at_t("a loop", "main:\n    i: 0\n    as long as i < 3\n        print i\n        i: i + 1\n", "0\n1\n2")
at_t("a job", "add a b:\n    return a + b\n\nmain:\n    print add(40, 2)\n", "42")
at_t("recursion", "fib n:\n    if n < 2\n        return n\n    return fib(n - 1) + fib(n - 2)\n\nmain:\n    print fib(20)\n", "6765")
at_t("seven values", "f a b c d e g h:\n    return a + b + c + d + e + g + h\n\nmain:\n    print f(1, 2, 3, 4, 5, 6, 7)\n", "28")
at_t("print times", "main:\n    print \"x\" 3 times\n", "x\nx\nx")
at_t("stop", "main:\n    print 1\n    stop\n    print 2\n", "1")
at_t("strings", "use string\nmain:\n    print str_len(\"abc\")\n", "3")
at_t("copying text", "use string\nmain:\n    print str_copy(\"hello\")\n", "hello")
at_t("a list", "use list\nmain:\n    l: list_new()\n    l: list_add(l, 7)\n    print list_get(l, 0)\n", "7")
at_t("sha256", "use sha256\nmain:\n    print sha256_hex(\"abc\")\n", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
at_t("sha1", "use sha1\nmain:\n    print sha1_hex(\"abc\")\n", "a9993e364706816aba3e25717850c26c9cd0d89d")

print ""
write_out(num_text(at_pass))
write_out(" passed, ")
write_out(num_text(at_fail))
print " failed"
if at_fail is 0
    print "the ARM back end is right"
    stop
print "the ARM back end has a problem"
