# run.sov — run an AArch64 program on this machine.
#
#   ./sovren tests/arm64/run.sov -o /tmp/armrun
#   /tmp/armrun
#
# The processor is emulated in Sovren, in library/arm.sov. Fully
# no external emulator. It reads the file named below; passing the name as an
# argument is not wired up yet, because `use arg` and `use arm`
# together make the run loop misbehave and that is not yet understood.

use arm

main:
    m: arm_new()
    if arm_load(m, "/tmp/sov-arm.bin") is 0
        print "cannot read /tmp/sov-arm.bin"
        stop
    why: arm_run(m)
    write_out(arm_out(m))
    if why is 2
        print ""
        write_out("stopped on an instruction this emulator does not know: ")
        print arm_bad(m)
        stop
    if why is 3
        print ""
        print "stopped: it ran too long"
        stop
