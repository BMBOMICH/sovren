
task test_integer_literals() {
    println("--- Integer Literals ---")

    set tokens = lexer_tokenize(lexer_new("42", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_INTEGER, "decimal token kind")
    assert(vectok_get(tokens, 0).int_val == 42, "decimal value 42")
    vectok_free(tokens)
    println("  Decimal literal 42: PASS")

    set tokens = lexer_tokenize(lexer_new("0", "test"))
    assert(vectok_get(tokens, 0).int_val == 0, "zero")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("99999", "test"))
    assert(vectok_get(tokens, 0).int_val == 99999, "large decimal")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("0xFF", "test"))
    assert(vectok_get(tokens, 0).int_val == 255, "hex 0xFF = 255")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("0x1A3F", "test"))
    assert(vectok_get(tokens, 0).int_val == 6719, "hex 0x1A3F = 6719")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("0x0", "test"))
    assert(vectok_get(tokens, 0).int_val == 0, "hex 0x0 = 0")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("0b1010", "test"))
    assert(vectok_get(tokens, 0).int_val == 10, "binary 0b1010 = 10")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("0b11111111", "test"))
    assert(vectok_get(tokens, 0).int_val == 255, "binary 0b11111111 = 255")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("0o777", "test"))
    assert(vectok_get(tokens, 0).int_val == 511, "octal 0o777 = 511")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("0o17", "test"))
    assert(vectok_get(tokens, 0).int_val == 15, "octal 0o17 = 15")
    vectok_free(tokens)

    println("  All integer literal formats: PASS")
}

task test_float_literals() {
    println("--- Float Literals ---")

    set tokens = lexer_tokenize(lexer_new("3.14", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_FLOAT, "float token kind")
    assert(vectok_get(tokens, 0).float_val > 3.1, "float value ~3.14")
    assert(vectok_get(tokens, 0).float_val < 3.2, "float value ~3.14")
    vectok_free(tokens)
    println("  Float 3.14: PASS")

    set tokens = lexer_tokenize(lexer_new(".5", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_FLOAT, ".5 is float")
    vectok_free(tokens)
    println("  Float .5: PASS")

    set tokens = lexer_tokenize(lexer_new("1e10", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_FLOAT, "1e10 is float")
    vectok_free(tokens)
    println("  Float 1e10: PASS")

    set tokens = lexer_tokenize(lexer_new("2.5e-3", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_FLOAT, "2.5e-3 is float")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("0.0", "test"))
    assert(vectok_get(tokens, 0).float_val == 0.0, "float 0.0")
    vectok_free(tokens)

    println("  All float literal formats: PASS")
}

task test_string_literals() {
    println("--- String Literals ---")

    set tokens = lexer_tokenize(lexer_new("\"hello\"", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_STRING, "string token kind")
    assert(str_eq(vectok_get(tokens, 0).str_val, "hello"), "string value hello")
    vectok_free(tokens)
    println("  String \"hello\": PASS")

    set tokens = lexer_tokenize(lexer_new("\"\"", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_STRING, "empty string kind")
    assert(str_eq(vectok_get(tokens, 0).str_val, ""), "empty string value")
    vectok_free(tokens)
    println("  Empty string \"\": PASS")

    set tokens = lexer_tokenize(lexer_new("\"escaped \\\"quote\\\" inside\"", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_STRING, "escaped string kind")
    assert(str_contains(vectok_get(tokens, 0).str_val, "quote"), "contains quote word")
    vectok_free(tokens)
    println("  String with escaped quotes: PASS")

    set tokens = lexer_tokenize(lexer_new("\"abc\\ndef\"", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_STRING, "newline escape string kind")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("\"tab\\tchar\"", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_STRING, "tab escape string kind")
    vectok_free(tokens)

    println("  All string literal formats: PASS")
}

task test_identifiers() {
    println("--- Identifiers ---")

    set tokens = lexer_tokenize(lexer_new("snake_case", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_IDENTIFIER, "snake_case is identifier")
    assert(str_eq(vectok_get(tokens, 0).str_val, "snake_case"), "snake_case value")
    vectok_free(tokens)
    println("  snake_case: PASS")

    set tokens = lexer_tokenize(lexer_new("camelCase", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_IDENTIFIER, "camelCase is identifier")
    assert(str_eq(vectok_get(tokens, 0).str_val, "camelCase"), "camelCase value")
    vectok_free(tokens)
    println("  camelCase: PASS")

    set tokens = lexer_tokenize(lexer_new("with_numbers_123", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_IDENTIFIER, "numbers in identifier")
    assert(str_eq(vectok_get(tokens, 0).str_val, "with_numbers_123"), "identifier value")
    vectok_free(tokens)
    println("  with_numbers_123: PASS")

    set tokens = lexer_tokenize(lexer_new("_underscore_start", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_IDENTIFIER, "underscore start")
    vectok_free(tokens)
    println("  _underscore_start: PASS")

    println("  All identifier formats: PASS")
}

task test_keywords() {
    println("--- Keywords ---")

    set tokens = lexer_tokenize(lexer_new("task set check loop return", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_TASK, "task keyword")
    assert(vectok_get(tokens, 1).kind == TOK_SET, "set keyword")
    assert(vectok_get(tokens, 2).kind == TOK_CHECK, "check keyword")
    assert(vectok_get(tokens, 3).kind == TOK_LOOP, "loop keyword")
    assert(vectok_get(tokens, 4).kind == TOK_RETURN, "return keyword")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("struct const enum import true false null", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_STRUCT, "struct keyword")
    assert(vectok_get(tokens, 1).kind == TOK_CONST, "const keyword")
    assert(vectok_get(tokens, 2).kind == TOK_ENUM, "enum keyword")
    assert(vectok_get(tokens, 3).kind == TOK_IMPORT, "import keyword")
    assert(vectok_get(tokens, 4).kind == TOK_TRUE, "true keyword")
    assert(vectok_get(tokens, 5).kind == TOK_FALSE, "false keyword")
    assert(vectok_get(tokens, 6).kind == TOK_NULL, "null keyword")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("inline extern sensitive async await override defer purge spawn", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_INLINE, "inline keyword")
    assert(vectok_get(tokens, 1).kind == TOK_EXTERN, "extern keyword")
    assert(vectok_get(tokens, 2).kind == TOK_SENSITIVE, "sensitive keyword")
    assert(vectok_get(tokens, 3).kind == TOK_ASYNC, "async keyword")
    assert(vectok_get(tokens, 4).kind == TOK_AWAIT, "await keyword")
    assert(vectok_get(tokens, 5).kind == TOK_OVERRIDE, "override keyword")
    assert(vectok_get(tokens, 6).kind == TOK_DEFER, "defer keyword")
    assert(vectok_get(tokens, 7).kind == TOK_PURGE, "purge keyword")
    assert(vectok_get(tokens, 8).kind == TOK_SPAWN, "spawn keyword")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("chan make_chan", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_CHAN, "chan keyword")
    assert(vectok_get(tokens, 1).kind == TOK_MAKE_CHAN, "make_chan keyword")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("sensitive constant_time purge", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_SENSITIVE, "sensitive keyword (2)")
    assert(vectok_get(tokens, 1).kind == TOK_CONSTANT_TIME, "constant_time keyword")
    assert(vectok_get(tokens, 2).kind == TOK_PURGE, "purge keyword (2)")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("assert", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_ASSERT, "assert keyword")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("break continue else from to times and or not", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_BREAK, "break keyword")
    assert(vectok_get(tokens, 1).kind == TOK_CONTINUE, "continue keyword")
    assert(vectok_get(tokens, 2).kind == TOK_ELSE, "else keyword")
    assert(vectok_get(tokens, 3).kind == TOK_FROM, "from keyword")
    assert(vectok_get(tokens, 4).kind == TOK_TO, "to keyword")
    assert(vectok_get(tokens, 5).kind == TOK_TIMES, "times keyword")
    assert(vectok_get(tokens, 6).kind == TOK_AND, "and keyword")
    assert(vectok_get(tokens, 7).kind == TOK_OR, "or keyword")
    assert(vectok_get(tokens, 8).kind == TOK_NOT, "not keyword")
    vectok_free(tokens)

    println("  All keywords: PASS")
}

task test_operators() {
    println("--- Operators ---")

    set tokens = lexer_tokenize(lexer_new("+ - * / %", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_PLUS, "+")
    assert(vectok_get(tokens, 1).kind == TOK_MINUS, "-")
    assert(vectok_get(tokens, 2).kind == TOK_STAR, "*")
    assert(vectok_get(tokens, 3).kind == TOK_SLASH, "/")
    assert(vectok_get(tokens, 4).kind == TOK_PERCENT, "%")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("== != < > <= >=", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_EQUAL, "==")
    assert(vectok_get(tokens, 1).kind == TOK_NOT_EQUAL, "!=")
    assert(vectok_get(tokens, 2).kind == TOK_LESS, "<")
    assert(vectok_get(tokens, 3).kind == TOK_GREATER, ">")
    assert(vectok_get(tokens, 4).kind == TOK_LESS_EQUAL, "<=")
    assert(vectok_get(tokens, 5).kind == TOK_GREATER_EQUAL, ">=")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("= += -= *= /=", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_ASSIGN, "=")
    assert(vectok_get(tokens, 1).kind == TOK_PLUS_ASSIGN, "+=")
    assert(vectok_get(tokens, 2).kind == TOK_MINUS_ASSIGN, "-=")
    assert(vectok_get(tokens, 3).kind == TOK_STAR_ASSIGN, "*=")
    assert(vectok_get(tokens, 4).kind == TOK_SLASH_ASSIGN, "/=")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("& | ^ ~ << >>", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_AMPERSAND, "&")
    assert(vectok_get(tokens, 1).kind == TOK_PIPE, "|")
    assert(vectok_get(tokens, 2).kind == TOK_CARET, "^")
    assert(vectok_get(tokens, 3).kind == TOK_TILDE, "~")
    assert(vectok_get(tokens, 4).kind == TOK_LSHIFT, "<<")
    assert(vectok_get(tokens, 5).kind == TOK_RSHIFT, ">>")
    vectok_free(tokens)

    set tokens = lexer_tokenize(lexer_new("( ) { } [ ] , . : ; -> => :: ? @ #", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_LPAREN, "(")
    assert(vectok_get(tokens, 1).kind == TOK_RPAREN, ")")
    assert(vectok_get(tokens, 2).kind == TOK_LBRACE, "{")
    assert(vectok_get(tokens, 3).kind == TOK_RBRACE, "}")
    assert(vectok_get(tokens, 4).kind == TOK_LBRACKET, "[")
    assert(vectok_get(tokens, 5).kind == TOK_RBRACKET, "]")
    assert(vectok_get(tokens, 6).kind == TOK_COMMA, ",")
    assert(vectok_get(tokens, 7).kind == TOK_DOT, ".")
    assert(vectok_get(tokens, 8).kind == TOK_COLON, ":")
    assert(vectok_get(tokens, 9).kind == TOK_SEMICOLON, ";")
    assert(vectok_get(tokens, 10).kind == TOK_ARROW, "->")
    assert(vectok_get(tokens, 11).kind == TOK_FAT_ARROW, "=>")
    assert(vectok_get(tokens, 12).kind == TOK_DOUBLE_COLON, "::")
    assert(vectok_get(tokens, 13).kind == TOK_QUESTION, "?")
    assert(vectok_get(tokens, 14).kind == TOK_AT, "@")
    assert(vectok_get(tokens, 15).kind == TOK_HASH, "#")
    vectok_free(tokens)

    println("  All operators: PASS")
}

task test_comments() {
    println("--- Comments ---")

    set tokens = lexer_tokenize(lexer_new("set x = 42
    assert(vectok_get(tokens, 0).kind == TOK_SET, "set before line comment")
    assert(vectok_get(tokens, 1).kind == TOK_IDENTIFIER, "identifier before line comment")
    assert(vectok_get(tokens, 2).kind == TOK_ASSIGN, "assign before line comment")
    assert(vectok_get(tokens, 3).kind == TOK_INTEGER, "integer before line comment")
    vectok_free(tokens)
    println("  Line comments: PASS")

    set tokens = lexer_tokenize(lexer_new("set x = 42 ", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_SET, "set before block comment")
    assert(vectok_get(tokens, 1).kind == TOK_IDENTIFIER, "identifier before block comment")
    assert(vectok_get(tokens, 2).kind == TOK_ASSIGN, "assign before block comment")
    assert(vectok_get(tokens, 3).kind == TOK_INTEGER, "integer before block comment")
    vectok_free(tokens)
    println("  Block comments: PASS")

    set tokens = lexer_tokenize(lexer_new("set x = 42  set y = 10", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_SET, "set before multi-line comment")
    assert(vectok_get(tokens, 1).kind == TOK_IDENTIFIER, "x before multi-line comment")
    assert(vectok_get(tokens, 2).kind == TOK_ASSIGN, "= before multi-line comment")
    assert(vectok_get(tokens, 3).kind == TOK_INTEGER, "42 before multi-line comment")
    assert(vectok_get(tokens, 4).kind == TOK_SET, "set after multi-line comment")
    vectok_free(tokens)
    println("  Multi-line block comments: PASS")

    println("  All comment formats: PASS")
}

task test_newlines_indentation() {
    println("--- Newlines and Indentation ---")

    set source = "set x = 1\nset y = 2\nset z = 3"
    set tokens = lexer_tokenize(lexer_new(source, "test"))
    assert(vectok_len(tokens) >= 12, "multiple lines tokenized")
    vectok_free(tokens)
    println("  Multi-line tokenization: PASS")

    set source = "check x > 0 {\n    set result = 1\n}"
    set tokens = lexer_tokenize(lexer_new(source, "test"))
    assert(vectok_get(tokens, 0).kind == TOK_CHECK, "check keyword preserved")
    assert(vectok_get(tokens, 4).kind == TOK_LBRACE, "open brace")
    vectok_free(tokens)
    println("  Indented block tokenization: PASS")

    println("  All newline/indentation tests: PASS")
}

task test_type_keywords() {
    println("--- Type Keywords ---")

    set tokens = lexer_tokenize(lexer_new("int8 int16 int64 uint8 uint16 uint32 uint64", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_INT8, "int8")
    assert(vectok_get(tokens, 1).kind == TOK_INT16, "int16")
    assert(vectok_get(tokens, 2).kind == TOK_INT64, "int64")
    assert(vectok_get(tokens, 3).kind == TOK_UINT8, "uint8")
    assert(vectok_get(tokens, 4).kind == TOK_UINT16, "uint16")
    assert(vectok_get(tokens, 5).kind == TOK_UINT32, "uint32")
    assert(vectok_get(tokens, 6).kind == TOK_UINT64, "uint64")
    vectok_free(tokens)

    println("  All type keywords: PASS")
}

task test_lexer_edge_cases() {
    println("--- Edge Cases ---")

    set tokens = lexer_tokenize(lexer_new("", "test"))
    assert(vectok_len(tokens) >= 1, "empty source produces at least EOF")
    vectok_free(tokens)
    println("  Empty source: PASS")

    set tokens = lexer_tokenize(lexer_new("   \n  \t  \n  ", "test"))
    assert(vectok_len(tokens) >= 1, "whitespace-only produces EOF")
    vectok_free(tokens)
    println("  Whitespace only: PASS")

    set tokens = lexer_tokenize(lexer_new("this_is_a_very_long_identifier_name_with_many_underscores_and_stuff", "test"))
    assert(vectok_get(tokens, 0).kind == TOK_IDENTIFIER, "long identifier kind")
    assert(str_len(vectok_get(tokens, 0).str_val) > 30, "long identifier length")
    vectok_free(tokens)
    println("  Very long identifier: PASS")

    set tokens = lexer_tokenize(lexer_new("a+b-c*d/e==f", "test"))
    assert(vectok_len(tokens) >= 11, "mixed operators tokenized")
    vectok_free(tokens)
    println("  Mixed operators without spaces: PASS")

    println("  All edge cases: PASS")
}

