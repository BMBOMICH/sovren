v: cv_len(fx_from(1), "m", "mm")
chk("1m in mm", v, 1000000000)
v: cv_len(fx_from(1), "km", "m")
chk("1km in m", v, 1000000000)
v: cv_len(fx_from(250), "cm", "m")
chk("250cm in m", v, 2500000)

