# ---- map ----
mm: map_new()
mm: map_set(mm, "k1", 10)
mm: map_set(mm, "k2", 20)
mm: map_del(mm, "k1")
chk("map len", map_len(mm), 1)
chk("map get", map_get(mm, "k2"), 20)
chk("map has gone", map_has(mm, "k1"), 0)
mm: map_set(mm, "k3", 30)
ks: map_keys(mm)
chk("map keys", list_len(ks), 2)

# ---- url ----
