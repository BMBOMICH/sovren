chk_s("url noport", url_port("http://h/x"), "")
chk_s("url query", url_query("http://h/x?a=1"), "a=1")
chk_s("url noquery", url_query("http://h/x"), "")

# ---- shell ----
so: shell_out("echo hi there")
chk("shell out", str_has(so, "hi there"), 1)

# ---- the arena ----
arn_begin()
m0: arn_used()
i: 0
as long as i < 100
    q: str_cat("xy", "zw")
    i: i + 1
m1: arn_used()
chk("arena grew", m1 > m0, 1)
arn_end()
m2: arn_used()
chk("arena reclaimed", m2, m0)
arn_begin()
arn_begin()
arn_end()
chk("arena depth", arn_depth(), 1)
arn_end()
chk("arena depth 0", arn_depth(), 0)

# ---- the sequencer ----
t: seq_new(3)
poke_i64(t, 0, seq_note(1000000, 400000))
poke_i64(t, 8, seq_note(500000, 200000))
poke_i64(t, 16, seq_note(2000000, 400000))
p: aud_new(1000000)
seq_play(p, t, 3, 1, 1000000)
chk("seq n1 s0", samp(p, 0), 32767)
chk("seq n1 s8820", samp(p, 8820), 32767)
chk("seq n1 s11047", samp(p, 11047), 32769)
chk("seq n2 s17640", samp(p, 17640), 32767)
chk("seq n2 s19889", samp(p, 19889), 32769)
chk("seq n3 s26460", samp(p, 26460), 32767)
chk("seq n3 s28676", samp(p, 28676), 32769)
chk("seq end s35280", samp(p, 35280), 32767)

