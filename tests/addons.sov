# the rebuilt add-on libraries, checked against known answers
use arena
use audio
use calc
use csv
use escape
use fill
use map
use shell
use sort
use url
use seq
use site
use fixed
use frac
use roman
use convert
use encrypt
use trig
use file
use num
use string
use sys

fail: 0

chk name got want:
    if got is want
        write_out("ok ")
        print as text name
        write_out("\n")
    if not
        write_out("FAIL ")
        print as text name
        write_out(" got ")
        print num_text(got)
        write_out(" want ")
        print num_text(want)
        write_out("\n")
        fail: fail + 1
    return 0

# one raw sixteen-bit sample out of a buffer
samp p s:
    return peek_byte(p, s * 2) + peek_byte(p, s * 2 + 1) * 256

chk_s name got want:
    if str_eq(got, want) is 1
        write_out("ok ")
        print as text name
        write_out("\n")
    if not
        write_out("FAIL ")
        print as text name
        write_out(" got ")
        print as text got
        write_out(" want ")
        print as text want
        write_out("\n")
        fail: fail + 1
    return 0

# ---- calc ----
v: calc_eval("2 + 3 * 4")
chk("calc 2+3*4", v, 14000000)
v: calc_eval("(2 + 3) * 4")
chk("calc (2+3)*4", v, 20000000)
v: calc_eval("7 / 2")
chk("calc 7/2", v, 3500000)
v: calc_eval("sqrt(16)")
chk("calc sqrt(16)", v, 4000000)
v: calc_eval("10 - 3")
chk("calc 10-3", v, 7000000)
v: calc_eval("2.5 * 2")
chk("calc 2.5*2", v, 5000000)
v: calc_eval("-3 + 5")
chk("calc -3+5", v, 2000000)
v: calc_eval("1.5 + 0.25")
chk("calc 1.5+0.25", v, 1750000)
v: calc_eval("sin(pi / 2)")
chk("calc sin(pi/2)", v, 1000000)
v: calc_eval("1 +")
chk("calc bad ok", calc_ok(), 0)
v: calc_eval("2 + 2")
chk("calc ok again", calc_ok(), 1)
v: calc_eval("sqrt(2)")
chk("calc sqrt(2)", v, 1414213)

# ---- trig ----
chk("sin(pi/2)", tri_sin(TR_PI2), 1000000)
chk("cos(0)", tri_cos(0), 1000000)
chk("sin(0)", tri_sin(0), 0)
chk("cos(pi/2)", tri_cos(TR_PI2), 0)
chk("sin(pi)", tri_sin(TR_PI), 0)
chk("cos(pi)", tri_cos(TR_PI), 0 - 1000000)
chk("sin(pi/6)", tri_sin(523599), 500000)
chk("sin(-pi/2)", tri_sin(0 - TR_PI2), 0 - 1000000)
chk("atan(1)", tri_atan(1000000), 785398)
chk("atan(0)", tri_atan(0), 0)
chk("atan(0.5)", tri_atan(500000), 463648)
chk("atan(-1)", tri_atan(0 - 1000000), 0 - 785398)
chk("atan(2)", tri_atan(2000000), 1107148)

# ---- frac ----
a: frac_make(1, 2)
b: frac_make(1, 3)
chk_s("frac 1/2+1/3", frac_text(frac_add(a, b)), "5/6")
chk_s("frac 8/12", frac_text(frac_make(8, 12)), "2/3")
chk_s("frac 1/2-1/3", frac_text(frac_sub(a, b)), "1/6")
chk_s("frac 1/2*2/3", frac_text(frac_mul(a, frac_make(2, 3))), "1/3")
chk_s("frac 1/2/1/4", frac_text(frac_div(a, frac_make(1, 4))), "2/1")

# ---- roman ----
chk_s("roman 2024", rom_to(2024), "MMXXIV")
chk("roman 14", rom_from("XIV"), 14)
chk_s("roman 1999", rom_to(1999), "MCMXCIX")
chk_s("roman 3888", rom_to(3888), "MMMDCCCLXXXVIII")
chk("roman back", rom_from(rom_to(2024)), 2024)
chk("roman 9", rom_from("IX"), 9)
chk_s("roman 0", rom_to(0), "")

# ---- convert ----
v: cv_temp(fx_from(0), "c", "f")
