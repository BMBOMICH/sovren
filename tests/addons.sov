# ---- encrypt: xor round trip ----
c: encrypt_xor("Attack at dawn", "swordfish")
p: decrypt_xor(c, "swordfish")
chk_s("xor roundtrip", p, "Attack at dawn")
chk("xor changes it", str_eq(c, "Attack at dawn"), 0)
chk("xor wrong key", str_eq(decrypt_xor(c, "nope"), "Attack at dawn"), 0)

# ---- the page writer ----
page("T")
heading(1, "Hi")
paragraph("body")
bullets("a|b|c")
input("name")
rule()
save("/tmp/sov-page.html")
pg: file_read_all("/tmp/sov-page.html")
chk("page has h1", str_has(pg, "<h1>Hi</h1>"), 1)
chk("page has p", str_has(pg, "<p>body</p>"), 1)
chk("page has li", str_has(pg, "<li>a</li>"), 1)
chk("page has li3", str_has(pg, "<li>c</li>"), 1)
chk("page has input", str_has(pg, "<input placeholder=\"name\">"), 1)
chk("page has hr", str_has(pg, "<hr>"), 1)
chk("page closes", str_has(pg, "</html>"), 1)

