# unsafe-module
# Exact instrumentation oracle: all 16 alignments and lengths 0..130.
prof_mode: 1
prof_counter_active: 0
prof_bytes_scanned: 0
prof_bytes_copied: 0
prof_allocations: 0
prof_alloc_bytes: 0
prof_hash_probes: 0
prof_fallbacks: 0
main:
    s: _sov_alloc(288)
    offset: 0
    bad: 0
    cases: 0
    as long as offset < 16
        n: 0
        as long as n < 131
            i: 0
            as long as i < 288
                poke_byte(s, i, 65)
                i: i + 1
            ptr: s + offset
            poke_byte(ptr, n, 0)
            before: prof_bytes_scanned
            got: _sov_strlen(ptr)
            scanned: prof_bytes_scanned - before
            expected: ((ptr % 8 + n) / 8 + 1) * 8
            if got is not n
                bad: bad + 1
            if scanned is not expected
                bad: bad + 1
            cases: cases + 1
            n: n + 1
        offset: offset + 1
    d: _sov_alloc(32)
    dummy: _sov_memcpy(d, s, 7)
    prof_mode: 0
    print bad
    print cases
    print prof_counter_active
    print prof_allocations
    print prof_alloc_bytes
    print prof_bytes_copied
