# tests/windows-run.sov — run a Windows .exe here, strictly. In Sovren.
#
# This replaces the old run_pe.py. A compatibility layer is not a fair test for Sovren: it
# runs on Linux, so a raw `syscall` instruction inside the program
# falls straight through to the Linux kernel and appears to work. On
# real Windows there is no Linux kernel underneath and the program
# dies quietly. That is the bug this catches.
#
# The emulator plays the part of Windows: it answers the kernel32
# calls the program imports, and it REFUSES a raw syscall, which is
# exactly what a real machine does.
#
#   ./sovren tests/windows-run.sov -o run
#   ./run app.exe
#
# It exits with the code the program exited with, or 3 when the
# program was rejected for using a raw syscall.

use x86
use arg
use string
use num
use sys

# a line on the error channel
say_err s:
    write_err(s)
    write_err("\n")
    return 0

main:
    p: arg_at(1)
    if str_len(p) is 0
        print "Usage: run <app.exe> [arguments]"
        print "Runs a Windows program here, on an emulated processor."
        sys_exit(1)

    m: x86_new()
    if x86_load(m, p) is 0
        write_out("cannot read ")
        print p
        sys_exit(2)
    if peek_i64(m, 240) is not 1
        print "that is not a Windows program"
        sys_exit(2)

    # hand the program its command line, the way Windows does
    cl: p
    i: 2
    as long as str_len(arg_at(i)) > 0
        cl: str_cat(cl, " ")
        cl: str_cat(cl, arg_at(i))
        i: i + 1
    x_set_cmdline(m, cl)

    x86_run(m)
    write_out(x86_out(m))
    write_err(x86_err(m))

    why: x86_why(m)
    if why is 4
        say_err("")
        say_err("REJECTED: the program used a raw syscall instruction.")
        say_err("Windows has no Linux kernel behind it, so this does")
        say_err("nothing on a real machine. A compatibility layer hides it; this does not.")
        sys_exit(3)
    if why is 2
        write_err("cpu: an instruction it does not know, ")
        say_err(num_text(x86_bad(m)))
        sys_exit(4)
    if why is 5
        say_err("cpu: it divided by nothing")
        sys_exit(4)
    if why is 6
        write_err("cpu: it reached outside its own memory, at ")
        say_err(num_text(x86_bad(m)))
        sys_exit(4)
    if why is 3
        say_err("cpu: it ran too long and was stopped")
        sys_exit(4)
    sys_exit(x86_code(m))
