# all.sov — the whole battery, every check, every tier.
#
#   ./sovren tests/all.sov -o /tmp/battery && /tmp/battery
#
# The checks themselves live in library/suite.sov, as suite(), so that
# tests/fast.sov can run the same suite with the slow tier switched
# off. One list of checks, two ways to run it.

use suite

main:
    tr_use("./sovren")
    sys_exit(suite())
