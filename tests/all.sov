    gsrc: str_cat("secret_keeper a:\n    x: a * 3\n    y: a + 1\n    z: x + y\n", "    w: z * 2\n    v: w + 5\n    u: v - a\n    t: u * u\n    private\n    return t\n")
    gsrc: str_cat(gsrc, "main:\n    print secret_keeper(7)\n")
