    file_write_all("/tmp/sov-gw.sov", "g: 0\nmain:\n    private\n    g: 12345679 * 66339001\n    print g\n")
    tr_build_for("/tmp/sov-gw.sov", "/tmp/sov-gw.out", "")
    gm: x86_new()
    if x86_load(gm, "/tmp/sov-gw.out") is 1
        x86_run(gm)
        gw_ok: 1
        if x86_why(gm) is not 1
            gw_ok: 0
        if str_eq(str_trim(x86_out(gm)), "819000011526679") is 0
            gw_ok: 0
        lo: peek_i64(gm, 216)
        gw_off: 0
        as long as gw_off < 65536
            if x86_peek_q(gm, lo + gw_off) is 819000011526679
                gw_ok: 0
            gw_off: gw_off + 8
        if gw_ok is 1
            tr_ok("globals wiped at exit")
        if not
            tr_bad("globals wiped at exit", "the canary survived", "nothing")

