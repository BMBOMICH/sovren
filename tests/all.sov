            if x86_peek_q(gww, low + gw_off) is 819000011526679
                gww_ok: 0
            gw_off: gw_off + 8
        if gww_ok is 1
            tr_ok("globals wiped at exit on windows")
        if not
            tr_bad("globals wiped at exit on windows", "the canary survived", "nothing")

    # pass 137: string literals wiped at exit - print a distinctive
    # constant, then scan the image for its first eight bytes
    st_src: "main:\n    private\n    s: \"SVNSNTPRIV\"\n    print s\n"
    file_write_all("/tmp/sov-st.sov", st_src)
    tr_build_for("/tmp/sov-st.sov", "/tmp/sov-st.out", "")
    stm: x86_new()
    if x86_load(stm, "/tmp/sov-st.out") is 1
        x86_run(stm)
        st_ok: 1
        if x86_why(stm) is not 1
            st_ok: 0
        if str_eq(str_trim(x86_out(stm)), "SVNSNTPRIV") is 0
            st_ok: 0
        lost: 5931333404628768339
        lo2: peek_i64(stm, 216)
        st_off: 0
        as long as st_off < 65536
            if x86_peek_q(stm, lo2 + st_off) is lost
                st_ok: 0
            st_off: st_off + 1
        if st_ok is 1
            tr_ok("string literals wiped at exit")
        if not
            tr_bad("string literals wiped at exit", "the canary string survived", "nothing")
    file_write_all("/tmp/sov-stm.sov", st_src)
    tr_build_for("/tmp/sov-stm.sov", "/tmp/sov-stm.out", "--mac")
    stm2: x86_new()
    if x86_load(stm2, "/tmp/sov-stm.out") is 1
        x86_run(stm2)
        stm_ok: 1
        if x86_why(stm2) is not 1
            stm_ok: 0
        if str_eq(str_trim(x86_out(stm2)), "SVNSNTPRIV") is 0
            stm_ok: 0
        lom2: peek_i64(stm2, 216)
        st_off: 0
        as long as st_off < 65536
            if x86_peek_q(stm2, lom2 + st_off) is 5931333404628768339
                stm_ok: 0
            st_off: st_off + 1
        if stm_ok is 1
            tr_ok("string literals wiped at exit on mac")
        if not
            tr_bad("string literals wiped at exit on mac", "the canary string survived", "nothing")
    file_write_all("/tmp/sov-stw.sov", st_src)
    tr_build_for("/tmp/sov-stw.sov", "/tmp/sov-stw.out", "--windows")
    stw: x86_new()
    if x86_load(stw, "/tmp/sov-stw.out") is 1
        x86_run(stw)
        stw_ok: 1
        if x86_why(stw) is not 1
            stw_ok: 0
        if str_eq(str_trim(x86_out(stw)), "SVNSNTPRIV") is 0
            stw_ok: 0
        low2: peek_i64(stw, 216)
        st_off: 0
        as long as st_off < 65536
            if x86_peek_q(stw, low2 + st_off) is 5931333404628768339
                stw_ok: 0
            st_off: st_off + 1
        if stw_ok is 1
            tr_ok("string literals wiped at exit on windows")
        if not
            tr_bad("string literals wiped at exit on windows", "the canary string survived", "nothing")

    # the control: the same guest without private keeps its literal
    file_write_all("/tmp/sov-stc.sov", "main:\n    s: \"SVNSNTPRIV\"\n    print s\n")
    tr_build_for("/tmp/sov-stc.sov", "/tmp/sov-stc.out", "")
    stc: x86_new()
    if x86_load(stc, "/tmp/sov-stc.out") is 1
        x86_run(stc)
        if str_eq(str_trim(x86_out(stc)), "SVNSNTPRIV") is 1
            loc3: peek_i64(stc, 216)
            found3: 0
            c_off: 0
            as long as c_off < 65536
                if x86_peek_q(stc, loc3 + c_off) is 5931333404628768339
                    found3: 1
                c_off: c_off + 1
            if found3 is 1
                tr_ok("string canary control: the scanner sees unwiped literals")
            if not
                tr_bad("string canary control", "scanner found nothing", "the literal visible")

    # pass 138: the up-walk signature must be present in every
    # private build - mov edx,3 before the mprotect number on linux
    # and mac, two VirtualQuery state checks on windows, the
    # and-x0/add-2048 chain on arm
    up_src: "main:\n    private\n    s: \"UPWALKCAN\"\n    print s\n"
    file_write_all("/tmp/sov-up.sov", up_src)
    tr_build_for("/tmp/sov-up.sov", "/tmp/sov-up.l", "")
    if count_run("/tmp/sov-up.l", 3, 0, 0, 0, 184, 10) > 0
        tr_ok("up-walk signature in linux builds")
    if not
        tr_bad("up-walk signature in linux builds", "the mprotect probe is gone", "the probe")
    tr_build_for("/tmp/sov-up.sov", "/tmp/sov-up.m", "--mac")
    if count_run("/tmp/sov-up.m", 3, 0, 0, 0, 184, 74) > 0
        tr_ok("up-walk signature in mac builds")
    if not
        tr_bad("up-walk signature in mac builds", "the mprotect probe is gone", "the probe")
    tr_build_for("/tmp/sov-up.sov", "/tmp/sov-up.w", "--windows")
    if count_run("/tmp/sov-up.w", 72, 129, 199, 0, 16, 0) > 0
        tr_ok("up-walk signature in windows builds")
    if not
        tr_bad("up-walk signature in windows builds", "the add rdi,4096 probe start is gone", "the step-up")
    tr_build_for("/tmp/sov-up.sov", "/tmp/sov-up.a", "--android")
    if count_run("/tmp/sov-up.a", 160, 0, 10, 138, 0, 0) > 0
        tr_ok("up-walk signature in android builds")
    if not
        tr_bad("up-walk signature in android builds", "the mprotect chain is gone", "the chain")
    tr_build_for("/tmp/sov-up.sov", "/tmp/sov-up.i", "--ios")
    if count_run("/tmp/sov-up.i", 160, 0, 10, 138, 0, 0) > 0
        tr_ok("up-walk signature in ios builds")
    if not
        tr_bad("up-walk signature in ios builds", "the mprotect chain is gone", "the chain")
    # and the same signature when main is thin - no locals, no
    # frame: the exit path must still carry the walks
    thin_src: "main:\n    private\n    print \"T\"\n"
    file_write_all("/tmp/sov-tup.sov", thin_src)
    tr_build_for("/tmp/sov-tup.sov", "/tmp/sov-tup.l", "")
    if count_run("/tmp/sov-tup.l", 3, 0, 0, 0, 184, 10) > 0
        tr_ok("up-walk signature in thin private builds")
    if not
        tr_bad("up-walk signature in thin private builds", "the thin path dropped the walk", "the walk")
    tr_build_for("/tmp/sov-tup.sov", "/tmp/sov-tup.m", "--mac")
    if count_run("/tmp/sov-tup.m", 3, 0, 0, 0, 184, 74) > 0
        tr_ok("up-walk signature in thin private mac builds")
    if not
        tr_bad("up-walk signature in thin private mac builds", "the thin path dropped the walk", "the walk")
    tr_build_for("/tmp/sov-tup.sov", "/tmp/sov-tup.a", "--android")
    if count_run("/tmp/sov-tup.a", 160, 0, 10, 138, 0, 0) > 0
        tr_ok("up-walk signature in thin private android builds")
    if not
        tr_bad("up-walk signature in thin private android builds", "the thin path dropped the walk", "the walk")

    # pass 139: the heap wiped at exit. a string copy lands in the
    # bump heap; after a private program exits, its bytes must be
    # gone from there - and a control guest without private must
    # still show them to the scanner
    hps: "use string\nmain:\n    private\n    s: str_copy(\"HEAPCANARY0123456789\")\n    print s\n    _sov_print_int(s)\n"
    file_write_all("/tmp/sov-hp.sov", hps)
    tr_build_for("/tmp/sov-hp.sov", "/tmp/sov-hp.out", "")
    hpm: x86_new()
    if x86_load(hpm, "/tmp/sov-hp.out") is 1
        x86_run(hpm)
        hp_ok: 1
        if x86_why(hpm) is not 1
            hp_ok: 0
        ho: x86_out(hpm)
        hn: 0
        as long as _sov_byte_at(ho, hn) is not 10
            hn: hn + 1
        if str_eq(str_cut(ho, 0, hn), "HEAPCANARY0123456789") is 0
            hp_ok: 0
        hb: str_num(str_trim(str_cut(ho, hn + 1, str_len(ho))))
        h_off: 0
        as long as h_off < 65536
            if x86_peek_q(hpm, hb + h_off) is 4705770418013816136
                hp_ok: 0
            h_off: h_off + 1
        if hp_ok is 1
            tr_ok("heap wiped at exit")
        if not
            tr_bad("heap wiped at exit", "the heap canary survived", "nothing")
    hps2: "use string\nmain:\n    s: str_copy(\"HEAPCANARY0123456789\")\n    print s\n    _sov_print_int(s)\n"
    file_write_all("/tmp/sov-hp2.sov", hps2)
    tr_build_for("/tmp/sov-hp2.sov", "/tmp/sov-hp2.out", "")
    hpm2: x86_new()
    if x86_load(hpm2, "/tmp/sov-hp2.out") is 1
        x86_run(hpm2)
        ho2: x86_out(hpm2)
        hn2: 0
        as long as _sov_byte_at(ho2, hn2) is not 10
            hn2: hn2 + 1
        hb2: str_num(str_trim(str_cut(ho2, hn2 + 1, str_len(ho2))))
        hfound: 0
        h_off: 0
        as long as h_off < 65536
            if x86_peek_q(hpm2, hb2 + h_off) is 4705770418013816136
                hfound: 1
            h_off: h_off + 1
        if hfound is 1
            tr_ok("heap canary control: the scanner sees unwiped heaps")
        if not
            tr_bad("heap canary control", "scanner found nothing", "the literal visible")

    # pass 140: a private program's binary carries its secrets in
    # its string span - it lands 0700; a plain build stays 0755
    tr_build_for("/tmp/sov-up.sov", "/tmp/sov-up.l", "")
    if file_mode("/tmp/sov-up.l") is 448
        tr_ok("private builds land 0700")
    if not
        tr_bad("private builds land 0700", "wrong mode on the private binary", "0700")
    file_write_all("/tmp/sov-pm.sov", "main:\n    print \"p\"\n")
    tr_build_for("/tmp/sov-pm.sov", "/tmp/sov-pm.out", "")
    if file_mode("/tmp/sov-pm.out") is 493
        tr_ok("plain builds stay 0755")
    if not
        tr_bad("plain builds stay 0755", "wrong mode on the plain binary", "0755")

    tr_privacy_checks()
    tr_strict_checks()

    # the tally, and an exit code so a script can tell
    sys_exit(tr_report())
