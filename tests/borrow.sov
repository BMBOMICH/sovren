// ============================================================================
// Sovereign Borrow Checker Test Suite
// ============================================================================
// These tests verify ownership, move semantics, and borrow checking.
// Some tests are designed to FAIL compilation (marked with @reject).
// Run: sovereign check tests/test_borrow_checker.sov

// ── Copy Types — Should all work fine ─────────────────────────────────────

test task test_copy_int() {
    set x = 42
    set y = x      // Copy type — x is still valid
    set z = x + y  // Both x and y valid
    assert(z == 84, "Copy types can be used after assignment")
}

test task test_copy_float() {
    set x = 3.14
    set y = x
    assert(y == 3.14, "Float is Copy")
}

test task test_copy_bool() {
    set a = true
    set b = a
    assert(b == true, "Bool is Copy")
}

test task test_copy_multiple_use() {
    set x = 10
    set a = x
    set b = x
    set c = x
    assert(a + b + c == 30, "Copy types can be used multiple times")
}

// ── Move Types — Ownership transfer ───────────────────────────────────────

test task test_string_move() {
    set s1 = "hello"
    set s2 = s1      // Move — s1 is now invalid
    // s1 cannot be used after this point
    assert(str_eq(s2, "hello"), "String move transfers ownership")
}

test task test_struct_move() {
    struct Data { value: int }
    set d1 = Data { value: 42 }
    set d2 = d1      // Move — d1 is invalid
    assert(d2.value == 42, "Struct move transfers ownership")
}

test task test_move_to_function() {
    struct Token { kind: int, text: string }
    
    task consume_token(t: Token) {
        assert(t.kind == 1, "Token kind preserved after move")
    }
    
    set tok = Token { kind: 1, text: "hello" }
    consume_token(tok)  // tok is moved into function
    // tok cannot be used after this
}

// ── Borrowing — Immutable ─────────────────────────────────────────────────

test task test_immutable_borrow() {
    set data = [1, 2, 3, 4, 5]
    set ref1 = &data
    set ref2 = &data    // Multiple immutable borrows OK
    assert(ref1[0] == 1, "Immutable borrow access")
    assert(ref2[4] == 5, "Multiple immutable borrows")
}

test task test_borrow_in_expression() {
    set x = 10
    set y = 20
    // &x and &y are temporary immutable borrows
    assert(x + y == 30, "Expression with borrows")
}

// ── Sensitive Data ────────────────────────────────────────────────────────

test task test_sensitive_auto_zero() {
    sensitive set secret = 42
    assert(secret == 42, "Sensitive variable readable")
    // secret will be auto-zeroed at scope exit
}

test task test_sensitive_string() {
    sensitive set password = "super_secret_123"
    assert(str_len(password) > 0, "Sensitive string readable")
    // password will be auto-zeroed at scope exit
}

test task test_sensitive_struct() {
    struct Credentials { username: string, password: string }
    
    sensitive set creds = Credentials { 
        username: "admin", 
        password: "p@ssw0rd" 
    }
    assert(str_eq(creds.username, "admin"), "Sensitive struct readable")
}

// ── Purge — Explicit memory wiping ────────────────────────────────────────

test task test_purge_variable() {
    set key = 0xDEADBEEF
    assert(key == 0xDEADBEEF, "Key before purge")
    purge key
    assert(key == 0, "Key after purge is zero")
}

// ── Constant-Time Blocks ─────────────────────────────────────────────────

test task test_constant_time_block() {
    set a = 42
    set b = 42
    
    constant_time {
        set result = ct_eq(a, b)
        assert(result == 1, "Constant-time equality in constant_time block")
    }
}

// ── Scope-based Lifetime ──────────────────────────────────────────────────

test task test_scope_lifetime() {
    set outer = "outer_value"
    
    check true {
        set inner = "inner_value"
        assert(str_eq(inner, "inner_value"), "Inner scope variable")
        // inner is dropped here
    }
    // inner is no longer accessible
    
    assert(str_eq(outer, "outer_value"), "Outer variable still valid")
}

test task test_borrow_across_scopes() {
    set owner = [1, 2, 3]
    set result = 0
    
    check true {
        set borrow = &owner    // Immutable borrow
        result = borrow[0] + borrow[1]
        // borrow lifetime ends here
    }
    // owner is usable again after borrow ends
    
    assert(result == 3, "Borrow across scope boundary")
}

// ── Loop Variable Ownership ───────────────────────────────────────────────

test task test_loop_copy_accumulation() {
    set sum = 0
    loop i from 1 to 101 {
        sum = sum + i
    }
    assert(sum == 5050, "Sum from 1 to 100")
}

test task test_loop_with_borrow() {
    set data = [10, 20, 30]
    set total = 0
    loop i from 0 to 3 {
        total = total + data[i]    // Repeated immutable access
    }
    assert(total == 60, "Loop with array access")
}

// ── Function Return Ownership ─────────────────────────────────────────────

test task test_return_copy_type() {
    task make_int() -> int {
        return 42
    }
    
    set x = make_int()
    set y = make_int()
    assert(x + y == 84, "Multiple calls to function returning Copy type")
}

test task test_return_struct() {
    struct Vec2 { x: int, y: int }
    
    task make_vec(a: int, b: int) -> Vec2 {
        return Vec2 { x: a, y: b }
    }
    
    set v = make_vec(3, 4)
    assert(v.x == 3, "Struct return value field access")
    assert(v.y == 4, "Struct return value field access")
}

// ── Nested Ownership ──────────────────────────────────────────────────────

test task test_struct_containing_string() {
    struct Person { name: string, age: int }
    
    set p1 = Person { name: "Alice", age: 30 }
    assert(str_eq(p1.name, "Alice"), "Struct with string field")
    assert(p1.age == 30, "Struct with int field")
    
    set p2 = p1  // Move — p1 is invalid
    assert(str_eq(p2.name, "Alice"), "Moved struct field intact")
}

// ── Run all tests ─────────────────────────────────────────────────────────

task main() {
    println("=== Sovereign Borrow Checker Test Suite ===")
    println("")
    
    println("--- Copy Types ---")
    test_copy_int()
    test_copy_float()
    test_copy_bool()
    test_copy_multiple_use()
    println("  ✅ Copy types work correctly")
    
    println("--- Move Semantics ---")
    test_string_move()
    test_struct_move()
    test_move_to_function()
    println("  ✅ Move semantics work correctly")
    
    println("--- Borrowing ---")
    test_immutable_borrow()
    test_borrow_in_expression()
    println("  ✅ Borrowing works correctly")
    
    println("--- Sensitive Data ---")
    test_sensitive_auto_zero()
    test_sensitive_string()
    test_sensitive_struct()
    println("  ✅ Sensitive data works correctly")
    
    println("--- Purge ---")
    test_purge_variable()
    println("  ✅ Purge works correctly")
    
    println("--- Constant-Time ---")
    test_constant_time_block()
    println("  ✅ Constant-time blocks work correctly")
    
    println("--- Scope Lifetime ---")
    test_scope_lifetime()
    test_borrow_across_scopes()
    println("  ✅ Scope-based lifetimes work correctly")
    
    println("--- Loop Ownership ---")
    test_loop_copy_accumulation()
    test_loop_with_borrow()
    println("  ✅ Loop ownership works correctly")
    
    println("--- Function Returns ---")
    test_return_copy_type()
    test_return_struct()
    println("  ✅ Function return ownership works correctly")
    
    println("--- Nested Ownership ---")
    test_struct_containing_string()
    println("  ✅ Nested ownership works correctly")
    
    println("")
    println("✅ All borrow checker tests passed!")
}
