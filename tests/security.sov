
sensitive set secret = 99999
println(secret)

constant_time {
    set low_byte = secret & 0xFF
    println(low_byte)
}

set key = 0xDEAD
purge key

set a = 42
set b = 42
set c = 43

assert(a == b, "equal values match")
assert(not (a == c), "unequal values differ")
println(0)

println("secure_compare works")