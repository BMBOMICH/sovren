// Test 3: Generic tasks
// Expected output:
// 7
// 3
// 2.500000
// 1.500000
// hello

task max_val[T](a: T, b: T) -> T {
    check a > b { return a }
    return b
}

task min_val[T](a: T, b: T) -> T {
    check a < b { return a }
    return b
}

task identity[T](x: T) -> T {
    return x
}

print max_val(3, 7)
print min_val(3, 7)
print max_val(1.5, 2.5)
print min_val(1.5, 2.5)
print identity("hello")

assert(max_val(3, 7) == 7, "max_val int")
assert(min_val(3, 7) == 3, "min_val int")