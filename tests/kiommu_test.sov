include inc/px00.sov 2760 6 (kiommu kiommu)
aligned_page:
    raw: _sov_alloc(8192) ;; return (raw + 4095) / 4096 * 4096
main:
    aligned_page():
        include inc/px00.sov 6 4 (root context pdpt pdpt2)
        pd ;; pt
    include inc/px00.sov 1864 4 (pool_raw 12288 pool_base pool_raw pool pool_bits)
    if kiommu_pool_init(pool, pool_base, 2, pool_bits, 1) != 1 -> bad('pool init')
    kiommu_pool_alloc(pool):
        pool0 ;; pool1
    if pool0 != pool_base -> bad('pool first page')
    if pool1 != pool_base + 4096 -> bad('pool second page')
    if kiommu_pool_alloc(pool) != 0 -> bad('pool exhaustion')
    poke_raw64(pool0, 0, 99)
    if kiommu_pool_free(pool, pool0) != 1 -> bad('pool free')
    if kiommu_pool_free(pool, pool0) != 0 -> bad('pool duplicate free')
    if peek_raw64(pool0, 0) != 0 -> bad('pool clear on free')
    if kiommu_pool_alloc(pool) != pool0 -> bad('pool reuse')
    if kiommu_pool_used(pool) != 2 -> bad('pool used count')
    if kiommu_pool_init(pool, pool_base + 1, 2, pool_bits, 1) != 0 -> bad('unaligned pool accepted')
    include inc/px00.sov 1864 4 (tree_raw 24576 tree_base tree_raw tree_pool tree_bits)
    if kiommu_pool_init(tree_pool, tree_base, 4, tree_bits, 1) != 1 -> bad('tree pool init')
    tree_root: kiommu_pool_alloc(tree_pool)
    if kiommu_tree_init(tree_pool, tree_root) != 1 -> bad('tree init')
    if kiommu_tree_map(tree_pool, tree_root, 8388608, 12582912, 3) != 1 -> bad('tree first map')
    if kiommu_pool_used(tree_pool) != 3 -> bad('tree demand allocation')
    if kiommu_tree_set_permissions(tree_pool, tree_root, 8388608, 1) != 1 -> bad('tree permission narrow')
    if kiommu_tree_lookup(tree_pool, tree_root, 8388608) != 12582913 -> bad('tree narrowed leaf')
    if kiommu_tree_set_permissions(tree_pool, tree_root, 8388608, 3) != 1 -> bad('tree permission widen')
    if kiommu_tree_lookup(tree_pool, tree_root, 8388608) != 12582915 -> bad('tree widened leaf')
    if kiommu_tree_set_permissions(tree_pool, tree_root, 8392704, 1) != 0 -> bad('tree missing permission update')
    if kiommu_tree_map(tree_pool, tree_root, 8392704, 12587008, 1) != 1 -> bad('tree shared branch map')
    if kiommu_pool_used(tree_pool) != 3 -> bad('tree branch duplicated')
    if kiommu_tree_map(tree_pool, tree_root, 8388608, 12582912, 3) != 0 -> bad('tree duplicate map')
    if kiommu_tree_map_identity_range(tree_pool, tree_root, 16777216, 16785407, 3) != 1 -> bad('tree identity range')
    if kiommu_pool_used(tree_pool) != 4 -> bad('tree identity demand allocation')
    if kiommu_tree_unmap_identity_range(tree_pool, tree_root, 16777216, 16785407) != 1 -> bad('tree identity range unmap')
    if kiommu_pool_used(tree_pool) != 3 -> bad('tree identity branch reclaim')
    if kiommu_tree_map_identity_range(tree_pool, tree_root, 16777216, 16785407, 3) != 1 -> bad('tree identity remap')
    if kiommu_tree_unmap(tree_pool, tree_root, 16781312) != 1 -> bad('tree identity hole')
    if kiommu_tree_unmap_identity_range(tree_pool, tree_root, 16777216, 16785407) != 0 -> bad('partial identity teardown')
    if kiommu_tree_lookup(tree_pool, tree_root, 16777216) = 0 -> bad('identity preflight mutated')
    if kiommu_tree_unmap(tree_pool, tree_root, 16777216) != 1 -> bad('identity preflight cleanup')
    if kiommu_pool_used(tree_pool) != 3 -> bad('tree identity cleanup reclaim')
    if kiommu_tree_map(tree_pool, tree_root, 1073741824, 12591104, 3) != 0 -> bad('tree exhaustion accepted')
    if kiommu_pool_used(tree_pool) != 3 -> bad('tree allocation rollback')
    if kiommu_tree_unmap(tree_pool, tree_root, 8388608) != 1 -> bad('tree first unmap')
    if kiommu_pool_used(tree_pool) != 3 -> bad('tree premature reclaim')
    if kiommu_tree_unmap(tree_pool, tree_root, 8392704) != 1 -> bad('tree final unmap')
    if kiommu_pool_used(tree_pool) != 1 -> bad('tree branch reclaim')
    if kiommu_tree_unmap(tree_pool, tree_root, 8392704) != 0 -> bad('tree duplicate unmap')
    if kiommu_pool_free(tree_pool, tree_root) != 1 -> bad('tree root reclaim')
    if kiommu_pool_used(tree_pool) != 0 -> bad('tree pool leak')
    if kiommu_cap_aw(512) != 1 -> bad('39-bit capability')
    if kiommu_cap_aw(1024) != 2 -> bad('48-bit capability')
    if kiommu_cap_aw(0) != 0 - 1 -> bad('missing address width')
    if kiommu_legacy_root_init(root, context, 0) != 1 -> bad('root initialization')
    if peek_raw64(root, 0) != context + 1 -> bad('root publication')
    context_bus1: aligned_page()
    if kiommu_legacy_root_add(root, context_bus1, 1) != 1 -> bad('second bus root')
    if peek_raw64(root + 16, 0) != context_bus1 + 1 -> bad('second bus publication')
    if kiommu_legacy_root_add(root, context_bus1, 1) != 0 -> bad('duplicate bus root')
    registry: _sov_alloc(KIOMMU_DOMAIN_STRIDE * 2)
    if kiommu_domains_init(registry, 2) != 1 -> bad('domain registry init')
    slot0: kiommu_domain_alloc(registry, 2, 7, pdpt, 1) ;; slot1: kiommu_domain_alloc(registry, 2, 8, pdpt2, 1)
    if slot0 != 0 -> bad('first domain allocation')
    if slot1 != 1 -> bad('second domain allocation')
    if kiommu_domain_alloc(registry, 2, 7, pdpt2, 1) != 0 - 1 -> bad('duplicate domain accepted')
    generation0: kiommu_domain_generation(registry, 2, slot0) ;; generation1: kiommu_domain_generation(registry, 2, slot1)
    if kiommu_domain_attach(registry, 2, slot0, generation0, context, 16) != 1 -> bad('first managed attach')
    if kiommu_domain_attach(registry, 2, slot1, generation1, context_bus1, 273) != 1 -> bad('second managed attach')
    if kiommu_domain_release(registry, 2, slot0, generation0) != 0 -> bad('attached domain release')
    if kiommu_domain_detach(registry, 2, slot0, generation0, context) != 1 -> bad('first managed detach')
    if kiommu_domain_release(registry, 2, slot0, generation0) != 1 -> bad('first managed release')
    if kiommu_domain_attach(registry, 2, slot0, generation0, context, 18) != 0 -> bad('stale generation attach')
    if kiommu_domain_generation(registry, 2, slot0) = generation0 -> bad('generation did not advance')
    if kiommu_domain_detach(registry, 2, slot1, generation1, context_bus1) != 1 -> bad('second managed detach')
    if kiommu_domain_release(registry, 2, slot1, generation1) != 1 -> bad('second managed release')
    if kiommu_context_bind(context, 16, pdpt, 7, 1) != 1 -> bad('context bind')
    if peek_raw64(context + 16 * 16, 0) != pdpt + 1 -> bad('context low')
    if peek_raw64(context + 16 * 16 + 8, 0) != 1793 -> bad('context high')
    if kiommu_context_bind(context, 17, pdpt2, 8, 1) != 1 -> bad('second domain bind')
    if peek_raw64(context + 17 * 16, 0) != pdpt2 + 1 -> bad('second context low')
    if peek_raw64(context + 17 * 16 + 8, 0) != 2049 -> bad('second context high')
    if kiommu_context_bind(context, 256, pdpt, 7, 1) != 0 -> bad('bad devfn accepted')
    if kiommu_context_bind(context, 1, pdpt + 1, 7, 1) != 0 -> bad('unaligned slpt accepted')
    if kiommu_window_init(pdpt, pd, pt, 8388608) != 1 -> bad('window initialization')
    if kiommu_window_map(pt, 8388608, 8388608, 12582912, 3) != 1 -> bad('window map')
    if peek_raw64(pt, 0) != 12582915 -> bad('leaf publication')
    if kiommu_window_map(pt, 8388608, 10485760, 12582912, 3) != 0 -> bad('out of window map')
    if kiommu_window_map(pt, 8388608, 8392705, 12582912, 3) != 0 -> bad('unaligned iova map')
    if kiommu_window_unmap(pt, 8388608, 8388608) != 1 -> bad('window unmap')
    if peek_raw64(pt, 0) != 0 -> bad('leaf clear')
    if kiommu_context_unbind(context, 16) != 1 -> bad('context unbind')
    if peek_raw64(context + 16 * 16, 0) != 0 -> bad('context clear')
    if peek_raw64(context + 17 * 16, 0) != pdpt2 + 1 -> bad('independent context damaged')
    if kiommu_context_unbind(context, 17) != 1 -> bad('second context unbind')
    units: _sov_alloc(KIOMMU_UNIT_STRIDE * 2)
    include inc/px01.sov 1681 4 (unit_mmio0 unit_mmio1 kiommu_units_init units unit registry)
    unit0: kiommu_unit_configure(units, 2, unit_mmio0, 8) ;; unit1: kiommu_unit_configure(units, 2, unit_mmio1, 8)
    if unit0 != 0 -> bad('first unit configure')
    if unit1 != 1 -> bad('second unit configure')
    if kiommu_unit_configure(units, 2, unit_mmio0, 8) != 0 - 1 -> bad('duplicate unit accepted')
    unit_generation: kiommu_unit_generation(units, 2, unit0)
    if kiommu_unit_state(units, 2, unit0, unit_generation) != KIOMMU_UNIT_READY -> bad('unit ready state')
    if kiommu_unit_release(units, 2, unit0, unit_generation) != 1 -> bad('unit release')
    if kiommu_unit_release(units, 2, unit0, unit_generation) != 0 -> bad('stale unit release')
    if kiommu_unit_generation(units, 2, unit0) = unit_generation -> bad('unit generation did not advance')
    ir: aligned_page()
    if kiommu_ir_table_init(ir, 256) != 1 -> bad('interrupt table init')
    if kiommu_ir_size_code(256) != 7 -> bad('interrupt table size')
    if kiommu_ir_size_code(3) != 0 - 1 -> bad('non-power interrupt table')
    if kiommu_ir_entry_bind(ir, 256, 3, 48, 2, 4660, 0) != 1 -> bad('interrupt entry bind')
    if peek_raw64(ir + 48, 0) != 2199026401281 -> bad('interrupt entry low')
    if peek_raw64(ir + 56, 0) != 266804 -> bad('interrupt entry source')
    if kiommu_ir_entry_bind(ir, 256, 3, 48, 2, 4660, 0) != 0 -> bad('duplicate interrupt entry')
    if kiommu_ir_msi_address(3) != 4276093040 -> bad('remappable msi address')
    if kiommu_ir_entry_unbind(ir, 256, 3) != 1 -> bad('interrupt entry unbind')
    if kiommu_ir_entry_unbind(ir, 256, 3) != 0 -> bad('duplicate interrupt unbind')
    owners: _sov_alloc(KIOMMU_IR_OWNER_STRIDE * 2)
    if kiommu_ir_owners_init(owners, 2, 3, 256) != 1 -> bad('interrupt owner init')
    ir_slot0: kiommu_ir_owner_acquire(owners, 2, 11, 4660) ;; ir_slot1: kiommu_ir_owner_acquire(owners, 2, 22, 22136)
    if ir_slot0 != 0 -> bad('interrupt owner acquire')
    if ir_slot1 != 1 -> bad('interrupt owner acquire 2')
    ir_generation0: kiommu_ir_owner_generation(owners, 2, ir_slot0) ;; ir_generation1: kiommu_ir_owner_generation(owners, 2, ir_slot1)
    if kiommu_ir_owner_index(owners, 2, ir_slot0, ir_generation0) != 3 -> bad('interrupt owner index')
    if kiommu_ir_owner_bind(ir, owners, 2, ir_slot0, ir_generation0 + 1, 48, 2) != 0 -> bad('stale interrupt owner bind')
    if kiommu_ir_owner_bind(ir, owners, 2, ir_slot0, ir_generation0, 48, 2) != 1 -> bad('interrupt owner bind')
    if kiommu_ir_owner_bind_level(ir, owners, 2, ir_slot1, ir_generation1, 49, 2) != 1 -> bad('interrupt owner level bind')
    if band(peek_raw64(ir + 64, 0), 16) = 0 -> bad('interrupt owner trigger')
    if kiommu_ir_owner_acquire(owners, 2, 33, 39612) != 0 - 1 -> bad('interrupt owner exhaustion')
    if kiommu_ir_owner_retire(ir, owners, 2, ir_slot0, ir_generation0, 22) != 0 -> bad('wrong interrupt owner retire')
    if kiommu_ir_owner_retire(ir, owners, 2, ir_slot0, ir_generation0, 11) != 1 -> bad('interrupt owner retire')
    if kiommu_ir_owner_acquire(owners, 2, 33, 39612) != 0 - 1 -> bad('retiring interrupt owner reused')
    if kiommu_ir_owner_reclaim(owners, 2, ir_slot0, ir_generation0, 22) != 0 -> bad('wrong interrupt owner reclaim')
    if kiommu_ir_owner_reclaim(owners, 2, ir_slot0, ir_generation0, 11) != 1 -> bad('interrupt owner reclaim')
    if kiommu_ir_owner_reclaim(owners, 2, ir_slot0, ir_generation0, 11) != 0 -> bad('stale interrupt owner reclaim')
    ir_slot2: kiommu_ir_owner_acquire(owners, 2, 33, 39612) ;; ir_generation2: kiommu_ir_owner_generation(owners, 2, ir_slot2)
    if ir_slot2 != ir_slot0 -> bad('interrupt owner slot reuse')
    if ir_generation2 = ir_generation0 -> bad('interrupt owner generation reuse')
    if kiommu_ir_owner_cancel(owners, 2, ir_slot2, ir_generation2, 22) != 0 -> bad('wrong interrupt owner cancel')
    if kiommu_ir_owner_cancel(owners, 2, ir_slot2, ir_generation2, 33) != 1 -> bad('interrupt owner cancel')
    if kiommu_ir_owner_retire(ir, owners, 2, ir_slot1, ir_generation1, 22) != 1 -> bad('interrupt owner retire 2')
    if kiommu_ir_owner_reclaim(owners, 2, ir_slot1, ir_generation1, 22) != 1 -> bad('interrupt owner reclaim 2')
    include inc/px00.sov 1754 4 (aligned_page mmio qi qi_completion _sov_alloc 8)
    if kiommu_qi_hw_enable(mmio, 0, qi, 10) != 0 -> bad('queued invalidation without capability')
    if kiommu_qi_hw_enable(mmio, KIOMMU_ECAP_QI, qi + 1, 10) != 0 -> bad('unaligned invalidation queue')
    if kiommu_qi_ir_invalidate(mmio, qi, qi_completion, 3, 10) != 0 -> bad('invalidation accepted while disabled')
    poke_raw32(mmio + 28, 0, KIOMMU_GSTS_IRTPS)
    if kiommu_ir_hw_set_table_mode(mmio, 0, ir, 256, 1, 10) != 0 -> bad('unsupported extended interrupt mode')
    if kiommu_ir_hw_set_table_mode(mmio, 16, ir, 256, 2, 10) != 0 -> bad('invalid extended interrupt mode')
    if kiommu_ir_hw_set_table_mode(mmio, 16, ir, 256, 1, 10) != 1 -> bad('extended interrupt table mode')
    if peek_raw64(mmio + 184, 0) != ir + 2055 -> bad('extended interrupt table address')
    record: _sov_alloc(KIOMMU_FAULT_STRIDE) ;; capability: 570425344
    poke_raw32(mmio + 52, 0, 2) ;; poke_raw64(mmio + 544, 0, 11255808)
    high: bor(bshl(1, 63), bor(bshl(7, 32), 4660)) ;; poke_raw64(mmio + 552, 0, high)
    if kiommu_fault_read(mmio, capability, record) != 1 -> bad('fault read')
    if kiommu_fault_address(record) != 11255808 -> bad('fault address')
    if kiommu_fault_source(record) != 4660 -> bad('fault source')
    if kiommu_fault_reason(record) != 7 -> bad('fault reason')
    include inc/px01.sov 1681 4 (account_context account_slpt kiommu_domains_init registry fault domain)
    account_domain: kiommu_domain_alloc(registry, 2, 77, account_slpt, 1) ;; account_generation: kiommu_domain_generation(registry, 2, account_domain)
    if kiommu_domain_attach(registry, 2, account_domain, account_generation, account_context, 4660) != 1 -> bad('fault domain attach')
    account_owner: kiommu_ir_owner_acquire(owners, 2, 88, 22136) ;; account_owner_generation: kiommu_ir_owner_generation(owners, 2, account_owner)
    if kiommu_ir_owner_bind(ir, owners, 2, account_owner, account_owner_generation, 48, 2) != 1 -> bad('fault interrupt owner bind')
    account: _sov_alloc(KIOMMU_FAULT_ACCOUNT_STRIDE)
    if kiommu_fault_account_init(account) != 1 -> bad('fault account init')
    if kiommu_fault_account(record, registry, 2, owners, 2, account) != 1 -> bad('dma fault account')
    if peek_raw64(account, 0) != 1 -> bad('dma fault account count')
    if peek_raw64(account + 32, 0) != 77 -> bad('dma fault domain')
    poke_raw64(record, 0, bshl(3, 48)) ;; poke_raw64(record + 8, 0, bor(bshl(1, 63), bor(bshl(38, 32), 4660)))
    if kiommu_fault_account(record, registry, 2, owners, 2, account) != 3 -> bad('interrupt fault account')
    if peek_raw64(account, 0) != 2 -> bad('interrupt fault account count')
    if peek_raw64(account + 24, 0) != 3 -> bad('interrupt fault account index')
    if peek_raw64(account + 40, 0) != 88 -> bad('interrupt fault configured owner')
    policies: _sov_alloc(KIOMMU_FAULT_POLICY_HEADER + KIOMMU_FAULT_POLICY_STRIDE * 2)
    if kiommu_fault_policies_init(policies, 2) != 1 -> bad('fault policy init')
    if kiommu_fault_policy_configure(policies, 2, 77, 100, 10, 2, 1) != 1 -> bad('fault policy configure')
    if kiommu_fault_policy_configure(policies, 2, 77, 99, 10, 2, 1) != 0 -> bad('active fault policy reconfigured')
    if kiommu_fault_policy_note_at(policies, 2, account, 100) != KIOMMU_FAULT_POLICY_MONITOR -> bad('fault window first monitor')
    if kiommu_fault_policy_note_at(policies, 2, account, 105) != KIOMMU_FAULT_POLICY_MONITOR -> bad('fault window quota monitor')
    if kiommu_fault_policy_window_count(policies, 2, 77) != 2 -> bad('fault window count')
    if kiommu_fault_policy_note_at(policies, 2, account, 109) != KIOMMU_FAULT_POLICY_QUARANTINE -> bad('fault window quarantine')
    if kiommu_fault_policy_action(policies, 2, 77) != KIOMMU_FAULT_POLICY_QUARANTINE -> bad('fault quarantine action')
    if kiommu_fault_policy_count(policies, 2, 77) != 3 -> bad('fault policy count')
    if kiommu_fault_policy_reset(policies, 2, 88) != 0 -> bad('wrong fault policy reset')
    if kiommu_fault_policy_reset(policies, 2, 77) != 1 -> bad('fault policy reset')
    if kiommu_fault_policy_count(policies, 2, 77) != 0 -> bad('fault policy count after reset')
    if kiommu_fault_policy_recoveries(policies, 2, 77) != 1 -> bad('fault recovery count')
    if kiommu_fault_policy_note_at(policies, 2, account, 200) != KIOMMU_FAULT_POLICY_MONITOR -> bad('post-recovery monitor one')
    if kiommu_fault_policy_note_at(policies, 2, account, 201) != KIOMMU_FAULT_POLICY_MONITOR -> bad('post-recovery monitor two')
    if kiommu_fault_policy_note_at(policies, 2, account, 202) != KIOMMU_FAULT_POLICY_BLOCK -> bad('recovery escalation block')
    if kiommu_fault_policy_reset(policies, 2, 77) != 0 -> bad('blocked policy reset')
    if kiommu_fault_policy_note_at(policies, 2, account, 203) != KIOMMU_FAULT_POLICY_BLOCK -> bad('fault block regressed')
    if kiommu_fault_policy_release(policies, 2, 77) != 1 -> bad('fault policy release')
    if kiommu_fault_policy_active(policies, 2) != 0 -> bad('fault policy leak')
    if kiommu_fault_policy_configure(policies, 2, 77, 0, 10, 2, 1) != 0 -> bad('zero fault threshold accepted')
    if kiommu_fault_policy_configure(policies, 2, 77, 5, 0, 2, 1) != 0 -> bad('quota without window accepted')
    if kiommu_fault_policy_configure(policies, 2, 77, 5, 10, 0, 1) != 0 -> bad('window without quota accepted')
    if kiommu_fault_policy_configure(policies, 2, 77, 5, 10, 2, 0) != 1 -> bad('unlimited recovery configure')
    if kiommu_fault_policy_note_at(policies, 2, account, 50) != KIOMMU_FAULT_POLICY_MONITOR -> bad('timestamp baseline')
    if kiommu_fault_policy_note_at(policies, 2, account, 49) != 0 - 1 -> bad('timestamp rollback accepted')
    if kiommu_fault_policy_count(policies, 2, 77) != 1 -> bad('timestamp rollback mutated count')
    atomic_store(policies, 1)
    if kiommu_fault_policy_note_at(policies, 2, account, 51) != 0 - 1 -> bad('fault policy lock contention accepted')
    atomic_store(policies, 0)
    if kiommu_fault_policy_release(policies, 2, 77) != 1 -> bad('contended policy release')
    if kiommu_fault_policy_active(policies, 1) != 0 - 1 -> bad('policy capacity mismatch accepted')
    if kiommu_ir_owner_retire(ir, owners, 2, account_owner, account_owner_generation, 88) != 1 -> bad('fault interrupt owner retire')
    if kiommu_ir_owner_reclaim(owners, 2, account_owner, account_owner_generation, 88) != 1 -> bad('fault interrupt owner reclaim')
    if kiommu_domain_detach(registry, 2, account_domain, account_generation, account_context) != 1 -> bad('fault domain detach')
    if kiommu_domain_release(registry, 2, account_domain, account_generation) != 1 -> bad('fault domain release')
    poke_raw64(mmio + 552, 0, 0)
    if kiommu_fault_read(mmio, capability, record) != 0 -> bad('invalid fault accepted')
    include inc/px00.sov 1864 4 (large_raw 24576 large_base large_raw large_pool large_bits)
    if kiommu_pool_init(large_pool, large_base, 4, large_bits, 1) != 1 -> bad('large page pool')
    large_root: kiommu_pool_alloc(large_pool)
    if kiommu_tree_init(large_pool, large_root) != 1 -> bad('large page root')
    if kiommu_cap_2m(bshl(1, 34)) != 1 -> bad('2m capability')
    if kiommu_cap_2m(0) != 0 -> bad('false 2m capability')
    if kiommu_tree_map_identity_2m(large_pool, large_root, 0, 4194303, 3) != 1 -> bad('2m identity map')
    if kiommu_pool_used(large_pool) != 2 -> bad('2m map allocation')
    large_pd_entry: peek_raw64(large_root, 0) ;; large_pd: large_pd_entry - large_pd_entry % 4096
    if peek_raw64(large_pd, 0) != 131 -> bad('first 2m leaf')
    if peek_raw64(large_pd + 8, 0) != 2097283 -> bad('second 2m leaf')
    poke_raw64(large_pd + 8, 0, 0)
    if kiommu_tree_unmap_identity_2m(large_pool, large_root, 0, 4194303) != 0 -> bad('partial 2m teardown accepted')
    if peek_raw64(large_pd, 0) != 131 -> bad('2m preflight mutated')
    poke_raw64(large_pd + 8, 0, 2097283)
    if kiommu_tree_unmap_identity_2m(large_pool, large_root, 0, 4194303) != 1 -> bad('2m identity unmap')
    if kiommu_pool_used(large_pool) != 1 -> bad('2m branch reclaim')
    if kiommu_pool_free(large_pool, large_root) != 1 -> bad('2m root release')
    if kiommu_pool_used(large_pool) != 0 -> bad('2m pool leak')
    print 'kiommu OK'
