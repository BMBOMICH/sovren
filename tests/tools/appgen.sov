include inc/inc00.sov 294 3 #1120291588909355907
    sys
appgen_die msg:
    write_err('appgen: ')
    write_err(msg)
    write_err("\n")
    sys_exit(1)
key_at buf pos klen key:
    include inc/px00.sov 3882 4 (klen peek_byte buf pos key)
    return 1
include inc/px00.sov 3897 4 (manifest_get src key kl str_len key pos str_len src)
    as long as pos < n -> le: pos
        as long as le < n -> if peek_byte(src, le) = 10
                leave
            le: le + 1
        if key_at(src, pos, kl, key) = 1 -> if peek_byte(src, pos + kl) = 61
                return str_sub(src, pos + kl + 1, le)
        pos: le + 1
main argc argv:
    if argc != 3 -> write_err("use: appgen <manifest> <output.sov>\n")
        sys_exit(2)
    src: file_read_all(peek_ptr(argv, 1))
    if src = 0 -> appgen_die('manifest not found')
    name: manifest_get(src, 'name')
    docfile: manifest_get(src, 'file')
    banner: manifest_get(src, 'banner')
    reopen: manifest_get(src, 'reopen')
    if name = 0 -> appgen_die('manifest missing name')
    if docfile = 0 -> appgen_die('manifest missing file')
    if banner = 0 -> appgen_die('manifest missing banner')
    if reopen = 0 -> appgen_die('manifest missing reopen')
    out: "# generated by tools/appgen.sov - do not edit by hand\n"
    out: str_cat(out, "# application: ")
    out: str_cat(out, name)
    out: str_cat(out, "\n#\n# Standard capability-gated application scaffold: phase one saves the\n# document through FILE_* service calls with negative gates; phase two\n# reopens it after reboot through the SESSION relaunch path.\n\n")
    out: str_cat(out, "use sovsys_abi\nuse sovstorage_abi\n\n")
    out: str_cat(out, "CELL: 1073761280\nDOC: 1073759264\nST: 1073760768\n\n")
    out: str_cat(out, "finish status:\n    sov_EXIT(status)\n    return 0\n\n")
    out: str_cat(out, "copy_text dst text:\n    n: 0\n    as long as 1 is 1\n        c: peek_byte(text, n)\n        if c is 0\n            leave\n        poke_byte(dst, n, c)\n        n: n + 1\n    poke_byte(dst, n, 0)\n    return n\n\n")
    out: str_cat(out, "phase_one:\n    msg: \"")
    out: str_cat(out, banner)
    out: str_cat(out, "\"\n    m: copy_text(DOC, msg)\n")
    out: str_cat(out, "    w: sov_FILE_WRITE(\"")
    out: str_cat(out, docfile)
    out: str_cat(out, "\", DOC, m)\n    if w is not m\n        return finish(60)\n")
    out: str_cat(out, "    if sov_FILE_STAT(\"")
    out: str_cat(out, docfile)
    out: str_cat(out, "\", ST) is not 0\n        return finish(61)\n    if peek_raw64(ST, 0) is not 1\n        return finish(62)\n    if peek_raw64(ST + 8, 0) is not m\n        return finish(63)\n")
    out: str_cat(out, "    r: sov_FILE_READ(\"")
    out: str_cat(out, docfile)
    out: str_cat(out, "\", DOC, 1536)\n    if r is not m\n        return finish(64)\n    if sov_WRITE(1, DOC, m) is not m\n        return finish(65)\n")
    out: str_cat(out, "    if sov_FILE_WRITE(\"NODIR/X.TXT\", DOC, 4) is not 0 - 2\n        return finish(66)\n    if sov_FILE_READ(\"DOCS/MISSING.TXT\", DOC, 16) is not 0 - 2\n        return finish(67)\n    return finish(0)\n\n")
    out: str_cat(out, "phase_two:\n    r: sov_FILE_READ(\"")
    out: str_cat(out, docfile)
    out: str_cat(out, "\", DOC, 1536)\n    if r < 1\n        return finish(70)\n    if sov_WRITE(1, DOC, r) is not r\n        return finish(71)\n    msg2: \"")
    out: str_cat(out, reopen)
    out: str_cat(out, "\"\n    m2: copy_text(DOC, msg2)\n    if sov_WRITE(1, DOC, m2) is not m2\n        return finish(72)\n    if sov_FILE_LIST(DOC) is not 0\n        return finish(73)\n    return finish(0)\n\n")
    out: str_cat(out, "main:\n    phase: peek_raw64(CELL, 0)\n    if phase is 1\n        return phase_one()\n    if phase is 2\n        return phase_two()\n    return finish(59)\n")
    if file_write_all(peek_ptr(argv, 2), out) != 1 -> appgen_die('cannot write output')
    write_out('appgen: wrote ') ;; write_out(peek_ptr(argv, 2))
    write_out("\n")
