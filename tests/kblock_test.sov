# unsafe-module
use kblock
bad message:
    print as text message ;; stop
main:
    request: _sov_alloc(KBLK_STRIDE) ;; buffer: _sov_alloc(4096)
    if kblk_init(request, 7) != 1 -> bad('init')
    generation: kio_req_generation(request)
    if kblk_prepare(request, KBLK_READ, 12, 8, 512, buffer, 4096) != 1 -> bad('prepare')
    if kblk_lba(request) != 12 -> bad('lba')
    if kblk_blocks(request) != 8 -> bad('blocks')
    if kblk_bytes(request) != 4096 -> bad('bytes')
    if kblk_activate(request) != 1 -> bad('activate')
    if kblk_complete(request, 0, 8) != 1 -> bad('complete')
    if kio_req_state(request) != KIO_REQ_DONE -> bad('done state')
    if kio_req_transferred(request) != 4096 -> bad('transferred')
    if kblk_complete(request, 0, 8) != 0 -> bad('double complete')
    if kblk_init(request, 7) != 1 -> bad('reinit')
    if kio_req_generation(request) != generation + 1 -> bad('generation')
    if kblk_prepare(request, KBLK_WRITE, 0, 9, 512, buffer, 4096) != 0 -> bad('short buffer')
    if kblk_prepare(request, KBLK_WRITE, 0, 1, 1000, buffer, 4096) != 0 -> bad('non-power block')
    if kblk_prepare(request, KBLK_READ, 9223372036854775807, 2, 512, buffer, 4096) != 0 -> bad('lba overflow')
    if kblk_prepare(request, 99, 0, 1, 512, buffer, 4096) != 0 -> bad('operation')
    if kblk_prepare(request, KBLK_FLUSH, 0, 1, 512, 0, 0) != 1 -> bad('flush')
    if kblk_activate(request) != 1 -> bad('flush activate')
    if kblk_cancel(request) != 1 -> bad('cancel')
    if kio_req_cancel_pending(request) != 1 -> bad('cancel pending')
    if kblk_cancel_ack(request, 0) != 1 -> bad('cancel acknowledge')
    if kio_req_state(request) != KIO_REQ_CANCELLED -> bad('cancel state')
    if kblk_init(request, 7) != 1 -> bad('flag init')
    if kblk_prepare(request, KBLK_WRITE, 1, 1, 512, buffer, 4096) != 1 -> bad('flag prepare')
    if kblk_set_flags(request, KBLK_REQ_FUA + KBLK_REQ_BARRIER) != 1 -> bad('FUA barrier flags')
    if kblk_flags(request) != 3 -> bad('flag value')
    if kblk_activate(request) != 1 -> bad('flag activate')
    if kblk_cancel(request) != 1 -> bad('flag cancel')
    if kblk_cancel_ack(request, 0) != 1 -> bad('flag cancel acknowledge')
    if kblk_init(request, 7) != 1 -> bad('zeroes init')
    if kblk_prepare(request, KBLK_WRITE_ZEROES, 2, 2, 512, 0, 0) != 1 -> bad('write zeroes')
    if kblk_set_flags(request, KBLK_REQ_FUA) != 0 -> bad('zeroes FUA')
    registry: _sov_alloc(KBLK_DEVICE_STRIDE * 2) ;; second: _sov_alloc(KBLK_STRIDE)
    if kblk_registry_init(registry, 2) != 1 -> bad('registry init')
    if kblk_device_register(registry, 2, 44, 512, 9223372036854775807, 1, 0) != 0 -> bad('capacity overflow')
    if kblk_device_register(registry, 2, 44, 512, 64, 4, 64) != 0 -> bad('unknown flags')
    device: kblk_device_register(registry, 2, 44, 512, 64, 4, KBLK_DEVICE_REMOVABLE + KBLK_DEVICE_FLUSH)
    if device != 1 -> bad('register')
    device_generation: kblk_device_generation(registry, 2, device)
    if device_generation != 1 -> bad('device generation')
    include inc/inc04.sov 1012 3
    if kblk_device_attach_queue(registry, 2, device, 45, queue) != 0 -> bad('wrong owner queue')
    if kblk_device_attach_queue(registry, 2, device, 44, queue) != 1 -> bad('attach queue')
    if kblk_device_online(registry, 2, device, 45) != 0 -> bad('wrong owner online')
    if kblk_device_online(registry, 2, device, 44) != 1 -> bad('online')
    if kblk_device_find_backend(registry, 2, 44) != device -> bad('find backend')
    if kblk_device_blocks(registry, 2, device) != 64 -> bad('capacity')
    if kblk_init(request, 44) != 1 -> bad('device request init')
    if kblk_prepare(request, KBLK_READ, 63, 1, 512, buffer, 4096) != 1 -> bad('device request prepare')
    if kblk_set_deadline(request, 60) != 1 -> bad('active timeout deadline')
    if kblk_device_enqueue(registry, 2, device, device_generation + 1, request) != 0 -> bad('stale enqueue')
    if kblk_device_enqueue(registry, 2, device, device_generation, request) != 1 -> bad('enqueue')
    if kblk_device_pending(registry, 2, device) != 1 -> bad('pending')
    if kblk_device_dispatch(registry, 2, device, device_generation) != request -> bad('dispatch')
    if kblk_device_pending(registry, 2, device) != 0 -> bad('dispatched pending')
    if kblk_device_inflight(registry, 2, device) != 1 -> bad('inflight')
    if kblk_device_timeout(registry, 2, device, device_generation, request, 59) != 0 -> bad('early active timeout')
    if kblk_device_timeout(registry, 2, device, device_generation, request, 60) != 1 -> bad('active timeout')
    if kio_req_timeout_pending(request) != 1 -> bad('active timeout pending')
    if kblk_device_inflight(registry, 2, device) != 1 -> bad('timeout retired before ack')
    if kblk_device_timeout_ack(registry, 2, device, device_generation + 1, request, 0) != 0 -> bad('stale timeout ack')
    include inc/px00.sov 2417 6 (kblk_device_timeout_ack timeout KIO_REQ_TIMED_OUT timeout timeout cancel 62 cancel cancel)
    if kblk_device_dispatch(registry, 2, device, device_generation) != request -> bad('cancel dispatch')
    if kblk_device_cancel(registry, 2, device, device_generation, request) != 1 -> bad('active cancel')
    if kio_req_cancel_pending(request) != 1 -> bad('active cancel pending')
    if kblk_device_inflight(registry, 2, device) != 1 -> bad('cancel retired before ack')
    if kblk_device_cancel_ack(registry, 2, device, device_generation, request, 2) != 0 -> bad('cancel ack block overflow')
    include inc/px00.sov 2417 6 (kblk_device_cancel_ack cancel KIO_REQ_CANCELLED cancel cancel drain 63 drain drain)
    if kblk_device_dispatch(registry, 2, device, device_generation) != request -> bad('drain dispatch')
    if kblk_init(second, 44) != 1 -> bad('second init')
    if kblk_prepare(second, KBLK_READ, 1, 1, 512, buffer, 4096) != 1 -> bad('second prepare')
    if kblk_set_deadline(second, 50) != 1 -> bad('second deadline')
    if kblk_device_enqueue(registry, 2, device, device_generation, second) != 1 -> bad('second enqueue')
    if kblk_device_pending(registry, 2, device) != 1 -> bad('second pending')
    if kblk_device_offline(registry, 2, device, 44) != 0 -> bad('offline active')
    if kblk_device_remove(registry, 2, device, 44) != 0 -> bad('remove online')
    if kblk_device_timeout_queued(registry, 2, device, device_generation, second, 49) != 0 -> bad('early queued timeout')
    if kblk_device_quiesce(registry, 2, device, 44) != 1 -> bad('quiesce')
    if kblk_device_submit(registry, 2, device, device_generation, second) != 0 -> bad('submit while quiescing')
    if kblk_device_timeout_queued(registry, 2, device, device_generation, second, 50) != 1 -> bad('queued timeout')
    if kblk_device_pending(registry, 2, device) != 0 -> bad('timeout pending')
    if kio_req_state(second) != KIO_REQ_TIMED_OUT -> bad('queued timeout state')
    if kblk_device_complete(registry, 2, device, device_generation, request, 0, 1) != 1 -> bad('drain completion')
    if kblk_device_inflight(registry, 2, device) != 0 -> bad('drained')
    if kblk_device_offline(registry, 2, device, 44) != 1 -> bad('offline')
    if kblk_device_remove(registry, 2, device, 44) != 1 -> bad('remove')
    if kblk_device_state(registry, 2, device) != KBLK_DEVICE_FREE -> bad('free state')
    reused: kblk_device_register(registry, 2, 44, 512, 64, 2, KBLK_DEVICE_READ_ONLY)
    if reused != device -> bad('reuse slot')
    if kblk_device_generation(registry, 2, reused) != device_generation + 1 -> bad('reuse generation')
    if kblk_device_online(registry, 2, reused, 44) != 1 -> bad('reuse online')
    if kblk_init(second, 44) != 1 -> bad('readonly init')
    if kblk_prepare(second, KBLK_WRITE, 0, 1, 512, buffer, 4096) != 1 -> bad('readonly prepare')
    if kblk_device_submit(registry, 2, reused, device_generation + 1, second) != 0 -> bad('readonly submit')
    if kblk_init(second, 44) != 1 -> bad('flush init')
    if kblk_prepare(second, KBLK_FLUSH, 0, 1, 512, 0, 0) != 1 -> bad('flush prepare')
    if kblk_device_submit(registry, 2, reused, device_generation + 1, second) != 0 -> bad('unsupported flush')
    if kblk_init(second, 44) != 1 -> bad('range init')
    if kblk_prepare(second, KBLK_READ, 64, 1, 512, buffer, 4096) != 1 -> bad('range prepare')
    if kblk_device_submit(registry, 2, reused, device_generation + 1, second) != 0 -> bad('range submit')
    if kblk_device_quiesce(registry, 2, reused, 44) != 1 -> bad('reuse quiesce')
    if kblk_device_offline(registry, 2, reused, 44) != 1 -> bad('reuse offline')
    if kblk_device_remove(registry, 2, reused, 44) != 1 -> bad('reuse remove')
    print 'kblock OK'
