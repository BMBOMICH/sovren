use string
main:
    src: _sov_heap_alloc(65536)
    dst: _sov_heap_alloc(65536)
    i: 0
    as long as i < 65536
        poke_byte(src, i, i % 251)
        i: i + 1
    acc: 0
    r: 0
    as long as r < 3000
        dummy: _sov_memcpy(dst, src, 65536)
        dummy: _sov_memcpy(src, dst, 4097)
        dummy: _sov_memcpy(dst, src, 33)
        acc: acc + peek_byte(dst, r % 60000)
        r: r + 1
    big: _sov_heap_alloc(100001)
    big2: _sov_heap_alloc(100001)
    i: 0
    as long as i < 100000
        c: 97 + (i % 26)
        poke_byte(big, i, c)
        poke_byte(big2, i, c)
        i: i + 1
    poke_byte(big, 100000, 0)
    poke_byte(big2, 100000, 0)
    r: 0
    eq: 0
    as long as r < 2000
        eq: eq + _sov_str_eq(big, big2)
        eq: eq + _sov_starts_with(big, big2)
        r: r + 1
    print acc
    print eq
