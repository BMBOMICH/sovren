#!/bin/sh
# The checks. Most of them live in check/all.sov and are written in
# Sovren; this builds that and runs it. What stays here is only the
# part that needs another processor emulated, or a second opinion
# from a different language, which Sovren cannot give itself.

SOV=./sovren
fail=0
ok() { echo "ok $1"; }
bad() { echo "FAIL $1"; fail=1; }
skip() { echo "skip $1"; }

# ---- the Sovren suite ----
if $SOV check/all.sov -o /tmp/sov-all >/dev/null 2>&1; then
    if /tmp/sov-all; then :; else fail=1; fi
else
    bad "could not build check/all.sov"
    $SOV check/all.sov -o /tmp/sov-all 2>&1 | tail -5
fi

# ---- the arm emulator written in Sovren, against the C one ----
# Both run the same binary. If they ever disagree, one is wrong.
if $SOV arm64/run.sov -o /tmp/sov-armrun >/dev/null 2>&1; then
    printf '%s\n' 'main:' '    print 5 * 3 / 2' > /tmp/sov-ea.sov
    $SOV /tmp/sov-ea.sov --android -o /tmp/sov-arm.bin >/dev/null 2>&1
    g=$(timeout 300 /tmp/sov-armrun 2>/dev/null | tr -d '\r\n')
    if [ "$g" = "7" ]; then ok arm-emulator-in-sovren; else bad arm-emulator-in-sovren; echo "  got $g"; fi

    printf '%s\n' 'use sha256' 'main:' '    print sha256_hex("abc")' > /tmp/sov-ea2.sov
    $SOV /tmp/sov-ea2.sov --android -o /tmp/sov-arm.bin >/dev/null 2>&1
    g=$(timeout 300 /tmp/sov-armrun 2>/dev/null | tr -d '\r\n')
    if [ "$g" = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" ]; then
        ok arm-emulator-sha256
    else bad arm-emulator-sha256; echo "  got $g"; fi
else
    bad "could not build arm64/run.sov"
fi

# ---- AArch64, all of it in Sovren now ----
# The encoder check, the back end check, and the shared library
# exports each have a Sovren program. No Python, no Unicorn.

if $SOV arm64/verify.sov -o /tmp/sov-verify >/dev/null 2>&1; then
    if /tmp/sov-verify | tail -1 | grep -q "every encoding is right"; then
        ok arm64-encodings
    else
        bad arm64-encodings; /tmp/sov-verify | grep FAIL | head -3
    fi
else
    bad "could not build arm64/verify.sov"
fi

if $SOV arm64/test.sov -o /tmp/sov-armtest >/dev/null 2>&1; then
    if /tmp/sov-armtest | tail -1 | grep -q "the ARM back end is right"; then
        ok arm64-codegen
    else
        bad arm64-codegen; /tmp/sov-armtest | grep FAIL | head -3
    fi
else
    bad "could not build arm64/test.sov"
fi

printf '%s\n' 'main:' '    print 5 * 3 / 2' > /tmp/sov-so.sov
$SOV /tmp/sov-so.sov --android-so -o /tmp/sov-so.so >/dev/null 2>&1
if $SOV arm64/runso.sov -o /tmp/sov-runso >/dev/null 2>&1; then
    g=$(timeout 300 /tmp/sov-runso 2>/dev/null | tr -d '\r\n')
    if [ "$g" = "77" ]; then ok so-exports; else bad so-exports; echo "  got $g"; fi
else
    bad "could not build arm64/runso.sov"
fi

# the iOS signature still needs a second, independent SHA-256
if python3 -c "import hashlib" >/dev/null 2>&1; then
    $SOV hello.sov --ios -o /tmp/sov-ios.bin >/dev/null 2>&1
    if python3 arm64/check_sig.py /tmp/sov-ios.bin >/dev/null 2>&1; then
        ok ios-code-signature
    else
        bad ios-code-signature
    fi
fi

# ---- the x86 emulator, instruction by instruction ----
# check/x86ins.sov feeds library/x86.sov known bytes and checks the
# registers and flags afterwards. The answers came from a real
# processor, through a differential checker.
if $SOV check/x86ins.sov -o /tmp/sov-x86ins >/dev/null 2>&1; then
    if /tmp/sov-x86ins | tail -1 | grep -q "every instruction is right"; then
        ok x86-instructions
    else
        bad x86-instructions; /tmp/sov-x86ins | grep FAIL | head -5
    fi
else
    bad "could not build check/x86ins.sov"
fi

# ---- a real C program, built by gcc, run on the Sovren emulator ----
# This is the difference between an emulator that runs what Sovren
# emits and one that runs x86-64. glibc uses SSE, string
# instructions, the full-width multiply and half the flag rules.
if command -v gcc >/dev/null 2>&1; then
    cat > /tmp/sov-cprog.c <<'CEOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
static int cmp(const void *a, const void *b) { return *(int*)a - *(int*)b; }
int main(void) {
    int *a = malloc(sizeof(int) * 50);
    for (int i = 0; i < 50; i++) a[i] = (i * 7919) % 1000;
    qsort(a, 50, sizeof(int), cmp);
    printf("%d %d\n", a[0], a[49]);
    char *s = malloc(256);
    snprintf(s, 256, "%s|%d|%x", "fmt", 42, 255);
    printf("%s %zu\n", s, strlen(s));
    long long b = 1;
    for (int i = 0; i < 20; i++) b *= 3;
    printf("%lld\n", b);
    free(a); free(s);
    return 0;
}
CEOF
    if gcc -static -O2 -o /tmp/sov-cprog /tmp/sov-cprog.c >/dev/null 2>&1; then
        cat > /tmp/sov-runc.sov <<'SEOF'
use x86
use arg
main:
    m: x86_new()
    if x86_load(m, arg_at(1)) is 0
        print "cannot load"
        stop
    x86_run(m)
    write_out(x86_out(m))
    write_err(x86_reason(m))
SEOF
        $SOV /tmp/sov-runc.sov -o /tmp/sov-runc >/dev/null 2>&1
        /tmp/sov-cprog > /tmp/sov-c-native.txt 2>&1
        timeout 300 /tmp/sov-runc /tmp/sov-cprog > /tmp/sov-c-emu.txt 2>/dev/null
        if diff -q /tmp/sov-c-native.txt /tmp/sov-c-emu.txt >/dev/null 2>&1; then
            ok x86-runs-a-real-c-program
        else
            bad x86-runs-a-real-c-program
            echo "  native:"; sed "s/^/    /" /tmp/sov-c-native.txt
            echo "  emulated:"; sed "s/^/    /" /tmp/sov-c-emu.txt
        fi
    else
        skip "a real C program (gcc cannot build static)"
    fi
else
    skip "a real C program (no gcc)"
fi

# ---- a C program that uses decimals ----
# Decimals are the hardest part of a processor to get right. This
# builds one with gcc and checks every line against what it prints
# natively.
if command -v gcc >/dev/null 2>&1; then
    cat > /tmp/sov-fp.c <<'CEOF'
#include <stdio.h>
int main(void) {
    double v[] = {1.0, 2.5, -3.75, 0.1, 1e10, 1e-10, 123456.789};
    double s = 0, p = 1;
    for (int i = 0; i < 7; i++) { s += v[i]; p *= v[i]; }
    printf("sum=%.10f\nprod=%.10e\n", s, p);
    for (int i = 0; i < 5; i++) printf("%d:%.4f ", i, (double)i / 7.0);
    printf("\n");
    printf("big=%.3e small=%.3e\n", 1e300 * 1e5, 1e-300 / 1e5);
    printf("cast=%d %d %lld\n", (int)3.99, (int)-3.99, (long long)1e15);
    printf("cmp %d %d %d\n", 1.5 < 2.5, 1.5 == 1.5, 3.0 > 4.0);
    double a = 0.1, b = 0.2;
    printf("tenths=%.17g exact=%d\n", a + b, (a + b) == 0.3);
    return 0;
}
CEOF
    if gcc -static -O2 -o /tmp/sov-fp /tmp/sov-fp.c >/dev/null 2>&1; then
        /tmp/sov-fp > /tmp/sov-fp-native.txt 2>&1
        timeout 300 /tmp/sov-runc /tmp/sov-fp > /tmp/sov-fp-emu.txt 2>/dev/null
        if diff -q /tmp/sov-fp-native.txt /tmp/sov-fp-emu.txt >/dev/null 2>&1; then
            ok x86-decimals-match-the-real-thing
        else
            bad x86-decimals-match-the-real-thing
            echo "  native:";   sed "s/^/    /" /tmp/sov-fp-native.txt
            echo "  emulated:"; sed "s/^/    /" /tmp/sov-fp-emu.txt
        fi
    else
        skip "decimals in C (gcc cannot build static)"
    fi
else
    skip "decimals in C (no gcc)"
fi

# ---- the window, widget and game libraries ----
#
# These draw on a real screen. The checks start a screen with no
# monitor behind it, run a program that draws, and then look at
# what actually landed on it. Anything less would only prove the
# program did not fall over.
if command -v Xvfb >/dev/null 2>&1; then
    xdisp=""
    for d in 77 78 79 80 81; do
        if [ ! -e "/tmp/.X${d}-lock" ] && [ ! -e "/tmp/.X11-unix/X${d}" ]; then
            Xvfb ":${d}" -screen 0 640x480x24 -nolisten tcp >/dev/null 2>&1 &
            xvfbpid=$!
            k=0
            while [ $k -lt 8 ]; do
                if [ -e "/tmp/.X11-unix/X${d}" ]; then
                    xdisp=":${d}"
                    k=8
                else
                    k=$((k+1))
                    sleep 1
                fi
            done
            if [ -n "$xdisp" ]; then break; fi
            kill $xvfbpid 2>/dev/null
        fi
    done
fi

if [ -n "$xdisp" ]; then
    cat > /tmp/sov-win.sov <<'WEOF'
use win
use time
main:
    w: win_open(320, 240, "sovrencheck")
    if w is 0
        print "nodisplay"
        stop
    i: 0
    as long as i < 30
        win_fill(w, 0, 0, 320, 240, WIN_WHITE)
        win_fill(w, 20, 20, 80, 60, WIN_RED)
        win_box(w, 140, 20, 90, 60, WIN_BLUE)
        win_line(w, 10, 200, 300, 160, WIN_GREEN)
        win_text(w, 20, 120, "sovren", WIN_BLACK)
        win_flush(w)
        sleep_ms(100)
        i: i + 1
    print "drew"
WEOF
    if $SOV /tmp/sov-win.sov -o /tmp/sov-win >/dev/null 2>&1; then
        DISPLAY=$xdisp /tmp/sov-win > /tmp/sov-win.txt 2>&1 &
        winpid=$!
        k=0
        while [ $k -lt 20 ]; do
            if DISPLAY=$xdisp xwininfo -root -children 2>/dev/null | grep -q sovrencheck; then
                k=20
            else
                k=$((k+1))
                sleep 1
            fi
        done
        n=$(DISPLAY=$xdisp xwininfo -root -children 2>/dev/null | grep -c sovrencheck)
        if [ "$n" -ge 1 ]; then ok window-opens; else bad window-opens; fi
        if command -v import >/dev/null 2>&1; then
            DISPLAY=$xdisp import -window root /tmp/sov-shot.png 2>/dev/null
            c=$(python3 -c "
from PIL import Image
from collections import Counter
print(len(Counter(Image.open('/tmp/sov-shot.png').convert('RGB').getdata())))
" 2>/dev/null || echo 0)
            # white, red, blue, green and black all had to reach it
            if [ "$c" -ge 5 ]; then ok window-draws; else bad window-draws; echo "  colours on the screen: $c"; fi
        else
            skip "looking at the screen (no import)"
        fi
        wait $winpid 2>/dev/null
        if grep -q drew /tmp/sov-win.txt; then ok window-finishes; else bad window-finishes; fi
    else
        bad "could not build the window check"
    fi

    # the game loop has to keep proper time, or everything written
    # with it runs at a different speed on every machine
    cat > /tmp/sov-game.sov <<'GEOF'
use game
use num
use time
main:
    g: game_new(200, 150, "g")
    if g is 0
        print "nodisplay"
        stop
    game_speed(g, 50)
    t0: time_ms()
    n: 0
    as long as n < 50
        game_step(g)
        game_clear(g, WIN_BLACK)
        game_rect(g, n, 40, 10, 10, WIN_RED)
        game_show(g)
        n: n + 1
    el: time_ms() - t0
    if el > 800
        if el < 1400
            print "paced"
    print num_text(game_frame(g))
GEOF
    if $SOV /tmp/sov-game.sov -o /tmp/sov-game >/dev/null 2>&1; then
        g=$(DISPLAY=$xdisp timeout 40 /tmp/sov-game 2>/dev/null | head -1)
        if [ "$g" = "paced" ]; then ok game-loop-keeps-time; else bad game-loop-keeps-time; echo "  got $g"; fi
    else
        bad "could not build the game check"
    fi

    # the widgets: a form with a button and a box to type in
    cat > /tmp/sov-ui.sov <<'UEOF'
use ui
use time
main:
    u: ui_new(300, 200, "form")
    if u is 0
        print "nodisplay"
        stop
    ui_label(u, 20, 16, "name")
    e: ui_entry(u, 20, 40, 260, 28)
    b: ui_button(u, 20, 90, 100, 32, "Go")
    c: ui_check(u, 20, 140, "keep me")
    ui_set_text(u, e, "Elxan")
    ui_tick(u, c, 1)
    i: 0
    as long as i < 20
        ui_draw(u)
        sleep_ms(100)
        i: i + 1
    print "form drawn"
UEOF
    if $SOV /tmp/sov-ui.sov -o /tmp/sov-ui >/dev/null 2>&1; then
        DISPLAY=$xdisp /tmp/sov-ui > /tmp/sov-ui.txt 2>&1 &
        uipid=$!
        # wait for the window to actually appear rather than guess.
        # A fixed sleep passes on a quick machine and fails on a
        # loaded one, which is worse than no check at all.
        k=0
        while [ $k -lt 20 ]; do
            if DISPLAY=$xdisp xwininfo -root -children 2>/dev/null | grep -q form; then
                k=20
            else
                k=$((k+1))
                sleep 1
            fi
        done
        if command -v import >/dev/null 2>&1; then
            DISPLAY=$xdisp import -window root /tmp/sov-ui.png 2>/dev/null
            c=$(python3 -c "
from PIL import Image
from collections import Counter
print(len(Counter(Image.open('/tmp/sov-ui.png').convert('RGB').getdata())))
" 2>/dev/null || echo 0)
            if [ "$c" -ge 3 ]; then ok widgets-draw; else bad widgets-draw; echo "  colours: $c"; fi
        fi
        wait $uipid 2>/dev/null
    else
        bad "could not build the widget check"
    fi

    kill $xvfbpid 2>/dev/null
else
    skip "the window libraries (no screen to draw on)"
fi

# ---- a window program must not hang when the screen goes away ----
#
# This is the worst kind of fault: nothing prints, nothing fails,
# the program simply sits there. It happened, so it is checked.
if command -v Xvfb >/dev/null 2>&1; then
    hd=""
    for d in 84 85 86; do
        if [ ! -e "/tmp/.X${d}-lock" ] && [ ! -e "/tmp/.X11-unix/X${d}" ]; then
            Xvfb ":${d}" -screen 0 320x240x24 -nolisten tcp >/dev/null 2>&1 &
            hxpid=$!
            k=0
            while [ $k -lt 8 ]; do
                if [ -e "/tmp/.X11-unix/X${d}" ]; then
                    hd=":${d}"
                    k=8
                else
                    k=$((k+1))
                    sleep 1
                fi
            done
            if [ -n "$hd" ]; then break; fi
            kill $hxpid 2>/dev/null
        fi
    done
fi
if [ -n "$hd" ]; then
    cat > /tmp/sov-hang.sov <<'HEOF'
use win
use time
main:
    w: win_open(200, 150, "hangcheck")
    if w is 0
        print "nodisplay"
        stop
    i: 0
    as long as i < 300
        win_fill(w, 0, 0, 200, 150, WIN_RED)
        win_flush(w)
        if win_alive(w) is 0
            print "noticed"
            stop
        sleep_ms(100)
        i: i + 1
    print "ranout"
HEOF
    if $SOV /tmp/sov-hang.sov -o /tmp/sov-hang >/dev/null 2>&1; then
        DISPLAY=$hd /tmp/sov-hang > /tmp/sov-hang.txt 2>&1 &
        hpid=$!
        sleep 2
        kill $hxpid 2>/dev/null
        # give it a few seconds to notice and stop
        k=0
        while [ $k -lt 10 ]; do
            if kill -0 $hpid 2>/dev/null; then
                k=$((k+1))
                sleep 1
            else
                k=10
            fi
        done
        if kill -0 $hpid 2>/dev/null; then
            bad window-notices-a-dead-screen
            echo "  it was still running ten seconds after the screen went"
            kill -9 $hpid 2>/dev/null
        else
            if grep -q noticed /tmp/sov-hang.txt; then
                ok window-notices-a-dead-screen
            else
                bad window-notices-a-dead-screen
                echo "  it stopped but did not say why"
            fi
        fi
    else
        bad "could not build the hang check"
    fi
fi

# ---- reaching the rest of Windows ----
#
# A Windows program carries thirteen names with it, two of which
# are LoadLibraryA and GetProcAddress. Those two are what let it
# open user32 and gdi32 at run time and draw a window, without
# every drawing function having to be listed at build time.
$SOV hello.sov --windows -o /tmp/sov-imp.exe >/dev/null 2>&1
n=$(python3 -c "
import struct
d = open('/tmp/sov-imp.exe','rb').read()
pe = struct.unpack_from('<I', d, 0x3c)[0]
imp = struct.unpack_from('<I', d, pe+24+112+8)[0]
so = pe+24+240+40
vs, va, rs, ra = struct.unpack_from('<IIII', d, so+8)
def rd(rva, n): return d[ra+(rva-va):ra+(rva-va)+n]
ilt, ts, fc, nm, iat = struct.unpack_from('<IIIII', rd(imp, 20), 0)
names = []
j = 0
while True:
    v = struct.unpack_from('<Q', rd(iat+j*8, 8))[0]
    if v == 0: break
    names.append(rd(v+2, 24).split(b'\\0')[0].decode())
    j += 1
print(' '.join(names))
" 2>/dev/null)
if echo "$n" | grep -q LoadLibraryA && echo "$n" | grep -q GetProcAddress; then
    ok windows-can-reach-other-libraries
else
    bad windows-can-reach-other-libraries
    echo "  imports were: $n"
fi

# and the window library must build for Windows and say honestly
# that it cannot draw where there is no Windows
cat > /tmp/sov-ww.sov <<'WWEOF'
use window
use sys
main:
    w: window_open(200, 150, "x")
    if w is 0
        print "noscreen"
        stop
    print window_which(w)
    window_shut(w)
WWEOF
if $SOV /tmp/sov-ww.sov --windows -o /tmp/sov-ww.exe >/dev/null 2>&1; then
    ok window-library-builds-for-windows
else
    bad window-library-builds-for-windows
fi
if $SOV /tmp/sov-ww.sov -o /tmp/sov-ww >/dev/null 2>&1; then
    g=$(env -u DISPLAY timeout 20 /tmp/sov-ww 2>&1)
    if [ "$g" = "noscreen" ]; then
        ok window-library-honest-with-no-screen
    else
        bad window-library-honest-with-no-screen
        echo "  got $g"
    fi
fi

# a program that wants a screen must say so, not fall over, when
# there is not one
cat > /tmp/sov-nodisp.sov <<'NEOF'
use win
main:
    w: win_open(100, 100, "x")
    if w is 0
        print "nodisplay"
        stop
    print "opened"
NEOF
if $SOV /tmp/sov-nodisp.sov -o /tmp/sov-nodisp >/dev/null 2>&1; then
    g=$(env -u DISPLAY /tmp/sov-nodisp 2>&1)
    if [ "$g" = "nodisplay" ]; then ok window-without-a-screen; else bad window-without-a-screen; echo "  got $g"; fi
fi

# ---- the bot libraries, against a service we run ourselves ----
# The real ones need the locked kind of connection, which is tested
# separately. What is checked here is everything else: building the
# request, reading the reply, pulling the message out of the JSON.
python3 - <<'PYEOF' &
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _send(self, obj):
        b = json.dumps(obj).encode()
        self.send_response(200); self.send_header("Content-Type","application/json")
        self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        if "getMe" in self.path:
            self._send({"ok":True,"result":{"username":"sovren_test_bot"}})
        elif "getUpdates" in self.path:
            self._send({"ok":True,"result":[{"update_id":1,"message":{"message_id":7,"chat":{"id":999},"text":"hello bot","from":{"username":"elxan"}}}]})
        else:
            self._send({"ok":True})
    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        self._send({"ok":True,"echo":self.rfile.read(n).decode() if n else ""})
HTTPServer(("127.0.0.1", 8877), H).serve_forever()
PYEOF
srvpid=$!
sleep 2
cat > /tmp/sov-tg.sov <<'TEOF'
use telegram
use num
use sys
main:
    t: tg_new("test:token")
    tg_base(t, "http://127.0.0.1:8877")
    if str_eq(tg_me(t), "sovren_test_bot") is 0
        print "bad-me"
        stop
    n: tg_poll(t)
    if n is not 1
        print "bad-count"
        stop
    if str_eq(tg_text(t, 0), "hello bot") is 0
        print "bad-text"
        stop
    if tg_chat(t, 0) is not 999
        print "bad-chat"
        stop
    if tg_say(t, 999, "hi back") is not 1
        print "bad-send"
        stop
    print "telegram-ok"
TEOF
if $SOV /tmp/sov-tg.sov -o /tmp/sov-tg >/dev/null 2>&1; then
    g=$(timeout 30 /tmp/sov-tg 2>/dev/null | tail -1)
    if [ "$g" = "telegram-ok" ]; then ok telegram-bot; else bad telegram-bot; echo "  got $g"; fi
else
    bad "could not build the telegram check"
    $SOV /tmp/sov-tg.sov -o /tmp/sov-tg 2>&1 | tail -3
fi
kill $srvpid 2>/dev/null

# ---- macOS and Windows are checked by check/all.sov now ----
# The emulator is library/x86.sov, written in Sovren. It runs the PE
# and the Mach-O, and it refuses a raw syscall the way real hardware
# does. run_pe.py and run_macho.py are gone, and so is Unicorn.
#
# One thing stays here: sovren.exe building itself. It needs a real
# Windows, or Wine standing in for one, and it is slow.

# ---- Windows (needs wine) ----
if command -v wine >/dev/null 2>&1; then
    WINEDEBUG=-all; export WINEDEBUG
    if [ -z "$WINEPREFIX" ]; then WINEPREFIX="$HOME/.cache/wp"; export WINEPREFIX; fi
    mkdir -p "$WINEPREFIX" 2>/dev/null

    printf '%s\n' 'main:' '    print 5 * 3 / 2' > /tmp/sov-w1.sov
    $SOV /tmp/sov-w1.sov --windows -o /tmp/sov-w1.exe >/dev/null 2>&1
    g=$(timeout 120 wine /tmp/sov-w1.exe 2>/dev/null | tr -d '\r\n')
    if [ "$g" = "7" ]; then ok windows-run; else bad windows-run; echo "  got $g"; fi

    printf '%s\n' 'add a b:' '    return a + b' '' 'main:' '    print add(40, 2)' > /tmp/sov-w2.sov
    $SOV /tmp/sov-w2.sov --windows -o /tmp/sov-w2.exe >/dev/null 2>&1
    g=$(timeout 120 wine /tmp/sov-w2.exe 2>/dev/null | tr -d '\r\n')
    if [ "$g" = "42" ]; then ok windows-job; else bad windows-job; echo "  got $g"; fi

    printf '%s\n' 'use sha256' 'main:' '    print sha256_hex("abc")' > /tmp/sov-w3.sov
    $SOV /tmp/sov-w3.sov --windows -o /tmp/sov-w3.exe >/dev/null 2>&1
    g=$(timeout 120 wine /tmp/sov-w3.exe 2>/dev/null | tr -d '\r\n')
    if [ "$g" = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" ]; then
        ok windows-sha256
    else bad windows-sha256; echo "  got $g"; fi

    # sovren.exe must be able to build itself, byte for byte
    $SOV windows/compiler.sov --windows -o /tmp/sov-selfw.exe >/dev/null 2>&1
    timeout 400 wine /tmp/sov-selfw.exe windows/compiler.sov -o /tmp/sov-selfw2.exe >/dev/null 2>&1
    a=$(sha256sum /tmp/sov-selfw.exe 2>/dev/null | cut -d" " -f1)
    b=$(sha256sum /tmp/sov-selfw2.exe 2>/dev/null | cut -d" " -f1)
    if [ -n "$a" ] && [ "$a" = "$b" ]; then ok windows-self-host; else bad windows-self-host; fi
else
    skip "windows (apt install wine)"
fi

# ---- editor libraries (tui, list insert/delete) ----
printf '%s\n' 'use list' 'main:' '    l: list_new()' '    l: list_add(l, 1)' '    l: list_add(l, 3)' '    l: list_ins(l, 1, 2)' '    print list_get(l, 1)' > /tmp/sov-li.sov
$SOV /tmp/sov-li.sov -o /tmp/sov-li.bin >/dev/null 2>&1
g=$(/tmp/sov-li.bin 2>/dev/null)
if [ "$g" = "2" ]; then ok list-insert; else bad list-insert; echo "  got $g"; fi

printf '%s\n' 'use list' 'main:' '    l: list_new()' '    l: list_add(l, 1)' '    l: list_add(l, 2)' '    l: list_del(l, 0)' '    print list_get(l, 0)' > /tmp/sov-ld.sov
$SOV /tmp/sov-ld.sov -o /tmp/sov-ld.bin >/dev/null 2>&1
g=$(/tmp/sov-ld.bin 2>/dev/null)
if [ "$g" = "2" ]; then ok list-delete; else bad list-delete; echo "  got $g"; fi

printf '%s\n' 'use tui' 'main:' '    tui_goto(3, 5)' > /tmp/sov-tui.sov
$SOV /tmp/sov-tui.sov -o /tmp/sov-tui.bin >/dev/null 2>&1
g=$(/tmp/sov-tui.bin 2>/dev/null | od -An -c | tr -d ' \n')
if [ "$g" = "033[3;5H" ]; then ok tui-goto; else bad tui-goto; echo "  got $g"; fi

$SOV edit.sov -o /tmp/sov-edit >/dev/null 2>&1
rm -f /tmp/sov-ed.txt
printf 'hello\023\021' | timeout 30 /tmp/sov-edit /tmp/sov-ed.txt >/dev/null 2>&1
g=$(cat /tmp/sov-ed.txt 2>/dev/null)
if [ "$g" = "hello" ]; then ok editor; else bad editor; echo "  got '$g'"; fi

# A program that reads keys must stop when there are no more, not
# spin on nothing. The editor used to sit there forever, and then
# fall over, when its input ran out.
timeout 20 /tmp/sov-edit /tmp/sov-ed3.txt </dev/null >/dev/null 2>&1
rc=$?
if [ "$rc" = "0" ]; then
    ok editor-stops-when-input-ends
else
    bad editor-stops-when-input-ends
    if [ "$rc" = "124" ]; then echo "  it hung"; else echo "  it fell over, code $rc"; fi
fi

# Pressing escape on its own must not wedge the editor. An arrow
# key is escape followed by two more bytes; a bare escape has
# nothing behind it, and reading two more regardless sat there
# forever. This sends one escape down a pipe that stays open, then
# a quit, and insists the quit is acted on.
if command -v mkfifo >/dev/null 2>&1; then
    rm -f /tmp/sov-kf
    mkfifo /tmp/sov-kf 2>/dev/null
    ( printf '\033'; sleep 3; printf '\021'; sleep 10 ) > /tmp/sov-kf &
    feeder=$!
    timeout 15 /tmp/sov-edit /tmp/sov-esc.txt < /tmp/sov-kf >/dev/null 2>&1
    rc=$?
    kill $feeder 2>/dev/null
    rm -f /tmp/sov-kf
    if [ "$rc" = "0" ]; then
        ok editor-survives-a-bare-escape
    else
        bad editor-survives-a-bare-escape
        if [ "$rc" = "124" ]; then echo "  it wedged on the escape"; fi
    fi
fi

# and the arrow keys must still move the cursor rather than being
# typed in as letters
rm -f /tmp/sov-arrow.txt
printf 'ab\033[Dx\023\021' | timeout 20 /tmp/sov-edit /tmp/sov-arrow.txt >/dev/null 2>&1
g=$(cat /tmp/sov-arrow.txt 2>/dev/null)
if [ "$g" = "axb" ]; then ok editor-arrow-keys; else bad editor-arrow-keys; echo "  got '$g'"; fi

# and so must every other example, with nothing to read
for ex in hello.sov show.sov play.sov guess.sov mysite.sov; do
    if $SOV "$ex" -o /tmp/sov-ex >/dev/null 2>&1; then
        timeout 25 /tmp/sov-ex </dev/null >/dev/null 2>&1
        r=$?
        if [ "$r" = "124" ]; then bad "$ex stops on its own"; else ok "$ex stops on its own"; fi
    fi
done

for tgt in --android --ios --android-so; do
    if $SOV hello.sov $tgt -o /tmp/sov-tgt.bin >/dev/null 2>&1; then
        ok "target$tgt"
    else
        bad "target$tgt"
    fi
done

if [ "$fail" = "0" ]; then
    echo "all checks passed"
    exit 0
fi
echo "some checks failed"
exit 1
