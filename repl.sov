# unsafe-module
# Explicit source replaces drifted line-number macro fragments.
use arg
use file
use list
use num
use string
use sys
use tool
RP_SRC: ""
RP_BIN: ""
RP_EOF: 0
rp_line:
    buf: _sov_alloc(4096)
    one: _sov_alloc(1)
    n: 0
    going: 1
    as long as going is 1
        got: sys_read(0, one, 1)
        if got < 1
            going: 0
            if n is 0
                RP_EOF: 1
        if not
            c: peek_byte(one, 0)
            if c is 10
                going: 0
            if not
                if c is not 13
                    if n < 4095
                        poke_byte(buf, n, c)
                        n: n + 1
    poke_byte(buf, n, 0)
    return as text buf
rp_compiler:
    if file_exists("compilers/linux/compiler") is 1
        return "compilers/linux/compiler"
    me: arg_at(0)
    i: str_len(me)
    as long as i > 0
        i: i - 1
        if peek_byte(me, i) is 47
            root: str_cut(me, 0, i)
            path: str_cat(root, "/compilers/linux/compiler")
            if file_exists(path) is 1
                return as text path
    return "compilers/linux/compiler"
rp_compile uses line want:
    src: str_cat(uses, "main:\n")
    if want is 1
        src: str_cat(src, "    print ")
    if not
        src: str_cat(src, "    ")
    src: str_cat(src, str_cat(line, "\n"))
    file_delete(RP_BIN)
    if file_write_all(RP_SRC, src) is 0
        return "Error: cannot write REPL input"
    args: list_new()
    args: list_add(args, RP_SRC)
    args: list_add(args, "-o")
    args: list_add(args, RP_BIN)
    return as text tool_outv(rp_compiler(), args)
rp_error output:
    p: str_find(output, "Error")
    if p >= 0
        write_out(str_cut(output, p, str_len(output)))
    if not
        write_out(output)
    write_out("\n")
rp_show output:
    if str_has(output, "Error") is 1
        rp_error(output)
        return 0
    if file_exists(RP_BIN) is 0
        print "Error: REPL compilation produced no executable"
        return 0
    got: tool_outv(RP_BIN, list_new())
    write_out(got)
    if str_len(got) is 0
        write_out("ok\n")
    return 1
rp_try uses line:
    first: rp_compile(uses, line, 1)
    if str_has(first, "Error") is 1
        second: rp_compile(uses, line, 0)
        if str_has(second, "Error") is 1
            rp_error(first)
            return 0
        return rp_show(second)
    return rp_show(first)
main:
    tag: str_cat("/tmp/sov-repl-", num_text(sys_getpid()))
    RP_SRC: str_cat(tag, ".sov")
    RP_BIN: str_cat(tag, ".bin")
    uses: ""
    script: arg_at(1)
    scripted: 0
    lines: list_new()
    if str_len(script) > 0
        data: file_read_all(script)
        if data is 0
            print "Error: cannot read REPL script"
            sys_exit(1)
        lines: str_lines(data)
        scripted: 1
    if scripted is 0
        print "Sovren. An expression a line; use name opens a library; quit leaves."
    index: 0
    going: 1
    as long as going is 1
        line: ""
        if scripted is 1
            if index >= list_len(lines)
                going: 0
            if not
                line: list_get(lines, index)
                index: index + 1
        if not
            write_out("sovren> ")
            line: rp_line()
            if RP_EOF is 1
                going: 0
        if going is 1
            if str_eq(line, "quit") is 1
                going: 0
            if str_eq(line, "exit") is 1
                going: 0
            if going is 1
                if str_starts(line, "use ") is 1
                    uses: str_cat(uses, str_cat(line, "\n"))
                    print "ok"
                if not
                    if str_len(line) > 0
                        rp_try(uses, line)
    file_delete(RP_SRC)
    file_delete(RP_BIN)
    return 0
