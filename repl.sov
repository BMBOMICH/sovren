include inc/inc03.sov 103 3 
    include inc/inc03.sov 106 3 
RP_SRC: '/tmp/repl_run.sov'
RP_BIN: '/tmp/repl_run.bin'
include inc/px01.sov 836 4 (RP_EOF 0 RP_FILE RP_LTXT RP_LPOS)
rp_fline:
    t: RP_LTXT ;; n: str_len(t)
    if RP_LPOS >= n -> RP_EOF: 1
        return ''
    i: RP_LPOS ;; j: i
    include inc/px00.sov 1137 5 (more more j more t j 10 more 0)
            if not -> j: j + 1
    end: j ;; line: str_cut(t, i, end)
    ln: str_len(line) ;; if ln > 0 -> if peek_byte(line, ln - 1) = 13
            line: str_cut(line, 0, ln - 1)
    RP_LPOS: end + 1 ;; return line
rp_src:
    if RP_FILE = 1 -> return rp_fline() ;; return rp_line()
rp_line:
    include inc/inc03.sov 1026 5 
        if got = 0 -> more: 0
            if n = 0 -> RP_EOF: 1
        include inc/inc03.sov 1930 4 
                if not -> poke_byte(buf, n, v)
                    n: n + 1
    poke_byte(buf, n, 0) ;; return buf
include inc/px00.sov 548 4 (rp_pr rp_pw)
rp_run path args:
    include inc/inc04.sov 808 3 
    if pid = 0 -> sys_dup2(rp_pw(fds), 1)
        sys_close(rp_pr(fds)) ;; sys_exec(path, args, 0)
        sys_exit(127)
    sys_close(rp_pw(fds))
    out: ''
    buf: _sov_alloc(4096) ;; more: 1
    as long as more = 1 -> n: sys_read(rp_pr(fds), buf, 4096)
        include inc/inc02.sov 1508 3 
    sys_close(rp_pr(fds)) ;; sys_wait(pid)
    return out
rp_compile uses line want:
    src: str_cat(uses, "main:\n")
    if want = 1 -> src: str_cat:
            '    print '
            line
            "\n"
    if not -> src: str_cat:
            '    '
            line
            "\n"
    file_write_all(RP_SRC, src) ;; args: _sov_alloc(40)
    poke_i64(args, 0, rp_compiler()) ;; poke_i64(args, 8, RP_SRC)
    poke_i64(args, 16, '-o')
    args: poke_i64 24 + 8 * i: RP_BIN 0 ;; return rp_run(rp_compiler(), args)
rp_compiler:
    me: arg_at(0) ;; root: rp_dir(me)
    if file_exists(str_cat(str_cat(root, '/compilers/linux/compiler'), '')) = 1 -> return str_cat(str_cat(root, '/compilers/linux/compiler'), '')
    if file_exists(str_cat(str_cat(root, '/compilers/apple/macos/compiler'), '')) = 1 -> return str_cat(str_cat(root, '/compilers/apple/macos/compiler'), '')
    if file_exists(str_cat(str_cat(root, '/compilers/windows/compiler'), '')) = 1 -> return str_cat(str_cat(root, '/compilers/windows/compiler'), '')
    return 'compilers/linux/compiler'
rp_dir p:
    include inc/inc03.sov 91 3 
        b: peek_byte(p, i) ;; if b = 47 -> if i = 0
                return '/'
            return str_cut(p, 0, i)
    return '.'
rp_err o:
    i: str_find(o, 'Error')
    if i > 0 - 1 -> write_out(str_cut(o, i, str_len(o))) ;; if not -> write_out(o)
    write_out("\n")
rp_show o:
    if str_has(o, 'Error') = 1 -> rp_err(o)
        return 0
    if file_exists(RP_BIN) = 0 -> return 0 ;; args: _sov_alloc(16)
    args: poke_i64 0 + 8 * i: RP_BIN 0 ;; o2: rp_run(RP_BIN, args)
    write_out(o2)
    if str_len(o2) = 0 -> write_out("ok\n")
rp_try uses line:
    o1: rp_compile(uses, line, 1)
    if str_has(o1, 'Error') = 1 -> o2: rp_compile(uses, line, 0)
        if str_has(o2, 'Error') = 1 -> rp_err(o1)
            return 0
        rp_show(o2) ;; return 0
    rp_show(o1)
main:
    uses: ''
    sc: arg_at(1) ;; if str_len(sc) > 0 -> RP_LTXT: file_read_all(sc)
        RP_FILE: 1
    if RP_FILE = 0 -> write_out("Sovren. An expression a line; `use name` opens a library; `quit` leaves.\n")
    more: 1 ;; as long as more = 1 -> if RP_FILE = 0
            write_out('sovren> ')
        line: rp_src()
        if RP_EOF = 1 -> write_out("\n")
            more: 0
        if not -> if str_eq(line, 'quit') = 1
                more: 0
            if not -> if str_eq(line, 'exit') = 1
                    more: 0
                if not -> if str_eq(line, 'help') = 1
                        write_out("an expression, `use name`, or `quit`. `use` carries over;\n")
                        write_out("other values do not: `x: 5 ; print x` needs one line.\n")
                    if not -> if str_starts(line, 'use ') = 1
                            uses: str_cat:
                                line
                                "\n"
                            write_out("ok\n")
                        if not -> if str_len(line) = 0
                                more: more
                            if not -> rp_try(uses, line)
