# launcher.sov — pick a machine and run that compiler.
#
# This is the `sovren` command, written in Sovren. Build it with:
#
#   ./sovren launcher.sov -o sovren-bin
#
# It reads the flags, works out which compiler to use, and hands the
# rest of the arguments over.

use arg
use string
use file
use proc
use sys
use dir

lc_version:
    print "Sovren 0.1.0"
    return 0

lc_help:
    print "Usage: sovren <file.sov> [-o out] [target]"
    print ""
    print "Targets:"
    print "  (none)         Linux, ELF x86-64"
    print "  --windows      Windows, PE32+ x86-64"
    print "  --mac          macOS, Mach-O x86-64"
    print "  --android      Android, ELF aarch64"
    print "  --android-so   Android shared library"
    print "  --ios          iOS, Mach-O arm64, code signed"
    print "  --bare         Bare metal, no OS"
    print ""
    print "  --arm64 is another name for --android."
    print "  --macos is another name for --mac."
    print ""
    print "Other:"
    print "  --debug          Trace the program line by line"
    print "                     (add --interactive to step)"
    print "  --version, -v  Print the version"
    print "  --help, -h  Print this"
    return 0

# is this word one of the target flags?
lc_is_target a:
    if str_eq(a, "--linux") is 1
        return 1
    if str_eq(a, "--windows") is 1
        return 1
    if str_eq(a, "--mac") is 1
        return 1
    if str_eq(a, "--macos") is 1
        return 1
    if str_eq(a, "--android") is 1
        return 1
    if str_eq(a, "--android-so") is 1
        return 1
    if str_eq(a, "--ios") is 1
        return 1
    if str_eq(a, "--arm64") is 1
        return 1
    return 0

# which folder holds the compiler for this flag
lc_dir_for a:
    if str_eq(a, "--windows") is 1
        return as text "windows"
    if str_eq(a, "--mac") is 1
        return as text "macos"
    if str_eq(a, "--macos") is 1
        return as text "macos"
    if str_eq(a, "--android") is 1
        return as text "android"
    if str_eq(a, "--arm64") is 1
        return as text "android"
    if str_eq(a, "--ios") is 1
        return as text "ios"
    return as text "linux"

main:
    n: arg_count()
    if n < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        stop

    # the flags that answer and stop
    i: 1
    as long as i < n
        a: as text arg_at(i)
        if str_eq(a, "--version") is 1
            lc_version()
            stop
        if str_eq(a, "-v") is 1
            lc_version()
            stop
        if str_eq(a, "--help") is 1
            lc_help()
            stop
        if str_eq(a, "-h") is 1
            lc_help()
            stop
        i: i + 1

    # which compiler. the running launcher's own image says the host:
    # MZ is Windows (PE compilers), Mach-O magic is macOS (.macho
    # compilers), anything else is the ELF compilers Linux already has.
    which: "linux"
    host_win: 0
    host_mac: 0
    me0: lc_unquote(as text arg_at(0))
    if str_ends(me0, ".exe") is 1
        host_win: 1
        which: "windows"
    if not
        if str_has(me0, ".exe") is 1
            host_win: 1
            which: "windows"
        if not
            hdr: file_read_all(me0)
            if hdr is not 0
                b0: peek_byte(hdr, 0)
                if b0 is 77
                    host_win: 1
                    which: "windows"
                if b0 is 207
                    host_mac: 1
                    which: "macos"
                if b0 is 254
                    host_mac: 1
                    which: "macos"
    so: 0
    i: 1
    as long as i < n
        a: as text arg_at(i)
        if str_eq(a, "--android-so") is 1
            so: 1
            which: "android"
        if not
            if lc_is_target(a) is 1
                which: lc_dir_for(a)
        i: i + 1

    # an output name ending in .exe means Windows
    i: 1
    as long as i < n - 1
        if str_eq(as text arg_at(i), "-o") is 1
            out: as text arg_at(i + 1)
            if str_ends(out, ".exe") is 1
                which: "windows"
        i: i + 1

    # where this launcher lives, so the compiler is found from
    # any folder
    me: me0
    root: as text dir_of(me)

    # --debug: hand the whole argument list to the debugger,
    # which sits next to this launcher
    dbg: 0
    i: 1
    as long as i < n
        if str_eq(as text arg_at(i), "--debug") is 1
            dbg: 1
        i: i + 1
    if dbg is 1
        dbgpath: str_cat(root, "/sovren-dbg")
        if host_win is 1
            dbgpath: str_cat(dbgpath, ".exe")
        if host_mac is 1
            dbgpath: str_cat(dbgpath, ".macho")
        if file_exists(dbgpath) is 0
            write_out("Error: no sovren-dbg at ")
            print dbgpath
            stop
        lc_exec_dbg(dbgpath, n)

    if so is 1
        which: "android-so"
    path: str_cat(root, "/compilers/")
    path: str_cat(path, which)
    path: str_cat(path, "/")
    if so is 1
        path: str_cat(path, "compiler-so")
    if not
        path: str_cat(path, "compiler")

    if host_win is 1
        path: str_cat(path, ".exe")
    if host_mac is 1
        path: str_cat(path, ".macho")
    if file_exists(path) is 0
        if str_ends(path, ".exe") is 0
            pexe: str_cat(path, ".exe")
            if file_exists(pexe) is 1
                path: pexe
    if file_exists(path) is 0
        write_out("Error: no compiler at ")
        print path
        stop

    # hand over everything except the target flags
    lc_exec(path, n)

# windows wraps argv[0] in quotes. file calls and .exe detection
# need the plain path.
lc_unquote s:
    n: str_len(s)
    if n is 0
        return s
    a: 0
    b: n
    if peek_byte(s, 0) is 34
        a: 1
    if n > a
        if peek_byte(s, n - 1) is 34
            b: n - 1
    if a is 0
        if b is n
            return s
    if b < a + 1
        return s
    return as text str_cut(s, a, b)

# windows has no execve. the windows compiler replaces this
# with CreateProcessA; the stub is what linux and mac keep.
_sov_win_exec path argv:
    return 0

# the folder part of a path
dir_of p:
    n: str_len(p)
    if n is 0
        return as text "."
    i: n
    as long as i > 0
        i: i - 1
        b: peek_byte(p, i)
        if b is 92
            b: 47
        if b is 47
            if i is 0
                return as text "/"
            return as text str_cut(p, 0, i)
    return as text "."

# build the argument list and become the debugger; no filtering,
# the debugger parses its own flags
lc_exec_dbg path n:
    argv: _sov_alloc(256)
    poke_i64(argv, 0, path)
    i: 1
    as long as i < n
        poke_i64(argv, i * 8, as text arg_at(i))
        i: i + 1
    poke_i64(argv, n * 8, 0)
    if str_ends(path, ".exe") is 1
        _sov_win_exec(path, argv)
        print "Error: could not start the debugger"
        return 1
    syscall(59, path, argv, 0, 0, 0, 0)
    print "Error: could not start the debugger"
    return 1

# build the argument list and become the compiler
lc_exec path n:
    argv: _sov_alloc(256)
    poke_i64(argv, 0, path)
    k: 1
    i: 1
    as long as i < n
        a: as text arg_at(i)
        keep: 1
        if lc_is_target(a) is 1
            keep: 0
        if str_eq(a, "--android-so") is 1
            keep: 0
        if keep is 1
            poke_i64(argv, k * 8, a)
            k: k + 1
        i: i + 1
    poke_i64(argv, k * 8, 0)
    if str_ends(path, ".exe") is 1
        _sov_win_exec(path, argv)
        print "Error: could not start the compiler"
        return 1
    syscall(59, path, argv, 0, 0, 0, 0)
    print "Error: could not start the compiler"
    return 1
