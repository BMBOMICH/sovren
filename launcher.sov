# launcher.sov — pick a machine and run that compiler.
#
# This is the `sovren` command, written in Sovren. Build it with:
#
#   ./sovren launcher.sov -o sovren-bin
#
# It reads the flags, works out which compiler to use, and hands the
# rest of the arguments over.

use arg
use string
use file
use proc
use sys
use dir

lc_version:
    print "Sovren 0.1.0"
    return 0

lc_help:
    print "Usage: sovren <file.sov> [-o out] [target]"
    print ""
    print "Targets:"
    print "  (none)         Linux, ELF x86-64"
    print "  --windows      Windows, PE32+ x86-64"
    print "  --mac          macOS, Mach-O x86-64"
    print "  --android      Android, ELF aarch64"
    print "  --android-so   Android shared library"
    print "  --ios          iOS, Mach-O arm64, code signed"
    print "  --bare         Bare metal, no OS"
    print ""
    print "  --arm64 is another name for --android."
    print "  --macos is another name for --mac."
    print ""
    print "Other:"
    print "  --version, -v  Print the version"
    print "  --help, -h     Print this"
    print ""
    print "Read book.md to learn the language."
    return 0

# is this word one of the target flags?
lc_is_target a:
    if str_eq(a, "--linux") is 1
        return 1
    if str_eq(a, "--windows") is 1
        return 1
    if str_eq(a, "--mac") is 1
        return 1
    if str_eq(a, "--macos") is 1
        return 1
    if str_eq(a, "--android") is 1
        return 1
    if str_eq(a, "--android-so") is 1
        return 1
    if str_eq(a, "--ios") is 1
        return 1
    if str_eq(a, "--arm64") is 1
        return 1
    return 0

# which folder holds the compiler for this flag
lc_dir_for a:
    if str_eq(a, "--windows") is 1
        return as text "windows"
    if str_eq(a, "--mac") is 1
        return as text "mac"
    if str_eq(a, "--macos") is 1
        return as text "mac"
    if str_eq(a, "--android") is 1
        return as text "android"
    if str_eq(a, "--arm64") is 1
        return as text "android"
    if str_eq(a, "--ios") is 1
        return as text "ios"
    return as text "linux"

main:
    n: arg_count()
    if n < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, no C, no Python"
        stop

    # the flags that answer and stop
    i: 1
    as long as i < n
        a: as text arg_at(i)
        if str_eq(a, "--version") is 1
            lc_version()
            stop
        if str_eq(a, "-v") is 1
            lc_version()
            stop
        if str_eq(a, "--help") is 1
            lc_help()
            stop
        if str_eq(a, "-h") is 1
            lc_help()
            stop
        i: i + 1

    # which compiler
    which: "linux"
    so: 0
    i: 1
    as long as i < n
        a: as text arg_at(i)
        if str_eq(a, "--android-so") is 1
            so: 1
            which: "android"
        if not
            if lc_is_target(a) is 1
                which: lc_dir_for(a)
        i: i + 1

    # an output name ending in .exe means Windows
    i: 1
    as long as i < n - 1
        if str_eq(as text arg_at(i), "-o") is 1
            out: as text arg_at(i + 1)
            if str_ends(out, ".exe") is 1
                which: "windows"
        i: i + 1

    # where this launcher lives, so the compiler is found from
    # any folder
    me: as text arg_at(0)
    root: as text dir_of(me)

    path: str_cat(root, "/")
    path: str_cat(path, which)
    if so is 1
        path: str_cat(path, "/compiler_so")
    if not
        path: str_cat(path, "/compiler")

    if file_exists(path) is 0
        write_out("Error: no compiler at ")
        print path
        stop

    # hand over everything except the target flags
    lc_exec(path, n)

# the folder part of a path
dir_of p:
    n: str_len(p)
    if n is 0
        return as text "."
    i: n
    as long as i > 0
        i: i - 1
        b: peek_byte(p, i)
        if b is 92
            b: 47
        if b is 47
            if i is 0
                return as text "/"
            return as text str_cut(p, 0, i)
    return as text "."

# build the argument list and become the compiler
lc_exec path n:
    argv: _sov_alloc(256)
    poke_i64(argv, 0, path)
    k: 1
    i: 1
    as long as i < n
        a: as text arg_at(i)
        keep: 1
        if lc_is_target(a) is 1
            keep: 0
        if str_eq(a, "--android-so") is 1
            keep: 0
        if keep is 1
            poke_i64(argv, k * 8, a)
            k: k + 1
        i: i + 1
    poke_i64(argv, k * 8, 0)
    syscall(59, path, argv, 0, 0, 0, 0)
    print "Error: could not start the compiler"
    return 1
