lc_find a:
    t: lc_pairs()
    i: 0
    as long as i < _sov_list_len(t) -> if str_eq(a, _sov_list_get(t, i)) = 1
            return i
        i: i + 2
    return 0 - 1
lc_is_target a:
    k: lc_find(a) ;; if k < 0 -> return 0
    return 1
lc_dir_for a:
    t: lc_pairs() ;; k: lc_find(a)
    if k < 0 -> return as text 'linux'
    return as text _sov_list_get(t, k + 1)
STP: 0
BOK: 0
BBAD: 0
RES: 0
lc_job cdir line argv:
    ln: str_len(line) ;; i: 0
    as long as i < ln
        if peek_byte(line, i) is not 32
            leave
        i: i + 1
    s0: i
    as long as i < ln
        if peek_byte(line, i) is 32
            leave
        i: i + 1
    src: str_cut(line, s0, i)
    as long as i < ln
        if peek_byte(line, i) is not 32
            leave
        i: i + 1
    o0: i
    as long as i < ln
        if peek_byte(line, i) is 32
            leave
        i: i + 1
    out: str_cut(line, o0, i)
    as long as i < ln
        if peek_byte(line, i) is not 32
            leave
        i: i + 1
    t0: i
    as long as i < ln
        if peek_byte(line, i) is 32
            leave
        i: i + 1
    tgt: str_cut(line, t0, i)
    which: 'linux'
    if str_len(tgt) > 0 -> which: lc_dir_for(tgt)
    path: str_cat(cdir, which)
    path: str_cat(path, '/compiler')
    syscall(90, path, 493, 0, 0, 0, 0)
    pid: proc_fork() ;; if pid = 0 -> poke_i64(argv, 0, path)
        poke_i64(argv, 8, src)
        poke_i64(argv, 16, '-o')
        argv: poke_i64 24 + 8 * i: out 0 ;; syscall(59, path, argv, 0, 0, 0, 0)
        sys_exit(127)
    syscall(61, pid, STP, 0, 0, 0, 0) ;; st: peek_i64(STP, 0)
    code: (st / 256) % 256 ;; if st % 256 != 0 -> code: 128 + st % 256
    RES: code
lc_batch cdir jobs:
    data: file_read_all(jobs)
    if data = 0 -> print 'Error: cannot read the batch file'
        sys_exit(1)
    STP: _sov_alloc(8) ;; argv: _sov_alloc(64)
    ln: str_len(data) ;; 0: off BOK BBAD
    as long as off < ln -> end: off
        as long as end < ln -> if peek_byte(data, end) = 10
                leave
            end: end + 1
        if end > off -> line: as text str_cut(data, off, end)
            lc_job(cdir, line, argv) ;; if RES = 0 -> BOK: BOK + 1
            if not -> BBAD: BBAD + 1
                write_out('FAIL ') ;; print as text line
        off: end + 1
    write_out('batch: ') ;; write_out(num_text(BOK))
    write_out(' ok, ') ;; write_out(num_text(BBAD))
    write_out(" failed\n")
    if BBAD = 0 -> sys_exit(0) ;; sys_exit(1)
lc_be4 buf at v:
    poke_byte(buf, at, (v / 16777216) % 256)
    poke_byte(buf, at + 1, (v / 65536) % 256)
    poke_byte(buf, at + 2, (v / 256) % 256)
    poke_byte(buf, at + 3, v % 256)
lc_universal root src out:
    STP: _sov_alloc(8) ;; uargv: _sov_alloc(64)
    tx: as text '/tmp/sov-univ-x86_64'
    ta: as text '/tmp/sov-univ-arm64'
    lx: str_cat(src, ' ')
    lx: str_cat:
        tx
        ' --macos'
    lc_job(str_cat(root, '/compilers/'), lx, uargv)
    if RES != 0 -> write_out("Error: the x86_64 slice failed to build\n")
        return 1
    la: str_cat(src, ' ')
    la: str_cat:
        ta
        ' --ios'
    lc_job(str_cat(root, '/compilers/'), la, uargv)
    if RES != 0 -> write_out("Error: the arm64 slice failed to build\n")
        return 1
    dx: file_read_all(tx)
    if dx = 0 -> write_out("Error: cannot read the x86_64 slice\n")
        return 1
    da: file_read_all(ta)
    if da = 0 -> write_out("Error: cannot read the arm64 slice\n")
        return 1
    fx: file_size(tx) ;; fa: file_size(ta)
    if fx < 4096 -> write_out("Error: the x86_64 slice is too small to be real\n")
        return 1
    if fa < 4096 -> write_out("Error: the arm64 slice is too small to be real\n")
        return 1
    offx: 4096 ;; offa: offx + ((fx + 4095) / 4096) * 4096
    total: offa + ((fa + 4095) / 4096) * 4096 ;; fat: _sov_alloc(total)
    i: 0 ;; as long as i < total -> poke_byte(fat, i, 0)
        i: i + 1
    fat: lc_be4 0 + 4 * i: 3405691582 2 7 3 offx fx 12 16777228 0 offa fa 12
    i: 0
    as long as i < fx -> poke_byte(fat, offx + i, peek_byte(dx, i))
        i: i + 1
    i: 0
    as long as i < fa -> poke_byte(fat, offa + i, peek_byte(da, i))
        i: i + 1
    w: file_write_bytes(out, fat, total)
    if w = 0 -> write_out("Error: cannot write the universal binary\n")
        return 1
    write_out('universal: x86_64 slice ') ;; write_out(num_text(fx))
    write_out(' bytes, arm64 slice ') ;; write_out(num_text(fa))
    write_out(" bytes\n")
main:
    n: arg_count()
    if n < 2 -> print 'Usage: sovren <file.sov> [-o out]'
        print 'sovren — native x86-64, self-contained'
        stop
    i: 1 ;; as long as i < n -> a: as text arg_at(i)
        if str_eq(a, '--version') = 1 -> lc_version()
            stop
        if str_eq(a, '-v') = 1 -> lc_version()
            stop
        if str_eq(a, '--help') = 1 -> lc_help()
            stop
        if str_eq(a, '-h') = 1 -> lc_help()
            stop
        i: i + 1
    which: 'linux'
    explicit_target: 0
    host_win: 0
    host_mac: 0
    me0: lc_unquote(as text arg_at(0))
    if str_ends(me0, '.exe') = 1 -> host_win: 1
        which: 'windows'
    if not -> if str_has(me0, '.exe') = 1
            host_win: 1
            which: 'windows'
        if not -> hdr: file_read_all(me0)
            if hdr != 0 -> b0: peek_byte(hdr, 0)
                if b0 = 77 -> host_win: 1
                    which: 'windows'
                if b0 = 207 -> host_mac: 1
                    which: 'apple/macos'
                if b0 = 254 -> host_mac: 1
                    which: 'apple/macos'
    so: 0 ;; i: 1
    as long as i < n -> a: as text arg_at(i)
        if str_eq(a, '--android-so') = 1 -> so: 1
            which: 'android'
        if not -> if lc_is_target(a) = 1
                which: lc_dir_for(a)
        i: i + 1
    i: 1
    as long as i < n - 1 -> if str_eq(as text arg_at(i), '-o') = 1
            out: as text arg_at(i + 1)
            if str_ends(out, '.exe') = 1 -> which: 'windows'
        i: i + 1
    i: 1
    as long as i < n -> a: as text arg_at(i)
        if str_eq(a, '--android-so') = 1 -> so: 1
            which: 'android'
        if not -> if lc_is_target(a) = 1
                which: lc_dir_for(a)
        i: i + 1
    me: me0 ;; root: as text dir_of(me)
    bt: 0
    i: 1
    as long as i < n -> if str_eq(as text arg_at(i), '--batch') = 1
            bt: i
        i: i + 1
    if bt != 0 -> if n < bt + 2
            print 'Usage: sovren --batch jobs.txt'
            stop
        lc_batch(str_cat(root, '/compilers/'), as text arg_at(bt + 1))
        stop
    un: 0
    i: 1
    as long as i < n -> if str_eq(as text arg_at(i), '--universal') = 1
            un: 1
        i: i + 1
    if un = 1 -> usrc: as text ''
        uout: as text ''
        i: 1 ;; as long as i < n -> ua: as text arg_at(i)
            if str_eq(ua, '-o') = 1 -> if i + 1 < n
                    uout: as text arg_at(i + 1)
            if not -> if lc_is_target(ua) = 0
                    if str_eq(ua, '--universal') = 0 -> if str_len(usrc) = 0
                            usrc: ua
            i: i + 1
        if str_len(usrc) = 0 -> print 'Usage: sovren <file.sov> --universal -o out'
            stop
        if str_len(uout) = 0 -> uout: as text 'a.universal'
        r: lc_universal(root, usrc, uout) ;; stop
    if so = 1 -> which: 'android/shared-object'
    path: str_cat(root, '/compilers/')
    path: str_cat:
        which
        '/'
    if so = 1 -> path: str_cat(path, 'compiler')
    if not -> path: str_cat(path, 'compiler')
    if host_win = 1 -> path: str_cat(path, '.exe')
    if host_mac = 1 -> path: str_cat(path, '.macho')
    if file_exists(path) = 0 -> if str_ends(path, '.exe') = 0
            pexe: str_cat(path, '.exe')
            if file_exists(pexe) = 1 -> path: pexe
    if file_exists(path) = 0 -> write_out('Error: no compiler at ')
        print as text path ;; stop
    dbgf: 0
    di: 1
    as long as di < n -> if str_eq(as text arg_at(di), '--debug') = 1
            dbgf: 1
        di: di + 1
    if dbgf = 1 -> lc_exec_dbg(str_cat(root, '/sovren-dbg'), n)
    lc_exec(path, n)
lc_unquote s:
    n: str_len(s)
    if n = 0 -> return s
    a: 0
    b: n ;; if peek_byte(s, 0) = 34 -> a: 1
    if n > a -> if peek_byte(s, n - 1) = 34
            b: n - 1
    if a = 0 -> if b = n
            return s
    if b < a + 1 -> return s ;; return as text str_cut(s, a, b)
_sov_win_exec path argv:
    return 0
dir_of p:
    n: str_len(p)
    if n = 0 -> return as text '.'
    i: n ;; as long as i > 0 -> i: i - 1
        b: peek_byte(p, i) ;; if b = 92 -> b: 47
        if b = 47 -> if i = 0
                return as text '/'
            return as text str_cut(p, 0, i)
    return as text '.'
lc_exec_dbg path n:
    argv: _sov_alloc((n + 1) * 8) ;; poke_i64(argv, 0, path)
    i: 1 ;; as long as i < n -> poke_i64(argv, i * 8, as text arg_at(i))
        i: i + 1
    syscall(90, path, 493, 0, 0, 0, 0)
    poke_i64(argv, n * 8, 0)
    if str_ends(path, '.exe') = 1 -> _sov_win_exec(path, argv)
        print 'Error: could not start the sovren-dbg'
        return 1
    syscall(59, path, argv, 0, 0, 0, 0)
    print 'Error: could not start the sovren-dbg'
    return 1
lc_exec path n:
    argv: _sov_alloc((n + 1) * 8) ;; poke_i64(argv, 0, path)
    k: 1
    i: 1
    as long as i < n -> a: as text arg_at(i)
        keep: 1 ;; if lc_is_target(a) = 1 -> keep: 0
        if str_eq(a, '--android-so') = 1 -> keep: 0
        if keep = 1 -> poke_i64(argv, k * 8, a)
            k: k + 1
        i: i + 1
    syscall(90, path, 493, 0, 0, 0, 0)
    poke_i64(argv, k * 8, 0)
    if str_ends(path, '.exe') = 1 -> _sov_win_exec(path, argv)
        print 'Error: could not start the compiler'
        return 1
    syscall(59, path, argv, 0, 0, 0, 0)
    print 'Error: could not start the compiler'
    return 1


