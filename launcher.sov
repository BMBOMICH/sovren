use:
    include inc/px00.sov 6 4 (arg string file proc)
    sys ;; dir
    num

lc_version:
    print 'Sovren 0.1.0'
lc_help:
    print 'Usage: sovren <file.sov> [-o out] [target]' ;; print ''
    print 'Targets:'
    print:
        '  (none)         Linux, ELF x86-64'
        '  --freebsd      FreeBSD, ELF x86-64'
        '  --netbsd       NetBSD, ELF x86-64'
        '  --openbsd      OpenBSD, ELF x86-64'
        '  --dragonfly    DragonFly BSD, ELF x86-64'
        '  --redox        Redox OS, ELF x86-64'
        '  --qnx          QNX Neutrino, ELF x86-64'
        '  --serenityos   SerenityOS, ELF x86-64'
        '  --menuetos     MenuetOS 64, MENUET64 image (int 0x60)'
        '  --sovrenos     SovrenOS, ELF x86-64 (the native schema)'
        '  --illumos      illumos (OpenSolaris), ELF x86-64'
        '  --haiku        Haiku, ELF x86-64'
        '  --windows      Windows, PE32+ x86-64'
        '  --windows-arm64 Windows, PE32+ ARM64'
        '  --windows-dll Windows shared library, PE32+ x86-64 DLL'
        '  --mac          macOS, Mach-O x86-64'
        '  --macos-arm64  macOS, Mach-O arm64'
        '  --arm64e       macOS arm64e, Mach-O with pointer-authentication ABI'
        '  --arm64_32     watchOS arm64_32, Mach-O LP32 (64-bit hardware, 32-bit types)'
        '  --linux-arm64  Linux, ELF aarch64'
        '  --linux-armv7  Linux, ELF ARMv7 EABI'
        '  --armv5        Linux armv5 old-ABI (OABI) ELF32 executable'
        '  --armv7a-armel  Linux armv7a EABI5 soft-float ELF32 (armel)'
        '  --a / --lib     static archive (.a): ar(1) around an ELF relocatable object'
        '  --so / --shared  shared object (.so): reuse the ELF .so writer'
        '  --dll           import library / dynamic library (.dll)'
        '  --hypervisor    hypervisor image: ELF64 + PT_NOTE entry ABI'
        '  --eh-frame      ELF with a real .eh_frame (CIE + FDE) section'
        '  --pdata         PE with a real .pdata exception directory'
        '  --windows-store Microsoft Store packaged app'
        '  --windows-arm64ec  ARM64EC (x64 code under ARM64 emulation)'
        '  --harmonyos     HarmonyOS/OpenHarmony HAP package (ZIP + module.json)'
        '  --avr           ELF32 Atmel AVR (8-bit)'
        '  --msp430        ELF32 TI MSP430 (16-bit)'
        '  --arc           ELF32 Synopsys ARC (ARCompact)'
        '  --xtensa        ELF32 Tensilica Xtensa (ESP32)'
        '  --dex           Dalvik .dex bytecode container (Adler-32 + SHA-1)'
        '  --aix           XCOFF64 (AIX, magic 0x01F7)'
        '  --plan9         Plan 9 a.out (amd64 S_MAGIC)'
        '  --fuchsia       Fuchsia FAR archive (Zircon package container)'
        '  --hexagon       ELF32 Qualcomm Hexagon DSP6 (e_machine=164)'
        '  --riscv64-be    ELF64 RISC-V, big-endian'
        '  --arm64-sve     ELF64 AArch64 + SVE (v8.2-A) attributes'
        '  --arm64-sve2    ELF64 AArch64 + SVE2 (v9.0-A) attributes'
        '  --arm64-mte     ELF64 AArch64 + MTE (v8.5-A) attributes'
        '  --evm           Ethereum VM bytecode (PUSH1/STOP)'
        '  --hpux          HP-UX SOM executable (PA-RISC 1.1, a_magic 0x0108)'
        '  --c166          Infineon C166 OMF166 object module (absolute)'
        '  --8051          8051 raw image (MOV A,#n; SJMP .)'
        '  --z80           Zilog Z80 raw image (LD A,n; HALT)'
        '  --ez80          Zilog eZ80 raw image'
        '  --6502          6502 raw image (LDA #n; BRK)'
        '  --pic16         Microchip PIC16 raw image (MOVLW)'
        '  --pic18         Microchip PIC18 raw image (MOVLW)'
        '  --linux-riscv64 Linux, ELF riscv64gc'
        '  --riscv64v      Linux riscv64 + Vector (V) extension ELF64 (.riscv.attributes)'
        '  --riscv64h      Linux riscv64 + Hypervisor (H) extension ELF64 (.riscv.attributes)'
        '  --riscv32zfinx  Linux riscv32 + Zfinx extension ELF32 (.riscv.attributes)'
        '  --riscv32zdinx  Linux riscv32 + Zdinx extension ELF32 (.riscv.attributes)'
        '  --linux-ppc64le Linux, ELF ppc64le ELFv2'
        '  --linux-s390x Linux, ELF IBM Z/s390x'
        '  --linux-mips64 Linux, ELF MIPS64 N64 big-endian'
        '  --linux-mips64el Linux, ELF MIPS64 N64 little-endian'
        '  --linux-loongarch64 Linux, ELF LoongArch64'
        '  --linux-so     Linux shared library, ELF x86-64 .so'
        '  --linux-arm64-so Linux shared library, ELF aarch64 .so'
        '  --android      Android, ELF aarch64'
        '  --android-so   Android shared library'
        '  --wasi         WebAssembly wasm32-wasi command module'
        '  --wasm32       WebAssembly wasm32 unknown-unknown pure module'
        '  --wasm32-simd  WebAssembly wasm32 module with SIMD v128 probe'
        '  --wasm64       WebAssembly memory64 module with exported memory'
        '  --wasm32-threads WebAssembly wasm32 module with shared memory and atomics probe'
        '  --wasm32-browser Browser HTML wrapper with embedded wasm32 module'
        '  --wasm32-emscripten Emscripten-style HTML shell with Module/ccall/cwrap'
        '  --wasm32-edge Edge-worker JS module with embedded wasm32 module'
        '  --wasm-component WebAssembly component-model package with WIT/canonical ABI metadata'
        '  --wat          WebAssembly text module emitter'
        '  --js           JavaScript emitter for Node and browsers'
        '  --ts           TypeScript emitter'
        '  --jvm          JVM .class emitter'
        '  --csharp       C# source emitter for CLR/.NET-style runtimes'
        '  --cil          CIL/IL source emitter for CLR/.NET-style runtimes'
        '  --cil-pe       CIL PE/CLI assembly emitter for CLR/Mono runtimes'
        '  --metal        Metal Shading Language compute kernel emitter'
        '  --wgsl         WGSL compute shader source emitter'
        '  --glsl         GLSL 450 compute shader source emitter'
        '  --hlsl         HLSL compute shader source emitter'
        '  --metal-air    Packaged Metal AIR seed artifact'
        '  --metallib     Packaged Metal library seed artifact'
        '  --ptx          NVIDIA PTX kernel text emitter'
        '  --amdgcn       AMD GCN/RDNA kernel assembly text emitter'
        '  --intel-xe     Intel Xe/GEN kernel assembly text emitter'
        '  --spirv        SPIR-V compute module emitter'
        '  --ios          iOS, Mach-O arm64, code signed'
        '  --ios-framework iOS framework binary, Mach-O arm64 dylib'
        '  --ipados       iPadOS, the same file: it reports the iOS platform'
        '  --tvos         tvOS, Mach-O arm64'
        '  --watchos      watchOS, Mach-O arm64'
        '  --visionos     visionOS, Mach-O arm64'
        '  --ios-simulator      iOS simulator, the arm64 slice'
        '  --tvos-simulator     tvOS simulator'
        '  --watchos-simulator  watchOS simulator'
        '  --visionos-simulator visionOS simulator'
        '  --universal    macOS fat binary: x86_64 + arm64 slices'
        '  --uefi         UEFI x86-64 PE/COFF .efi application'
        '  --bare         Bare metal x86-64 flat image, no OS'
        '  --kernel       Alias for the bare x86-64 flat image'
        '  --cortex-m     ARM Cortex-M Thumb vector-table firmware image'
        '  --riscv64-bare RISC-V RV64 freestanding flat firmware image'
        '  --riscv32-bare RISC-V RV32IMAC freestanding flat firmware image'
        '  --riscv32e     RISC-V RV32E (16-register) freestanding flat firmware image'
        '  --thumbv7m     ARM Thumb ARMv7-M (Cortex-M3) vector-table firmware image'
        '  --thumbv7em    ARM Thumb ARMv7E-M (Cortex-M4/M7) vector-table firmware image'
        '  --thumbv6m     ARM Thumb ARMv6-M (Cortex-M0/M0+) vector-table firmware image'
        '  --thumbv8m     ARM Thumb ARMv8-M (Cortex-M23/M33) vector-table firmware image'
        '  --ihex         Intel HEX firmware packaging for the bare payload'
        '  --srec         Motorola S-record firmware packaging for the bare payload'
        '  --uf2          UF2 firmware packaging for the bare payload'
        '  --dfu          USB DFU/DfuSe firmware packaging for the bare payload'
        '  --firmware-img MCUboot IMG packaging for the bare payload'
        '  --freertos     FreeRTOS C task shim over the freestanding profile'
        '  --zephyr       Zephyr C thread shim over the freestanding profile'
        '  --nuttx        NuttX pthread-style C shim over the freestanding profile'
        '  --riot         RIOT thread_create C shim over the freestanding profile'
        '  --rt-thread    RT-Thread C shim over the freestanding profile'
        '  --mbed         Mbed OS C++ Thread shim over the freestanding profile'
        '  --threadx      Azure RTOS ThreadX C shim over the freestanding profile'
        '  --ti-rtos      TI-RTOS/SYS-BIOS Task shim over the freestanding profile'
        '  --embos        SEGGER embOS task shim over the freestanding profile'
        '  --chromium-ec  Chromium EC task shim over the freestanding profile'
        '  --kernel       Freestanding flat kernel payload'
        '  --sxe          Sovren Executable v1 container'
        '  --c            C source emitter (portable subset backend)'
        '  --llvm-ir      LLVM IR emitter (portable subset backend)'
        '  --ebpf         eBPF assembly emitter (EM_BPF, command subset)'
        '  --qbe          QBE IR emitter (portable reach-multiplier backend)'
        '  --multiboot    Multiboot1 bootable image (address-fields header)'
        '  --dos          DOS .COM program (x86-16 real mode, flat image)'
        '  --com          alias for --dos (DOS .COM)'
        '  --x86-16       alias for --dos (16-bit real mode)'
        '  --mz           DOS MZ .EXE executable (MZ header + code)'
        '  --dos-exe      alias for --mz (DOS .EXE)'
        '  --obj          COFF object file (.obj, x86-64 .text)'
        '  --coff         alias for --obj (COFF object)'
        '  --i386         Linux i386 ELF32 executable (int 0x80 syscall ABI)'
        '  --x32          Linux x32 ABI ELF32 (ILP32 on the x86-64 ISA)'
        '  --x86-64-v2    Linux x86-64-v2 ELF64 (GNU property marks ISA level v2)'
        '  --x86-64-v3    Linux x86-64-v3 ELF64 (GNU property marks ISA level v3)'
        '  --x86-64-v4    Linux x86-64-v4 ELF64 (GNU property marks ISA level v4)'
        '  --riscv32      Linux riscv32 (RV32IMAC) ELF32 executable'
        '  --mipsel       Linux mipsel (mips32el) ELF32 executable (o32 ABI)'
        '  --ppc64        Linux ppc64 (big-endian PowerPC64) ELF64 executable'
        '  --armhf        Linux armv7a hard-float ARM EABI5 ELF32 executable'
        '  --ppc32        Linux ppc32 (big-endian PowerPC32) ELF32 executable'
        '  --mips         Linux mips (big-endian mips32) ELF32 executable (o32 ABI)'
        '  --thumbv7a     Linux armv7a Thumb-2 ELF32 executable (Thumb entry bit)'
        '  --sparc64      Linux sparc64 (SPARC V9, big-endian) ELF64 executable'
        '  --sparc-v8     Linux sparc_v8 (SPARC V8, big-endian) ELF32 executable'
        '  --m68k         Linux m68k (Motorola 68000, big-endian) ELF32 executable'
        '  --microblaze   Linux microblaze (Xilinx MicroBlaze, big-endian) ELF32 executable'
        '  --openrisc     Linux openrisc (OpenRISC 1000, big-endian) ELF32 executable'
        '  --nios2        Linux nios2 (Altera Nios II, little-endian) ELF32 executable'
        '  --sh4          Linux sh4 (Renesas SuperH SH-4, big-endian) ELF32 executable'
        ''
        '  --arm64 is another name for --android.'
        '  --macos is another name for --mac.'
        '  --wasm32-wasi and --wasm are another name for --wasi.'
        ''
        'The same file, under the name that platform has for it:'
        '  --chromeos     ChromeOS, the Linux ABI'
        '  --linux-musl   Linux, musl systems (the output has no libc at all)'
        '  --linux-static Linux, static'
        '  --darwin       the Darwin POSIX layer, without the AppKit size of it'
        '  --android-tv   Android TV'
        '  --wear-os      Wear OS'
        '  --wine         the same PE file under Wine'
        '  --reactos      the same PE file under ReactOS'
        ''
        'Other:'
        '  --release        Run whole-program dead-code elimination (smaller output, slower build)'
        '  --debug          Trace the program line by line'
        '                     (add --interactive to step)'
        '  --version, -v  Print the version'
        '  --help, -h  Print this'
lc_pairs:
    t: _sov_list_new()
    include inc/px00.sov 1349 4 (linux linux windows windows)
    include inc/px00.sov 1349 4 (freebsd operating-systems/freebsd netbsd operating-systems/netbsd)
    include inc/px00.sov 1349 4 (openbsd operating-systems/openbsd bsd operating-systems/freebsd)
    include inc/px00.sov 1349 4 (dragonfly operating-systems/dragonfly dfly operating-systems/dragonfly)
    include inc/px00.sov 1349 4 (illumos operating-systems/illumos solaris operating-systems/illumos)
