# unsafe-module
use arg
use string
use file
use proc
use sys
use num
use dir

lc_version:
    print 'Sovren 0.1.0'
lc_help:
    print 'Usage: sovren <file.sov> [-o out] [target]'
    print 'Retained compiler targets:'
    print '  --android  android'
    print '  --android-so  android/shared-object'
    print '  --arm64_32  apple/arm64_32'
    print '  --arm64e  apple/arm64e'
    print '  --ios  apple/ios'
    print '  --ios-simulator  apple/ios-simulator'
    print '  --mac  apple/macos'
    print '  --macos-arm64  apple/macos-arm64'
    print '  --tvos  apple/tvos'
    print '  --tvos-simulator  apple/tvos-simulator'
    print '  --visionos  apple/visionos'
    print '  --visionos-simulator  apple/visionos-simulator'
    print '  --watchos  apple/watchos'
    print '  --watchos-simulator  apple/watchos-simulator'
    print '  --linux-arm64  linux/arm64'
    print '  --linux-arm64-so  linux/arm64-shared-object'
    print '  --linux  linux'
    print '  --dragonfly  operating-systems/dragonfly'
    print '  --freebsd  operating-systems/freebsd'
    print '  --haiku  operating-systems/haiku'
    print '  --illumos  operating-systems/illumos'
    print '  --menuetos  operating-systems/menuetos'
    print '  --netbsd  operating-systems/netbsd'
    print '  --openbsd  operating-systems/openbsd'
    print '  --qnx  operating-systems/qnx'
    print '  --redox  operating-systems/redox'
    print '  --serenityos  operating-systems/serenityos'
    print '  --sovrenos  operating-systems/sovrenos'
    print '  --wasm32-browser  webassembly/browser'
    print '  --wasm-component  webassembly/component-model'
    print '  --wasm32-edge  webassembly/edge'
    print '  --wasm32-emscripten  webassembly/emscripten'
    print '  --wasm32-simd  webassembly/wasm32-single-instruction-multiple-data'
    print '  --wasm32-threads  webassembly/wasm32-threads-atomics'
    print '  --wasm32  webassembly/wasm32-unknown-unknown'
    print '  --wasm64  webassembly/wasm64-memory64'
    print '  --wasi  webassembly/webassembly-system-interface'
    print '  --wat  webassembly/webassembly-text'
    print '  --windows  windows'
    print '  --windows-store  windows/store'
    print 'See TARGETS.md for source and build availability.'
    print 'Other options: --release, --debug, --version, --help'
