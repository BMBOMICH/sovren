# Sovereign .sovignore
# Files and directories ignored by the Sovereign package manager and tools

# Build output
build/
*.o
*.obj
*.exe
*.out
*.so
*.dylib
*.dll
*.wasm

# Generated C code from compiler
*.gen.c
*.gen.h
stage*.c

# LLVM output
*.ll
*.bc
*.s

# PGO profiles
.sov_pgo/

# LTO cache
.sov_lto_cache/

# Dependencies
.sov_packages/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary
/tmp/
*.tmp
*.log
