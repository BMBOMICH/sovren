# music.sov — the tune the piano plays by itself. Builds a little
# song out of sines and writes it as a WAV file: Twinkle, Twinkle,
# Little Star, one note at a time.
#
#   ./sovren music.sov -o music && ./music
#   (then play twinkle.wav)
#
use audio
use file
use seq
use sys

# one note of the scale, as frequency in thousandths of a hertz on
# top of a length in millionths of a second: middle C is 261.63 Hz,
# so the pair reads 261630000000 + 400000
note_at i:
    if i is 0
        return 261630000000 + 400000
    if i is 1
        return 293660000000 + 400000
    if i is 2
        return 329630000000 + 400000
    if i is 3
        return 349230000000 + 400000
    if i is 4
        return 392000000000 + 400000
    if i is 5
        return 440000000000 + 400000
    return 493880000000 + 400000

# the tune, one scale step at a time
tune_at i:
    if i is 0
        return 0
    if i is 1
        return 0
    if i is 2
        return 4
    if i is 3
        return 4
    if i is 4
        return 5
    if i is 5
        return 5
    if i is 6
        return 4
    if i is 7
        return 3
    if i is 8
        return 3
    if i is 9
        return 2
    if i is 10
        return 2
    if i is 11
        return 1
    if i is 12
        return 1
    return 0

main:
    # C C G G A A G(2)   F F E E D D C(2)
    t: seq_new(14)
    i: 0
    as long as i < 14
        v: note_at(tune_at(i))
        f: v / 1000000
        d: v % 1000000
        if i is 6
            d: 800000
        if i is 13
            d: 800000
        poke_i64(t, i * 8, seq_note(f, d))
        i: i + 1
    p: aud_new(7000000)
    at: seq_play(p, t, 14, 0, 1000000)
    aud_wav("twinkle.wav", p, at)
    write_out("wrote twinkle.wav, ")
    print file_size("twinkle.wav")
    write_out(" bytes of Twinkle Twinkle\n")
