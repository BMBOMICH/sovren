# carm.sov — the shared arm64 compiler core.
#
# every task here is byte-identical between the android and
# ios back ends; android-so shares the emit core subset. the
# per-OS files keep their image writers, syscall tables and
# entry conventions, and define the constants these read.
use mem

# set while main's own statements emit
carm_main_now: 0

# per-OS syscall table. defaults are Linux arm64; the ios file
# re-points them at the XNU arm64 table.
sc_write: 64
sc_exit: 93
sc_mmap: 222
mmap_flags: 34
sc_mincore: 232
sc_rand: 278
sc_nodump: 167
sc_sigact: 134

use file
use string
use num
use bit32

length s:
    return _sov_strlen(s)

same a b:
    return _sov_str_eq(a, b)

starts t p:
    return _sov_starts_with(t, p)

look t s:
    return _sov_find_text(t, s)

cut t a b:
    return _sov_substring(t, a, b)

join a b:
    return _sov_strcat(a, b)

strip t:
    return _sov_trim(t)

letter t i:
    return _sov_char_at(t, i)

emit n:
    x: n % 256
    if x < 0
        x: x + 256
    oc: _sov_list_add(oc, x)

here:
    return _sov_list_len(oc)

addp at kind val:
    patch_at: _sov_list_add(patch_at, at)
    patch_kind: _sov_list_add(patch_kind, kind)
    patch_val: _sov_list_add(patch_val, val)
    patch_line: _sov_list_add(patch_line, err_line)

fail:
    syscall(60, 1, 0, 0, 0, 0, 0)

file_ln li:
    n: li + 1
    if n > src_base
        return n - src_base
    return n

idx lst name:
    i: 0
    as long as i < _sov_list_len(lst)
        if same(_sov_list_get(lst, i), name) is 1
            return i
        i: i + 1
    return 0 - 1

unesc s:
    n: length(s)
    r: _sov_alloc(n + 1)
    j: 0
    i: 0
    as long as i < n
        b: _sov_byte_at(s, i)
        if b is 92
            if i + 1 < n
                nxt: _sov_byte_at(s, i + 1)
                out: nxt
                if nxt is 110
                    out: 10
                if not
                    if nxt is 116
                        out: 9
                    if not
                        if nxt is 114
                            out: 13
                dummy: _sov_set_byte(r, j, out)
                j: j + 1
                i: i + 2
            if not
                dummy: _sov_set_byte(r, j, b)
                j: j + 1
                i: i + 1
        if not
            dummy: _sov_set_byte(r, j, b)
            j: j + 1
            i: i + 1
    dummy: _sov_set_byte(r, j, 0)
    return r

intern s:
    s: unesc(s)
    i: 0
    as long as i < _sov_list_len(str_keys)
        if same(_sov_list_get(str_keys, i), s) is 1
            return _sov_list_get(str_pos, i)
        i: i + 1
    off: _sov_buf_len(strb)
    k: 0
    as long as k < length(s)
        strb: _sov_buf_u8(strb, _sov_byte_at(s, k))
        k: k + 1
    strb: _sov_buf_u8(strb, 0)
    str_keys: _sov_list_add(str_keys, s)
    str_pos: _sov_list_add(str_pos, off)
    return off

slot name:
    i: idx(locals, name)
    if i > 0 - 1
        return i
    locals: _sov_list_add(locals, name)
    return _sov_list_len(locals) - 1

cset name val:
    ci: idx(cnms, name)
    if ci > 0 - 1
        cvls: _sov_list_set(cvls, ci, val)
        cemt: _sov_list_set(cemt, ci, 0)
        return
    cnms: _sov_list_add(cnms, name)
    cvls: _sov_list_add(cvls, val)
    cemt: _sov_list_add(cemt, 0)

cflush name:
    ci: idx(cnms, name)
    if ci < 0
        return
    if _sov_list_get(cemt, ci) is 1
        return
    rax_imm(_sov_list_get(cvls, ci))
    cemt: _sov_list_set(cemt, ci, 1)
    if idx(locals, name) < 0
        if idx(glob_names, name) > 0 - 1
            store_glob(name)
            return
    store_loc(slot(name))

cflush_all:
    i: 0
    as long as i < _sov_list_len(cnms)
        if _sov_list_get(cemt, i) is 0
            cflush(_sov_list_get(cnms, i))
        i: i + 1

cflush_globs:
    i: 0
    as long as i < _sov_list_len(cnms)
        nm: _sov_list_get(cnms, i)
        if _sov_list_get(cemt, i) is 0
            if idx(glob_names, nm) > 0 - 1
                if idx(locals, nm) < 0
                    cflush(nm)
        i: i + 1

loadv name:
    cflush(name)
    g: idx(glob_names, name)
    if g > 0 - 1
        if idx(locals, name) < 0
            load_glob(name)
            return
    i: idx(locals, name)
    if i > 0 - 1
        load_loc(i)
        return
    if g > 0 - 1
        load_glob(name)
        return
    print "Error: no such name"
    _sov_print(name)
    print err_line
    had_err: 1
    load_loc(slot(name))

storev name:
    ci: idx(cnms, name)
    if ci > 0 - 1
        cemt: _sov_list_set(cemt, ci, 1)
    g: idx(glob_names, name)
    if g > 0 - 1
        if idx(locals, name) < 0
            store_glob(name)
            return
    i: idx(locals, name)
    if i > 0 - 1
        store_loc(i)
        return
    if g > 0 - 1
        store_glob(name)
        return
    store_loc(slot(name))

mark_str name:
    if idx(str_vars, name) < 0
        str_vars: _sov_list_add(str_vars, name)

drop_str name:
    di: idx(str_vars, name)
    if di > 0 - 1
        str_vars: _sov_list_set(str_vars, di, "")

mark_fn_str name:
    if idx(str_fns, name) < 0
        str_fns: _sov_list_add(str_fns, name)

patch at:
    put_here(at)

repl text old new:
    n: length(text)
    o: length(old)
    gn: length(new)
    r: _sov_alloc(n + gn + 8)
    p: 0
    j: 0
    ins: 0
    as long as p < n
        b: _sov_byte_at(text, p)
        if ins is 1
            if b is 92
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if p < n
                    poke_byte(r, j, _sov_byte_at(text, p))
                    j: j + 1
                    p: p + 1
            if not
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
            if not
                # match old at p one byte at a time, the way cx86's
                # repl now does. cut(text, p, n) copies the whole tail
                # at every position, which is quadratic - the arm
                # compilers replace far less text than the x86 ones,
                # but the same trap was sitting here
                rp_m: 0
                if p + o <= n
                    rp_m: 1
                rp_k: 0
                as long as rp_k < o
                    if rp_m is 1
                        if _sov_byte_at(text, p + rp_k) is _sov_byte_at(old, rp_k)
                            dummy: 0
                        if not
                            rp_m: 0
                    rp_k: rp_k + 1
                if rp_m is 1
                    k: 0
                    as long as k < gn
                        poke_byte(r, j, _sov_byte_at(new, k))
                        j: j + 1
                        k: k + 1
                    p: p + o
                if rp_m is 0
                    poke_byte(r, j, b)
                    j: j + 1
                    p: p + 1
    poke_byte(r, j, 0)
    return r

cops text:
    r: text
    r: repl(r, " is not ", " != ")
    r: repl(r, " and ", " && ")
    r: repl(r, " or ", " || ")
    r: repl(r, " is ", " == ")
    return r

fop3 e:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
            i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if same(c, "*") is 1
                                f: i
                            if not
                                if same(c, "/") is 1
                                    f: i
                                if not
                                    if same(c, "%") is 1
                                        f: i
                        i: i + 1
    return f

fop2 e a b:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
            i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if same(c, a) is 1
                                f: i
                            if not
                                if same(c, b) is 1
                                    f: i
                        i: i + 1
    return f

fop e op:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
                if i < n
                    i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
                i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if starts(cut(e, i, n), op) is 1
                                f: i
                        i: i + 1
    return f

# fop, except a match followed by `nxt` does not count - the same
# guard cx86 has, so the less-than comparison walks past a shift
fopn e op nxt:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
                if i < n
                    i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
                i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if starts(cut(e, i, n), op) is 1
                                fhit: 1
                                if i + length(op) < n
                                    if same(letter(e, i + length(op)), nxt) is 1
                                        fhit: 0
                                # and the character before it, so the
                                # second half of a shift is not read
                                # as a comparison
                                if i > 0
                                    if same(letter(e, i - 1), nxt) is 1
                                        fhit: 0
                                if fhit is 1
                                    f: i
                        i: i + 1
    return f

# "a & b" becomes "band(a, b)" and goes back through expr. the arm
# builtins and/orr/eor/lslv/lsrv/asrv are already there, so the
# operator costs one call and no new emit path
bitop e p opn wide:
    return expr(join(join(join(join(opn, "("), cut(e, 0, p)), ","), join(cut(e, p + wide, length(e)), ")")))

find_sep text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n - 3
        b: _sov_byte_at(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
        if ins is 0
            if same(cut(text, i, i + 4), " := ") is 1
                return i
        i: i + 1
    return 0 - 1

find_col text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n
        b: _sov_byte_at(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
            if not
                if b is 58
                    return i
        i: i + 1
    return 0 - 1

is_task_hdr s:
    n: length(s)
    if n < 2
        return 0
    if peek_byte(s, 0) is 35
        return 0
    if peek_byte(s, n - 1) is 58
        return 1
    return 0

ends_times s:
    if length(s) < 6
        return 0
    if same(cut(s, length(s) - 6, length(s)), " times") is 1
        return 1
    return 0

find_last_sp text:
    i: length(text) - 1
    as long as i > 0 - 1
        if same(letter(text, i), " ") is 1
            return i
        i: i - 1
    return 0 - 1

dec_txt v:
    if v is 0
        return "0\n"
    neg: 0
    dv: v
    if dv < 0
        neg: 1
    # see cx86's dec_txt: negating the most negative value gives back
    # itself, and the digit loop then indexed "0123456789" with a
    # negative d
    r: ""
    as long as dv is not 0
        d: dv % 10
        if d < 0
            d: 0 - d
        r: join(cut("0123456789", d, d + 1), r)
        dv: dv / 10
    if neg is 1
        r: join("-", r)
    return join(r, "\n")

print_const arg:
    v: 0
    ok: 0
    if is_imm(arg) is 1
        v: _sov_atoi(arg)
        ok: 1
    if ok is 0
        if starts(arg, "-") is 1
            if length(arg) > 1
                if is_imm(cut(arg, 1, length(arg))) is 1
                    v: 0 - _sov_atoi(cut(arg, 1, length(arg)))
                    ok: 1
    if ok is 0
        if length(fib_nm) > 0
            mark: join(fib_nm, "(")
            if starts(arg, mark) is 1
                if same(letter(arg, length(arg) - 1), ")") is 1
                    inn: strip(cut(arg, length(mark), length(arg) - 1))
                    if is_imm(inn) is 1
                        fv: _sov_atoi(inn)
                        if fv < 2
                            v: fv
                            ok: 1
                        if fv < 93
                            v: fib_of(fv)
                            ok: 1
    if ok is 0
        if starts(arg, "const(") is 1
            if length(arg) > 7
                if same(letter(arg, length(arg) - 1), ")") is 1
                    if ceval(cut(arg, 6, length(arg) - 1)) is 1
                        v: cval
                        ok: 1
    if ok is 0
        return 0
    emit_write_lit(dec_txt(v))
    return 1

do_print_one arg:
    if length(arg) > 1
        if _sov_byte_at(arg, 0) is 34
            if same(letter(arg, length(arg) - 1), "\"") is 1
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
    typ: expr(arg)
    mov_rdi_rax()
    if typ is 1
        used_pr: 1
        calln("_sov_print")
    if not
        used_pi: 1
        calln("_sov_print_int")

do_print_times what nstr:
    expr(nstr)
    storev("__pt_c")
    xor_rax()
    storev("__pt_i")
    st: here()
    loadv("__pt_i")
    push_rax()
    loadv("__pt_c")
    mov_rcx_rax()
    pop_rax()
    cmp_rax_rcx()
    setcc("lt")
    test_rax()
    z: jz()
    do_print_one(what)
    inc_var("__pt_i")
    jb: jmp()
    put_arm(jb, st - jb)
    patch(z)

digit c:
    b: _sov_byte_at(c, 0)
    if b >= 48
        if b <= 57
            return 1
    return 0
bin L R op:
    Lq: strip(L)
    Rq: strip(R)
    if same(op, "eq") is 1
        if starts(Rq, "\"") is 1
            expr(Lq)
            push_rax()
            expr(Rq)
            mov_reg(1, 0)
            pop_rax()
            calln("_sov_str_eq")
            return 0
        if starts(Lq, "\"") is 1
            expr(Rq)
            push_rax()
            expr(Lq)
            mov_reg(1, 0)
            pop_rax()
            calln("_sov_str_eq")
            return 0
    if same(op, "ne") is 1
        if starts(Rq, "\"") is 1
            expr(Lq)
            push_rax()
            expr(Rq)
            mov_reg(1, 0)
            pop_rax()
            calln("_sov_str_eq")
            test_rax()
            setcc("eq")
            return 0
        if starts(Lq, "\"") is 1
            expr(Rq)
            push_rax()
            expr(Lq)
            mov_reg(1, 0)
            pop_rax()
            calln("_sov_str_eq")
            test_rax()
            setcc("eq")
            return 0
    expr(L)
    push_rax()
    expr(R)
    mov_rcx_rax()
    pop_rax()
    if same(op, "add") is 1
        add_rax_rcx()
        chk_ov()
        return
    if same(op, "sub") is 1
        sub_rax_rcx()
        chk_ov()
        return
    if same(op, "mul") is 1
        imul_rax_rcx()
        chk_ov()
        return
    if same(op, "div") is 1
        chk_zrcx()
        sdiv_rax_rcx()
        return
    if same(op, "mod") is 1
        chk_zrcx()
        mod_rax_rcx()
        return
    cmp_rax_rcx()
    setcc(op)

expr e0:
    ex_depth: ex_depth + 1
    if ex_depth > 150
        if had_err is 0
            print "Error: expression too long, split it up"
            print err_line
            had_err: 1
        ex_depth: ex_depth - 1
        xor_rax()
        return 0
    t: expr_body(e0)
    ex_depth: ex_depth - 1
    return t

expr_body e0:
    e: strip(e0)
    if length(e) is 0
        xor_rax()
        return 0
    # postfix cast: <expr> as text / <expr> as ptr. must run before
    # the literal check, which would swallow the cast as string text
    if length(e) >= 8
        if same(cut(e, length(e) - 8, length(e)), " as text") is 1
            expr(cut(e, 0, length(e) - 8))
            return 1
    if length(e) >= 7
        if same(cut(e, length(e) - 7, length(e)), " as ptr") is 1
            expr(cut(e, 0, length(e) - 7))
            return 1
    if length(e) > 0
        if _sov_byte_at(e, 0) is 34
            if length(e) > 1
                rax_str(cut(e, 1, length(e) - 1))
                return 1
            rax_str("")
            return 1
    if starts(e, "as text ") is 1
        expr(cut(e, 8, length(e)))
        return 1
    if starts(e, "as ptr ") is 1
        expr(cut(e, 7, length(e)))
        return 1
    # const(expr) - folded to a literal while compiling
    if starts(e, "const(") is 1
        if length(e) > 7
            if same(letter(e, length(e) - 1), ")") is 1
                if ceval(cut(e, 6, length(e) - 1)) is 1
                    rax_imm(cval)
                    return 0
                print "Error: const: not a compile-time number"
                print err_line
                had_err: 1
                xor_rax()
                return 0
    # addr_of name -- where a job lives, so a C library can call back
    if starts(e, "addr_of ") is 1
        aat: here()
        movz_x(0, 0, 0)
        movk_x(0, 0, 1)
        movk_x(0, 0, 2)
        movk_x(0, 0, 3)
        addp(aat, "fnaddr64", strip(cut(e, 8, length(e))))
        return 0
    if starts(e, "length of ") is 1
        expr(cut(e, 10, length(e)))
        mov_rdi_rax()
        used_sl: 1
        calln("_sov_strlen")
        return 0
    e: strip(cops(e))
    p: fop(e, "||")
    if p > 0 - 1
        expr(cut(e, 0, p))
        test_rax()
        a: jnz()
        expr(cut(e, p + 2, length(e)))
        test_rax()
        b: jnz()
        xor_rax()
        d: jmp()
        patch(a)
        patch(b)
        rax_imm(1)
        patch(d)
        return 0
    p: fop(e, "&&")
    if p > 0 - 1
        expr(cut(e, 0, p))
        test_rax()
        a: jz()
        expr(cut(e, p + 2, length(e)))
        test_rax()
        b: jz()
        rax_imm(1)
        d: jmp()
        patch(a)
        patch(b)
        xor_rax()
        patch(d)
        return 0
    # bit operators, loosest first, the way C orders them
    p: fop(e, "|")
    if p > 0 - 1
        return bitop(e, p, "bor", 1)
    p: fop(e, "^")
    if p > 0 - 1
        return bitop(e, p, "bxor", 1)
    p: fop(e, "&")
    if p > 0 - 1
        return bitop(e, p, "band", 1)
    p: fop(e, "==")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "eq")
        return 0
    p: fop(e, "!=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "ne")
        return 0
    p: fop(e, "<=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "le")
        return 0
    p: fop(e, ">=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "ge")
        return 0
    p: fopn(e, "<", "<")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "lt")
        return 0
    p: fopn(e, ">", ">")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "gt")
        return 0
    # >>> before >>, because >> matches the first two characters of
    # it. >> is arithmetic on a signed value; >>> fills from the top
    p: fop(e, ">>>")
    if p > 0 - 1
        return bitop(e, p, "bshr", 3)
    p: fop(e, ">>")
    if p > 0 - 1
        return bitop(e, p, "bsar", 2)
    p: fop(e, "<<")
    if p > 0 - 1
        return bitop(e, p, "bshl", 2)
    p: fop2(e, "+", "-")
    if p > 0
        if same(letter(e, p), "+") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "add")
            return 0
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "sub")
        return 0
    if p is 0
        if same(letter(e, p), "+") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "add")
            return 0
    p: fop3(e)
    if p > 0 - 1
        o: letter(e, p)
        if same(o, "*") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "mul")
            return 0
        if same(o, "/") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "div")
            return 0
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "mod")
        return 0
    if same(e, "blank") is 1
        rax_str("")
        return 1
    if length(e) > 0
        if _sov_byte_at(e, 0) is 34
            rax_str(cut(e, 1, length(e) - 1))
            return 1
    if starts(e, "(") is 1
        if same(letter(e, length(e) - 1), ")") is 1
            t: expr(cut(e, 1, length(e) - 1))
            return t
    lp: look(e, "(")
    if lp > 0
        if same(letter(e, length(e) - 1), ")") is 1
            name: strip(cut(e, 0, lp))
            # spawn work(x, y) = start a thread running work(x, y).
            # parsed here, the same shape cx86 parses, so a library
            # can use it and still build for an arm target; what it
            # emits is each machine's own answer, in spawn_emit
            is_spawn: 0
            if starts(name, "spawn ") is 1
                name: strip(cut(name, 6, length(name)))
                if length(name) is 0
                    print "Error: spawn needs a task name"
                    print err_line
                    had_err: 1
                    set_reg(0, 0)
                    return 0
                is_spawn: 1
            inside: cut(e, lp + 1, length(e) - 1)
            if length(fib_nm) > 0
                if same(name, fib_nm) is 1
                    if is_imm(strip(inside)) is 1
                        fv: _sov_atoi(strip(inside))
                        if fv < 2
                            rax_imm(fv)
                            return 0
                        if fv < 93
                            rax_imm(fib_of(fv))
                            return 0
            argc: 0
            if length(strip(inside)) > 0
                depth: 0
                ins: 0
                start: 0
                i: 0
                ilen: length(inside)
                as long as i < ilen
                    c: letter(inside, i)
                    if ins is 1
                        if _sov_byte_at(inside, i) is 92
                            i: i + 1
                        if not
                            if _sov_byte_at(inside, i) is 34
                                ins: 0
                    if not
                        if _sov_byte_at(inside, i) is 34
                            ins: 1
                        if not
                            if same(c, "(") is 1
                                depth: depth + 1
                            if not
                                if same(c, ")") is 1
                                    depth: depth - 1
                                if not
                                    if same(c, ",") is 1
                                        if depth is 0
                                            expr(cut(inside, start, i))
                                            push_rax()
                                            argc: argc + 1
                                            start: i + 1
                    i: i + 1
                expr(cut(inside, start, ilen))
                push_rax()
                argc: argc + 1
            axi: idx(ar_names, name)
            if axi > 0 - 1
                if _sov_list_get(ar_cnt, axi) is not argc
                    print "Error: wrong number of values"
                    _sov_print(name)
                    print err_line
                    had_err: 1
            if is_spawn is 1
                spawn_emit(name, argc)
            if not
                call_args(name, argc)
            if same(name, "cat") is 1
                return 1
            if same(name, "strcat") is 1
                return 1
            if same(name, "_sov_strcat") is 1
                return 1
            if same(name, "sub") is 1
                return 1
            if same(name, "trim") is 1
                return 1
            if same(name, "ch") is 1
                return 1
            if same(name, "_sov_substring") is 1
                return 1
            if idx(str_fns, name) > 0 - 1
                return 1
            return 0
    if digit(letter(e, 0)) is 1
        dq: 0
        as long as dq < length(e)
            if digit(letter(e, dq)) is 0
                print "Error: do not know these words"
                _sov_print(e)
                print err_line
                had_err: 1
                xor_rax()
                return 0
            dq: dq + 1
        rax_imm(_sov_atoi(e))
        return 0
    if starts(e, "-") is 1
        if length(e) > 1
            if digit(letter(e, 1)) is 1
                rax_imm(0 - _sov_atoi(cut(e, 1, length(e))))
                return 0
    if look(e, " ") > 0 - 1
        print "Error: do not know these words"
        _sov_print(e)
        print err_line
        had_err: 1
        xor_rax()
        return 0
    vn: e
    loadv(vn)
    if idx(str_vars, vn) > 0 - 1
        return 1
    return 0

# immutable: names declared `immutable name: value` may not be
# assigned again anywhere in the file
im_names: 0
im_skip: 0

stmt line:
    im_skip: 0
    s: strip(line)
    if length(s) is 0
        return
    if starts(s, "#") is 1
        return
    s: compound(s)
    q: 0
    qi: 0
    as long as qi < length(s)
        if _sov_byte_at(s, qi) is 92
            qi: qi + 1
        if not
            if _sov_byte_at(s, qi) is 34
                q: q + 1
        qi: qi + 1
    if q % 2 is not 0
        print "Error: unterminated text"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    if length(s) > 1000
        print "Error: line too long, split it up"
        print err_line
        had_err: 1
        return
    if starts(s, "use ") is 1
        return
    if starts(s, "immutable ") is 1
        rest: strip(cut(s, 10, length(s)))
        t: find_col(rest)
        if t < 1
            print "Error: immutable needs a name and a value"
            print err_line
            had_err: 1
            return
        im_names: _sov_list_add(im_names, strip(cut(rest, 0, t)))
        im_skip: 1
        s: rest
    if same(s, "private") is 1
        # pass 118 (a64): a function that declares private zeroes its
        # frame at every return - see frame_wipe_a64. the marker also
        # flips need_priv like wipe does.
        fw_on: 1
        return
    if starts(s, "wipe ") is 1
        expr(strip(cut(s, 5, length(s))))
        mov_rdi_rax()
        test_rax()
        wsk: jz()
        wtop: here()
        emitw(960495650)
        emitw(1895825503)
        wend: here()
        emitw(1409286144)
        emitw(956301375)
        emitw(2432697377)
        wb: here()
        emitw(335544320)
        put_arm(wb, wtop - wb)
        put_here(wend)
        patch(wsk)
        return
    if starts(s, "join ") is 1
        expr(strip(cut(s, 5, length(s))))
        stmt_join_op()
        return
    if starts(s, "print ") is 1
        arg: strip(cut(s, 6, length(s)))
        if ends_times(arg) is 1
            head: strip(cut(arg, 0, length(arg) - 6))
            sp: find_last_sp(head)
            if sp > 0 - 1
                do_print_times(strip(cut(head, 0, sp)), strip(cut(head, sp + 1, length(head))))
                return
        # a postfix cast on a print: force the text path
        if length(arg) >= 8
            if same(cut(arg, length(arg) - 8, length(arg)), " as text") is 1
                expr(cut(arg, 0, length(arg) - 8))
                mov_rdi_rax()
                used_pr: 1
                calln("_sov_print")
                return
        if length(arg) >= 7
            if same(cut(arg, length(arg) - 7, length(arg)), " as ptr") is 1
                expr(cut(arg, 0, length(arg) - 7))
                mov_rdi_rax()
                used_pr: 1
                calln("_sov_print")
                return
        if length(arg) > 1
            if _sov_byte_at(arg, 0) is 34
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
        if starts(arg, "peek_byte(") is 1
            if opt_imm > 0
                emit_write_lit(i2s(opt_imm))
                return
        if print_const(arg) is 1
            return
        # pass 115: a pending constant under a name folds to the
        # same literal write as print 123 - no division loop
        pci: idx(cnms, arg)
        if pci > 0 - 1
            if _sov_list_get(cemt, pci) is 0
                emit_write_lit(dec_txt(_sov_list_get(cvls, pci)))
                cemt: _sov_list_set(cemt, pci, 1)
                return
        typ: expr(arg)
        mov_rdi_rax()
        if typ is 1
            used_pr: 1
            calln("_sov_print")
        if not
            used_pi: 1
            calln("_sov_print_int")
        return
    had_col: 0
    col: find_col(s)
    if col > 0
        if col < length(s) - 1
            had_col: 1
            s: join("<-- ", join(strip(cut(s, 0, col)), join(" := ", strip(cut(s, col + 1, length(s))))))
    if starts(s, "<-- ") is 1
        if had_col is 0
            print "Error: bad line"
            _sov_print(s)
            print err_line
            had_err: 1
            return
        rest: cut(s, 4, length(s))
        t: find_sep(rest)
        if t > 0 - 1
            var: repl(strip(cut(rest, 0, t)), " ", "_")
            rhs: strip(cut(rest, t + 4, length(rest)))
            if idx(im_names, var) > 0 - 1
                if im_skip is 0
                    print join("Error: ", join(var, " is immutable, it cannot be assigned again"))
                    _sov_print(s)
                    print err_line
                    had_err: 1
                    return
                im_skip: 0
            if same(rhs, join(var, " + 1")) is 1
                inc_var(var)
                return
            if same(rhs, join(var, " - 1")) is 1
                dec_var(var)
                return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            if length(rhs) > 0
                if digit(letter(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        if br_depth is 0
                            nv: _sov_atoi(rhs)
                            cset(var, nv)
                            if nv > 0
                                kn: var
                                kv: nv
                            drop_str(var)
                            if has_vm is 0
                                return
            if try_alloc_imm(var, rhs) is 1
                mark_str(var)
                return
            typ: expr(rhs)
            storev(var)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if starts(rhs, "_sov_strlen(") is 1
                if did_stos is 1
                    if kv > 0
                        kn: var
        return
    if same(s, "return") is 1
        if carm_main_now is 1
            set_reg(0, 0)
            set_reg(8, sc_exit)
            sysc()
            return
        xor_rax()
        if fw_on is 1
            canary_check_a64()
            frame_wipe_a64()
            return
        leave()
        ret()
        return
    if starts(s, "return ") is 1
        typ: expr(cut(s, 7, length(s)))
        if typ is 1
            saw_str: 1
        if carm_main_now is 1
            set_reg(8, sc_exit)
            sysc()
            return
        if fw_on is 1
            canary_check_a64()
            frame_wipe_a64()
            return
        leave()
        ret()
        return
    if same(s, "stop") is 1
        set_reg(0, 0)
        set_reg(8, sc_exit)
        sysc()
        return
    if look(s, "(") < 0
        print "Error: bad line"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    expr(s)

nind line:
    c: 0
    i: 0
    as long as i < length(line)
        if _sov_byte_at(line, i) is 9
            print "Error: tab indent, use spaces"
            _sov_print(line)
            print err_line
            had_err: 1
            return c
        if same(letter(line, i), " ") is 1
            c: c + 1
        if not
            return c
        i: i + 1
    return c
bk: 0
bi: 0
bj: 0
bs: 0
be: 0
br: 0

popblk:
    last: _sov_list_len(bk) - 1
    k: _sov_list_get(bk, last)
    if same(k, "while") is 1
        st: _sov_list_get(bs, last)
        at: jmp()
        put_arm(at, st - at)
        patch(_sov_list_get(bj, last))
    if not
        if same(k, "forever") is 1
            st: _sov_list_get(bs, last)
            at: jmp()
            put_arm(at, st - at)
        if not
            if same(k, "repeat") is 1
                rs: _sov_list_get(br, last)
                load_loc(rs)
                rdi_imm(1)
                add_rax_rcx()
                store_loc(rs)
                st: _sov_list_get(bs, last)
                at: jmp()
                put_arm(at, st - at)
                patch(_sov_list_get(bj, last))
            if not
                if same(k, "try") is 1
                    tb2: _sov_list_get(bs, last)
                    if tb2 is 0
                        print "Error: try needs an except"
                        had_err: 1
                    if not
                        put_here(tb2)
                if not
                    if same(k, "except") is 1
                        skipme: 0
                    if not
                        z: _sov_list_get(bj, last)
                        if z > 0 - 1
                            patch(z)
                        je: _sov_list_get(be, last)
                        ji: 0
                as long as ji < _sov_list_len(je)
                    patch(_sov_list_get(je, ji))
                    ji: ji + 1
    nk: _sov_list_new()
    ni: _sov_list_new()
    nj: _sov_list_new()
    ns: _sov_list_new()
    ne: _sov_list_new()
    nr: _sov_list_new()
    pi: 0
    as long as pi < last
        nk: _sov_list_add(nk, _sov_list_get(bk, pi))
        ni: _sov_list_add(ni, _sov_list_get(bi, pi))
        nj: _sov_list_add(nj, _sov_list_get(bj, pi))
        ns: _sov_list_add(ns, _sov_list_get(bs, pi))
        ne: _sov_list_add(ne, _sov_list_get(be, pi))
        nr: _sov_list_add(nr, _sov_list_get(br, pi))
        pi: pi + 1
    bk: nk
    bi: ni
    bj: nj
    bs: ns
    be: ne
    br: nr
    br_depth: br_depth - 1

try_alloc_imm var rhs:
    if starts(rhs, "_sov_alloc(") is 0
        return 0
    if same(var, skip_al) is 1
        return 1
    if has_vm is 0
        if same(letter(rhs, length(rhs) - 1), ")") is 1
            inn: strip(cut(rhs, 11, length(rhs) - 1))
            asz: 0
            if same(inn, kn) is 1
                if kv > 0
                    asz: kv
            if asz is 0
                if length(inn) > 0
                    if digit(letter(inn, 0)) is 1
                        if look(inn, " ") < 0
                            asz: _sov_atoi(inn)
            if asz > 511
                emit_mmap_k(asz)
                storev(var)
                return 1
    return 0

collect_body lines start bind:
    out: _sov_list_new()
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    out: _sov_list_add(out, s)
                    j: j + 1
                if not
                    return out
    return out

skip_body lines start bind:
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    j: j + 1
                if not
                    return j
    return j

lines_of source:
    lst: _sov_list_new()
    start: 0
    i: 0
    n: length(source)
    as long as i < n
        if _sov_byte_at(source, i) is 10
            lst: _sov_list_add(lst, cut(source, start, i))
            start: i + 1
        i: i + 1
    if start < n
        lst: _sov_list_add(lst, cut(source, start, n))
    return lst

tname line:
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            return repl(strip(cut(s, 0, wp)), " ", "_")
        sp: look(s, " ")
        if sp > 0 - 1
            return strip(cut(s, 0, sp))
        return s
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp > 0 - 1
        return repl(strip(cut(rest, 0, wp)), " ", "_")
    sp: look(rest, " ")
    if sp > 0 - 1
        return repl(strip(cut(rest, 0, sp)), " ", "_")
    return repl(rest, " ", "_")

tparams line:
    lst: _sov_list_new()
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            s: strip(cut(s, wp + 6, length(s)))
        if not
            sp: look(s, " ")
            if sp < 0
                return lst
            s: strip(cut(s, sp + 1, length(s)))
        p: repl(s, ",", " ")
        p: repl(p, " and ", " ")
        start: 0
        i: 0
        n: length(p)
        as long as i < n
            if same(letter(p, i), " ") is 1
                one: strip(cut(p, start, i))
                if length(one) > 0
                    lst: _sov_list_add(lst, one)
                start: i + 1
            i: i + 1
        one: strip(cut(p, start, n))
        if length(one) > 0
            lst: _sov_list_add(lst, one)
        return lst
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp < 0
        return lst
    p: repl(cut(rest, wp + 6, length(rest)), ",", " and ")
    start: 0
    i: 0
    n: length(p)
    as long as i < n
        if starts(cut(p, i, n), " and ") is 1
            one: repl(strip(cut(p, start, i)), " ", "_")
            if length(one) > 0
                lst: _sov_list_add(lst, one)
            start: i + 5
            i: i + 5
        if not
            i: i + 1
    one: repl(strip(cut(p, start, n)), " ", "_")
    if length(one) > 0
        lst: _sov_list_add(lst, one)
    return lst

dead_iota lines:
    an: blank
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        if starts(s, "<-- ") is 1
            if look(s, "_sov_alloc(") > 0 - 1
                rest: cut(s, 4, length(s))
                t: find_sep(rest)
                if t > 0 - 1
                    an: repl(strip(cut(rest, 0, t)), " ", "_")
        i: i + 1
    if length(an) is 0
        return blank
    hits: 0
    ok: 1
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        mark: join(an, ",")
        hit: 0
        if look(s, mark) > 0 - 1
            hit: 1
        if starts(s, join("<-- ", an)) is 1
            hit: 1
        if hit is 1
            hits: hits + 1
            good: 0
            if look(s, "_sov_alloc(") > 0 - 1
                good: 1
            if look(s, "poke_i64(") > 0 - 1
                good: 1
            if look(s, "peek_i64(") > 0 - 1
                good: 1
            if good is 0
                ok: 0
        i: i + 1
    if ok is 0
        return blank
    if hits < 3
        return blank
    return an

i2s n:
    r: ""
    v: n
    if v is 0
        return "0\n"
    neg: 0
    if v < 0
        neg: 1
    as long as v is not 0
        d: v % 10
        if d < 0
            d: 0 - d
        r: join(cut("0123456789", d, d + 1), r)
        v: v / 10
    if neg is 1
        r: join("-", r)
    return join(r, "\n")

intern_nz s:
    s: unesc(s)
    i: 0
    as long as i < _sov_list_len(str_keys)
        if same(_sov_list_get(str_keys, i), s) is 1
            return _sov_list_get(str_pos, i)
        i: i + 1
    off: _sov_buf_len(strb)
    k: 0
    as long as k < length(s)
        strb: _sov_buf_u8(strb, _sov_byte_at(s, k))
        k: k + 1
    str_keys: _sov_list_add(str_keys, s)
    str_pos: _sov_list_add(str_pos, off)
    return off
# windows hands back argv[0] wrapped in quotes, as a drive path with
# backslashes. turn it into the plain form the file calls understand.

tidy_path s:
    r: unquote(s)
    n: length(r)
    # drop a leading drive letter such as Z:
    if n > 2
        if _sov_byte_at(r, 1) is 58
            r: cut(r, 2, n)
            n: n - 2
    # backslash to slash
    o: _sov_alloc(n + 1)
    i: 0
    as long as i < n
        b: _sov_byte_at(r, i)
        if b is 92
            b: 47
        dummy: _sov_set_byte(o, i, b)
        i: i + 1
    dummy: _sov_set_byte(o, n, 0)
    return as text o

unquote s:
    n: length(s)
    if n < 2
        return s
    if _sov_byte_at(s, 0) is not 34
        return s
    e: n
    if _sov_byte_at(s, n - 1) is 34
        e: n - 1
    return cut(s, 1, e)

dirname p:
    n: length(p)
    if n is 0
        return "."
    i: n
    as long as i > 0
        i: i - 1
        b: _sov_byte_at(p, i)
        # windows writes paths with a backslash
        if b is 92
            b: 47
        if b is 47
            if i is 0
                return "/"
            return cut(p, 0, i)
    return "."

emit_used:
    if used_al is 1
        if idx(glob_names, "heap_ptr") is 0 - 1
            glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_alloc()
    if used_pr is 1
        used_sl: 1
    if used_sl is 1
        emit_strlen()
    if used_eq is 1
        emit_streq()
    if used_pr is 1
        emit_print()
    if used_pi is 1
        emit_print_int()
    if used_tr is 1
        emit_trap_stub()

prep_main names params bodies:
    thin_main: 0
    skip_al: blank
    fib_nm: blank
    fib_drop: 0
    fi: 0
    as long as fi < _sov_list_len(names)
        if same(_sov_list_get(names, fi), "main") is 1
            if _sov_list_len(_sov_list_get(params, fi)) is 0
                thin_main: 1
            skip_al: dead_iota(_sov_list_get(bodies, fi))
        if fiblike(_sov_list_get(names, fi), _sov_list_get(params, fi), _sov_list_get(bodies, fi)) is 1
            fib_nm: _sov_list_get(names, fi)
        fi: fi + 1
    if length(fib_nm) > 0
        fib_drop: 1
        fi: 0
        as long as fi < _sov_list_len(names)
            if same(_sov_list_get(names, fi), fib_nm) is 0
                bln: _sov_list_get(bodies, fi)
                bi: 0
                as long as bi < _sov_list_len(bln)
                    if fib_call_var(_sov_list_get(bln, bi), fib_nm) is 1
                        fib_drop: 0
                    if look(_sov_list_get(bln, bi), join("addr_of ", fib_nm)) > 0 - 1
                        fib_drop: 0
                    bi: bi + 1
            fi: fi + 1
    if fib_drop is 1
        fn_names: _sov_list_add(fn_names, fib_nm)
        fn_offs: _sov_list_add(fn_offs, 0)

warn_unused:
    ui: 0
    as long as ui < _sov_list_len(names)
        nm: _sov_list_get(names, ui)
        do_w: 0
        if length(nm) > 0
            if same(nm, "main") is 0
                if starts(nm, "_sov_") is 0
                    # spawn_emit is machine interface, the same way
                    # cx86 treats it: every back end defines it, and a
                    # back end built from its own source has no spawn
                    # to reach it, so it is not a finding
                    if same(nm, "spawn_emit") is 0
                        if _sov_list_get(task_user, ui) is 1
                            do_w: 1
        if do_w is 1
            if fib_drop is 1
                if same(nm, fib_nm) is 1
                    do_w: 0
        if do_w is 1
            used: 0
            uj: 0
            as long as uj < _sov_list_len(patch_kind)
                if same(_sov_list_get(patch_kind, uj), "rel") is 1
                    if same(_sov_list_get(patch_val, uj), nm) is 1
                        used: 1
                if same(_sov_list_get(patch_kind, uj), "rel26") is 1
                    if same(_sov_list_get(patch_val, uj), nm) is 1
                        used: 1
                if same(_sov_list_get(patch_kind, uj), "fnaddr64") is 1
                    if same(_sov_list_get(patch_val, uj), nm) is 1
                        used: 1
                uj: uj + 1
            if used is 0
                print "Warning: never used"
                _sov_print(nm)
                print _sov_list_get(task_lns, ui)
        ui: ui + 1

dce:
    if had_err is 1
        return
    n: _sov_list_len(fn_names)
    if n < 2
        return
    clen: _sov_list_len(oc)
    # real function entries in emission order (skip the phantom fib)
    dro: _sov_list_new()
    dri: _sov_list_new()
    i: 0
    as long as i < n
        nm: _sov_list_get(fn_names, i)
        ph: 0
        if fib_drop is 1
            if same(nm, fib_nm) is 1
                ph: 1
        if ph is 0
            dro: _sov_list_add(dro, _sov_list_get(fn_offs, i))
            dri: _sov_list_add(dri, i)
        i: i + 1
    nr: _sov_list_len(dro)
    if nr < 2
        return
    first_off: _sov_list_get(dro, 0)
    # pos: fn_names index -> dri index (-1 if phantom)
    dpos: _sov_list_new()
    i: 0
    as long as i < n
        dpos: _sov_list_add(dpos, 0 - 1)
        i: i + 1
    i: 0
    as long as i < nr
        dpos: _sov_list_set(dpos, _sov_list_get(dri, i), i)
        i: i + 1
    # owner for each patch: -1 = the entry stub, else a dri index
    pn: _sov_list_len(patch_at)
    downer: _sov_list_new()
    ff: 0
    pp: 0
    as long as pp < pn
        at: _sov_list_get(patch_at, pp)
        o: 0 - 1
        if at >= first_off
            adv: 1
            as long as adv is 1
                if ff + 1 < nr
                    if at >= _sov_list_get(dro, ff + 1)
                        ff: ff + 1
                    if not
                        adv: 0
                if not
                    adv: 0
            o: ff
        downer: _sov_list_add(downer, o)
        pp: pp + 1
    # reachability from main (and the stub's own call) over rel/fnaddr
    dreach: _sov_list_new()
    i: 0
    as long as i < nr
        dreach: _sov_list_add(dreach, 0)
        i: i + 1
    dadj: _sov_list_new()
    i: 0
    as long as i < nr
        dadj: _sov_list_add(dadj, _sov_list_new())
        i: i + 1
    dtodo: _sov_list_new()
    mi: idx(fn_names, "main")
    if mi < 0
        return
    rj: _sov_list_get(dpos, mi)
    if rj > 0 - 1
        dreach: _sov_list_set(dreach, rj, 1)
        dtodo: _sov_list_add(dtodo, rj)
    pp: 0
    as long as pp < pn
        o: _sov_list_get(downer, pp)
        dk: _sov_list_get(patch_kind, pp)
        tgt: blank
        if same(dk, "rel26") is 1
            tgt: _sov_list_get(patch_val, pp)
        if same(dk, "fnaddr64") is 1
            tgt: _sov_list_get(patch_val, pp)
        if same(dk, "rel") is 1
            tgt: _sov_list_get(patch_val, pp)
        if same(dk, "cbz_trap") is 1
            tgt: "_sov_trap"
        if same(dk, "b19_trap") is 1
            tgt: "_sov_trap"
        if length(tgt) > 0
            ti: idx(fn_names, tgt)
            if ti > 0 - 1
                rj: _sov_list_get(dpos, ti)
                if rj > 0 - 1
                    if o is 0 - 1
                        if _sov_list_get(dreach, rj) is 0
                            dreach: _sov_list_set(dreach, rj, 1)
                            dtodo: _sov_list_add(dtodo, rj)
                    if not
                        dadj: _sov_list_set(dadj, o, _sov_list_add(_sov_list_get(dadj, o), rj))
        pp: pp + 1
    dhead: 0
    as long as dhead < _sov_list_len(dtodo)
        u: _sov_list_get(dtodo, dhead)
        dhead: dhead + 1
        nbl: _sov_list_get(dadj, u)
        j: 0
        as long as j < _sov_list_len(nbl)
            v: _sov_list_get(nbl, j)
            if _sov_list_get(dreach, v) is 0
                dreach: _sov_list_set(dreach, v, 1)
                dtodo: _sov_list_add(dtodo, v)
            j: j + 1
    kept: 0
    i: 0
    as long as i < nr
        if _sov_list_get(dreach, i) is 1
            kept: kept + 1
        i: i + 1
    if kept is nr
        return
    # rebuild: stub, then kept functions in order, then remap patches
    noc: _sov_list_new()
    i: 0
    as long as i < first_off
        noc: _sov_list_add(noc, _sov_list_get(oc, i))
        i: i + 1
    nfn_names: _sov_list_new()
    nfn_offs: _sov_list_new()
    dshift: _sov_list_new()
    i: 0
    as long as i < nr
        dshift: _sov_list_add(dshift, 0)
        i: i + 1
    cum: first_off
    i: 0
    as long as i < nr
        if _sov_list_get(dreach, i) is 1
            s: _sov_list_get(dro, i)
            e: clen
            if i + 1 < nr
                e: _sov_list_get(dro, i + 1)
            j: s
            as long as j < e
                noc: _sov_list_add(noc, _sov_list_get(oc, j))
                j: j + 1
            nfn_names: _sov_list_add(nfn_names, _sov_list_get(fn_names, _sov_list_get(dri, i)))
            nfn_offs: _sov_list_add(nfn_offs, cum)
            dshift: _sov_list_set(dshift, i, cum - s)
            cum: cum + (e - s)
        i: i + 1
    npat_at: _sov_list_new()
    npat_kind: _sov_list_new()
    npat_val: _sov_list_new()
    npat_line: _sov_list_new()
    pp: 0
    as long as pp < pn
        o: _sov_list_get(downer, pp)
        keep: 0
        ns: _sov_list_get(patch_at, pp)
        if o is 0 - 1
            keep: 1
        if not
            if _sov_list_get(dreach, o) is 1
                keep: 1
                ns: ns + _sov_list_get(dshift, o)
        if keep is 1
            npat_at: _sov_list_add(npat_at, ns)
            npat_kind: _sov_list_add(npat_kind, _sov_list_get(patch_kind, pp))
            npat_val: _sov_list_add(npat_val, _sov_list_get(patch_val, pp))
            npat_line: _sov_list_add(npat_line, _sov_list_get(patch_line, pp))
        pp: pp + 1
    oc: noc
    fn_names: nfn_names
    fn_offs: nfn_offs
    patch_at: npat_at
    patch_kind: npat_kind
    patch_val: npat_val
    patch_line: npat_line

poke4 p off v:
    x: v
    if x < 0
        x: x + 4294967296
    i: 0
    as long as i < 4
        dummy: _sov_set_byte(p, off + i, x % 256)
        x: x / 256
        i: i + 1

poke8 p off v:
    x: v
    i: 0
    as long as i < 8
        b: x % 256
        if b < 0
            b: b + 256
        dummy: _sov_set_byte(p, off + i, b)
        x: x / 256
        i: i + 1

use_one name:
    tail: join(name, ".sov")
    path: join("library/", tail)
    r: load_file(path)
    if r is not 0
        return r
    # not in this folder, so look beside the compiler
    path: join(self_dir, join("/library/", tail))
    r: load_file(path)
    if r is not 0
        return r
    # one folder up (compiler in linux/ or windows/ at the root)
    path: join(dirname(self_dir), join("/library/", tail))
    r: load_file(path)
    if r is not 0
        return r
    # two folders up (compiler in compilers/linux or compilers/windows)
    path: join(dirname(dirname(self_dir)), join("/library/", tail))
    return load_file(path)

take_use name:
    mark: join(" ", join(name, " "))
    if look(used_libs, mark) > 0 - 1
        return blank
    used_libs: join(used_libs, mark)
    chunk: use_one(name)
    if chunk is 0
        print "Error: cannot read library"
        _sov_print(name)
        print err_line
        had_err: 1
        return blank
    return chunk

pull_uses src:
    out: blank
    lns: lines_of(src)
    i: 0
    n: _sov_list_len(lns)
    as long as i < n
        line: strip(_sov_list_get(lns, i))
        if starts(line, "use ") is 1
            err_line: i + 1
            out: join(out, take_use(strip(cut(line, 4, length(line)))))
        i: i + 1
    return out

load_file path:
    fd: _sov_open(path, 0)
    if fd < 0
        return 0
    sz: _sov_lseek(fd, 0, 2)
    _sov_lseek(fd, 0, 0)
    if sz < 1
        _sov_close(fd)
        return 0
    buf: _sov_alloc(sz + 1)
    got: _sov_read(fd, buf, sz)
    _sov_close(fd)
    dummy: _sov_set_byte(buf, got, 0)
    return buf

# backend.sov — AArch64 back end for Sovren
# Replaces the x86-64 code generator. Register map:
#   x0  value register (was rax)      x1  second operand (was rcx)
#   x19..x23  locals 0..4             x29 frame pointer, x30 link
#   x9,x10..x15  scratch              x8  syscall number
# Every instruction is 4 bytes, little endian.

emitw w:
    v: w
    if v < 0
        v: v + 4294967296
    emit(v % 256)
    emit((v / 256) % 256)
    emit((v / 65536) % 256)
    emit((v / 16777216) % 256)

movz_x d imm sh:
    emitw(3531603968 + sh * 2097152 + band(imm, 65535) * 32 + d)

movk_x d imm sh:
    emitw(4068474880 + sh * 2097152 + band(imm, 65535) * 32 + d)

set_reg d n:
    # a negative n is already two's complement, so the chunks come
    # straight off it with a logical shift. the old form added 2^64
    # first to make it unsigned - and 2^64 does not fit in the type it
    # was filling, so the add wrapped and every negative immediate
    # came out as its top chunk alone: -1 loaded as 0xFFFF000000000000
    movz_x(d, band(n, 65535), 0)
    p1: band(bshr(n, 16), 65535)
    if p1 is not 0
        movk_x(d, p1, 1)
    p2: band(bshr(n, 32), 65535)
    if p2 is not 0
        movk_x(d, p2, 2)
    p3: band(bshr(n, 48), 65535)
    if p3 is not 0
        movk_x(d, p3, 3)

rax_imm n:
    set_reg(0, n)

rdi_imm n:
    set_reg(1, n)

# mov xD, xS   (orr xD, xzr, xS)

mov_reg d s:
    emitw(2852127712 + s * 65536 + d)

# str x0,[sp,#-16]!

pop_reg n:
    emitw(4165011424 + n)

pop_rax:
    pop_reg(0)

ret:
    emitw(3596551104)

xor_rax:
    emitw(2432697312)

mov_rdi_rax:
    mov_reg(1, 0)

mov_rcx_rax:
    mov_reg(1, 0)

add_rax_rcx:
    emitw(2332098560)

sub_rax_rcx:
    emitw(3405840384)

imul_rax_rcx:
    emitw(2600565760)

# x0 = x0 / x1

sdiv_rax_rcx:
    emitw(2596342784)

# x0 = x0 % x1   (sdiv x2,x0,x1 ; msub x0,x2,x1,x0)

mod_rax_rcx:
    emitw(2596342786)
    emitw(2600566848)

cmp_rax_rcx:
    emitw(3942711327)

test_rax:
    emitw(4043309087)

setcc op:
    if same(op, "eq") is 1
        emitw(2594117600)
        return
    if same(op, "ne") is 1
        emitw(2594113504)
        return
    if same(op, "lt") is 1
        emitw(2594154464)
        return
    if same(op, "gt") is 1
        emitw(2594166752)
        return
    if same(op, "le") is 1
        emitw(2594162656)
        return
    if same(op, "ge") is 1
        emitw(2594158560)
        return

loc_reg slot:
    return 19 + slot

# ldr xD,[x29,#off]
# ldur xD,[x29,#-off]   off is a positive byte count

ldr_fp d off:
    n: 512 - off
    emitw(4164944800 + n * 4096 + d)

# str xS,[x29,#off]
# stur xS,[x29,#-off]

str_fp s off:
    n: 512 - off
    emitw(4160750496 + n * 4096 + s)

load_loc slot:
    if slot < 5
        mov_reg(0, loc_reg(slot))
        return
    ldr_fp(0, (slot - 5) * 8 + 8)

canary_store_a64:
    can_used: 1
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", "g_canary")
    emitw(4181721384)
    emitw(3506570156)
    emitw(4177527176)
    return 0

canary_check_a64:
    can_used: 1
    emitw(3506570156)
    emitw(4181721482)
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", "g_canary")
    emitw(4181721387)
    emitw(3943367007)
    emitw(1409286208)
    cf: here()
    emitw(2483027968)
    addp(cf, "rel26", "_sov_canary_fail")
    return 0

emit_canary_fail:
    fn_names: _sov_list_add(fn_names, "_sov_canary_fail")
    fn_offs: _sov_list_add(fn_offs, here())
    emit_write_lit("stack\n")
    set_reg(0, 60)
    set_reg(8, sc_exit)
    sysc()

emit_crash_handler:
    cwns: _sov_list_new()
    cwns: _sov_list_add(cwns, "_sov_cw_4")
    cwns: _sov_list_add(cwns, "_sov_cw_6")
    cwns: _sov_list_add(cwns, "_sov_cw_7")
    cwns: _sov_list_add(cwns, "_sov_cw_8")
    cwns: _sov_list_add(cwns, "_sov_cw_11")
    cwvs: _sov_list_new()
    cwvs: _sov_list_add(cwvs, 4)
    cwvs: _sov_list_add(cwvs, 6)
    cwvs: _sov_list_add(cwvs, 7)
    cwvs: _sov_list_add(cwvs, 8)
    cwvs: _sov_list_add(cwvs, 11)
    chi: 0
    as long as chi < 5
        sg2: _sov_list_get(cwns, chi)
        sgv: _sov_list_get(cwvs, chi)
        fn_names: _sov_list_add(fn_names, sg2)
        fn_offs: _sov_list_add(fn_offs, here())
        emit_write_lit("crash\\n")
        # a crash handler wipes its own frame only, inline and
        # without a ret: the big heap walk would fault inside the
        # very handler it just entered, and a returned-to link
        # register is the smashed caller's
        emitw(2432762801)
        emitw(3506504624)
        emitw(2827058719)
        emitw(3943760415)
        emitw(1409286210)
        set_reg(0, 100 + sgv)
        set_reg(8, sc_exit)
        sysc()
        chi: chi + 1
    # the sigreturn trampoline the act points at
    fn_names: _sov_list_add(fn_names, "_sov_cw_ret")
    fn_offs: _sov_list_add(fn_offs, here())
    movz_x(8, 139, 0)
    sysc()

load_glob name:
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", name)
    emitw(4181721376)

store_glob name:
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", name)
    emitw(4177527072)

calln name:
    # bitwise, native: one opcode each, a in x0, b in x1, answer x0.
    # the words are the shifted-register logical form with Rd=x0 Rn=x0
    # Rm=x1 - and/orr/eor from opc 00/01/10, and lslv/lsrv/asrv from
    # the data-processing 2-register form with type2 00/01/10
    if same(name, "band") is 1
        cflush_globs()
        emitw(2315321344)
        return
    if same(name, "bor") is 1
        cflush_globs()
        emitw(2852192256)
        return
    if same(name, "bxor") is 1
        cflush_globs()
        emitw(3389063168)
        return
    if same(name, "bsar") is 1
        cflush_globs()
        emitw(2596349952)
        return
    if same(name, "bshl") is 1
        cflush_globs()
        emitw(2596347904)
        return
    if same(name, "bshr") is 1
        cflush_globs()
        emitw(2596348928)
        return
    # atomics: x0 is the slot, x1 the value, x2 the cas desired.
    # ldaxr/stlxr retry, ldar/stlr for load/store. words computed
    # from the armv8 encoding, not from an aarch64 assembler.
    if same(name, "atomic_add") is 1
        cflush_globs()
        emitw(3361733634)
        emitw(2332098627)
        emitw(3355769859)
        emitw(905969572)
        emitw(2852258784)
        return
    if same(name, "atomic_swap") is 1
        cflush_globs()
        emitw(3361733634)
        emitw(3355704321)
        emitw(905969603)
        emitw(2852258784)
        return
    if same(name, "atomic_load") is 1
        cflush_globs()
        emitw(3370122240)
        return
    if same(name, "atomic_store") is 1
        cflush_globs()
        emitw(3365927937)
        emitw(2852193248)
        return
    if same(name, "atomic_cas") is 1
        cflush_globs()
        emitw(3361733635)
        emitw(3942711423)
        emitw(1409286241)
        emitw(3355769858)
        emitw(905969540)
        emitw(3573755999)
        emitw(2852324320)
        return
    cflush_globs()
    at: here()
    emitw(2483027968)
    addp(at, "rel26", name)

jmp:
    at: here()
    emitw(335544320)
    return at

# b.eq — taken when the previous cmp set Z (value was zero)

jz:
    at: here()
    emitw(1409286144)
    return at

jnz:
    at: here()
    emitw(1409286145)
    return at

# b.hs — unsigned greater-or-equal, used by bounds checks
# stp x29,x30,[sp,#-16]! ; mov x29,sp ; sub sp,sp,#N (patched)

prolog:
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    pro_at: here()
    emitw(3506439167)

# ldp x29,x30,[sp],#16

leave:
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)

frame_wipe_a64:
    # the private-return epilogue. restore the caller's x19-x23 from
    # their slots (x29-based, sp is not reset yet), pull the caller's
    # fp and lr into x10/x11, then zero every byte of the frame
    # [x29-ns, x29+64) with an stp-xzr loop - spilled locals and the
    # saved slots both. the return value rides in x0 untouched: zero
    # stores never read it. the loop cursor ends on x29+64, which is
    # the caller's sp, so it becomes the new sp. one patched word:
    # sub x16,x29,#ns, resolved at fn end like pro_at.
    emitw(2839630771)
    emitw(2839698357)
    emitw(4181728183)
    emitw(2839556010)
    emitw(2432762801)
    fw_a: here()
    emitw(3506439088)
    fw_pos: _sov_list_add(fw_pos, fw_a)
    fw_top: here()
    emitw(2827058719)
    emitw(3943760415)
    fw_cond: here()
    emitw(1409286146)
    fw_back: here()
    emitw(335544320)
    put_arm(fw_back, fw_top - fw_back)
    put_here(fw_cond)
    emitw(2432696863)
    emitw(3596550496)
    return 0

copyargs n:
    i: 0
    as long as i < n
        if i < 5
            mov_reg(loc_reg(i), i)
        if not
            str_fp(i, (i - 5) * 8 + 8)
        i: i + 1

sysc:
    emitw(3556769793)

# ---- memory access ----

# ldrb w0,[x0,x1]

ldrb_x0_x0x1:
    emitw(945907712)

# strb w2,[x0,x1]

strb_x2_x0x1:
    emitw(941713410)

# ldr x0,[x0,x1]

ldr_x0_x0x1:
    emitw(4167133184)

# str x2,[x0,x1]

str_x2_x0x1:
    emitw(4162938882)

# ldur x9,[x0,#-8]  — read the allocation length header

ldur_len:
    emitw(4167008265)

# cmp x1,x9  — index against length

cmp_idx_len:
    emitw(3943235647)

chk_mem extra:
    if has_vm is 1
        return
    used_tr: 1
    cbz_at: here()
    emitw(3019898880)
    addp(cbz_at, "cbz_trap", 0)
    ldur_len()
    if extra is 1
        cmp_idx_len()
        at: here()
        emitw(1409286146)
        addp(at, "b19_trap", 0)
    if not
        emitw(2432704513)
        emitw(3943235647)
        at: here()
        emitw(1409286146)
        addp(at, "b19_trap", 0)

chk_zrcx:
    if has_vm is 1
        return
    used_tr: 1
    at: here()
    emitw(3019898881)
    addp(at, "cbz_trap", 1)

# write(1, str, n) with a literal

emit_mmap:
    set_reg(0, 0)
    set_reg(1, mmap_sz)
    set_reg(2, 3)
    set_reg(3, mmap_flags)
    emitw(2457862148)
    set_reg(5, 0)
    set_reg(8, sc_mmap)
    sysc()

emit_mmap_k n:
    set_reg(0, 0)
    set_reg(1, n + 2097152)
    set_reg(2, 3)
    set_reg(3, mmap_flags)
    emitw(2457862148)
    set_reg(5, 0)
    set_reg(8, sc_mmap)
    sysc()

# _start: x0 = argc from [sp], x1 = argv = sp+8

# the pie flag: 1 makes the compiler emit the self-relocating
# walk as the first code. each os file defines its own emit_walk
pie_walk: 0
# where the start stub landed, past the walk when there is one
start_off: 0

emit_start:
    emitw(4181722080)
    emitw(2432705505)
    at: here()
    emitw(2483027968)
    addp(at, "rel26", "main")
    set_reg(0, 0)
    set_reg(8, sc_exit)
    sysc()

emit_trap_stub:
    fn_names: _sov_list_add(fn_names, "_sov_trap")
    fn_offs: _sov_list_add(fn_offs, here())
    emit_write_lit("trap\n")
    set_reg(0, 1)
    set_reg(8, sc_exit)
    sysc()
# patch_arm64.sov — AArch64 branch patching
# x86 writes a flat 32-bit offset. ARM packs the offset into instruction bits:
#   b / bl   : 26-bit word offset in bits 0..25   (top byte 0x14 / 0x94)
#   b.cond   : 19-bit word offset in bits 5..23   (top byte 0x54)
# Offsets are in words (bytes / 4), signed, relative to the branch itself.

# read the 4 bytes already emitted at `at`

oc_word at:
    b0: _sov_list_get(oc, at)
    b1: _sov_list_get(oc, at + 1)
    b2: _sov_list_get(oc, at + 2)
    b3: _sov_list_get(oc, at + 3)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

oc_set_word at v:
    x: v
    if x < 0
        x: x + 4294967296
    oc: _sov_list_set(oc, at, x % 256)
    oc: _sov_list_set(oc, at + 1, (x / 256) % 256)
    oc: _sov_list_set(oc, at + 2, (x / 65536) % 256)
    oc: _sov_list_set(oc, at + 3, (x / 16777216) % 256)
    return 0

# byte offset -> signed word offset

word_off delta:
    d: delta / 4
    return d

# put a 26-bit offset into a b / bl already at `at`

put26 at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    d: word_off(delta)
    if d < 0
        d: d + 67108864
    base: top * 16777216
    oc_set_word(at, base + (d % 67108864))
    return 0

put19 at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    cond: w % 32
    d: word_off(delta)
    if d < 0
        d: d + 524288
    base: top * 16777216
    oc_set_word(at, base + (d % 524288) * 32 + cond)
    return 0

# ARM version of `put`: choose by instruction type

put_arm at delta:
    w: oc_word(at)
    top: (w / 16777216) % 256
    if top is 84
        put19(at, delta)
        return 0
    if top is 16
        # an adr site: the immediate is BYTES, not words, and it
        # lives in the immhi:immlo pair, not the low 26 bits. The
        # try/except handler address is patched through here; sent
        # to put26 it lost its register and scaled by four, so a
        # raise always branched on junk.
        put_adr(at, delta)
        return 0
    put26(at, delta)
    return 0

put_adr at delta:
    w: oc_word(at)
    rd: w % 32
    d: delta
    if d < 0
        d: d + 2097152
    lo: d % 4
    hi: (d / 4) % 524288
    oc_set_word(at, 268435456 + lo * 536870912 + hi * 32 + rd)
    return 0

# a forward patch: to wherever the code is now. This is its own
# little job on purpose: calling here() inside the arguments of
# put_arm loses the first answer.

put_here at:
    delta: here() - at
    put_arm(at, delta)
    return 0

# ARM version of `patch`: branch at `at` jumps to the current position
# backend2.sov — remaining AArch64 emitters
# Every raw word below was produced by an encoder and confirmed with a
# disassembler; the runtime helpers were then executed on an emulated ARM64 CPU.

inc_var name:
    loadv(name)
    rdi_imm(1)
    add_rax_rcx()
    storev(name)

dec_var name:
    loadv(name)
    rdi_imm(1)
    sub_rax_rcx()
    storev(name)

add_into dest src:
    loadv(dest)
    push_rax()
    loadv(src)
    mov_rcx_rax()
    pop_rax()
    add_rax_rcx()
    storev(dest)

add_imm name n:
    loadv(name)
    rdi_imm(n)
    add_rax_rcx()
    storev(name)

fiblike nm ps blines:
    if same(nm, "main") is 1
        return 0
    if _sov_list_len(ps) is not 1
        return 0
    p: _sov_list_get(ps, 0)
    if _sov_list_len(blines) is not 3
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    l3: strip(_sov_list_get(blines, 2))
    if same(l1, join("if ", join(p, " < 2"))) is 0
        return 0
    if same(l2, join("return ", p)) is 0
        return 0
    want3: join("return ", join(nm, join("(", join(p, " - 1)"))))
    want3b: join(want3, join(" + ", join(nm, join("(", join(p, " - 2)")))))
    if same(l3, want3b) is 0
        return 0
    return 1

is_imm s:
    n: length(s)
    if n is 0
        return 0
    i: 0
    if starts(s, "-") is 1
        i: 1
    if i >= n
        return 0
    as long as i < n
        if digit(letter(s, i)) is 0
            return 0
        i: i + 1
    return 1
# ---- const: compile-time evaluation of numeric expressions ----
# const(2 + 3 * 4) folds to a literal while the program is compiled:
# the value never touches the machine. What ceval cannot prove
# (names, calls, strings, a zero divisor) is a compile error, so a
# const is never silently a runtime value.
#
# Sovren names are file-global, so a recursive call overwrites every
# "local". ceval therefore reads no plain name after a call returns;
# ceval2 rides its operands on the cstk frame list so deeper frames
# cannot clobber them.

cval: 0
cvop: 0
cspl: 0
cstk: 0

lcut lst n:
    out: _sov_list_new()
    i: 0
    as long as i < n
        out: _sov_list_add(out, _sov_list_get(lst, i))
        i: i + 1
    return out

cnum s:
    e: strip(s)
    if length(e) is 0
        return 0
    i: 0
    if same(letter(e, 0), "-") is 1
        i: 1
    if i >= length(e)
        return 0
    as long as i < length(e)
        if digit(letter(e, i)) is 0
            return 0
        i: i + 1
    cval: _sov_atoi(e)
    return 1

# evaluate ls and rs, combine with op2 (10..15 compares, 20/21
# add/sub, 30/31/32 mul/div/mod). The frame rides cstk: nothing is
# read from a plain name after a recursive ceval returns.

cwrap s:
    e: strip(s)
    n: length(e)
    if n < 2
        return 0
    if same(letter(e, 0), "(") is 0
        return 0
    if same(letter(e, n - 1), ")") is 0
        return 0
    d: 1
    i: 1
    as long as i < n - 1
        if same(letter(e, i), "(") is 1
            d: d + 1
        if not
            if same(letter(e, i), ")") is 1
                d: d - 1
                if d is 0
                    return 0
        i: i + 1
    return 1

ceval2 ls rs op2:
    cstk: _sov_list_add(cstk, ls)
    cstk: _sov_list_add(cstk, rs)
    cstk: _sov_list_add(cstk, op2)
    if ceval(_sov_list_get(cstk, _sov_list_len(cstk) - 3)) is 0
        cstk: lcut(cstk, _sov_list_len(cstk) - 3)
        return 0
    cstk: _sov_list_add(cstk, cval)
    if ceval(_sov_list_get(cstk, _sov_list_len(cstk) - 3)) is 0
        cstk: lcut(cstk, _sov_list_len(cstk) - 4)
        return 0
    lv: _sov_list_get(cstk, _sov_list_len(cstk) - 1)
    rv: cval
    o2: _sov_list_get(cstk, _sov_list_len(cstk) - 2)
    cstk: lcut(cstk, _sov_list_len(cstk) - 4)
    if o2 is 10
        cval: 0
        if lv is rv
            cval: 1
    if not
        if o2 is 11
            cval: 0
            if lv is not rv
                cval: 1
        if not
            if o2 is 12
                cval: 0
                if lv < rv
                    cval: 1
            if not
                if o2 is 13
                    cval: 0
                    if lv >= rv
                        cval: 1
                if not
                    if o2 is 14
                        cval: 0
                        if lv < rv
                            cval: 1
                    if not
                        if o2 is 15
                            cval: 0
                            if lv > rv
                                cval: 1
                        if not
                            if o2 is 20
                                cval: lv + rv
                            if not
                                if o2 is 21
                                    cval: lv - rv
                                if not
                                    if o2 is 30
                                        cval: lv * rv
                                    if not
                                        if o2 is 31
                                            if rv is 0
                                                return 0
                                            cval: lv / rv
                                        if not
                                            if o2 is 32
                                                if rv is 0
                                                    return 0
                                            cval: lv % rv
    return 1

ceval s:
    e: strip(s)
    if length(e) is 0
        return 0
    if starts(e, "const(") is 1
        if same(letter(e, length(e) - 1), ")") is 1
            return ceval(cut(e, 6, length(e) - 1))
    if cnum(e) is 1
        return 1
    if cwrap(e) is 1
        return ceval(cut(e, 1, length(e) - 1))
    if same(letter(e, 0), "-") is 1
        if ceval(cut(e, 1, length(e))) is 1
            cval: 0 - cval
            return 1
    op: fop(e, "==")
    cvop: 10
    if op < 0
        op: fop(e, "!=")
        cvop: 11
    if op < 0
        op: fop(e, "<=")
        cvop: 12
    if op < 0
        op: fop(e, ">=")
        cvop: 13
    if op < 0
        op: fop(e, "<")
        cvop: 14
    if op < 0
        op: fop(e, ">")
        cvop: 15
    if op > 0 - 1
        if ceval2(cut(e, 0, op), cut(e, op + 2, length(e)), cvop) is 0
            return 0
        return 1
    cspl: 0
    pa: fop(e, "+")
    if pa > 0
        cspl: pa
        cvop: 20
    if cspl <= 0
        pm: fop(e, "-")
        if pm > 0
            cspl: pm
            cvop: 21
    if cspl > 0
        if ceval2(cut(e, 0, cspl), cut(e, cspl + 1, length(e)), cvop) is 0
            return 0
        return 1
    cspl: 0
    px: fop(e, "*")
    if px > 0
        cspl: px
        cvop: 30
    if cspl <= 0
        pd: fop(e, "/")
        if pd > 0
            cspl: pd
            cvop: 31
    if cspl <= 0
        pm: fop(e, "%")
        if pm > 0
            cspl: pm
            cvop: 32
    if cspl > 0
        if ceval2(cut(e, 0, cspl), cut(e, cspl + 1, length(e)), cvop) is 0
            return 0
        return 1
    return 0
fib_of n:
    if n < 2
        return n
    a: 0
    b: 1
    i: 2
    as long as i <= n
        t: a + b
        a: b
        b: t
        i: i + 1
    return b

fib_call_var line nm:
    mark: join(nm, "(")
    ln: length(line)
    pos: 0
    as long as pos < ln
        p: look(cut(line, pos, ln), mark)
        if p < 0
            return 0
        p: p + pos
        inn: cut(line, p + length(mark), ln)
        c: look(inn, ")")
        if c < 0
            return 0
        arg: strip(cut(inn, 0, c))
        if is_imm(arg) is 0
            return 1
        if _sov_atoi(arg) > 92
            return 1
        pos: p + length(mark) + c + 1
    return 0

chk_ov:
    return

emit_stack_wipe:
    # pass 139: the heap, first. heap_ptr is the program's own bump
    # frontier; every byte below it down to the mmap base was
    # allocated by the program, and a private program that never
    # called secret_die left it all in mapped memory at exit. the
    # base is found by the walk itself: mprotect (226) probing
    # downward, the same gate as the up-walk - the bottom of the
    # heap mapping refuses, everything inside grants and takes the
    # zero loop. guard: heap_ptr zero means no heap ever started.
    if idx(glob_names, "heap_ptr") > 0 - 1
        hwa: here()
        movz_x(0, 0, 0)
        movk_x(0, 0, 1)
        movk_x(0, 0, 2)
        movk_x(0, 0, 3)
        addp(hwa, "glob", "heap_ptr")
        emitw(4181721089)
        emitw(3019899457)
        set_reg(10, 4294963200)
        emitw(2315911168)
        # pass 141: the heap mapping is 64MB - 16384 pages, a hard bound
        emitw(1384644617)
        hw_loop: here()
        emitw(1384251393)
        emitw(1384120418)
        emitw(1384127560)
        sysc()
        emitw(889192736)
        emitw(2852127715)
        emitw(1384136705)
        hw_in: here()
        emitw(4160783391)
        emitw(4043310113)
        emitw(1426063265)
        emitw(3508535296)
        emitw(3508535296)
        emitw(1895826729)
    emitw(1426062945)
    # pass 136: the globals region first. the address goes into x0
    # through the same four-word immediate chain fnaddr uses, the
    # qword count into x1; one str xzr,[x0],#8 / subs / bne loop
    # clears it. then the stack walk below.
    gwa: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    movk_x(0, 0, 3)
    addp(gwa, "gw64a", 0)
    gwn: here()
    movz_x(1, 0, 0)
    addp(gwn, "gw64n", 0)
    gwi: here()
    emitw(1426063297)
    # pass 137: the string literals, same way - the address through a
    # four-word chain into x0, the qword count into x1. a rider string
    # (9 bytes or fewer) lives at BASE+7 in the elf ident padding; the
    # patch points there instead.
    gsa: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    movk_x(0, 0, 3)
    addp(gsa, "gw64s_a", 0)
    gsn: here()
    movz_x(1, 0, 0)
    addp(gsn, "gw64s_n", 0)
    gsi: here()
    emitw(4160783391)
    emitw(4043310113)
    emitw(1426063297)
    # pass 132: after main's body, before the exit syscall, walk the
    # stack downward one page at a time and zero every mapped page.
    # anchor: sp itself - everything below the running frame is dead.
    # x0 = sp & -4096, x2 = that page (the mincore vec byte lives
    # there: always mapped, always writable), then probe with
    # mincore (232), zero with a str/add/subs/bne loop, stop at the
    # first unmapped page. x0/x1/x2/x3/x8/x10 only - the exit that
    # follows re-sets x0 and x8 itself.
    emitw(2432697312)
    set_reg(10, 4294963200)
    emitw(2315911168)
    emitw(2852126722)
    # pass 141: 64MB of pages bounds the down-walk
    emitw(1384644617)
    sw_loop: here()
    set_reg(1, 4096)
    set_reg(8, sc_mincore)
    sysc()
    emitw(889192800)
    emitw(2852126723)
    set_reg(1, 512)
    sw_inner: here()
    emitw(4177526895)
    emitw(2432704611)
    emitw(4043310113)
    emitw(1426063265)
    emitw(3506962432)
    emitw(3506962432)
    emitw(1895826729)
    emitw(1426062945)
    # pass 138: the up-walk. everything above the sp page - dead
    # frames, the initial block, argv and env strings, the arrays -
    # gets the same zeros. probe with mprotect (226), not mincore: a
    # read-only page against the stack top answers mincore "mapped"
    # and faults the store, while mprotect(page,4096,RW) grants only
    # pages that can take the write; the exit syscall follows before
    # the permission change could matter to anyone. x5 (sp) and x10
    # (-4096) survive the down-walk above.
    emitw(2315911328)
    emitw(2434793472)
    emitw(2434793472)
    # pass 141: 16MB above the frame bounds the up-walk
    emitw(1384251401)
    up_loop: here()
    emitw(1384251393)
    emitw(1384120418)
    emitw(1384127560)
    sysc()
    emitw(889192736)
    emitw(2852127715)
    emitw(1384136705)
    up_in: here()
    emitw(4160783391)
    emitw(4043310113)
    emitw(1426063265)
    emitw(2434793472)
    emitw(2434793472)
    emitw(1895826729)
    emitw(1426062945)
    # pass 142: the register file - zero every general
    # register so the exit trap hands the kernel a clean
    # dump. x8/x0 are set fresh by the exit that follows.
    emitw(3531603968)
    emitw(3531603969)
    emitw(3531603970)
    emitw(3531603971)
    emitw(3531603972)
    emitw(3531603973)
    emitw(3531603974)
    emitw(3531603975)
    emitw(3531603976)
    emitw(3531603977)
    emitw(3531603978)
    emitw(3531603979)
    emitw(3531603980)
    emitw(3531603981)
    emitw(3531603982)
    emitw(3531603983)
    emitw(3531603984)
    emitw(3531603985)
    emitw(3531603986)
    emitw(3531603987)
    emitw(3531603988)
    emitw(3531603989)
    emitw(3531603990)
    emitw(3531603991)
    emitw(3531603992)
    emitw(3531603993)
    emitw(3531603994)
    emitw(3531603995)
    emitw(3531603996)
    emitw(3531603997)
    emitw(3531603998)
    return

emit_nodump:
    if sc_nodump is 0
        return
    # prctl(PR_SET_DUMPABLE, 0) - aarch64 prctl is 167. the x86 side
    # had this since pass 116; the arm stub sat empty.
    set_reg(0, 4)
    set_reg(1, 0)
    set_reg(8, sc_nodump)
    sysc()
    return

# x86 string-instruction fast paths have no AArch64 form.
# Returning 0 makes the caller emit an ordinary loop instead.

try_opt_while cond blines:
    return 0

# ---- runtime helpers ----

# x0 = pointer, returns the length in x0

emit_strlen:
    fn_names: _sov_list_add(fn_names, "_sov_strlen")
    fn_offs: _sov_list_add(fn_offs, here())
    # pass 141: a byte value is not a pointer; anything at or under
    # 4095 is the empty string here too, never dereferenced
    emitw(4047502367)
    gb: here()
    emitw(1409286153)
    mov_reg(9, 0)
    set_reg(0, 0)
    top: here()
    emitw(945842475)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432697344)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ex)
    ret()
    gz: here()
    set_reg(0, 0)
    ret()
    put_arm(gb, gz - gb)

# x0, x1 = two pointers, returns 1 when the text matches

emit_streq:
    fn_names: _sov_list_add(fn_names, "_sov_str_eq")
    fn_offs: _sov_list_add(fn_offs, here())
    mov_reg(9, 0)
    mov_reg(10, 1)
    set_reg(11, 0)
    top: here()
    emitw(2332754220)
    emitw(2332754253)
    emitw(960496014)
    emitw(960496047)
    emitw(1796145631)
    ne: here()
    emitw(1409286145)
    emitw(1895825887)
    eq: here()
    emitw(1409286144)
    emitw(2432697707)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ne)
    set_reg(0, 0)
    ret()
    put_here(eq)
    set_reg(0, 1)
    ret()

# x0 = pointer, writes the text then a newline

emit_print_int:
    fn_names: _sov_list_add(fn_names, "_sov_print_int")
    fn_offs: _sov_list_add(fn_offs, here())
    emitw(3506488319)
    mov_reg(9, 0)
    set_reg(15, 0)
    emitw(4043309375)
    ng: here()
    emitw(1409286154)
    set_reg(15, 1)
    emitw(3406365673)
    put_here(ng)
    emitw(2432746474)
    set_reg(11, 10)
    emitw(3506439498)
    emitw(956301643)
    set_reg(12, 10)
    d: here()
    emitw(2597062957)
    emitw(2601297326)
    # x14 now holds the remainder, and the remainder of a negative
    # number is negative. the negate at the top of this task cannot
    # fix that for the most negative value - negating it hands back
    # the same value - so every digit reached the add below as 48
    # minus itself. take the sign off the digit instead: cmp x14, #0
    # then b.ge over a sub x14, xzr, x14, the same pair the top uses
    emitw(4043309535)
    nq: here()
    emitw(1409286154)
    emitw(3406693358)
    put_here(nq)
    emitw(2432745934)
    emitw(3506439498)
    emitw(956301646)
    mov_reg(9, 13)
    emitw(4043309375)
    bn: here()
    emitw(1409286145)
    put_arm(bn, d - bn)
    emitw(4043309567)
    ns: here()
    emitw(1409286144)
    emitw(3506439498)
    set_reg(11, 45)
    emitw(956301643)
    put_here(ns)
    set_reg(0, 1)
    mov_reg(1, 10)
    emitw(2432746466)
    emitw(3406430274)
    set_reg(8, sc_write)
    sysc()
    emitw(2432746495)
    ret()

# x0 = size, returns a pointer with an 8 byte length header behind it

emit_alloc:
    fn_names: _sov_list_add(fn_names, "_sov_alloc")
    fn_offs: _sov_list_add(fn_offs, here())
    mov_reg(13, 0)
    gl: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(gl, "glob64", "heap_ptr")
    emitw(4181721386)
    emitw(4043309407)
    nz: here()
    emitw(1409286145)
    emit_mmap()
    mov_reg(10, 0)
    put_here(nz)
    emitw(4177527117)
    emitw(2432704843)
    emitw(2332885356)
    emitw(2432703884)
    emitw(2457727372)
    gs: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(gs, "glob64", "heap_ptr")
    emitw(4177527084)
    mov_reg(0, 11)
    ret()


# --- pass 3 shared additions ---

body lines:
    n: _sov_list_len(lines)
    i: 0
    bk: _sov_list_new()
    bi: _sov_list_new()
    bj: _sov_list_new()
    bs: _sov_list_new()
    be: _sov_list_new()
    br: _sov_list_new()
    as long as i < n
        raw: _sov_list_get(lines, i)
        s: strip(raw)
        err_line: i + 1
        if _sov_list_len(stmt_lns) > i
            err_line: _sov_list_get(stmt_lns, i)
        ind: nind(raw)
        if length(s) is 0
            i: i + 1
        if not
            if starts(s, "#") is 1
                i: i + 1
            if not
                isel: 0
                if same(s, "if not") is 1
                    isel: 1
                if starts(s, "except") is 1
                    isel: 1
                popgo: 1
                as long as popgo is 1
                    if _sov_list_len(bk) is 0
                        popgo: 0
                    if not
                        last: _sov_list_len(bk) - 1
                        if ind > _sov_list_get(bi, last)
                            popgo: 0
                        if not
                            stay: 0
                            if isel is 1
                                if ind is _sov_list_get(bi, last)
                                    if same(_sov_list_get(bk, last), "if") is 1
                                        stay: 1
                                    if same(_sov_list_get(bk, last), "try") is 1
                                        stay: 1
                            if stay is 1
                                popgo: 0
                            if not
                                popblk()
                loop_ok: 0
                if starts(s, "as long as ") is 1
                    s: join("while ", strip(cut(s, 11, length(s))))
                    loop_ok: 1
                if starts(s, "if ") is 1
                    if same(s, "if not") is 0
                        if starts(s, "if not ") is 0
                            expr(cut(s, 3, length(s)))
                            test_rax()
                            z: jz()
                            bk: _sov_list_add(bk, "if")
                            bi: _sov_list_add(bi, ind)
                            bj: _sov_list_add(bj, z)
                            bs: _sov_list_add(bs, 0)
                            be: _sov_list_add(be, _sov_list_new())
                            br: _sov_list_add(br, 0)
                            br_depth: br_depth + 1
                        if not
                            stmt(s)
                    if not
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                if not
                    # the if-not chain resets here: an always-false gate keeps
                    # the next if-not a plain "keep going", the way the old
                    # and-if-not token did
                    if 0 is 1
                        last: 0
                    if not
                        if starts(s, "do while ") is 1
                            bln: collect_body(lines, i + 1, ind)
                            if try_opt_while(cut(s, 9, length(s)), bln) is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                            if not
                                cflush_all()
                                st: here()
                                expr(cut(s, 9, length(s)))
                                test_rax()
                                z: jz()
                                bk: _sov_list_add(bk, "while")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, st)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                                br_depth: br_depth + 1
                        if not
                            if loop_ok is 1
                                bln: collect_body(lines, i + 1, ind)
                                if try_opt_while(cut(s, 6, length(s)), bln) is 1
                                    i: skip_body(lines, i + 1, ind)
                                    i: i - 1
                                if not
                                    cflush_all()
                                    st: here()
                                    expr(cut(s, 6, length(s)))
                                    test_rax()
                                    z: jz()
                                    bk: _sov_list_add(bk, "while")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, z)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                          br_depth: br_depth + 1
                              br: _sov_list_add(br, 0)
                            if not
                                if same(s, "do forever") is 1
                                    st: here()
                                    bk: _sov_list_add(bk, "forever")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, 0 - 1)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                    br_depth: br_depth + 1
                                if not
                                    # chain reset, as above (the repeat token is gone)
                                    if 0 is 1
                                        last: 0
                                    if not
                                        if same(s, "try") is 1
                                            cflush_all()
                                            if idx(glob_names, "err_top") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_top")
                                            if idx(glob_names, "err_val") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_val")
                                            # the frame: the error top, the frame
                                            # pointer, the stack, and where the handler
                                            # starts
                                            emitw(2432697321)
                                            emitw(4162785257)
                                            load_glob("err_top")
                                            emitw(4162785248)
                                            ta: here()
                                            emitw(268435466)
                                            emitw(4162785258)
                                            emitw(2432697321)
                                            mov_reg(0, 9)
                                            store_glob("err_top")
                                            bk: _sov_list_add(bk, "try")
                                            bi: _sov_list_add(bi, ind)
                                            bj: _sov_list_add(bj, 0)
                                            bs: _sov_list_add(bs, 0)
                                            be: _sov_list_add(be, _sov_list_new())
                                            br: _sov_list_add(br, ta)
                                            br_depth: br_depth + 1
                                        if not
                                            if starts(s, "except") is 1
                                                last: _sov_list_len(bk) - 1
                                                if last > 0 - 1
                                                    if same(_sov_list_get(bk, last), "try") is 1
                                                        ev: strip(cut(s, 6, length(s)))
                                                        # pass 68: a local may not share a global's name -
                                                        # the load/store ladders divert global-named names to
                                                        # the global until the moment a local appears, so the
                                                        # one hole is an except name materialising a local
                                                        # mid-function. refuse loudly.
                                                        if idx(glob_names, ev) > 0 - 1
                                                            if idx(locals, ev) < 0
                                                                print "Error: the except name shadows a global"
                                                                _sov_print(ev)
                                                                print err_line
                                                                had_err: 1
                                                        load_glob("err_top")
                                                        mov_reg(9, 0)
                                                        emitw(4181723424)
                                                        store_glob("err_top")
                                                        emitw(2432746495)
                                                        tb: here()
                                                        emitw(335544320)
                                                        bs: _sov_list_set(bs, last, tb)
                                                        put_here(_sov_list_get(br, last))
                                                        load_glob("err_val")
                                                        store_loc(slot(ev))
                                                        bk: _sov_list_add(bk, "except")
                                                        bi: _sov_list_add(bi, ind)
                                                        bj: _sov_list_add(bj, 0)
                                                        bs: _sov_list_add(bs, 0)
                                                        be: _sov_list_add(be, _sov_list_new())
                                                        br: _sov_list_add(br, 0)
                                                        br_depth: br_depth + 1
                                                    if not
                                                        print "Error: except without try"
                                                        _sov_print(s)
                                                        print err_line
                                                        had_err: 1
                                                if not
                                                    print "Error: except without try"
                                                    _sov_print(s)
                                                    print err_line
                                                    had_err: 1
                                            if not
                                                if starts(s, "raise ") is 1
                                                    expr(cut(s, 6, length(s)))
                                                    if idx(glob_names, "err_val") is 0 - 1
                                                        glob_names: _sov_list_add(glob_names, "err_val")
                                                    if idx(glob_names, "err_top") is 0 - 1
                                                        glob_names: _sov_list_add(glob_names, "err_top")
                                                    store_glob("err_val")
                                                    load_glob("err_top")
                                                    # x10 keeps the frame: store_glob
                                                    # spends x9 reaching its cell, so
                                                    # the frame read must not go through
                                                    # x9 after that. walking +32/+48 of a three-slot
                                                    # frame lands x29 and the
                                                    # nowhere stack on top of each
                                                    # other. reads: old top at +16,
                                                    # caller sp at +32, handler at +0,
                                                    # branch by x10, which ldr keeps.
                                                    mov_reg(10, 0)
                                                    emitw(4043309407)
                                                    zz: here()
                                                    emitw(1409286144)
                                                    emitw(4181723456)
                                                    store_glob("err_top")
                                                    emitw(4181725515)
                                                    emitw(2432696703)
                                                    emitw(4181721418)
                                                    emitw(3592356160)
                                                    put_here(zz)
                                                    load_glob("err_val")
                                                    used_pi: 1
                                                    calln("_sov_print_int")
                                                    set_reg(0, 1)
                                                    set_reg(8, sc_exit)
                                                    sysc()
                                                if not
                                                    stmt(s)
                i: i + 1
    as long as _sov_list_len(bk) > 0
        popblk()

compile source:
    oc: _sov_list_new()
    iota_ptr: blank
    iota_lim: blank
    kn: blank
    kv: 0
    skip_al: blank
    used_al: 0
    used_sl: 0
    used_eq: 0
    used_pr: 0
    used_pi: 0
    used_tr: 0
    did_stos: 0
    thin_main: 0
    has_vm: 0
    need_priv: 0
    saw_str: 0
    str_vars: _sov_list_new()
    str_fns: _sov_list_new()
    ar_names: _sov_list_new()
    ar_cnt: _sov_list_new()
    str_fns: _sov_list_add(str_fns, "cat")
    str_fns: _sov_list_add(str_fns, "strcat")
    str_fns: _sov_list_add(str_fns, "_sov_strcat")
    str_fns: _sov_list_add(str_fns, "sub")
    str_fns: _sov_list_add(str_fns, "trim")
    str_fns: _sov_list_add(str_fns, "ch")
    str_fns: _sov_list_add(str_fns, "_sov_substring")
    str_fns: _sov_list_add(str_fns, "str_cat")
    str_fns: _sov_list_add(str_fns, "str_cut")
    str_fns: _sov_list_add(str_fns, "str_trim")
    str_fns: _sov_list_add(str_fns, "str_join3")
    str_fns: _sov_list_add(str_fns, "_sov_trim")
    str_fns: _sov_list_add(str_fns, "join")
    str_fns: _sov_list_add(str_fns, "strip")
    str_fns: _sov_list_add(str_fns, "cut")
    str_fns: _sov_list_add(str_fns, "repl")
    str_fns: _sov_list_add(str_fns, "letter")
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) is 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") is 0
                    if starts(pre_t, "use ") is 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c is length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") is 1
                                            pre_in: 0
                                        if not
                                            if pre_in is 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
                                    # seven values is the most a job can
                                    # take. more used to compile and then
                                    # go wrong while running.
                                    if pre_na > 7
                                        print "Error: a job takes at most seven values"
                                        _sov_print(pre_cur)
                                        print pre_na
                                        had_err: 1
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, pre_na)
                                if not
                                    pre_cur: pre_h
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, 0)
            if not
                pre_t2: strip(pre_l)
                if starts(pre_t2, "return ") is 1
                    pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                    if starts(pre_r, "as text ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if starts(pre_r, "as ptr ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    # the documented form is the postfix cast: return "x" as text
                    if length(pre_r) >= 8
                        if same(cut(pre_r, length(pre_r) - 8, length(pre_r)), " as text") is 1
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                    if length(pre_r) >= 7
                        if same(cut(pre_r, length(pre_r) - 7, length(pre_r)), " as ptr") is 1
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                    if length(pre_r) > 0
                        if _sov_byte_at(pre_r, 0) is 34
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                        if not
                            if same(pre_r, "blank") is 1
                                if length(pre_cur) > 0
                                    mark_fn_str(pre_cur)
        pre_i: pre_i + 1
    # a job that hands back another job's answer is a text job too,
    # whatever order the jobs were written in. Keep going round until
    # nobody new is marked, so forward references work as well as
    # backward ones.
    changed: 1
    as long as changed is 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) is 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") is 0
                        if starts(pre_t, "use ") is 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c is length(pre_t) - 1
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    if starts(pre_t2, "return ") is 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(str_fns, pre_cur) < 0
                            if starts(pre_r, "as text ") is 0
                                if starts(pre_r, "as ptr ") is 0
                                    if length(pre_r) > 0
                                        if _sov_byte_at(pre_r, 0) is not 34
                                            if same(pre_r, "blank") is 0
                                                pre_lp: look(pre_r, "(")
                                                if pre_lp > 0
                                                    pre_f: strip(cut(pre_r, 0, pre_lp))
                                                    if idx(str_fns, pre_f) > 0 - 1
                                                        mark_fn_str(pre_cur)
                                                        changed: 1
            pre_i: pre_i + 1
    # a program that wipes or marks private data must not core-dump it.
    # match the statements, not the substring: look() must not match
    # "# would wipe what the stub stored" in a runtime comment and
    # spent 14 bytes of prctl in every runtime-linked binary.
    nls: lines_of(source)
    ni: 0
    as long as ni < _sov_list_len(nls)
        ns: strip(_sov_list_get(nls, ni))
        if same(ns, "private") is 1
            need_priv: 1
        if starts(ns, "wipe ") is 1
            need_priv: 1
        ni: ni + 1
    cnms: _sov_list_new()
    cvls: _sov_list_new()
    cemt: _sov_list_new()
    strb: _sov_buf_new()
    str_keys: _sov_list_new()
    str_pos: _sov_list_new()
    fn_names: _sov_list_new()
    fn_offs: _sov_list_new()
    fn_locs: _sov_list_new()
    glob_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_val: _sov_list_new()
    patch_line: _sov_list_new()
    stmt_lns: _sov_list_new()
    body_lns: _sov_list_new()
    task_lns: _sov_list_new()
    task_user: _sov_list_new()
    lns: lines_of(source)
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    li: 0
    as long as li < _sov_list_len(lns)
        raw: _sov_list_get(lns, li)
        s: strip(raw)
        th: 0
        if is_task_hdr(s) is 1
            th: 1
        if th is 1
            if in_t is 1
                bodies: _sov_list_add(bodies, cur)
                body_lns: _sov_list_add(body_lns, cur_ln)
            tn: tname(s)
            if idx(names, tn) > 0 - 1
                print "Error: two with the same name"
                _sov_print(tn)
                err_line: file_ln(li)
                print err_line
                had_err: 1
            names: _sov_list_add(names, tn)
            params: _sov_list_add(params, tparams(s))
            tu: 0
            if li + 1 > src_base
                tu: 1
            task_user: _sov_list_add(task_user, tu)
            task_lns: _sov_list_add(task_lns, file_ln(li))
            cur: _sov_list_new()
            cur_ln: _sov_list_new()
            in_t: 1
        if not
            if nind(raw) is 0
                gok: 0
                gc: find_col(s)
                if gc > 0
                    if gc < length(s) - 1
                        gok: 1
                if gok is 1
                    gn: blank
                    if starts(s, "<-- ") is 1
                        rest: cut(s, 4, length(s))
                        t: find_sep(rest)
                        if t > 0 - 1
                            gn: repl(strip(cut(rest, 0, t)), " ", "_")
                    if not
                        gn: repl(strip(cut(s, 0, gc)), " ", "_")
                    if length(gn) > 0
                        if idx(glob_names, gn) is 0 - 1
                            glob_names: _sov_list_add(glob_names, gn)
                        # a top-level "x: x" only registers the global;
                        # the store is a no-op (the start stub has already
                        # filled g_argc/g_argv before main runs). skip it.
                        sa: 0
                        if gc + 1 < length(s)
                            grhs: strip(cut(s, gc + 1, length(s)))
                            if same(repl(grhs, " ", "_"), gn) is 1
                                sa: 1
                        if sa is 0
                            tops: _sov_list_add(tops, raw)
            if not
                if in_t is 1
                    cur: _sov_list_add(cur, raw)
                    cur_ln: _sov_list_add(cur_ln, file_ln(li))
        li: li + 1
    if in_t is 1
        bodies: _sov_list_add(bodies, cur)
        body_lns: _sov_list_add(body_lns, cur_ln)
    has_vm: 0
    if look(source, "task _sov_alloc") > 0 - 1
        has_vm: 1
    if look(source, "_sov_alloc size:") > 0 - 1
        has_vm: 1
    prep_main(names, params, bodies)
    # count each function's distinct local declarations now that the
    # global names are known, so a frame-free main can be recognised.
    # A local is any indented name: line that is neither a global nor
    # a job.
    fli: 0
    as long as fli < _sov_list_len(bodies)
        fb: _sov_list_get(bodies, fli)
        fset: _sov_list_new()
        flj: 0
        as long as flj < _sov_list_len(fb)
            fls: strip(_sov_list_get(fb, flj))
            if length(fls) > 0
                if _sov_byte_at(fls, 0) is not 35
                    if _sov_byte_at(fls, 0) is not 34
                        fgc: find_col(fls)
                        if fgc > 0
                            if fgc < length(fls) - 1
                                fgn: repl(strip(cut(fls, 0, fgc)), " ", "_")
                                if length(fgn) > 0
                                    if idx(glob_names, fgn) is 0 - 1
                                        if idx(fset, fgn) is 0 - 1
                                            fset: _sov_list_add(fset, fgn)
            flj: flj + 1
        fn_locs: _sov_list_add(fn_locs, _sov_list_len(fset))
        fli: fli + 1
    if has_vm is 1
        glob_names: _sov_list_add(glob_names, "heap_ptr")
        if pie_walk is 1
            emit_walk()
        start_off: here()
        emit_start()
        emit_alloc()
        emit_strlen()
        emit_streq()
        emit_print()
        emit_print_int()
        thin_main: 0
    if not
        if pie_walk is 1
            emit_walk()
        if thin_main is 0
            start_off: here()
            emit_start()
    fi: 0
    as long as fi < _sov_list_len(names)
        nm: _sov_list_get(names, fi)
        if idx(fn_names, nm) < 0
                fn_names: _sov_list_add(fn_names, nm)
                fn_offs: _sov_list_add(fn_offs, here())
                locals: _sov_list_new()
                str_vars: _sov_list_new()
                saw_str: 0
                br_depth: 0
                fw_on: 0
                fw_done: 0
                fw_pos: _sov_list_new()
                stmt_lns: _sov_list_get(body_lns, fi)
                if _sov_list_len(_sov_list_get(bodies, fi)) is 0
                    if _sov_list_get(task_user, fi) is 1
                        print "Warning: empty"
                        _sov_print(nm)
                        print _sov_list_get(task_lns, fi)
                ps: _sov_list_get(params, fi)
                pi: 0
                as long as pi < _sov_list_len(ps)
                    locals: _sov_list_add(locals, _sov_list_get(ps, pi))
                    pi: pi + 1
                thin: 0
                if same(nm, "main") is 1
                    if _sov_list_len(ps) is 0
                        floc: 0
                        if fi < _sov_list_len(fn_locs)
                            floc: _sov_list_get(fn_locs, fi)
                        if floc is 0
                            thin: 1
                if thin is 1
                    skip_al: dead_iota(_sov_list_get(bodies, fi))
                    if need_priv is 1
                        emit_nodump()
                        emit_canary_seed()
                        emit_crash_install()
                    carm_main_now: 1
                    body(tops)
                    cflush_all()
                    carm_main_now: 1
                    body(_sov_list_get(bodies, fi))
                    carm_main_now: 0
                    if saw_str is 1
                        mark_fn_str(nm)
                    if need_priv is 1
                        emit_stack_wipe()
                    set_reg(0, 0)
                    set_reg(8, sc_exit)
                    sysc()
                if not
                    isfib: fiblike(nm, ps, _sov_list_get(bodies, fi))
                    # frame-free: the fib walk lives in caller-saved
                    # registers only, so the frame and the arg copy
                    # are pure overhead for it
                    if isfib is 0
                        prolog()
                        copyargs(_sov_list_len(ps))
                    cbi: 0
                    can_here: 0
                    as long as cbi < _sov_list_len(_sov_list_get(bodies, fi))
                        if same(strip(_sov_list_get(_sov_list_get(bodies, fi), cbi)), "private") is 1
                            can_here: 1
                        cbi: cbi + 1
                    if can_here is 1
                        if isfib is 0
                            canary_store_a64()
                    if isfib is 1
                        emit_fib_iter_a64()
                    if same(nm, "main") is 1
                        skip_al: dead_iota(_sov_list_get(bodies, fi))
                        if need_priv is 1
                            emit_nodump()
                            emit_canary_seed()
                            emit_crash_install()
                        carm_main_now: 1
                        body(tops)
                        carm_main_now: 0
                        cflush_all()
                    if isfib is 0
                        if same(nm, "main") is 1
                            carm_main_now: 1
                        body(_sov_list_get(bodies, fi))
                        if same(nm, "main") is 1
                            carm_main_now: 0
                    if saw_str is 1
                        mark_fn_str(nm)
                    ns: 0
                    if isfib is 0
                        ns: 64
                        if _sov_list_len(locals) > 5
                            ns: (_sov_list_len(locals) - 5) * 8 + 64
                            as long as ns % 16 is not 0
                                ns: ns + 8
                        put_sub_sp(pro_at, ns)
                        if fw_on is 1
                            if same(nm, "main") is 0
                                if isfib is 0
                                    xor_rax()
                                    canary_check_a64()
                                    frame_wipe_a64()
                                    fw_done: 1
                                fwi: 0
                                as long as fwi < _sov_list_len(fw_pos)
                                    oc_set_word(_sov_list_get(fw_pos, fwi), 3506439088 + (ns % 4096) * 1024)
                                    fwi: fwi + 1
                    if same(nm, "main") is 1
                        if need_priv is 1
                            emit_stack_wipe()
                        set_reg(0, 0)
                        set_reg(8, sc_exit)
                        sysc()
                    if not
                        # the fib fast path ends in its own ret; a
                        # second epilogue here would be dead words.
                        # a private function just got its wipe
                        # epilogue above, so this one is dead too
                        if isfib is 0
                            if fw_done is 0
                                xor_rax()
                                leave()
                                ret()
        fi: fi + 1
    if has_vm is 0
        emit_used()
    if can_used is 1
        emit_canary_fail()
    if need_priv is 1
        emit_crash_handler()
    warn_unused()
    dce()

push_rax:
    emitw(4162785248)

# str xN,[sp,#-16]!

store_loc slot:
    if slot < 5
        mov_reg(loc_reg(slot), 0)
        return
    str_fp(0, (slot - 5) * 8 + 8)

# pass S5: the stack canary, arm shape. a private frame stores
# the canary below its frame at [x29-128] and proves it on every
# return; a smashed frame lands in the refusal stub instead of
# returning into the smash. seeded from getrandom before main.

emit_canary_seed:
    if idx(glob_names, "g_canary") is 0 - 1
        glob_names: _sov_list_add(glob_names, "g_canary")
    # getrandom(&g_canary, 8) - arm64 linux 278, two arguments
    at: here()
    movz_x(9, 0, 0)
    movk_x(9, 0, 1)
    movk_x(9, 0, 2)
    addp(at, "glob64", "g_canary")
    mov_reg(0, 9)
    set_reg(1, 8)
    set_reg(8, sc_rand)
    sysc()

# pass S6: crash handlers, arm64 shape. rt_sigaction arms five
# handlers and the sigreturn trampoline real arm64 insists on:
# SA_RESTORER set, the restorer pointer in the act.

emit_crash_install:
    if sc_sigact is 0
        return
    # rt_sigaction for ill, abrt, bus, fpe, segv. the act lives at
    # [sp]: handler, restorer, an empty mask, SA_RESTORER
    emitw(3506471935)
    csgs: _sov_list_new()
    csgs: _sov_list_add(csgs, 4)
    csgs: _sov_list_add(csgs, 6)
    csgs: _sov_list_add(csgs, 7)
    csgs: _sov_list_add(csgs, 8)
    csgs: _sov_list_add(csgs, 11)
    cnms: _sov_list_new()
    cnms: _sov_list_add(cnms, "_sov_cw_4")
    cnms: _sov_list_add(cnms, "_sov_cw_6")
    cnms: _sov_list_add(cnms, "_sov_cw_7")
    cnms: _sov_list_add(cnms, "_sov_cw_8")
    cnms: _sov_list_add(cnms, "_sov_cw_11")
    csi: 0
    as long as csi < 5
        sg: _sov_list_get(csgs, csi)
        nm: _sov_list_get(cnms, csi)
        at9: here()
        movz_x(0, 0, 0)
        movk_x(0, 0, 1)
        movk_x(0, 0, 2)
        movk_x(0, 0, 3)
        addp(at9, "fnaddr64", nm)
        emitw(4177527776)
        at10: here()
        movz_x(0, 0, 0)
        movk_x(0, 0, 1)
        movk_x(0, 0, 2)
        movk_x(0, 0, 3)
        addp(at10, "fnaddr64", "_sov_cw_ret")
        emitw(4177528800)
        emitw(4177529855)
        movz_x(11, 4, 1)
        emitw(4177530859)
        set_reg(0, sg)
        emitw(2432697313)
        set_reg(2, 0)
        set_reg(3, 8)
        set_reg(8, sc_sigact)
        sysc()
        csi: csi + 1
    emitw(2432730111)

# globals: address built with movz+movk+movk, patched as glob64

emit_fib_iter_a64:
    # frame-free: n arrives in x0 and the walk stays in x9/x10/x11,
    # all caller-saved, so there is no prolog, no arg copy and no
    # leave. n <= 1 keeps x0 = n and b.le goes straight to the ret:
    # b.le must not aim at the loop's own b.gt; it fell through
    # and returned the unseeded x10 - fib(1) printed garbage.
    emitw(4043310111)
    emitw(1409286477)
    emitw(3531603977)
    emitw(3531604010)
    emitw(4043310080)
    emitw(2332688683)
    mov_reg(9, 10)
    mov_reg(10, 11)
    emitw(4043310080)
    emitw(1426063244)
    mov_reg(0, 10)
    ret()

compound s:
    i: 0
    n: length(s)
    intext: 0
    as long as i + 1 < n
        c: _sov_byte_at(s, i)
        if c is 34
            if intext is 0
                intext: 1
            if not
                intext: 0
        if intext is 0
            if _sov_byte_at(s, i + 1) is 61
                op: 0
                if c is 43
                    op: 1
                if c is 45
                    op: 1
                if c is 42
                    op: 1
                if c is 47
                    op: 1
                if c is 38
                    op: 1
                if c is 124
                    op: 1
                if c is 94
                    op: 1
                if op is 1
                    lhs: strip(cut(s, 0, i))
                    rhs: strip(cut(s, i + 2, n))
                    if length(lhs) > 0
                        if length(rhs) > 0
                            return join(join(lhs, ": "), join(join(lhs, " "), join(join(cut(s, i, i + 1), " "), rhs)))
        i: i + 1
    return s
