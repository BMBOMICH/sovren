# WARNING: demo primitives. Use sha256 for real hashing.
# crypto.sov — hash && XOR lock
# needs _sov_list
use hash
use encrypt
use string

crypto_hash s:
    return hash_text(s)

crypto_lock data key:
    return encrypt_xor(data, key)

crypto_unlock data key:
    return decrypt_xor(data, key)

crypto_mix s key:
    return hash_text(str_cat(key, s))
