kfont_draw_glyph framebuffer width x y code fg bg:
    if framebuffer is 0 -> return 0 - 1
    if width < 8 -> return 0 - 1
    if x < 0 -> return 0 - 1
    if y < 0 -> return 0 - 1
    if x + 8 > width -> return 0 - 1
    if y < 0 -> return 0 - 1
    idx: kfont_index(code)
    if idx < 0 -> idx: kfont_index(63)
    glyph: kfont_glyph(idx)
    row: 0
    as long as row < 8
        bits: bshr(glyph, row * 8) % 256
        col: 0
        as long as col < 8
            pixel: bg
            if band(bshr(bits, col), 1) is 1 -> pixel: fg
            if pixel is not 0 - 1 -> poke_raw32(framebuffer + ((y + row) * width + x + col) * 4, 0, pixel)
            col: col + 1
        row: row + 1
    return 8
kfont_draw_text framebuffer width x y text fg bg:
    if framebuffer is 0 -> return 0 - 1
    if width < 8 -> return 0 - 1
    if text is 0 -> return 0 - 1
    cx: x
    i: 0
    as long as 1 is 1
        c: peek_byte(text, i)
        if c is 0 -> leave
        advanced: kfont_draw_glyph(framebuffer, width, cx, y, c, fg, bg)
        if advanced < 0 -> return 0 - 1
        cx: cx + advanced
        if cx + 8 > width -> leave
        i: i + 1
    return cx - x
