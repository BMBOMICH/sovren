    emit(0)
    emit(2)
    emit(0)
    emit(0)
    emit(15)
    emit(133)
    jbck: here()
    br_at: _sov_list_add(br_at, jbck)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, jbck)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    put(jbck, lp - (jbck + 4))
    patch(tl)
    emit(137)
    emit(209)
    emit(129)
    emit(225)
    emit(255)
    emit(1)
    emit(0)
    emit(0)
    dn: jz()
    rax_imm(opt_imm)
    emit(243)
    emit(170)
    patch(dn)
    emit_name_or_imm(lim)
    storev(iv)
    patch(sk)

emit_scaled_reg bs i2 v dp:
    # mov [r_base + r_idx * 8 + dp], r_val - same verification.
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    if v > 0
        rx: rx + 4
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + (v + 3) * 8 + nd * 64
    emit(m)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
    return 0

emit_store_abs bs vr imm:
    # mov [r_base + imm], slot vr - twin of the load above. the
    # value field is the register slot form (vr + 3), REX.R when
    # the value sits past rbx. GAS-verified.
    rx: 72
    if bs > 0
        rx: rx + 1
    if vr > 0
        rx: rx + 4
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        emit(nd * 64 + (vr + 3) * 8 + 4)
        emit(36)
    if not
        emit(nd * 64 + (vr + 3) * 8 + bs + 3)
    if nd is 1
        emit(imm)
    if nd is 2
        emit4(imm)
    return 0

emit_store_abs_rax bs imm:
    # mov [r_base + imm], rax - the same form with a nought /r
    # field, for values loadv materialised. r12 takes the SIB
    # escape like the slot-value form. GAS-verified.
    rx: 72
    if bs > 0
        rx: rx + 1
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        emit(nd * 64 + 4)
        emit(36)
    if not
        emit(nd * 64 + bs + 3)
    if nd is 1
        emit(imm)
    if nd is 2
        emit4(imm)
    return 0

emit_store_scaled_rax bs i2 dp:
    # mov [r_base + r_idx * 8 + dp], rax - the value-from-rax half
    # of emit_scaled_reg (/r field nought, no REX.R), same mod01
    # rule and the same trailing-byte nop guard. GAS-verified.
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + nd * 64
    emit(m)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
    return 0

