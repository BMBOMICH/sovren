lea_ok ag:
    p: look(ag, " - ")
    neg: 1
    if p < 0
        p: look(ag, " + ")
        neg: 0
    if p < 0
        return 0
    nm: strip(cut(ag, 0, p))
    cs: strip(cut(ag, p + 3, length(ag)))
    if plain_name(nm) is 0
        return 0
    if is_imm(cs) is 0
        return 0
    v: _sov_atoi(cs)
    if neg is 1
        v: 0 - v
    if v > 127
        return 0
    if v < 0 - 128
        return 0
    if v is 0
        return 0
    if reg_slot(nm) < 0
        return 0
    return 1

leaf8_scan lines:
    # pass 43b gate: 1 when a body may give its fifth-eighth locals
    # the scratch registers (slots 5-7 = r8/r9/r10). The rule: no
    # calls and no syscall-emitting constructs, so nothing but this
    # task's own stores can write those registers. Only the six
    # inline peek/poke forms may parenthesize; print, raise,
    # syscall and runtime-proc names disqualify outright. False
    # rejects only cost speed, never correctness.
    li: 0
    as long as li < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, li))
        cm: look(s, "#")
        if cm > 0 - 1
            s: strip(cut(s, 0, cm))
        if look(s, "print") > 0 - 1
            return 0
        if look(s, "raise") > 0 - 1
            return 0
        if look(s, "syscall") > 0 - 1
            return 0
        if look(s, "_sov_") > 0 - 1
            return 0
        p: 0
        m: length(s)
        as long as p < m
            if _sov_byte_at(s, p) is 40
                q: p
                go: 1
                as long as go is 1
                    if q is 0
                        go: 0
                    if not
                        b: _sov_byte_at(s, q - 1)
                        aln: 0
                        if b > 47
                            if b < 58
                                aln: 1
                        if b > 64
                            if b < 91
                                aln: 1
                        if b > 96
                            if b < 123
                                aln: 1
                        if b is 95
                            aln: 1
                        if aln is 1
                            q: q - 1
                        if not
                            go: 0
                tk: cut(s, q, p)
                ok: 0
                if same(tk, "peek_i64") is 1
                    ok: 1
                if same(tk, "poke_i64") is 1
                    ok: 1
                if same(tk, "peek_raw64") is 1
                    ok: 1
                if same(tk, "poke_raw64") is 1
                    ok: 1
                if same(tk, "peek_byte") is 1
                    ok: 1
                if same(tk, "poke_byte") is 1
                    ok: 1
                if ok is 0
                    return 0
            p: p + 1
        li: li + 1
    return 1

length s:
    return _sov_strlen(s)

letter t i:
    return _sov_char_at(t, i)

lim_const lim:
    # a run limit we can prove at compile time, in 1..2^31-1
    if same(lim, kn) is 1
        if kv > 0
            if kv < 2147483648
                return kv
    if is_imm(lim) is 1
        v: _sov_atoi(lim)
        if v > 0
            if v < 2147483648
                return v
    return 0

lim_source_const lines li lim:
    # the nearest assignment to lim above line li, read from the
    # source. sound only when that line sits at or above the loop's
    # own indent (an assignment inside a deeper block is conditional
    # or loop-carried and proves nothing).
    jj: li - 1
    pref: join(lim, ": ")
    loopind: nind(_sov_list_get(lines, li))
    as long as jj >= 0
        raw: _sov_list_get(lines, jj)
        pl: strip(raw)
        if length(pl) > 0
            if starts(pl, "#") is 0
                if starts(pl, pref) is 1
                    if nind(raw) <= loopind
                        vs: strip(cut(pl, length(pref), length(pl)))
                        if digit(letter(vs, 0)) is 1
                            if look(vs, " ") < 0
                                return _sov_atoi(vs)
                    return 0
        jj: jj - 1
    return 0

lines_of source:
    lst: _sov_list_new()
    start: 0
    i: 0
    n: length(source)
    as long as i < n
        if _sov_byte_at(source, i) is 10
            lst: _sov_list_add(lst, cut(source, start, i))
            start: i + 1
        i: i + 1
    if start < n
        lst: _sov_list_add(lst, cut(source, start, n))
    return lst

load_file path:
    fd: _sov_open(path, 0)
    if fd < 0
        return 0
    sz: _sov_lseek(fd, 0, 2)
    _sov_lseek(fd, 0, 0)
    if sz < 1
        _sov_close(fd)
        return 0
    buf: _sov_alloc(sz + 1)
    got: _sov_read(fd, buf, sz)
    _sov_close(fd)
    dummy: _sov_set_byte(buf, got, 0)
    return buf

load_loc slot:
    if slot is 0
        emit(72)
        emit(137)
        emit(216)
        return
    if slot is 1
        emit(76)
        emit(137)
        emit(224)
        return
    if slot is 2
        emit(76)
        emit(137)
        emit(232)
        return
    if slot is 3
        emit(76)
        emit(137)
        emit(240)
        return
    if slot is 4
        emit(76)
        emit(137)
        emit(248)
        return
    if slot is 5
        if leaf8 is 1
            emit(76)
            emit(137)
            emit(192)
            return
    if slot is 6
        if leaf8 is 1
            emit(76)
            emit(137)
            emit(200)
            return
    if slot is 7
        if leaf8 is 1
            emit(76)
            emit(137)
            emit(208)
            return
    if slot is 8
        if leaf8 is 1
            emit(76)
            emit(137)
            emit(216)
            return
    emit(72)
    emit(139)
    emit(133)
    emit4(loc_off(slot))

loadv name:
    cflush(name)
    g: idx(glob_names, name)
    if g > 0 - 1
        if idx(locals, name) < 0
            load_glob(name)
            return
    i: idx(locals, name)
    if i > 0 - 1
        load_loc(i)
        return
    if g > 0 - 1
        load_glob(name)
        return
    print "Error: no such name"
    _sov_print(name)
    err_where()
    suggest_name(name)
    had_err: 1
    load_loc(slot(name))

loadv_rcx name:
    loadv(name)
    li: idx(locals, name)
    if li > 0 - 1
        if li < 5
            if _sov_list_len(oc) > 0
                lb: _sov_list_get(oc, _sov_list_len(oc) - 1)
                if lb is 216
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 217)
                if lb is 224
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 225)
                if lb is 232
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 233)
                if lb is 240
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 241)
                if lb is 248
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 249)
                return 0
    # a stack local, a constant or a global: the trailing byte of
    # loadv is not a register byte, so the rewrite above cannot fire.
    # rax already holds the value, so a plain move is enough.
    mov_rcx_rax()
    return 0

# like loadv_rcx, but the value lands in rdi (the first call
# argument). The trailing mov rax, reg byte is rewritten in place.

loadv_rdi name:
    # pass 60: a pure global rides rip straight into the target
    # register - 48 8B 3D = mov rdi, [rip+disp] (row63), one op
    # instead of the loadv+mov_rdi_rax hop. cflush first, same as
    # loadv's own order; locals keep precedence exactly like loadv.
    g9: idx(glob_names, name)
    if g9 > 0 - 1
        if idx(locals, name) < 0
            cflush(name)
            emit(72)
            emit(139)
            emit(61)
            at: here()
            emit4(0)
            addp(at, "grel", name)
            return 0
    loadv(name)
    li: idx(locals, name)
    if li > 0 - 1
        if li < 5
            if _sov_list_len(oc) > 0
                lb: _sov_list_get(oc, _sov_list_len(oc) - 1)
                if lb is 216
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 223)
                if lb is 224
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 231)
                if lb is 232
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 239)
                if lb is 240
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 247)
                if lb is 248
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 255)
                return 0
    mov_rdi_rax()
    return 0

# the value lands in rsi (the second call argument)

loadv_rdx name:
    # pass 64: the pass-60 treatment reaches rdx too - a pure
    # global loads straight, 48 8B 15 (GAS row66), no rax hop.
    g9: idx(glob_names, name)
    if g9 > 0 - 1
        if idx(locals, name) < 0
            cflush(name)
            emit(72)
            emit(139)
            emit(21)
            at: here()
            emit4(0)
            addp(at, "grel", name)
            return 0
    loadv(name)
    li: idx(locals, name)
    if li > 0 - 1
        if li < 5
            if _sov_list_len(oc) > 0
                lb: _sov_list_get(oc, _sov_list_len(oc) - 1)
                if lb is 216
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 218)
                if lb is 224
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 226)
                if lb is 232
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 234)
                if lb is 240
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 242)
                if lb is 248
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 250)
                return 0
    emit(72)
    emit(137)
    emit(194)
    return 0

# the two operands sit in rax and rcx; do whatever op asked

loadv_rsi name:
    # pass 60 twin of loadv_rdi: 48 8B 35 = mov rsi, [rip+disp].
    g9: idx(glob_names, name)
    if g9 > 0 - 1
        if idx(locals, name) < 0
            cflush(name)
            emit(72)
            emit(139)
            emit(53)
            at: here()
            emit4(0)
            addp(at, "grel", name)
            return 0
    loadv(name)
    li: idx(locals, name)
    if li > 0 - 1
        if li < 5
            if _sov_list_len(oc) > 0
                lb: _sov_list_get(oc, _sov_list_len(oc) - 1)
                if lb is 216
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 222)
                if lb is 224
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 230)
                if lb is 232
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 238)
                if lb is 240
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 246)
                if lb is 248
                    oc: _sov_list_set(oc, _sov_list_len(oc) - 1, 254)
                return 0
    mov_rsi_rax()
    return 0

# the value lands in rdx (the third call argument)

loc_off slot:
    return 0 - (slot + 1) * 8

look t s:
    return _sov_find_text(t, s)

mark_fn_str name:
    if idx(str_fns, name) < 0
        str_fns: _sov_list_add(str_fns, name)

mark_str name:
    if idx(str_vars, name) < 0
        str_vars: _sov_list_add(str_vars, name)

