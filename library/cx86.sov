colon_arg one:
    if length(one) is 0
        return one
    if peek_byte(one, 0) is 34
        return one
    if is_imm(one) is 1
        return one
    if plain_name(one) is 1
        if idx(local_names, one) > 0 - 1
            return one
        if idx(global_names, one) > 0 - 1
            return one
    q: "\""
    return join(q, join(one, q))

colon_call name rhs:
    inside: blank
    i: 0
    n: length(rhs)
    start: 0
    qon: 0
    first: 1
    as long as i <= n
        take: 0
        if i is n
            take: 1
        if not
            if i < n
                b: peek_byte(rhs, i)
                if qon is 1
                    if b is 34
                        qon: 0
                if not
                    if b is 34
                        qon: 1
                    if not
                        if b is 44
                            take: 1
        if take is 1
            if qon is 0
                one: strip(cut(rhs, start, i))
                if length(one) > 0
                    bit: colon_arg(one)
                    if first is 1
                        inside: bit
                        first: 0
                    if not
                        inside: join(inside, join(", ", bit))
                start: i + 1
        i: i + 1
    value_dead: 1
    expr(join(name, join("(", join(inside, ")"))))
    value_dead: 0
    return 0

stmt line:
    note_debug_place
    skip_lock: 0
    s: strip(line)
    if length(s) is 0
        return
    if starts(s, "#") is 1
        return
    s: compound(s)
    forget_small
    q: 0
    qi: 0
    as long as qi < length(s)
        if _sov_byte_at(s, qi) is 92
            qi: qi + 1
        if not
            if _sov_byte_at(s, qi) is 34
                q: q + 1
        qi: qi + 1
    if q % 2 is not 0
        print "Error: unterminated text" : s
        err_where
        saw_error: 1
        return
    if length(s) > 1000
        print "Error: line too long, split it up"
        err_where
        saw_error: 1
        return
    if starts(s, "use ") is 1
        return
    if starts(s, "immutable ") is 1
        rest: strip(cut(s, 10, length(s)))
        t: find_col(rest)
        if t < 1
            print "Error: immutable needs a name and a value"
            err_where
            saw_error: 1
            return
        locked_names: _sov_list_add(locked_names, strip(cut(rest, 0, t)))
        skip_lock: 1
        s: rest
    if same(s, "private") is 1
        # pass 117: a function that declares private zeroes its frame
        # (the local_names region below the saved-register block) at every
        # return, so spilled secrets do not outlive the call in stack
        # residue. the marker also flips needs_private like wipe does.
        frame_open: 1
        return
    if starts(s, "wipe ") is 1
        expr(strip(cut(s, 5, length(s))))
        mov_rdi_rax
        bytes:
            72
            133
            255
        wsk: jz()
        put_in_program(87)
        used_text_length: 1
        text_length
        bytes:
            72
            137
            193
            95
        xor_rax
        bytes:
            252
            243
            170
        patch(wsk)
        return
    if starts(s, "join ") is 1
        expr(strip(cut(s, 5, length(s))))
        do_wait_for_thread
        return
    if starts(s, "print ") is 1
        arg: strip(cut(s, 6, length(s)))
        had_lab: 0
        if ends_times(arg) is 1
            head: strip(cut(arg, 0, length(arg) - 6))
            sp: find_last_sp(head)
            if sp > 0 - 1
                do_print_times(strip(cut(head, 0, sp)), strip(cut(head, sp + 1, length(head))))
                return
        # a postfix cast on a print: force the text path
        if length(arg) >= 8
            if same(cut(arg, length(arg) - 8, length(arg)), " as text") is 1
                expr(cut(arg, 0, length(arg) - 8))
                mov_rdi_rax
                used_print: 1
                print_text
                return
        if length(arg) >= 7
            if same(cut(arg, length(arg) - 7, length(arg)), " as ptr") is 1
                expr(cut(arg, 0, length(arg) - 7))
                mov_rdi_rax
                used_print: 1
                print_text
                return
        if length(arg) > 1
            if _sov_byte_at(arg, 0) is 34
                qe: end_quote(arg)
                if qe < 1
                    qe: length(arg) - 1
                lit: unesc(cut(arg, 1, qe))
                rest: strip(cut(arg, qe + 1, length(arg)))
                if length(rest) is 0
                    emit_write_lit(join(lit, "\n"))
                    return
                if starts(rest, ":") is 1
                    lit: join(lit, ": ")
                    rest: strip(cut(rest, 1, length(rest)))
                if not
                    if length(lit) > 0
                        if peek_byte(lit, length(lit) - 1) is not 32
                            lit: join(lit, " ")
                emit_write_lit(lit)
                arg: rest
                had_lab: 1
        if starts(arg, "peek_byte(") is 1
            if folded_number > 0
                emit_write_lit(i2s(folded_number))
                return
        if had_lab is 0
            if print_const(arg) is 1
                return
        typ: expr(arg)
        mov_rdi_rax
        if had_lab is 1
            used_print: 1
            print_text
            note_print
            return
        if typ is 1
            used_print: 1
            print_text
        if not
            used_print_number: 1
            print_number
        note_print
        return
    had_col: 0
    col: find_col(s)
    if col > 0
        if col < length(s) - 1
            lhs: repl(strip(cut(s, 0, col)), " ", "_")
            rhs: strip(cut(s, col + 1, length(s)))
            if at_top is 1
                if idx(names, lhs) > 0 - 1
                    if idx(global_names, lhs) < 0
                        if look(rhs, "(") < 0
                            colon_call(lhs, rhs)
                            return
            had_col: 1
            s: join("<-- ", join(strip(cut(s, 0, col)), join(" := ", strip(cut(s, col + 1, length(s))))))
    if starts(s, "<-- ") is 1
        if had_col is 0
            print "Error: bad line" : s
            err_where
            saw_error: 1
            return
        rest: cut(s, 4, length(s))
        t: find_sep(rest)
        if t > 0 - 1
            var: repl(strip(cut(rest, 0, t)), " ", "_")
            rhs: strip(cut(rest, t + 4, length(rest)))
            if idx(locked_names, var) > 0 - 1
                if skip_lock is 0
                    print "Error: immutable, it cannot be assigned again" : var
                    print "line" : s
                    err_where
                    saw_error: 1
                    return
                skip_lock: 0
            if same(rhs, join(var, " + 1")) is 1
                inc_var(var)
                return
            if same(rhs, join(var, " - 1")) is 1
                dec_var(var)
                return
            if try_slot_forms(var, rhs) is 1
                drop_str(var)
                return
            if try_def_peek(var, rhs) is 1
                drop_str(var)
                return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
                    rs: reg_slot(var)
                    if rs > 0 - 1
                        cflush(var)
                        expr(other)
                        add_rax_slot(rs)
                        drop_str(var)
                        return
                    if not
                        sl6: idx(local_names, var)
                        if sl6 > 4
                            mm3: mem_scaled(other)
                            if mm3 > 0 - 1
                                cflush(var)
                                ms3: mm3 / 65536
                                mq3: mm3 % 65536
                                emit_rax_scaled(ms3, mq3 / 4096, mq3 % 4096 - 128)
                                add_rax_mem(sl6)
                                drop_str(var)
                                return
                            mm4: memabs_scaled(other)
                            if mm4 > 0 - 1
                                cflush(var)
                                emit_rax_abs(mm4 / 4294967296 - 1, mm4 % 4294967296)
                                add_rax_mem(sl6)
                                drop_str(var)
                                return
            pref: join(var, " - ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, 0 - _sov_atoi(other))
                                drop_str(var)
                                return
                            sub_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
                    rs: reg_slot(var)
                    if rs > 0 - 1
                        cflush(var)
                        expr(other)
                        sub_rax_slot(rs)
                        drop_str(var)
                        return
            if length(rhs) > 0
                if digit(letter(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        if inside_if is 0
                            nv: _sov_atoi(rhs)
                            cset(var, nv)
                            if nv > 0
                                known_name: var
                                known_value: nv
                            drop_str(var)
                            if needs_heap is 0
                                return
            if try_alloc_imm(var, rhs) is 1
                mark_str(var)
                return
            # pass 111: nought into a register local rides xor
            # slot,slot straight from the flusher - the pending
            # entry is registered and cashed at once, so a later
            # read never materializes a second copy
            if same(rhs, "0") is 1
                # reassigns only: a fresh def keeps registering its
                # slot at first use, so the slot order (and every
                # fusion decision built on it) is untouched
                zl: idx(local_names, var)
                if zl > 0 - 1
                    if idx(global_names, var) < 0
                        if zl < 5
                            cset(var, 0)
                            if zl is 0
                                bytes:
                                    72
                                    49
                                    219
                            if not
                                bytes:
                                    77
                                    49
                                put_in_program(192 + 9 * (zl + 3))
                            zi: idx(const_names, var)
                            const_dirty: _sov_list_set(const_dirty, zi, 1)
                            drop_str(var)
                            return
                        if leaf8 is 1
                            if zl < 9
                                cset(var, 0)
                                bytes:
                                    77
                                    49
                                put_in_program(192 + 9 * (zl - 5))
                                zi: idx(const_names, var)
                                const_dirty: _sov_list_set(const_dirty, zi, 1)
                                drop_str(var)
                                return
            typ: expr(rhs)
            storev(var)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if starts(rhs, "_sov_strlen(") is 1
                if used_fill is 1
                    if known_value > 0
                        known_name: var
        return
    if same(s, "return") is 1
        if at_top is 1
            bytes:
                49
                255
            emit_sys_num(60)
            emit_sys_do
            return
        if frame_open is 1
            if skip_frame is 0
                canary_check
                xor_rax
                restores
                frame_wipe
                do_restore_frame
                ret
                return
        xor_rax
        restore_frame
        ret
        return
    if starts(s, "return ") is 1
        typ: expr(cut(s, 7, length(s)))
        if typ is 1
            saw_letters: 1
        if at_top is 1
            bytes:
                72
                137
                199
            emit_sys_num(60)
            emit_sys_do
            return
        if frame_open is 1
            if skip_frame is 0
                canary_check
                put_in_program(80)
                restores
                frame_wipe
                put_in_program(88)
                do_restore_frame
                ret
                return
        restore_frame
        ret
        return
    if same(s, "stop") is 1
        bytes:
            49
            255
        emit_sys_num(60)
        emit_sys_do
        return
    if same(s, "leave") is 1
        # exit the nearest enclosing loop: one jump straight to its
        # join, recorded on the block's bx list and patched when the
        # loop pops. Replaces the flag-the-limit exit trick, which
        # paid a store, a jump back and a full limit re-check.
        # Walking past a try or except is refused: the jump would
        # strand the error frame on the stack. cflush_all first: a
        # pending constant must sit in memory before the exit path
        # reaches the join, the while arms already flush at the head
        # and forever never had a forward exit before leave.
        ld: _sov_list_len(bk) - 1
        lfound: 0
        lbad: 0
        as long as ld > 0 - 1
            lkind: _sov_list_get(bk, ld)
            if same(lkind, "try") is 1
                lbad: 1
                ld: 0 - 1
            if not
                if same(lkind, "except") is 1
                    lbad: 1
                    ld: 0 - 1
                if not
                    if same(lkind, "while") is 1
                        lfound: ld + 1
                        ld: 0 - 1
                    if not
                        if same(lkind, "forever") is 1
                            lfound: ld + 1
                            ld: 0 - 1
                        if not
                            if same(lkind, "repeat") is 1
                                lfound: ld + 1
                                ld: 0 - 1
                            if not
                                ld: ld - 1
        if lbad is 1
            print "Error: leave cannot cross try" : s
            err_where
            saw_error: 1
            return
        if lfound is 0
            print "Error: leave needs a loop around it" : s
            err_where
            saw_error: 1
            return
        ld: lfound - 1
        cflush_all
        lx: _sov_list_get(bx, ld)
        lx: _sov_list_add(lx, jmp())
        bx: _sov_list_set(bx, ld, lx)
        return
    if look(s, "(") < 0
        if plain_name(s) is 1
            if idx(names, s) > 0 - 1
                expr(join(s, "()"))
                return
            # even if not in names, try to parse as zero-arg call
            expr(join(s, "()"))
            return
        # check if line starts with a function name (for paren-free calls as statements)
        sp: look(s, " ")
        if sp > 0
            # it looks like a paren-free call, parse it as an expression
            expr(s)
            return
        # not a function call, must be an error
        print "Error: bad line" : s
        print "line" : error_line
        saw_error: 1
        return
    expr(s)
    value_dead: 0
try_alloc_imm var rhs:
    if starts(rhs, "_sov_alloc(") is 0
        return 0
    if same(var, dead_alloc_name) is 1
        return 1
    r: try_static_block(var, rhs)
    if r is 1
        return 1
    if needs_heap is 0
        if same(letter(rhs, length(rhs) - 1), ")") is 1
            inn: strip(cut(rhs, 11, length(rhs) - 1))
            asz: 0
            if same(inn, known_name) is 1
                if known_value > 0
                    asz: known_value
            if asz is 0
                if length(inn) > 0
                    if digit(letter(inn, 0)) is 1
                        if look(inn, " ") < 0
                            asz: _sov_atoi(inn)
            if asz > 511
                emit_mmap_k(asz)
                storev(var)
                return 1
    return 0

emit_used:
    emit_platform
    if used_alloc is 1
        if idx(global_names, "heap_ptr") is 0 - 1
            global_names: _sov_list_add(global_names, "heap_ptr")
        emit_alloc
    if used_print is 1
        used_text_length: 1
    if used_text_length is 1
        emit_strlen
    if used_texts_equal is 1
        emit_streq
    if used_print is 1
        emit_print
    if used_print_number is 1
        emit_print_int
    if used_crash is 1
        emit_trap_stub
    emit_stack_guard

restore_frame:
    if skip_frame is 1
        if saved_locals > 4
            bytes:
                65
