# op rax, r_slot for slots 0-8: rbx r12-r15 r8-r11. every form
# GAS-verified (63/63, row 60). the r8-r11 forms only ever get
# emitted for leaf8 functions, the only places slots 5-8 hold
# values.

collect_body lines start bind:
    out: _sov_list_new()
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    out: _sov_list_add(out, s)
                    j: j + 1
                if not
                    return out
    return out

cops text:
    r: text
    r: repl(r, " is not ", " != ")
    r: repl(r, " and ", " && ")
    r: repl(r, " or ", " || ")
    r: repl(r, " is ", " == ")
    r: repl(r, " = ", " == ")
    return r

cset name val:
    ci: idx(const_names, name)
    if ci > 0 - 1
        const_values: _sov_list_set(const_values, ci, val)
        const_dirty: _sov_list_set(const_dirty, ci, 0)
        return
    const_names: _sov_list_add(const_names, name)
    const_values: _sov_list_add(const_values, val)
    const_dirty: _sov_list_add(const_dirty, 0)

cut t a b:
    return _sov_substring(t, a, b)

dce_globals:
    live: _sov_list_new()
    gi: 0
    as long as gi < _sov_list_len(global_names)
        gnm: _sov_list_get(global_names, gi)
        used: 0
        pi: 0
        as long as pi < _sov_list_len(patch_kind)
            k: _sov_list_get(patch_kind, pi)
            if same(k, "glob") is 1
                if same(_sov_list_get(patch_value, pi), gnm) is 1
                    used: 1
            if same(k, "grel") is 1
                if same(_sov_list_get(patch_value, pi), gnm) is 1
                    used: 1
            pi: pi + 1
        if used is 1
            # heap_ptr can arrive twice (driver add + runtime top
            # level): keep one copy, the duplicate costs 8 bytes of
            # LOAD filesz in every heap program
            if idx(live, gnm) is 0 - 1
                live: _sov_list_add(live, gnm)
        gi: gi + 1
    global_names: live

dce_litter:
    if saw_error is 1
        return
    dl_rng_at: _sov_list_new()
    dl_rng_len: _sov_list_new()
    dl_fi: 0
    as long as dl_fi < _sov_list_len(task_at)
        dl_s: _sov_list_get(task_at, dl_fi)
        dl_e: _sov_list_len(code)
        if dl_fi + 1 < _sov_list_len(task_at)
            dl_e: _sov_list_get(task_at, dl_fi + 1)
        dl_ok: 1
        dl_q: 0
        as long as dl_q < _sov_list_len(jump_at)
            dl_bq: _sov_list_get(jump_at, dl_q)
            if dl_bq >= dl_s
                if dl_bq < dl_e
                    # a site only counts when the bytes before it still
                    # decode as a branch opcode: the fold can delete a
                    # loop after its sites were registered, leaving a
                    # fossil that would veto the whole function
                    dl_real: 0
                    dl_dead: 0
                    if _sov_list_get(jump_state, dl_q) is 4
                        dl_dead: 1
                    if dl_dead is 0
                        if _sov_list_get(code, dl_bq - 1) is 233
                            dl_real: 1
                        if dl_bq >= 2
                            if _sov_list_get(code, dl_bq - 2) is 15
                                dl_pb: _sov_list_get(code, dl_bq - 1)
                                if dl_pb >= 128
                                    if dl_pb < 136
                                        dl_real: 1
                    if dl_real is 1
                        dl_ok: 0
            dl_q: dl_q + 1
        dl_q: 0
        as long as dl_q < _sov_list_len(patch_at)
            if same(_sov_list_get(patch_kind, dl_q), "rel") is 1
                dl_bq: _sov_list_get(patch_at, dl_q)
                if dl_bq >= dl_s
                    if dl_bq < dl_e
                        dl_ok: 0
            dl_q: dl_q + 1
        if dl_ok is 1
            dl_ist: 0
            dl_ilen: 0
            dl_idst: 0
            dl_isrc: 0
            dl_irm: 0
            dl_live: 0
            dl_dead: 0
            dl_pos: dl_s
            dl_runst: 0
            dl_noprun: 0
            as long as dl_pos < dl_e
                dl_b: _sov_list_get(code, dl_pos)
                dl_len: 0
                dl_dst: 0 - 1
                dl_src: 0 - 1
                dl_rm: 0
                dl_term: 0
                if dl_b is 144
                    dl_len: 1
                    dl_rm: 1
                if dl_len is 0
                    if dl_b is 49
                        dl_n2: _sov_list_get(code, dl_pos + 1)
                        dl_r: 0
                        as long as dl_r < 8
                            if dl_n2 is 192 + dl_r * 9
                                dl_len: 2
                                dl_dst: dl_r
                                dl_rm: 1
                            dl_r: dl_r + 1
                if dl_len is 0
                    dl_n1: _sov_list_get(code, dl_pos + 1)
                    dl_n2: _sov_list_get(code, dl_pos + 2)
                    if dl_b is 72
                        if dl_n1 is 137
                            if dl_n2 >= 192
                                if dl_n2 < 200
                                    dl_len: 3
                                    dl_dst: dl_n2 - 192
                                    dl_src: 0
                                    dl_rm: 1
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r
                                    dl_rm: 1
                                dl_r: dl_r + 1
                        if dl_n1 is 184
                            dl_len: 10
                            dl_dst: 0
                            dl_rm: 1
                    if dl_b is 73
                        if dl_n1 is 137
                            if dl_n2 >= 192
                                if dl_n2 < 200
                                    dl_len: 3
                                    dl_dst: dl_n2 - 192 + 8
                                    dl_src: 0
                                    dl_rm: 1
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r + 8
                                    dl_rm: 1
                                dl_r: dl_r + 1
                        if dl_n1 >= 184
                            if dl_n1 < 192
                                dl_len: 10
                                dl_dst: dl_n1 - 184 + 8
                                dl_rm: 1
                    if dl_b is 77
                        # pass 111's xor r8-15,r8-15: W+R+B rex, the
                        # modrm rides the register's low three
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r + 8
                                    dl_rm: 1
                                dl_r: dl_r + 1
                    if dl_b is 65
                        if dl_n1 >= 80
                            if dl_n1 < 88
                                dl_len: 2
                                dl_src: dl_n1 - 80 + 8
                        if dl_n1 >= 88
                            if dl_n1 < 96
                                dl_len: 2
                                dl_dst: dl_n1 - 88 + 8
                                dl_rm: 1
                        if dl_n1 >= 184
                            if dl_n1 < 192
                                dl_len: 6
                                dl_dst: dl_n1 - 184 + 8
                                dl_rm: 1
                if dl_len is 0
                    if dl_b >= 80
                        if dl_b < 88
                            dl_len: 1
                            dl_src: dl_b - 80
                    if dl_b >= 88
                        if dl_b < 96
                            dl_len: 1
                            dl_dst: dl_b - 88
                            dl_rm: 1
                    if dl_b >= 184
                        if dl_b < 192
                            dl_len: 5
                            dl_dst: dl_b - 184
                            dl_rm: 1
                    if dl_b >= 176
                        if dl_b < 184
                            dl_len: 2
                    if dl_b is 106
                        dl_len: 2
                    if dl_b is 15
                        dl_n2: _sov_list_get(code, dl_pos + 1)
                        if dl_n2 is 5
                            dl_len: 2
                            dl_term: 1
                if dl_len is 0
                    dl_pos: dl_pos + 1
                    dl_runst: 0
                    dl_noprun: 0
                if not
                    if dl_runst is 0
                        dl_can: 0
                        if dl_pos is dl_s
                            dl_can: 1
                        if dl_term is 1
                            dl_can: 1
                        if dl_noprun >= 3
                            dl_can: 1
                        if dl_can is 1
                            dl_runst: 1
                            dl_ist: _sov_list_new()
                            dl_ilen: _sov_list_new()
                            dl_idst: _sov_list_new()
                            dl_isrc: _sov_list_new()
                            dl_irm: _sov_list_new()
                            dl_live: _sov_list_new()
                            dl_dead: _sov_list_new()
                    if dl_runst is 1
                        dl_ist: _sov_list_add(dl_ist, dl_pos)
                        dl_ilen: _sov_list_add(dl_ilen, dl_len)
                        dl_idst: _sov_list_add(dl_idst, dl_dst)
                        dl_isrc: _sov_list_add(dl_isrc, dl_src)
                        dl_irm: _sov_list_add(dl_irm, dl_rm)
                        dl_dead: _sov_list_add(dl_dead, 0)
                        if dl_term is 1
                            # syscall reads rax rdi rsi rdx r10 r8 r9
                            dl_live: _sov_list_add(dl_live, 0)
                            dl_live: _sov_list_add(dl_live, 7)
                            dl_live: _sov_list_add(dl_live, 6)
                            dl_live: _sov_list_add(dl_live, 2)
                            dl_live: _sov_list_add(dl_live, 10)
                            dl_live: _sov_list_add(dl_live, 8)
                            dl_live: _sov_list_add(dl_live, 9)
                            dl_k: _sov_list_len(dl_ist) - 1
                            as long as dl_k >= 0
                                dl_d: _sov_list_get(dl_idst, dl_k)
                                if dl_d > 0 - 1
                                    dl_inlive: 0
                                    dl_m: 0
                                    as long as dl_m < _sov_list_len(dl_live)
                                        if _sov_list_get(dl_live, dl_m) is dl_d
                                            dl_inlive: 1
                                        dl_m: dl_m + 1
                                    if dl_inlive is 1
                                        dl_nl: _sov_list_new()
                                        dl_m: 0
                                        as long as dl_m < _sov_list_len(dl_live)
                                            if _sov_list_get(dl_live, dl_m) is not dl_d
                                                dl_nl: _sov_list_add(dl_nl, _sov_list_get(dl_live, dl_m))
                                            dl_m: dl_m + 1
                                        dl_live: dl_nl
                                        dl_sv: _sov_list_get(dl_isrc, dl_k)
                                        if dl_sv > 0 - 1
                                            dl_in2: 0
                                            dl_m: 0
                                            as long as dl_m < _sov_list_len(dl_live)
                                                if _sov_list_get(dl_live, dl_m) is dl_sv
                                                    dl_in2: 1
                                                dl_m: dl_m + 1
                                            if dl_in2 is 0
                                                dl_live: _sov_list_add(dl_live, dl_sv)
                                    if not
                                        if _sov_list_get(dl_irm, dl_k) is 1
                                            dl_h0: _sov_list_get(dl_ist, dl_k)
                                            dl_h1: dl_h0 + _sov_list_get(dl_ilen, dl_k)
                                            dl_patched: 0
                                            dl_m: 0
                                            as long as dl_m < _sov_list_len(patch_at)
                                                dl_pp: _sov_list_get(patch_at, dl_m)
                                                if dl_pp >= dl_h0
                                                    if dl_pp < dl_h1
                                                        dl_patched: 1
                                                dl_m: dl_m + 1
                                            if dl_patched is 0
                                                dl_dead: _sov_list_set(dl_dead, dl_k, 1)
                                dl_k: dl_k - 1
                            dl_m: 0
                            as long as dl_m < _sov_list_len(dl_ist)
                                if _sov_list_get(dl_dead, dl_m) is 1
                                    dl_rng_at: _sov_list_add(dl_rng_at, _sov_list_get(dl_ist, dl_m))
                                    dl_rng_len: _sov_list_add(dl_rng_len, _sov_list_get(dl_ilen, dl_m))
                                dl_m: dl_m + 1
                            dl_runst: 0
                            dl_noprun: 0
                    if dl_b is 144
                        dl_noprun: dl_noprun + 1
                    if not
                        dl_noprun: 0
                    dl_pos: dl_pos + dl_len
        dl_fi: dl_fi + 1
    if _sov_list_len(dl_rng_at) is 0
        return
    dl_i: 1
    as long as dl_i < _sov_list_len(dl_rng_at)
        dl_k: dl_i - 1
        dl_ca: _sov_list_get(dl_rng_at, dl_i)
        dl_cl: _sov_list_get(dl_rng_len, dl_i)
        dl_done: 0
        as long as dl_done is 0
            if dl_k < 0
                dl_done: 1
            if not
                if _sov_list_get(dl_rng_at, dl_k) > dl_ca
                    dl_rng_at: _sov_list_set(dl_rng_at, dl_k + 1, _sov_list_get(dl_rng_at, dl_k))
                    dl_rng_len: _sov_list_set(dl_rng_len, dl_k + 1, _sov_list_get(dl_rng_len, dl_k))
                    dl_k: dl_k - 1
                if not
                    dl_done: 1
        dl_rng_at: _sov_list_set(dl_rng_at, dl_k + 1, dl_ca)
        dl_rng_len: _sov_list_set(dl_rng_len, dl_k + 1, dl_cl)
        dl_i: dl_i + 1
    dl_no: _sov_list_new()
    dl_pos: 0
    dl_ri: 0
    as long as dl_pos < _sov_list_len(code)
        dl_cut: 0
        if dl_ri < _sov_list_len(dl_rng_at)
            if _sov_list_get(dl_rng_at, dl_ri) is dl_pos
                dl_cut: 1
        if dl_cut is 1
            dl_pos: dl_pos + _sov_list_get(dl_rng_len, dl_ri)
            dl_ri: dl_ri + 1
        if not
            dl_no: _sov_list_add(dl_no, _sov_list_get(code, dl_pos))
            dl_pos: dl_pos + 1
    code: dl_no
    dl_na: _sov_list_new()
    dl_nk: _sov_list_new()
    dl_nv: _sov_list_new()
    dl_nl: _sov_list_new()
    dl_pi: 0
    as long as dl_pi < _sov_list_len(patch_at)
        dl_at: _sov_list_get(patch_at, dl_pi)
        dl_sh: 0
        dl_ri: 0
        as long as dl_ri < _sov_list_len(dl_rng_at)
            if _sov_list_get(dl_rng_at, dl_ri) + _sov_list_get(dl_rng_len, dl_ri) <= dl_at
                dl_sh: dl_sh + _sov_list_get(dl_rng_len, dl_ri)
            dl_ri: dl_ri + 1
        dl_na: _sov_list_add(dl_na, dl_at - dl_sh)
        dl_nk: _sov_list_add(dl_nk, _sov_list_get(patch_kind, dl_pi))
        dl_nv: _sov_list_add(dl_nv, _sov_list_get(patch_value, dl_pi))
        dl_nl: _sov_list_add(dl_nl, _sov_list_get(patch_line, dl_pi))
        dl_pi: dl_pi + 1
    patch_at: dl_na
    patch_kind: dl_nk
    patch_value: dl_nv
    patch_line: dl_nl
    dl_fi: 0
    as long as dl_fi < _sov_list_len(task_at)
        dl_off: _sov_list_get(task_at, dl_fi)
        dl_sh: 0
        dl_ri: 0
        as long as dl_ri < _sov_list_len(dl_rng_at)
            if _sov_list_get(dl_rng_at, dl_ri) + _sov_list_get(dl_rng_len, dl_ri) <= dl_off
                dl_sh: dl_sh + _sov_list_get(dl_rng_len, dl_ri)
            dl_ri: dl_ri + 1
        task_at: _sov_list_set(task_at, dl_fi, dl_off - dl_sh)
        dl_fi: dl_fi + 1
# Dead-global elimination. After dce the code stream holds only the
# reachable functions, but global_names still lists every global ever
# declared (heap_ptr/heap_end from the runtime, __pt_c/__pt_i from the
# string printer, err_top/err_val from try/except, the program's own
# spilled local_names) whether or not a surviving function touches it. Each
# wasted global costs 8 bytes of LOAD filesz. Every reference to a
# global goes through a "glob" (movabs absolute) or "grel"
# (rip-relative) patch, and write_program resolves those by NAME, so
# dropping an unreferenced global is just a filter of global_names.

dce_stores:
    if saw_error is 1
        return
    ds_gi: 0
    as long as ds_gi < _sov_list_len(global_names)
        ds_gnm: _sov_list_get(global_names, ds_gi)
        ds_allstore: 1
        ds_any: 0
        ds_pi: 0
        as long as ds_pi < _sov_list_len(patch_kind)
            if same(_sov_list_get(patch_kind, ds_pi), "grel") is 1
                if same(_sov_list_get(patch_value, ds_pi), ds_gnm) is 1
                    ds_any: 1
                    ds_at: _sov_list_get(patch_at, ds_pi)
                    if ds_at >= 3
                        ds_b3: _sov_list_get(code, ds_at - 3)
                        ds_b2: _sov_list_get(code, ds_at - 2)
                        ds_b1: _sov_list_get(code, ds_at - 1)
                        if ds_b3 is 72
                            if ds_b2 is 137
                                if ds_b1 is not 5
                                    ds_allstore: 0
                            if not
                                ds_allstore: 0
                        if not
                            ds_allstore: 0
                    if not
                        ds_allstore: 0
            if same(_sov_list_get(patch_kind, ds_pi), "glob") is 1
                if same(_sov_list_get(patch_value, ds_pi), ds_gnm) is 1
                    ds_any: 1
                    ds_allstore: 0
            ds_pi: ds_pi + 1
        if ds_any is 1
            if ds_allstore is 1
                ds_pi: 0
                as long as ds_pi < _sov_list_len(patch_kind)
                    if same(_sov_list_get(patch_kind, ds_pi), "grel") is 1
                        if same(_sov_list_get(patch_value, ds_pi), ds_gnm) is 1
                            ds_at: _sov_list_get(patch_at, ds_pi)
                            # paint the seven store bytes with nops;
                            # nothing in the stream moves
                            ds_k: ds_at - 3
                            as long as ds_k < ds_at + 4
                                code: _sov_list_set(code, ds_k, 144)
                                ds_k: ds_k + 1
                    ds_pi: ds_pi + 1
        ds_gi: ds_gi + 1
    # drop the grel patches whose sites now sit inside nops: the names
    # must look unreferenced or dce_globals keeps them
    ds_na: _sov_list_new()
    ds_nk: _sov_list_new()
    ds_nv: _sov_list_new()
    ds_nl: _sov_list_new()
    ds_pi: 0
    as long as ds_pi < _sov_list_len(patch_at)
        ds_drop: 0
        ds_at: _sov_list_get(patch_at, ds_pi)
        if same(_sov_list_get(patch_kind, ds_pi), "grel") is 1
            if ds_at >= 3
                if _sov_list_get(code, ds_at - 3) is 144
                    if _sov_list_get(code, ds_at - 2) is 144
                        if _sov_list_get(code, ds_at - 1) is 144
                            ds_drop: 1
        if ds_drop is 0
            ds_na: _sov_list_add(ds_na, ds_at)
            ds_nk: _sov_list_add(ds_nk, _sov_list_get(patch_kind, ds_pi))
            ds_nv: _sov_list_add(ds_nv, _sov_list_get(patch_value, ds_pi))
            ds_nl: _sov_list_add(ds_nl, _sov_list_get(patch_line, ds_pi))
        ds_pi: ds_pi + 1
    patch_at: ds_na
    patch_kind: ds_nk
    patch_value: ds_nv
    patch_line: ds_nl
# Pass 108: straight-line litter. In a function with no branch site
# (jump_at) and no rel patch - fully straight-line code - the stream is
# decoded greedily over a fixed shape set (nop, xor r,r, mov rX/r8-15,
# rax, mov eX/rXd imm32, movabs, push/pop, push imm8, mov r8b imm8,
# syscall). A run may only start at the function head, after a
# syscall, or after a 3-plus nop run (the P105b signature), never
# mid-instruction. When a run ends at a syscall, backwards liveness
# drops every removable instruction whose destination no later
# instruction and the syscall reads. Eight-bit writes never kill a
# register (mov al,60 leaves the upper bits alone); 32-bit writes do
# (they zero-extend). Removal splices bytes, so the pass is gated on
# the function holding no branch site and no rel patch at all.

drop_unused lines:
    an: blank
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        if starts(s, "<-- ") is 1
            if look(s, "_sov_alloc(") > 0 - 1
                rest: cut(s, 4, length(s))
                t: find_sep(rest)
                if t > 0 - 1
                    an: repl(strip(cut(rest, 0, t)), " ", "_")
        i: i + 1
    if length(an) is 0
        return blank
    hits: 0
    ok: 1
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        mark: join(an, ",")
        hit: 0
        if look(s, mark) > 0 - 1
            hit: 1
        if starts(s, join("<-- ", an)) is 1
            hit: 1
        if hit is 1
            hits: hits + 1
            good: 0
            if look(s, "_sov_alloc(") > 0 - 1
                good: 1
            if look(s, "poke_i64(") > 0 - 1
                good: 1
            if look(s, "peek_i64(") > 0 - 1
                good: 1
            if good is 0
                ok: 0
        i: i + 1
    if ok is 0
        return blank
    if hits < 3
        return blank
    return an

dec_txt v:
    if v is 0
        return "0\n"
    neg: 0
    dv: v
    if dv < 0
        neg: 1
    # no "dv: 0 - dv". the most negative value has no positive twin,
    # so negating it gave back itself, the loop ran on a negative, and
    # cut("0123456789", d, d + 1) indexed the digit string with a
    # negative d - which is how INT64_MIN printed as punctuation
    r: ""
    as long as dv is not 0
        d: dv % 10
        if d < 0
            d: 0 - d
        r: join(cut("0123456789", d, d + 1), r)
        dv: dv / 10
    if neg is 1
        r: join("-", r)
    return join(r, "\n")

dec_var name:
    sl: idx(local_names, name)
    if sl is 0
        bytes:
            72
            255
            203
        return
    if sl is 1
        bytes:
            73
            255
            204
        return
    if sl is 2
        bytes:
            73
            255
            205
        return
    if sl is 3
        bytes:
            73
            255
            206
        return
    if sl is 4
        bytes:
            73
            255
            207
        return
    if sl < 0
        # global (or unknown): the old walk, same rule as inc_var
        loadv(name)
        bytes:
            72
            255
            200
        storev(name)
        return
    if sl is 5
        if leaf8 is 1
            bytes:
                73
                255
                200
            return
    if sl is 6
        if leaf8 is 1
            bytes:
                73
                255
                201
            return
    if sl is 7
        if leaf8 is 1
            bytes:
                73
                255
                202
            return
    if sl is 8
        if leaf8 is 1
            bytes:
                73
                255
                203
            return
    # spilled local (sl > 4): dec straight in the frame slot
    cflush(name)
    of: loc_off(sl)
    bytes:
        72
        255
    if of > 0 - 129
        put_in_program(77)
        put_in_program(of)
        return
    put_in_program(141)
    put_4_bytes(of)
    return

digit c:
    b: _sov_byte_at(c, 0)
    if b >= 48
        if b <= 57
            return 1
    return 0
# load a name; when it is a register local, the value goes straight
# into rcx (the trailing mov rax, reg is rewritten in place, one
# byte: d8->d9 for rbx, e0->e1 for r12 and so on)

drop_str name:
    di: idx(letter_boxes, name)
    if di > 0 - 1
        letter_boxes: _sov_list_set(letter_boxes, di, "")

put_in_program n:
    x: n % 256
    if x < 0
        x: x + 256
    # peephole: a push rax directly followed by a pop of the same
    # register is a nought, and a push rax followed by a pop of
    # another register is a move. The decision uses a FLAG set by
    # the real push emitter, never the raw byte: 0x50 also lives
    # inside immediates and displacements, and matching it there
    # silently corrupts constants (see notes 9cd610c).
    if x > 87
        if x < 96
            if hold_value is 1
                hold_value: 0
                if x is 88
                    poke_i64(code, 8, _sov_list_len(code) - 1)
                    return
                if x is 89
                    poke_i64(code, 8, _sov_list_len(code) - 1)
                    code: _sov_list_add(code, 72)
                    code: _sov_list_add(code, 137)
                    code: _sov_list_add(code, 193)
                    return
                if x is 90
                    poke_i64(code, 8, _sov_list_len(code) - 1)
                    code: _sov_list_add(code, 72)
                    code: _sov_list_add(code, 137)
                    code: _sov_list_add(code, 194)
                    return
                if x is 94
                    poke_i64(code, 8, _sov_list_len(code) - 1)
                    code: _sov_list_add(code, 72)
                    code: _sov_list_add(code, 137)
                    code: _sov_list_add(code, 198)
                    return
                if x is 95
                    poke_i64(code, 8, _sov_list_len(code) - 1)
                    code: _sov_list_add(code, 72)
                    code: _sov_list_add(code, 137)
                    code: _sov_list_add(code, 199)
                    return
    hold_value: 0
    code: _sov_list_add(code, x)

put_4_bytes n:
    v: n
    if v < 0
        v: v + 4294967296
    i: 0
    as long as i < 4
        put_in_program(v % 256)
        v: v / 256
        i: i + 1

put_8_bytes n:
    v: n
    i: 0
    as long as i < 8
        b: v % 256
        if b < 0
            b: b + 256
        put_in_program(b)
        if v < 0
            v: (v - b) / 256
        if not
            v: v / 256
        i: i + 1

emit_addsub_slot dd sd is_sub:
    # add/sub rD, rS where D and S are slots 0..4 (rbx, r12..r15).
    # the 5x5 byte table for both was generated with GAS and objdump
    # and this formula matches all 50 rows:
    #   rex 48 (+4 if src reg >= r8) (+1 if dst reg >= r8)
    #   opcode 01 for add, 29 for sub
    #   modrm c0 + (src and 7) * 8 + (dst and 7)
    dn: 3
    if dd > 0
        dn: 11 + dd
    sn: 3
    if sd > 0
        sn: 11 + sd
    rex: 72
    if sn > 7
        rex: rex + 4
    if dn > 7
        rex: rex + 1
    put_in_program(rex)
    if is_sub is 1
        put_in_program(41)
    if not
        put_in_program(1)
    put_in_program(192 + (sn % 8) * 8 + (dn % 8))

emit_cmov_x_rdi cc xs:
    # cmovcc r_x, rdi - the twin pick's winner folded straight
    # into the index register: cc 76 = l, 79 = g (the dirs
    # try_sel_if can take). row59-verified.
    rx: 72
    if xs > 0
        rx: rx + 4
    put_in_program(rx)
    put_in_program(15)
    put_in_program(cc)
    put_in_program(192 + (xs + 3) * 8 + 7)
    return 0

emit_cmp_jge cond:
    return fuse_cmp(cond, 1)

emit_cmp_rax_scaled bs i2 dp:
    # cmp rax, [r_base + r_idx * 8 + dp] - twin of emit_rax_scaled
    # with 59 in the opcode seat, the /r field is rax so the REX
    # bits drop the +4. every form GAS-verified (11/11, pass 34).
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    put_in_program(rx)
    put_in_program(59)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + nd * 64
    put_in_program(m)
    put_in_program(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        put_in_program(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    put_in_program(144)
    return 0

emit_cmp_rcx_scaled bs i2 dp:
    # cmp rcx, [r_base + r_idx * 8 + dp] - 59 seat, rcx reg
    # field. GAS-verified (row 59).
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    put_in_program(rx)
    put_in_program(59)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    put_in_program(12 + nd * 64)
    put_in_program(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        put_in_program(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    put_in_program(144)
    return 0

emit_cmp_reg_scaled vs bs i2 dp:
    # cmp r_val, [r_base + r_idx * 8 + dp] - emit_scaled_reg's
    # register field riding on 59 in the opcode seat instead of
    # 137. same mod01-disp8 rules (r13 base, any displacement)
    # and the same trailing-byte guard. every form GAS-verified
    # against objdump (242/242, row 58).
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    if vs > 0
        rx: rx + 4
    put_in_program(rx)
    put_in_program(59)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + (vs + 3) * 8 + nd * 64
    put_in_program(m)
    put_in_program(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        put_in_program(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    put_in_program(144)
    return 0

emit_lea_arg ai sl disp:
    # lea argreg, [reglocal + disp]. the 5x7 table (dst rdi rsi rdx
    # rcx r8 r9 rax, src rbx r12..r15, disp8) was generated with GAS
    # and objdump; this formula matches all 210 nonzero-disp rows.
    # disp -128..127, never 0. r12 is rm 100 so it needs a SIB byte.
    dn: 7
    if ai is 1
        dn: 6
    if ai is 2
        dn: 2
    if ai is 3
        dn: 1
    if ai is 4
        dn: 8
    if ai is 5
        dn: 9
    sn: 11 + sl
    if sl is 0
        sn: 3
    rex: 72
    if dn > 7
        rex: rex + 4
    if sn > 7
        rex: rex + 1
    put_in_program(rex)
    put_in_program(141)
    put_in_program(64 + (dn % 8) * 8 + (sn % 8))
    if sl is 1
        put_in_program(36)
    put_in_program(disp % 256)

emit_lea_rax sl disp:
    sn: 11 + sl
    if sl is 0
        sn: 3
    rex: 72
    if sn > 7
        rex: rex + 1
    put_in_program(rex)
    put_in_program(141)
    put_in_program(64 + (sn % 8))
    if sl is 1
        put_in_program(36)
    put_in_program(disp % 256)

emit_lea_rdi_xs xs di:
    # lea rdi, [r_x + di] - di a signed imm8, flag-safe by
    # construction; the SIB form only for r12. row59-verified.
    if xs is 1
        bytes:
            73
            141
            124
            36
        put_in_program(di)
        return 0
    rx: 72
    if xs > 0
        rx: rx + 1
    put_in_program(rx)
    put_in_program(141)
    put_in_program(123 + xs)
    put_in_program(di)
    return 0

emit_lea_slot2p1 sd dd:
    # lea r_dd, [r_sd + r_sd*1 + 1] - one slot-sized doubling step
    # "t: u * 2 + 1". GAS-verified for all 25 pairs.
    rx: 72
    if dd > 0
        rx: rx + 4
    if sd > 0
        rx: rx + 3
    put_in_program(rx)
    put_in_program(141)
    put_in_program(68 + (dd + 3) * 8)
    put_in_program((sd + 3) * 9)
    put_in_program(1)
    return

emit_mov_rcx_h h:
    # mov rcx, r_h for h an ACTUAL machine number (rbx=3,
    # r12-r15=12-15): the later-term scratch load in sq_acc mode.
    # row69 GAS-verified for all five slot homes.
    rx: 72
    if h > 7
        rx: rx + 4
    put_in_program(rx)
    put_in_program(137)
    put_in_program(193 + (h % 8) * 8)
    return 0

emit_mov_rcx_scaled bs i2 dp:
    # mov rcx, [r_base + r_idx * 8 + dp] - emit_rax_scaled's form
    # with the rcx reg field. GAS-verified (row 59).
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    put_in_program(rx)
    put_in_program(139)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    put_in_program(12 + nd * 64)
    put_in_program(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        put_in_program(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    put_in_program(144)
    return 0

emit_mov_slot sd dd:
    # mov r_dd, r_sd - one register move for a plain name-to-name
    # assignment when both names live in slots; no rax round trip.
    # GAS-verified for every slot pair.
    rx: 72
    if dd > 0
        rx: rx + 1
    if sd > 0
        rx: rx + 4
    put_in_program(rx)
    put_in_program(137)
    put_in_program(192 + (sd + 3) * 8 + dd + 3)
    return

emit_name_or_imm e:
    e: strip(e)
    if length(e) is 0
        xor_rax
        return
    if digit(letter(e, 0)) is 1
        rax_imm(_sov_atoi(e))
        return
    if starts(e, "-") is 1
        if length(e) > 1
            if digit(letter(e, 1)) is 1
                rax_imm(0 - _sov_atoi(cut(e, 1, length(e))))
                return
    loadv(repl(e, " ", "_"))
# compile a simple comparison into a compare and a fused jump.
# inv 0 jumps when the comparison is true, inv 1 jumps when it is
# false. The caller patches the jump like a jz. Returns 0 - 1 when
# the condition is not one plain comparison (calls, and/or,
# brackets), so the caller can fall back to the boolean way.

emit_op op:
    if same(op, "add") is 1
        add_rax_rcx
        chk_ov
        return 0
    if same(op, "sub") is 1
        sub_rax_rcx
        chk_ov
        return 0
    if same(op, "mul") is 1
        imul_rax_rcx
        chk_ov
        return 0
    if same(op, "div") is 1
        chk_zrcx
        bytes:
            72
            153
            72
            247
            249
        return 0
    if same(op, "mod") is 1
        chk_zrcx
        bytes:
            72
            153
            72
            247
            249
            72
            146
        return 0
    cmp_rax_rcx
    setcc(op)
    return 0

# a number, optionally with a minus sign

emit_peek_rax:
    # rax = [rdi + rsi*8] - the scaled peek byte-row, exactly the
    # form try_scaled_mem's peek arm already emits (48 8B 04 F7).
    bytes:
        72
        139
        4
        247
# pass 62: folded-memory forms indexed straight out of a register
# home. h is the ACTUAL register number (rbx 3, rsi 6, rdx 2,
# r8-r15 8-15), so the legacy staged paths fall out as h 6/2 with
# bytes identical to the old emitters. SIB = 199 + low3(h)*8, REX
# gains X (=2) when h > 7. row65 GAS-verified, 55/55.

emit_rax_abs bs imm:
    # mov rax, [r_base + imm] - no index register. imm is the
    # byte offset, always positive; r13 base takes the mod01
    # form like everywhere else, r12 base is the SIB escape:
    # rm field 4 never means a bare r12, so a no-index SIB
    # byte follows the modrm. GAS-verified.
    rx: 72
    if bs > 0
        rx: rx + 1
    put_in_program(rx)
    put_in_program(139)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        put_in_program(nd * 64 + 4)
        put_in_program(36)
    if not
        put_in_program(nd * 64 + bs + 3)
    if nd is 1
        put_in_program(imm)
    if nd is 2
        put_4_bytes(imm)
    return 0

emit_rax_scaled bs i2 dp:
    # mov rax, [r_base + r_idx * 8 + dp] - every base/index/disp
    # form verified against GAS objdump (325/325, pass 31).
    # slots: 0 rbx, 1 r12, 2 r13, 3 r14, 4 r15. r13 base and a
    # nonzero displacement both take the mod01 + disp8 form.
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    put_in_program(rx)
    put_in_program(139)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + nd * 64
    put_in_program(m)
    put_in_program(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        put_in_program(dp)
        # a trailing 216/224/232/240/248 byte is what the loadv_r*
        # rewrites pattern-match (the pass-22 D8 collision); the SIB
        # byte itself can never equal them (slot fields step by 8),
        # but a displacement can - guard it with a nop terminator.
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    put_in_program(144)
    return 0

