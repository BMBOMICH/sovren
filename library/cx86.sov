                if lb is 232
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 234)
                if lb is 240
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 242)
                if lb is 248
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 250)
                return 0
    bytes:
        72
        137
        194
    return 0

# the two operands sit in rax and rcx; do whatever op asked

loadv_rsi name:
    # pass 60 twin of loadv_rdi: 48 8B 35 = mov rsi, [rip+disp].
    g9: idx(global_names, name)
    if g9 > 0 - 1
        if idx(local_names, name) < 0
            cflush(name)
            bytes:
                72
