    cat: here()
    put_4_bytes(0)
    later_fill(cat, "grel", "g_canary")
    # cmp rcx, [rbp - canarydisp]. the hole registers like a
    # branch site so a later relax cannot shift it out from under
    # the patch
    bytes:
