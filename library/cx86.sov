    # both sides plain names: load R into rcx, L into rax, and no
    # value ever touches the stack. loadv flushes constant local_names
    # and loads globals as well as register local_names.
    if is_imm(R) is 0
        if is_imm(L) is 0
            if plain_name(R) is 1
                if plain_name(L) is 1
                    if same(op, "mul") is 1
                        if same(L, R) is 1
