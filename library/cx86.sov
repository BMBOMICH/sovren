thread_tail st:
    # pass 40 jump threading: skips drained at if-pops that landed
    # exactly on this while's join are sent straight to the loop
    # head - one taken jump less per iteration down that tail.
    # Positions come from the block machinery's own lists, never a
    # byte walk; try/except pops are never logged (their unwinding
    # slots target the join too, but bending them breaks the raise
    # chain), so only plain if/else skips can ever fold.
    wi: 0
    as long as wi < _sov_list_len(sk_pos)
        wp: _sov_list_get(sk_pos, wi)
        if _sov_list_get(sk_to, wi) is here()
            if wp > st
                if _sov_list_get(code, wp - 1) is 233
                    put(wp, st - (wp + 4))
        wi: wi + 1
    sk_pos: _sov_list_new()
    sk_to: _sov_list_new()

tidy_path s:
    r: unquote(s)
    n: length(r)
    # drop a leading drive letter such as Z:
    if n > 2
        if _sov_byte_at(r, 1) is 58
            r: cut(r, 2, n)
            n: n - 2
    # backslash to slash
    o: _sov_alloc(n + 1)
    i: 0
    as long as i < n
        b: _sov_byte_at(r, i)
        if b is 92
            b: 47
        dummy: _sov_set_byte(o, i, b)
        i: i + 1
    dummy: _sov_set_byte(o, n, 0)
    return as text o

tname line:
