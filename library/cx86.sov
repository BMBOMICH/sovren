        put_in_program(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    put_in_program(144)
    return 0

emit_store_abs bs vr imm:
    # mov [r_base + imm], slot vr - twin of the load above. the
    # value field is the register slot form (vr + 3), REX.R when
    # the value sits past rbx. GAS-verified.
    rx: 72
    if bs > 0
        rx: rx + 1
    if vr > 0
        rx: rx + 4
    put_in_program(rx)
    put_in_program(137)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        put_in_program(nd * 64 + (vr + 3) * 8 + 4)
        put_in_program(36)
    if not
        put_in_program(nd * 64 + (vr + 3) * 8 + bs + 3)
    if nd is 1
        put_in_program(imm)
    if nd is 2
        put_4_bytes(imm)
    return 0

emit_store_abs_rax bs imm:
    # mov [r_base + imm], rax - the same form with a nought /r
    # field, for values loadv materialised. r12 takes the SIB
    # escape like the slot-value form. GAS-verified.
    rx: 72
    if bs > 0
        rx: rx + 1
    put_in_program(rx)
    put_in_program(137)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        put_in_program(nd * 64 + 4)
        put_in_program(36)
    if not
        put_in_program(nd * 64 + bs + 3)
    if nd is 1
        put_in_program(imm)
    if nd is 2
        put_4_bytes(imm)
    return 0

emit_store_scaled_rax bs i2 dp:
    # mov [r_base + r_idx * 8 + dp], rax - the value-from-rax half
    # of emit_scaled_reg (/r field nought, no REX.R), same mod01
    # rule and the same trailing-byte nop guard. GAS-verified.
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    put_in_program(rx)
    put_in_program(137)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + nd * 64
    put_in_program(m)
    put_in_program(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        put_in_program(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    put_in_program(144)
    return 0

