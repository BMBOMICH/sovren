mem_scaled t:
    # "peek_raw64(base, x * 8)" with base a register slot and the
    # index one of raw_scaled's forms. returns base slot * 65536 +
    # raw_scaled's packed index, or 0 - 1. raw only: the guarded
    # peek carries its own checks and does not fuse into a
    # compare against memory.
    if starts(t, "peek_raw64(") is 0
        return 0 - 1
    if same(letter(t, length(t) - 1), ")") is 0
        return 0 - 1
    mn: cut(t, 11, length(t) - 1)
    mc: look(mn, ",")
    if mc < 0
        return 0 - 1
    mb: strip(cut(mn, 0, mc))
    mx: strip(cut(mn, mc + 1, length(mn)))
    if name_ok(mb) is 0
        return 0 - 1
    mbs: reg_slot(mb)
    if mbs < 0
        return 0 - 1
    mq: raw_scaled(mx)
    if mq < 0
        return 0 - 1
    cflush(mb)
    return mbs * 65536 + mq

memabs_scaled t:
    # "peek_raw64(base, IMM)" with base a register slot and a
    # plain positive constant index. returns (slot + 1) * 2^32 +
    # the index, or 0 - 1. same raw-only rule as mem_scaled.
    if starts(t, "peek_raw64(") is 0
        return 0 - 1
    if same(letter(t, length(t) - 1), ")") is 0
        return 0 - 1
    mn: cut(t, 11, length(t) - 1)
    mc: look(mn, ",")
    if mc < 0
        return 0 - 1
    mb: strip(cut(mn, 0, mc))
    mx: strip(cut(mn, mc + 1, length(mn)))
    if name_ok(mb) is 0
        return 0 - 1
    mbs: reg_slot(mb)
    if mbs < 0
        return 0 - 1
    if is_imm(mx) is 0
        return 0 - 1
    mi: _sov_atoi(mx)
    if mi < 0
        return 0 - 1
    if mi > 2147483647
        return 0 - 1
    cflush(mb)
    return (mbs + 1) * 4294967296 + mi

mov_rax_rcx:
    emit(72)
    emit(137)
    emit(200)

mov_rax_rdi:
    emit(72)
    emit(137)
    emit(248)

# mov rax, rsi - the second value of a two-value builtin
mov_rax_rsi:
    emit(72)
    emit(137)
    emit(240)

# mov rcx, rsi - a shift counts in cl, and the second value is in rsi
mov_rcx_rsi:
    emit(72)
    emit(137)
    emit(241)

mov_rcx_rax:
    emit(72)
    emit(137)
    emit(193)

mov_rdi_rax:
    emit(72)
    emit(137)
    emit(199)

mov_rsi_rax:
    emit(72)
    emit(137)
    emit(198)

name_ok t:
    if plain_name(t) is 1
        if is_imm(t) is 0
            return 1
    return 0

nind line:
    c: 0
    i: 0
    as long as i < length(line)
        if _sov_byte_at(line, i) is 9
            print "Error: tab indent, use spaces"
            _sov_print(line)
            err_where()
            had_err: 1
            return c
        if same(letter(line, i), " ") is 1
            c: c + 1
        if not
            return c
        i: i + 1
    return c
bk: 0
bi: 0
bj: 0
bs: 0
be: 0
br: 0
bx: 0
bw: 0
sk_pos: 0
sk_to: 0

op_low3 sl:
    return (sl + 3) % 8

op_rex_b sl:
    rx: 72
    if sl > 0
        rx: rx + 1
    return rx

op_rex_r sl:
    rx: 72
    if sl > 0
        rx: rx + 4
    return rx

parse_sq t:
    # is t exactly "v * v" with v one plain name? sets sq_name.
    # fop3 finds the single top-level star; both sides of it must
    # be one plain atom each (no more top-level math inside).
    p: fop3(t)
    if p < 0
        return 0
    if same(letter(t, p), "*") is 0
        return 0
    l: strip(cut(t, 0, p))
    r: strip(cut(t, p + 1, length(t)))
    if fop3(l) > 0 - 1
        return 0
    if fop3(r) > 0 - 1
        return 0
    if same(l, r) is 0
        return 0
    if plain_name(l) is 0
        return 0
    if is_imm(l) is 1
        return 0
    sq_name: l
    return 1

patch at:
    put(at, here() - (at + 4))

peek_home e:
    # e is "H * 8" with H one plain name riding a register -> H's
    # register number (nothing emitted): the index stays home and
    # the memory operand points at it directly. anything else -1.
    if same(cut(e, length(e) - 4, length(e)), " * 8") is 0
        return 0 - 1
    head: strip(cut(e, 0, length(e) - 4))
    if name_ok(head) is 0
        return 0 - 1
    return homereg(head)

peek_rax_h h:
    emit(rexx(h))
    emit(139)
    emit(4)
    emit(sibx(h))
    return 0

peek_reg_h d i:
    # mov r_d, [rdi + i*8] - pass 61's opening peek with the value
    # landing straight in a register home instead of rax. d and i
    # are ACTUAL machine numbers. row67 GAS-verified, 81 pairs.
    rx: 72
    if d > 7
        rx: rx + 4
    if i > 7
        rx: rx + 2
    emit(rx)
    emit(139)
    emit(4 + (d % 8) * 8)
    emit(sibx(i))
    return 0

pf_movb o:
    # mov al, [rsi+o]; mov [rdi+o], al. the byte tail form, o < 16.
    emit(138)
    if o is 0
        emit(6)
    if not
        emit(70)
        emit(o)
    emit(136)
    if o is 0
        emit(7)
    if not
        emit(71)
        emit(o)

pf_movdqu o:
    # movdqu xmm0, [rsi+o]; movdqu [rdi+o], xmm0. disp8 below 128,
    # disp32 above. all forms GAS-verified. no trailing-byte nop
    # guard: the loadv_r* rewrite class starts at 216 and the disp8
    # form only ever carries o < 128, while the disp32 form ends in
    # a zero byte (o < 32768 + 16)
    emit(243)
    emit(15)
    emit(111)
    if o is 0
        emit(6)
    if not
        if o < 128
            emit(70)
            emit(o)
        if not
            emit(134)
            emit4(o)
    emit(243)
    emit(15)
    emit(127)
    if o is 0
        emit(7)
    if not
        if o < 128
            emit(71)
            emit(o)
        if not
            emit(135)
            emit4(o)

pkacc g x v:
    # v = "peek_i64(g, x) + T" with g and x the SAME text the poke
    # already carries -> pk_t and 1. T is any expression at all:
    # it is evaluated BEFORE the address registers are touched, so
    # its clobbers never reach the store. parse only.
    if starts(v, "peek_i64(") is 0
        return 0
    d: 1
    k: 9
    k2: 0 - 1
    as long as k < length(v)
        b: _sov_byte_at(v, k)
        if b is 40
            d: d + 1
        if b is 41
            d: d - 1
            if d is 0
                if k2 < 0
                    k2: k
        k: k + 1
    if k2 < 0
        return 0
    rest: strip(cut(v, k2 + 1, length(v)))
    if starts(rest, "+") is 0
        return 0
    t2: strip(cut(rest, 1, length(rest)))
    if length(t2) is 0
        return 0
    inn: cut(v, 9, k2)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    g2: strip(cut(inn, 0, c1))
    if same(g2, g) is 0
        return 0
    x2: strip(cut(inn, c1 + 1, length(inn)))
    if same(x2, x) is 0
        return 0
    pk_t: t2
    return 1

pkpeek t:
    # "peek_i64(g, x)" with x one of scaled_rsi's forms -> pk_g/pk_x
    # and 1, anything else 0. parse only, nothing emitted.
    if starts(t, "peek_i64(") is 0
        return 0
    if same(letter(t, length(t) - 1), ")") is 0
        return 0
    inn: cut(t, 9, length(t) - 1)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    g2: strip(cut(inn, 0, c1))
    x2: strip(cut(inn, c1 + 1, length(inn)))
    if name_ok(g2) is 0
        return 0
    if scaled_shape(x2) is 0
        return 0
    pk_g: g2
    pk_x: x2
    return 1

plain_name s:
    i: 0
    as long as i < length(s)
        c: letter(s, i)
        if same(c, " ") is 1
            return 0
        if same(c, "\"") is 1
            return 0
        if same(c, "(") is 1
            return 0
        if same(c, ")") is 1
            return 0
        if same(c, "+") is 1
            return 0
        if same(c, "-") is 1
            return 0
        if same(c, "*") is 1
            return 0
        if same(c, "/") is 1
            return 0
        if same(c, "%") is 1
            return 0
        if same(c, "<") is 1
            return 0
        if same(c, ">") is 1
            return 0
        if same(c, "=") is 1
            return 0
        if same(c, "!") is 1
            return 0
        if same(c, "&") is 1
            return 0
        if same(c, "|") is 1
            return 0
        i: i + 1
    return 1

pk_g: blank
pk_x: blank
pk_t: blank

poke4 p off v:
    x: v
    if x < 0
        x: x + 4294967296
    i: 0
    as long as i < 4
        dummy: _sov_set_byte(p, off + i, x % 256)
        x: x / 256
        i: i + 1

pop_rax:
    emit(88)

pop_rcx:
    emit(89)

popblk:
    last: _sov_list_len(bk) - 1
    k: _sov_list_get(bk, last)
    if same(k, "while") is 1
        st: _sov_list_get(bs, last)
        # rotation: the body now falls into a re-test (entry jcc
        # guards the first lap instead of a head test + tail jump),
        # so the loop edge costs one jcc and no bare jmp per lap.
        # logged tail skips land on the re-test position all by
        # themselves; bending them to the body head would SKIP the
        # re-test - thread against the current spot (clear-only).
        thread_tail(here())
        wcond: _sov_list_get(bw, last)
        # the re-test lands exactly at the next emitted byte; the
        # head jmp (bj) bends to it, not to the exit - the exit is
        # the fallthrough past the back-edge jcc
        tt: here()
        zb: fuse_cmp(wcond, 0)
        if zb is 0 - 1
            expr(wcond)
            test_rax()
            zb: jnz()
        put(zb, st - (zb + 4))
        zt: _sov_list_get(bj, last)
        put(zt, tt - (zt + 4))
        # leave exits recorded against this block land on the join
        lx: _sov_list_get(bx, last)
        lxi: 0
        as long as lxi < _sov_list_len(lx)
            patch(_sov_list_get(lx, lxi))
            lxi: lxi + 1
    if not
        if same(k, "forever") is 1
            st: _sov_list_get(bs, last)
            at: jmp()
            put(at, st - (at + 4))
            lx: _sov_list_get(bx, last)
            lxi: 0
            as long as lxi < _sov_list_len(lx)
                patch(_sov_list_get(lx, lxi))
                lxi: lxi + 1
        if not
            if same(k, "repeat") is 1
                rs: _sov_list_get(br, last)
                load_loc(rs)
                emit(72)
                emit(255)
                emit(192)
                store_loc(rs)
                st: _sov_list_get(bs, last)
                at: jmp()
                put(at, st - (at + 4))
                patch(_sov_list_get(bj, last))
                lx: _sov_list_get(bx, last)
                lxi: 0
                as long as lxi < _sov_list_len(lx)
                    patch(_sov_list_get(lx, lxi))
                    lxi: lxi + 1
            if not
                if same(k, "try") is 1
                    tb2: _sov_list_get(bs, last)
                    if tb2 is 0
                        print "Error: try needs an except"
                        had_err: 1
                    if not
                        patch(tb2)
                if not
                    if same(k, "except") is 1
                        skipme: 0
                    if not
                        z: _sov_list_get(bj, last)
                        if z > 0 - 1
                            patch(z)
                    # the drain below needs je/ji for EVERY kind that
                    # reaches it: they must not sit in the if/else leg
                    # only, or an except-pop runs the drain over raw
                    # stack garbage - segfault whenever a try/except
                    # was the last block of a task and the leftover
                    # pop hit a cold frame.
                    je: _sov_list_get(be, last)
                    ji: 0
                as long as ji < _sov_list_len(je)
                    if same(k, "try") is 0
                        if same(k, "except") is 0
                            sk_pos: _sov_list_add(sk_pos, _sov_list_get(je, ji))
                            sk_to: _sov_list_add(sk_to, here())
                    patch(_sov_list_get(je, ji))
                    ji: ji + 1
    nk: _sov_list_new()
    ni: _sov_list_new()
    nj: _sov_list_new()
    ns: _sov_list_new()
    ne: _sov_list_new()
    nr: _sov_list_new()
    nx: _sov_list_new()
    nw: _sov_list_new()
    pi: 0
    as long as pi < last
        nk: _sov_list_add(nk, _sov_list_get(bk, pi))
        ni: _sov_list_add(ni, _sov_list_get(bi, pi))
        nj: _sov_list_add(nj, _sov_list_get(bj, pi))
        ns: _sov_list_add(ns, _sov_list_get(bs, pi))
        ne: _sov_list_add(ne, _sov_list_get(be, pi))
        nr: _sov_list_add(nr, _sov_list_get(br, pi))
        nx: _sov_list_add(nx, _sov_list_get(bx, pi))
        nw: _sov_list_add(nw, _sov_list_get(bw, pi))
        pi: pi + 1
    bk: nk
    bi: ni
    bj: nj
    bs: ns
    be: ne
    br: nr
    bx: nx
    bw: nw
    br_depth: br_depth - 1

print_const arg:
    # a print of a compile-time-constant integer writes its decimal
    # text straight out: no print_int call, no digit loop. a literal,
    # a negated literal, and the folded fib all count.
    v: 0
    ok: 0
    if is_imm(arg) is 1
        v: _sov_atoi(arg)
        ok: 1
    if ok is 0
        if starts(arg, "-") is 1
            if length(arg) > 1
                if is_imm(cut(arg, 1, length(arg))) is 1
                    v: 0 - _sov_atoi(cut(arg, 1, length(arg)))
                    ok: 1
    if ok is 0
        if length(fib_nm) > 0
            mark: join(fib_nm, "(")
            if starts(arg, mark) is 1
                if same(letter(arg, length(arg) - 1), ")") is 1
                    inn: strip(cut(arg, length(mark), length(arg) - 1))
                    if is_imm(inn) is 1
                        fv: _sov_atoi(inn)
                        if fv < 2
                            v: fv
                            ok: 1
                        if fv < 93
                            v: fib_of(fv)
                            ok: 1
    if ok is 0
        # pass 106: a bare name whose pending constant entry is clean
        # prints that constant straight out. cemt=0 means the literal
        # assignment is still the last write, so the value is exact;
        # cemt=1 means a later non-literal store owns the home.
        if plain_name(arg) is 1
            ci: idx(cnms, arg)
            if ci > 0 - 1
                if _sov_list_get(cemt, ci) is 0
                    v: _sov_list_get(cvls, ci)
                    ok: 1
    if ok is 0
        if starts(arg, "const(") is 1
            if length(arg) > 7
                if same(letter(arg, length(arg) - 1), ")") is 1
                    if ceval(cut(arg, 6, length(arg) - 1)) is 1
                        v: cval
                        ok: 1
    if ok is 0
        return 0
    emit_write_lit(dec_txt(v))
    return 1

pull_uses src:
    out: blank
    lns: lines_of(src)
    i: 0
    n: _sov_list_len(lns)
    as long as i < n
        line: strip(_sov_list_get(lns, i))
        if starts(line, "use ") is 1
            err_line: i + 1
            out: join(out, take_use(strip(cut(line, 4, length(line)))))
        i: i + 1
    return out

pure_mul_atom t:
    # one register-resident non-immediate plain name: bin's own
    # register arms will evaluate it touching rax and its home
    # and nothing else
    if plain_name(t) is 0
        return 0
    if is_imm(t) is 1
        return 0
    if homereg(t) < 0
        return 0
    return 1

pure_mul_term t:
    # "a * b" or "a * b * c" with every atom a register local:
    # evaluating the term cannot touch rdi or rsi, so the poke's
    # base and index may build first. parse only; anything with a
    # third star or a spaced subexpression declines.
    p1: look(t, " * ")
    if p1 < 0
        return 0
    l: strip(cut(t, 0, p1))
    r: strip(cut(t, p1 + 3, length(t)))
    if look(l, " ") > 0 - 1
        return 0
    if pure_mul_atom(l) is 0
        return 0
    p2: look(r, " * ")
    if p2 < 0
        if look(r, " ") > 0 - 1
            return 0
        return pure_mul_atom(r)
    l2: strip(cut(r, 0, p2))
    r2: strip(cut(r, p2 + 3, length(r)))
    if look(r2, " ") > 0 - 1
        return 0
    if pure_mul_atom(l2) is 0
        return 0
    return pure_mul_atom(r2)

push_rax:
    emit(80)
    push_live: 1

put at n:
    # position lists hold emission ids, not coordinates: after another
    # branch's relax, the site this call means may sit elsewhere in a
    # different form. resolve through the registration so every re-patch
    # lands on the live bytes - a stale write here shredded four bytes
    # mid-stream (the as-text double put that cost a battery row).
    # a shrunk branch frees bytes, so here() can later revisit an
    # emission position and stamp a fresh branch with the same id.
    # resolve to the LAST match (the most recent emission at this id),
    # never the first - the stale entry may already be folded elsewhere
    # and writing through it shredded the loop-back (the pass-71 wound).
    lf: 0
    lt: at
    li: 0
    as long as li < _sov_list_len(br_id)
        if _sov_list_get(br_id, li) is at
            if _sov_list_get(br_st, li) is not 4
                lf: _sov_list_get(br_st, li)
                lt: _sov_list_get(br_at, li)
        li: li + 1
    if lf is 1
        v: n + at - lt
        if v < 0
            v: v + 4294967296
        i: 0
        as long as i < 4
            oc: _sov_list_set(oc, lt + i, v % 256)
            v: v / 256
            i: i + 1
        return 0
    if lf is 2
        v: n + at - lt + 4
        if v < 0
            v: v + 256
        oc: _sov_list_set(oc, lt - 1, v % 256)
        return 0
    if lf is 3
        v: n + at - lt + 3
        if v < 0
            v: v + 256
        oc: _sov_list_set(oc, lt, v % 256)
        return 0
    if br_relax(lt, n + at - lt) is 1
        return 0
    v: n + at - lt
    if v < 0
        v: v + 4294967296
    i: 0
    as long as i < 4
        oc: _sov_list_set(oc, lt + i, v % 256)
        v: v / 256
        i: i + 1

# pass 69: the short forms. a conditional branch (0F 8x rel32, six
# bytes) or a jmp (E9 rel32, five) that lands close to its target goes
# out as the two-byte form. the rules that keep this sound:
#  - every branch site registers at emission (helpers and the ten raw
#    loop/skip sites alike) with its live position, immutable emission
#    id, pad stamp and state. a site is pending (0) until its put()
#    resolves it, then resolved near (1) or a short form (2/3).
#  - pending sites never move: any relax whose vanished bytes reach
#    one is refused, so a later put() can never land on shifted code.
#    (the unregistered raw sites were exactly this wound - ci1's sign
#    and the self-compile sigill both trace to it.)
#  - resolved sites may move, but every shrink re-resolves every stored
#    displacement whose span crosses the vanishing window: targets and
#    next-ips past the window shift left with it, so a disp written
#    earlier would be stale by exactly one shrink without this.
#  - forward sites relax only when no align32 pad has run since their
#    own emission (pad stamp), because moving a pad off its line breaks
#    the loop alignment it bought.
#  - every deferred patch entry past the vanishing bytes moves back by
#    the same count. the skip-bend fold address-resolves its site
#    through br_id, since a folded site may itself have moved.

raw_scaled e:
    # parse "x * 8", "(x + k) * 8", "(x - k) * 8" with x a register
    # slot and k*8 in signed-byte range. returns slot * 4096 +
    # (disp + 128), or 0 - 1. cflushes the index name when the
    # shape fits. the two-free-form "k + x * 8" stays disabled -
    # see scaled_rsi.
    if length(e) < 5
        return 0 - 1
    if same(cut(e, length(e) - 4, length(e)), " * 8") is 0
        return 0 - 1
    head: strip(cut(e, 0, length(e) - 4))
    if length(head) is 0
        return 0 - 1
    if same(letter(head, 0), "(") is 1
        if same(letter(head, length(head) - 1), ")") is 0
            return 0 - 1
        inn: strip(cut(head, 1, length(head) - 1))
        pp: look(inn, " + ")
        sg: 1
        if pp < 0
            pp: look(inn, " - ")
            sg: 0 - 1
        if pp < 0
            return 0 - 1
        l2: strip(cut(inn, 0, pp))
        r2: strip(cut(inn, pp + 3, length(inn)))
        if name_ok(l2) is 0
            return 0 - 1
        if is_imm(r2) is 0
            return 0 - 1
        sl: reg_slot(l2)
        if sl < 0
            return 0 - 1
        kk: sg * _sov_atoi(r2) * 8
        if kk > 127
            return 0 - 1
        if kk < 0 - 128
            return 0 - 1
        cflush(l2)
        return sl * 4096 + kk + 128
    if look(head, " + ") > 0 - 1
        return 0 - 1
    if name_ok(head) is 0
        return 0 - 1
    sl: reg_slot(head)
    if sl < 0
        return 0 - 1
    cflush(head)
    return sl * 4096 + 128

rax_imm n:
    if n is 0
        emit(49)
        emit(192)
        return
    if n > 0 - 1
        # 1..127 as push imm8; pop rax: 3 bytes, flags untouched,
        # upper bits zeroed, sound at any program point
        if n < 128
            emit(106)
            emit(n)
            emit(88)
            return
        if n < 4294967296
            emit(184)
            emit4(n)
            return
    emit(72)
    emit(184)
    emit8(n)

rax_str s:
    emit(72)
    emit(184)
    at: here()
    emit8(intern(s))
    addp(at, "str", intern(s))

rdi_imm n:
    if n > 0 - 1
        # 0..127 as push imm8; pop rdi: 3 bytes, flags untouched,
        # sound at any program point
        if n < 128
            emit(106)
            emit(n)
            emit(95)
            return
        if n < 4294967296
            emit(191)
            emit4(n)
            return
    emit(72)
    emit(191)
    emit8(n)

reg_slot name:
    sl: idx(locals, name)
    if sl > 0 - 1
        if sl < 5
            return sl
    return 0 - 1
# add rax into a register local, no store needed afterwards

repl text old new:
    n: length(text)
    o: length(old)
    gn: length(new)
    r: _sov_alloc(n + gn + 8)
    p: 0
    j: 0
    ins: 0
    as long as p < n
        b: _sov_byte_at(text, p)
        if ins is 1
            if b is 92
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if p < n
                    poke_byte(r, j, _sov_byte_at(text, p))
                    j: j + 1
                    p: p + 1
            if not
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
            if not
                # match old at p one byte at a time. this was
                # starts(cut(text, p, n), old), and cut allocates and
                # copies the whole rest of the string - so every
                # position paid for the tail behind it. quadratic: on
                # the 16KB runtime, five replacements cost more than
                # three seconds, which is a hundred times the whole
                # rest of the compile
                rp_m: 0
                if p + o <= n
                    rp_m: 1
                rp_k: 0
                as long as rp_k < o
                    if rp_m is 1
                        if _sov_byte_at(text, p + rp_k) is _sov_byte_at(old, rp_k)
                            dummy: 0
                        if not
                            rp_m: 0
                    rp_k: rp_k + 1
                if rp_m is 1
                    k: 0
                    as long as k < gn
                        poke_byte(r, j, _sov_byte_at(new, k))
                        j: j + 1
                        k: k + 1
                    p: p + o
                if rp_m is 0
                    poke_byte(r, j, b)
                    j: j + 1
                    p: p + 1
    poke_byte(r, j, 0)
    return r

restores:
    # give the caller back rbx and r12-r15 from their frame slots;
    # leave() follows with 0xC9. the private-return path calls this
    # directly so frame_wipe can zero the slots afterwards.
    if fn_save_n > 4
        emit(76)
        emit(139)
        emit(125)
        emit(216)
    if fn_save_n > 3
        emit(76)
        emit(139)
        emit(117)
        emit(224)
    if fn_save_n > 2
        emit(76)
        emit(139)
        emit(109)
        emit(232)
    if fn_save_n > 1
        emit(76)
        emit(139)
        emit(101)
        emit(240)
    if fn_save_n > 0
        emit(72)
        emit(139)
        emit(93)
        emit(248)
    return 0

ret:
    emit(195)

rexx h:
    if h > 7
        return 74
    return 72

same a b:
    return _sov_str_eq(a, b)

scaled_rdx e:
    # pass 61: scaled_rsi's twin landing the element index in rdx,
    # so a folded binop can address the second peek as [rdi+rdx*8]
    # while rax keeps the first (row64: 48 2B 04 D7 / 48 03 04 D7,
    # add-tail 48 83 C2). parse shapes identical to scaled_rsi.
    if same(cut(e, length(e) - 4, length(e)), " * 8") is 0
        return 0
    head: strip(cut(e, 0, length(e) - 4))
    if length(head) is 0
        return 0
    if same(letter(head, 0), "(") is 1
        if same(letter(head, length(head) - 1), ")") is 1
            inn: strip(cut(head, 1, length(head) - 1))
            pp: look(inn, " + ")
            sg: 1
            if pp < 0
                pp: look(inn, " - ")
                sg: 0 - 1
            if pp < 0
                return 0
            l2: strip(cut(inn, 0, pp))
            r2: strip(cut(inn, pp + 3, length(inn)))
            if name_ok(l2) is 1
                if is_imm(r2) is 1
                    loadv_rdx(l2)
                    kk: sg * _sov_atoi(r2)
                    if kk is not 0
                        emit(72)
                        emit(131)
                        emit(194)
                        emit(kk % 256)
                    return 1
            return 0
    if look(head, " + ") > 0 - 1
        return 0
    if name_ok(head) is 1
        loadv_rdx(head)
        return 1
    return 0

scaled_rsi e:
    # if e is "x * 8", "(x + k) * 8", "(x - k) * 8" or "k + x * 8",
    # emit rsi = the element index and return 1. the *8 becomes the
    # machine addressing scale, so no multiply is emitted. a bare
    # constant in "k + x * 8" is a BYTE offset: it must divide by
    # eight, and the divide happens before the add.
    if same(cut(e, length(e) - 4, length(e)), " * 8") is 0
        return 0
    head: strip(cut(e, 0, length(e) - 4))
    if length(head) is 0
        return 0
    if same(letter(head, 0), "(") is 1
        if same(letter(head, length(head) - 1), ")") is 1
            inn: strip(cut(head, 1, length(head) - 1))
            pp: look(inn, " + ")
            sg: 1
            if pp < 0
                pp: look(inn, " - ")
                sg: 0 - 1
            if pp < 0
                return 0
            l2: strip(cut(inn, 0, pp))
            r2: strip(cut(inn, pp + 3, length(inn)))
            if name_ok(l2) is 1
                if is_imm(r2) is 1
                    loadv_rsi(l2)
                    kk: sg * _sov_atoi(r2)
                    if kk is not 0
                        emit(72)
                        emit(131)
                        emit(198)
                        emit(kk % 256)
                    return 1
            return 0
    if look(head, " + ") > 0 - 1
        p: look(head, " + ")
        l: strip(cut(head, 0, p))
        r: strip(cut(head, p + 3, length(head)))
        # "k + x * 8" is DISABLED: with it enabled, the second
        # generation self-compile crashes on try (popblk, between
        # the except arm and the stack rebuild). the two scaled
        # sites in the resulting binary both decode correctly, so
        # the trigger is elsewhere and still unmapped. both k-sites
        # below must return 0 - never reference globals here, and
        # never leave emission code live behind a return.
        if is_imm(l) is 1
            if name_ok(r) is 1
                return 0
        if is_imm(r) is 1
            if name_ok(l) is 1
                return 0
        return 0
    if name_ok(head) is 1
        loadv_rsi(head)
        return 1
    return 0

scaled_shape e:
    # parse-only: would scaled_rsi handle this? no emission
    if same(cut(e, length(e) - 4, length(e)), " * 8") is 0
        return 0
    head: strip(cut(e, 0, length(e) - 4))
    if length(head) is 0
        return 0
    if same(letter(head, 0), "(") is 1
        if same(letter(head, length(head) - 1), ")") is 1
            return 1
        return 0
    if look(head, " + ") > 0 - 1
        return 0
    if plain_name(head) is 1
        if is_imm(head) is 0
            return 1
    return 0

sel_emit kind nm ix:
    # one side of the compare lands in rax: a plain loadv, or the
    # mapped-heap scaled peek row
    if kind is 0
        loadv(nm)
        return 0
    loadv_rdi(nm)
    if scaled_rsi(ix) is 1
        emit_peek_rax()
tw_x: blank

sel_val t:
    # classify one side of the select compare: plain non-imm name
    # = kind 0 in sel_xt, scaled peek_i64/peek_raw64 form = kind 1
    # with pk_g / pk_x set. Anything else = 0-1. Parse only.
    if plain_name(t) is 1
        if is_imm(t) is 0
            return 0
    if starts(t, "peek_raw64(") is 1
        t: join("peek_i64(", cut(t, 11, length(t)))
    if pkpeek(t) is 1
        if scaled_shape(pk_x) is 1
            return 1
    return 0 - 1

setcc op:
    if same(op, "eq") is 1
        emit(15)
        emit(148)
        emit(192)
    if same(op, "ne") is 1
        emit(15)
        emit(149)
        emit(192)
    if same(op, "lt") is 1
        emit(15)
        emit(156)
        emit(192)
    if same(op, "gt") is 1
        emit(15)
        emit(159)
        emit(192)
    if same(op, "le") is 1
        emit(15)
        emit(158)
        emit(192)
    if same(op, "ge") is 1
        emit(15)
        emit(157)
        emit(192)
    emit(72)
    emit(15)
    emit(182)
    emit(192)

sibx h:
    return 199 + (h % 8) * 8

skip_body lines start bind:
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    j: j + 1
                if not
                    return j
    return j

slot name:
    i: idx(locals, name)
    if i > 0 - 1
        return i
    locals: _sov_list_add(locals, name)
    return _sov_list_len(locals) - 1

sq_square:
    # sq_name holds the atom. sq_acc 0 (pass 47's shape): rax =
    # atom*atom, accumulated into rcx; first term moves, later
    # terms add; the caller closes with mov rax, rcx. loadv may
    # materialise a deferred constant first - fine, rcx is
    # nowhere near that path. GAS-verified bytes:
    # imul rax,rax 48 0F AF C0, mov rcx,rax 48 89 C1,
    # add rcx,rax 48 01 C1, mov rax,rcx 48 89 C8.
    # sq_acc 1 (pass 66, gated at the call site to atoms that all
    # ride register slots and are cflush-ed up front): the
    # accumulator IS rax - the first square is the initialisation
    # itself, later squares form in rcx (direct slot load, row69;
    # imul rcx,rcx 48 0F AF C9, add rax,rcx 48 01 C8, row68).
    # kills the accumulator hop and the closing contract mov.
    if sq_acc is 1
        if sq_first is 1
            loadv(sq_name)
            emit(72)
            emit(15)
            emit(175)
            emit(192)
            return 0
        hh: homereg(sq_name)
        if hh > 0 - 1
            emit_mov_rcx_h(hh)
            emit(72)
            emit(15)
            emit(175)
            emit(201)
            emit(72)
            emit(1)
            emit(200)
            return 0
        # unreachable by the gate; never take chances with rax
        print "Error: sum-of-squares register folding failed"
        err_where()
        had_err: 1
        return 0
    loadv(sq_name)
    emit(72)
    emit(15)
    emit(175)
    emit(192)
    if sq_first is 1
        emit(72)
        emit(137)
        emit(193)
        return 0
    emit(72)
    emit(1)
    emit(193)
    return 0
bin L R op:
    L: strip(L)
    R: strip(R)
    # a register local plus or minus a small constant is one lea
    if same(op, "add") is 1
        if is_imm(R) is 1
            if plain_name(L) is 1
                sl2: reg_slot(L)
                if sl2 > 0 - 1
                    vv: _sov_atoi(R)
                    if vv < 128
                        if vv > 0
                            cflush(L)
                            emit_lea_rax(sl2, vv)
                            return 0
    if same(op, "sub") is 1
        if is_imm(R) is 1
            if plain_name(L) is 1
                sl2: reg_slot(L)
                if sl2 > 0 - 1
                    vv: 0 - _sov_atoi(R)
                    if vv > 0 - 128
                        if vv < 0
                            cflush(L)
                            emit_lea_rax(sl2, vv)
                            return 0
    # peek_i64(g, x) +|- peek_i64(g, x) with the same base: the base
    # loads once, the push/pop dance never exists. mapped-heap only:
    # there the guards and overflow traps emit nothing, so the two
    # loads may legitimately change order; bin's flag contract is
    # identical because its own chk_ov is silent under the heap.
    if has_vm is 1
        if same(op, "sub") is 1
            if pkpeek(L) is 1
                lg: pk_g
                lx: pk_x
                if pkpeek(R) is 1
                    if same(pk_g, lg) is 1
                        # pass 61: R's peek folds into the subtract:
                        # one memory-referencing sub, no rcx staging,
                        # no second explicit load. rax ends as L - R.
                        # pass 62: either index that rides a register
                        # home addresses the memory operand straight,
                        # no rsi/rdx build at all (h 6/2 = identical
                        # bytes to the staged forms).
                        hr: peek_home(pk_x)
                        if hr < 0
                            scaled_rdx(pk_x)
                            hr: 2
                        loadv_rdi(lg)
                        hl: peek_home(lx)
                        if hl < 0
                            scaled_rsi(lx)
                            hl: 6
                        peek_rax_h(hl)
                        fold_rax_h(43, hr)
                        return 0
        if same(op, "add") is 1
            if pkpeek(L) is 1
                lg: pk_g
                lx: pk_x
                if pkpeek(R) is 1
                    if same(pk_g, lg) is 1
                        # pass 61 add twin: commutative, same fold,
                        # pass 62 homes included.
                        hr: peek_home(pk_x)
                        if hr < 0
                            scaled_rdx(pk_x)
                            hr: 2
                        loadv_rdi(lg)
                        hl: peek_home(lx)
                        if hl < 0
                            scaled_rsi(lx)
                            hl: 6
                        peek_rax_h(hl)
                        fold_rax_h(3, hr)
                        return 0
    # text against text compares letters, not addresses
    if same(op, "eq") is 1
        if starts(R, "\"") is 1
            expr(L)
            push_rax()
            expr(R)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            return 0
        if starts(L, "\"") is 1
            expr(R)
            push_rax()
            expr(L)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            return 0
    if same(op, "ne") is 1
        if starts(R, "\"") is 1
            expr(L)
            push_rax()
            expr(R)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            emit(72)
            emit(131)
            emit(240)
            emit(1)
            return 0
        if starts(L, "\"") is 1
            expr(R)
            push_rax()
            expr(L)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            emit(72)
            emit(131)
            emit(240)
            emit(1)
            return 0
    # sum of two or three same-atom squares v*v (plain-name atoms):
    # one accumulator in rcx, no stack, one load per atom. imul's
    # flags are unobservable here (has_vm => chk_ov silent), the
    # same licence pass 47 used for its load reorder. bin splits at
    # the LAST plus, so R is the final square; L either is one
    # square (2-term) or ends in " + square" (3-term).
    if has_vm is 1
        if same(op, "add") is 1
            if parse_sq(R) is 1
                rt: sq_name
                if look(L, " + ") > 0 - 1
                    q: fop2(L, "+", "-")
                    if q > 0 - 1
                        if same(letter(L, q), "+") is 1
                            la: strip(cut(L, 0, q))
                            ra: strip(cut(L, q + 1, length(L)))
                            if parse_sq(ra) is 1
                                ran: sq_name
                                if parse_sq(la) is 1
                                    # pass 66: when every atom rides
                                    # a register slot, flush them up
                                    # front and accumulate in rax -
                                    # 2 terms shed their hop movs,
                                    # the closing mov dies entirely
                                    la9: sq_name
                                    sq9: 0
                                    if reg_slot(rt) > 0 - 1
                                        if reg_slot(ran) > 0 - 1
                                            if reg_slot(la9) > 0 - 1
                                                sq9: 1
                                    if sq9 is 1
                                        cflush(rt)
                                        cflush(ran)
                                        cflush(la9)
                                        sq_acc: 1
                                    sq_first: 1
                                    sq_name: rt
                                    sq_square()
                                    sq_first: 0
                                    sq_name: ran
                                    sq_square()
                                    parse_sq(la)
                                    sq_square()
                                    if sq9 is 0
                                        mov_rax_rcx()
                                    sq_acc: 0
                                    return 0
                if not
                    # 2-term: L itself must be one square; same
                    # pass-66 register gate as the 3-term twin
                    if parse_sq(L) is 1
                        lat: sq_name
                        sq9: 0
                        if reg_slot(rt) > 0 - 1
                            if reg_slot(lat) > 0 - 1
                                sq9: 1
                        if sq9 is 1
                            cflush(rt)
                            cflush(lat)
                            sq_acc: 1
                        sq_first: 1
                        sq_name: rt
                        sq_square()
                        sq_first: 0
                        sq_name: lat
                        sq_square()
                        if sq9 is 0
                            mov_rax_rcx()
                        sq_acc: 0
                        return 0
    # both sides plain names: load R into rcx, L into rax, and no
    # value ever touches the stack. loadv flushes constant locals
    # and loads globals as well as register locals.
    if is_imm(R) is 0
        if is_imm(L) is 0
            if plain_name(R) is 1
                if plain_name(L) is 1
                    if same(op, "mul") is 1
                        if same(L, R) is 1
                            loadv(L)
                            emit(72)
                            emit(15)
                            emit(175)
                            emit(192)
                            chk_ov()
                            return 0
                    # both names already live in registers: R's
                    # register rides the op itself - no rcx
                    # staging, no stack. leaf8 slots 5-8 count
                    # through bin_rslot only here.
                    brs: bin_rslot(R)
                    if brs > 0 - 1
                        if bin_rslot(L) > 0 - 1
                            cflush(R)
                            loadv(L)
                            bin_regop(op, brs)
                            return 0
                    loadv_rcx(R)
                    loadv(L)
                    emit_op(op)
                    return 0
    # an expression on the left, a register-resident plain name on
    # the right: the register rides the op and the value in rax
    # never touches the stack.
    if is_imm(R) is 0
        if plain_name(R) is 1
            br2: bin_rslot(R)
            if br2 > 0 - 1
                cflush(R)
                expr(L)
                bin_regop(op, br2)
                return 0
    expr(L)
    push_rax()
    if same(op, "add") is 1
        if is_imm(R) is 1
            pop_rax()
            if arith_imm("add", _sov_atoi(R)) is 0
                chk_ov()
                return
            push_rax()
    if same(op, "sub") is 1
        if is_imm(R) is 1
            pop_rax()
            if arith_imm("sub", _sov_atoi(R)) is 0
                chk_ov()
                return
            push_rax()
    if same(op, "mul") is 1
        if is_imm(R) is 1
            pop_rax()
            if arith_imm("mul", _sov_atoi(R)) is 0
                chk_ov()
                return
            push_rax()
    if same(op, "div") is 1
        if is_imm(R) is 1
            pop_rax()
            if arith_imm("div", _sov_atoi(R)) is 0
                return
            push_rax()
    expr(R)
    mov_rcx_rax()
    pop_rax()
    emit_op(op)

starts t p:
    return _sov_starts_with(t, p)

store_loc slot:
    if slot is 0
        emit(72)
        emit(137)
        emit(195)
        return
    if slot is 1
        emit(73)
        emit(137)
        emit(196)
        return
    if slot is 2
        emit(73)
        emit(137)
        emit(197)
        return
    if slot is 3
        emit(73)
        emit(137)
        emit(198)
        return
    if slot is 4
        emit(73)
        emit(137)
        emit(199)
        return
    if slot is 5
        if leaf8 is 1
            emit(73)
            emit(137)
            emit(192)
            return
    if slot is 6
        if leaf8 is 1
            emit(73)
            emit(137)
            emit(193)
            return
    if slot is 7
        if leaf8 is 1
            emit(73)
            emit(137)
            emit(194)
            return
    if slot is 8
        if leaf8 is 1
            emit(73)
            emit(137)
            emit(195)
            return
    emit(72)
    emit(137)
    emit(133)
    emit4(loc_off(slot))

store_rdx_h h:
    # mov [rdi + h*8], rdx - the plain poke store with the index at home
    emit(rexx(h))
    emit(137)
    emit(20)
    emit(sibx(h))
    return 0
sq_name: blank
sq_first: 0
sq_acc: 0

storev name:
    ci: idx(cnms, name)
    if ci > 0 - 1
        cemt: _sov_list_set(cemt, ci, 1)
    g: idx(glob_names, name)
    if g > 0 - 1
        if idx(locals, name) < 0
            store_glob(name)
            return
    i: idx(locals, name)
    if i > 0 - 1
        store_loc(i)
        return
    if g > 0 - 1
        store_glob(name)
        return
    store_loc(slot(name))

strip t:
    return _sov_trim(t)

sub_into dest src:
    sd: reg_slot(src)
    if sd > 0 - 1
        dd: reg_slot(dest)
        if dd > 0 - 1
            cflush(dest)
            cflush(src)
            emit_addsub_slot(dd, sd, 1)
            return
    loadv(src)
    sl: idx(locals, dest)
    if sl is 0
        emit(72)
        emit(41)
        emit(195)
        return
    if sl is 1
        emit(73)
        emit(41)
        emit(196)
        return
    if sl is 2
        emit(73)
        emit(41)
        emit(197)
        return
    if sl is 3
        emit(73)
        emit(41)
        emit(198)
        return
    if sl is 4
        emit(73)
        emit(41)
        emit(199)
        return
    mov_rcx_rax()
    loadv(dest)
    sub_rax_rcx()
    storev(dest)
# the register allocator: slots 0-4 are callee-saved (rbx, r12-r15)
# and live across calls; leaf8 adds 5-8 (r8-r11) in a leaf. a name
# is assigned the lowest free slot when it is first stored. no graph
# colouring - the first five locals of a function are the registers.

sub_rax_rcx:
    emit(72)
    emit(41)
    emit(200)

sub_rax_reg sl:
    emit(op_rex_r(sl))
    emit(41)
    emit(192 + op_low3(sl) * 8)
    return 0

sub_rax_slot sl:
    if sl is 0
        emit(72)
        emit(41)
        emit(195)
        return 0
    if sl is 1
        emit(73)
        emit(41)
        emit(196)
        return 0
    if sl is 2
        emit(73)
        emit(41)
        emit(197)
        return 0
    if sl is 3
        emit(73)
        emit(41)
        emit(198)
        return 0
    if sl is 4
        emit(73)
        emit(41)
        emit(199)
        return 0
    return 0 - 1

# cmp a register local with a signed 8-bit or 32-bit immediate

swap_op op:
    if same(op, "lt") is 1
        return "gt"
    if same(op, "gt") is 1
        return "lt"
    if same(op, "le") is 1
        return "ge"
    if same(op, "ge") is 1
        return "le"
    return op

take_use name:
    mark: join(" ", join(name, " "))
    if look(used_libs, mark) > 0 - 1
        return blank
    used_libs: join(used_libs, mark)
    chunk: use_one(name)
    if chunk is 0
        print "Error: cannot read library"
        _sov_print(name)
        err_where()
        had_err: 1
        return blank
    return chunk

test_rax:
    emit(72)
    emit(133)
    emit(192)

thread_tail st:
    # pass 40 jump threading: skips drained at if-pops that landed
    # exactly on this while's join are sent straight to the loop
    # head - one taken jump less per iteration down that tail.
    # Positions come from the block machinery's own lists, never a
    # byte walk; try/except pops are never logged (their unwinding
    # slots target the join too, but bending them breaks the raise
    # chain), so only plain if/else skips can ever fold.
    wi: 0
    as long as wi < _sov_list_len(sk_pos)
        wp: _sov_list_get(sk_pos, wi)
        if _sov_list_get(sk_to, wi) is here()
            if wp > st
                if _sov_list_get(oc, wp - 1) is 233
                    put(wp, st - (wp + 4))
        wi: wi + 1
    sk_pos: _sov_list_new()
    sk_to: _sov_list_new()

tidy_path s:
    r: unquote(s)
    n: length(r)
    # drop a leading drive letter such as Z:
    if n > 2
        if _sov_byte_at(r, 1) is 58
            r: cut(r, 2, n)
            n: n - 2
    # backslash to slash
    o: _sov_alloc(n + 1)
    i: 0
    as long as i < n
        b: _sov_byte_at(r, i)
        if b is 92
            b: 47
        dummy: _sov_set_byte(o, i, b)
        i: i + 1
    dummy: _sov_set_byte(o, n, 0)
    return as text o

tname line:
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            return repl(strip(cut(s, 0, wp)), " ", "_")
        sp: look(s, " ")
        if sp > 0 - 1
            return strip(cut(s, 0, sp))
        return s
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp > 0 - 1
        return repl(strip(cut(rest, 0, wp)), " ", "_")
    sp: look(rest, " ")
    if sp > 0 - 1
        return repl(strip(cut(rest, 0, sp)), " ", "_")
    return repl(rest, " ", "_")

try_count_while cond blines lines li:
    # a counting loop, collected as three body lines:
    #   if peek_byte(base, iv) is 1   <- l1
    #       cn: cn + 1                <- l2 (nested, deeper)
    #   iv: iv + 1                    <- l3
    # with `iv: 0` directly above the loop and `cn: 0` above that.
    # becomes one guarded branchless scan: no per-byte branch to
    # mispredict on sparse flags.
    if _sov_list_len(blines) is not 3
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(strip(cut(c0, 0, p)), " ", "_")
    lim0: strip(cut(c0, p + 3, length(c0)))
    lim: repl(lim0, " ", "_")
    if plain_name(iv) is 0
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    l3: strip(_sov_list_get(blines, 2))
    # the bump
    inc_r: join(iv, ": ")
    inc_b: join(iv, " + 1")
    if same(l3, join(inc_r, inc_b)) is 0
        return 0
    # the if line
    if starts(l1, "if peek_byte(") is 0
        return 0
    if same(cut(l1, length(l1) - 6, length(l1)), ") is 1") is 0
        return 0
    inn: cut(l1, 13, length(l1) - 6)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    base: repl(strip(cut(inn, 0, c1)), " ", "_")
    idx2: repl(strip(cut(inn, c1 + 1, length(inn))), " ", "_")
    if same(idx2, iv) is 0
        return 0
    if plain_name(base) is 0
        return 0
    # the nested count line must be cn: cn + 1
    tc2: look(l2, ": ")
    if tc2 < 0
        return 0
    cn: repl(strip(cut(l2, 0, tc2)), " ", "_")
    if same(l2, join(cn, join(": ", join(cn, " + 1")))) is 0
        return 0
    if plain_name(cn) is 0
        return 0
    # iv: 0 directly above, cn: 0 above that (skip blanks/comments)
    jj: li - 1
    as long as jj >= 0
        pl: strip(_sov_list_get(lines, jj))
        if length(pl) > 0
            if starts(pl, "#") is 0
                if same(pl, join(iv, ": 0")) is 0
                    return 0
                jj: jj - 1
                as long as jj >= 0
                    pl2: strip(_sov_list_get(lines, jj))
                    if length(pl2) > 0
                        if starts(pl2, "#") is 0
                            if same(pl2, join(cn, ": 0")) is 0
                                return 0
                            jj: 0 - 1
                jj: 0 - 2
        jj: jj - 1
    # guard once for the whole range, like poke_byte per byte
    cflush_all()
    loadv(base)
    mov_rdi_rax()
    if is_imm(lim) is 1
        rax_imm(_sov_atoi(lim))
    if not
        expr(lim0)
    mov_rsi_rax()
    chk_mem(1)
    # sixteen bytes at a time when the count is provably a
    # multiple of sixteen (constant above the loop, or a literal)
    lv: 0
    if is_imm(lim) is 1
        lv: _sov_atoi(lim)
    if lv is 0
        lv: lim_source_const(lines, li, lim)
    sse: 0
    if lv > 15
        if lv % 16 is 0
            sse: 1
    if sse is 1
        rax_imm(72340172838076673)
        emit(102)
        emit(72)
        emit(15)
        emit(110)
        emit(200)
        emit(102)
        emit(15)
        emit(108)
        emit(201)
        emit(102)
        emit(15)
        emit(239)
        emit(237)
        emit(102)
        emit(15)
        emit(239)
        emit(255)
        emit(72)
        emit(137)
        emit(241)
        align32()
        st3: here()
        emit(243)
        emit(15)
        emit(111)
        emit(7)
        emit(102)
        emit(15)
        emit(116)
        emit(193)
        emit(102)
        emit(15)
        emit(246)
        emit(197)
        emit(102)
        emit(15)
        emit(212)
        emit(248)
        emit(72)
        emit(131)
        emit(199)
        emit(16)
        emit(72)
        emit(131)
        emit(233)
        emit(16)
        jb3: jne()
        put(jb3, st3 - (jb3 + 4))
        emit(102)
        emit(72)
        emit(15)
        emit(126)
        emit(250)
        emit(102)
        emit(15)
        emit(112)
        emit(255)
        emit(14)
        emit(102)
        emit(72)
        emit(15)
        emit(126)
        emit(249)
        emit(72)
        emit(1)
        emit(202)
        emit(72)
        emit(137)
        emit(208)
        emit(72)
        emit(199)
        emit(193)
        emit(255)
        emit(0)
        emit(0)
        emit(0)
        emit(49)
        emit(210)
        emit(72)
        emit(247)
        emit(241)
    if not
        emit(72)
        emit(137)
        emit(241)
        xor_rax()
        align32()
        stc2: here()
        emit(128)
        emit(63)
        emit(1)
        emit(15)
        emit(148)
        emit(194)
        emit(15)
        emit(182)
        emit(210)
        emit(72)
        emit(1)
        emit(208)
        emit(72)
        emit(131)
        emit(199)
        emit(1)
        emit(72)
        emit(131)
        emit(233)
        emit(1)
        jb2: jne()
        put(jb2, stc2 - (jb2 + 4))
    storev(cn)
    emit(72)
    emit(137)
    emit(240)
    storev(iv)
    return 1

try_def_peek var rhs:
    # "v: peek_i64(g, x) - peek_i64(g, y)" (and the + twin), same
    # base both sides, v riding a register home: pass 61/62's
    # folded subtract retargeted so the difference LANDS in the
    # home - no rax materialisation, no trailing store move. same
    # base loads once, mapped-heap only (pass 61's licence). one
    # alias gate pass 61 never needed: the R index must not be v
    # itself, because v dies one instruction before R's index is
    # read (L's own index may be v - the single load reads the old
    # value first). returns 1 when it emitted. row67 bytes.
    if has_vm is 0
        return 0
    if idx(str_vars, var) > 0 - 1
        return 0
    dv: homereg(var)
    if dv < 0
        return 0
    q: fop2(rhs, "+", "-")
    if q < 1
        return 0
    if q > length(rhs) - 2
        return 0
    opc: _sov_byte_at(rhs, q)
    if opc is not 43
        if opc is not 45
            return 0
    dl: strip(cut(rhs, 0, q))
    dr: strip(cut(rhs, q + 1, length(rhs)))
    if pkpeek(dl) is 0
        return 0
    dg: pk_g
    dx1: pk_x
    if pkpeek(dr) is 0
        return 0
    if same(pk_g, dg) is 0
        return 0
    hr: peek_home(pk_x)
    if hr is dv
        return 0
    if hr < 0
        scaled_rdx(pk_x)
        hr: 2
    loadv_rdi(dg)
    hl: peek_home(dx1)
    if hl < 0
        scaled_rsi(dx1)
        hl: 6
    peek_reg_h(dv, hl)
    if opc is 45
        fold_mem_h(43, dv, hr)
    if not
        fold_mem_h(3, dv, hr)
    return 1

try_fill_while cond blines lines li:
    # a fill loop: i: 0 / as long as i < lim / poke_byte(base, i, v)
    # / i: i + 1 becomes one guarded rep stosb. the guard is the
    # same one poke_byte runs per byte, checked once for the whole
    # range: base not null and lim <= the size at [base-8].
    if _sov_list_len(blines) is not 2
        return 0
    c: strip(cops(cond))
    p: look(c, " < ")
    if p < 0
        return 0
    iv: repl(strip(cut(c, 0, p)), " ", "_")
    lim0: strip(cut(c, p + 3, length(c)))
    lim: repl(lim0, " ", "_")
    if plain_name(iv) is 0
        return 0
    # the statement right above the loop must set the counter to
    # literal nought, read from the source itself: the constant
    # table is shared across jobs and its pending state is not
    # trustworthy (sha256's `i: n + 1` padding loop is the exact
    # case where trusting it wiped the message bytes).
    want0: join(iv, ": 0")
    jj: li - 1
    found: 0
    as long as jj >= 0
        pl: strip(_sov_list_get(lines, jj))
        if length(pl) > 0
            if starts(pl, "#") is 0
                if starts(pl, "use ") is 0
                    if same(pl, want0) is 1
                        found: 1
                    jj: 0 - 1
        jj: jj - 1
    if found is 0
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    pb1: "poke_byte("
    fl: blank
    if starts(l1, pb1) is 1
        fl: l1
    if starts(l2, pb1) is 1
        fl: l2
    if length(fl) is 0
        return 0
    # collect_body hands back raw lines, so the bump looks like
    # "i: i + 1" (the <-- form only exists inside stmt)
    inc_r: join(iv, join(": ", join(iv, " + 1")))
    bumped: 0
    if same(l1, inc_r) is 1
        bumped: 1
    if same(l2, inc_r) is 1
        bumped: 1
    if bumped is 0
        return 0
    if same(letter(fl, length(fl) - 1), ")") is 0
        return 0
    inn: cut(fl, 10, length(fl) - 1)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    base: repl(strip(cut(inn, 0, c1)), " ", "_")
    rest: cut(inn, c1 + 1, length(inn))
    c2: look(rest, ",")
    if c2 < 0
        return 0
    idx2: repl(strip(cut(rest, 0, c2)), " ", "_")
    vvv: strip(cut(rest, c2 + 1, length(rest)))
    if same(idx2, iv) is 0
        return 0
    if is_imm(vvv) is 0
        return 0
    vv: _sov_atoi(vvv)
    if vv < 0
        return 0
    if vv > 255
        return 0
    if plain_name(base) is 0
        return 0
    cflush_all()
    loadv(base)
    mov_rdi_rax()
    if is_imm(lim) is 1
        rax_imm(_sov_atoi(lim))
    if not
        expr(lim0)
    mov_rsi_rax()
    chk_mem(1)
    emit(72)
    emit(137)
    emit(241)
    rax_imm(vv)
    emit(252)
    emit(243)
    emit(170)
    # the loop would have left the counter at lim, so code after it
    # still reads lim; rep stosb does not touch rsi, so it still
    # holds lim and one store restores the value
    emit(72)
    emit(137)
    emit(240)
    storev(iv)
    return 1

try_lea_arg ag ai:
    p: look(ag, " - ")
    neg: 1
    if p < 0
        p: look(ag, " + ")
        neg: 0
    if p < 0
        return 0
    nm: strip(cut(ag, 0, p))
    cs: strip(cut(ag, p + 3, length(ag)))
    if plain_name(nm) is 0
        return 0
    if is_imm(cs) is 0
        return 0
    v: _sov_atoi(cs)
    if neg is 1
        v: 0 - v
    if v > 127
        return 0
    if v < 0 - 128
        return 0
    if v is 0
        return 0
    sl: reg_slot(nm)
    if sl < 0
        return 0
    cflush(nm)
    emit_lea_arg(ai, sl, v)
    return 1

try_mem name argc m0 m1 m2 i2 v2:
    if same(name, "poke_byte") is 1
        if argc is 3
            if m0 > 0 - 1
                if m1 > 0 - 1
                    if m2 > 0 - 1
                        mem_poke_byte_reg(m0, m1, m2)
                        return 1
                    if i2 is 1
                        mem_poke_byte_imm(m0, m1, v2)
                        return 1
    if same(name, "peek_byte") is 1
        if argc is 2
            if m0 > 0 - 1
                if m1 > 0 - 1
                    mem_peek_byte(m0, m1)
                    return 1
    return 0

    if same(name, "poke_byte") is 1
        if argc is 3
            if m0 > 0 - 1
                if m1 > 0 - 1
                    if m2 > 0 - 1
                        mem_poke_byte_reg(m0, m1, m2)
                        return 1
                    if i2 is 1
                        mem_poke_byte_imm(m0, m1, v2)
                        return 1
    if same(name, "peek_byte") is 1
        if argc is 2
            if m0 > 0 - 1
                if m1 > 0 - 1
                    mem_peek_byte(m0, m1)
                    return 1
    return 0

# cmp rax with a signed 8-bit or 32-bit immediate

try_opt_while cond blines:
    if _sov_list_len(blines) is not 2
        return 0
    c: strip(cops(cond))
    p: look(c, " < ")
    if p < 0
        return 0
    iv: repl(strip(cut(c, 0, p)), " ", "_")
    lim: repl(strip(cut(c, p + 3, length(c))), " ", "_")
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    # collect_body returns raw lines, so the bump is "iv: iv + 1"
    inc_r: join(iv, ": ")
    inc_b: join(iv, " + 1")
    isinc1: 0
    if starts(l1, inc_r) is 1
        if same(cut(l1, length(inc_r), length(l1)), inc_b) is 1
            isinc1: 1
    isinc2: 0
    if starts(l2, inc_r) is 1
        if same(cut(l2, length(inc_r), length(l2)), inc_b) is 1
            isinc2: 1
    if isinc1 is 0
        if isinc2 is 0
            return 0
    work: l1
    if isinc1 is 1
        work: l2
    tc: look(work, ": ")
    if tc < 0
        return 0
    if tc > 0 - 1
        acc: repl(strip(cut(work, 0, tc)), " ", "_")
        rhs: strip(cut(work, tc + 2, length(work)))
            if lim_const(lim) is 0
                return 0
            if same(rhs, join(join(acc, " + "), iv)) is 1
                emit_sum_closed(acc, iv, lim)
                return 1
            sq_r: join(join(acc, " + "), join(iv, join(" * ", iv)))
            if same(rhs, sq_r) is 1
                emit_sumsq_closed(acc, iv, lim)
                return 1
            # nothing matched: never fall into the emission code
            # below (it assumes acc/rhs shapes it will not get)
            return 0
            pfx: join(acc, " + peek_i64(")
            if starts(rhs, pfx) is 1
                if same(letter(rhs, length(rhs) - 1), ")") is 1
                    inn: cut(rhs, length(pfx), length(rhs) - 1)
                    cm: look(inn, ",")
                    if cm > 0
                        ap: strip(cut(inn, 0, cm))
                        ix: strip(cut(inn, cm + 1, length(inn)))
                        if same(ix, join(iv, " times 8")) is 1
                            if same(ap, iota_ptr) is 1
                                if same(lim, iota_lim) is 1
                                    emit_sum_closed(acc, iv, lim)
                                    return 1
                            loadv(ap)
                            push_rax()
                            loadv(iv)
                            emit(72)
                            emit(193)
                            emit(224)
                            emit(3)
                            mov_rcx_rax()
                            pop_rax()
                            add_rax_rcx()
                            mov_rsi_rax()
                            loadv(lim)
                            push_rax()
                            loadv(iv)
                            mov_rcx_rax()
                            pop_rax()
                            sub_rax_rcx()
                            test_rax()
                            skc: jle()
                            mov_rcx_rax()
                            emit(197)
                            emit(253)
                            emit(239)
                            emit(192)
                            align32()
                            lpc: here()
                            emit(72)
                            emit(131)
                            emit(249)
                            emit(4)
                            tlc: jb()
                            emit(197)
                            emit(254)
                            emit(111)
                            emit(14)
                            emit(197)
                            emit(253)
                            emit(212)
                            emit(193)
                            emit(72)
                            emit(131)
                            emit(198)
                            emit(32)
                            emit(72)
                            emit(131)
                            emit(233)
                            emit(4)
                            jbc: jmp()
                            put(jbc, lpc - (jbc + 4))
                            patch(tlc)
                            emit(196)
                            emit(227)
                            emit(125)
                            emit(57)
                            emit(193)
                            emit(1)
                            emit(197)
                            emit(249)
                            emit(212)
                            emit(193)
                            emit(197)
                            emit(249)
                            emit(112)
                            emit(200)
                            emit(78)
                            emit(197)
                            emit(249)
                            emit(212)
                            emit(193)
                            emit(196)
                            emit(225)
                            emit(249)
                            emit(126)
                            emit(192)
                            emit(72)
                            emit(133)
                            emit(201)
                            dnc: jz()
                            align32()
                            lpt: here()
                            emit(72)
                            emit(3)
                            emit(6)
                            emit(72)
                            emit(131)
                            emit(198)
                            emit(8)
                            emit(72)
                            emit(255)
                            emit(201)
                            emit(15)
                            emit(133)
                            ajt: here()
                            br_at: _sov_list_add(br_at, ajt)
                            br_pv: _sov_list_add(br_pv, pad_ver)
                            br_id: _sov_list_add(br_id, ajt)
                            br_st: _sov_list_add(br_st, 0)
                            emit4(0)
                            put(ajt, lpt - (ajt + 4))
                            patch(dnc)
                            mov_rcx_rax()
                            loadv(acc)
                            add_rax_rcx()
                            storev(acc)
                            emit(197)
                            emit(248)
                            emit(119)
                            loadv(lim)
                            storev(iv)
                            patch(skc)
                            return 1
    if starts(work, "poke_byte(") is 1
        if same(letter(work, length(work) - 1), ")") is 1
            inside: cut(work, 10, length(work) - 1)
            p1: look(inside, ",")
            if p1 > 0
                ptr: strip(cut(inside, 0, p1))
                rest: cut(inside, p1 + 1, length(inside))
                p2: look(rest, ",")
                if p2 > 0
                    ix: strip(cut(rest, 0, p2))
                    bv: strip(cut(rest, p2 + 1, length(rest)))
                    if same(ix, iv) is 1
                        if starts(bv, "peek_byte(") is 1
                            if same(letter(bv, length(bv) - 1), ")") is 1
                                inn: cut(bv, 10, length(bv) - 1)
                                q: look(inn, ",")
                                if q > 0
                                    src: strip(cut(inn, 0, q))
                                    ix2: strip(cut(inn, q + 1, length(inn)))
                                    if same(ix2, iv) is 1
                                        emit_rep_movs(ptr, src, iv, lim)
                                        return 1
                        if digit(letter(bv, 0)) is 1
                            opt_imm: _sov_atoi(bv)
                            emit_rep_stos(ptr, iv, lim)
                            return 1
    if starts(work, "poke_i64(") is 1
        if same(letter(work, length(work) - 1), ")") is 1
            inside: cut(work, 9, length(work) - 1)
            p1: look(inside, ",")
            if p1 > 0
                ptr: strip(cut(inside, 0, p1))
                rest: cut(inside, p1 + 1, length(inside))
                p2: look(rest, ",")
                if p2 > 0
                    ix: strip(cut(rest, 0, p2))
                    vv: strip(cut(rest, p2 + 1, length(rest)))
                    if same(ix, join(iv, " times 8")) is 1
                        if same(vv, iv) is 1
                            iota_ptr: ptr
                            iota_lim: lim
                            if same(lim, kn) is 1
                                if kv > 0
                                    return 1
                            loadv(lim)
                            storev(iv)
                            return 1
    return 0

try_patfill_while cond blines lines li:
    # a periodic pattern fill: iv: 0 and right above the loop,
    #   as long as iv < N
    #       poke_byte(dst, iv, peek_byte(src, iv % P))
    #       iv: iv + 1
    # with N and P compile-time constants becomes ONE guarded
    # unrolled block repeat: the whole dst range is guarded once
    # against the alloc size the same way the fill path does it,
    # then N / P blocks of P bytes copy from src - movdqu pairs
    # where the final window of a block overlaps its own block
    # when P is not a multiple of 16, so every read stays inside
    # [0, P) and every write inside [0, N), no pads and no
    # overshoot - then the N % P remainder the same way. byte
    # pairs take over under 16 bytes. src is read at run time, so
    # whatever code built the pattern is untouched; dst may BE
    # src: at the first block the writes carry the bytes just
    # read, and the sequential loop would read the same values.
    # the loop-back offset is patched from a recorded marker,
    # never hardcoded (pass 32). P is capped at 32768: past that
    # the unrolled code outweighs the win, fall back to scalar.
    if _sov_list_len(blines) is not 2
        return 0
    c: strip(cops(cond))
    p: look(c, " < ")
    if p < 0
        return 0
    iv: repl(strip(cut(c, 0, p)), " ", "_")
    lim: repl(strip(cut(c, p + 3, length(c))), " ", "_")
    if plain_name(iv) is 0
        return 0
    if is_imm(lim) is 0
        return 0
    nn: _sov_atoi(lim)
    if nn < 1
        return 0
    # the statement right above the loop must set the counter to
    # literal nought, same reason as the fill path reads it from
    # the source itself and not from the constant table
    want0: join(iv, ": 0")
    jj: li - 1
    found: 0
    as long as jj >= 0
        pl: strip(_sov_list_get(lines, jj))
        if length(pl) > 0
            if starts(pl, "#") is 0
                if starts(pl, "use ") is 0
                    if same(pl, want0) is 1
                        found: 1
                    jj: 0 - 1
        jj: jj - 1
    if found is 0
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    pb1: "poke_byte("
    fl: blank
    if starts(l1, pb1) is 1
        fl: l1
    if starts(l2, pb1) is 1
        fl: l2
    if length(fl) is 0
        return 0
    inc_r: join(iv, join(": ", join(iv, " + 1")))
    bumped: 0
    if same(l1, inc_r) is 1
        bumped: 1
    if same(l2, inc_r) is 1
        bumped: 1
    if bumped is 0
        return 0
    if same(letter(fl, length(fl) - 1), ")") is 0
        return 0
    inn: cut(fl, 10, length(fl) - 1)
    c1: look(inn, ",")
    if c1 < 0
        return 0
    dstb: repl(strip(cut(inn, 0, c1)), " ", "_")
    rest: cut(inn, c1 + 1, length(inn))
    c2: look(rest, ",")
    if c2 < 0
        return 0
    idx2: repl(strip(cut(rest, 0, c2)), " ", "_")
    if same(idx2, iv) is 0
        return 0
    vvv: strip(cut(rest, c2 + 1, length(rest)))
    # the value must be peek_byte(src, iv % P)
    if starts(vvv, "peek_byte(") is 0
        return 0
    if same(letter(vvv, length(vvv) - 1), ")") is 0
        return 0
    vinn: strip(cut(vvv, 10, length(vvv) - 1))
    c3: look(vinn, ",")
    if c3 < 0
        return 0
    srcb: repl(strip(cut(vinn, 0, c3)), " ", "_")
    midx: strip(cut(vinn, c3 + 1, length(vinn)))
    mpre: join(iv, " % ")
    if starts(midx, mpre) is 0
        return 0
    ptxt: strip(cut(midx, length(mpre), length(midx)))
    if length(ptxt) is 0
        return 0
    if is_imm(ptxt) is 0
        return 0
    pp: _sov_atoi(ptxt)
    if pp < 1
        return 0
    if pp > nn
        return 0
    if pp > 32768
        return 0
    if plain_name(dstb) is 0
        return 0
    if plain_name(srcb) is 0
        return 0
    nb: nn / pp
    rr: nn % pp
    cflush_all()
    # guard both buffers once over the whole touched range, the
    # same contract the fill path runs under: base not null and
    # the range not past the size at [base-8] (no-ops where the
    # mapped-heap runtime ships the checks away)
    loadv(dstb)
    mov_rdi_rax()
    rax_imm(nn)
    mov_rsi_rax()
    chk_mem(1)
    emit(73)
    emit(137)
    emit(249)
    loadv(srcb)
    mov_rdi_rax()
    rax_imm(pp)
    mov_rsi_rax()
    chk_mem(1)
    # rsi = src base, rdi = dst cursor, rcx = block countdown
    emit(72)
    emit(137)
    emit(254)
    emit(76)
    emit(137)
    emit(207)
    emit(185)
    emit4(nb)
    align32()
    lp: here()
    ob: 0
    if pp > 15
        as long as ob + 16 <= pp
            pf_movdqu(ob)
            ob: ob + 16
        if pp % 16 is not 0
            pf_movdqu(pp - 16)
    if not
        as long as ob < pp
            pf_movb(ob)
            ob: ob + 1
    if pp < 128
        emit(72)
        emit(131)
        emit(199)
        emit(pp)
    if not
        emit(72)
        emit(129)
        emit(199)
        emit4(pp)
    emit(72)
    emit(255)
    emit(201)
    emit(15)
    emit(133)
    jb: here()
    br_at: _sov_list_add(br_at, jb)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, jb)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    put(jb, lp - (jb + 4))
    if rr > 15
        ob: 0
        as long as ob + 16 <= rr
            pf_movdqu(ob)
            ob: ob + 16
        if rr % 16 is not 0
            pf_movdqu(rr - 16)
    if not
        if rr > 0
            ob: 0
            as long as ob < rr
                pf_movb(ob)
                ob: ob + 1
    # the scalar loop would have left the counter at nn
    rax_imm(nn)
    storev(iv)
    return 1
sel_a: blank
sel_b: blank
sel_d: blank
sel_c: blank
sel_ka: 0
sel_kb: 0
sel_cc: 0
sel_axx: blank
sel_bxx: blank

try_scaled_mem name argc argl:
    # peek_raw64/poke_raw64 with a register base and a scaled
    # register index: ONE machine op, no multiply, no argument
    # materialization, and - raw contract - no guards either.
    # pass 63: stmt's bare-call fallthrough raises val_dead around
    # its one expr() - taken and cleared HERE, before any argument
    # evaluates, so a nested call still sees the live contract. a
    # poke's value normalisation (mov_rax_rdi) is pure dead store
    # at statement level, so the four tails skip it when tvd is 1.
    tvd: val_dead
    val_dead: 0
    if same(name, "peek_raw64") is 1
        if argc is 2
            q1: _sov_list_get(argl, 0)
            q2: _sov_list_get(argl, 1)
            if name_ok(q1) is 1
                qbs: reg_slot(q1)
                if qbs > 0 - 1
                    qk: raw_scaled(q2)
                    if qk > 0 - 1
                        cflush(q1)
                        emit_rax_scaled(qbs, qk / 4096, qk % 4096 - 128)
                        return 1
    if same(name, "poke_raw64") is 1
        if argc is 3
            q1: _sov_list_get(argl, 0)
            q2: _sov_list_get(argl, 1)
            q3: _sov_list_get(argl, 2)
            if name_ok(q1) is 1
                qbs: reg_slot(q1)
                if qbs > 0 - 1
                    if name_ok(q3) is 1
                        qv: reg_slot(q3)
                        if qv > 0 - 1
                            qk: raw_scaled(q2)
                            if qk > 0 - 1
                                cflush(q1)
                                cflush(q3)
                                emit_scaled_reg(qbs, qk / 4096, qv, qk % 4096 - 128)
                                return 1
                    # wider value forms: every text is parsed before
                    # ANY byte is emitted, so a declined site emits
                    # nothing and the generic path sees a fresh
                    # stream (the poke_i64 rule). scaled target,
                    # value a scaled peek, an abs peek, or a
                    # spilled local: value to rax, one store
                    qk2: raw_scaled(q2)
                    if qk2 > 0 - 1
                        mv2: mem_scaled(q3)
                        if mv2 > 0 - 1
                            mb2: mv2 / 65536
                            mq2: mv2 % 65536
                            cflush(q1)
                            emit_rax_scaled(mb2, mq2 / 4096, mq2 % 4096 - 128)
                            emit_store_scaled_rax(qbs, qk2 / 4096, qk2 % 4096 - 128)
                            return 1
                        ma2: memabs_scaled(q3)
                        if ma2 > 0 - 1
                            mb2: ma2 / 4294967296 - 1
                            mi2: ma2 % 4294967296
                            cflush(q1)
                            emit_rax_abs(mb2, mi2)
                            emit_store_scaled_rax(qbs, qk2 / 4096, qk2 % 4096 - 128)
                            return 1
                        if name_ok(q3) is 1
                            if reg_slot(q3) < 0
                                if idx(locals, q3) > 0 - 1
                                    cflush(q1)
                                    loadv(q3)
                                    emit_store_scaled_rax(qbs, qk2 / 4096, qk2 % 4096 - 128)
                                    return 1
                    # constant target index: one store, no address
                    # walk at all. slot value, or spilled via loadv
                    if is_imm(q2) is 1
                        mi3: _sov_atoi(q2)
                        if mi3 > 0 - 1
                            if mi3 < 2147483648
                                if name_ok(q3) is 1
                                    qv3: reg_slot(q3)
                                    if qv3 > 0 - 1
                                        cflush(q1)
                                        cflush(q3)
                                        emit_store_abs(qbs, qv3, mi3)
                                        return 1
                                    if reg_slot(q3) < 0
                                        if idx(locals, q3) > 0 - 1
                                            cflush(q1)
                                            loadv(q3)
                                            emit_store_abs_rax(qbs, mi3)
                                            return 1
    # peek_i64/poke_i64 with a scaled second value: one guarded
    # memory op, no call, no multiply (the 8 is the scale)
    if same(name, "peek_i64") is 1
        if argc is 2
            a1: _sov_list_get(argl, 0)
            a2: _sov_list_get(argl, 1)
            if name_ok(a1) is 1
                hp: peek_home(a2)
                if hp > 0 - 1
                    loadv_rdi(a1)
                    chk_mem(8)
                    peek_rax_h(hp)
                    return 1
                if scaled_rsi(a2) is 1
                    loadv_rdi(a1)
                    chk_mem(8)
                    emit(72)
                    emit(139)
                    emit(4)
                    emit(247)
                    return 1
    if same(name, "poke_i64") is 1
        if argc is 3
            b1: _sov_list_get(argl, 0)
            b2: _sov_list_get(argl, 1)
            b3: _sov_list_get(argl, 2)
            if name_ok(b1) is 1
                # the index must be known scalable BEFORE the value
                # is evaluated, or a declined site would evaluate its
                # value twice (the caller evaluates again)
                if scaled_shape(b2) is 1
                    # a[i*8]: a[i*8] + T written as a peek-add poke
                    # with the SAME base and index text: T evaluates
                    # first (its clobbers die before rdi/rsi exist),
                    # then one materialisation serves the read and
                    # the store both. mapped-heap only: trap order
                    # between T and the old-value read is unobservable
                    # there; the traps emit nothing.
                    if has_vm is 1
                        if pkacc(b1, b2, b3) is 1
                            # pass 67: T a pure register term (one
                            # or two stars, every atom a register
                            # local) evaluates without touching
                            # rdi or rsi, so base and index build
                            # FIRST and rax rides the store itself -
                            # the mov_rcx staging hop dies.
                            if pure_mul_term(pk_t) is 1
                                loadv_rdi(b1)
                                hp: peek_home(b2)
                                if hp > 0 - 1
                                    expr(pk_t)
                                    accadd_rax_h(hp)
                                    if tvd is 0
                                        mov_rax_rdi()
                                    return 1
                                if scaled_rsi(b2) is 1
                                    expr(pk_t)
                                    emit(72)
                                    emit(1)
                                    emit(4)
                                    emit(247)
                                    if tvd is 0
                                        mov_rax_rdi()
                                    return 1
                            # T rides rcx across the address builds
                            # (both may clobber rax), then one
                            # add-to-memory does the read, the add
                            # and the store: pass 59, row62-verified
                            # (48 01 0C F7 = add [rdi+rsi*8], rcx).
                            expr(pk_t)
                            mov_rcx_rax()
                            loadv_rdi(b1)
                            hp: peek_home(b2)
                            if hp > 0 - 1
                                accadd_rcx_h(hp)
                                if tvd is 0
                                    mov_rax_rdi()
                                return 1
                            if scaled_rsi(b2) is 1
                                emit(72)
                                emit(1)
                                emit(12)
                                emit(247)
                                if tvd is 0
                                    mov_rax_rdi()
                                return 1
                    val_ok: 0
                    if name_ok(b3) is 1
                        if is_imm(b3) is 0
                            loadv(b3)
                            val_ok: 1
                    if is_imm(b3) is 1
                        rax_imm(_sov_atoi(b3))
                        val_ok: 1
                    if val_ok is 0
                        typ: expr(b3)
                        val_ok: 1
                    if val_ok is 1
                        push_rax()
                        loadv_rdi(b1)
                        hp: peek_home(b2)
                        if hp > 0 - 1
                            pop_rax()
                            emit(72)
                            emit(137)
                            emit(194)
                            chk_mem(8)
                            store_rdx_h(hp)
                            if tvd is 0
                                mov_rax_rdi()
                            return 1
                        if scaled_rsi(b2) is 1
                            pop_rax()
                            emit(72)
                            emit(137)
                            emit(194)
                            chk_mem(8)
                            emit(72)
                            emit(137)
                            emit(20)
                            emit(247)
                            if tvd is 0
                                mov_rax_rdi()
                            return 1
                        pop_rax()
    return 0

try_sel_if cond lines li ind:
    # a single-statement select if: "if A < B" (or >) whose whole body
    #	is one deeper line "C: D", no else arm. A and B are plain
    #	non-imm names or scaled peeks; C and D are plain names.
    #	Becomes: A->rcx, B->rsi, D->rdi, C-old->rdx, cmp rcx,rsi,
    #	cmovcc rdx,rdi, mov rax,rdx, storev(C) - no branch at all,
    #	so a data-random pick (the sift child choice) stops paying
    #	mispredicts. Loads of D and C-old are pure, so the trap and
    #	read order equal the branched form exactly.
    nx: li + 1
    if nx > _sov_list_len(lines) - 1
        return 0
    r1: _sov_list_get(lines, nx)
    t1: strip(r1)
    if length(t1) is 0
        return 0
    if starts(t1, "#") is 1
        return 0
    bi1: nind(r1)
    if bi1 < ind + 1
        return 0
    n2: li + 2
    if n2 < _sov_list_len(lines)
        r2: _sov_list_get(lines, n2)
        t2: strip(r2)
        if length(t2) > 0
            if starts(t2, "#") is 0
                if nind(r2) > ind
                    return 0
                if nind(r2) is ind
                    if same(t2, "if not") is 1
                        return 0
                    if starts(t2, "if not ") is 1
                        return 0
    c0: strip(cond)
    sel_cc: 0
    ps: look(c0, " < ")
    if ps < 0
        ps: look(c0, " > ")
        sel_cc: 1
    if ps < 0
        return 0
    av: strip(cut(c0, 0, ps))
    bv: strip(cut(c0, ps + 3, length(c0)))
    ka: sel_val(av)
    if ka < 0
        return 0
    sel_ka: ka
    if ka is 1
        sel_a: pk_g
        sel_axx: pk_x
    if ka is 0
        sel_a: av
    kb: sel_val(bv)
    if kb < 0
        return 0
    sel_kb: kb
    if kb is 1
        sel_b: pk_g
        sel_bxx: pk_x
    if kb is 0
        sel_b: bv
    twin: 0
    if sel_ka is 1
        if sel_kb is 1
            if same(sel_a, sel_b) is 1
                if twin_idx(sel_axx, sel_bxx) is 1
                    twin: 1
    tc: look(t1, ": ")
    if tc < 0
        return 0
    sel_c: strip(cut(t1, 0, tc))
    sel_d: strip(cut(t1, tc + 2, length(t1)))
    if plain_name(sel_c) is 0
        return 0
    # D: a plain name, or "name + lit" / "name - lit" with lit a
    # small immediate (the sift's r: r + 1 shape); c_sv keeps D's
    # name, sel_di the literal, sel_dv 0 plain / 1 add / 0-1 sub
    sel_dn2: sel_d
    sel_di: 0
    sel_dv: 0
    if plain_name(sel_d) is 0
        pd: look(sel_d, " + ")
        pds: 1
        if pd < 0
            pd: look(sel_d, " - ")
            pds: 0 - 1
        if pd < 0
            return 0
        dn2: strip(cut(sel_d, 0, pd))
        di2: strip(cut(sel_d, pd + 3, length(sel_d)))
        if plain_name(dn2) is 0
            return 0
        if is_imm(di2) is 0
            return 0
        if _sov_atoi(di2) > 127
            return 0
        sel_dn2: dn2
        sel_di: _sov_atoi(di2)
        sel_dv: pds
    if is_imm(sel_dn2) is 1
        return 0
    # register-resident twin pick: base and index locals already
    # hold their values, the select target IS the index atom, and
    # D is that atom +/- one imm8. The whole pick folds to 4 ops:
    # mov rcx,left; cmp rcx,right-at-+8; lea rdi,x+di (flag-safe);
    # cmovcc x,rdi - the not-taken case keeps x as-is, which IS the
    # down value because c == x. No scratch copies, no C-old load,
    # no rax round trip. Anything looser takes the general path.
    rt: 0
    rbs: 0 - 1
    rxs: 0 - 1
    if twin is 1
        if sel_dv is not 0
            if same(sel_c, tw_x) is 1
                if same(sel_dn2, tw_x) is 1
                    rbs: reg_slot(sel_a)
                    rxs: reg_slot(tw_x)
                    if rbs > 0 - 1
                        if rxs > 0 - 1
                            rt: 1
    if rt is 1
        cflush_all()
        emit_mov_rcx_scaled(rbs, rxs, 0)
        emit_cmp_rcx_scaled(rbs, rxs, 8)
        if sel_dv is 1
            emit_lea_rdi_xs(rxs, sel_di)
        if sel_dv is 0 - 1
            emit_lea_rdi_xs(rxs, 0 - sel_di)
        emit_cmov_x_rdi(76 + sel_cc * 3, rxs)
        return 1
    cflush_all()
    if twin is 1
        # left in rcx from one base+index build, right compared
        # straight out of memory at the +1 slot (row56 GAS-verified)
        loadv_rdi(sel_a)
        loadv_rsi(tw_x)
        emit(72)
        emit(139)
        emit(12)
        emit(247)
        emit(72)
        emit(131)
        emit(198)
        emit(1)
        emit(72)
        emit(59)
        emit(12)
        emit(247)
    if not
        sel_emit(sel_ka, sel_a, sel_axx)
        mov_rcx_rax()
        sel_emit(sel_kb, sel_b, sel_bxx)
        mov_rsi_rax()
    loadv(sel_dn2)
    mov_rdi_rax()
    if sel_dv is 1
        if sel_di > 0
            # lea, never add: the twin path's mem-compare has
            # already set the flags the cmov reads (row57 lea
            # leaves flags alone, add/sub would clobber them)
            emit(72)
            emit(141)
            emit(120)
            emit(sel_di)
    if sel_dv is 0 - 1
        emit(72)
        emit(141)
        emit(120)
        emit(0 - sel_di % 256)
    loadv_rdx(sel_c)
    if twin is 0
        emit(72)
        emit(57)
        emit(241)
    emit(72)
    emit(15)
    if sel_cc is 0
        emit(76)
    if sel_cc is 1
        emit(79)
    emit(215)
    emit(72)
    emit(137)
    emit(208)
    storev(sel_c)
    return 1

try_slot_forms var rhs:
    # "t: u" and "t: u * 2 + 1" with every name in a register slot:
    # one mov, or (mapped heap only - flags unobservable there) one
    # lea. returns 1 when it emitted. cflush keeps any pending
    # constant honest before a register is read.
    if idx(str_vars, var) > 0 - 1
        return 0 - 1
    ds: reg_slot(var)
    if ds < 0
        return 0 - 1
    if plain_name(rhs) is 1
        if idx(str_vars, rhs) > 0 - 1
            return 0 - 1
        ss: reg_slot(rhs)
        if ss < 0
            return 0 - 1
        cflush(rhs)
        emit_mov_slot(ss, ds)
        return 1
    if has_vm is 0
        return 0 - 1
    pp: look(rhs, " * 2 + 1")
    if pp < 1
        return 0 - 1
    if pp + 8 is not length(rhs)
        return 0 - 1
    u: strip(cut(rhs, 0, pp))
    if plain_name(u) is 0
        return 0 - 1
    if idx(str_vars, u) > 0 - 1
        return 0 - 1
    ss: reg_slot(u)
    if ss < 0
        return 0 - 1
    cflush(u)
    emit_lea_slot2p1(ss, ds)
    return 1

twin_idx xa xb:
    # xa is "r * 8" and xb is "(r + 1) * 8" with the same plain
    # atom r -> 1, tw_x keeps the atom. the child-pick shape: the
    # right peek's address is the left's own index plus one slot,
    # so both loads share one base and one index build.
    if same(cut(xa, length(xa) - 4, length(xa)), " * 8") is 0
        return 0
    ah: strip(cut(xa, 0, length(xa) - 4))
    if plain_name(ah) is 0
        return 0
    if same(cut(xb, length(xb) - 4, length(xb)), " * 8") is 0
        return 0
    bh: strip(cut(xb, 0, length(xb) - 4))
    if same(letter(bh, 0), "(") is 0
        return 0
    if same(letter(bh, length(bh) - 1), ")") is 0
        return 0
    inn: strip(cut(bh, 1, length(bh) - 1))
    pp: look(inn, " + ")
    if pp < 0
        return 0
    l2: strip(cut(inn, 0, pp))
    r2: strip(cut(inn, pp + 3, length(inn)))
    if same(l2, ah) is 0
        return 0
    if same(r2, "1") is 0
        return 0
    tw_x: ah
    return 1

unesc s:
    n: length(s)
    r: _sov_alloc(n + 1)
    j: 0
    i: 0
    as long as i < n
        b: _sov_byte_at(s, i)
        if b is 92
            if i + 1 < n
                nxt: _sov_byte_at(s, i + 1)
                out: nxt
                if nxt is 110
                    out: 10
                if not
                    if nxt is 116
                        out: 9
                    if not
                        if nxt is 114
                            out: 13
                dummy: _sov_set_byte(r, j, out)
                j: j + 1
                i: i + 2
            if not
                dummy: _sov_set_byte(r, j, b)
                j: j + 1
                i: i + 1
        if not
            dummy: _sov_set_byte(r, j, b)
            j: j + 1
            i: i + 1
    dummy: _sov_set_byte(r, j, 0)
    return r

unquote s:
    n: length(s)
    if n < 2
        return s
    if _sov_byte_at(s, 0) is not 34
        return s
    e: n
    if _sov_byte_at(s, n - 1) is 34
        e: n - 1
    return cut(s, 1, e)

use_one name:
    tail: join(name, ".sov")
    path: join("library/", tail)
    r: load_file(path)
    if r is not 0
        return r
    # not in this folder, so look beside the compiler
    path: join(self_dir, join("/library/", tail))
    r: load_file(path)
    if r is not 0
        return r
    # one folder up (compiler in linux/ or windows/ at the root)
    path: join(dirname(self_dir), join("/library/", tail))
    r: load_file(path)
    if r is not 0
        return r
    # two folders up (compiler in compilers/linux or compilers/windows)
    path: join(dirname(dirname(self_dir)), join("/library/", tail))
    return load_file(path)

xor_rax:
    emit(72)
    emit(49)
    emit(192)


# --- pass 3 shared additions ---

align32:
    # pass 114: the pad is gone. loop-head line alignment is a speed
    # buy, not a size one, and no hand-asm floor pays it; every floor
    # program runs its loops unaligned. this was parked behind pass
    # 113 for good reason: with pads live, forward shrinks were
    # stamp-refused, and dropping them lets those compactions run -
    # which strands any hole put() resolves through raw coordinates.
    # with every hole registered and vanish-window fossils killed,
    # the resolver now survives the extra compactions. pad_ver stays
    # put so the forward-shrink stamp check passes trivially.
    return 0

emit_fib_iter:
    # rbx holds the one value (slot 0). a rides rax, b rides rdx,
    # the counter rides rcx (loop), all caller-saved - the frame
    # saves just rbx, not three registers. the same overflow trap
    # fires at the same step the recursion would reach: every add
    # is fib(k-2) + fib(k-1) = fib(k). all bytes GAS-verified.
    # if n <= 1: return n
    emit(72)
    emit(137)
    emit(216)
    emit(72)
    emit(131)
    emit(248)
    emit(1)
    emit(15)
    emit(142)
    j1: here()
    br_at: _sov_list_add(br_at, j1)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, j1)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    # a = 1, b = 0, counter = n: (a, b) <- (b, a + b) n times
    # lands b on fib(n)
    emit(72)
    emit(137)
    emit(217)
    emit(106)
    emit(1)
    emit(88)
    emit(49)
    emit(210)
    lp: here()
    emit(72)
    emit(146)
    emit(72)
    emit(1)
    emit(194)
    chk_ov()
    emit(226)
    emit(lp - (here() + 1))
    emit(72)
    emit(137)
    emit(208)
    dn: here()
    leave()
    ret()
    put(j1, dn - (j1 + 4))

dirname p:
    n: length(p)
    if n is 0
        return "."
    i: n
    as long as i > 0
        i: i - 1
        b: _sov_byte_at(p, i)
        # windows writes paths with a backslash
        if b is 92
            b: 47
        if b is 47
            if i is 0
                return "/"
            return cut(p, 0, i)
    return "."

warn_unused:
    ui: 0
    as long as ui < _sov_list_len(names)
        nm: _sov_list_get(names, ui)
        do_w: 0
        if length(nm) > 0
            if same(nm, "main") is 0
                if starts(nm, "_sov_") is 0
                    # spawn_emit is machine interface: the shared
                    # codegen calls it for any spawn, so every back
                    # end defines it whether or not the source being
                    # compiled has a spawn in it. a back end compiled
                    # from its own source never does, and "never used"
                    # there is not a finding
                    if same(nm, "spawn_emit") is 0
                        if _sov_list_get(task_user, ui) is 1
                            do_w: 1
        if do_w is 1
            if fib_drop is 1
                if same(nm, fib_nm) is 1
                    do_w: 0
        if do_w is 1
            used: 0
            uj: 0
            as long as uj < _sov_list_len(patch_kind)
                pk: _sov_list_get(patch_kind, uj)
                if same(pk, "rel") is 1
                    if same(_sov_list_get(patch_val, uj), nm) is 1
                        used: 1
                if same(pk, "fnaddr") is 1
                    if same(_sov_list_get(patch_val, uj), nm) is 1
                        used: 1
                uj: uj + 1
            if used is 0
                print "Warning: never used"
                _sov_print(nm)
                print _sov_list_get(task_lns, ui)
        ui: ui + 1
# Dead-code elimination. After emission, the flat code stream holds
# every function that was parsed: the whole runtime plus every `use`
# library, whether or not main reaches them. A call graph from the
# "rel"/"fnaddr" patches (which already encode every call edge, direct
# or compiler-internal) marks what main actually reaches, and the
# unreachable functions are spliced out of the stream. fn_offs and
# every patch site are remapped so write_elf sees a self-consistent
# picture. Strings and globals are untouched: only their base offset
# (recomputed in write_elf from the new code length) moves.

dce:
    if had_err is 1
        return
    n: _sov_list_len(fn_names)
    if n < 2
        return
    clen: _sov_list_len(oc)
    # real function entries in emission order (skip the phantom fib)
    dro: _sov_list_new()
    dri: _sov_list_new()
    i: 0
    as long as i < n
        nm: _sov_list_get(fn_names, i)
        ph: 0
        if fib_drop is 1
            if same(nm, fib_nm) is 1
                ph: 1
        if ph is 0
            dro: _sov_list_add(dro, _sov_list_get(fn_offs, i))
            dri: _sov_list_add(dri, i)
        i: i + 1
    nr: _sov_list_len(dro)
    if nr < 2
        return
    first_off: _sov_list_get(dro, 0)
    # pos: fn_names index -> dri index (-1 if phantom)
    dpos: _sov_list_new()
    i: 0
    as long as i < n
        dpos: _sov_list_add(dpos, 0 - 1)
        i: i + 1
    i: 0
    as long as i < nr
        dpos: _sov_list_set(dpos, _sov_list_get(dri, i), i)
        i: i + 1
    # owner for each patch: -1 = the entry stub, else a dri index
    pn: _sov_list_len(patch_at)
    downer: _sov_list_new()
    ff: 0
    pp: 0
    as long as pp < pn
        at: _sov_list_get(patch_at, pp)
        o: 0 - 1
        if at >= first_off
            adv: 1
            as long as adv is 1
                if ff + 1 < nr
                    if at >= _sov_list_get(dro, ff + 1)
                        ff: ff + 1
                    if not
                        adv: 0
                if not
                    adv: 0
            o: ff
        downer: _sov_list_add(downer, o)
        pp: pp + 1
    # reachability from main (and the stub's own call) over rel/fnaddr
    dreach: _sov_list_new()
    i: 0
    as long as i < nr
        dreach: _sov_list_add(dreach, 0)
        i: i + 1
    dadj: _sov_list_new()
    i: 0
    as long as i < nr
        dadj: _sov_list_add(dadj, _sov_list_new())
        i: i + 1
    dtodo: _sov_list_new()
    mi: idx(fn_names, "main")
    if mi < 0
        return
    rj: _sov_list_get(dpos, mi)
    if rj > 0 - 1
        dreach: _sov_list_set(dreach, rj, 1)
        dtodo: _sov_list_add(dtodo, rj)
    pp: 0
    as long as pp < pn
        o: _sov_list_get(downer, pp)
        dk: _sov_list_get(patch_kind, pp)
        iscall: 0
        if same(dk, "rel") is 1
            iscall: 1
        if same(dk, "fnaddr") is 1
            iscall: 1
        if iscall is 1
            val: _sov_list_get(patch_val, pp)
            ti: idx(fn_names, val)
            if ti > 0 - 1
                rj: _sov_list_get(dpos, ti)
                if rj > 0 - 1
                    if o is 0 - 1
                        if _sov_list_get(dreach, rj) is 0
                            dreach: _sov_list_set(dreach, rj, 1)
                            dtodo: _sov_list_add(dtodo, rj)
                    if not
                        dadj: _sov_list_set(dadj, o, _sov_list_add(_sov_list_get(dadj, o), rj))
        pp: pp + 1
    dhead: 0
    as long as dhead < _sov_list_len(dtodo)
        u: _sov_list_get(dtodo, dhead)
        dhead: dhead + 1
        nbl: _sov_list_get(dadj, u)
        j: 0
        as long as j < _sov_list_len(nbl)
            v: _sov_list_get(nbl, j)
            if _sov_list_get(dreach, v) is 0
                dreach: _sov_list_set(dreach, v, 1)
                dtodo: _sov_list_add(dtodo, v)
            j: j + 1
    kept: 0
    i: 0
    as long as i < nr
        if _sov_list_get(dreach, i) is 1
            kept: kept + 1
        i: i + 1
    if kept is nr
        return
    # rebuild: stub, then kept functions in order, then remap patches
    noc: _sov_list_new()
    i: 0
    as long as i < first_off
        noc: _sov_list_add(noc, _sov_list_get(oc, i))
        i: i + 1
    nfn_names: _sov_list_new()
    nfn_offs: _sov_list_new()
    dshift: _sov_list_new()
    i: 0
    as long as i < nr
        dshift: _sov_list_add(dshift, 0)
        i: i + 1
    cum: first_off
    i: 0
    as long as i < nr
        if _sov_list_get(dreach, i) is 1
            s: _sov_list_get(dro, i)
            e: clen
            if i + 1 < nr
                e: _sov_list_get(dro, i + 1)
            j: s
            as long as j < e
                noc: _sov_list_add(noc, _sov_list_get(oc, j))
                j: j + 1
            nfn_names: _sov_list_add(nfn_names, _sov_list_get(fn_names, _sov_list_get(dri, i)))
            nfn_offs: _sov_list_add(nfn_offs, cum)
            dshift: _sov_list_set(dshift, i, cum - s)
            cum: cum + (e - s)
        i: i + 1
    npat_at: _sov_list_new()
    npat_kind: _sov_list_new()
    npat_val: _sov_list_new()
    npat_line: _sov_list_new()
    pp: 0
    as long as pp < pn
        o: _sov_list_get(downer, pp)
        keep: 0
        ns: _sov_list_get(patch_at, pp)
        if o is 0 - 1
            keep: 1
        if not
            if _sov_list_get(dreach, o) is 1
                keep: 1
                ns: ns + _sov_list_get(dshift, o)
        if keep is 1
            npat_at: _sov_list_add(npat_at, ns)
            npat_kind: _sov_list_add(npat_kind, _sov_list_get(patch_kind, pp))
            npat_val: _sov_list_add(npat_val, _sov_list_get(patch_val, pp))
            npat_line: _sov_list_add(npat_line, _sov_list_get(patch_line, pp))
        pp: pp + 1
    oc: noc
    fn_names: nfn_names
    fn_offs: nfn_offs
    patch_at: npat_at
    patch_kind: npat_kind
    patch_val: npat_val
    patch_line: npat_line
# Pass 104b: when want_args was set only because the linked runtime
# mentions g_argc, and dce has since removed every reader, the stub's
# argv stores are dead. A reader is a reference OUTSIDE the stub's own
# block (the block's two store patches are the writes themselves -
# counting them vetoed the splice for every program and the pass never
# fired; the P104 reorder also stopped feeding rdi/rsi to a param
# main, which only survived because the veto made it dead code).
# The register setup survives when main takes parameters (copyargs
# reads rdi/rsi); otherwise it goes with the stores.

# mov rcx, rdx - a count for rep, which counts in rcx
mov_rcx_rdx:
    emit(72)
    emit(137)
    emit(209)

# x += e  becomes  x: x + e, so the rest of the compiler only ever
# sees one form of assignment. Text is skipped so "a=b" inside a
# literal is left alone, and == != <= >= are not operators we fold.
compound s:
    i: 0
    n: length(s)
    intext: 0
    as long as i + 1 < n
        c: _sov_byte_at(s, i)
        if c is 34
            if intext is 0
                intext: 1
            if not
                intext: 0
        if intext is 0
            if _sov_byte_at(s, i + 1) is 61
                op: 0
                if c is 43
                    op: 1
                if c is 45
                    op: 1
                if c is 42
                    op: 1
                if c is 47
                    op: 1
                if c is 38
                    op: 1
                if c is 124
                    op: 1
                if c is 94
                    op: 1
                if op is 1
                    lhs: strip(cut(s, 0, i))
                    rhs: strip(cut(s, i + 2, n))
                    if length(lhs) > 0
                        if length(rhs) > 0
                            return join(join(lhs, ": "), join(join(lhs, " "), join(join(cut(s, i, i + 1), " "), rhs)))
        i: i + 1
    return s

# moved up from the three x86 back ends: linux, macos and windows each
# carried their own copy of these, and the copies had drifted only by
# lines one of them was missing. one definition here, all three use it
do_print_one arg:
    if length(arg) > 1
        if _sov_byte_at(arg, 0) is 34
            if same(letter(arg, length(arg) - 1), "\"") is 1
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
    typ: expr(arg)
    mov_rdi_rax()
    if typ is 1
        used_pr: 1
        calln("_sov_print")
    if not
        used_pi: 1
        calln("_sov_print_int")
    if br_depth is 0
        rax_small: 1
do_print_times what nstr:
    if idx(glob_names, "__pt_c") is 0 - 1
        glob_names: _sov_list_add(glob_names, "__pt_c")
        glob_names: _sov_list_add(glob_names, "__pt_i")
    expr(nstr)
    storev("__pt_c")
    xor_rax()
    storev("__pt_i")
    align32()
    st: here()
    loadv("__pt_i")
    push_rax()
    loadv("__pt_c")
    mov_rcx_rax()
    pop_rax()
    cmp_rax_rcx()
    setcc("lt")
    test_rax()
    z: jz()
    do_print_one(what)
    inc_var("__pt_i")
    jb: jmp()
    put(jb, st - (jb + 4))
    patch(z)
emit_sumsq_closed acc iv lim:
    # sum of iv*iv for iv in 0..lim-1 = n(n-1)(2n-1)/6, taken mod
    # 2^64 exactly like the loop's wrapping accumulate. fires only
    # for a constant lim below 2^31: then i*i never overflows a
    # signed 64-bit (no trap difference), the exact value fits in
    # 93 bits, and the two-limb mul below lands the low 64 bits.
    limn: 0
    if same(lim, kn) is 1
        if kv > 0
            limn: kv
    if limn is 0
        if length(lim) > 0
            if digit(letter(lim, 0)) is 1
                if look(lim, " ") < 0
                    limn: _sov_atoi(lim)
    if limn < 1
        return
    if limn > 2147483647
        return
    nn: limn
    cc: nn * 2 - 1
    e: nn * nn - nn
    e: e / 2
    # exactly one of nn, nn - 1, cc is a multiple of three; pull
    # the /3 out of whichever it is, keeping every step exact
    g: e
    h: cc
    if cc % 3 is 0
        h: cc / 3
    if not
        if nn % 3 is 0
            g: e / 3
        if not
            g: e / 3
            h: cc
    # (3 and 2 are coprime, so e carries the 3 whenever 3 divides
    # n or n-1; every step above stays exact)
    gl: g % 4294967296
    gh: g / 4294967296
    total: gl * h
    hi: gh * h
    hi: hi % 4294967296
    hi: hi * 4294967296
    total: total + hi
    # pass 106: register the folded value instead of emitting it - a
    # print of the accumulator folds to a literal write, and an
    # accumulator nobody reads costs nothing at all
    cset(acc, total)
    rax_imm(limn)
    storev(iv)
    kn: acc
    kv: total
    return
emit_sum_closed acc iv lim:
    limn: 0
    if same(lim, kn) is 1
        if kv > 0
            limn: kv
    if limn is 0
        if length(lim) > 0
            if digit(letter(lim, 0)) is 1
                if look(lim, " ") < 0
                    limn: _sov_atoi(lim)
    if limn > 0
        if limn < 2147483648
            total: limn * limn - limn
            total: total / 2
            rax_imm(total)
        storev(acc)
        rax_imm(limn)
        storev(iv)
        kn: acc
        kv: total
        return
    emit_name_or_imm(lim)
    push_rax()
    loadv(iv)
    mov_rcx_rax()
    pop_rax()
    sub_rax_rcx()
    test_rax()
    sk: jle()
    push_rax()
    loadv(iv)
    push_rax()
    emit_name_or_imm(lim)
    mov_rcx_rax()
    pop_rax()
    add_rax_rcx()
    emit(72)
    emit(255)
    emit(200)
    pop_rcx()
    imul_rax_rcx()
    emit(72)
    emit(209)
    emit(232)
    mov_rcx_rax()
    loadv(acc)
    add_rax_rcx()
    storev(acc)
    emit_name_or_imm(lim)
    storev(iv)
    patch(sk)
tparams line:
    lst: _sov_list_new()
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            s: strip(cut(s, wp + 6, length(s)))
        if not
            sp: look(s, " ")
            if sp < 0
                return lst
            s: strip(cut(s, sp + 1, length(s)))
        p: repl(s, ",", " ")
        p: repl(p, " and ", " ")
        start: 0
        i: 0
        n: length(p)
        as long as i < n
            if same(letter(p, i), " ") is 1
                one: strip(cut(p, start, i))
                if length(one) > 0
                    lst: _sov_list_add(lst, one)
                start: i + 1
            i: i + 1
        one: strip(cut(p, start, n))
        if length(one) > 0
            lst: _sov_list_add(lst, one)
        return lst
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp < 0
        return lst
    p: repl(cut(rest, wp + 6, length(rest)), ",", " and ")
    start: 0
    i: 0
    n: length(p)
    as long as i < n
        if starts(cut(p, i, n), " and ") is 1
            one: repl(strip(cut(p, start, i)), " ", "_")
            if length(one) > 0
                lst: _sov_list_add(lst, one)
            start: i + 5
            i: i + 5
        if not
            i: i + 1
    one: repl(strip(cut(p, start, n)), " ", "_")
    if length(one) > 0
        lst: _sov_list_add(lst, one)
    return lst
prep_main names params bodies:
    thin_main: 0
    skip_al: blank
    fib_nm: blank
    fib_drop: 0
    fi: 0
    as long as fi < _sov_list_len(names)
        if same(_sov_list_get(names, fi), "main") is 1
            if _sov_list_len(_sov_list_get(params, fi)) is 0
                thin_main: 1
            main_params_n: _sov_list_len(_sov_list_get(params, fi))
            skip_al: dead_iota(_sov_list_get(bodies, fi))
        if fiblike(_sov_list_get(names, fi), _sov_list_get(params, fi), _sov_list_get(bodies, fi)) is 1
            fib_nm: _sov_list_get(names, fi)
        fi: fi + 1
    # fold + drop the recognized fib when every call outside its own
    # body passes a literal constant (or it is never called at all).
    # a non-constant call, or an addr_of take, keeps the body.
    if length(fib_nm) > 0
        fib_drop: 1
        fi: 0
        as long as fi < _sov_list_len(names)
            if same(_sov_list_get(names, fi), fib_nm) is 0
                bln: _sov_list_get(bodies, fi)
                bi: 0
                as long as bi < _sov_list_len(bln)
                    if fib_call_var(_sov_list_get(bln, bi), fib_nm) is 1
                        fib_drop: 0
                    if look(_sov_list_get(bln, bi), join("addr_of ", fib_nm)) > 0 - 1
                        fib_drop: 0
                    bi: bi + 1
            fi: fi + 1
    if fib_drop is 1
        fn_names: _sov_list_add(fn_names, fib_nm)
        fn_offs: _sov_list_add(fn_offs, 0)
poke8 p off v:
    x: v
    i: 0
    as long as i < 8
        b: x % 256
        if b < 0
            b: b + 256
        dummy: _sov_set_byte(p, off + i, b)
        x: x / 256
        i: i + 1
