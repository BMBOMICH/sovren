emit_sys_exit:
    m: this_is_mac()
    if m is 1
        rax_mac(60)
        sysc_raw
        return 0
    put_in_program(184)
    put_4_bytes(60)
    ask_kernel
    return 0

emit_sys_num n:
    m: this_is_mac()
    if m is 1
        rax_mac(n)
        return 0
    if not
        rax_imm(n)
        return 0

emit_sys_do:
    m: this_is_mac()
    if m is 1
        sysc_raw
        return 0
    if not
        ask_kernel
        return 0

