# cx86.sov — the shared x86-64 compiler core.
#
# pulled verbatim from the three x86 back ends: every task
# here is byte-identical across linux, macos and windows.
# the per-OS files keep their writers, syscall numbers and
# image formats, and define the constants these tasks read.
use mem
use file
use string
use num
use bit32

accadd_rax_h h:
    # add [rdi + h*8], rax - pass 67's accumulate-poke when T is
    # a pure register term and rax may ride the store directly.
    # row68 GAS-verified for every home and the legacy rsi form.
    put_in_program(rexx(h))
    bytes:
        1
        4
    put_in_program(sibx(h))
    return 0

accadd_rcx_h h:
    # add [rdi + h*8], rcx - the accumulate-poke with the index at home
    put_in_program(rexx(h))
    bytes:
        1
        12
    put_in_program(sibx(h))
    return 0

add_imm dest n:
    # pass 109: a register (or frame) local taking a small constant
    # step adds it straight in place - no loadv, no movabs staging
    # in rcx, no storev. n == 1 rides the 3-byte inc form.
    asl: idx(local_names, dest)
    if asl > 0 - 1
        if n >= 0 - 128
            if n < 128
                if asl < 5
                    cflush(dest)
                    arx: 72
                    if asl > 0
                        arx: 73
                    if n is 1
                        put_in_program(arx)
                        put_in_program(255)
                        put_in_program(195 + asl)
                        return
                    put_in_program(arx)
                    put_in_program(131)
                    put_in_program(195 + asl)
                    put_in_program(n)
                    return
                if leaf8 is 1
                    cflush(dest)
                    if n is 1
                        bytes:
                            73
                            255
                        put_in_program(192 + asl - 5)
                        return
                    bytes:
                        73
                        131
                    put_in_program(192 + asl - 5)
                    put_in_program(n)
                    return
                of: loc_off(asl)
                # spilled: only a disp8 in range rides the fast path;
                # a deeper slot keeps the generic loadv/storev walk
                if of >= 0 - 128
                    cflush(dest)
                    if n is 1
                        # FF /0 (modrm 69) is inc [rbp+disp]; 77 is dec
                        bytes:
                            72
                            255
                            69
                        put_in_program(of)
                        return
                    bytes:
                        72
                        131
                        69
                    put_in_program(of)
                    put_in_program(n)
                    return
    loadv(dest)
    bytes:
        72
        185
    put_8_bytes(n)
    add_rax_rcx
    storev(dest)

add_into dest src:
    sd: reg_slot(src)
    if sd > 0 - 1
        dd: reg_slot(dest)
        if dd > 0 - 1
            cflush(dest)
            cflush(src)
            emit_addsub_slot(dd, sd, 0)
            return
    loadv(src)
    sl: idx(local_names, dest)
    if sl is 0
        bytes:
            72
            1
            195
        return
    if sl is 1
        bytes:
            73
            1
            196
        return
    if sl is 2
        bytes:
            73
            1
            197
        return
    if sl is 3
        bytes:
            73
            1
            198
        return
    if sl is 4
        bytes:
            73
            1
            199
        return
    mov_rcx_rax
    loadv(dest)
    add_rax_rcx
    storev(dest)

add_rax_mem sl:
    # scratch-class local_names (leaf8 tasks) take a one-instruction add
    if leaf8 is 1
        if sl is 5
            bytes:
                73
                1
                192
            return
        if sl is 6
            bytes:
                73
                1
                193
            return
        if sl is 7
            bytes:
                73
                1
                194
            return
        if sl is 8
            bytes:
                73
                1
                195
            return
    # "var: var + <rax>" with var a spilled local: one read/modify/
    # write add against the frame slot instead of loadv + add +
    # storev. sl is the local_names index, always past the five register
    # local_names here, so loc_off(sl) never comes out 0 and the modrm
    # byte belongs to rbp. GAS-verified.
    of: loc_off(sl)
    bytes:
        72
        1
    if of > 0 - 129
        put_in_program(69)
        put_in_program(of)
        return
    put_in_program(133)
    put_4_bytes(of)
    return

add_rax_rcx:
    bytes:
        72
        1
        200

add_rax_reg sl:
    put_in_program(op_rex_r(sl))
    put_in_program(1)
    put_in_program(192 + op_low3(sl) * 8)
    return 0

add_rax_slot sl:
    if sl is 0
        bytes:
            72
            1
            195
        return 0
    if sl is 1
        bytes:
            73
            1
            196
        return 0
    if sl is 2
        bytes:
            73
            1
            197
        return 0
    if sl is 3
        bytes:
            73
            1
            198
        return 0
    if sl is 4
        bytes:
            73
            1
            199
        return 0
    return 0 - 1
# sub rax from a register local, no store needed afterwards

later_fill at kind val:
    patch_at: _sov_list_add(patch_at, at)
    patch_kind: _sov_list_add(patch_kind, kind)
    patch_value: _sov_list_add(patch_value, val)
    patch_line: _sov_list_add(patch_line, error_line)

holds text piece:
    if look(text, piece) > 0 - 1
        return 1
    return 0

uses_runtime src:
    if holds(src, "_sov_list") is 1
        return 1
    if holds(src, "load_file") is 1
        return 1
    if holds(src, "_sov_buf") is 1
        return 1
    if holds(src, "_sov_alloc") is 1
        return 1
    if holds(src, "_sov_set_byte") is 1
        return 1
    if holds(src, "peek_byte") is 1
        return 1
    if holds(src, "poke_byte") is 1
        return 1
    if holds(src, "spawn ") is 1
        return 1
    if holds(src, "join ") is 1
        return 1
    return 0


arith_imm op v:
    if v >= 2147483648
        return 0 - 1
    if v < 0 - 2147483648
        return 0 - 1
    if same(op, "div") is 1
        # idiv-free x/2^k: sign mask, round-up add, arithmetic shift.
        # (x + (x >>> 63 unsigned-shifted 64-k)) >>> k arithmetic
        # equals idiv x, 2^k for every 64-bit x incl INT64_MIN;
        # division by 2^k can never overflow (that trap is x/-1's).
        # rows GAS-verified (bs row53 + row55).
        if v is 1
            return 0
        if v < 2
            return 0 - 1
        k: 0
        q: v
        as long as q > 1
            if q % 2 is 1
                return 0 - 1
            q: q / 2
            k: k + 1
        bytes:
            72
            137
            194
            72
            193
            250
            63
            72
            193
            234
        put_in_program(64 - k)
        bytes:
            72
            1
            208
            72
            193
            248
        put_in_program(k)
        return 0
    if same(op, "mul") is 1
        if v is 2
            # add rax, rax - the OF-exact twin of imul-by-2: same
            # bits, same overflow flag, so chk_ov still traps
            # exactly where imul would. one byte shorter, 3x less
            # latency on loop-carried chains. GAS-verified.
            bytes:
                72
                1
                192
            return 0
        if needs_heap is 1
            # chk_ov emits nothing with the mapped heap, so no one
            # can observe flags: flag-free lea/shl forms are legal.
            if v is 3
                bytes:
                    72
                    141
                    4
                    64
                return 0
            if v is 5
                bytes:
                    72
                    141
                    4
                    128
                return 0
            if v is 9
                bytes:
                    72
                    141
                    4
                    192
                return 0
            if v is 4
                bytes:
                    72
                    193
                    224
                    2
                return 0
            if v is 8
                bytes:
                    72
                    193
                    224
                    3
                return 0
            if v is 16
                bytes:
                    72
                    193
                    224
                    4
                return 0
            if v is 32
                bytes:
                    72
                    193
                    224
                    5
                return 0
    if v >= 0 - 128
        if v < 128
            if same(op, "add") is 1
                bytes:
                    72
                    131
                    192
                put_in_program(v % 256)
            if same(op, "sub") is 1
                bytes:
                    72
                    131
                    232
                put_in_program(v % 256)
            if same(op, "mul") is 1
                bytes:
                    72
                    107
                    192
                put_in_program(v % 256)
            return 0
    if same(op, "add") is 1
        bytes:
            72
            5
        put_4_bytes(v)
    if same(op, "sub") is 1
        bytes:
            72
            45
        put_4_bytes(v)
    if same(op, "mul") is 1
        bytes:
            72
            105
            192
        put_4_bytes(v)
    return 0

# is this expression one plain name (letters, digits, underscore)?

bin_regop op sl:
    # a binop whose right side already sits in slot sl: op rax,
    # r_slot with exactly the trap contract emit_op keeps for the
    # rcx form - no staging, no stack.
    if same(op, "add") is 1
        add_rax_reg(sl)
        chk_ov
        return 0
    if same(op, "sub") is 1
        sub_rax_reg(sl)
        chk_ov
        return 0
    if same(op, "mul") is 1
        imul_rax_reg(sl)
        chk_ov
        return 0
    if same(op, "div") is 1
        chk_zreg(sl)
        bytes:
            72
            153
        idiv_reg(sl)
        return 0
    if same(op, "mod") is 1
        chk_zreg(sl)
        bytes:
            72
            153
        idiv_reg(sl)
        bytes:
            72
            146
        return 0
    cmp_rax_reg(sl)
    setcc(op)
    return 0
# a plain name that lives in a register right now: its slot, or
# 0 - 1. slots 5-8 count only under leaf8, when they really are
# r8-r11; every other fused arm keeps the reg_slot contract (< 5).

bin_rslot name:
    rs: reg_slot(name)
    if rs > 0 - 1
        return rs
    if leaf8 is 1
        bsl: idx(local_names, name)
        if bsl > 4
            if bsl < 9
                return bsl
    return 0 - 1

# the fused jump for a comparison: inv 1 jumps when false

br_relax at n:
    if at < 2
        return 0
    self: 0 - 1
    busy: 0
    i: 0
    as long as i < _sov_list_len(jump_at)
        e: _sov_list_get(jump_at, i)
        if e is at
            if _sov_list_get(jump_state, i) is not 4
                self: i
        if _sov_list_get(jump_state, i) is 0
            if e > at
                if e <= here()
                    busy: 1
        i: i + 1
    if self > 0 - 1
        jump_state: _sov_list_set(jump_state, self, 1)
    o1: _sov_list_get(code, at - 2)
    o2: _sov_list_get(code, at - 1)
    shrink: 0
    back: 0
    if o2 is 233
        shrink: 3
        back: 3
    if o1 is 15
        if o2 >= 128
            if o2 <= 143
                shrink: 4
                back: 4
    if shrink is 0
        return 0
    if busy is 1
        return 0
    rel8: n
    if n < 0
        rel8: n + back
    if rel8 < 0 - 128
        return 0
    if rel8 > 127
        return 0
    if n > 0
        if self < 0
            return 0
        if _sov_list_get(jump_pad, self) is not pad_version
            return 0
    b: rel8
    if b < 0
        b: b + 256
    if o2 is 233
        code: _sov_list_set(code, at - 1, 235)
        code: _sov_list_set(code, at, b)
    if not
        code: _sov_list_set(code, at - 2, o2 - 16)
        code: _sov_list_set(code, at - 1, b)
    d: at + 4 - shrink
    i: 0
    as long as i < _sov_list_len(jump_at)
        if i is not self
            rst: _sov_list_get(jump_state, i)
            if rst is 4
                rst: 0
            if rst > 0
                e: _sov_list_get(jump_at, i)
                nb: e + 4
                ep: e
                if rst is 2
                    nb: e
                    ep: e - 1
                if rst is 3
                    nb: e + 1
                dv: _sov_list_get(code, ep)
                if rst is 1
                    dv: dv + _sov_list_get(code, e + 1) * 256 + _sov_list_get(code, e + 2) * 65536 + _sov_list_get(code, e + 3) * 16777216
                    if dv >= 2147483648
                        dv: dv - 4294967296
                if rst > 1
                    if dv >= 128
                        dv: dv - 256
                tg: nb + dv
                nn: nb
                if tg >= d
                    tg: tg - shrink
                if nn >= d
                    nn: nn - shrink
                ndv: tg - nn
                if rst is 1
                    v: ndv
                    if v < 0
                        v: v + 4294967296
                    k: 0
                    as long as k < 4
                        code: _sov_list_set(code, e + k, v % 256)
                        v: v / 256
                        k: k + 1
                if rst > 1
                    if ndv < 0
                        ndv: ndv + 256
                    code: _sov_list_set(code, ep, ndv)
        i: i + 1
    ln: here() - (at + 4)
    i: 0
    as long as i < ln
        code: _sov_list_set(code, at + 4 - shrink + i, _sov_list_get(code, at + 4 + i))
        i: i + 1
    poke_i64(code, 8, here() - shrink)
    # pass 113: the vanished bytes under [d, d + shrink) delete any
    # other site whose four-byte hole reaches into that window. such a
    # site is dead - a later re-resolve would rewrite whatever live
    # code sits at its stale offset (the self-compile jne that kept a
    # zero disp while its intended bytes landed six late). this scan
    # runs on pre-move positions, where a hole [e, e+4) overlapping
    # [d, d+shrink) is exactly e in (d-4, d+shrink); after the move
    # loop the moved-dead and the untouched-alive are indistinguishable
    # at d-4. mark them dead: put, br_relax and dce_litter skip st 4.
    i: 0
    as long as i < _sov_list_len(jump_at)
        if i is not self
            e: _sov_list_get(jump_at, i)
            if e > d - 4
                if e < d + shrink
                    if _sov_list_get(jump_state, i) is not 4
                        jump_state: _sov_list_set(jump_state, i, 4)
        i: i + 1
    i: 0
    as long as i < _sov_list_len(jump_at)
        if i is not self
            if _sov_list_get(jump_state, i) > 0
                e: _sov_list_get(jump_at, i)
                if e >= d
                    jump_at: _sov_list_set(jump_at, i, e - shrink)
        i: i + 1
    i: 0
    pa: at + 4
    as long as i < _sov_list_len(patch_at)
        e: _sov_list_get(patch_at, i)
        if e >= pa
            patch_at: _sov_list_set(patch_at, i, e - shrink)
        i: i + 1
    if self > 0 - 1
        if o2 is 233
            jump_state: _sov_list_set(jump_state, self, 3)
        if not
            jump_state: _sov_list_set(jump_state, self, 2)
    return 1

call name:
    cflush_globs
    put_in_program(232)
    at: here()
    put_4_bytes(0)
    later_fill(at, "rel", name)

prolog:
    if skip_frame is 1
        # every local lives in a callee-saved register, so the rbp
        # frame is pure overhead. no pad: callee entry rsp is 8 mod
        # 16, so an ODD number of pushes leaves rsp 16-aligned for
        # the calls inside, and an even number is fine too because
        # nothing in a Sovren program needs 16-byte alignment (the
        # cfunc path aligns itself with and rsp, -16).
        if saved_locals > 0
            put_in_program(83)
        if saved_locals > 1
            bytes:
                65
                84
        if saved_locals > 2
            bytes:
                65
                85
        if saved_locals > 3
            bytes:
                65
                86
        if saved_locals > 4
            bytes:
                65
                87
        return 0
    bytes:
        85
        72
        137
        229
    # pushes go lowest slot first: rbx lands at rbp-8, r12 at
    # rbp-16 and so on, which is where leave reads them back
    if saved_locals > 0
        put_in_program(83)
    if saved_locals > 1
        bytes:
            65
            84
    if saved_locals > 2
        bytes:
            65
            85
    if saved_locals > 3
        bytes:
            65
            86
    if saved_locals > 4
        bytes:
            65
            87
    bytes:
        72
        129
        236
    frame_at: here()
    jump_at: _sov_list_add(jump_at, frame_at)
    jump_pad: _sov_list_add(jump_pad, pad_version)
    jump_id: _sov_list_add(jump_id, frame_at)
    jump_state: _sov_list_add(jump_state, 0)
    put_4_bytes(512)
    return 0

