# cx86.sov — the shared x86-64 compiler core.
#
# pulled verbatim from the three x86 back ends: every task
# here is byte-identical across linux, macos and windows.
# the per-OS files keep their writers, syscall numbers and
# image formats, and define the constants these tasks read.
use mem
use file
use string
use num
use bit32

accadd_rax_h h:
    # add [rdi + h*8], rax - pass 67's accumulate-poke when T is
    # a pure register term and rax may ride the store directly.
    # row68 GAS-verified for every home and the legacy rsi form.
    emit(rexx(h))
    emit(1)
    emit(4)
    emit(sibx(h))
    return 0

accadd_rcx_h h:
    # add [rdi + h*8], rcx - the accumulate-poke with the index at home
    emit(rexx(h))
    emit(1)
    emit(12)
    emit(sibx(h))
    return 0

add_imm dest n:
    # pass 109: a register (or frame) local taking a small constant
    # step adds it straight in place - no loadv, no movabs staging
    # in rcx, no storev. n == 1 rides the 3-byte inc form.
    asl: idx(locals, dest)
    if asl > 0 - 1
        if n >= 0 - 128
            if n < 128
                if asl < 5
                    cflush(dest)
                    arx: 72
                    if asl > 0
                        arx: 73
                    if n is 1
                        emit(arx)
                        emit(255)
                        emit(195 + asl)
                        return
                    emit(arx)
                    emit(131)
                    emit(195 + asl)
                    emit(n)
                    return
                if leaf8 is 1
                    cflush(dest)
                    if n is 1
                        emit(73)
                        emit(255)
                        emit(192 + asl - 5)
                        return
                    emit(73)
                    emit(131)
                    emit(192 + asl - 5)
                    emit(n)
                    return
                of: loc_off(asl)
                # spilled: only a disp8 in range rides the fast path;
                # a deeper slot keeps the generic loadv/storev walk
                if of >= 0 - 128
                    cflush(dest)
                    if n is 1
                        # FF /0 (modrm 69) is inc [rbp+disp]; 77 is dec
                        emit(72)
                        emit(255)
                        emit(69)
                        emit(of)
                        return
                    emit(72)
                    emit(131)
                    emit(69)
                    emit(of)
                    emit(n)
                    return
    loadv(dest)
    emit(72)
    emit(185)
    emit8(n)
    add_rax_rcx()
    storev(dest)

add_into dest src:
    sd: reg_slot(src)
    if sd > 0 - 1
        dd: reg_slot(dest)
        if dd > 0 - 1
            cflush(dest)
            cflush(src)
            emit_addsub_slot(dd, sd, 0)
            return
    loadv(src)
    sl: idx(locals, dest)
    if sl is 0
        emit(72)
        emit(1)
        emit(195)
        return
    if sl is 1
        emit(73)
        emit(1)
        emit(196)
        return
    if sl is 2
        emit(73)
        emit(1)
        emit(197)
        return
    if sl is 3
        emit(73)
        emit(1)
        emit(198)
        return
    if sl is 4
        emit(73)
        emit(1)
        emit(199)
        return
    mov_rcx_rax()
    loadv(dest)
    add_rax_rcx()
    storev(dest)

add_rax_mem sl:
    # scratch-class locals (leaf8 tasks) take a one-instruction add
    if leaf8 is 1
        if sl is 5
            emit(73)
            emit(1)
            emit(192)
            return
        if sl is 6
            emit(73)
            emit(1)
            emit(193)
            return
        if sl is 7
            emit(73)
            emit(1)
            emit(194)
            return
        if sl is 8
            emit(73)
            emit(1)
            emit(195)
            return
    # "var: var + <rax>" with var a spilled local: one read/modify/
    # write add against the frame slot instead of loadv + add +
    # storev. sl is the locals index, always past the five register
    # locals here, so loc_off(sl) never comes out 0 and the modrm
    # byte belongs to rbp. GAS-verified.
    of: loc_off(sl)
    emit(72)
    emit(1)
    if of > 0 - 129
        emit(69)
        emit(of)
        return
    emit(133)
    emit4(of)
    return

add_rax_rcx:
    emit(72)
    emit(1)
    emit(200)

add_rax_reg sl:
    emit(op_rex_r(sl))
    emit(1)
    emit(192 + op_low3(sl) * 8)
    return 0

add_rax_slot sl:
    if sl is 0
        emit(72)
        emit(1)
        emit(195)
        return 0
    if sl is 1
        emit(73)
        emit(1)
        emit(196)
        return 0
    if sl is 2
        emit(73)
        emit(1)
        emit(197)
        return 0
    if sl is 3
        emit(73)
        emit(1)
        emit(198)
        return 0
    if sl is 4
        emit(73)
        emit(1)
        emit(199)
        return 0
    return 0 - 1
# sub rax from a register local, no store needed afterwards

addp at kind val:
    patch_at: _sov_list_add(patch_at, at)
    patch_kind: _sov_list_add(patch_kind, kind)
    patch_val: _sov_list_add(patch_val, val)
    patch_line: _sov_list_add(patch_line, err_line)

arith_imm op v:
    if v >= 2147483648
        return 0 - 1
    if v < 0 - 2147483648
        return 0 - 1
    if same(op, "div") is 1
        # idiv-free x/2^k: sign mask, round-up add, arithmetic shift.
        # (x + (x >>> 63 unsigned-shifted 64-k)) >>> k arithmetic
        # equals idiv x, 2^k for every 64-bit x incl INT64_MIN;
        # division by 2^k can never overflow (that trap is x/-1's).
        # rows GAS-verified (bs row53 + row55).
        if v is 1
            return 0
        if v < 2
            return 0 - 1
        k: 0
        q: v
        as long as q > 1
            if q % 2 is 1
                return 0 - 1
            q: q / 2
            k: k + 1
        emit(72)
        emit(137)
        emit(194)
        emit(72)
        emit(193)
        emit(250)
        emit(63)
        emit(72)
        emit(193)
        emit(234)
        emit(64 - k)
        emit(72)
        emit(1)
        emit(208)
        emit(72)
        emit(193)
        emit(248)
        emit(k)
        return 0
    if same(op, "mul") is 1
        if v is 2
            # add rax, rax - the OF-exact twin of imul-by-2: same
            # bits, same overflow flag, so chk_ov still traps
            # exactly where imul would. one byte shorter, 3x less
            # latency on loop-carried chains. GAS-verified.
            emit(72)
            emit(1)
            emit(192)
            return 0
        if has_vm is 1
            # chk_ov emits nothing with the mapped heap, so no one
            # can observe flags: flag-free lea/shl forms are legal.
            if v is 3
                emit(72)
                emit(141)
                emit(4)
                emit(64)
                return 0
            if v is 5
                emit(72)
                emit(141)
                emit(4)
                emit(128)
                return 0
            if v is 9
                emit(72)
                emit(141)
                emit(4)
                emit(192)
                return 0
            if v is 4
                emit(72)
                emit(193)
                emit(224)
                emit(2)
                return 0
            if v is 8
                emit(72)
                emit(193)
                emit(224)
                emit(3)
                return 0
            if v is 16
                emit(72)
                emit(193)
                emit(224)
                emit(4)
                return 0
            if v is 32
                emit(72)
                emit(193)
                emit(224)
                emit(5)
                return 0
    if v >= 0 - 128
        if v < 128
            if same(op, "add") is 1
                emit(72)
                emit(131)
                emit(192)
                emit(v % 256)
            if same(op, "sub") is 1
                emit(72)
                emit(131)
                emit(232)
                emit(v % 256)
            if same(op, "mul") is 1
                emit(72)
                emit(107)
                emit(192)
                emit(v % 256)
            return 0
    if same(op, "add") is 1
        emit(72)
        emit(5)
        emit4(v)
    if same(op, "sub") is 1
        emit(72)
        emit(45)
        emit4(v)
    if same(op, "mul") is 1
        emit(72)
        emit(105)
        emit(192)
        emit4(v)
    return 0

# is this expression one plain name (letters, digits, underscore)?

bin_regop op sl:
    # a binop whose right side already sits in slot sl: op rax,
    # r_slot with exactly the trap contract emit_op keeps for the
    # rcx form - no staging, no stack.
    if same(op, "add") is 1
        add_rax_reg(sl)
        chk_ov()
        return 0
    if same(op, "sub") is 1
        sub_rax_reg(sl)
        chk_ov()
        return 0
    if same(op, "mul") is 1
        imul_rax_reg(sl)
        chk_ov()
        return 0
    if same(op, "div") is 1
        chk_zreg(sl)
        emit(72)
        emit(153)
        idiv_reg(sl)
        return 0
    if same(op, "mod") is 1
        chk_zreg(sl)
        emit(72)
        emit(153)
        idiv_reg(sl)
        emit(72)
        emit(146)
        return 0
    cmp_rax_reg(sl)
    setcc(op)
    return 0
# a plain name that lives in a register right now: its slot, or
# 0 - 1. slots 5-8 count only under leaf8, when they really are
# r8-r11; every other fused arm keeps the reg_slot contract (< 5).

bin_rslot name:
    rs: reg_slot(name)
    if rs > 0 - 1
        return rs
    if leaf8 is 1
        bsl: idx(locals, name)
        if bsl > 4
            if bsl < 9
                return bsl
    return 0 - 1

# the fused jump for a comparison: inv 1 jumps when false

br_relax at n:
    if at < 2
        return 0
    self: 0 - 1
    busy: 0
    i: 0
    as long as i < _sov_list_len(br_at)
        e: _sov_list_get(br_at, i)
        if e is at
            if _sov_list_get(br_st, i) is not 4
                self: i
        if _sov_list_get(br_st, i) is 0
            if e > at
                if e <= here()
                    busy: 1
        i: i + 1
    if self > 0 - 1
        br_st: _sov_list_set(br_st, self, 1)
    o1: _sov_list_get(oc, at - 2)
    o2: _sov_list_get(oc, at - 1)
    shrink: 0
    back: 0
    if o2 is 233
        shrink: 3
        back: 3
    if o1 is 15
        if o2 >= 128
            if o2 <= 143
                shrink: 4
                back: 4
    if shrink is 0
        return 0
    if busy is 1
        return 0
    rel8: n
    if n < 0
        rel8: n + back
    if rel8 < 0 - 128
        return 0
    if rel8 > 127
        return 0
    if n > 0
        if self < 0
            return 0
        if _sov_list_get(br_pv, self) is not pad_ver
            return 0
    b: rel8
    if b < 0
        b: b + 256
    if o2 is 233
        oc: _sov_list_set(oc, at - 1, 235)
        oc: _sov_list_set(oc, at, b)
    if not
        oc: _sov_list_set(oc, at - 2, o2 - 16)
        oc: _sov_list_set(oc, at - 1, b)
    d: at + 4 - shrink
    i: 0
    as long as i < _sov_list_len(br_at)
        if i is not self
            rst: _sov_list_get(br_st, i)
            if rst is 4
                rst: 0
            if rst > 0
                e: _sov_list_get(br_at, i)
                nb: e + 4
                ep: e
                if rst is 2
                    nb: e
                    ep: e - 1
                if rst is 3
                    nb: e + 1
                dv: _sov_list_get(oc, ep)
                if rst is 1
                    dv: dv + _sov_list_get(oc, e + 1) * 256 + _sov_list_get(oc, e + 2) * 65536 + _sov_list_get(oc, e + 3) * 16777216
                    if dv >= 2147483648
                        dv: dv - 4294967296
                if rst > 1
                    if dv >= 128
                        dv: dv - 256
                tg: nb + dv
                nn: nb
                if tg >= d
                    tg: tg - shrink
                if nn >= d
                    nn: nn - shrink
                ndv: tg - nn
                if rst is 1
                    v: ndv
                    if v < 0
                        v: v + 4294967296
                    k: 0
                    as long as k < 4
                        oc: _sov_list_set(oc, e + k, v % 256)
                        v: v / 256
                        k: k + 1
                if rst > 1
                    if ndv < 0
                        ndv: ndv + 256
                    oc: _sov_list_set(oc, ep, ndv)
        i: i + 1
    ln: here() - (at + 4)
    i: 0
    as long as i < ln
        oc: _sov_list_set(oc, at + 4 - shrink + i, _sov_list_get(oc, at + 4 + i))
        i: i + 1
    poke_i64(oc, 8, here() - shrink)
    # pass 113: the vanished bytes under [d, d + shrink) delete any
    # other site whose four-byte hole reaches into that window. such a
    # site is dead - a later re-resolve would rewrite whatever live
    # code sits at its stale offset (the self-compile jne that kept a
    # zero disp while its intended bytes landed six late). this scan
    # runs on pre-move positions, where a hole [e, e+4) overlapping
    # [d, d+shrink) is exactly e in (d-4, d+shrink); after the move
    # loop the moved-dead and the untouched-alive are indistinguishable
    # at d-4. mark them dead: put, br_relax and dce_litter skip st 4.
    i: 0
    as long as i < _sov_list_len(br_at)
        if i is not self
            e: _sov_list_get(br_at, i)
            if e > d - 4
                if e < d + shrink
                    if _sov_list_get(br_st, i) is not 4
                        br_st: _sov_list_set(br_st, i, 4)
        i: i + 1
    i: 0
    as long as i < _sov_list_len(br_at)
        if i is not self
            if _sov_list_get(br_st, i) > 0
                e: _sov_list_get(br_at, i)
                if e >= d
                    br_at: _sov_list_set(br_at, i, e - shrink)
        i: i + 1
    i: 0
    pa: at + 4
    as long as i < _sov_list_len(patch_at)
        e: _sov_list_get(patch_at, i)
        if e >= pa
            patch_at: _sov_list_set(patch_at, i, e - shrink)
        i: i + 1
    if self > 0 - 1
        if o2 is 233
            br_st: _sov_list_set(br_st, self, 3)
        if not
            br_st: _sov_list_set(br_st, self, 2)
    return 1

calln name:
    cflush_globs()
    emit(232)
    at: here()
    emit4(0)
    addp(at, "rel", name)

prolog:
    if no_frame is 1
        # every local lives in a callee-saved register, so the rbp
        # frame is pure overhead. no pad: callee entry rsp is 8 mod
        # 16, so an ODD number of pushes leaves rsp 16-aligned for
        # the calls inside, and an even number is fine too because
        # nothing in a Sovren program needs 16-byte alignment (the
        # cfunc path aligns itself with and rsp, -16).
        if fn_save_n > 0
            emit(83)
        if fn_save_n > 1
            emit(65)
            emit(84)
        if fn_save_n > 2
            emit(65)
            emit(85)
        if fn_save_n > 3
            emit(65)
            emit(86)
        if fn_save_n > 4
            emit(65)
            emit(87)
        return 0
    emit(85)
    emit(72)
    emit(137)
    emit(229)
    # pushes go lowest slot first: rbx lands at rbp-8, r12 at
    # rbp-16 and so on, which is where leave reads them back
    if fn_save_n > 0
        emit(83)
    if fn_save_n > 1
        emit(65)
        emit(84)
    if fn_save_n > 2
        emit(65)
        emit(85)
    if fn_save_n > 3
        emit(65)
        emit(86)
    if fn_save_n > 4
        emit(65)
        emit(87)
    emit(72)
    emit(129)
    emit(236)
    pro_at: here()
    br_at: _sov_list_add(br_at, pro_at)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, pro_at)
    br_st: _sov_list_add(br_st, 0)
    emit4(512)
    return 0

sysc_raw:
    emit(15)
    emit(5)

rax_mac n:
    if n is 1
        rax_imm(33554436)
    if n is 27
        rax_imm(33554510)
    if n is 160
        rax_imm(33554627)
    if n is 318
        rax_imm(33554932)
    if n is 13
        rax_imm(33554478)
    if n is 60
        rax_imm(33554433)
    if n is 9
        rax_imm(33554629)
    if n is 28
        rax_imm(33554618)
    if n is 74
        rax_imm(33554506)

emit_sys_exit:
    m: is_mac()
    if m is 1
        rax_mac(60)
        sysc_raw()
        return 0
    emit(184)
    emit4(60)
    sysc()
    return 0

emit_sys_num n:
    m: is_mac()
    if m is 1
        rax_mac(n)
        return 0
    if not
        rax_imm(n)
        return 0

emit_sys_do:
    m: is_mac()
    if m is 1
        sysc_raw()
        return 0
    if not
        sysc()
        return 0

emit_mmap:
    win_rare()
    emit_sys_num(9)
    rdi_imm(0)
    emit(72)
    emit(190)
    emit8(mmap_sz)
    emit(72)
    emit(186)
    emit8(3)
    emit(73)
    emit(186)
    emit8(34)
    emit(73)
    emit(184)
    emit8(0 - 1)
    emit(73)
    emit(185)
    emit8(0)
    emit_sys_do()

emit_mmap_k n:
    win_rare()
    emit_sys_num(9)
    emit(49)
    emit(255)
    emit(190)
    emit4(n + 2097152)
    emit(186)
    emit(3)
    emit(0)
    emit(0)
    emit(0)
    emit(65)
    emit(186)
    emit(34)
    emit(0)
    emit(0)
    emit(0)
    emit(73)
    emit(199)
    emit(192)
    emit(255)
    emit(255)
    emit(255)
    emit(255)
    emit(77)
    emit(49)
    emit(201)
    emit_sys_do()
    emit(72)
    emit(5)
    emit4(2097151)
    emit(72)
    emit(37)
    emit(0)
    emit(0)
    emit(224)
    emit(255)
    emit(80)
    emit(72)
    emit(137)
    emit(199)
    emit(190)
    emit4(n)
    emit(186)
    emit(14)
    emit(0)
    emit(0)
    emit(0)
    emit_sys_num(28)
    emit_sys_do()
    emit(88)

emit_alloc:
    win_rare()
    fn_names: _sov_list_add(fn_names, "_sov_alloc")
    fn_offs: _sov_list_add(fn_offs, here())
    if has_vm is 0
        emit(83)
        emit(72)
        emit(137)
        emit(251)
        emit(72)
        emit(141)
        emit(179)
        emit4(2097160)
        rdi_imm(0)
        emit(72)
        emit(186)
        emit8(3)
        emit(73)
        emit(186)
        emit8(34)
        emit(73)
        emit(184)
        emit8(0 - 1)
        emit(73)
        emit(185)
        emit8(0)
        emit_sys_num(9)
        emit_sys_do()
        if used_tr is 1
            emit(72)
            emit(131)
            emit(192)
            emit(8)
        emit(72)
        emit(5)
        emit4(2097151)
        emit(72)
        emit(37)
        emit(0)
        emit(0)
        emit(224)
        emit(255)
        if used_tr is 1
            emit(72)
            emit(137)
            emit(88)
            emit(248)
        emit(80)
        emit(72)
        emit(137)
        emit(199)
        emit(72)
        emit(137)
        emit(222)
        emit(72)
        emit(186)
        emit8(14)
        emit_sys_num(28)
        emit_sys_do()
        emit(88)
        emit(91)
        ret()
        return
    emit(72)
    emit(129)
    emit(255)
    emit4(2097152)
    sm: jb()
    emit(83)
    emit(72)
    emit(137)
    emit(251)
    emit(72)
    emit(141)
    emit(179)
    emit4(2097152)
    rdi_imm(0)
    emit(72)
    emit(186)
    emit8(3)
    emit(73)
    emit(186)
    emit8(34)
    emit(73)
    emit(184)
    emit8(0 - 1)
    emit(73)
    emit(185)
    emit8(0)
    emit_sys_num(9)
    emit_sys_do()
    emit(72)
    emit(5)
    emit4(2097151)
    emit(72)
    emit(37)
    emit(0)
    emit(0)
    emit(224)
    emit(255)
    emit(80)
    emit(72)
    emit(137)
    emit(199)
    emit(72)
    emit(137)
    emit(222)
    emit(72)
    emit(186)
    emit8(14)
    emit_sys_num(28)
    emit_sys_do()
    emit(88)
    emit(91)
    ret()
    patch(sm)
    fn_save_n: 2
    prolog()
    copyargs(1)
    load_glob("heap_ptr")
    test_rax()
    hv: jnz()
    emit_mmap()
    store_glob("heap_ptr")
    patch(hv)
    # lock xadd [heap_ptr], size: the bump is one instruction so two
    # threads cannot both read the same pointer. rcx keeps the old
    # value, which is the block this call owns.
    load_loc(0)
    mov_rcx_rax()
    relh: is_rel()
    if relh is 1
        emit(240)
        emit(72)
        emit(15)
        emit(193)
        emit(13)
        xat: here()
        emit4(0)
        addp(xat, "grel", "heap_ptr")
    if not
        emit(73)
        emit(187)
        xat: here()
        emit8(0)
        addp(xat, "glob", "heap_ptr")
        emit(240)
        emit(73)
        emit(15)
        emit(193)
        emit(11)
    emit(72)
    emit(137)
    emit(200)
    leave()
    ret()
    # alloc_mark / alloc_reset: the heap as an arena. mark hands back
    # the bump pointer as it stands; reset rolls it back, so every
    # allocation made after the mark is reclaimed in one step - a
    # request-scoped pattern for programs that run forever. reset
    # only when nothing above the mark is still live, and not while
    # another task may be mid-allocation.
    emit_alloc_mark()
    emit_alloc_reset()

emit_alloc_mark:
    fn_names: _sov_list_add(fn_names, "alloc_mark")
    fn_offs: _sov_list_add(fn_offs, here())
    load_glob("heap_ptr")
    ret()

emit_alloc_reset:
    fn_names: _sov_list_add(fn_names, "alloc_reset")
    fn_offs: _sov_list_add(fn_offs, here())
    fn_save_n: 1
    prolog()
    copyargs(1)
    load_loc(0)
    store_glob("heap_ptr")
    xor_rax()
    leave()
    ret()

emit_print:
    fn_names: _sov_list_add(fn_names, "_sov_print")
    fn_offs: _sov_list_add(fn_offs, here())
    fn_save_n: 1
    prolog()
    copyargs(1)
    load_loc(0)
    emit(72)
    emit(137)
    emit(195)
    # a real number sits inside the heap; everything else is text.
    # Strings live below the bump pointer, and the arguments the
    # system handed over sit above the heap's far end, so both are
    # text whatever they look like.
    if has_vm is 1
        load_glob("heap_ptr")
        emit(72)
        emit(57)
        emit(195)
        n1: jb()
        load_glob("heap_end")
        emit(72)
        emit(57)
        emit(195)
        n2: jae()
    if not
        emit(72)
        emit(61)
        emit4(65536)
        n1: jae()
        n2: n1
    emit(72)
    emit(137)
    emit(216)
    mov_rdi_rax()
    used_pi: 1
    calln("_sov_print_int")
    xor_rax()
    leave()
    ret()
    patch(n1)
    patch(n2)
    emit(72)
    emit(137)
    emit(216)
    mov_rdi_rax()
    calln("_sov_strlen")
    emit(72)
    emit(137)
    emit(194)
    load_loc(0)
    mov_rsi_rax()
    rdi_imm(1)
    emit_sys_num(1)
    emit_sys_do()
    rax_str("\n")
    mov_rsi_rax()
    rdi_imm(1)
    emit(72)
    emit(186)
    emit8(1)
    emit_sys_num(1)
    emit_sys_do()
    xor_rax()
    leave()
    ret()

body lines:
    n: _sov_list_len(lines)
    i: 0
    bk: _sov_list_new()
    bi: _sov_list_new()
    bj: _sov_list_new()
    bs: _sov_list_new()
    be: _sov_list_new()
    br: _sov_list_new()
    bx: _sov_list_new()
    bw: _sov_list_new()
    sk_pos: _sov_list_new()
    sk_to: _sov_list_new()
    as long as i < n
        raw: _sov_list_get(lines, i)
        s: strip(raw)
        err_line: i + 1
        if _sov_list_len(stmt_lns) > i
            err_line: _sov_list_get(stmt_lns, i)
        ind: nind(raw)
        if length(s) is 0
            i: i + 1
        if not
            if starts(s, "#") is 1
                i: i + 1
            if not
                isel: 0
                if same(s, "if not") is 1
                    isel: 1
                if starts(s, "except") is 1
                    isel: 1
                popgo: 1
                as long as popgo is 1
                    if _sov_list_len(bk) is 0
                        popgo: 0
                    if not
                        last: _sov_list_len(bk) - 1
                        if ind > _sov_list_get(bi, last)
                            popgo: 0
                        if not
                            stay: 0
                            if isel is 1
                                if ind is _sov_list_get(bi, last)
                                    if same(_sov_list_get(bk, last), "if") is 1
                                        stay: 1
                                    if same(_sov_list_get(bk, last), "try") is 1
                                        stay: 1
                            if stay is 1
                                popgo: 0
                            if not
                                popblk()
                loop_ok: 0
                if starts(s, "as long as ") is 1
                    s: join("while ", strip(cut(s, 11, length(s))))
                    loop_ok: 1
                if starts(s, "if ") is 1
                    if same(s, "if not") is 0
                        if starts(s, "if not ") is 0
                            selhit: 0
                            if try_sel_if(cut(s, 3, length(s)), lines, i, ind) is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                                selhit: 1
                            if selhit is 0
                                cflush_all()
                                z: fuse_cmp(cut(s, 3, length(s)), 1)
                                if z is 0 - 1
                                    expr(cut(s, 3, length(s)))
                                    test_rax()
                                    z: jz()
                                bk: _sov_list_add(bk, "if")
                                bw: _sov_list_add(bw, "")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, 0)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                                bx: _sov_list_add(bx, _sov_list_new())
                                br_depth: br_depth + 1
                        if not
                            stmt(s)
                    if not
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                if not
                    if same(s, "\x00__removed_and_if_not") is 1
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                    if not
                        if starts(s, "do while ") is 1
                            bln: collect_body(lines, i + 1, ind)
                            filw: 0
                            if try_opt_while(cut(s, 9, length(s)), bln) is 1
                                filw: 1
                            if not
                                if try_fill_while(cut(s, 9, length(s)), bln, lines, i) is 1
                                    filw: 1
                            if filw is 0
                                if try_count_while(cut(s, 9, length(s)), bln, lines, i) is 1
                                    filw: 1
                            if filw is 0
                                if try_patfill_while(cut(s, 9, length(s)), bln, lines, i) is 1
                                    filw: 1
                            if filw is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                            if not
                                cflush_all()
                                w9: cut(s, 9, length(s))
                                z: jmp()
                                align32()
                                st: here()
                                bk: _sov_list_add(bk, "while")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, st)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                                bx: _sov_list_add(bx, _sov_list_new())
                                bw: _sov_list_add(bw, w9)
                                br_depth: br_depth + 1
                        if not
                            if loop_ok is 1
                                bln: collect_body(lines, i + 1, ind)
                                filw: 0
                                if try_opt_while(cut(s, 6, length(s)), bln) is 1
                                    filw: 1
                                if not
                                    if try_fill_while(cut(s, 6, length(s)), bln, lines, i) is 1
                                        filw: 1
                                if filw is 0
                                    if try_count_while(cut(s, 6, length(s)), bln, lines, i) is 1
                                        filw: 1
                                if filw is 0
                                    if try_patfill_while(cut(s, 6, length(s)), bln, lines, i) is 1
                                        filw: 1
                                if filw is 1
                                    i: skip_body(lines, i + 1, ind)
                                    i: i - 1
                                if not
                                    cflush_all()
                                    w6: cut(s, 6, length(s))
                                    z: jmp()
                                    align32()
                                    st: here()
                                    bk: _sov_list_add(bk, "while")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, z)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                    bx: _sov_list_add(bx, _sov_list_new())
                                    bw: _sov_list_add(bw, w6)
                                    br_depth: br_depth + 1
                            if not
                                if same(s, "do forever") is 1
                                    # flush deferred constants ahead of the
                                    # head, like the while arms already do:
                                    # a first-use flush inside the body lands
                                    # past st and re-materialises the old
                                    # value every lap (the loop counter never
                                    # advanced - the loop ran forever)
                                    cflush_all()
                                    align32()
                                    st: here()
                                    bk: _sov_list_add(bk, "forever")
                                    bw: _sov_list_add(bw, "")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, 0 - 1)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                    bx: _sov_list_add(bx, _sov_list_new())
                                    br_depth: br_depth + 1
                                if not
                                    if starts(s, "\x00__removed_repeat ") is 1
                                        cflush_all()
                                        tmp: cut(s, 7, length(s))
                                        tp: look(tmp, " times")
                                        if tp > 0 - 1
                                            tmp: cut(tmp, 0, tp)
                                        expr(tmp)
                                        cn: "__rep_c"
                                        inn: "__rep_i"
                                        storev(cn)
                                        xor_rax()
                                        storev(inn)
                                        rs: idx(locals, inn)
                                        cs: idx(locals, cn)
                                        align32()
                                        st: here()
                                        load_loc(rs)
                                        push_rax()
                                        load_loc(cs)
                                        mov_rcx_rax()
                                        pop_rax()
                                        cmp_rax_rcx()
                                        setcc("lt")
                                        test_rax()
                                        z: jz()
                                        bk: _sov_list_add(bk, "repeat")
                                        bw: _sov_list_add(bw, "")
                                        bi: _sov_list_add(bi, ind)
                                        bj: _sov_list_add(bj, z)
                                        bs: _sov_list_add(bs, st)
                                        be: _sov_list_add(be, _sov_list_new())
                                        br: _sov_list_add(br, rs)
                                        bx: _sov_list_add(bx, _sov_list_new())
                                        br_depth: br_depth + 1
                                    if not
                                        if same(s, "try") is 1
                                            cflush_all()
                                            if idx(glob_names, "err_top") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_top")
                                            if idx(glob_names, "err_val") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_val")
                                            # the frame: the old error top, the frame
                                            # pointer, the stack, and where the handler
                                            # starts
                                            emit(84)
                                            emit(85)
                                            load_glob("err_top")
                                            emit(80)
                                            emit(72)
                                            emit(141)
                                            emit(13)
                                            ta: here()
                                            br_at: _sov_list_add(br_at, ta)
                                            br_pv: _sov_list_add(br_pv, pad_ver)
                                            br_id: _sov_list_add(br_id, ta)
                                            br_st: _sov_list_add(br_st, 0)
                                            emit4(0)
                                            emit(81)
                                            emit(72)
                                            emit(137)
                                            emit(225)
                                            emit(72)
                                            emit(137)
                                            emit(200)
                                            store_glob("err_top")
                                            bk: _sov_list_add(bk, "try")
                                            bw: _sov_list_add(bw, "")
                                            bi: _sov_list_add(bi, ind)
                                            bj: _sov_list_add(bj, 0)
                                            bs: _sov_list_add(bs, 0)
                                            be: _sov_list_add(be, _sov_list_new())
                                            br: _sov_list_add(br, ta)
                                            bx: _sov_list_add(bx, _sov_list_new())
                                            br_depth: br_depth + 1
                                        if not
                                            if starts(s, "except") is 1
                                                last: _sov_list_len(bk) - 1
                                                if last > 0 - 1
                                                    if same(_sov_list_get(bk, last), "try") is 1
                                                                                                            ev: strip(cut(s, 6, length(s)))
                                                                                                            # pass 68: a local may not share a
                                                                                                            # global's name - the load/store
                                                                                                            # ladders divert global-named names
                                                                                                            # to the global until the moment a
                                                                                                            # local appears, so the one hole is
                                                                                                            # an except name materialising a
                                                                                                            # local mid-function. refuse loudly.
                                                                                                            if idx(glob_names, ev) > 0 - 1
                                                                                                                if idx(locals, ev) < 0
                                                                                                                    print "Error: the except name shadows a global"
                                                                                                                    _sov_print(ev)
                                                                                                                    err_where()
                                                                                                                    had_err: 1
                                                                                                            # the try body finished cleanly: the
                                                        # frame comes off and the handler is
                                                        # skipped
                                                        load_glob("err_top")
                                                                                                            emit(72)
                                                        emit(137)
                                                        emit(194)
                                                        emit(72)
                                                        emit(139)
                                                        emit(66)
                                                        emit(8)
                                                        store_glob("err_top")
                                                        emit(72)
                                                        emit(131)
                                                        emit(196)
                                                        emit(32)
                                                        tb: jmp()
                                                        bs: _sov_list_set(bs, last, tb)
                                                                                                            put(_sov_list_get(br, last), here() - (_sov_list_get(br, last) + 4))
                                                                                                            load_glob("err_val")
                                                        store_loc(slot(ev))
                                                                                                            bk: _sov_list_add(bk, "except")
                                                                                                            bw: _sov_list_add(bw, "")
                                                        bi: _sov_list_add(bi, ind)
                                                        bj: _sov_list_add(bj, 0)
                                                        bs: _sov_list_add(bs, 0)
                                                        be: _sov_list_add(be, _sov_list_new())
                                                        br: _sov_list_add(br, 0)
                                                        bx: _sov_list_add(bx, _sov_list_new())
                                                        br_depth: br_depth + 1
                                                    if not
                                                        print "Error: except without try"
                                                        _sov_print(s)
                                                        err_where()
                                                        had_err: 1
                                                if not
                                                    print "Error: except without try"
                                                    _sov_print(s)
                                                    err_where()
                                                    had_err: 1
                                            if not
                                                if starts(s, "raise ") is 1
                                                    expr(cut(s, 6, length(s)))
                                                    if idx(glob_names, "err_val") is 0 - 1
                                                        glob_names: _sov_list_add(glob_names, "err_val")
                                                    if idx(glob_names, "err_top") is 0 - 1
                                                        glob_names: _sov_list_add(glob_names, "err_top")
                                                    store_glob("err_val")
                                                    load_glob("err_top")
                                                    emit(72)
                                                    emit(137)
                                                    emit(194)
                                                    emit(72)
                                                    emit(133)
                                                    emit(210)
                                                    zz: jz()
                                                    emit(72)
                                                    emit(139)
                                                    emit(66)
                                                    emit(8)
                                                    store_glob("err_top")
                                                    emit(72)
                                                    emit(139)
                                                    emit(106)
                                                    emit(16)
                                                    emit(72)
                                                    emit(139)
                                                    emit(98)
                                                    emit(24)
                                                    emit(255)
                                                    emit(98)
                                                    emit(0)
                                                    patch(zz)
                                                    load_glob("err_val")
                                                    mov_rdi_rax()
                                                    used_pi: 1
                                                    calln("_sov_print_int")
                                                    emit(191)
                                                    emit4(1)
                                                    emit_sys_exit()
                                                if not
                                                    stmt(s)
                i: i + 1
    as long as _sov_list_len(bk) > 0
        popblk()
stmt line:
    stmt_dbg()
    im_skip: 0
    s: strip(line)
    if length(s) is 0
        return
    if starts(s, "#") is 1
        return
    s: compound(s)
    stmt_reset_small()
    q: 0
    qi: 0
    as long as qi < length(s)
        if _sov_byte_at(s, qi) is 92
            qi: qi + 1
        if not
            if _sov_byte_at(s, qi) is 34
                q: q + 1
        qi: qi + 1
    if q % 2 is not 0
        print "Error: unterminated text"
        _sov_print(s)
        err_where()
        had_err: 1
        return
    if length(s) > 1000
        print "Error: line too long, split it up"
        err_where()
        had_err: 1
        return
    if starts(s, "use ") is 1
        return
    if starts(s, "immutable ") is 1
        rest: strip(cut(s, 10, length(s)))
        t: find_col(rest)
        if t < 1
            print "Error: immutable needs a name and a value"
            err_where()
            had_err: 1
            return
        im_names: _sov_list_add(im_names, strip(cut(rest, 0, t)))
        im_skip: 1
        s: rest
    if same(s, "private") is 1
        # pass 117: a function that declares private zeroes its frame
        # (the locals region below the saved-register block) at every
        # return, so spilled secrets do not outlive the call in stack
        # residue. the marker also flips need_priv like wipe does.
        fw_on: 1
        return
    if starts(s, "wipe ") is 1
        expr(strip(cut(s, 5, length(s))))
        mov_rdi_rax()
        emit(72)
        emit(133)
        emit(255)
        wsk: jz()
        emit(87)
        used_sl: 1
        calln("_sov_strlen")
        emit(72)
        emit(137)
        emit(193)
        emit(95)
        xor_rax()
        emit(252)
        emit(243)
        emit(170)
        patch(wsk)
        return
    if starts(s, "join ") is 1
        expr(strip(cut(s, 5, length(s))))
        stmt_join_op()
        return
    if starts(s, "print ") is 1
        arg: strip(cut(s, 6, length(s)))
        if ends_times(arg) is 1
            head: strip(cut(arg, 0, length(arg) - 6))
            sp: find_last_sp(head)
            if sp > 0 - 1
                do_print_times(strip(cut(head, 0, sp)), strip(cut(head, sp + 1, length(head))))
                return
        # a postfix cast on a print: force the text path
        if length(arg) >= 8
            if same(cut(arg, length(arg) - 8, length(arg)), " as text") is 1
                expr(cut(arg, 0, length(arg) - 8))
                mov_rdi_rax()
                used_pr: 1
                calln("_sov_print")
                return
        if length(arg) >= 7
            if same(cut(arg, length(arg) - 7, length(arg)), " as ptr") is 1
                expr(cut(arg, 0, length(arg) - 7))
                mov_rdi_rax()
                used_pr: 1
                calln("_sov_print")
                return
        if length(arg) > 1
            if _sov_byte_at(arg, 0) is 34
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
        if starts(arg, "peek_byte(") is 1
            if opt_imm > 0
                emit_write_lit(i2s(opt_imm))
                return
        if print_const(arg) is 1
            return
        typ: expr(arg)
        mov_rdi_rax()
        if typ is 1
            used_pr: 1
            calln("_sov_print")
        if not
            used_pi: 1
            calln("_sov_print_int")
        stmt_mark_print()
        return
    had_col: 0
    col: find_col(s)
    if col > 0
        if col < length(s) - 1
            had_col: 1
            s: join("<-- ", join(strip(cut(s, 0, col)), join(" := ", strip(cut(s, col + 1, length(s))))))
    if starts(s, "<-- ") is 1
        if had_col is 0
            print "Error: bad line"
            _sov_print(s)
            err_where()
            had_err: 1
            return
        rest: cut(s, 4, length(s))
        t: find_sep(rest)
        if t > 0 - 1
            var: repl(strip(cut(rest, 0, t)), " ", "_")
            rhs: strip(cut(rest, t + 4, length(rest)))
            if idx(im_names, var) > 0 - 1
                if im_skip is 0
                    print join("Error: ", join(var, " is immutable, it cannot be assigned again"))
                    _sov_print(s)
                    err_where()
                    had_err: 1
                    return
                im_skip: 0
            if same(rhs, join(var, " + 1")) is 1
                inc_var(var)
                return
            if same(rhs, join(var, " - 1")) is 1
                dec_var(var)
                return
            if try_slot_forms(var, rhs) is 1
                drop_str(var)
                return
            if try_def_peek(var, rhs) is 1
                drop_str(var)
                return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
                    rs: reg_slot(var)
                    if rs > 0 - 1
                        cflush(var)
                        expr(other)
                        add_rax_slot(rs)
                        drop_str(var)
                        return
                    if not
                        sl6: idx(locals, var)
                        if sl6 > 4
                            mm3: mem_scaled(other)
                            if mm3 > 0 - 1
                                cflush(var)
                                ms3: mm3 / 65536
                                mq3: mm3 % 65536
                                emit_rax_scaled(ms3, mq3 / 4096, mq3 % 4096 - 128)
                                add_rax_mem(sl6)
                                drop_str(var)
                                return
                            mm4: memabs_scaled(other)
                            if mm4 > 0 - 1
                                cflush(var)
                                emit_rax_abs(mm4 / 4294967296 - 1, mm4 % 4294967296)
                                add_rax_mem(sl6)
                                drop_str(var)
                                return
            pref: join(var, " - ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, 0 - _sov_atoi(other))
                                drop_str(var)
                                return
                            sub_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
                    rs: reg_slot(var)
                    if rs > 0 - 1
                        cflush(var)
                        expr(other)
                        sub_rax_slot(rs)
                        drop_str(var)
                        return
            if length(rhs) > 0
                if digit(letter(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        if br_depth is 0
                            nv: _sov_atoi(rhs)
                            cset(var, nv)
                            if nv > 0
                                kn: var
                                kv: nv
                            drop_str(var)
                            if has_vm is 0
                                return
            if try_alloc_imm(var, rhs) is 1
                mark_str(var)
                return
            # pass 111: nought into a register local rides xor
            # slot,slot straight from the flusher - the pending
            # entry is registered and cashed at once, so a later
            # read never materializes a second copy
            if same(rhs, "0") is 1
                # reassigns only: a fresh def keeps registering its
                # slot at first use, so the slot order (and every
                # fusion decision built on it) is untouched
                zl: idx(locals, var)
                if zl > 0 - 1
                    if idx(glob_names, var) < 0
                        if zl < 5
                            cset(var, 0)
                            if zl is 0
                                emit(72)
                                emit(49)
                                emit(219)
                            if not
                                emit(77)
                                emit(49)
                                emit(192 + 9 * (zl + 3))
                            zi: idx(cnms, var)
                            cemt: _sov_list_set(cemt, zi, 1)
                            drop_str(var)
                            return
                        if leaf8 is 1
                            if zl < 9
                                cset(var, 0)
                                emit(77)
                                emit(49)
                                emit(192 + 9 * (zl - 5))
                                zi: idx(cnms, var)
                                cemt: _sov_list_set(cemt, zi, 1)
                                drop_str(var)
                                return
            typ: expr(rhs)
            storev(var)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if starts(rhs, "_sov_strlen(") is 1
                if did_stos is 1
                    if kv > 0
                        kn: var
        return
    if same(s, "return") is 1
        if in_main_now is 1
            emit(49)
            emit(255)
            emit_sys_num(60)
            emit_sys_do()
            return
        if fw_on is 1
            if no_frame is 0
                canary_check()
                xor_rax()
                restores()
                frame_wipe()
                stmt_leave_op()
                ret()
                return
        xor_rax()
        leave()
        ret()
        return
    if starts(s, "return ") is 1
        typ: expr(cut(s, 7, length(s)))
        if typ is 1
            saw_str: 1
        if in_main_now is 1
            emit(72)
            emit(137)
            emit(199)
            emit_sys_num(60)
            emit_sys_do()
            return
        if fw_on is 1
            if no_frame is 0
                canary_check()
                emit(80)
                restores()
                frame_wipe()
                emit(88)
                stmt_leave_op()
                ret()
                return
        leave()
        ret()
        return
    if same(s, "stop") is 1
        emit(49)
        emit(255)
        emit_sys_num(60)
        emit_sys_do()
        return
    if same(s, "leave") is 1
        # exit the nearest enclosing loop: one jump straight to its
        # join, recorded on the block's bx list and patched when the
        # loop pops. Replaces the flag-the-limit exit trick, which
        # paid a store, a jump back and a full limit re-check.
        # Walking past a try or except is refused: the jump would
        # strand the error frame on the stack. cflush_all first: a
        # pending constant must sit in memory before the exit path
        # reaches the join, the while arms already flush at the head
        # and forever never had a forward exit before leave.
        ld: _sov_list_len(bk) - 1
        lfound: 0
        lbad: 0
        as long as ld > 0 - 1
            lkind: _sov_list_get(bk, ld)
            if same(lkind, "try") is 1
                lbad: 1
                ld: 0 - 1
            if not
                if same(lkind, "except") is 1
                    lbad: 1
                    ld: 0 - 1
                if not
                    if same(lkind, "while") is 1
                        lfound: ld + 1
                        ld: 0 - 1
                    if not
                        if same(lkind, "forever") is 1
                            lfound: ld + 1
                            ld: 0 - 1
                        if not
                            if same(lkind, "repeat") is 1
                                lfound: ld + 1
                                ld: 0 - 1
                            if not
                                ld: ld - 1
        if lbad is 1
            print "Error: leave cannot cross try"
            _sov_print(s)
            err_where()
            had_err: 1
            return
        if lfound is 0
            print "Error: leave needs a loop around it"
            _sov_print(s)
            err_where()
            had_err: 1
            return
        ld: lfound - 1
        cflush_all()
        lx: _sov_list_get(bx, ld)
        lx: _sov_list_add(lx, jmp())
        bx: _sov_list_set(bx, ld, lx)
        return
    if look(s, "(") < 0
        print "Error: bad line"
        _sov_print(s)
        err_where()
        had_err: 1
        return
    # a bare call's value dies with the statement: try_scaled_mem
    # takes the flag and clears it before any argument evaluates
    val_dead: 1
    expr(s)
    val_dead: 0
try_alloc_imm var rhs:
    if starts(rhs, "_sov_alloc(") is 0
        return 0
    if same(var, skip_al) is 1
        return 1
    r: try_sbss(var, rhs)
    if r is 1
        return 1
    if has_vm is 0
        if same(letter(rhs, length(rhs) - 1), ")") is 1
            inn: strip(cut(rhs, 11, length(rhs) - 1))
            asz: 0
            if same(inn, kn) is 1
                if kv > 0
                    asz: kv
            if asz is 0
                if length(inn) > 0
                    if digit(letter(inn, 0)) is 1
                        if look(inn, " ") < 0
                            asz: _sov_atoi(inn)
            if asz > 511
                emit_mmap_k(asz)
                storev(var)
                return 1
    return 0

emit_used:
    plat_used()
    if used_al is 1
        if idx(glob_names, "heap_ptr") is 0 - 1
            glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_alloc()
    if used_pr is 1
        used_sl: 1
    if used_sl is 1
        emit_strlen()
    if used_eq is 1
        emit_streq()
    if used_pr is 1
        emit_print()
    if used_pi is 1
        emit_print_int()
    if used_tr is 1
        emit_trap_stub()
    plat_canary()

leave:
    if no_frame is 1
        if fn_save_n > 4
            emit(65)
            emit(95)
        if fn_save_n > 3
            emit(65)
            emit(94)
        if fn_save_n > 2
            emit(65)
            emit(93)
        if fn_save_n > 1
            emit(65)
            emit(92)
        if fn_save_n > 0
            emit(91)
        return 0
    leave_reload()
    restores()
    stmt_leave_op()

spawn_emit name argc:
    ai: argc - 1
    as long as ai > 0 - 1
        pop_rax()
        spawn_arg(ai)
        ai: ai - 1
    spawn_finish(name)

emit_trap_stub:
    fn_names: _sov_list_add(fn_names, "_sov_trap")
    fn_offs: _sov_list_add(fn_offs, here())
    emit_write_lit("trap\n")
    emit(106)
    emit(1)
    emit(95)
    emit_sys_num(60)
    emit_sys_do()

load_glob name:
    r: is_rel()
    if r is 1
        emit(72)
        emit(139)
        emit(5)
        at: here()
        emit4(0)
        addp(at, "grel", name)
        return 0
    if not
        emit(73)
        emit(187)
        at: here()
        emit8(0)
        addp(at, "glob", name)
        emit(73)
        emit(139)
        emit(3)
        return 0

store_glob name:
    r: is_rel()
    if r is 1
        emit(72)
        emit(137)
        emit(5)
        at: here()
        emit4(0)
        addp(at, "grel", name)
        return 0
    if not
        emit(73)
        emit(187)
        at: here()
        emit8(0)
        addp(at, "glob", name)
        emit(73)
        emit(137)
        emit(3)
        return 0

emit_canary_fail:
    fn_names: _sov_list_add(fn_names, "_sov_canary_fail")
    fn_offs: _sov_list_add(fn_offs, here())
    emit_write_lit("stack\n")
    canary_die()

canary_check:
    can_used: 1
    # mov rcx, [rip + g_canary]
    emit(72)
    emit(139)
    emit(13)
    cat: here()
    emit4(0)
    addp(cat, "grel", "g_canary")
    # cmp rcx, [rbp - canarydisp]. the hole registers like a
    # branch site so a later relax cannot shift it out from under
    # the patch
    emit(72)
    emit(57)
    emit(141)
    cat2: here()
    emit4(0)
    cd_at: _sov_list_add(cd_at, cat2)
    br_at: _sov_list_add(br_at, cat2)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, cat2)
    br_st: _sov_list_add(br_st, 0)
    # jne _sov_canary_fail
    emit(15)
    emit(133)
    cat3: here()
    emit4(0)
    addp(cat3, "rel", "_sov_canary_fail")
    return 0

canary_store:
    can_used: 1
    # mov rax, [rip + g_canary]
    emit(72)
    emit(139)
    emit(5)
    cst: here()
    emit4(0)
    addp(cst, "grel", "g_canary")
    # mov [rbp - canarydisp], rax, registered the same way
    emit(72)
    emit(137)
    emit(133)
    cst2: here()
    emit4(0)
    cd_at: _sov_list_add(cd_at, cst2)
    br_at: _sov_list_add(br_at, cst2)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, cst2)
    br_st: _sov_list_add(br_st, 0)
    return 0

cflush name:
    ci: idx(cnms, name)
    if ci < 0
        return
    if _sov_list_get(cemt, ci) is 1
        return
    # pass 111: materializing a literal nought straight into a
    # register local rides xor slot,slot - no rax staging round
    # trip. spilled slots and globals keep the old walk.
    if _sov_list_get(cvls, ci) is 0
        cl: idx(locals, name)
        if cl > 0 - 1
            # rbx is 72,49,219; r12-r15 and r8-r11 need W+R+B (77)
            # with the modrm built from the register's low three,
            # never the slot number
            if cl is 0
                emit(72)
                emit(49)
                emit(219)
                cemt: _sov_list_set(cemt, ci, 1)
                return
            if cl < 5
                emit(77)
                emit(49)
                emit(192 + 9 * (cl + 3))
                cemt: _sov_list_set(cemt, ci, 1)
                return
            if leaf8 is 1
                if cl < 9
                    emit(77)
                    emit(49)
                    emit(192 + 9 * (cl - 5))
                    cemt: _sov_list_set(cemt, ci, 1)
                    return
    rax_imm(_sov_list_get(cvls, ci))
    cemt: _sov_list_set(cemt, ci, 1)
    if idx(locals, name) < 0
        if idx(glob_names, name) > 0 - 1
            store_glob(name)
            return
    store_loc(slot(name))

cflush_all:
    i: 0
    as long as i < _sov_list_len(cnms)
        if _sov_list_get(cemt, i) is 0
            cflush(_sov_list_get(cnms, i))
        i: i + 1

cflush_globs:
    i: 0
    as long as i < _sov_list_len(cnms)
        nm: _sov_list_get(cnms, i)
        if _sov_list_get(cemt, i) is 0
            if idx(glob_names, nm) > 0 - 1
                if idx(locals, nm) < 0
                    cflush(nm)
        i: i + 1

chk_mem extra:
    if has_vm is 1
        return
    used_tr: 1
    emit(72)
    emit(133)
    emit(255)
    emit(15)
    emit(132)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")
    if extra is 1
        emit(72)
        emit(59)
        emit(119)
        emit(248)
        emit(15)
        emit(131)
        at: here()
        emit4(0)
        addp(at, "rel", "_sov_trap")
    if not
        emit(72)
        emit(141)
        emit(70)
        emit(8)
        emit(72)
        emit(59)
        emit(71)
        emit(248)
        emit(15)
        emit(135)
        at: here()
        emit4(0)
        addp(at, "rel", "_sov_trap")

chk_ov:
    if has_vm is 1
        return
    used_tr: 1
    emit(15)
    emit(128)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")

chk_zrcx:
    if has_vm is 1
        return
    used_tr: 1
    emit(72)
    emit(133)
    emit(201)
    emit(15)
    emit(132)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")

chk_zreg sl:
    # chk_zrcx with the divisor's own register: test r,r + jz trap
    if has_vm is 1
        return
    used_tr: 1
    rx: 72
    if sl > 0
        rx: rx + 5
    emit(rx)
    emit(133)
    emit(192 + op_low3(sl) * 9)
    emit(15)
    emit(132)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")
    return 0

cmp_rax_imm v:
    if v >= 0 - 128
        if v < 128
            emit(72)
            emit(131)
            emit(248)
            emit(v % 256)
            return 0
    # 2^31 and beyond do not fit the sign-extended imm32 form:
    # 48 3D with imm32 0x80000000 compares against -2147483648.
    # Load the full 64 bits into rcx instead.
    if v >= 2147483648
        emit(72)
        emit(185)
        emit8(v)
        cmp_rax_rcx()
        return 0
    if v < 0 - 2147483648
        emit(72)
        emit(185)
        emit8(v)
        cmp_rax_rcx()
        return 0
    emit(72)
    emit(61)
    emit4(v)
    return 0

# cmp rax with a register local (after expr(le) put the left side in rax)

cmp_rax_rcx:
    emit(72)
    emit(57)
    emit(200)

cmp_rax_reg slot:
    if slot is 0
        emit(72)
        emit(57)
        emit(216)
    if slot is 1
        emit(76)
        emit(57)
        emit(224)
    if slot is 2
        emit(76)
        emit(57)
        emit(232)
    if slot is 3
        emit(76)
        emit(57)
        emit(240)
    if slot is 4
        emit(76)
        emit(57)
        emit(248)
    if slot > 4
        # r8-r11 (leaf8 slots): same row60 form, REX.R rides
        emit(op_rex_r(slot))
        emit(57)
        emit(192 + op_low3(slot) * 8)
    return 0

# cmp a register local with rax (the left side is the register local)

cmp_reg_imm sl v:
    if v >= 0 - 128
        if v < 128
            if sl is 0
                emit(72)
                emit(131)
                emit(251)
                emit(v % 256)
            if sl is 1
                emit(73)
                emit(131)
                emit(252)
                emit(v % 256)
            if sl is 2
                emit(73)
                emit(131)
                emit(253)
                emit(v % 256)
            if sl is 3
                emit(73)
                emit(131)
                emit(254)
                emit(v % 256)
            if sl is 4
                emit(73)
                emit(131)
                emit(255)
                emit(v % 256)
            if sl is 5
                emit(73)
                emit(131)
                emit(248)
                emit(v % 256)
            if sl is 6
                emit(73)
                emit(131)
                emit(249)
                emit(v % 256)
            if sl is 7
                emit(73)
                emit(131)
                emit(250)
                emit(v % 256)
            if sl is 8
                emit(73)
                emit(131)
                emit(251)
                emit(v % 256)
            return 0
    if v >= 2147483648
        emit(72)
        emit(185)
        emit8(v)
        if sl is 0
            emit(72)
            emit(57)
            emit(203)
        if sl is 1
            emit(73)
            emit(57)
            emit(204)
        if sl is 2
            emit(73)
            emit(57)
            emit(205)
        if sl is 3
            emit(73)
            emit(57)
            emit(206)
        if sl is 4
            emit(73)
            emit(57)
            emit(207)
        if sl is 5
            emit(73)
            emit(57)
            emit(200)
        if sl is 6
            emit(73)
            emit(57)
            emit(201)
        if sl is 7
            emit(73)
            emit(57)
            emit(202)
        if sl is 8
            emit(73)
            emit(57)
            emit(203)
        return 0
    if v < 0 - 2147483648
        emit(72)
        emit(185)
        emit8(v)
        if sl is 0
            emit(72)
            emit(57)
            emit(203)
        if sl is 1
            emit(73)
            emit(57)
            emit(204)
        if sl is 2
            emit(73)
            emit(57)
            emit(205)
        if sl is 3
            emit(73)
            emit(57)
            emit(206)
        if sl is 4
            emit(73)
            emit(57)
            emit(207)
        if sl is 5
            emit(73)
            emit(57)
            emit(200)
        if sl is 6
            emit(73)
            emit(57)
            emit(201)
        if sl is 7
            emit(73)
            emit(57)
            emit(202)
        if sl is 8
            emit(73)
            emit(57)
            emit(203)
        return 0
    if sl is 0
        emit(72)
        emit(129)
        emit(251)
        emit4(v)
    if sl is 1
        emit(73)
        emit(129)
        emit(252)
        emit4(v)
    if sl is 2
        emit(73)
        emit(129)
        emit(253)
        emit4(v)
    if sl is 3
        emit(73)
        emit(129)
        emit(254)
        emit4(v)
    if sl is 4
        emit(73)
        emit(129)
        emit(255)
        emit4(v)
    if sl is 5
        emit(73)
        emit(129)
        emit(248)
        emit4(v)
    if sl is 6
        emit(73)
        emit(129)
        emit(249)
        emit4(v)
    if sl is 7
        emit(73)
        emit(129)
        emit(250)
        emit4(v)
    if sl is 8
        emit(73)
        emit(129)
        emit(251)
        emit4(v)
    return 0

cmp_reg_rax slot:
    if slot is 0
        emit(72)
        emit(57)
        emit(195)
    if slot is 1
        emit(73)
        emit(57)
        emit(196)
    if slot is 2
        emit(73)
        emit(57)
        emit(197)
    if slot is 3
        emit(73)
        emit(57)
        emit(198)
    if slot is 4
        emit(73)
        emit(57)
        emit(199)
    return 0

# cmp two register locals against each other, no loading at all

cmp_reg_reg la ra:
    if la is 0
        if ra is 1
            emit(76)
            emit(57)
            emit(227)
        if ra is 2
            emit(76)
            emit(57)
            emit(235)
        if ra is 3
            emit(76)
            emit(57)
            emit(243)
        if ra is 4
            emit(76)
            emit(57)
            emit(251)
    if la is 1
        if ra is 0
            emit(73)
            emit(57)
            emit(220)
        if ra is 2
            emit(77)
            emit(57)
            emit(236)
        if ra is 3
            emit(77)
            emit(57)
            emit(244)
        if ra is 4
            emit(77)
            emit(57)
            emit(252)
    if la is 2
        if ra is 0
            emit(73)
            emit(57)
            emit(221)
        if ra is 1
            emit(77)
            emit(57)
            emit(229)
        if ra is 3
            emit(77)
            emit(57)
            emit(245)
        if ra is 4
            emit(77)
            emit(57)
            emit(253)
    if la is 3
        if ra is 0
            emit(73)
            emit(57)
            emit(222)
        if ra is 1
            emit(77)
            emit(57)
            emit(230)
        if ra is 2
            emit(77)
            emit(57)
            emit(238)
        if ra is 4
            emit(77)
            emit(57)
            emit(254)
    if la is 4
        if ra is 0
            emit(73)
            emit(57)
            emit(223)
        if ra is 1
            emit(77)
            emit(57)
            emit(231)
        if ra is 2
            emit(77)
            emit(57)
            emit(239)
        if ra is 3
            emit(77)
            emit(57)
            emit(247)
    return 0

# op rax, r_slot for slots 0-8: rbx r12-r15 r8-r11. every form
# GAS-verified (63/63, row 60). the r8-r11 forms only ever get
# emitted for leaf8 functions, the only places slots 5-8 hold
# values.

collect_body lines start bind:
    out: _sov_list_new()
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    out: _sov_list_add(out, s)
                    j: j + 1
                if not
                    return out
    return out

cops text:
    r: text
    r: repl(r, " is not ", " != ")
    r: repl(r, " and ", " && ")
    r: repl(r, " or ", " || ")
    r: repl(r, " is ", " == ")
    return r

cset name val:
    ci: idx(cnms, name)
    if ci > 0 - 1
        cvls: _sov_list_set(cvls, ci, val)
        cemt: _sov_list_set(cemt, ci, 0)
        return
    cnms: _sov_list_add(cnms, name)
    cvls: _sov_list_add(cvls, val)
    cemt: _sov_list_add(cemt, 0)

cut t a b:
    return _sov_substring(t, a, b)

dce_globals:
    live: _sov_list_new()
    gi: 0
    as long as gi < _sov_list_len(glob_names)
        gnm: _sov_list_get(glob_names, gi)
        used: 0
        pi: 0
        as long as pi < _sov_list_len(patch_kind)
            k: _sov_list_get(patch_kind, pi)
            if same(k, "glob") is 1
                if same(_sov_list_get(patch_val, pi), gnm) is 1
                    used: 1
            if same(k, "grel") is 1
                if same(_sov_list_get(patch_val, pi), gnm) is 1
                    used: 1
            pi: pi + 1
        if used is 1
            # heap_ptr can arrive twice (driver add + runtime top
            # level): keep one copy, the duplicate costs 8 bytes of
            # LOAD filesz in every heap program
            if idx(live, gnm) is 0 - 1
                live: _sov_list_add(live, gnm)
        gi: gi + 1
    glob_names: live

dce_litter:
    if had_err is 1
        return
    dl_rng_at: _sov_list_new()
    dl_rng_len: _sov_list_new()
    dl_fi: 0
    as long as dl_fi < _sov_list_len(fn_offs)
        dl_s: _sov_list_get(fn_offs, dl_fi)
        dl_e: _sov_list_len(oc)
        if dl_fi + 1 < _sov_list_len(fn_offs)
            dl_e: _sov_list_get(fn_offs, dl_fi + 1)
        dl_ok: 1
        dl_q: 0
        as long as dl_q < _sov_list_len(br_at)
            dl_bq: _sov_list_get(br_at, dl_q)
            if dl_bq >= dl_s
                if dl_bq < dl_e
                    # a site only counts when the bytes before it still
                    # decode as a branch opcode: the fold can delete a
                    # loop after its sites were registered, leaving a
                    # fossil that would veto the whole function
                    dl_real: 0
                    dl_dead: 0
                    if _sov_list_get(br_st, dl_q) is 4
                        dl_dead: 1
                    if dl_dead is 0
                        if _sov_list_get(oc, dl_bq - 1) is 233
                            dl_real: 1
                        if dl_bq >= 2
                            if _sov_list_get(oc, dl_bq - 2) is 15
                                dl_pb: _sov_list_get(oc, dl_bq - 1)
                                if dl_pb >= 128
                                    if dl_pb < 136
                                        dl_real: 1
                    if dl_real is 1
                        dl_ok: 0
            dl_q: dl_q + 1
        dl_q: 0
        as long as dl_q < _sov_list_len(patch_at)
            if same(_sov_list_get(patch_kind, dl_q), "rel") is 1
                dl_bq: _sov_list_get(patch_at, dl_q)
                if dl_bq >= dl_s
                    if dl_bq < dl_e
                        dl_ok: 0
            dl_q: dl_q + 1
        if dl_ok is 1
            dl_ist: 0
            dl_ilen: 0
            dl_idst: 0
            dl_isrc: 0
            dl_irm: 0
            dl_live: 0
            dl_dead: 0
            dl_pos: dl_s
            dl_runst: 0
            dl_noprun: 0
            as long as dl_pos < dl_e
                dl_b: _sov_list_get(oc, dl_pos)
                dl_len: 0
                dl_dst: 0 - 1
                dl_src: 0 - 1
                dl_rm: 0
                dl_term: 0
                if dl_b is 144
                    dl_len: 1
                    dl_rm: 1
                if dl_len is 0
                    if dl_b is 49
                        dl_n2: _sov_list_get(oc, dl_pos + 1)
                        dl_r: 0
                        as long as dl_r < 8
                            if dl_n2 is 192 + dl_r * 9
                                dl_len: 2
                                dl_dst: dl_r
                                dl_rm: 1
                            dl_r: dl_r + 1
                if dl_len is 0
                    dl_n1: _sov_list_get(oc, dl_pos + 1)
                    dl_n2: _sov_list_get(oc, dl_pos + 2)
                    if dl_b is 72
                        if dl_n1 is 137
                            if dl_n2 >= 192
                                if dl_n2 < 200
                                    dl_len: 3
                                    dl_dst: dl_n2 - 192
                                    dl_src: 0
                                    dl_rm: 1
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r
                                    dl_rm: 1
                                dl_r: dl_r + 1
                        if dl_n1 is 184
                            dl_len: 10
                            dl_dst: 0
                            dl_rm: 1
                    if dl_b is 73
                        if dl_n1 is 137
                            if dl_n2 >= 192
                                if dl_n2 < 200
                                    dl_len: 3
                                    dl_dst: dl_n2 - 192 + 8
                                    dl_src: 0
                                    dl_rm: 1
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r + 8
                                    dl_rm: 1
                                dl_r: dl_r + 1
                        if dl_n1 >= 184
                            if dl_n1 < 192
                                dl_len: 10
                                dl_dst: dl_n1 - 184 + 8
                                dl_rm: 1
                    if dl_b is 77
                        # pass 111's xor r8-15,r8-15: W+R+B rex, the
                        # modrm rides the register's low three
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r + 8
                                    dl_rm: 1
                                dl_r: dl_r + 1
                    if dl_b is 65
                        if dl_n1 >= 80
                            if dl_n1 < 88
                                dl_len: 2
                                dl_src: dl_n1 - 80 + 8
                        if dl_n1 >= 88
                            if dl_n1 < 96
                                dl_len: 2
                                dl_dst: dl_n1 - 88 + 8
                                dl_rm: 1
                        if dl_n1 >= 184
                            if dl_n1 < 192
                                dl_len: 6
                                dl_dst: dl_n1 - 184 + 8
                                dl_rm: 1
                if dl_len is 0
                    if dl_b >= 80
                        if dl_b < 88
                            dl_len: 1
                            dl_src: dl_b - 80
                    if dl_b >= 88
                        if dl_b < 96
                            dl_len: 1
                            dl_dst: dl_b - 88
                            dl_rm: 1
                    if dl_b >= 184
                        if dl_b < 192
                            dl_len: 5
                            dl_dst: dl_b - 184
                            dl_rm: 1
                    if dl_b >= 176
                        if dl_b < 184
                            dl_len: 2
                    if dl_b is 106
                        dl_len: 2
                    if dl_b is 15
                        dl_n2: _sov_list_get(oc, dl_pos + 1)
                        if dl_n2 is 5
                            dl_len: 2
                            dl_term: 1
                if dl_len is 0
                    dl_pos: dl_pos + 1
                    dl_runst: 0
                    dl_noprun: 0
                if not
                    if dl_runst is 0
                        dl_can: 0
                        if dl_pos is dl_s
                            dl_can: 1
                        if dl_term is 1
                            dl_can: 1
                        if dl_noprun >= 3
                            dl_can: 1
                        if dl_can is 1
                            dl_runst: 1
                            dl_ist: _sov_list_new()
                            dl_ilen: _sov_list_new()
                            dl_idst: _sov_list_new()
                            dl_isrc: _sov_list_new()
                            dl_irm: _sov_list_new()
                            dl_live: _sov_list_new()
                            dl_dead: _sov_list_new()
                    if dl_runst is 1
                        dl_ist: _sov_list_add(dl_ist, dl_pos)
                        dl_ilen: _sov_list_add(dl_ilen, dl_len)
                        dl_idst: _sov_list_add(dl_idst, dl_dst)
                        dl_isrc: _sov_list_add(dl_isrc, dl_src)
                        dl_irm: _sov_list_add(dl_irm, dl_rm)
                        dl_dead: _sov_list_add(dl_dead, 0)
                        if dl_term is 1
                            # syscall reads rax rdi rsi rdx r10 r8 r9
                            dl_live: _sov_list_add(dl_live, 0)
                            dl_live: _sov_list_add(dl_live, 7)
                            dl_live: _sov_list_add(dl_live, 6)
                            dl_live: _sov_list_add(dl_live, 2)
                            dl_live: _sov_list_add(dl_live, 10)
                            dl_live: _sov_list_add(dl_live, 8)
                            dl_live: _sov_list_add(dl_live, 9)
                            dl_k: _sov_list_len(dl_ist) - 1
                            as long as dl_k >= 0
                                dl_d: _sov_list_get(dl_idst, dl_k)
                                if dl_d > 0 - 1
                                    dl_inlive: 0
                                    dl_m: 0
                                    as long as dl_m < _sov_list_len(dl_live)
                                        if _sov_list_get(dl_live, dl_m) is dl_d
                                            dl_inlive: 1
                                        dl_m: dl_m + 1
                                    if dl_inlive is 1
                                        dl_nl: _sov_list_new()
                                        dl_m: 0
                                        as long as dl_m < _sov_list_len(dl_live)
                                            if _sov_list_get(dl_live, dl_m) is not dl_d
                                                dl_nl: _sov_list_add(dl_nl, _sov_list_get(dl_live, dl_m))
                                            dl_m: dl_m + 1
                                        dl_live: dl_nl
                                        dl_sv: _sov_list_get(dl_isrc, dl_k)
                                        if dl_sv > 0 - 1
                                            dl_in2: 0
                                            dl_m: 0
                                            as long as dl_m < _sov_list_len(dl_live)
                                                if _sov_list_get(dl_live, dl_m) is dl_sv
                                                    dl_in2: 1
                                                dl_m: dl_m + 1
                                            if dl_in2 is 0
                                                dl_live: _sov_list_add(dl_live, dl_sv)
                                    if not
                                        if _sov_list_get(dl_irm, dl_k) is 1
                                            dl_h0: _sov_list_get(dl_ist, dl_k)
                                            dl_h1: dl_h0 + _sov_list_get(dl_ilen, dl_k)
                                            dl_patched: 0
                                            dl_m: 0
                                            as long as dl_m < _sov_list_len(patch_at)
                                                dl_pp: _sov_list_get(patch_at, dl_m)
                                                if dl_pp >= dl_h0
                                                    if dl_pp < dl_h1
                                                        dl_patched: 1
                                                dl_m: dl_m + 1
                                            if dl_patched is 0
                                                dl_dead: _sov_list_set(dl_dead, dl_k, 1)
                                dl_k: dl_k - 1
                            dl_m: 0
                            as long as dl_m < _sov_list_len(dl_ist)
                                if _sov_list_get(dl_dead, dl_m) is 1
                                    dl_rng_at: _sov_list_add(dl_rng_at, _sov_list_get(dl_ist, dl_m))
                                    dl_rng_len: _sov_list_add(dl_rng_len, _sov_list_get(dl_ilen, dl_m))
                                dl_m: dl_m + 1
                            dl_runst: 0
                            dl_noprun: 0
                    if dl_b is 144
                        dl_noprun: dl_noprun + 1
                    if not
                        dl_noprun: 0
                    dl_pos: dl_pos + dl_len
        dl_fi: dl_fi + 1
    if _sov_list_len(dl_rng_at) is 0
        return
    dl_i: 1
    as long as dl_i < _sov_list_len(dl_rng_at)
        dl_k: dl_i - 1
        dl_ca: _sov_list_get(dl_rng_at, dl_i)
        dl_cl: _sov_list_get(dl_rng_len, dl_i)
        dl_done: 0
        as long as dl_done is 0
            if dl_k < 0
                dl_done: 1
            if not
                if _sov_list_get(dl_rng_at, dl_k) > dl_ca
                    dl_rng_at: _sov_list_set(dl_rng_at, dl_k + 1, _sov_list_get(dl_rng_at, dl_k))
                    dl_rng_len: _sov_list_set(dl_rng_len, dl_k + 1, _sov_list_get(dl_rng_len, dl_k))
                    dl_k: dl_k - 1
                if not
                    dl_done: 1
        dl_rng_at: _sov_list_set(dl_rng_at, dl_k + 1, dl_ca)
        dl_rng_len: _sov_list_set(dl_rng_len, dl_k + 1, dl_cl)
        dl_i: dl_i + 1
    dl_no: _sov_list_new()
    dl_pos: 0
    dl_ri: 0
    as long as dl_pos < _sov_list_len(oc)
        dl_cut: 0
        if dl_ri < _sov_list_len(dl_rng_at)
            if _sov_list_get(dl_rng_at, dl_ri) is dl_pos
                dl_cut: 1
        if dl_cut is 1
            dl_pos: dl_pos + _sov_list_get(dl_rng_len, dl_ri)
            dl_ri: dl_ri + 1
        if not
            dl_no: _sov_list_add(dl_no, _sov_list_get(oc, dl_pos))
            dl_pos: dl_pos + 1
    oc: dl_no
    dl_na: _sov_list_new()
    dl_nk: _sov_list_new()
    dl_nv: _sov_list_new()
    dl_nl: _sov_list_new()
    dl_pi: 0
    as long as dl_pi < _sov_list_len(patch_at)
        dl_at: _sov_list_get(patch_at, dl_pi)
        dl_sh: 0
        dl_ri: 0
        as long as dl_ri < _sov_list_len(dl_rng_at)
            if _sov_list_get(dl_rng_at, dl_ri) + _sov_list_get(dl_rng_len, dl_ri) <= dl_at
                dl_sh: dl_sh + _sov_list_get(dl_rng_len, dl_ri)
            dl_ri: dl_ri + 1
        dl_na: _sov_list_add(dl_na, dl_at - dl_sh)
        dl_nk: _sov_list_add(dl_nk, _sov_list_get(patch_kind, dl_pi))
        dl_nv: _sov_list_add(dl_nv, _sov_list_get(patch_val, dl_pi))
        dl_nl: _sov_list_add(dl_nl, _sov_list_get(patch_line, dl_pi))
        dl_pi: dl_pi + 1
    patch_at: dl_na
    patch_kind: dl_nk
    patch_val: dl_nv
    patch_line: dl_nl
    dl_fi: 0
    as long as dl_fi < _sov_list_len(fn_offs)
        dl_off: _sov_list_get(fn_offs, dl_fi)
        dl_sh: 0
        dl_ri: 0
        as long as dl_ri < _sov_list_len(dl_rng_at)
            if _sov_list_get(dl_rng_at, dl_ri) + _sov_list_get(dl_rng_len, dl_ri) <= dl_off
                dl_sh: dl_sh + _sov_list_get(dl_rng_len, dl_ri)
            dl_ri: dl_ri + 1
        fn_offs: _sov_list_set(fn_offs, dl_fi, dl_off - dl_sh)
        dl_fi: dl_fi + 1
# Dead-global elimination. After dce the code stream holds only the
# reachable functions, but glob_names still lists every global ever
# declared (heap_ptr/heap_end from the runtime, __pt_c/__pt_i from the
# string printer, err_top/err_val from try/except, the program's own
# spilled locals) whether or not a surviving function touches it. Each
# wasted global costs 8 bytes of LOAD filesz. Every reference to a
# global goes through a "glob" (movabs absolute) or "grel"
# (rip-relative) patch, and write_elf resolves those by NAME, so
# dropping an unreferenced global is just a filter of glob_names.

dce_stores:
    if had_err is 1
        return
    ds_gi: 0
    as long as ds_gi < _sov_list_len(glob_names)
        ds_gnm: _sov_list_get(glob_names, ds_gi)
        ds_allstore: 1
        ds_any: 0
        ds_pi: 0
        as long as ds_pi < _sov_list_len(patch_kind)
            if same(_sov_list_get(patch_kind, ds_pi), "grel") is 1
                if same(_sov_list_get(patch_val, ds_pi), ds_gnm) is 1
                    ds_any: 1
                    ds_at: _sov_list_get(patch_at, ds_pi)
                    if ds_at >= 3
                        ds_b3: _sov_list_get(oc, ds_at - 3)
                        ds_b2: _sov_list_get(oc, ds_at - 2)
                        ds_b1: _sov_list_get(oc, ds_at - 1)
                        if ds_b3 is 72
                            if ds_b2 is 137
                                if ds_b1 is not 5
                                    ds_allstore: 0
                            if not
                                ds_allstore: 0
                        if not
                            ds_allstore: 0
                    if not
                        ds_allstore: 0
            if same(_sov_list_get(patch_kind, ds_pi), "glob") is 1
                if same(_sov_list_get(patch_val, ds_pi), ds_gnm) is 1
                    ds_any: 1
                    ds_allstore: 0
            ds_pi: ds_pi + 1
        if ds_any is 1
            if ds_allstore is 1
                ds_pi: 0
                as long as ds_pi < _sov_list_len(patch_kind)
                    if same(_sov_list_get(patch_kind, ds_pi), "grel") is 1
                        if same(_sov_list_get(patch_val, ds_pi), ds_gnm) is 1
                            ds_at: _sov_list_get(patch_at, ds_pi)
                            # paint the seven store bytes with nops;
                            # nothing in the stream moves
                            ds_k: ds_at - 3
                            as long as ds_k < ds_at + 4
                                oc: _sov_list_set(oc, ds_k, 144)
                                ds_k: ds_k + 1
                    ds_pi: ds_pi + 1
        ds_gi: ds_gi + 1
    # drop the grel patches whose sites now sit inside nops: the names
    # must look unreferenced or dce_globals keeps them
    ds_na: _sov_list_new()
    ds_nk: _sov_list_new()
    ds_nv: _sov_list_new()
    ds_nl: _sov_list_new()
    ds_pi: 0
    as long as ds_pi < _sov_list_len(patch_at)
        ds_drop: 0
        ds_at: _sov_list_get(patch_at, ds_pi)
        if same(_sov_list_get(patch_kind, ds_pi), "grel") is 1
            if ds_at >= 3
                if _sov_list_get(oc, ds_at - 3) is 144
                    if _sov_list_get(oc, ds_at - 2) is 144
                        if _sov_list_get(oc, ds_at - 1) is 144
                            ds_drop: 1
        if ds_drop is 0
            ds_na: _sov_list_add(ds_na, ds_at)
            ds_nk: _sov_list_add(ds_nk, _sov_list_get(patch_kind, ds_pi))
            ds_nv: _sov_list_add(ds_nv, _sov_list_get(patch_val, ds_pi))
            ds_nl: _sov_list_add(ds_nl, _sov_list_get(patch_line, ds_pi))
        ds_pi: ds_pi + 1
    patch_at: ds_na
    patch_kind: ds_nk
    patch_val: ds_nv
    patch_line: ds_nl
# Pass 108: straight-line litter. In a function with no branch site
# (br_at) and no rel patch - fully straight-line code - the stream is
# decoded greedily over a fixed shape set (nop, xor r,r, mov rX/r8-15,
# rax, mov eX/rXd imm32, movabs, push/pop, push imm8, mov r8b imm8,
# syscall). A run may only start at the function head, after a
# syscall, or after a 3-plus nop run (the P105b signature), never
# mid-instruction. When a run ends at a syscall, backwards liveness
# drops every removable instruction whose destination no later
# instruction and the syscall reads. Eight-bit writes never kill a
# register (mov al,60 leaves the upper bits alone); 32-bit writes do
# (they zero-extend). Removal splices bytes, so the pass is gated on
# the function holding no branch site and no rel patch at all.

dead_iota lines:
    an: blank
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        if starts(s, "<-- ") is 1
            if look(s, "_sov_alloc(") > 0 - 1
                rest: cut(s, 4, length(s))
                t: find_sep(rest)
                if t > 0 - 1
                    an: repl(strip(cut(rest, 0, t)), " ", "_")
        i: i + 1
    if length(an) is 0
        return blank
    hits: 0
    ok: 1
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        mark: join(an, ",")
        hit: 0
        if look(s, mark) > 0 - 1
            hit: 1
        if starts(s, join("<-- ", an)) is 1
            hit: 1
        if hit is 1
            hits: hits + 1
            good: 0
            if look(s, "_sov_alloc(") > 0 - 1
                good: 1
            if look(s, "poke_i64(") > 0 - 1
                good: 1
            if look(s, "peek_i64(") > 0 - 1
                good: 1
            if good is 0
                ok: 0
        i: i + 1
    if ok is 0
        return blank
    if hits < 3
        return blank
    return an

dec_txt v:
    if v is 0
        return "0\n"
    neg: 0
    dv: v
    if dv < 0
        neg: 1
    # no "dv: 0 - dv". the most negative value has no positive twin,
    # so negating it gave back itself, the loop ran on a negative, and
    # cut("0123456789", d, d + 1) indexed the digit string with a
    # negative d - which is how INT64_MIN printed as punctuation
    r: ""
    as long as dv is not 0
        d: dv % 10
        if d < 0
            d: 0 - d
        r: join(cut("0123456789", d, d + 1), r)
        dv: dv / 10
    if neg is 1
        r: join("-", r)
    return join(r, "\n")

dec_var name:
    sl: idx(locals, name)
    if sl is 0
        emit(72)
        emit(255)
        emit(203)
        return
    if sl is 1
        emit(73)
        emit(255)
        emit(204)
        return
    if sl is 2
        emit(73)
        emit(255)
        emit(205)
        return
    if sl is 3
        emit(73)
        emit(255)
        emit(206)
        return
    if sl is 4
        emit(73)
        emit(255)
        emit(207)
        return
    if sl < 0
        # global (or unknown): the old walk, same rule as inc_var
        loadv(name)
        emit(72)
        emit(255)
        emit(200)
        storev(name)
        return
    if sl is 5
        if leaf8 is 1
            emit(73)
            emit(255)
            emit(200)
            return
    if sl is 6
        if leaf8 is 1
            emit(73)
            emit(255)
            emit(201)
            return
    if sl is 7
        if leaf8 is 1
            emit(73)
            emit(255)
            emit(202)
            return
    if sl is 8
        if leaf8 is 1
            emit(73)
            emit(255)
            emit(203)
            return
    # spilled local (sl > 4): dec straight in the frame slot
    cflush(name)
    of: loc_off(sl)
    emit(72)
    emit(255)
    if of > 0 - 129
        emit(77)
        emit(of)
        return
    emit(141)
    emit4(of)
    return

digit c:
    b: _sov_byte_at(c, 0)
    if b >= 48
        if b <= 57
            return 1
    return 0
# load a name; when it is a register local, the value goes straight
# into rcx (the trailing mov rax, reg is rewritten in place, one
# byte: d8->d9 for rbx, e0->e1 for r12 and so on)

drop_str name:
    di: idx(str_vars, name)
    if di > 0 - 1
        str_vars: _sov_list_set(str_vars, di, "")

emit n:
    x: n % 256
    if x < 0
        x: x + 256
    # peephole: a push rax directly followed by a pop of the same
    # register is a nought, and a push rax followed by a pop of
    # another register is a move. The decision uses a FLAG set by
    # the real push emitter, never the raw byte: 0x50 also lives
    # inside immediates and displacements, and matching it there
    # silently corrupts constants (see notes 9cd610c).
    if x > 87
        if x < 96
            if push_live is 1
                push_live: 0
                if x is 88
                    poke_i64(oc, 8, _sov_list_len(oc) - 1)
                    return
                if x is 89
                    poke_i64(oc, 8, _sov_list_len(oc) - 1)
                    oc: _sov_list_add(oc, 72)
                    oc: _sov_list_add(oc, 137)
                    oc: _sov_list_add(oc, 193)
                    return
                if x is 90
                    poke_i64(oc, 8, _sov_list_len(oc) - 1)
                    oc: _sov_list_add(oc, 72)
                    oc: _sov_list_add(oc, 137)
                    oc: _sov_list_add(oc, 194)
                    return
                if x is 94
                    poke_i64(oc, 8, _sov_list_len(oc) - 1)
                    oc: _sov_list_add(oc, 72)
                    oc: _sov_list_add(oc, 137)
                    oc: _sov_list_add(oc, 198)
                    return
                if x is 95
                    poke_i64(oc, 8, _sov_list_len(oc) - 1)
                    oc: _sov_list_add(oc, 72)
                    oc: _sov_list_add(oc, 137)
                    oc: _sov_list_add(oc, 199)
                    return
    push_live: 0
    oc: _sov_list_add(oc, x)

emit4 n:
    v: n
    if v < 0
        v: v + 4294967296
    i: 0
    as long as i < 4
        emit(v % 256)
        v: v / 256
        i: i + 1

emit8 n:
    v: n
    i: 0
    as long as i < 8
        b: v % 256
        if b < 0
            b: b + 256
        emit(b)
        if v < 0
            v: (v - b) / 256
        if not
            v: v / 256
        i: i + 1

emit_addsub_slot dd sd is_sub:
    # add/sub rD, rS where D and S are slots 0..4 (rbx, r12..r15).
    # the 5x5 byte table for both was generated with GAS and objdump
    # and this formula matches all 50 rows:
    #   rex 48 (+4 if src reg >= r8) (+1 if dst reg >= r8)
    #   opcode 01 for add, 29 for sub
    #   modrm c0 + (src and 7) * 8 + (dst and 7)
    dn: 3
    if dd > 0
        dn: 11 + dd
    sn: 3
    if sd > 0
        sn: 11 + sd
    rex: 72
    if sn > 7
        rex: rex + 4
    if dn > 7
        rex: rex + 1
    emit(rex)
    if is_sub is 1
        emit(41)
    if not
        emit(1)
    emit(192 + (sn % 8) * 8 + (dn % 8))

emit_cmov_x_rdi cc xs:
    # cmovcc r_x, rdi - the twin pick's winner folded straight
    # into the index register: cc 76 = l, 79 = g (the dirs
    # try_sel_if can take). row59-verified.
    rx: 72
    if xs > 0
        rx: rx + 4
    emit(rx)
    emit(15)
    emit(cc)
    emit(192 + (xs + 3) * 8 + 7)
    return 0

emit_cmp_jge cond:
    return fuse_cmp(cond, 1)

emit_cmp_rax_scaled bs i2 dp:
    # cmp rax, [r_base + r_idx * 8 + dp] - twin of emit_rax_scaled
    # with 59 in the opcode seat, the /r field is rax so the REX
    # bits drop the +4. every form GAS-verified (11/11, pass 34).
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    emit(rx)
    emit(59)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + nd * 64
    emit(m)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
    return 0

emit_cmp_rcx_scaled bs i2 dp:
    # cmp rcx, [r_base + r_idx * 8 + dp] - 59 seat, rcx reg
    # field. GAS-verified (row 59).
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    emit(rx)
    emit(59)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    emit(12 + nd * 64)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
    return 0

emit_cmp_reg_scaled vs bs i2 dp:
    # cmp r_val, [r_base + r_idx * 8 + dp] - emit_scaled_reg's
    # register field riding on 59 in the opcode seat instead of
    # 137. same mod01-disp8 rules (r13 base, any displacement)
    # and the same trailing-byte guard. every form GAS-verified
    # against objdump (242/242, row 58).
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    if vs > 0
        rx: rx + 4
    emit(rx)
    emit(59)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + (vs + 3) * 8 + nd * 64
    emit(m)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
    return 0

emit_lea_arg ai sl disp:
    # lea argreg, [reglocal + disp]. the 5x7 table (dst rdi rsi rdx
    # rcx r8 r9 rax, src rbx r12..r15, disp8) was generated with GAS
    # and objdump; this formula matches all 210 nonzero-disp rows.
    # disp -128..127, never 0. r12 is rm 100 so it needs a SIB byte.
    dn: 7
    if ai is 1
        dn: 6
    if ai is 2
        dn: 2
    if ai is 3
        dn: 1
    if ai is 4
        dn: 8
    if ai is 5
        dn: 9
    sn: 11 + sl
    if sl is 0
        sn: 3
    rex: 72
    if dn > 7
        rex: rex + 4
    if sn > 7
        rex: rex + 1
    emit(rex)
    emit(141)
    emit(64 + (dn % 8) * 8 + (sn % 8))
    if sl is 1
        emit(36)
    emit(disp % 256)

emit_lea_rax sl disp:
    sn: 11 + sl
    if sl is 0
        sn: 3
    rex: 72
    if sn > 7
        rex: rex + 1
    emit(rex)
    emit(141)
    emit(64 + (sn % 8))
    if sl is 1
        emit(36)
    emit(disp % 256)

emit_lea_rdi_xs xs di:
    # lea rdi, [r_x + di] - di a signed imm8, flag-safe by
    # construction; the SIB form only for r12. row59-verified.
    if xs is 1
        emit(73)
        emit(141)
        emit(124)
        emit(36)
        emit(di)
        return 0
    rx: 72
    if xs > 0
        rx: rx + 1
    emit(rx)
    emit(141)
    emit(123 + xs)
    emit(di)
    return 0

emit_lea_slot2p1 sd dd:
    # lea r_dd, [r_sd + r_sd*1 + 1] - one slot-sized doubling step
    # "t: u * 2 + 1". GAS-verified for all 25 pairs.
    rx: 72
    if dd > 0
        rx: rx + 4
    if sd > 0
        rx: rx + 3
    emit(rx)
    emit(141)
    emit(68 + (dd + 3) * 8)
    emit((sd + 3) * 9)
    emit(1)
    return

emit_mov_rcx_h h:
    # mov rcx, r_h for h an ACTUAL machine number (rbx=3,
    # r12-r15=12-15): the later-term scratch load in sq_acc mode.
    # row69 GAS-verified for all five slot homes.
    rx: 72
    if h > 7
        rx: rx + 4
    emit(rx)
    emit(137)
    emit(193 + (h % 8) * 8)
    return 0

emit_mov_rcx_scaled bs i2 dp:
    # mov rcx, [r_base + r_idx * 8 + dp] - emit_rax_scaled's form
    # with the rcx reg field. GAS-verified (row 59).
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    emit(rx)
    emit(139)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    emit(12 + nd * 64)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        # same trailing-byte guard as emit_rax_scaled
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
    return 0

emit_mov_slot sd dd:
    # mov r_dd, r_sd - one register move for a plain name-to-name
    # assignment when both names live in slots; no rax round trip.
    # GAS-verified for every slot pair.
    rx: 72
    if dd > 0
        rx: rx + 1
    if sd > 0
        rx: rx + 4
    emit(rx)
    emit(137)
    emit(192 + (sd + 3) * 8 + dd + 3)
    return

emit_name_or_imm e:
    e: strip(e)
    if length(e) is 0
        xor_rax()
        return
    if digit(letter(e, 0)) is 1
        rax_imm(_sov_atoi(e))
        return
    if starts(e, "-") is 1
        if length(e) > 1
            if digit(letter(e, 1)) is 1
                rax_imm(0 - _sov_atoi(cut(e, 1, length(e))))
                return
    loadv(repl(e, " ", "_"))
# compile a simple comparison into a compare and a fused jump.
# inv 0 jumps when the comparison is true, inv 1 jumps when it is
# false. The caller patches the jump like a jz. Returns 0 - 1 when
# the condition is not one plain comparison (calls, and/or,
# brackets), so the caller can fall back to the boolean way.

emit_op op:
    if same(op, "add") is 1
        add_rax_rcx()
        chk_ov()
        return 0
    if same(op, "sub") is 1
        sub_rax_rcx()
        chk_ov()
        return 0
    if same(op, "mul") is 1
        imul_rax_rcx()
        chk_ov()
        return 0
    if same(op, "div") is 1
        chk_zrcx()
        emit(72)
        emit(153)
        emit(72)
        emit(247)
        emit(249)
        return 0
    if same(op, "mod") is 1
        chk_zrcx()
        emit(72)
        emit(153)
        emit(72)
        emit(247)
        emit(249)
        emit(72)
        emit(146)
        return 0
    cmp_rax_rcx()
    setcc(op)
    return 0

# a number, optionally with a minus sign

emit_peek_rax:
    # rax = [rdi + rsi*8] - the scaled peek byte-row, exactly the
    # form try_scaled_mem's peek arm already emits (48 8B 04 F7).
    emit(72)
    emit(139)
    emit(4)
    emit(247)
# pass 62: folded-memory forms indexed straight out of a register
# home. h is the ACTUAL register number (rbx 3, rsi 6, rdx 2,
# r8-r15 8-15), so the legacy staged paths fall out as h 6/2 with
# bytes identical to the old emitters. SIB = 199 + low3(h)*8, REX
# gains X (=2) when h > 7. row65 GAS-verified, 55/55.

emit_rax_abs bs imm:
    # mov rax, [r_base + imm] - no index register. imm is the
    # byte offset, always positive; r13 base takes the mod01
    # form like everywhere else, r12 base is the SIB escape:
    # rm field 4 never means a bare r12, so a no-index SIB
    # byte follows the modrm. GAS-verified.
    rx: 72
    if bs > 0
        rx: rx + 1
    emit(rx)
    emit(139)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        emit(nd * 64 + 4)
        emit(36)
    if not
        emit(nd * 64 + bs + 3)
    if nd is 1
        emit(imm)
    if nd is 2
        emit4(imm)
    return 0

emit_rax_scaled bs i2 dp:
    # mov rax, [r_base + r_idx * 8 + dp] - every base/index/disp
    # form verified against GAS objdump (325/325, pass 31).
    # slots: 0 rbx, 1 r12, 2 r13, 3 r14, 4 r15. r13 base and a
    # nonzero displacement both take the mod01 + disp8 form.
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    emit(rx)
    emit(139)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + nd * 64
    emit(m)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        # a trailing 216/224/232/240/248 byte is what the loadv_r*
        # rewrites pattern-match (the pass-22 D8 collision); the SIB
        # byte itself can never equal them (slot fields step by 8),
        # but a displacement can - guard it with a nop terminator.
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
    return 0

