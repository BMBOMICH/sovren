emit_strlen:
    fn_names: _sov_list_add(fn_names, "_sov_strlen")
    fn_offs: _sov_list_add(fn_offs, here())
    # pass 141: a byte value is not a pointer. anything under the
    # first page is treated as the empty string, reusing the stub's
    # own zero-exit instead of dereferencing it. prepended, so every
    # jump inside the hand-tuned body keeps its offset.
    emit(72)
    emit(49)
    emit(192)
    emit(72)
    emit(129)
    emit(255)
    emit(0)
    emit(16)
    emit(0)
    emit(0)
    emit(118)
    emit(88)
    # plain x86-64 only. an earlier version used AVX-512, which
    # crashes on any cpu without it. eight bytes at a time using
    # the zero-byte bit trick, then a byte loop for the tail.
    emit(49)
    emit(192)
    emit(72)
    emit(133)
    emit(255)
    emit(116)
    emit(81)
    emit(72)
    emit(137)
    emit(254)
