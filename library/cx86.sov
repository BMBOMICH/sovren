# numbers under byte: / bytes: become machine bytes, in order
# bytes: with numbers under it becomes put_in_program(n) for each,
# so the compiler source can list bytes and still mean "put these
# in the program being built" when it runs.
expand_bytes body:
    out: _sov_list_new()
    n: _sov_list_len(body)
    i: 0
    as long as i < n
        raw: _sov_list_get(body, i)
        took: 0
        if same(strip(raw), "bytes:") is 1
            took: 1
            bind: nind(raw)
            pad: cut(raw, 0, bind)
            j: i + 1
            go: 1
            as long as go is 1
                if j < n
                    raw2: _sov_list_get(body, j)
                    if nind(raw2) > bind
                        s2: strip(raw2)
                        if length(s2) > 0
                            if peek_byte(s2, 0) is not 35
                                line: join(pad, join("put_in_program(", join(s2, ")")))
                                out: _sov_list_add(out, line)
                        j: j + 1
                    if not
                        go: 0
                if not
                    go: 0
            i: j - 1
        if took is 0
            out: _sov_list_add(out, raw)
        i: i + 1
    return out

