# memory builtins with register-local operands: the byte op goes
# straight to the registers, no argument dance. Only used when the
# runtime heap is mapped (needs_heap), where the bounds checks are no-ops
# anyway. Returns 1 when it handled the call.

mem_poke_byte_imm b x v:
    if b is 0
        if x is 0
                bytes:
                    64
                    198
                    4
                    27
                put_in_program(v % 256)
    if b is 0
        if x is 1
                bytes:
                    66
                    198
                    4
                    35
