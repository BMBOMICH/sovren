cflush name:
    ci: idx(const_names, name)
    if ci < 0
        return
    if _sov_list_get(const_dirty, ci) is 1
        return
    # pass 111: materializing a literal nought straight into a
    # register local rides xor slot,slot - no rax staging round
    # trip. spilled slots and globals keep the old walk.
    if _sov_list_get(const_values, ci) is 0
        cl: idx(local_names, name)
        if cl > 0 - 1
            # rbx is 72,49,219; r12-r15 and r8-r11 need W+R+B (77)
            # with the modrm built from the register's low three,
            # never the slot number
            if cl is 0
                bytes:
                    72
                    49
                    219
                const_dirty: _sov_list_set(const_dirty, ci, 1)
                return
            if cl < 5
                bytes:
                    77
                    49
                put_in_program(192 + 9 * (cl + 3))
                const_dirty: _sov_list_set(const_dirty, ci, 1)
                return
            if leaf8 is 1
                if cl < 9
                    bytes:
                        77
                        49
                    put_in_program(192 + 9 * (cl - 5))
                    const_dirty: _sov_list_set(const_dirty, ci, 1)
                    return
    rax_imm(_sov_list_get(const_values, ci))
    const_dirty: _sov_list_set(const_dirty, ci, 1)
    if idx(local_names, name) < 0
        if idx(global_names, name) > 0 - 1
            store_glob(name)
            return
    store_loc(slot(name))

cflush_all:
    i: 0
    as long as i < _sov_list_len(const_names)
        if _sov_list_get(const_dirty, i) is 0
