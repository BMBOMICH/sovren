ends_times s:
    if length(s) < 6
        return 0
    if same(cut(s, length(s) - 6, length(s)), " times") is 1
        return 1
    return 0

expr e0:
    ex_depth: ex_depth + 1
    if ex_depth > 150
        if had_err is 0
            print "Error: expression too long, split it up"
            err_where()
            had_err: 1
        ex_depth: ex_depth - 1
        xor_rax()
        return 0
    t: expr_body(e0)
    ex_depth: ex_depth - 1
    return t

expr_body e0:
    e: strip(e0)
    if length(e) is 0
        xor_rax()
        return 0
    # postfix cast: <expr> as text / <expr> as ptr. must run before
    # the literal check, which would swallow the cast as string text
    if length(e) >= 8
        if same(cut(e, length(e) - 8, length(e)), " as text") is 1
            expr(cut(e, 0, length(e) - 8))
            return 1
    if length(e) >= 7
        if same(cut(e, length(e) - 7, length(e)), " as ptr") is 1
            expr(cut(e, 0, length(e) - 7))
            return 1
    if length(e) > 0
        if _sov_byte_at(e, 0) is 34
            if length(e) > 1
                rax_str(cut(e, 1, length(e) - 1))
                return 1
            rax_str("")
            return 1
    if starts(e, "as text ") is 1
        expr(cut(e, 8, length(e)))
        return 1
    if starts(e, "as ptr ") is 1
        expr(cut(e, 7, length(e)))
        return 1
    # const(expr) - folded to a literal while compiling
    if starts(e, "const(") is 1
        if length(e) > 7
            if same(letter(e, length(e) - 1), ")") is 1
                if ceval(cut(e, 6, length(e) - 1)) is 1
                    rax_imm(cval)
                    return 0
                print "Error: const: not a compile-time number"
                err_where()
                had_err: 1
                xor_rax()
                return 0
    # addr_of name -- where a job lives in memory, so a C library
    # can be told to call back into Sovren
    if starts(e, "addr_of ") is 1
        emit(72)
        emit(184)
        aat: here()
        emit8(0)
        addp(aat, "fnaddr", strip(cut(e, 8, length(e))))
        return 0
    if starts(e, "length of ") is 1
        expr(cut(e, 10, length(e)))
        mov_rdi_rax()
        used_sl: 1
        calln("_sov_strlen")
        return 0
    e: strip(cops(e))
    p: fop(e, "||")
    if p > 0 - 1
        expr(cut(e, 0, p))
        test_rax()
        a: jnz()
        expr(cut(e, p + 2, length(e)))
        test_rax()
        b: jnz()
        xor_rax()
        d: jmp()
        patch(a)
        patch(b)
        rax_imm(1)
        patch(d)
        return 0
    p: fop(e, "&&")
    if p > 0 - 1
        expr(cut(e, 0, p))
        test_rax()
        a: jz()
        expr(cut(e, p + 2, length(e)))
        test_rax()
        b: jz()
        rax_imm(1)
        d: jmp()
        patch(a)
        patch(b)
        xor_rax()
        patch(d)
        return 0
    # bit operators, loosest first: in C, and in every language that
    # copied C, | binds looser than ^, ^ looser than &, and all three
    # looser than a comparison. splitting on the loosest operator is
    # what makes the tree come out right
    p: fop(e, "|")
    if p > 0 - 1
        return bitop(e, p, "bor", 1)
    p: fop(e, "^")
    if p > 0 - 1
        return bitop(e, p, "bxor", 1)
    p: fop(e, "&")
    if p > 0 - 1
        return bitop(e, p, "band", 1)
    p: fop(e, "==")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "eq")
        return 0
    p: fop(e, "!=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "ne")
        return 0
    p: fop(e, "<=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "le")
        return 0
    p: fop(e, ">=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "ge")
        return 0
    # fopn, not fop: a "<" that is really the first half of a shift
    # has to be walked past, or "a << b" parses as a comparison
    p: fopn(e, "<", "<")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "lt")
        return 0
    p: fopn(e, ">", ">")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "gt")
        return 0
    # >>> before >>, because >> matches the first two characters of
    # it. >> is arithmetic, the way it is on a signed type in C; >>>
    # is the logical one, which is how you get zero fill from the top
    p: fop(e, ">>>")
    if p > 0 - 1
        return bitop(e, p, "bshr", 3)
    p: fop(e, ">>")
    if p > 0 - 1
        return bitop(e, p, "bsar", 2)
    p: fop(e, "<<")
    if p > 0 - 1
        return bitop(e, p, "bshl", 2)
    p: fop2(e, "+", "-")
    if p > 0
        if same(letter(e, p), "+") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "add")
            return 0
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "sub")
        return 0
    if p is 0
        if same(letter(e, p), "+") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "add")
            return 0
    p: fop3(e)
    if p > 0 - 1
        o: letter(e, p)
        if same(o, "*") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "mul")
            return 0
        if same(o, "/") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "div")
            return 0
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "mod")
        return 0
    if same(e, "blank") is 1
        rax_str("")
        return 1
    if length(e) > 0
        if _sov_byte_at(e, 0) is 34
            rax_str(cut(e, 1, length(e) - 1))
            return 1
    if starts(e, "(") is 1
        if same(letter(e, length(e) - 1), ")") is 1
            t: expr(cut(e, 1, length(e) - 1))
            return t
    lp: look(e, "(")
    if lp > 0
        if same(letter(e, length(e) - 1), ")") is 1
            name: strip(cut(e, 0, lp))
            is_spawn: 0
            if starts(name, "spawn ") is 1
                # spawn work(x, y) = start a thread running work(x, y)
                name: strip(cut(name, 6, length(name)))
                if name is blank
                    print "Error: spawn needs a task name"
                    err_where()
                    had_err: 1
                    xor_rax()
                    return 0
                is_spawn: 1
            inside: cut(e, lp + 1, length(e) - 1)
            argc: 0
            argl: _sov_list_new()
            if length(strip(inside)) > 0
                depth: 0
                ins: 0
                start: 0
                i: 0
                ilen: length(inside)
                as long as i < ilen
                    c: letter(inside, i)
                    if ins is 1
                        if _sov_byte_at(inside, i) is 92
                            i: i + 1
                        if not
                            if _sov_byte_at(inside, i) is 34
                                ins: 0
                    if not
                        if _sov_byte_at(inside, i) is 34
                            ins: 1
                        if not
                            if same(c, "(") is 1
                                depth: depth + 1
                            if not
                                if same(c, ")") is 1
                                    depth: depth - 1
                                if not
                                    if same(c, ",") is 1
                                        if depth is 0
                                            argl: _sov_list_add(argl, strip(cut(inside, start, i)))
                                            start: i + 1
                    i: i + 1
                argl: _sov_list_add(argl, strip(cut(inside, start, ilen)))
            argc: _sov_list_len(argl)
            # fib(constant) folds at compile time: the recognized fib
            # shape is pure, and n <= 92 fits (n >= 93 keeps the
            # runtime call so its overflow trap still fires)
            if length(fib_nm) > 0
                if same(name, fib_nm) is 1
                    if argc is 1
                        a0: _sov_list_get(argl, 0)
                        if is_imm(a0) is 1
                            fv: _sov_atoi(a0)
                            if fv < 2
                                rax_imm(fv)
                                return 0
                            if fv < 93
                                rax_imm(fib_of(fv))
                                return 0
            # every argument a plain name or a number: each goes
            # straight to its argument register, no stack trip. A
            # plain load only touches rax and the callee-saved
            # locals, never rdi/rsi/rdx, so the earlier targets stay
            # intact while the later arguments load.
            if try_scaled_mem(name, argc, argl) is 1
                return 0
            all_s: 1
            ai: 0
            as long as ai < argc
                ag: _sov_list_get(argl, ai)
                if is_imm(ag) is 0
                    if plain_name(ag) is 0
                        if lea_ok(ag) is 0
                            all_s: 0
                ai: ai + 1
            if same(name, "syscall") is 1
                all_s: 0
            if same(name, "cfunc") is 1
                all_s: 0
            # the windows bridge builtins pop their arguments, so the
            # values must be pushed (the linux name is never one of
            # these; the other targets reject or ignore them)
            if same(name, "thread_create") is 1
                all_s: 0
            if same(name, "thread_wait") is 1
                all_s: 0
            if same(name, "thread_wake") is 1
                all_s: 0
            if is_spawn is 1
                # spawn always takes the slow path: the arguments are
                # pushed, then re-packed for the thread runtime
                all_s: 0
                if argc > 6
                    print "Error: spawn takes at most six values"
                    err_where()
                    had_err: 1
                    xor_rax()
                    return 0
            if argc > 6
                all_s: 0
            if all_s is 1
                m0: 0 - 1
                m1: 0 - 1
                m2: 0 - 1
                p2: 0
                i2: 0
                ai: 0
                as long as ai < argc
                    ag: _sov_list_get(argl, ai)
                    if ai is 0
                        m0: reg_slot(ag)
                    if ai is 1
                        m1: reg_slot(ag)
                    if ai is 2
                        m2: reg_slot(ag)
                        if is_imm(ag) is 1
                            p2: _sov_atoi(ag)
                            i2: 1
                    ai: ai + 1
                if has_vm is 1
                    if try_mem(name, argc, m0, m1, m2, i2, p2) is 1
                        return 0
                ai: 0
                as long as ai < argc
                    ag: _sov_list_get(argl, ai)
                    if ai is 0
                        if is_imm(ag) is 1
                            expr(ag)
                            mov_rdi_rax()
                        if not
                            if try_lea_arg(ag, 0) is 0
                                loadv_rdi(ag)
                    if ai is 1
                        if is_imm(ag) is 1
                            expr(ag)
                            mov_rsi_rax()
                        if not
                            if try_lea_arg(ag, 1) is 0
                                loadv_rsi(ag)
                    if ai is 2
                        if is_imm(ag) is 1
                            expr(ag)
                            emit(72)
                            emit(137)
                            emit(194)
                        if not
                            if try_lea_arg(ag, 2) is 0
                                loadv_rdx(ag)
                    if ai is 3
                        if try_lea_arg(ag, 3) is 0
                            expr(ag)
                            emit(72)
                            emit(137)
                            emit(193)
                    if ai is 4
                        if try_lea_arg(ag, 4) is 0
                            expr(ag)
                            emit(73)
                            emit(137)
                            emit(192)
                    if ai is 5
                        if try_lea_arg(ag, 5) is 0
                            expr(ag)
                            emit(73)
                            emit(137)
                            emit(193)
                    ai: ai + 1
                call_args(name, argc, 1)
            if not
                ai: 0
                as long as ai < argc
                    expr(_sov_list_get(argl, ai))
                    push_rax()
                    ai: ai + 1
                if is_spawn is 1
                    spawn_emit(name, argc)
                if not
                    call_args(name, argc, 0)
            axi: idx(ar_names, name)
            if axi > 0 - 1
                if _sov_list_get(ar_cnt, axi) is not argc
                    print "Error: wrong number of values"
                    _sov_print(name)
                    err_where()
                    had_err: 1
            if same(name, "cat") is 1
                return 1
            if same(name, "strcat") is 1
                return 1
            if same(name, "_sov_strcat") is 1
                return 1
            if same(name, "sub") is 1
                return 1
            if same(name, "trim") is 1
                return 1
            if same(name, "ch") is 1
                return 1
            if same(name, "_sov_substring") is 1
                return 1
            if idx(str_fns, name) > 0 - 1
                return 1
            return 0
    if digit(letter(e, 0)) is 1
        dq: 0
        as long as dq < length(e)
            if digit(letter(e, dq)) is 0
                print "Error: do not know these words"
                _sov_print(e)
                err_where()
                had_err: 1
                xor_rax()
                return 0
            dq: dq + 1
        rax_imm(_sov_atoi(e))
        return 0
    if starts(e, "-") is 1
        if length(e) > 1
            if digit(letter(e, 1)) is 1
                rax_imm(0 - _sov_atoi(cut(e, 1, length(e))))
                return 0
    if look(e, " ") > 0 - 1
        print "Error: do not know these words"
        _sov_print(e)
        err_where()
        had_err: 1
        xor_rax()
        return 0
    vn: e
    loadv(vn)
    if idx(str_vars, vn) > 0 - 1
        return 1
    return 0

fail:
    syscall(60, 1, 0, 0, 0, 0, 0)

err_where:
    if length(src_name) > 0
        _sov_print(src_name)
    print err_line

suggest_name name:
    best: blank
    bn: 0
    si: 0
    as long as si < _sov_list_len(names)
        nm: _sov_list_get(names, si)
        hit: 0
        if starts(nm, name) is 1
            hit: 1
        if starts(name, nm) is 1
            if length(nm) > 1
                hit: 1
        if hit is 1
            if length(nm) > bn
                best: nm
                bn: length(nm)
        si: si + 1
    si: 0
    as long as si < _sov_list_len(locals)
        nm: _sov_list_get(locals, si)
        if starts(nm, name) is 1
            if length(nm) > bn
                best: nm
                bn: length(nm)
        si: si + 1
    si: 0
    as long as si < _sov_list_len(glob_names)
        nm: _sov_list_get(glob_names, si)
        if starts(nm, name) is 1
            if length(nm) > bn
                best: nm
                bn: length(nm)
        si: si + 1
    if bn > 0
        print "did you mean"
        _sov_print(best)

seed_str_fns:
    str_fns: _sov_list_add(str_fns, "str_cat")
    str_fns: _sov_list_add(str_fns, "str_cut")
    str_fns: _sov_list_add(str_fns, "str_trim")
    str_fns: _sov_list_add(str_fns, "str_join3")
    str_fns: _sov_list_add(str_fns, "_sov_trim")
    str_fns: _sov_list_add(str_fns, "join")
    str_fns: _sov_list_add(str_fns, "strip")
    str_fns: _sov_list_add(str_fns, "cut")
    str_fns: _sov_list_add(str_fns, "repl")
    str_fns: _sov_list_add(str_fns, "letter")

fib_call_var line nm:
    mark: join(nm, "(")
    ln: length(line)
    pos: 0
    as long as pos < ln
        p: look(cut(line, pos, ln), mark)
        if p < 0
            return 0
        p: p + pos
        inn: cut(line, p + length(mark), ln)
        c: look(inn, ")")
        if c < 0
            return 0
        arg: strip(cut(inn, 0, c))
        if is_imm(arg) is 0
            return 1
        if _sov_atoi(arg) > 92
            return 1
        pos: p + length(mark) + c + 1
    return 0

fib_of n:
    if n < 2
        return n
    a: 0
    b: 1
    i: 2
    as long as i <= n
        t: a + b
        a: b
        b: t
        i: i + 1
    return b
# does this line call nm(...) with a non-literal argument? 1 if so.
# the fold only ever eats literal args, so a non-constant call means
# the function body must survive.

fiblike nm ps blines:
    # the exact two-arm recursive fib shape: one value in, the
    # smaller-or-equal base case, one self call per arm. matches
    # only the literal source text; anything else compiles the
    # recursive way
    if same(nm, "main") is 1
        return 0
    if _sov_list_len(ps) is not 1
        return 0
    p: _sov_list_get(ps, 0)
    if _sov_list_len(blines) is not 3
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    l3: strip(_sov_list_get(blines, 2))
    if same(l1, join("if ", join(p, " < 2"))) is 0
        return 0
    if same(l2, join("return ", p)) is 0
        return 0
    want3: join("return ", join(nm, join("(", join(p, " - 1)"))))
    want3b: join(want3, join(" + ", join(nm, join("(", join(p, " - 2)")))))
    if same(l3, want3b) is 0
        return 0
    return 1
# fib of a compile-time constant: the recognized fib shape is pure,
# and for n <= 92 the value fits an int64 (fib(93) overflows and the
# runtime call must keep its trap). iterative, so no recursion
# return-value worries.

file_ln li:
    n: li + 1
    if n > src_base
        return n - src_base
    return n

find_col text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n
        b: _sov_byte_at(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
            if not
                if b is 58
                    return i
        i: i + 1
    return 0 - 1

find_last_sp text:
    i: length(text) - 1
    as long as i > 0 - 1
        if same(letter(text, i), " ") is 1
            return i
        i: i - 1
    return 0 - 1

find_sep text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n - 3
        b: _sov_byte_at(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
        if ins is 0
            if same(cut(text, i, i + 4), " := ") is 1
                return i
        i: i + 1
    return 0 - 1

fold_mem_h oc d i:
    # sub(43)/add(3) r_d with the memory operand at [rdi + i*8] -
    # pass 61's fold accumulating in a register home, not rax.
    # row67 GAS-verified, 81 pairs x 2 ops.
    rx: 72
    if d > 7
        rx: rx + 4
    if i > 7
        rx: rx + 2
    emit(rx)
    emit(oc)
    emit(4 + (d % 8) * 8)
    emit(sibx(i))
    return 0

fold_rax_h oc h:
    # sub(43)/add(3) rax with the memory operand at [rdi + h*8]
    emit(rexx(h))
    emit(oc)
    emit(4)
    emit(sibx(h))
    return 0

fop e op:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
                if i < n
                    i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
                i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if starts(cut(e, i, n), op) is 1
                                f: i
                        i: i + 1
    return f

# fop, except a match followed by `nxt` does not count. that is what
# keeps the less-than comparison from eating the first half of a
# shift: fopn(e, "<", "<") walks straight past "<<"
fopn e op nxt:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
                if i < n
                    i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
                i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if starts(cut(e, i, n), op) is 1
                                fhit: 1
                                if i + length(op) < n
                                    if same(letter(e, i + length(op)), nxt) is 1
                                        fhit: 0
                                # and the character before it: without
                                # this the second < of "a << b" reads
                                # as a comparison of its own
                                if i > 0
                                    if same(letter(e, i - 1), nxt) is 1
                                        fhit: 0
                                if fhit is 1
                                    f: i
                        i: i + 1
    return f

# the bit operators are not new machinery. band, bor, bxor, bshl,
# bshr and bsar already exist as builtins on every back end, so all
# the parser has to do is name one: "a & b" becomes "band(a, b)" and
# goes back through expr, which means the operands get the whole
# expression grammar for free. wide is the operator's own length
bitop e p opn wide:
    return expr(join(join(join(join(opn, "("), cut(e, 0, p)), ","), join(cut(e, p + wide, length(e)), ")")))

fop2 e a b:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
            i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if same(c, a) is 1
                                f: i
                            if not
                                if same(c, b) is 1
                                    f: i
                        i: i + 1
    return f

fop3 e:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
            i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if same(c, "*") is 1
                                f: i
                            if not
                                if same(c, "/") is 1
                                    f: i
                                if not
                                    if same(c, "%") is 1
                                        f: i
                        i: i + 1
    return f

frame_wipe:
    # zero [rbp - (ns + 8*fn_save_n), rbp): every slot below the
    # frame pointer - spilled locals and the saved-register slots
    # both. call sites run restores() FIRST so the caller's rbx and
    # r12-r15 are back in their registers before their stack slots
    # are zeroed, and save rax across the wipe (rep stosb needs
    # al = 0). ns is not final at mid-body return sites, so both
    # immediates are registered holes, patched where pro_at is. 21
    # bytes per return site, and only in functions that said private.
    emit(72)
    emit(137)
    emit(239)
    emit(72)
    emit(129)
    emit(239)
    fw_a: here()
    br_at: _sov_list_add(br_at, fw_a)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, fw_a)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    emit(185)
    fw_b: here()
    br_at: _sov_list_add(br_at, fw_b)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, fw_b)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    emit(49)
    emit(192)
    emit(243)
    emit(170)
    fw_pos: _sov_list_add(fw_pos, fw_a)
    fw_pos: _sov_list_add(fw_pos, fw_b)
    return 0

fuse_cmp cond inv:
    e: strip(cops(cond))
    if look(e, " and ") > 0 - 1
        return 0 - 1
    if look(e, " or ") > 0 - 1
        return 0 - 1
    if look(e, "&&") > 0 - 1
        return 0 - 1
    if look(e, "||") > 0 - 1
        return 0 - 1
    p: fop(e, "==")
    op: "eq"
    ow: 2
    if p < 0
        p: fop(e, "!=")
        op: "ne"
        ow: 2
    if p < 0
        p: fop(e, "<=")
        op: "le"
        ow: 2
    if p < 0
        p: fop(e, ">=")
        op: "ge"
        ow: 2
    if p < 0
        p: fop(e, "<")
        op: "lt"
        ow: 1
    if p < 0
        p: fop(e, ">")
        op: "gt"
        ow: 1
    if p < 0
        return 0 - 1
    le: strip(cut(e, 0, p))
    re: strip(cut(e, p + ow, length(e)))
    # a call on either side is evaluated once through expr, never
    # through a register-slot fast path that would skip it or a
    # fallthrough that would run it twice
    if look(le, "(") > 0 - 1
        expr(le)
        if is_imm(re) is 1
            cmp_rax_imm(_sov_atoi(re))
            return fuse_jcc(op, inv)
        push_rax()
        expr(re)
        mov_rcx_rax()
        pop_rax()
        cmp_rax_rcx()
        return fuse_jcc(op, inv)
    # text against text compares letters, not addresses
    if same(op, "eq") is 1
        if starts(re, "\"") is 1
            expr(le)
            push_rax()
            expr(re)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            cmp_rax_imm(1)
            return fuse_jcc("eq", inv)
        if starts(le, "\"") is 1
            expr(re)
            push_rax()
            expr(le)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            cmp_rax_imm(1)
            return fuse_jcc("eq", inv)
    if same(op, "ne") is 1
        if starts(re, "\"") is 1
            expr(le)
            push_rax()
            expr(re)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            cmp_rax_imm(1)
            return fuse_jcc("ne", inv)
        if starts(le, "\"") is 1
            expr(re)
            push_rax()
            expr(le)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            cmp_rax_imm(1)
            return fuse_jcc("ne", inv)
    # a comparison against a number: no second register needed
    if is_imm(re) is 1
        if is_imm(le) is 0
            sl: bin_rslot(le)
            if sl > 0 - 1
                cflush(le)
                cmp_reg_imm(sl, _sov_atoi(re))
            if not
                expr(le)
                cmp_rax_imm(_sov_atoi(re))
            return fuse_jcc(op, inv)
    if is_imm(le) is 1
        if is_imm(re) is 0
            sl: bin_rslot(re)
            if sl > 0 - 1
                cflush(re)
                cmp_reg_imm(sl, _sov_atoi(le))
            if not
                expr(re)
                cmp_rax_imm(_sov_atoi(le))
            return fuse_jcc(swap_op(op), inv)
    # both sides register locals: one compare, no loading at all
    la: reg_slot(le)
    ra: reg_slot(re)
    if la > 0 - 1
        if ra > 0 - 1
            cflush(le)
            cflush(re)
            cmp_reg_reg(la, ra)
            return fuse_jcc(op, inv)
        # a register local against a scaled raw peek: the compare
        # reads the element straight out of memory - no load, no
        # rax round trip. flags-compare only, same raw contract
        # as the both-peeks arm below.
        mr: mem_scaled(re)
        if mr > 0 - 1
            mb: mr / 65536
            mq: mr % 65536
            cflush(le)
            emit_cmp_reg_scaled(la, mb, mq / 4096, mq % 4096 - 128)
            return fuse_jcc(op, inv)
        cflush(le)
        expr(re)
        cmp_reg_rax(la)
        return fuse_jcc(op, inv)
    if ra > 0 - 1
        ml: mem_scaled(le)
        if ml > 0 - 1
            mb: ml / 65536
            mq: ml % 65536
            cflush(re)
            emit_cmp_reg_scaled(ra, mb, mq / 4096, mq % 4096 - 128)
            return fuse_jcc(swap_op(op), inv)
        cflush(re)
        expr(le)
        cmp_rax_reg(ra)
        return fuse_jcc(op, inv)
    # both sides scaled raw peeks of register bases: one load and
    # one compare against memory - no push, no pop, no second
    # address walk. flags-compare only, so every fused jump works
    # unchanged; the raw contract carries no checks to preserve.
    ml: mem_scaled(le)
    if ml > 0 - 1
        mr: mem_scaled(re)
        if mr > 0 - 1
            mb: ml / 65536
            mq: ml % 65536
            nb: mr / 65536
            nq: mr % 65536
            emit_rax_scaled(mb, mq / 4096, mq % 4096 - 128)
            emit_cmp_rax_scaled(nb, nq / 4096, nq % 4096 - 128)
            return fuse_jcc(op, inv)
    expr(le)
    push_rax()
    expr(re)
    mov_rcx_rax()
    pop_rax()
    cmp_rax_rcx()
    return fuse_jcc(op, inv)

fuse_jcc op inv:
    if same(op, "eq") is 1
        if inv is 1
            return jne()
        return jz()
    if same(op, "ne") is 1
        if inv is 1
            return jz()
        return jne()
    if same(op, "lt") is 1
        if inv is 1
            return jge()
        return jl()
    if same(op, "le") is 1
        if inv is 1
            return jg()
        return jle()
    if same(op, "gt") is 1
        if inv is 1
            return jle()
        return jg()
    if same(op, "ge") is 1
        if inv is 1
            return jl()
        return jge()
    return 0 - 1

# swap < and > for the flipped-operand compare

here:
    return _sov_list_len(oc)

homereg name:
    # a register-resident name's ACTUAL machine register number
    sl: reg_slot(name)
    if sl > 0 - 1
        if sl is 0
            return 3
        return sl + 11
    if leaf8 is 1
        sl8: idx(locals, name)
        if sl8 > 4
            if sl8 < 9
                return sl8 + 3
    return 0 - 1

i2s n:
    r: ""
    v: n
    if v is 0
        return "0\n"
    # sign handled per digit: negating the most negative value gives
    # back itself, and the old "v > 0" loop then produced nothing at
    # all for it
    neg: 0
    if v < 0
        neg: 1
    as long as v is not 0
        d: v % 10
        if d < 0
            d: 0 - d
        r: join(cut("0123456789", d, d + 1), r)
        v: v / 10
    if neg is 1
        r: join("-", r)
    return join(r, "\n")

idiv_reg sl:
    emit(op_rex_b(sl))
    emit(247)
    emit(248 + op_low3(sl))
    return 0

# exact match only. a shorter name must never win over a longer
# one that extends it: "print" is not "print_int".
idx lst name:
    i: 0
    as long as i < _sov_list_len(lst)
        if same(_sov_list_get(lst, i), name) is 1
            return i
        i: i + 1
    return 0 - 1

imul_rax_rcx:
    emit(72)
    emit(15)
    emit(175)
    emit(193)

imul_rax_reg sl:
    # imul rax, r_slot
    emit(op_rex_b(sl))
    emit(15)
    emit(175)
    emit(192 + op_low3(sl))
    return 0

inc_var name:
    sl: idx(locals, name)
    if sl is 0
        emit(72)
        emit(255)
        emit(195)
        return
    if sl is 1
        emit(73)
        emit(255)
        emit(196)
        return
    if sl is 2
        emit(73)
        emit(255)
        emit(197)
        return
    if sl is 3
        emit(73)
        emit(255)
        emit(198)
        return
    if sl is 4
        emit(73)
        emit(255)
        emit(199)
        return
    if sl < 0
        # not a local: a global (or an unknown name that loadv
        # will catch). keep the old load/inc/store walk, which
        # knows the rip-relative global forms.
        loadv(name)
        emit(72)
        emit(255)
        emit(192)
        storev(name)
        return
    if sl is 5
        if leaf8 is 1
            emit(73)
            emit(255)
            emit(192)
            return
    if sl is 6
        if leaf8 is 1
            emit(73)
            emit(255)
            emit(193)
            return
    if sl is 7
        if leaf8 is 1
            emit(73)
            emit(255)
            emit(194)
            return
    if sl is 8
        if leaf8 is 1
            emit(73)
            emit(255)
            emit(195)
            return
    # spilled local (sl > 4): inc straight in the frame slot,
    # one RMW instead of load+inc+store. cflush keeps any pending
    # constant honest first. loc_off(sl) is never 0 here, so the
    # modrm byte belongs to rbp and disp8/disp32 both reach.
    cflush(name)
    of: loc_off(sl)
    emit(72)
    emit(255)
    if of > 0 - 129
        emit(69)
        emit(of)
        return
    emit(133)
    emit4(of)
    return

intern s:
    s: unesc(s)
    i: 0
    as long as i < _sov_list_len(str_keys)
        if same(_sov_list_get(str_keys, i), s) is 1
            return _sov_list_get(str_pos, i)
        i: i + 1
    off: _sov_buf_len(strb)
    k: 0
    as long as k < length(s)
        strb: _sov_buf_u8(strb, _sov_byte_at(s, k))
        k: k + 1
    strb: _sov_buf_u8(strb, 0)
    str_keys: _sov_list_add(str_keys, s)
    str_pos: _sov_list_add(str_pos, off)
    return off

intern_nz s:
    s: unesc(s)
    i: 0
    as long as i < _sov_list_len(str_keys)
        if same(_sov_list_get(str_keys, i), s) is 1
            return _sov_list_get(str_pos, i)
        i: i + 1
    off: _sov_buf_len(strb)
    k: 0
    as long as k < length(s)
        strb: _sov_buf_u8(strb, _sov_byte_at(s, k))
        k: k + 1
    str_keys: _sov_list_add(str_keys, s)
    str_pos: _sov_list_add(str_pos, off)
    return off

is_imm s:
    n: length(s)
    if n is 0
        return 0
    i: 0
    if starts(s, "-") is 1
        i: 1
    if i >= n
        return 0
    as long as i < n
        if digit(letter(s, i)) is 0
            return 0
        i: i + 1
    return 1
# ---- const: compile-time evaluation of numeric expressions ----
# const(2 + 3 * 4) folds to a literal while the program is compiled:
# the value never touches the machine. What ceval cannot prove
# (names, calls, strings, a zero divisor) is a compile error, so a
# const is never silently a runtime value.
#
# Sovren names are file-global, so a recursive call overwrites every
# "local". ceval therefore reads no plain name after a call returns;
# ceval2 rides its operands on the cstk frame list so deeper frames
# cannot clobber them.

cval: 0
cvop: 0
cspl: 0
cstk: 0

lcut lst n:
    out: _sov_list_new()
    i: 0
    as long as i < n
        out: _sov_list_add(out, _sov_list_get(lst, i))
        i: i + 1
    return out

cnum s:
    e: strip(s)
    if length(e) is 0
        return 0
    i: 0
    if same(letter(e, 0), "-") is 1
        i: 1
    if i >= length(e)
        return 0
    as long as i < length(e)
        if digit(letter(e, i)) is 0
            return 0
        i: i + 1
    cval: _sov_atoi(e)
    return 1

# evaluate ls and rs, combine with op2 (10..15 compares, 20/21
# add/sub, 30/31/32 mul/div/mod). The frame rides cstk: nothing is
# read from a plain name after a recursive ceval returns.

cwrap s:
    e: strip(s)
    n: length(e)
    if n < 2
        return 0
    if same(letter(e, 0), "(") is 0
        return 0
    if same(letter(e, n - 1), ")") is 0
        return 0
    d: 1
    i: 1
    as long as i < n - 1
        if same(letter(e, i), "(") is 1
            d: d + 1
        if not
            if same(letter(e, i), ")") is 1
                d: d - 1
                if d is 0
                    return 0
        i: i + 1
    return 1

ceval2 ls rs op2:
    cstk: _sov_list_add(cstk, ls)
    cstk: _sov_list_add(cstk, rs)
    cstk: _sov_list_add(cstk, op2)
    if ceval(_sov_list_get(cstk, _sov_list_len(cstk) - 3)) is 0
        cstk: lcut(cstk, _sov_list_len(cstk) - 3)
        return 0
    cstk: _sov_list_add(cstk, cval)
    if ceval(_sov_list_get(cstk, _sov_list_len(cstk) - 3)) is 0
        cstk: lcut(cstk, _sov_list_len(cstk) - 4)
        return 0
    lv: _sov_list_get(cstk, _sov_list_len(cstk) - 1)
    rv: cval
    o2: _sov_list_get(cstk, _sov_list_len(cstk) - 2)
    cstk: lcut(cstk, _sov_list_len(cstk) - 4)
    if o2 is 10
        cval: 0
        if lv is rv
            cval: 1
    if not
        if o2 is 11
            cval: 0
            if lv is not rv
                cval: 1
        if not
            if o2 is 12
                cval: 0
                if lv < rv
                    cval: 1
            if not
                if o2 is 13
                    cval: 0
                    if lv >= rv
                        cval: 1
                if not
                    if o2 is 14
                        cval: 0
                        if lv < rv
                            cval: 1
                    if not
                        if o2 is 15
                            cval: 0
                            if lv > rv
                                cval: 1
                        if not
                            if o2 is 20
                                cval: lv + rv
                            if not
                                if o2 is 21
                                    cval: lv - rv
                                if not
                                    if o2 is 30
                                        cval: lv * rv
                                    if not
                                        if o2 is 31
                                            if rv is 0
                                                return 0
                                            cval: lv / rv
                                        if not
                                            if o2 is 32
                                                if rv is 0
                                                    return 0
                                            cval: lv % rv
    return 1

# compile-time numbers only: literals, unary minus, + - * / %,
# comparisons, nested const(), and brackets. names, calls, and
# text do not fold - they keep the runtime form, including any
# overflow trap the operator would have fired.
ceval s:
    e: strip(s)
    if length(e) is 0
        return 0
    if starts(e, "const(") is 1
        if same(letter(e, length(e) - 1), ")") is 1
            return ceval(cut(e, 6, length(e) - 1))
    if cnum(e) is 1
        return 1
    if cwrap(e) is 1
        return ceval(cut(e, 1, length(e) - 1))
    if same(letter(e, 0), "-") is 1
        if ceval(cut(e, 1, length(e))) is 1
            cval: 0 - cval
            return 1
    op: fop(e, "==")
    cvop: 10
    if op < 0
        op: fop(e, "!=")
        cvop: 11
    if op < 0
        op: fop(e, "<=")
        cvop: 12
    if op < 0
        op: fop(e, ">=")
        cvop: 13
    if op < 0
        op: fop(e, "<")
        cvop: 14
    if op < 0
        op: fop(e, ">")
        cvop: 15
    if op > 0 - 1
        if ceval2(cut(e, 0, op), cut(e, op + 2, length(e)), cvop) is 0
            return 0
        return 1
    cspl: 0
    pa: fop(e, "+")
    if pa > 0
        cspl: pa
        cvop: 20
    if cspl <= 0
        pm: fop(e, "-")
        if pm > 0
            cspl: pm
            cvop: 21
    if cspl > 0
        if ceval2(cut(e, 0, cspl), cut(e, cspl + 1, length(e)), cvop) is 0
            return 0
        return 1
    cspl: 0
    px: fop(e, "*")
    if px > 0
        cspl: px
        cvop: 30
    if cspl <= 0
        pd: fop(e, "/")
        if pd > 0
            cspl: pd
            cvop: 31
    if cspl <= 0
        pm: fop(e, "%")
        if pm > 0
            cspl: pm
            cvop: 32
    if cspl > 0
        if ceval2(cut(e, 0, cspl), cut(e, cspl + 1, length(e)), cvop) is 0
            return 0
        return 1
    return 0
# add/sub/imul with a signed 8-bit or 32-bit immediate; 0 - 1 when
# the value does not fit an immediate and the caller must fall back

is_task_hdr s:
    n: length(s)
    if n < 2
        return 0
    if peek_byte(s, 0) is 35
        return 0
    if peek_byte(s, n - 1) is 58
        return 1
    return 0

jae:
    emit(15)
    emit(131)
    at: here()
    emit4(0)
    br_at: _sov_list_add(br_at, at)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, at)
    br_st: _sov_list_add(br_st, 0)
    return at

