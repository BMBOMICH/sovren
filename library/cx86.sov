            bytes:
                76
                137
                208
            return
    if slot is 8
        if leaf8 is 1
            bytes:
                76
                137
                216
            return
    bytes:
        72
        139
        133
    put_4_bytes(loc_off(slot))

loadv name:
    cflush(name)
    g: idx(global_names, name)
    if g > 0 - 1
        if idx(local_names, name) < 0
            load_glob(name)
            return
    i: idx(local_names, name)
    if i > 0 - 1
        load_loc(i)
        return
    if g > 0 - 1
        load_glob(name)
        return
    print "Error: no such name" : name
    err_where
    suggest_name(name)
    saw_error: 1
    load_loc(slot(name))

loadv_rcx name:
    loadv(name)
    li: idx(local_names, name)
    if li > 0 - 1
        if li < 5
            if _sov_list_len(code) > 0
                lb: _sov_list_get(code, _sov_list_len(code) - 1)
                if lb is 216
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 217)
                if lb is 224
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 225)
                if lb is 232
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 233)
                if lb is 240
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 241)
                if lb is 248
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 249)
                return 0
    # a stack local, a constant or a global: the trailing byte of
    # loadv is not a register byte, so the rewrite above cannot fire.
    # rax already holds the value, so a plain move is enough.
    mov_rcx_rax
    return 0

# like loadv_rcx, but the value lands in rdi (the first call
# argument). The trailing mov rax, reg byte is rewritten in place.

loadv_rdi name:
    # pass 60: a pure global rides rip straight into the target
    # register - 48 8B 3D = mov rdi, [rip+disp] (row63), one op
    # instead of the loadv+mov_rdi_rax hop. cflush first, same as
    # loadv's own order; local_names keep precedence exactly like loadv.
    g9: idx(global_names, name)
    if g9 > 0 - 1
        if idx(local_names, name) < 0
            cflush(name)
            bytes:
                72
                139
                61
            at: here()
            put_4_bytes(0)
            later_fill(at, "grel", name)
            return 0
    loadv(name)
    li: idx(local_names, name)
    if li > 0 - 1
        if li < 5
            if _sov_list_len(code) > 0
                lb: _sov_list_get(code, _sov_list_len(code) - 1)
                if lb is 216
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 223)
                if lb is 224
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 231)
                if lb is 232
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 239)
                if lb is 240
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 247)
                if lb is 248
                    code: _sov_list_set(code, _sov_list_len(code) - 1, 255)
                return 0
    mov_rdi_rax
    return 0

# the value lands in rsi (the second call argument)

loadv_rdx name:
    # pass 64: the pass-60 treatment reaches rdx too - a pure
    # global loads straight, 48 8B 15 (GAS row66), no rax hop.
    g9: idx(global_names, name)
    if g9 > 0 - 1
        if idx(local_names, name) < 0
            cflush(name)
            bytes:
                72
                139
                21
            at: here()
            put_4_bytes(0)
            later_fill(at, "grel", name)
            return 0
    loadv(name)
    li: idx(local_names, name)
    if li > 0 - 1
        if li < 5
            if _sov_list_len(code) > 0
                lb: _sov_list_get(code, _sov_list_len(code) - 1)
                if lb is 216
