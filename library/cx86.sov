    emit(255)
    emit(254)
    emit(254)
    emit(254)
    emit(254)
    emit(254)
    emit(254)
    emit(254)
    emit(76)
    emit(1)
    emit(194)
    emit(72)
    emit(247)
    emit(209)
    emit(73)
    emit(185)
    emit(128)
    emit(128)
    emit(128)
