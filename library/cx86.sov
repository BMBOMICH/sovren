sq_square:
    # sq_name holds the atom. sq_acc 0 (pass 47's shape): rax =
    # atom*atom, accumulated into rcx; first term moves, later
    # terms add; the caller closes with mov rax, rcx. loadv may
    # materialise a deferred constant first - fine, rcx is
    # nowhere near that path. GAS-verified bytes:
    # imul rax,rax 48 0F AF C0, mov rcx,rax 48 89 C1,
    # add rcx,rax 48 01 C1, mov rax,rcx 48 89 C8.
    # sq_acc 1 (pass 66, gated at the call site to atoms that all
    # ride register slots and are cflush-ed up front): the
    # accumulator IS rax - the first square is the initialisation
    # itself, later squares form in rcx (direct slot load, row69;
    # imul rcx,rcx 48 0F AF C9, add rax,rcx 48 01 C8, row68).
    # kills the accumulator hop and the closing contract mov.
    if sq_acc is 1
        if sq_first is 1
            loadv(sq_name)
            bytes:
                72
                15
                175
                192
            return 0
        hh: homereg(sq_name)
        if hh > 0 - 1
            emit_mov_rcx_h(hh)
            bytes:
                72
                15
                175
                201
                72
                1
                200
            return 0
        # unreachable by the gate; never take chances with rax
        print "Error: sum-of-squares register folding failed"
        err_where
        saw_error: 1
        return 0
    loadv(sq_name)
    bytes:
        72
        15
        175
        192
    if sq_first is 1
        bytes:
            72
            137
            193
        return 0
    bytes:
        72
        1
        193
    return 0
