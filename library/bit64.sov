# bit64.sov — bitwise ops on the machine's own opcodes
#
# These were 32-step loops over % and /, because the language had no
# bit operators to write them with. band/bor/bxor/bshl/bshr/bsar are
# compiler builtins now - one and/orr/eor/lsl/lsr/asr each - on all
# six targets. The old answers are kept exactly: the loops only ever
# produced the low 32 bits, so the result is still cut to 32, and a
# shift by 64 or more still gives 0 rather than the machine's
# count-modulo-64.

M32B: 4294967296

bit_and a b:
    return band(a, b) % M32B

bit_or a b:
    return bor(a, b) % M32B

bit_xor a b:
    return bxor(a, b) % M32B

bit_not8 a:
    return 255 - (a % 256)

bit_shl a n:
    if n >= 64
        return 0
    if n < 0
        return a
    return bshl(a, n)

# the old loop divided by two, which truncates toward zero: that is an
# arithmetic shift, so a negative keeps its sign exactly as before
bit_shr a n:
    if n >= 64
        return 0
    if n < 0
        return a
    return bsar(a, n)

bit_xor8 a b:
    return bxor(a % 256, b % 256) % 256
