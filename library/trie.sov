# trie.sov — word lookup by prefix
use list
use string
use vec

tr_new:
    l: list_new()
    l: list_add(l, list_new())
    return l

tr_words t:
    return list_get(t, 0)

tr_add t w:
    ws: tr_words(t)
    ws: list_add(ws, w)
    list_set(t, 0, ws)
    return t

tr_has t w:
    ws: tr_words(t)
    i: 0
    as long as i < list_len(ws)
        if str_eq(list_get(ws, i), w) is 1
            return 1
        i: i + 1
    return 0

tr_count t:
    return list_len(tr_words(t))

tr_starting t pre:
    ws: tr_words(t)
    out: list_new()
    i: 0
    as long as i < list_len(ws)
        if str_starts(list_get(ws, i), pre) is 1
            out: list_add(out, list_get(ws, i))
        i: i + 1
    return out
