# sha256.sov — real SHA-256 in pure Sovren
# Batteries, not certified: review before production crypto.
use bit32
use string
use mem

sha_ch x y z:
    return wxor(wand(x, y), wand(wnot(x), z))

sha_maj x y z:
    return wxor(wxor(wand(x, y), wand(x, z)), wand(y, z))

sha_bs0 x:
    return wxor(wxor(rotr(x, 2), rotr(x, 13)), rotr(x, 22))

sha_bs1 x:
    return wxor(wxor(rotr(x, 6), rotr(x, 11)), rotr(x, 25))

sha_ss0 x:
    return wxor(wxor(rotr(x, 7), rotr(x, 18)), shr(x, 3))

sha_ss1 x:
    return wxor(wxor(rotr(x, 17), rotr(x, 19)), shr(x, 10))

