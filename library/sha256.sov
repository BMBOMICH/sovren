sha256_bytes data n out:
    _sha26c25bb_tot: n + 9
    as long as _sha26c25bb_tot % 64 is not 0
        _sha26c25bb_tot: _sha26c25bb_tot + 1
    _sha26c25bb_buf: _sov_alloc(_sha26c25bb_tot + 8)
    _sha26c25bb_i: n
    mem_copy(_sha26c25bb_buf, data, n)
    poke_byte(_sha26c25bb_buf, n, 128)
    _sha26c25bb_i: n + 1
    as long as _sha26c25bb_i < _sha26c25bb_tot
        poke_byte(_sha26c25bb_buf, _sha26c25bb_i, 0)
        _sha26c25bb_i: _sha26c25bb_i + 1
    _sha26c25bb_bits: n * 8
    poke_byte(_sha26c25bb_buf, _sha26c25bb_tot - 1, _sha26c25bb_bits % 256)
    poke_byte(_sha26c25bb_buf, _sha26c25bb_tot - 2, (_sha26c25bb_bits / 256) % 256)
    poke_byte(_sha26c25bb_buf, _sha26c25bb_tot - 3, (_sha26c25bb_bits / 65536) % 256)
    poke_byte(_sha26c25bb_buf, _sha26c25bb_tot - 4, (_sha26c25bb_bits / 16777216) % 256)
    _sha26c25bb_h0: 1779033703
    _sha26c25bb_h1: 3144134277
    _sha26c25bb_h2: 1013904242
    _sha26c25bb_h3: 2773480762
    _sha26c25bb_h4: 1359893119
    _sha26c25bb_h5: 2600822924
    _sha26c25bb_h6: 528734635
    _sha26c25bb_h7: 1541459225
    _sha26c25bb_w: _sov_alloc(64 * 8)
    _sha26c25bb_blk: 0
    as long as _sha26c25bb_blk < _sha26c25bb_tot
        _sha26c25bb_t: 0
        as long as _sha26c25bb_t < 16
            _sha26c25bb_b0: peek_byte(_sha26c25bb_buf, _sha26c25bb_blk + _sha26c25bb_t * 4)
            _sha26c25bb_b1: peek_byte(_sha26c25bb_buf, _sha26c25bb_blk + _sha26c25bb_t * 4 + 1)
            _sha26c25bb_b2: peek_byte(_sha26c25bb_buf, _sha26c25bb_blk + _sha26c25bb_t * 4 + 2)
            _sha26c25bb_b3: peek_byte(_sha26c25bb_buf, _sha26c25bb_blk + _sha26c25bb_t * 4 + 3)
            poke_i64(_sha26c25bb_w, _sha26c25bb_t * 8, _sha26c25bb_b0 * 16777216 + _sha26c25bb_b1 * 65536 + _sha26c25bb_b2 * 256 + _sha26c25bb_b3)
            _sha26c25bb_t: _sha26c25bb_t + 1
        _sha26c25bb_t: 16
        as long as _sha26c25bb_t < 64
            _sha26c25bb_v1: sha_ss1(peek_i64(_sha26c25bb_w, (_sha26c25bb_t - 2) * 8))
            _sha26c25bb_v2: peek_i64(_sha26c25bb_w, (_sha26c25bb_t - 7) * 8)
            _sha26c25bb_v3: sha_ss0(peek_i64(_sha26c25bb_w, (_sha26c25bb_t - 15) * 8))
            _sha26c25bb_v4: peek_i64(_sha26c25bb_w, (_sha26c25bb_t - 16) * 8)
            poke_i64(_sha26c25bb_w, _sha26c25bb_t * 8, wadd(wadd(_sha26c25bb_v1, _sha26c25bb_v2), wadd(_sha26c25bb_v3, _sha26c25bb_v4)))
            _sha26c25bb_t: _sha26c25bb_t + 1
        _sha26c25bb_a: _sha26c25bb_h0
        _sha26c25bb_b: _sha26c25bb_h1
        _sha26c25bb_c: _sha26c25bb_h2
        _sha26c25bb_d: _sha26c25bb_h3
        _sha26c25bb_e: _sha26c25bb_h4
        _sha26c25bb_f: _sha26c25bb_h5
        _sha26c25bb_g: _sha26c25bb_h6
        _sha26c25bb_hh: _sha26c25bb_h7
        _sha26c25bb_t: 0
        as long as _sha26c25bb_t < 64
            _sha26c25bb_t1: wadd(wadd(wadd(_sha26c25bb_hh, sha_bs1(_sha26c25bb_e)), wadd(sha_ch(_sha26c25bb_e, _sha26c25bb_f, _sha26c25bb_g), sha_k(_sha26c25bb_t))), peek_i64(_sha26c25bb_w, _sha26c25bb_t * 8))
            _sha26c25bb_t2: wadd(sha_bs0(_sha26c25bb_a), sha_maj(_sha26c25bb_a, _sha26c25bb_b, _sha26c25bb_c))
            _sha26c25bb_hh: _sha26c25bb_g
            _sha26c25bb_g: _sha26c25bb_f
            _sha26c25bb_f: _sha26c25bb_e
            _sha26c25bb_e: wadd(_sha26c25bb_d, _sha26c25bb_t1)
            _sha26c25bb_d: _sha26c25bb_c
            _sha26c25bb_c: _sha26c25bb_b
            _sha26c25bb_b: _sha26c25bb_a
            _sha26c25bb_a: wadd(_sha26c25bb_t1, _sha26c25bb_t2)
            _sha26c25bb_t: _sha26c25bb_t + 1
        _sha26c25bb_h0: wadd(_sha26c25bb_h0, _sha26c25bb_a)
        _sha26c25bb_h1: wadd(_sha26c25bb_h1, _sha26c25bb_b)
        _sha26c25bb_h2: wadd(_sha26c25bb_h2, _sha26c25bb_c)
        _sha26c25bb_h3: wadd(_sha26c25bb_h3, _sha26c25bb_d)
        _sha26c25bb_h4: wadd(_sha26c25bb_h4, _sha26c25bb_e)
        _sha26c25bb_h5: wadd(_sha26c25bb_h5, _sha26c25bb_f)
        _sha26c25bb_h6: wadd(_sha26c25bb_h6, _sha26c25bb_g)
        _sha26c25bb_h7: wadd(_sha26c25bb_h7, _sha26c25bb_hh)
        _sha26c25bb_blk: _sha26c25bb_blk + 64
    poke_i64(out, 0, _sha26c25bb_h0)
    poke_i64(out, 8, _sha26c25bb_h1)
    poke_i64(out, 16, _sha26c25bb_h2)
    poke_i64(out, 24, _sha26c25bb_h3)
    poke_i64(out, 32, _sha26c25bb_h4)
    poke_i64(out, 40, _sha26c25bb_h5)
    poke_i64(out, 48, _sha26c25bb_h6)
    poke_i64(out, 56, _sha26c25bb_h7)
sha_hexd v:
    if v < 10 -> return v + 48
    return v + 87
sha256_hex text:
    _sha2cc7a6f_n: _sov_strlen(text)
    _sha2cc7a6f_hs: _sov_heap_alloc(64)
    sha256_bytes(text, _sha2cc7a6f_n, _sha2cc7a6f_hs)
    _sha2cc7a6f_out: _sov_heap_alloc(72)
    _sha2cc7a6f_i: 0
    as long as _sha2cc7a6f_i < 8
        _sha2cc7a6f_v: peek_i64(_sha2cc7a6f_hs, _sha2cc7a6f_i * 8)
        _sha2cc7a6f_j: 0
        as long as _sha2cc7a6f_j < 8
            _sha2cc7a6f_sh: 28 - _sha2cc7a6f_j * 4
            _sha2cc7a6f_nib: wand(shr(_sha2cc7a6f_v, _sha2cc7a6f_sh), 15)
            poke_byte(_sha2cc7a6f_out, _sha2cc7a6f_i * 8 + _sha2cc7a6f_j, sha_hexd(_sha2cc7a6f_nib))
            _sha2cc7a6f_j: _sha2cc7a6f_j + 1
        _sha2cc7a6f_i: _sha2cc7a6f_i + 1
    poke_byte(_sha2cc7a6f_out, 64, 0)
    return as text _sha2cc7a6f_out
