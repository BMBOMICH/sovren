md5_s i:
    if i < 16
        if wand(i, 3) is 0 -> return 7
        if wand(i, 3) is 1 -> return 12
        if wand(i, 3) is 2 -> return 17
        return 22
    if i < 32
        if wand(i, 3) is 0 -> return 5
        if wand(i, 3) is 1 -> return 9
        if wand(i, 3) is 2 -> return 14
        return 20
    if i < 48
        if wand(i, 3) is 0 -> return 4
        if wand(i, 3) is 1 -> return 11
        if wand(i, 3) is 2 -> return 16
        return 23
    if wand(i, 3) is 0 -> return 6
    if wand(i, 3) is 1 -> return 10
    if wand(i, 3) is 2 -> return 15
    return 21
md5_midx i:
    if i < 16 -> return i
    if i < 32 -> return wand(1 + i * 5, 15)
    if i < 48 -> return wand(5 + i * 3, 15)
    return wand(i * 7, 15)
md5_rotl x n:
    return wor(shl(x, n), shr(x, 32 - n))
md5_bytes data n:
    tot: n + 9
    as long as tot % 64 is not 0
        tot: tot + 1
    buf: _sov_heap_alloc(tot + 8)
    mem_copy(buf, data, n)
    poke_byte(buf, n, 128)
    i: n + 1
    as long as i < tot
        poke_byte(buf, i, 0)
        i: i + 1
    bits: n * 8
    poke_byte(buf, tot - 8, bits % 256)
    poke_byte(buf, tot - 7, (bits / 256) % 256)
    poke_byte(buf, tot - 6, (bits / 65536) % 256)
    poke_byte(buf, tot - 5, (bits / 16777216) % 256)
    h0: 1732584193
    h1: 4023233417
    h2: 2562383102
    h3: 271733878
    w: _sov_alloc(16 * 8)
    blk: 0
    as long as blk < tot
        t: 0
        as long as t < 16
            b0: peek_byte(buf, blk + t * 4)
            b1: peek_byte(buf, blk + t * 4 + 1)
            b2: peek_byte(buf, blk + t * 4 + 2)
            b3: peek_byte(buf, blk + t * 4 + 3)
            poke_i64(w, t * 8, b3 * 16777216 + b2 * 65536 + b1 * 256 + b0)
            t: t + 1
        a: h0
        b: h1
        c: h2
        d: h3
        i: 0
        as long as i < 64
            if i < 16 -> f: wor(wand(b, c), wand(wnot(b), d))
            if not
                if i < 32 -> f: wor(wand(b, d), wand(c, wnot(d)))
                if not
                    if i < 48 -> f: wxor(wxor(b, c), d)
                    if not -> f: wxor(c, wor(b, wnot(d)))
            tmp: wadd(wadd(a, f), wadd(md5_k(i), peek_i64(w, md5_midx(i) * 8)))
            tmp: wadd(b, md5_rotl(tmp, md5_s(i)))
            a: d
            d: c
            c: b
            b: tmp
            i: i + 1
        h0: wadd(h0, a)
        h1: wadd(h1, b)
        h2: wadd(h2, c)
        h3: wadd(h3, d)
        blk: blk + 64
    out: _sov_alloc(16)
    ws: _sov_alloc(32)
    poke_i64(ws, 0, h0)
    poke_i64(ws, 8, h1)
    poke_i64(ws, 16, h2)
    poke_i64(ws, 24, h3)
    i: 0
    as long as i < 4
        v: peek_i64(ws, i * 8)
        poke_byte(out, i * 4, wand(v, 255))
        poke_byte(out, i * 4 + 1, wand(shr(v, 8), 255))
        poke_byte(out, i * 4 + 2, wand(shr(v, 16), 255))
        poke_byte(out, i * 4 + 3, wand(shr(v, 24), 255))
        i: i + 1
    return out
md5_hex text:
    d: md5_bytes(text, str_len(text))
    s: ""
    i: 0
    as long as i < 16
        b: peek_byte(d, i)
        hi: b / 16
        lo: b % 16
        h1: "0123456789abcdef"
        s: str_cat(s, str_sub(h1, hi, hi + 1))
        s: str_cat(s, str_sub(h1, lo, lo + 1))
        i: i + 1
    return s
hmac_md5 key klen msg mlen out:
    kb: _sov_heap_alloc(64)
    if klen > 64
        db: md5_bytes(key, klen)
        i: 0
        as long as i < 64
            poke_byte(kb, i, 0)
            i: i + 1
        i: 0
        as long as i < 16
            poke_byte(kb, i, peek_byte(db, i))
            i: i + 1
    if not
        i: 0
        as long as i < 64
            poke_byte(kb, i, 0)
            i: i + 1
        i: 0
        as long as i < klen
            poke_byte(kb, i, peek_byte(key, i))
            i: i + 1
    inner: _sov_alloc(64 + mlen + 16)
    i: 0
    as long as i < 64
        poke_byte(inner, i, wxor(peek_byte(kb, i), 54))
        i: i + 1
    i: 0
    as long as i < mlen
        poke_byte(inner, 64 + i, peek_byte(msg, i))
        i: i + 1
    ib: md5_bytes(inner, 64 + mlen)
    outer: _sov_alloc(64 + 16)
    i: 0
    as long as i < 64
        poke_byte(outer, i, wxor(peek_byte(kb, i), 92))
        i: i + 1
    i: 0
    as long as i < 16
        poke_byte(outer, 64 + i, peek_byte(ib, i))
        i: i + 1
    ob: md5_bytes(outer, 80)
    i: 0
    as long as i < 16
        poke_byte(out, i, peek_byte(ob, i))
        i: i + 1
