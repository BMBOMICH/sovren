use file
use string
use pbkdf2
use hex
use constant
use token
use store
use mem
use secret
use num
use bit32
auth_num s:
    v: 0
    i: 0
    n: str_len(s)
    as long as i < n
        c: peek_byte(s, i)
        if c < 48 -> return 0
        if c > 57 -> return 0
        v: v * 10 + c - 48
        i: i + 1
    return v
auth_mix salt pass iters:
    o: _sov_alloc(32)
    private
    pbkdf2_sha256(pass, _sov_strlen(pass), salt, _sov_strlen(salt), iters, 32, o)
    r: hex_from_bytes(o, 32)
    secret_wipe_bytes(o, 32)
    return r
auth_line name pass iters:
    salt: token_hex(32)
    h: auth_mix(salt, pass, iters)
    a: str_join3(name, "|", salt)
    b: str_cat(a, "|")
    c: str_cat(b, num_text(iters))
    d: str_cat(c, "|")
    return as text str_cat(d, h)
auth_add_iters path name pass iters:
    x: str_cat(auth_line(name, pass, iters), "\n")
    return file_append_secret(path, x)
auth_add path name pass:
    return auth_add_iters(path, name, pass, 1000)
auth_find text name:
    want: str_cat(name, "|")
    n: str_len(text)
    line: 0
    i: 0
    as long as i < n
        if peek_byte(text, i) is 10
            if str_starts(str_cut(text, line, i), want) is 1 -> return str_cut(text, line, i)
            line: i + 1
        i: i + 1
    if line < n
        if str_starts(str_cut(text, line, n), want) is 1 -> return str_cut(text, line, n)
    return blank
auth_check path name pass:
    private
    text: file_read_all(path)
    if text is 0 -> return 0
    line: auth_find(text, name)
    if str_empty(line) is 1 -> return 0
    p1: str_find(line, "|")
    if p1 < 0 -> return 0
    rest: str_cut(line, p1 + 1, str_len(line))
    p2: str_find(rest, "|")
    if p2 < 0 -> return 0
    salt: str_cut(rest, 0, p2)
    rest2: str_cut(rest, p2 + 1, str_len(rest))
    p3: str_find(rest2, "|")
    if p3 < 0 -> return 0
    iters: auth_num(str_cut(rest2, 0, p3))
    if iters < 1 -> return 0
    want_hex: str_cut(rest2, p3 + 1, str_len(rest2))
    if str_len(want_hex) is not 64 -> return 0
    hexn: 0
    q: 0
    as long as q < 64
        cc: peek_byte(want_hex, q)
        good: 0
        if cc >= 48
            if cc <= 57 -> good: 1
        if cc >= 97
            if cc <= 102 -> good: 1
        hexn: hexn + good
        q: q + 1
    if hexn is not 64 -> return 0
    want: hex_to_bytes(want_hex)
    o: _sov_alloc(32)
    pbkdf2_sha256(pass, _sov_strlen(pass), salt, _sov_strlen(salt), iters, 32, o)
    r: ct_eq(want, o, 32)
    secret_wipe_bytes(o, 32)
    return r
