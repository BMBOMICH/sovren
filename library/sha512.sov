s64_ch x y z:
    return bxor(band(x, y), band(bxor(x, 0 - 1), z))
s64_maj x y z:
    return bxor(bxor(band(x, y), band(x, z)), band(y, z))
s64_rot x n:
    return bor(bshr(x, n), bshl(x, 64 - n))
s64_bs0 x:
    return bxor(bxor(s64_rot(x, 28), s64_rot(x, 34)), s64_rot(x, 39))
s64_bs1 x:
    return bxor(bxor(s64_rot(x, 14), s64_rot(x, 18)), s64_rot(x, 41))
s64_ss0 x:
    return bxor(bxor(s64_rot(x, 1), s64_rot(x, 8)), bshr(x, 7))
s64_ss1 x:
    return bxor(bxor(s64_rot(x, 19), s64_rot(x, 61)), bshr(x, 6))
sha512_bytes data n out:
    tot: n + 17
    as long as tot % 128 is not 0
        tot: tot + 1
    buf: _sov_alloc(tot + 16)
    mem_copy(buf, data, n)
    poke_byte(buf, n, 128)
    i: n + 1
    as long as i < tot
        poke_byte(buf, i, 0)
        i: i + 1
    bits: n * 8
    i: 0
    as long as i < 8
        poke_byte(buf, tot - 1 - i, (bits / bshl(1, i * 8)) % 256)
        i: i + 1
    h0: s64_iv(0)
    h1: s64_iv(1)
    h2: s64_iv(2)
    h3: s64_iv(3)
    h4: s64_iv(4)
    h5: s64_iv(5)
    h6: s64_iv(6)
    h7: s64_iv(7)
    w: _sov_alloc(80 * 8)
    blk: 0
    as long as blk < tot
        t: 0
        as long as t < 16
            v: 0
            j: 0
            as long as j < 8
                v: v * 256 + peek_byte(buf, blk + t * 8 + j)
                j: j + 1
            poke_i64(w, t * 8, v)
            t: t + 1
        t: 16
        as long as t < 80
            v1: s64_ss1(peek_i64(w, (t - 2) * 8))
            v2: peek_i64(w, (t - 7) * 8)
            v3: s64_ss0(peek_i64(w, (t - 15) * 8))
            v4: peek_i64(w, (t - 16) * 8)
            poke_i64(w, t * 8, v1 + v2 + v3 + v4)
            t: t + 1
        a: h0
        b: h1
        c: h2
        dd: h3
        e: h4
        f: h5
        g: h6
        hh: h7
        t: 0
        as long as t < 80
            s1: s64_bs1(e)
            ch: s64_ch(e, f, g)
            t1: hh + s1 + ch + s64_k(t) + peek_i64(w, t * 8)
            s0: s64_bs0(a)
            mj: s64_maj(a, b, c)
            t2: s0 + mj
            hh: g
            g: f
            f: e
            e: dd + t1
            dd: c
            c: b
            b: a
            a: t1 + t2
            t: t + 1
        h0: h0 + a
        h1: h1 + b
        h2: h2 + c
        h3: h3 + dd
        h4: h4 + e
        h5: h5 + f
        h6: h6 + g
        h7: h7 + hh
        blk: blk + 128
    hs: _sov_alloc(64)
    poke_i64(hs, 0, h0)
    poke_i64(hs, 8, h1)
    poke_i64(hs, 16, h2)
    poke_i64(hs, 24, h3)
    poke_i64(hs, 32, h4)
    poke_i64(hs, 40, h5)
    poke_i64(hs, 48, h6)
    poke_i64(hs, 56, h7)
    i: 0
    as long as i < 8
        v: peek_i64(hs, i * 8)
        j: 0
        as long as j < 8
            poke_byte(out, i * 8 + j, bshr(v, 56 - j * 8) % 256)
            j: j + 1
        i: i + 1
