# csv.sov — read and write comma separated lines
use string
use list

# split one CSV line on commas. Fields with commas, quotes or
# newlines in them must be quoted; this understands the quoting.
csv_split line:
    return csv_parse(line)

csv_parse line:
    lst: list_new()
    n: str_len(line)
    i: 0
    start: 0
    inq: 0
    as long as i < n
        c: peek_byte(line, i)
        if inq is 1
            if c is 34
                if i + 1 < n
                    if peek_byte(line, i + 1) is 34
                        i: i + 1
                    if not
                        inq: 0
                if not
                    inq: 0
        if not
            if c is 34
                inq: 1
            if not
                if c is 44
                    lst: list_add(lst, csv_unquote(str_cut(line, start, i)))
                    start: i + 1
        i: i + 1
    lst: list_add(lst, csv_unquote(str_cut(line, start, n)))
    return lst

# take the quotes off one field, and turn doubled quotes back
csv_unquote f:
    n: str_len(f)
    if n >= 2
        if peek_byte(f, 0) is 34
            if peek_byte(f, n - 1) is 34
                g: str_cut(f, 1, n - 1)
                o: _sov_alloc(n + 1)
                j: 0
                i: 0
                m: str_len(g)
                as long as i < m
                    if peek_byte(g, i) is 34
                        if i + 1 < m
                            if peek_byte(g, i + 1) is 34
                                poke_byte(o, j, 34)
                                j: j + 1
                                i: i + 2
                            if not
                                poke_byte(o, j, 34)
                                j: j + 1
                                i: i + 1
                    if not
                        poke_byte(o, j, peek_byte(g, i))
                        j: j + 1
                        i: i + 1
                poke_byte(o, j, 0)
                return as text o
    return f

# join a list back into one line, quoting anything that needs it
csv_join lst:
    n: list_len(lst)
    out: ""
    i: 0
    as long as i < n
        f: csv_quote(list_get(lst, i))
        if i is 0
            out: f
        if not
            out: str_cat(out, ",")
            out: str_cat(out, f)
        i: i + 1
    return out

# one field quoted if it has to be
csv_quote f:
    need: 0
    i: 0
    n: str_len(f)
    as long as i < n
        c: peek_byte(f, i)
        if c is 44
            need: 1
        if not
            if c is 34
                need: 1
            if not
                if c is 10
                    need: 1
                if not
                    if c is 13
                        need: 1
        i: i + 1
    if need is 0
        return f
    o: _sov_alloc(n * 2 + 3)
    poke_byte(o, 0, 34)
    j: 1
    i: 0
    as long as i < n
        c: peek_byte(f, i)
        if c is 34
            poke_byte(o, j, 34)
            poke_byte(o, j + 1, 34)
            j: j + 2
        if not
            poke_byte(o, j, c)
            j: j + 1
        i: i + 1
    poke_byte(o, j, 34)
    poke_byte(o, j + 1, 0)
    return as text o
