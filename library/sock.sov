# sock.sov — TCP sockets
# AF_INET=2 SOCK_STREAM=1

use sys
use num
sock_tcp:
    return sys_socket(2, 1, 0)

sock_addr4 ip0 ip1 ip2 ip3 port:
    a: _sov_alloc(16)
    i: 0
    as long as i < 16
        poke_byte(a, i, 0)
        i: i + 1
    poke_u16(a, 0, 2)
    poke_u16(a, 2, htons(port))
    poke_byte(a, 4, ip0)
    poke_byte(a, 5, ip1)
    poke_byte(a, 6, ip2)
    poke_byte(a, 7, ip3)
    return a

sock_listen port:
    fd: sock_tcp()
    if fd < 0
        return 0 - 1
    addr: sock_addr4(0, 0, 0, 0, port)
    if sys_bind(fd, addr, 16) < 0
        sys_close(fd)
        return 0 - 1
    if sys_listen(fd, 16) < 0
        sys_close(fd)
        return 0 - 1
    return fd

sock_accept fd:
    return sys_accept(fd, 0, 0)

sock_connect ip0 ip1 ip2 ip3 port:
    fd: sock_tcp()
    if fd < 0
        return 0 - 1
    addr: sock_addr4(ip0, ip1, ip2, ip3, port)
    if sys_connect(fd, addr, 16) < 0
        sys_close(fd)
        return 0 - 1
    return fd

sock_send fd s:
    return sys_send(fd, s, _sov_strlen(s))

sock_recv fd n:
    buf: _sov_alloc(n + 1)
    g: sys_recv(fd, buf, n)
    if g < 0
        poke_byte(buf, 0, 0)
        return as text buf
    poke_byte(buf, g, 0)
    return as text buf

sock_close fd:
    return sys_close(fd)

# raw send and receive for binary data (TLS records have zeros in
# them, so the text forms cannot carry them)
sock_send_raw fd buf n:
    return sys_send(fd, buf, n)

sock_recv_raw fd buf n:
    g: sys_recv(fd, buf, n)
    if g < 0
        return 0 - 1
    return g
