# winwin.sov — a real window on Windows.
#
# The companion to win.sov, which does the same on Linux. That one
# speaks to the X server over a socket; this one calls user32 and
# gdi32, which is how Windows does it.
#
# Neither needs anything installed. win.sov needs no library at all
# because X11 is a protocol; this one needs user32 and gdi32, which
# are part of Windows and always there.
#
#   use winwin
#   main:
#       w: ww_open(400, 300, "Hello")
#       if w is 0
#           print "no windows here"
#           stop
#       as long as ww_next(w) is 1
#           ww_fill(w, 0, 0, 400, 300, 16777215)
#           ww_text(w, 20, 20, "Hello from Sovren", 0)
#           ww_show(w)
#
# Only a program built with --windows can use this. Anywhere else
# ww_open hands back nought.
#
# The block:
#    0 the window handle    8 the drawing handle
#   16 how wide            24 how tall
#   32 still going         40 the last key
#   48 the mouse x         56 the mouse y
#   64 the message block   72 the paint block
#   80 the brush in use   88 the last brush colour

use winapi
use sys
use string
use mem
use num
# poke_u32 and peek_u32 come from num and winapi

# the pieces of Windows this needs
ww_user: 0
ww_gdi: 0
ww_f_reg: 0
ww_f_create: 0
ww_f_defproc: 0
ww_f_show: 0
ww_f_update: 0
ww_f_peek: 0
ww_f_translate: 0
ww_f_dispatch: 0
ww_f_getdc: 0
ww_f_releasedc: 0
ww_f_invalidate: 0
ww_f_destroy: 0
ww_f_brush: 0
ww_f_fillrect: 0
ww_f_delete: 0
ww_f_textout: 0
ww_f_settextcolor: 0
ww_f_setbkmode: 0
ww_f_moveto: 0
ww_f_lineto: 0
ww_f_pen: 0
ww_f_select: 0
ww_f_ellipse: 0
ww_f_getmodule: 0
ww_f_cursor: 0
ww_f_getmsg: 0
ww_f_move: 0
ww_f_quit: 0
ww_f_font: 0
ww_f_extent: 0
ww_f_iswindow: 0
ww_f_exit: 0
ww_f_compdc: 0
ww_f_compbmp: 0
ww_f_bitblt: 0
ww_f_deldc: 0
ww_f_dpi: 0
ww_f_timer: 0
ww_f_icon: 0
ww_loaded: 0

# Find everything, once. Hands back nought when this is not
# Windows, or when the libraries are not there.
ww_load:
    if ww_loaded is 1
        return 1
    if ww_loaded is 0 - 1
        return 0
    ww_loaded: 0 - 1
    if dll_ok() is 0
        return 0
    ww_user: dll_open("user32.dll")
    ww_gdi: dll_open("gdi32.dll")
    k32: dll_open("kernel32.dll")
    if ww_user is 0
        return 0
    if ww_gdi is 0
        return 0
    ww_f_reg: dll_find(ww_user, "RegisterClassExA")
    ww_f_create: dll_find(ww_user, "CreateWindowExA")
    ww_f_defproc: dll_find(ww_user, "DefWindowProcA")
    ww_f_show: dll_find(ww_user, "ShowWindow")
    ww_f_update: dll_find(ww_user, "UpdateWindow")
    ww_f_peek: dll_find(ww_user, "PeekMessageA")
    ww_f_translate: dll_find(ww_user, "TranslateMessage")
    ww_f_dispatch: dll_find(ww_user, "DispatchMessageA")
    ww_f_getdc: dll_find(ww_user, "GetDC")
    ww_f_releasedc: dll_find(ww_user, "ReleaseDC")
    ww_f_invalidate: dll_find(ww_user, "InvalidateRect")
    ww_f_destroy: dll_find(ww_user, "DestroyWindow")
    ww_f_brush: dll_find(ww_gdi, "CreateSolidBrush")
    ww_f_fillrect: dll_find(ww_user, "FillRect")
    ww_f_delete: dll_find(ww_gdi, "DeleteObject")
    ww_f_textout: dll_find(ww_gdi, "TextOutA")
    ww_f_settextcolor: dll_find(ww_gdi, "SetTextColor")
    ww_f_setbkmode: dll_find(ww_gdi, "SetBkMode")
    ww_f_moveto: dll_find(ww_gdi, "MoveToEx")
    ww_f_lineto: dll_find(ww_gdi, "LineTo")
    ww_f_pen: dll_find(ww_gdi, "CreatePen")
    ww_f_select: dll_find(ww_gdi, "SelectObject")
    ww_f_ellipse: dll_find(ww_gdi, "Ellipse")
    ww_f_getmsg: dll_find(ww_user, "GetMessageA")
    ww_f_move: dll_find(ww_user, "MoveWindow")
    ww_f_quit: dll_find(ww_user, "PostQuitMessage")
    ww_f_font: dll_find(ww_gdi, "CreateFontIndirectA")
    ww_f_cursor: dll_find(ww_user, "LoadCursorA")
    ww_f_extent: dll_find(ww_gdi, "GetTextExtentPoint32A")
    ww_f_iswindow: dll_find(ww_user, "IsWindow")
    ww_f_compdc: dll_find(ww_gdi, "CreateCompatibleDC")
    ww_f_compbmp: dll_find(ww_gdi, "CreateCompatibleBitmap")
    ww_f_bitblt: dll_find(ww_gdi, "BitBlt")
    ww_f_deldc: dll_find(ww_gdi, "DeleteDC")
    ww_f_timer: dll_find(ww_user, "SetTimer")
    ww_f_icon: dll_find(ww_user, "LoadIconA")
    ww_f_dpi: dll_find(ww_user, "SetProcessDPIAware")
    ww_f_getmodule: 0
    ww_f_exit: 0
    if k32 is not 0
        ww_f_getmodule: dll_find(k32, "GetModuleHandleA")
        ww_f_exit: dll_find(k32, "ExitProcess")
    if ww_f_dpi is not 0
        wincall0(ww_f_dpi)
    if ww_f_create is 0
        return 0
    if ww_f_fillrect is 0
        return 0
    if ww_f_reg is 0
        return 0
    ww_loaded: 1
    return 1

ww_ready:
    if ww_load() is 1
        return 1
    return 0

# ---------------------------------------------------------------
# opening one
# ---------------------------------------------------------------
#
# Windows wants a window class registered first, which says what
# the window looks like and which job answers its messages. The
# answering job here is DefWindowProcA, the one Windows itself
# provides, so nothing has to be handed back into Sovren. Messages
# are then collected by asking rather than being pushed, which is
# what lets a Sovren loop stay in charge.

WW_CLASS: "SovrenWindow"
WW_STYLE: 0

ww_open width height title:
    if ww_load() is 0
        return 0
    inst: 0
    if ww_f_getmodule is not 0
        inst: wincall1(ww_f_getmodule, 0)
    cur: 0
    if ww_f_cursor is not 0
        cur: wincall2(ww_f_cursor, 0, 32513)
    # WNDCLASSEXA: cbSize 80, style CS_HREDRAW|CS_VREDRAW, lpfnWndProc,
    # hInstance at 24, hCursor at 40, hbrBackground COLOR_WINDOW+1 at 48,
    # lpszClassName at 64
    wc: mem_new(96)
    i: 0
    as long as i < 96
        poke_byte(wc, i, 0)
        i: i + 1
    poke_u32(wc, 0, 80)
    poke_u32(wc, 4, 3)
    poke_i64(wc, 8, ww_f_defproc)
    poke_i64(wc, 24, inst)
    poke_i64(wc, 40, cur)
    if ww_f_icon is not 0
        ic: wincall2(ww_f_icon, 0, 32512)
        poke_i64(wc, 32, ic)
        poke_i64(wc, 72, ic)
    bgb: 6
    if ww_f_brush is not 0
        bgb: wincall1(ww_f_brush, 789516)
    poke_i64(wc, 48, bgb)
    poke_i64(wc, 64, WW_CLASS)
    wincall1(ww_f_reg, wc)
    style: 281870336
    if WW_STYLE is not 0
        style: WW_STYLE
    av: mem_new(96)
    poke_i64(av, 0, 0)
    poke_i64(av, 8, WW_CLASS)
    poke_i64(av, 16, title)
    poke_i64(av, 24, style)
    poke_i64(av, 32, 80)
    poke_i64(av, 40, 80)
    poke_i64(av, 48, width)
    poke_i64(av, 56, height)
    poke_i64(av, 64, 0)
    poke_i64(av, 72, 0)
    poke_i64(av, 80, inst)
    poke_i64(av, 88, 0)
    h: wincall12(ww_f_create, av)
    if h is 0
        return 0
    if ww_f_move is not 0
        mv: mem_new(96)
        poke_i64(mv, 0, h)
        poke_i64(mv, 8, 80)
        poke_i64(mv, 16, 80)
        poke_i64(mv, 24, width)
        poke_i64(mv, 32, height)
        poke_i64(mv, 40, 1)
        wincall12(ww_f_move, mv)
    w: mem_new(192)
    i: 0
    as long as i < 192
        poke_byte(w, i, 0)
        i: i + 1
    poke_i64(w, 0, h)
    poke_i64(w, 16, width)
    poke_i64(w, 24, height)
    poke_i64(w, 32, 1)
    poke_i64(w, 64, mem_new(64))
    poke_i64(w, 120, 8)
    poke_i64(w, 128, 20)
    wincall2(ww_f_show, h, 5)
    wincall1(ww_f_update, h)
    dc: wincall1(ww_f_getdc, h)
    poke_i64(w, 8, dc)
    if ww_f_font is not 0
        lf: mem_new(64)
        fi: 0
        as long as fi < 64
            poke_byte(lf, fi, 0)
            fi: fi + 1
        poke_u32(lf, 0, 20)
        poke_u32(lf, 16, 400)
        poke_byte(lf, 26, 5)
        poke_byte(lf, 27, 49)
        fnm: "Consolas"
        fi: 0
        as long as fi < str_len(fnm)
            poke_byte(lf, 28 + fi, peek_byte(fnm, fi))
            fi: fi + 1
        hf: wincall1(ww_f_font, lf)
        if hf is not 0
            wincall2(ww_f_select, dc, hf)
        mw: ww_measure(dc, "M")
        iw: ww_measure(dc, "i")
        if mw is 0
            mw: 8
        if mw is not iw
            fi: 0
            as long as fi < 32
                poke_byte(lf, 28 + fi, 0)
                fi: fi + 1
            fnm: "Consolas"
            fi: 0
            as long as fi < str_len(fnm)
                poke_byte(lf, 28 + fi, peek_byte(fnm, fi))
                fi: fi + 1
            hf: wincall1(ww_f_font, lf)
            if hf is not 0
                wincall2(ww_f_select, dc, hf)
            mw: ww_measure(dc, "M")
            if mw is 0
                mw: 8
        poke_i64(w, 120, mw)
        mh: ww_measure_h(dc, "M")
        if mh < 12
            mh: 16
        poke_i64(w, 128, mh + 4)
        poke_i64(w, 176, hf)
    poke_i64(w, 168, dc)
    ww_buf(w)
    if ww_f_timer is not 0
        wincall4(ww_f_timer, h, 1, 500, 0)
    sh: dll_open("shell32.dll")
    if sh is not 0
        df: dll_find(sh, "DragAcceptFiles")
        if df is not 0
            wincall2(df, h, 1)
    return w

ww_buf w:
    windc: peek_i64(w, 168)
    if windc is 0
        return 0
    if ww_f_compdc is 0
        return 0
    oldmdc: peek_i64(w, 144)
    oldbmp: peek_i64(w, 152)
    oldsel: peek_i64(w, 160)
    if oldmdc is not 0
        if oldsel is not 0
            wincall2(ww_f_select, oldmdc, oldsel)
        if oldbmp is not 0
            wincall1(ww_f_delete, oldbmp)
        if ww_f_deldc is not 0
            wincall1(ww_f_deldc, oldmdc)
    bw: peek_i64(w, 16)
    bh: peek_i64(w, 24)
    if bw < 64
        bw: 64
    if bh < 64
        bh: 64
    mdc: wincall1(ww_f_compdc, windc)
    if mdc is 0
        poke_i64(w, 8, windc)
        return 0
    bmp: wincall3(ww_f_compbmp, windc, bw, bh)
    old: wincall2(ww_f_select, mdc, bmp)
    hf: peek_i64(w, 176)
    if hf is not 0
        wincall2(ww_f_select, mdc, hf)
    poke_i64(w, 144, mdc)
    poke_i64(w, 152, bmp)
    poke_i64(w, 160, old)
    poke_i64(w, 8, mdc)
    return 1

ww_flip w:
    mdc: peek_i64(w, 144)
    windc: peek_i64(w, 168)
    if mdc is 0
        return 0
    if windc is 0
        return 0
    if ww_f_bitblt is 0
        return 0
    av: mem_new(96)
    poke_i64(av, 0, windc)
    poke_i64(av, 8, 0)
    poke_i64(av, 16, 0)
    poke_i64(av, 24, peek_i64(w, 16))
    poke_i64(av, 32, peek_i64(w, 24))
    poke_i64(av, 40, mdc)
    poke_i64(av, 48, 0)
    poke_i64(av, 56, 0)
    poke_i64(av, 64, 13369376)
    poke_i64(av, 72, 0)
    poke_i64(av, 80, 0)
    poke_i64(av, 88, 0)
    wincall12(ww_f_bitblt, av)
    return 1

ww_char_more w:
    msg: peek_i64(w, 64)
    if ww_f_peek is 0
        return 0
    h: peek_i64(w, 0)
    if wincall(ww_f_peek, msg, h, 258, 258, 1) is 0
        return 0
    return peek_i64(msg, 16)

ww_measure dc s:
    if ww_f_extent is 0
        return 0
    if dc is 0
        return 0
    sz: mem_new(8)
    poke_i64(sz, 0, 0)
    wincall4(ww_f_extent, dc, s, str_len(s), sz)
    return peek_u32(sz, 0)

ww_measure_h dc s:
    if ww_f_extent is 0
        return 0
    if dc is 0
        return 0
    sz: mem_new(8)
    poke_i64(sz, 0, 0)
    wincall4(ww_f_extent, dc, s, str_len(s), sz)
    return peek_u32(sz, 4)

ww_take_mouse w msg:
    p: peek_i64(msg, 24)
    x: p % 65536
    if x > 32767
        x: x - 65536
    y: (p / 65536) % 65536
    if y > 32767
        y: y - 65536
    poke_i64(w, 48, x)
    poke_i64(w, 56, y)
    return 0

ww_ok w:
    if w is 0
        return 0
    return 1

ww_going w:
    return peek_i64(w, 32)

ww_stop w:
    poke_i64(w, 32, 0)
    return 0

# ---------------------------------------------------------------
# the message loop
# ---------------------------------------------------------------
#
# Everything waiting is taken in, without stopping to wait for
# more, so a program can draw between messages. Hands back nought
# when the window has been closed.

ww_next w:
    if peek_i64(w, 32) is 0
        return 0
    msg: peek_i64(w, 64)
    n: 0
    as long as n < 64
        # PM_REMOVE is 1: take the message rather than peek at it
        if wincall(ww_f_peek, msg, 0, 0, 0, 1) is 0
            n: 64
        if not
            kind: peek_u32(msg, 8)
            if kind is 2
                poke_i64(w, 32, 0)
                n: 64
            if not
                if kind is 18
                    poke_i64(w, 32, 0)
                    n: 64
                if not
                    poke_i64(w, 104, kind)
                    if kind is 256
                        poke_i64(w, 40, peek_i64(msg, 16))
                    if kind is 258
                        poke_i64(w, 96, peek_i64(msg, 16))
                        poke_i64(w, 40, peek_i64(msg, 16))
                    if kind is 16
                        poke_i64(w, 32, 0)
                        n: 64
                    if kind is 512
                        p: peek_i64(msg, 24)
                        poke_i64(w, 48, p % 65536)
                        poke_i64(w, 56, (p / 65536) % 65536)
                    wincall1(ww_f_translate, msg)
                    wincall1(ww_f_dispatch, msg)
                    n: n + 1
    return peek_i64(w, 32)

ww_gone w:
    poke_i64(w, 32, 0)
    if ww_f_quit is not 0
        wincall1(ww_f_quit, 0)
    if ww_f_exit is not 0
        wincall1(ww_f_exit, 0)
    return 0

ww_wait w:
    if peek_i64(w, 32) is 0
        return 0
    msg: peek_i64(w, 64)
    if ww_f_getmsg is 0
        return ww_next(w)
    r: wincall4(ww_f_getmsg, msg, 0, 0, 0)
    if r < 1
        return ww_gone(w)
    kind: peek_u32(msg, 8)
    poke_i64(w, 104, kind)
    poke_i64(w, 112, peek_i64(msg, 16))
    poke_i64(w, 136, peek_i64(msg, 24))
    if kind is 2
        return ww_gone(w)
    if kind is 18
        return ww_gone(w)
    if kind is 16
        return ww_gone(w)
    if kind is 274
        c: peek_i64(msg, 16) % 65536
        c: c - (c % 16)
        if c is 61536
            return ww_gone(w)
    if kind is 256
        poke_i64(w, 40, peek_i64(msg, 16))
    if kind is 258
        poke_i64(w, 96, peek_i64(msg, 16))
        poke_i64(w, 40, peek_i64(msg, 16))
    if kind is 512
        ww_take_mouse(w, msg)
    if kind is 513
        ww_take_mouse(w, msg)
    if kind is 514
        ww_take_mouse(w, msg)
    if kind is 516
        ww_take_mouse(w, msg)
    if kind is 517
        ww_take_mouse(w, msg)
    if kind is 518
        ww_take_mouse(w, msg)
    if kind is 515
        ww_take_mouse(w, msg)
    if kind is 563
        ww_take_mouse(w, msg)
    wincall1(ww_f_translate, msg)
    wincall1(ww_f_dispatch, msg)
    if ww_f_iswindow is not 0
        if wincall1(ww_f_iswindow, peek_i64(w, 0)) is 0
            return ww_gone(w)
    return peek_i64(w, 32)

ww_key w:
    return peek_i64(w, 40)

ww_char w:
    return peek_i64(w, 96)

ww_msg w:
    return peek_i64(w, 104)

ww_wparam w:
    return peek_i64(w, 112)

ww_cellw w:
    c: peek_i64(w, 120)
    if c < 4
        return 8
    return c

ww_cellh w:
    c: peek_i64(w, 128)
    if c < 12
        return 20
    return c

ww_x w:
    return peek_i64(w, 48)

ww_y w:
    return peek_i64(w, 56)

ww_width w:
    return peek_i64(w, 16)

ww_height w:
    return peek_i64(w, 24)

# ---------------------------------------------------------------
# drawing
# ---------------------------------------------------------------
#
# Windows counts colour the other way round from everyone else:
# blue first, then green, then red. This turns the usual sort into
# the sort Windows wants, so a program writes the same number on
# both machines.

ww_colour rgb:
    r: (rgb / 65536) % 256
    g: (rgb / 256) % 256
    b: rgb % 256
    return b * 65536 + g * 256 + r

# a solid block
ww_fill w x y width height rgb:
    dc: peek_i64(w, 8)
    if dc is 0
        return 0
    br: peek_i64(w, 80)
    if peek_i64(w, 88) is not rgb
        if br is not 0
            wincall1(ww_f_delete, br)
        br: wincall1(ww_f_brush, ww_colour(rgb))
        poke_i64(w, 80, br)
        poke_i64(w, 88, rgb)
    rect: mem_new(32)
    poke_u32(rect, 0, x)
    poke_u32(rect, 4, y)
    poke_u32(rect, 8, x + width)
    poke_u32(rect, 12, y + height)
    wincall3(ww_f_fillrect, dc, rect, br)
    return 0

ww_box w x y width height rgb:
    ww_fill(w, x, y, width, 1, rgb)
    ww_fill(w, x, y + height - 1, width, 1, rgb)
    ww_fill(w, x, y, 1, height, rgb)
    ww_fill(w, x + width - 1, y, 1, height, rgb)
    return 0

ww_dot w x y rgb:
    return ww_fill(w, x, y, 1, 1, rgb)

ww_line w x0 y0 x1 y1 rgb:
    dc: peek_i64(w, 8)
    if dc is 0
        return 0
    pen: wincall3(ww_f_pen, 0, 1, ww_colour(rgb))
    old: wincall2(ww_f_select, dc, pen)
    wincall4(ww_f_moveto, dc, x0, y0, 0)
    wincall3(ww_f_lineto, dc, x1, y1)
    wincall2(ww_f_select, dc, old)
    wincall1(ww_f_delete, pen)
    return 0

ww_circle w x y r rgb:
    dc: peek_i64(w, 8)
    if dc is 0
        return 0
    br: wincall1(ww_f_brush, ww_colour(rgb))
    old: wincall2(ww_f_select, dc, br)
    wincall(ww_f_ellipse, dc, x - r, y - r, x + r, y + r)
    wincall2(ww_f_select, dc, old)
    wincall1(ww_f_delete, br)
    return 0

# y is the top of the letters here, not the bottom, which is the
# other way round from the X11 one. This follows X11 so a program
# written for one looks the same on the other.
ww_text w x y words rgb:
    dc: peek_i64(w, 8)
    if dc is 0
        return 0
    wincall2(ww_f_setbkmode, dc, 1)
    wincall2(ww_f_settextcolor, dc, ww_colour(rgb))
    wincall(ww_f_textout, dc, x, y - 12, words, str_len(words))
    return 0

# Windows draws as it goes, so there is nothing held back, but a
# program written for both should call this anyway.
ww_show w:
    return 0

ww_shut w:
    if w is 0
        return 0
    h: peek_i64(w, 0)
    dc: peek_i64(w, 8)
    if dc is not 0
        wincall2(ww_f_releasedc, h, dc)
    if h is not 0
        wincall1(ww_f_destroy, h)
    poke_i64(w, 32, 0)
    return 0
