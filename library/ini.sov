# ini.sov — key=value lines
# needs _sov_list
use string
use file

ini_get text key:
    want: str_cat(key, "=")
    wn: str_len(want)
    n: str_len(text)
    line: 0
    i: 0
    as long as i < n
        if peek_byte(text, i) is 10
            if str_starts(str_cut(text, line, i), want) is 1
                return str_cut(text, line + wn, i)
            line: i + 1
        i: i + 1
    if line < n
        if str_starts(str_cut(text, line, n), want) is 1
            return str_cut(text, line + wn, n)
    return blank

ini_load path key:
    t: file_read_all(path)
    if t is 0
        return blank
    return ini_get(t, key)
