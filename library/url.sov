# url.sov — pull host && path out of http://host/path
use string

url_host u:
    p: str_find(u, "://")
    s: 0
    if p > 0 - 1
        s: p + 3
    e: s
    n: str_len(u)
    as long as e < n
        c: peek_byte(u, e)
        if c is 47
            return str_cut(u, s, e)
        e: e + 1
    return str_cut(u, s, n)

url_path u:
    p: str_find(u, "://")
    s: 0
    if p > 0 - 1
        s: p + 3
    n: str_len(u)
    e: s
    as long as e < n
        if peek_byte(u, e) is 47
            return str_cut(u, e, n)
        e: e + 1
    return "/"
