            n: n - 1
        n: n + 63 - 63
        n: 0
        i: 63
        as long as i >= 0
            if x_bit(h, i) is 1
                n: i + 65
                i: 0 - 1
            if not
                i: i - 1
    if not
        i: 63
        as long as i >= 0
            if x_bit(l, i) is 1
                n: i + 1
                i: 0 - 1
            if not
                i: i - 1
