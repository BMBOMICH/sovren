    return r

# shift the whole sixteen bytes left or right by whole bytes
x_pslldq m n by:
    if by >= 16
        return x_xset(m, n, 0, 0)
    lo: x_xlo(m, n)
    hi: x_xhi(m, n)
    if by is 0
        return 0
    if by < 8
        nh: x_or(x_shl64(hi, by * 8), x_shr64(lo, (8 - by) * 8))
        return x_xset(m, n, x_shl64(lo, by * 8), nh)
    return x_xset(m, n, 0, x_shl64(lo, (by - 8) * 8))

x_psrldq m n by:
    if by >= 16
        return x_xset(m, n, 0, 0)
    lo: x_xlo(m, n)
    hi: x_xhi(m, n)
    if by is 0
        return 0
    if by < 8
        nl: x_or(x_shr64(lo, by * 8), x_shl64(hi, (8 - by) * 8))
        return x_xset(m, n, nl, x_shr64(hi, by * 8))
    return x_xset(m, n, x_shr64(hi, (by - 8) * 8), 0)

# ---------------------------------------------------------------
# what the program asks the system for
# ---------------------------------------------------------------

# Hand out a slab well past the program itself.
#
# The Sovren runtime asks for a gigabyte of heap up front and then
# uses a sliver of it. Handing back nothing because a gigabyte will
# not fit turns into a write to address zero, so the reservation is
# capped: the program gets a real address, and the parts of that
# gigabyte it never touches cost nothing.
X_SLAB: 33554432

# Where things sit inside the block, counted from the bottom:
#   0                the program itself
#   X_BRK_TOP        as far as brk may grow
#   X_STACK_AT       the stack, growing down from here
#   X_SLABS          everything mmap hands out, growing up
X_BRK_TOP: 67108864
X_STACK_AT: 100663296
X_SLABS: 134217728

# The heap that brk grows and the slabs that mmap hands out must not
# land on each other. brk starts just above the program and grows
# upwards; mmap starts a long way above that and also grows up.
# Hand out a piece of memory.
#
# A program often RESERVES far more than it will ever touch: the
# Sovren runtime asks for a gigabyte and uses a sliver. Refusing
# that would stop it dead, so a reservation larger than the slab
# area is trimmed to what is left. A program that then writes past
# the trimmed end is caught by the range check, which is the honest
# answer: this machine did not have the room.
x_give m n:
    lo: peek_i64(m, 216)
    floor: lo + X_SLABS
    top: peek_i64(m, 224)
    if top < floor
        top: floor
    want: n
    if want < 4096
        want: 4096
    want: (want / 4096) * 4096 + 4096
    room: lo + X_MEM - 4096 - top
    if want > room
        if room < 1048576
            # genuinely nothing left
            return 0 - 12
        want: room
    poke_i64(m, 224, top + want)
    return top

# a guest address as an address here
x_here m a:
    return peek_i64(m, 176) + a - peek_i64(m, 216)

x_syscall m nx:
    poke_i64(m, 272, 1)
    os: peek_i64(m, 240)
    if os is X_WIN
        # real Windows has no Linux kernel behind it. Wine hides this
        # because Wine runs on Linux. This does not hide it.
        poke_i64(m, 168, X_RAWSYS)
        return 0
    nr: x_reg(m, 0)
    if os is X_MAC
        if nr < 33554432
            # a Linux number on a Mac. It would fail on real hardware.
            poke_i64(m, 168, X_RAWSYS)
            poke_i64(m, 232, nr)
            return 0
        nr: x_mac_to_linux(nr - 33554432)
    return x_do_call(m, nx, nr)

# macOS counts its calls differently. Turn the Mac number into the
# Linux one this emulator already knows how to answer.
x_mac_to_linux n:
    if n is 1
        return 60
    if n is 3
        return 0
    if n is 4
        return 1
    if n is 5
        return 257
    if n is 6
        return 3
    if n is 199
        return 8
    if n is 197
        return 9
    if n is 20
        return 39
    if n is 10
        return 87
    if n is 136
        return 83
    if n is 12
        return 80
    if n is 73
        return 11
    if n is 33
        return 21
    if n is 54
        return 16
    return 0 - 1

x_do_call m nx nr:
    a0: x_reg(m, 7)
    a1: x_reg(m, 6)
    a2: x_reg(m, 2)
    a3: x_reg(m, 10)
    if nr is 1
        if a0 is 1
            x_say(m, a1, a2)
            x_setr(m, 0, a2)
            return x_go(m, nx)
        if a0 is 2
            x_grumble(m, a1, a2)
            x_setr(m, 0, a2)
            return x_go(m, nx)
        x_setr(m, 0, sys_write(a0, x_here(m, a1), a2))
        return x_go(m, nx)
    if nr is 0
        x_setr(m, 0, sys_read(a0, x_here(m, a1), a2))
        return x_go(m, nx)
    if nr is 257
        x_setr(m, 0, sys_open(x_here(m, a1), a2))
        return x_go(m, nx)
    if nr is 2
        x_setr(m, 0, sys_open(x_here(m, a0), a1))
        return x_go(m, nx)
    if nr is 3
        x_setr(m, 0, sys_close(a0))
        return x_go(m, nx)
    if nr is 8
        x_setr(m, 0, sys_seek(a0, a1, a2))
        return x_go(m, nx)
    if nr is 9
        # A fresh piece of memory from the system always arrives
        # blank. malloc keeps its bookkeeping in the first bytes and
        # goes wrong in confusing ways if they hold rubbish.
        got: x_give(m, a1)
        if got is not 0
            k: 0
            n: a1
            if n > X_SLAB
                n: X_SLAB
            as long as k < n
                x_w8(m, got + k, 0)
                k: k + 1
        x_setr(m, 0, got)
        return x_go(m, nx)
    if nr is 11
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 10
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 60
        poke_i64(m, 208, x_mask(a0, 1))
        poke_i64(m, 168, X_EXITED)
        return 0
    if nr is 231
        poke_i64(m, 208, x_mask(a0, 1))
        poke_i64(m, 168, X_EXITED)
        return 0
    # ---- the calls a C library makes before it will start ----
    if nr is 158
        # set or read the thread pointer. glibc asks for this early.
        if a0 is 4098
            poke_i64(m, 440, a1)
            x_setr(m, 0, 0)
            return x_go(m, nx)
        if a0 is 4097
            x_setr(m, 0, peek_i64(m, 440))
            return x_go(m, nx)
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 12
        # move the top of the heap. Nought asks where it is.
        # This is its own area, kept well clear of the slabs mmap
        # hands out, so the two can never tread on each other.
        cur: peek_i64(m, 520)
        if cur is 0
            cur: peek_i64(m, 568)
            poke_i64(m, 520, cur)
        if a0 is 0
            x_setr(m, 0, cur)
            return x_go(m, nx)
        if a0 > cur
            lo: peek_i64(m, 216)
            if a0 - lo > X_BRK_TOP - 65536
                x_setr(m, 0, cur)
                return x_go(m, nx)
            # the new part must start blank
            k: cur
            as long as k < a0
                x_w8(m, k, 0)
                k: k + 1
        poke_i64(m, 520, a0)
        x_setr(m, 0, a0)
        return x_go(m, nx)
    if nr is 218
        x_setr(m, 0, 1)
        return x_go(m, nx)
    if nr is 39
        x_setr(m, 0, 1)
        return x_go(m, nx)
    if nr is 20
        # writing several pieces at once
        cnt: a2
        total: 0
        i: 0
        as long as i < cnt
            base: x_add(a1, i * 16)
            buf: x_r64(m, base)
            len: x_r64(m, base + 8)
            if len > 0
                if a0 is 1
                    x_say(m, buf, len)
                if not
                    if a0 is 2
                        x_grumble(m, buf, len)
                    if not
                        sys_write(a0, x_here(m, buf), len)
                total: total + len
            i: i + 1
        x_setr(m, 0, total)
        return x_go(m, nx)
    if nr is 16
        # asking a device a question. Say it is a terminal.
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 5
        # what kind of thing this file is. The C library asks before
        # it decides how to buffer, and reads the answer whatever it
        # is told, so the block must be filled in.
        if a1 is 0
            x_setr(m, 0, 0 - 14)
            return x_go(m, nx)
        i: 0
        as long as i < 144
            x_w8(m, a1 + i, 0)
            i: i + 1
        # a character device, readable and writable by everyone
        x_w32(m, a1 + 24, 8630)
        x_w64(m, a1 + 48, 4096)
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 262
        if a2 is not 0
            i: 0
            as long as i < 144
                x_w8(m, a2 + i, 0)
                i: i + 1
            x_w32(m, a2 + 24, 8630)
            x_w64(m, a2 + 48, 4096)
        x_setr(m, 0, 0)
        return x_go(m, nx)

    # anything else: say it worked and carry on
    x_setr(m, 0, 0)
    return x_go(m, nx)

# ---------------------------------------------------------------
# the stand-in Windows library
# ---------------------------------------------------------------
#
# A Windows program does not talk to the kernel directly; it calls
# kernel32. The loader points every imported name at an address here.
# When the instruction pointer lands on one, this answers it and
# returns, the same way the real library would.

# Windows hands out handles, not file numbers. Ten, eleven and twelve
# are the three standard ones; everything the program opens gets a
# number well clear of those, so a file can never be mistaken for the
# console no matter how many are open at once.
X_HBASE: 1000

x_fd h:
    if h >= X_HBASE
        return h - X_HBASE
    if h is 10
        return 0
    if h is 11
        return 1
    if h is 12
        return 2
    return h

x_win_call m which:
    nm: list_get(peek_i64(m, 288), which)
    a1: x_reg(m, 1)
    a2: x_reg(m, 2)
    a3: x_reg(m, 8)
    a4: x_reg(m, 9)
    sp: x_sp(m)
    a5: x_r64(m, x_add(sp, 40))
    if str_eq(nm, "GetStdHandle") is 1
        h: x_lo(a1)
        if h is 4294967286
            x_setr(m, 0, 10)
        if not
            if h is 4294967284
                x_setr(m, 0, 12)
            if not
                x_setr(m, 0, 11)
        return 1
    if str_eq(nm, "WriteFile") is 1
        if a1 is 11
            x_say(m, a2, a3)
        if not
            if a1 is 12
                x_grumble(m, a2, a3)
            if not
                sys_write(x_fd(a1), x_here(m, a2), a3)
        if a4 is not 0
            x_w32(m, a4, a3)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "ReadFile") is 1
        n: 0
        if a1 is 10
            n: sys_read(0, x_here(m, a2), a3)
        if not
            if a1 > 12
                n: sys_read(x_fd(a1), x_here(m, a2), a3)
        if n < 0
            n: 0
        if a4 is not 0
            x_w32(m, a4, n)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "CreateFileA") is 1
        flags: 0
        if x_lo(a2) is 1073741824
            flags: 577
        if x_lo(a5) is 2
            flags: 577
        fd: sys_open(x_here(m, a1), flags)
        if fd < 0
            x_setr(m, 0, 0 - 1)
            return 1
        x_setr(m, 0, X_HBASE + fd)
        return 1
    if str_eq(nm, "CloseHandle") is 1
        if a1 > 12
            sys_close(x_fd(a1))
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "VirtualAlloc") is 1
        # Windows says no with nought, not with a number
        got: x_give(m, a2)
        if got < 0
            got: 0
        x_setr(m, 0, got)
        return 1
    if str_eq(nm, "ExitProcess") is 1
        poke_i64(m, 208, x_mask(a1, 1))
        poke_i64(m, 168, X_EXITED)
        return 0
    if str_eq(nm, "GetCommandLineA") is 1
        x_setr(m, 0, peek_i64(m, 248))
        return 1
    if str_eq(nm, "SetFilePointerEx") is 1
        w: x_lo(a4)
        r: sys_seek(x_fd(a1), a2, w)
        if a3 is not 0
            x_w64(m, a3, r)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "GetConsoleMode") is 1
        if a2 is not 0
            x_w32(m, a2, 3)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "SetConsoleMode") is 1
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "GetFileSizeEx") is 1
        f: x_fd(a1)
        here: sys_seek(f, 0, 1)
        end: sys_seek(f, 0, 2)
        sys_seek(f, here, 0)
        if a2 is not 0
            x_w64(m, a2, end)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "LoadLibraryA") is 1
        # Opening another Windows library. Nothing here can really
        # load user32 or gdi32 — those are Windows itself — so a
        # made-up handle comes back and any function asked for
        # inside it is answered with nought. A program checks for
        # that and says it cannot draw, which is the truth here.
        x_setr(m, 0, 305419896)
        return 1
    if str_eq(nm, "GetProcAddress") is 1
        x_setr(m, 0, 0)
        return 1
    if str_eq(nm, "DeleteFileA") is 1
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "CreateDirectoryA") is 1
        x_setr(m, 0, 1)
        return 1
    # a name nobody taught it: say nothing happened, note it, carry on
    x_note_missing(m, nm)
    x_setr(m, 0, 0)
    return 1

x_note_missing m nm:
    o: peek_i64(m, 296)
    used: peek_i64(m, 304)
    t: str_cat("no stand-in for ", nm)
    t: str_cat(t, "\n")
    n: str_len(t)
    i: 0
    as long as i < n
        if used < X_OUT - 2
            poke_byte(o, used, peek_byte(t, i))
            used: used + 1
        i: i + 1
    poke_byte(o, used, 0)
    poke_i64(m, 304, used)
    return 0

# ---------------------------------------------------------------
# the loop
# ---------------------------------------------------------------

x86_run m:
    return x86_run_for(m, 400000000)

x86_run_for m limit:
    n: 0
    going: 1
    tb: peek_i64(m, 280)
    nt: peek_i64(m, 312)
    as long as going is 1
        if n >= limit
            poke_i64(m, 168, X_TOOLONG)
            going: 0
        if not
            pc: peek_i64(m, 128)
            hit: 0
            if nt > 0
                if pc >= tb
                    if pc < tb + nt * 16
                        hit: 1
            if hit is 1
                going: x_win_call(m, (pc - tb) / 16)
                if going is 1
                    x_set_rip(m, x_pop(m))
            if not
                going: x_step(m)
            # a read or write outside the block is a fault, and the
            # step that caused it must not be allowed to continue
            if peek_i64(m, 168) is not X_RUNNING
                going: 0
            n: n + 1
    return peek_i64(m, 168)

x86_steps m:
    return peek_i64(m, 328)

# ---------------------------------------------------------------
# loading an ELF, the Linux shape
# ---------------------------------------------------------------

x86_load_elf m path:
    d: file_read_all(path)
    if d is 0
        return 0
    poke_i64(m, 240, X_LINUX)
    entry: peek_i64(d, 24)
    phoff: peek_i64(d, 32)
    phnum: peek_byte(d, 56) + peek_byte(d, 57) * 256
    phsz: peek_byte(d, 54) + peek_byte(d, 55) * 256
    # the lowest address any piece wants to sit at
    lo: 0
    i: 0
    as long as i < phnum
        o: phoff + i * phsz
        t: peek_byte(d, o) + peek_byte(d, o + 1) * 256
        if t is 1
            va: peek_i64(d, o + 16)
            if lo is 0
                lo: va
            if va < lo
                lo: va
        i: i + 1
    if lo is 0
        lo: 4194304
    poke_i64(m, 216, lo)
    x_rebase(m)
    # copy each piece in, and zero whatever it asked for beyond what
    # the file holds. That tail is the program's blank workspace and
    # a program that finds rubbish there goes wrong in odd ways.
    top: lo
    i: 0
    as long as i < phnum
        o: phoff + i * phsz
        t: peek_byte(d, o) + peek_byte(d, o + 1) * 256
        if t is 1
            off: peek_i64(d, o + 8)
            va: peek_i64(d, o + 16)
            fsz: peek_i64(d, o + 32)
            msz: peek_i64(d, o + 40)
            k: 0
            as long as k < fsz
                x_w8(m, va + k, peek_byte(d, off + k))
                k: k + 1
            as long as k < msz
                x_w8(m, va + k, 0)
                k: k + 1
            if va + msz > top
                top: va + msz
        # the thread-local piece, which is copied fresh per thread
        if t is 7
            poke_i64(m, 496, peek_i64(d, o + 8))
            poke_i64(m, 504, peek_i64(d, o + 32))
            poke_i64(m, 512, peek_i64(d, o + 40))
        i: i + 1
    # the heap starts above everything the file asked for
    poke_i64(m, 568, (top / 4096) * 4096 + 65536)
    poke_i64(m, 520, peek_i64(m, 568))
    # what the auxiliary table needs to say about this program
    poke_i64(m, 528, lo + phoff)
    poke_i64(m, 536, phnum)
    poke_i64(m, 544, entry)
    x_setup_tls_elf(m, d)
    x_set_rip(m, entry)
    x_start_stack(m, path)
    return 1

# ---- thread-local storage ----
#
# A real program keeps per-thread things behind the fs register:
# the stack guard, the thread pointer, errno. glibc reads fs:[0x10]
# before it does anything else. Give it a block, with the thread
# pointer at nought pointing back at itself, which is the shape the
# system sets up.
# For an ELF that carries a thread-local piece, the block sits just
# BELOW the thread pointer and the pointer itself is at the top. The
# program reaches its own variables with a negative offset from fs,
# which is why there has to be room underneath.
x_setup_tls_elf m d:
    lo: peek_i64(m, 216)
    room: peek_i64(m, 512)
    if room < 512
        room: 512
    room: (room / 64) * 64 + 128
    base: lo + X_STACK_AT + 1048576
    tp: base + room
    poke_i64(m, 440, tp)
    poke_i64(m, 448, tp)
    i: 0
    as long as i < room + 2048
        x_w8(m, base + i, 0)
        i: i + 1
    # the program's own starting values go right below the pointer
    fsz: peek_i64(m, 504)
    off: peek_i64(m, 496)
    k: 0
    as long as k < fsz
        x_w8(m, tp - room + k, peek_byte(d, off + k))
        k: k + 1
    x_w64(m, tp, tp)
    x_w64(m, tp + 16, tp)
    x_w64(m, tp + 40, 5089731888844279321)
    return 0

x_setup_tls m:
    lo: peek_i64(m, 216)
    tls: lo + X_STACK_AT + 1048576
    poke_i64(m, 440, tls)
    poke_i64(m, 448, tls)
    i: 0
    as long as i < 2048
        x_w8(m, tls + i, 0)
        i: i + 1
    # the thread pointer, which points at itself
    x_w64(m, tls, tls)
    # the pointer to this thread's own block
    x_w64(m, tls + 16, tls)
    # a stack guard value that is not zero
    x_w64(m, tls + 40, 5089731888844279321)
    return 0

# argc, argv and an empty environment, the way Linux leaves them
# The stack the way Linux hands it over: the count of arguments, the
# arguments, a nought, the environment, a nought, and then the
# auxiliary table. A small program ignores all but the first few. A
# program built on the C library reads the auxiliary table before it
# does anything else, and gives up in confusing ways if it is not
# there, so it is worth setting out properly.
x_start_stack m path:
    lo: peek_i64(m, 216)
    sp: lo + X_STACK_AT
    # the program name and a couple of environment lines sit above
    np: lo + X_STACK_AT + 131072
    n: str_len(path)
    i: 0
    as long as i < n
        x_w8(m, np + i, peek_byte(path, i))
        i: i + 1
    x_w8(m, np + n, 0)
    # sixteen bytes of something for the random slot in the table
    rnd: np + 256
    i: 0
    as long as i < 16
        x_w8(m, rnd + i, i * 37 + 11)
        i: i + 1
    # an empty name, for the slots that want a piece of text
    empty: np + 320
    x_w8(m, empty, 0)
    x_set_sp(m, sp)
    a: sp
    x_w64(m, a, 1)
    a: a + 8
    x_w64(m, a, np)
    a: a + 8
    x_w64(m, a, 0)
    a: a + 8
    # no environment
    x_w64(m, a, 0)
    a: a + 8
    # the auxiliary table, in pairs
    a: x_aux(m, a, 6, 4096)
    a: x_aux(m, a, 17, 100)
    a: x_aux(m, a, 11, 1000)
    a: x_aux(m, a, 12, 1000)
    a: x_aux(m, a, 13, 1000)
    a: x_aux(m, a, 14, 1000)
    a: x_aux(m, a, 23, 0)
    a: x_aux(m, a, 25, rnd)
    a: x_aux(m, a, 31, np)
    a: x_aux(m, a, 15, empty)
    a: x_aux(m, a, 16, 0)
    a: x_aux(m, a, 3, peek_i64(m, 528))
    a: x_aux(m, a, 4, 56)
    a: x_aux(m, a, 5, peek_i64(m, 536))
    a: x_aux(m, a, 9, peek_i64(m, 544))
    a: x_aux(m, a, 7, 0)
    a: x_aux(m, a, 8, 0)
    a: x_aux(m, a, 0, 0)
    return 0

# one pair of the auxiliary table
x_aux m a k v:
    x_w64(m, a, k)
    x_w64(m, a + 8, v)
    return a + 16

# ---------------------------------------------------------------
# loading a Mach-O, the Mac shape
# ---------------------------------------------------------------

x86_load_macho m path:
    d: file_read_all(path)
    if d is 0
        return 0
    magic: peek_byte(d, 0) + peek_byte(d, 1) * 256 + peek_byte(d, 2) * 65536 + peek_byte(d, 3) * 16777216
    if magic is not 4277009103
        return 0
    poke_i64(m, 240, X_MAC)
    ncmds: peek_byte(d, 16) + peek_byte(d, 17) * 256 + peek_byte(d, 18) * 65536 + peek_byte(d, 19) * 16777216
    entry: 0
    lo: 0
    off: 32
    i: 0
    as long as i < ncmds
        cmd: peek_byte(d, off) + peek_byte(d, off + 1) * 256 + peek_byte(d, off + 2) * 65536 + peek_byte(d, off + 3) * 16777216
        sz: peek_byte(d, off + 4) + peek_byte(d, off + 5) * 256 + peek_byte(d, off + 6) * 65536 + peek_byte(d, off + 7) * 16777216
        if cmd is 25
            vmaddr: peek_i64(d, off + 24)
            filesz: peek_i64(d, off + 48)
            if filesz > 0
                if lo is 0
                    lo: vmaddr
                if vmaddr < lo
                    lo: vmaddr
        off: off + sz
        i: i + 1
    if lo is 0
        lo: 4294967296
    poke_i64(m, 216, lo)
    x_rebase(m)
    off: 32
    i: 0
    as long as i < ncmds
        cmd: peek_byte(d, off) + peek_byte(d, off + 1) * 256 + peek_byte(d, off + 2) * 65536 + peek_byte(d, off + 3) * 16777216
        sz: peek_byte(d, off + 4) + peek_byte(d, off + 5) * 256 + peek_byte(d, off + 6) * 65536 + peek_byte(d, off + 7) * 16777216
        if cmd is 25
            vmaddr: peek_i64(d, off + 24)
            fileoff: peek_i64(d, off + 40)
            filesz: peek_i64(d, off + 48)
            k: 0
            as long as k < filesz
                x_w8(m, vmaddr + k, peek_byte(d, fileoff + k))
                k: k + 1
        if cmd is 5
            entry: peek_i64(d, off + 144)
        if cmd is 2147483688
            entry: x_add(lo, peek_i64(d, off + 8))
        off: off + sz
        i: i + 1
    if entry is 0
        return 0
    x_setup_tls(m)
    x_set_rip(m, entry)
    x_start_stack(m, path)
    return 1

# ---------------------------------------------------------------
# loading a PE, the Windows shape
# ---------------------------------------------------------------

x86_load_pe m path:
    d: file_read_all(path)
    if d is 0
        return 0
    if peek_byte(d, 0) is not 77
        return 0
    if peek_byte(d, 1) is not 90
        return 0
    poke_i64(m, 240, X_WIN)
    pe: peek_byte(d, 60) + peek_byte(d, 61) * 256 + peek_byte(d, 62) * 65536 + peek_byte(d, 63) * 16777216
    nsec: peek_byte(d, pe + 6) + peek_byte(d, pe + 7) * 256
    opt: pe + 24
    entry_rva: x_u32d(d, opt + 16)
    base: peek_i64(d, opt + 24)
    imp_rva: x_u32d(d, opt + 112 + 8)
    poke_i64(m, 216, base)
    x_rebase(m)
    # Real Windows maps the headers at the load address as well as
    # the sections. A program that wants to look at its own import
    # table reads them from there, and found nothing but zeroes
    # while only the sections were being copied.
    hsz: x_u32d(d, opt + 60)
    if hsz < 1024
        hsz: 1024
    k: 0
    as long as k < hsz
        x_w8(m, base + k, peek_byte(d, k))
        k: k + 1
    i: 0
    as long as i < nsec
        o: pe + 24 + 240 + i * 40
        va: x_u32d(d, o + 12)
        rs: x_u32d(d, o + 16)
        ra: x_u32d(d, o + 20)
        k: 0
        as long as k < rs
            x_w8(m, base + va + k, peek_byte(d, ra + k))
            k: k + 1
        i: i + 1
    x86_bind_imports(m, base, imp_rva)
    # the command line, and a return address that means "all done"
    cmd: base + X_MEM - 65536
    n: str_len(path)
    i: 0
    as long as i < n
        x_w8(m, cmd + i, peek_byte(path, i))
        i: i + 1
    x_w8(m, cmd + n, 0)
    poke_i64(m, 248, cmd)
    x_setup_tls(m)
    x_set_sp(m, base + X_MEM - 262144)
    x_push(m, peek_i64(m, 320))
    x_set_rip(m, base + entry_rva)
    return 1

# Hand the program its command line, the way Windows does. Must be
# called after loading, because the loader chooses where it goes.
x_set_cmdline m line:
    p: peek_i64(m, 248)
    if p is 0
        return 0
    n: str_len(line)
    if n > 4000
        n: 4000
    i: 0
    as long as i < n
        x_w8(m, p + i, peek_byte(line, i))
        i: i + 1
    x_w8(m, p + n, 0)
    return 1

x_u32d d a:
    return peek_byte(d, a) + peek_byte(d, a + 1) * 256 + peek_byte(d, a + 2) * 65536 + peek_byte(d, a + 3) * 16777216

# Point every imported name at an address of our own. When the code
# calls it, the loop notices and answers instead.
x86_bind_imports m base imp_rva:
    if imp_rva is 0
        return 0
    tb: base + 201326592
    poke_i64(m, 280, tb)
    names: peek_i64(m, 288)
    count: 0
    k: 0
    going: 1
    as long as going is 1
        desc: base + imp_rva + k * 20
        iat: x_r32(m, desc + 16)
        nm: x_r32(m, desc + 12)
        if nm is 0
            going: 0
        if not
            j: 0
            more: 1
            as long as more is 1
                slot: base + iat + j * 8
                v: x_r64(m, slot)
                if v is 0
                    more: 0
                if not
                    fname: x_cstr(m, base + x_lo(v) + 2)
                    names: list_add(names, fname)
                    x_w64(m, slot, tb + count * 16)
                    count: count + 1
                    j: j + 1
            k: k + 1
    poke_i64(m, 288, names)
    poke_i64(m, 312, count)
    return count

# a run of bytes in guest memory, up to the zero, as text
x_cstr m a:
    n: 0
    as long as x_r8(m, a + n) is not 0
        n: n + 1
        if n > 250
            n: 250
            return as text x_grab(m, a, n)
    return as text x_grab(m, a, n)

x_grab m a n:
    s: mem_new(n + 1)
    i: 0
    as long as i < n
        poke_byte(s, i, x_r8(m, a + i))
        i: i + 1
    poke_byte(s, i, 0)
    return s

# ---------------------------------------------------------------
# a whole run, start to finish
# ---------------------------------------------------------------
#
# Work out what kind of file it is, load it, run it, and hand back
# what it printed. Returns "" when the file cannot be run.

x86_load m path:
    d: file_read_all(path)
    if d is 0
        return 0
    b0: peek_byte(d, 0)
    b1: peek_byte(d, 1)
    if b0 is 77
        if b1 is 90
            return x86_load_pe(m, path)
    if b0 is 127
        if b1 is 69
            return x86_load_elf(m, path)
    return x86_load_macho(m, path)

# a short word for why it stopped
x86_reason m:
    w: peek_i64(m, 168)
    if w is X_EXITED
        return "done"
    if w is X_BADOP
        return "an instruction it does not know"
    if w is X_TOOLONG
        return "it ran too long"
    if w is X_RAWSYS
        return "a raw syscall, which does not work there"
    if w is X_FAULT
        return "it divided by nothing"
    if w is X_OOB
        return "it reached outside its own memory"
    return "still running"
