    sa: x_up_sign(m)
    ea: x_up_exp(m)
    fa: x_up_frac(m)
    x_unpack(m, b)
    kb: x_up_kind(m)
    sb: x_up_sign(m)
    eb: x_up_exp(m)
    fb: x_up_frac(m)
    sg: 0
    if sa is not sb
        sg: 1
    if ka is X_F_NAN
        return X_QNAN
    if kb is X_F_NAN
        return X_QNAN
    if ka is X_F_INF
        if kb is X_F_ZERO
            return X_QNAN
        return x_bits_of(sg, 2047, 0)
    if kb is X_F_INF
        if ka is X_F_ZERO
            return X_QNAN
        return x_bits_of(sg, 2047, 0)
