# x86.sov — run x86-64 code on this machine, in Sovren.
#
# The companion to arm.sov. A processor is a loop: fetch a byte, work
# out what it means, change some registers, move on. This one covers
# the instructions Sovren's x86-64 back end emits, which is what the
# checks need in order to run a Windows .exe or a Mac binary here
# without Wine and without Python.
#
#   use x86
#   main:
#       m: x86_new()
#       x86_load_pe(m, "app.exe")
#       x86_run(m)
#       print x86_out(m)
#
# It is deliberately strict. A Windows program that reaches a raw
# `syscall` instruction is stopped, because real Windows has no Linux
# kernel behind it. Wine hides that; this does not. A Mac program
# that uses a Linux syscall number is stopped for the same reason.
#
# The machine is a block of memory:
#     0 ..127   the sixteen registers, rax rcx rdx rbx rsp rbp rsi rdi r8..r15
#   128         rip
#   136         zero flag        144  sign flag
#   152         carry flag       160  overflow flag
#   168         how it stopped   176  where guest memory lives here
#   184         how big that is  192  the collected output
#   200         how much output  208  the exit code
#   216         the lowest guest address   224  next free slab
#   232         the word it could not read 240  which system it is
#   248         the command line 256  the open files
#   264         strict           272  it used a raw syscall
#   280         where the stand-in library calls live
#   288         their names      296  errors        304  how many errors
#   312         how many stand-ins   320  the return sentinel
#   328         the parity flag  336  the shifted base
#   344         the adjust flag  352  the direction flag
#   360 ..415   scratch for taking one instruction apart
#   416         the repeat prefix    424  a lock prefix was seen
#   432         a segment override   440  fs base   448  gs base
#   456         the rotate carry     464  a fake clock
#   472         a divide overflowed  480  the divide remainder
#   488         where the sixteen vector registers live
#   608         the old unit's control word   616  its top of stack
#   624         where its eight registers live

use mem
use file
use string
use num
use sys
use list

# How much memory a guest program gets. A program built on the C
# library reserves large areas up front and then uses a little of
# each, so this has to be roomy: half a gigabyte costs nothing here
# until it is written to.
X_MEM: 536870912
X_OUT: 1048576

# which system the program was built for
X_LINUX: 0
X_WIN: 1
X_MAC: 2

# why it stopped
X_RUNNING: 0
X_EXITED: 1
X_BADOP: 2
X_TOOLONG: 3
X_RAWSYS: 4
X_FAULT: 5
X_OOB: 6

x86_new:
    m: mem_new(1024)
    i: 0
    as long as i < 1024
        poke_byte(m, i, 0)
        i: i + 1
    # the sixteen vector registers, thirty-two bytes each: the
    # upper sixteen are the YMM half a VEX instruction sees
    poke_i64(m, 488, mem_new(512))
    x: peek_i64(m, 488)
    i: 0
    as long as i < 512
        poke_byte(x, i, 0)
        i: i + 1
    # the old unit's eight registers. Each is kept as an ordinary
    # double here, which is eight bytes, plus a byte saying whether
    # anything is in it at all.
    poke_i64(m, 624, mem_new(128))
    y: peek_i64(m, 624)
    i: 0
    as long as i < 128
        poke_byte(y, i, 0)
        i: i + 1
    poke_i64(m, 608, X_FCW)
    poke_i64(m, 616, 0)
    poke_i64(m, 176, mem_new(X_MEM))
    poke_i64(m, 184, X_MEM)
    poke_i64(m, 192, mem_new(X_OUT))
    poke_i64(m, 296, mem_new(X_OUT))
    poke_i64(m, 256, list_new())
    poke_i64(m, 288, list_new())
    poke_i64(m, 320, 5583457307299373056)
    # the AES tables: the S-box and its inverse, built from the
    # field arithmetic rather than written out
    poke_i64(m, 704, mem_new(512))
    sb: peek_i64(m, 704)
    i: 0
    as long as i < 256
        s: x_sbox_byte(i)
        poke_byte(sb, i, s)
        poke_byte(sb, 256 + s, i)
        i: i + 1
    return m

# ---------------------------------------------------------------
# sixty-four bit sums that wrap instead of stopping
# ---------------------------------------------------------------
#
# Sovren stops the program when a sum runs off the end of a number,
# which is the right thing for a program and the wrong thing for a
# processor: a processor wraps. These do the sum in two halves so it
# wraps the way the hardware does. Each has a quick path for the
# ordinary case, because almost every sum here is an address.

X_2_32: 4294967296
X_2_31: 2147483648
X_2_62: 4611686018427387904

# the low thirty-two bits, always counted upwards
x_lo v:
    r: v % X_2_32
    if r < 0
        r: r + X_2_32
    return r

# the high thirty-two bits, always counted upwards
x_hiu v:
    l: x_lo(v)
    h: (v - l) / X_2_32
    if h < 0
        h: h + X_2_32
    return h

# put two halves back together
x_make hi lo:
    h: hi % X_2_32
    if h < 0
        h: h + X_2_32
    l: lo % X_2_32
    if l < 0
        l: l + X_2_32
    if h >= X_2_31
        h: h - X_2_32
    return h * X_2_32 + l

x_add a b:
    if a > 0 - X_2_62
        if a < X_2_62
            if b > 0 - X_2_62
                if b < X_2_62
                    return a + b
    l: x_lo(a) + x_lo(b)
    h: x_hiu(a) + x_hiu(b) + l / X_2_32
    return x_make(h, l)

x_sub a b:
    if a > 0 - X_2_62
        if a < X_2_62
            if b > 0 - X_2_62
                if b < X_2_62
                    return a - b
    l: x_lo(a) - x_lo(b)
    bor: 0
    if l < 0
        l: l + X_2_32
        bor: 1
    h: x_hiu(a) - x_hiu(b) - bor
    return x_make(h, l)

# the low sixty-four bits of a product, in sixteen bit pieces so no
# single multiply can run off the end
x_mul a b:
    if a > 0 - X_2_31
        if a < X_2_31
            if b > 0 - X_2_31
                if b < X_2_31
                    return a * b
    al: x_lo(a)
    ah: x_hiu(a)
    bl: x_lo(b)
    bh: x_hiu(b)
    a0: al % 65536
    a1: al / 65536
    a2: bl
    b0: bl % 65536
    b1: bl / 65536
    a2: ah % 65536
    a3: ah / 65536
    b2: bh % 65536
    b3: bh / 65536
    p0: a0 * b0
    p1: a0 * b1 + a1 * b0
    p2: a0 * b2 + a1 * b1 + a2 * b0
    p3: a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0
    c: p0
    r0: c % 65536
    c: p1 + c / 65536
    r1: c % 65536
    c: p2 + c / 65536
    r2: c % 65536
    c: p3 + c / 65536
    r3: c % 65536
    return x_make(r2 + r3 * 65536, r0 + r1 * 65536)

# is a below b when both are read as counting upwards?
x_ult a b:
    if a < 0
        if b < 0
            if a < b
                return 1
            return 0
        return 0
    if b < 0
        return 1
    if a < b
        return 1
    return 0

# shift one place right, counting upwards
x_shr1 a:
    if a >= 0
        return a / 2
    return (a + 9223372036854775807 + 1) / 2 + X_2_62

# divide counting upwards
x_udiv a b:
    if b is 0
        return 0
    if a >= 0
        if b > 0
            return a / b
    if b is 1
        return a
    if b < 0
        if x_ult(a, b) is 1
            return 0
        return 1
    q: x_shr1(a) / b
    q: x_add(q, q)
    r: x_sub(a, x_mul(q, b))
    if x_ult(r, b) is 0
        q: x_add(q, 1)
    return q

x_umod a b:
    if b is 0
        return 0
    return x_sub(a, x_mul(x_udiv(a, b), b))

# ---------------------------------------------------------------
# shifting
# ---------------------------------------------------------------
#
# Sovren has no shift operator, so these do it with multiply and
# divide, in two halves, so a shift can never run off the end of a
# number. Every shift on this processor is by 0..63.

x_pow2 n:
    if n <= 0
        return 1
    if n >= 63
        return 0
    r: 1
    k: n
    as long as k >= 8
        r: r * 256
        k: k - 8
    as long as k > 0
        r: r * 2
        k: k - 1
    return r

# left, counting upwards, sixty-four bits wide
x_shl64 v n:
    if n <= 0
        return v
    if n >= 64
        return 0
    lo: x_lo(v)
    hi: x_hiu(v)
    if n < 32
        k: x_pow2(n)
        j: x_pow2(32 - n)
        nh: (hi * k + lo / j) % X_2_32
        nl: (lo * k) % X_2_32
        return x_make(nh, nl)
    k: x_pow2(n - 32)
    return x_make((lo * k) % X_2_32, 0)

# right, counting upwards
x_shr64 v n:
    if n <= 0
        return v
    if n >= 64
        return 0
    lo: x_lo(v)
    hi: x_hiu(v)
    if n < 32
        k: x_pow2(n)
        j: x_pow2(32 - n)
        nl: (lo / k + (hi % k) * j) % X_2_32
        return x_make(hi / k, nl)
    k: x_pow2(n - 32)
    return x_make(0, hi / k)

# right, keeping the sign
x_sar64 v n:
    if n <= 0
        return v
    if v >= 0
        return x_shr64(v, n)
    if n >= 64
        return 0 - 1
    return x_not(x_shr64(x_not(v), n))

# the same three at any width
x_shl v n size:
    if size is 8
        return x_shl64(v, n)
    return x_mask(x_shl64(x_mask(v, size), n), size)

x_shr v n size:
    if size is 8
        return x_shr64(v, n)
    return x_shr64(x_mask(v, size), n)

x_sar v n size:
    if size is 8
        return x_sar64(v, n)
    k: x_sval(v, size)
    if k >= 0
        return x_mask(x_shr64(k, n), size)
    return x_mask(x_sar64(k, n), size)

# how many bits wide, as a number
x_bits size:
    if size is 1
        return 8
    if size is 2
        return 16
    if size is 4
        return 32
    return 64

# one bit out of a value
x_bit v n:
    if n < 0
        return 0
    if n > 63
        return 0
    # the remainder of a negative number is negative in Sovren, and
    # a bit is only ever nought or one
    r: x_shr64(v, n) % 2
    if r < 0
        return r + 2
    return r

# ---------------------------------------------------------------
# and, or, xor: a bit at a time, in two halves
# ---------------------------------------------------------------

x_and32 a b:
    r: 0
    p: 1
    i: 0
    as long as i < 32
        if a % 2 is 1
            if b % 2 is 1
                r: r + p
        a: a / 2
        b: b / 2
        p: p * 2
        i: i + 1
    return r

x_or32 a b:
    r: 0
    p: 1
    i: 0
    as long as i < 32
        if a % 2 + b % 2 > 0
            r: r + p
        a: a / 2
        b: b / 2
        p: p * 2
        i: i + 1
    return r

x_xor32 a b:
    r: 0
    p: 1
    i: 0
    as long as i < 32
        if a % 2 is not b % 2
            r: r + p
        a: a / 2
        b: b / 2
        p: p * 2
        i: i + 1
    return r

x_and a b:
    if a is b
        return a
    if a is 0
        return 0
    if b is 0
        return 0
    if a is 0 - 1
        return b
    if b is 0 - 1
        return a
    return x_make(x_and32(x_hiu(a), x_hiu(b)), x_and32(x_lo(a), x_lo(b)))

x_or a b:
    if a is b
        return a
    if a is 0
        return b
    if b is 0
        return a
    return x_make(x_or32(x_hiu(a), x_hiu(b)), x_or32(x_lo(a), x_lo(b)))

x_xor a b:
    if a is b
        return 0
    if a is 0
        return b
    if b is 0
        return a
    return x_make(x_xor32(x_hiu(a), x_hiu(b)), x_xor32(x_lo(a), x_lo(b)))

x_not a:
    return x_xor(a, 0 - 1)

# ---------------------------------------------------------------
# widths: a byte, a half, a word, a whole register
# ---------------------------------------------------------------

x_mask v size:
    if size is 8
        return v
    if size is 4
        return x_lo(v)
    if size is 1
        r: v % 256
        if r < 0
            r: r + 256
        return r
    r: v % 65536
    if r < 0
        r: r + 65536
    return r

# is the top bit of this width set?
x_neg_at v size:
    if size is 8
        if v < 0
            return 1
        return 0
    if size is 4
        if x_lo(v) >= X_2_31
            return 1
        return 0
    if size is 1
        if x_mask(v, 1) >= 128
            return 1
        return 0
    if x_mask(v, 2) >= 32768
        return 1
    return 0

# read this width as a number that can be below zero
x_sval v size:
    if size is 8
        return v
    k: x_mask(v, size)
    if size is 4
        if k >= X_2_31
            return k - X_2_32
        return k
    if size is 1
        if k >= 128
            return k - 256
        return k
    if k >= 32768
        return k - 65536
    return k

# ---------------------------------------------------------------
# registers
# ---------------------------------------------------------------

x_reg m n:
    return peek_i64(m, n * 8)

x_setr m n v:
    poke_i64(m, n * 8, v)
    return 0

# read a register at a given width
x_rget m n size:
    return x_mask(peek_i64(m, n * 8), size)

# write a register at a given width. thirty-two bit writes clear the
# top half, which is what the hardware does and a common surprise.
x_rset m n size v:
    if size is 8
        poke_i64(m, n * 8, v)
        return 0
    if size is 4
        poke_i64(m, n * 8, x_lo(v))
        return 0
    old: peek_i64(m, n * 8)
    if size is 1
        keep: x_sub(old, x_mask(old, 1))
        poke_i64(m, n * 8, x_add(keep, x_mask(v, 1)))
        return 0
    keep: x_sub(old, x_mask(old, 2))
    poke_i64(m, n * 8, x_add(keep, x_mask(v, 2)))
    return 0

# ---- the four odd byte registers ----
#
# Without a REX prefix, byte registers 4 to 7 are not the low bytes
# of rsp, rbp, rsi and rdi. They are ah, ch, dh and bh: the SECOND
# byte of rax, rcx, rdx and rbx. With any REX prefix at all they
# become spl, bpl, sil and dil, the low bytes, instead. Getting this
# wrong is silent: the value lands in a register nobody was reading.
#
# hasrex is 1 when the instruction carried a REX byte.

x_b_get m n hasrex:
    if hasrex is 0
        if n >= 4
            if n <= 7
                return x_mask(x_shr64(peek_i64(m, (n - 4) * 8), 8), 1)
    return x_mask(peek_i64(m, n * 8), 1)

x_b_set m n hasrex v:
    if hasrex is 0
        if n >= 4
            if n <= 7
                r: n - 4
                old: peek_i64(m, r * 8)
                mid: x_mask(x_shr64(old, 8), 1)
                keep: x_sub(old, x_shl64(mid, 8))
                poke_i64(m, r * 8, x_add(keep, x_shl64(x_mask(v, 1), 8)))
                return 0
    old: peek_i64(m, n * 8)
    keep: x_sub(old, x_mask(old, 1))
    poke_i64(m, n * 8, x_add(keep, x_mask(v, 1)))
    return 0

x_rip m:
    return peek_i64(m, 128)

x_set_rip m v:
    poke_i64(m, 128, v)
    return 0

x_sp m:
    return peek_i64(m, 32)

x_set_sp m v:
    poke_i64(m, 32, v)
    return 0

x_base m:
    return peek_i64(m, 176)

x_low m:
    return peek_i64(m, 216)

# ---------------------------------------------------------------
# guest memory. addresses are the real ones the program believes in,
# so the lowest loaded address comes off first.
# ---------------------------------------------------------------

# Every access is checked. A program that runs off the end of its
# memory must be reported, not allowed to reach past the block and
# take the emulator down with it. The offset is folded back into
# range so the read still has somewhere to go, and the fault is
# recorded for the loop to notice.
x_ck m off:
    if off < 0
        poke_i64(m, 168, X_FAULT)
        poke_i64(m, 232, off)
        return 0
    if off >= X_MEM - 16
        poke_i64(m, 168, X_FAULT)
        poke_i64(m, 232, off)
        return 0
    return off

# Slot 336 holds the block address with the lowest guest address
# already taken off, so a guest address turns into a real one with a
# single add. Working that out on every byte was the slowest part of
# the whole emulator.
x_rebase m:
    poke_i64(m, 336, peek_i64(m, 176) - peek_i64(m, 216))
    return 0

# check a guest address and hand it straight back, so it can be used
# as the index off the shifted base
# Check a guest address and hand back one that is safe to use with
# the shifted base. When the address is outside the block the fault
# is recorded AND the address is folded to the bottom of the block,
# so the read or write that follows lands somewhere harmless instead
# of reaching past the end and taking the whole emulator down.
x_ok m a:
    lo: peek_i64(m, 216)
    off: a - lo
    if off < 0
        poke_i64(m, 168, X_OOB)
        poke_i64(m, 232, a)
        return lo
    if off >= X_MEM - 16
        poke_i64(m, 168, X_OOB)
        poke_i64(m, 232, a)
        return lo
    return a

x_r8 m a:
    return peek_byte(peek_i64(m, 336), x_ok(m, a))

x_w8 m a v:
    poke_byte(peek_i64(m, 336), x_ok(m, a), x_mask(v, 1))
    return 0

x_r16 m a:
    return x_r8(m, a) + x_r8(m, a + 1) * 256

x_r32 m a:
    o: x_ok(m, a)
    b: peek_i64(m, 336)
    return peek_byte(b, o) + peek_byte(b, o + 1) * 256 + peek_byte(b, o + 2) * 65536 + peek_byte(b, o + 3) * 16777216

x_r64 m a:
    return peek_i64(peek_i64(m, 336) + x_ok(m, a), 0)

x_w64 m a v:
    poke_i64(peek_i64(m, 336) + x_ok(m, a), 0, v)
    return 0

x_w32 m a v:
    u: x_lo(v)
    o: x_ok(m, a)
    b: peek_i64(m, 336)
    poke_byte(b, o, u % 256)
    poke_byte(b, o + 1, (u / 256) % 256)
    poke_byte(b, o + 2, (u / 65536) % 256)
    poke_byte(b, o + 3, (u / 16777216) % 256)
    return 0

x_w16 m a v:
    u: x_mask(v, 2)
    x_w8(m, a, u % 256)
    x_w8(m, a + 1, u / 256)
    return 0

x_load m a size:
    if size is 8
        return x_r64(m, a)
    if size is 4
        return x_r32(m, a)
    if size is 1
        return x_r8(m, a)
    return x_r16(m, a)

x_store m a size v:
    if size is 8
        return x_w64(m, a, v)
    if size is 4
        return x_w32(m, a, v)
    if size is 1
        return x_w8(m, a, v)
    return x_w16(m, a, v)

# a signed byte, and a signed and unsigned four bytes, out of the code
x_i8 m a:
    v: x_r8(m, a)
    if v >= 128
        return v - 256
    return v

x_i32 m a:
    v: x_r32(m, a)
    if v >= X_2_31
        return v - X_2_32
    return v

# ---------------------------------------------------------------
# what the program printed
# ---------------------------------------------------------------

x_say m p n:
    o: peek_i64(m, 192)
    used: peek_i64(m, 200)
    i: 0
    as long as i < n
        if used < X_OUT - 2
            poke_byte(o, used, x_r8(m, p + i))
            used: used + 1
        i: i + 1
    poke_byte(o, used, 0)
    poke_i64(m, 200, used)
    return 0

x_grumble m p n:
    o: peek_i64(m, 296)
    used: peek_i64(m, 304)
    i: 0
    as long as i < n
        if used < X_OUT - 2
            poke_byte(o, used, x_r8(m, p + i))
            used: used + 1
        i: i + 1
    poke_byte(o, used, 0)
    poke_i64(m, 304, used)
    return 0

x86_out m:
    return as text peek_i64(m, 192)

x86_err m:
    return as text peek_i64(m, 296)

x86_code m:
    return peek_i64(m, 208)

x86_why m:
    return peek_i64(m, 168)

x86_bad m:
    return peek_i64(m, 232)

x86_used_syscall m:
    return peek_i64(m, 272)

# ---------------------------------------------------------------
# the four flags
# ---------------------------------------------------------------


# ---------------------------------------------------------------
# ---- the VEX layer ----
# A VEX prefix turns the instruction after it into its AVX form:
# a third source register, and a second hundred and twenty-eight
# bits of answer. The machine state keeps what the prefix said:
#   720   the vvvv register (the first source)
#   728   1 while a VEX instruction is running
#   736   the L bit: 1 means two hundred and fifty-six bits
#   744   1 on the second pass of a two hundred and fifty-six bit one
#   752   where the instruction started
#   760   where it ends
#   768   the map: 1 is 0F, 2 is 0F38, 3 is 0F3A
#   776   the W bit
#   784   the rex bits, 792 the width
#   800   the opcode, 808 where it sits
#
# A two hundred and fifty-six bit instruction runs twice: once on
# the low halves, once on the high. The second pass swaps the
# halves of the destination and the source, runs the same hundred
# and twenty-eight bit work again, and swaps them back, so every
# old instruction works at the new width without being rewritten.
#
x_ylo m n:
    return peek_i64(peek_i64(m, 488), n * 32 + 16)

x_yhi m n:
    return peek_i64(peek_i64(m, 488), n * 32 + 24)

x_yset m n lo hi:
    x: peek_i64(m, 488)
    poke_i64(x, n * 32 + 16, lo)
    poke_i64(x, n * 32 + 24, hi)
    return 0

# swap the two halves of a register
x_yswap m n:
    x: peek_i64(m, 488)
    a: peek_i64(x, n * 32)
    b: peek_i64(x, n * 32 + 16)
    poke_i64(x, n * 32, b)
    poke_i64(x, n * 32 + 16, a)
    a: peek_i64(x, n * 32 + 8)
    b: peek_i64(x, n * 32 + 24)
    poke_i64(x, n * 32 + 8, b)
    poke_i64(x, n * 32 + 24, a)
    return 0

x_yswap_rm m:
    if peek_i64(m, 360) is 1
        return x_yswap(m, peek_i64(m, 376))
    poke_i64(m, 376, peek_i64(m, 376) + 16)
    return 0

x_yswap_rm_back m:
    if peek_i64(m, 360) is 0
        poke_i64(m, 376, peek_i64(m, 376) - 16)
    return 0

# is this opcode one that does not take a third source? The moves,
# the gathers of a sign bit, and the ones that write a plain
# register have the vvvv field left empty by the assembler.
x_vex_nosrc m b map:
    if map is 1
        if b is 22
            return 1
        if b is 23
            return 1
        if b is 40
            return 1
        if b is 41
            return 1
        if b is 42
            return 1
        if b is 44
            return 1
        if b is 69
            return 1
        if b is 70
            return 1
        if b is 71
            return 1
        if b is 80
            return 1
        if b is 91
            return 1
        if b is 110
            return 1
        if b is 111
            return 1
        if b is 112
            return 1
        if b is 119
            return 1
        if b is 126
            return 1
        if b is 127
            return 1
        if b is 198
            return 1
        if b is 214
            return 1
        if b is 215
            return 1
        if b is 16
            if peek_i64(m, 416) is 0
                return 1
        if b is 17
            if peek_i64(m, 416) is 0
                return 1
    if map is 2
        if b is 0
            return 1
        if b is 1
            return 1
        if b is 16
            return 1
        if b is 22
            return 1
        if b is 24
            return 1
        if b is 25
            return 1
        if b is 54
            return 1
        if b is 69
            return 1
        if b is 70
            return 1
        if b is 71
            return 1
        if b is 88
            return 1
        if b is 89
            return 1
        if b is 120
            return 1
        if b is 121
            return 1
        if b is 42
            return 1
        if b is 242
            return 1
        if b is 243
            return 1
        if b is 245
            return 1
        if b is 246
            return 1
        if b is 247
            return 1
    if map is 3
        if b is 2
            return 1
        if b is 5
            return 1
        if b is 6
            return 1
        if b is 24
            return 1
        if b is 25
            return 1
        if b is 70
            return 1
        if b is 240
            return 1
        if b is 8
            return 1
        if b is 9
            return 1
        if b is 10
            return 1
        if b is 11
            return 1
        if b is 20
            return 1
        if b is 21
            return 1
        if b is 22
            return 1
        if b is 23
            return 1
        if b is 32
            return 1
        if b is 34
            return 1
        if b is 68
            return 1
        if b is 223
            return 1
    return 0

# the first source goes into the destination before the work, which
# turns every old two-operand instruction into a three-operand one
x_vex_copy m n b:
    if peek_i64(m, 728) is not 1
        return 0
    if peek_i64(m, 744) is 1
        return 0
    if x_vex_nosrc(m, b, peek_i64(m, 768)) is 1
        return 0
    v: peek_i64(m, 720)
    x: peek_i64(m, 488)
    i: 0
    as long as i < 32
        poke_byte(x, n * 32 + i, peek_byte(x, v * 32 + i))
        i: i + 1
    if peek_i64(m, 736) is 0
        i: 16
        as long as i < 32
            poke_byte(x, n * 32 + i, 0)
            i: i + 1
    return 0

# the five-value calls from a crowded job come out corrupted, so
# the wide work is reached through these thin ones
x_vex_go m:
    op: peek_i64(m, 800)
    opat: peek_i64(m, 808)
    m5: peek_i64(m, 768)
    rx: peek_i64(m, 784)
    sz: peek_i64(m, 792)
    q: x_modrm(m, opat, rx, 0)
    n: x_md_reg(m)
    pre: 0
    if sz is 2
        pre: 1
    rr: peek_i64(m, 416)
    if rr is 2
        pre: 2
    if rr is 1
        pre: 3
    x_vex_copy(m, n, op)
    poke_i64(m, 816, pre)
    poke_i64(m, 824, sz)
    poke_i64(m, 864, q)
    poke_i64(m, 872, n)
    r2: 0
    if m5 is 1
        r2: x_vex_of(m)
    if m5 is 2
        r2: x_vex_38(m)
    if m5 is 3
        r2: x_vex_3a(m)
    if r2 is 0
        poke_i64(m, 168, X_BADOP)
        poke_i64(m, 232, m5 * 1280 + op)
        poke_i64(m, 728, 0)
        return 0
    # a cross-lane instruction does the whole width in one go
    if peek_i64(m, 856) is 1
        poke_i64(m, 856, 0)
        poke_i64(m, 728, 0)
        return 1
    # the two passes of a two hundred and fifty-six bit instruction
    if peek_i64(m, 744) is 1
        x_yswap(m, peek_i64(m, 368))
        x_yswap_rm_back(m)
        x_yswap(m, peek_i64(m, 720))
        poke_i64(m, 728, 0)
        poke_i64(m, 744, 0)
        return 1
    if peek_i64(m, 736) is 1
        poke_i64(m, 760, x_rip(m))
        x_yswap(m, peek_i64(m, 368))
        x_yswap_rm(m)
        x_yswap(m, peek_i64(m, 720))
        poke_i64(m, 744, 1)
        x_set_rip(m, peek_i64(m, 752))
        return 1
    return 1



# decode a VEX instruction at `at` and run it. The last argument is
# the width the caller was working at; the VEX bytes carry their own
# REX bits, so the width is taken from the W bit instead.
x_vex_enter m at size:
    b: x_r8(m, at)
    map: 1
    w: 0
    l: 0
    pp: 0
    vv: 0
    r1: 0
    x1: 0
    b1: 0
    op: 0
    fin: 0
    if b is 197
        b2: x_r8(m, at + 1)
        r1: x_and(x_shr64(b2, 7), 1)
        vv: x_and(x_shr64(b2, 3), 15)
        l: x_and(x_shr64(b2, 2), 1)
        pp: x_and(b2, 3)
        op: x_r8(m, at + 2)
        fin: at + 3
    if not
        b2: x_r8(m, at + 1)
        b3: x_r8(m, at + 2)
        map: x_and(b2, 31)
        r1: x_and(x_shr64(b2, 7), 1)
        x1: x_and(x_shr64(b2, 6), 1)
        b1: x_and(x_shr64(b2, 5), 1)
        w: x_and(x_shr64(b3, 7), 1)
        vv: x_and(x_shr64(b3, 3), 15)
        l: x_and(x_shr64(b3, 2), 1)
        pp: x_and(b3, 3)
        op: x_r8(m, at + 3)
        fin: at + 4
    poke_i64(m, 720, 15 - vv)
    poke_i64(m, 728, 1)
    poke_i64(m, 736, l)
    poke_i64(m, 752, at)
    poke_i64(m, 760, fin)
    poke_i64(m, 768, map)
    poke_i64(m, 776, w)
    poke_i64(m, 784, r1 * 8 + x1 * 4 + b1 * 2)
    poke_i64(m, 880, vv)
    if pp is 1
        poke_i64(m, 792, 2)
    if not
        if w is 1
            poke_i64(m, 792, 8)
        if not
            poke_i64(m, 792, 4)
    if pp is 2
        poke_i64(m, 416, 2)
    if not
        if pp is 3
            poke_i64(m, 416, 1)
        if not
            poke_i64(m, 416, 0)
    poke_i64(m, 800, op)
    poke_i64(m, 808, fin)
    return x_vex_go(m)

# the upper halves of the second operand, memory or register
x_xrm_ylo m:
    if peek_i64(m, 360) is 1
        return x_ylo(m, peek_i64(m, 376))
    return peek_i64(m, peek_i64(m, 376) + 16)

x_xrm_yhi m:
    if peek_i64(m, 360) is 1
        return x_yhi(m, peek_i64(m, 376))
    return peek_i64(m, peek_i64(m, 376) + 24)

# ---- AVX2 ----
# The new whole-width permutes and broadcasts. A whole-width
# instruction reads both hundred and twenty-eight bit halves and
# writes both, so the two-pass mechanism is switched off for it.

# vpermilps: the register form takes its four two-bit controls from
# the vvvv register, the immediate form from the byte after the
# modrm. The two forms are told apart by the reserved vvvv field,
# which is 1111 in the immediate form.
x_vpermilps m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    a: x_xrm_lo(m)
    b: x_xrm_hi(m)
    if peek_i64(m, 880) is not 15
        # the register form: the four two-bit controls choose the
        # four pieces of the same half of the data, and the second
        # pass of a two hundred and fifty-six bit one works on the
        # swapped halves
        c: peek_i64(m, 720)
        x: peek_i64(m, 488)
        lo: 0
        hi: 0
        i: 0
        as long as i < 2
            ctl: x_mask(peek_i64(x, c * 32 + i * 4), 4)
            k: x_and(ctl, 3)
            v: 0
            if k < 2
                v: x_mask(x_shr64(a, k * 32), 4)
            if not
                v: x_mask(x_shr64(b, (k - 2) * 32), 4)
            lo: x_or(lo, x_shl64(v, i * 32))
            i: i + 1
        i: 2
        as long as i < 4
            ctl: x_mask(peek_i64(x, c * 32 + i * 4), 4)
            k: x_and(ctl, 3)
            v: 0
            if k < 2
                v: x_mask(x_shr64(a, k * 32), 4)
            if not
                v: x_mask(x_shr64(b, (k - 2) * 32), 4)
            hi: x_or(hi, x_shl64(v, (i - 2) * 32))
            i: i + 1
        x_xset(m, n, lo, hi)
        return x_go(m, q)
    im: x_r8(m, q)
    f0: x_and(im, 3)
    f1: x_and(x_shr64(im, 2), 3)
    f2: x_and(x_shr64(im, 4), 3)
    f3: x_and(x_shr64(im, 6), 3)
    poke_i64(m, 920, x_mask(a, 4))
    poke_i64(m, 928, x_mask(x_shr64(a, 32), 4))
    poke_i64(m, 936, x_mask(b, 4))
    poke_i64(m, 944, x_mask(x_shr64(b, 32), 4))
    v0: x_vpermq_pick(m, f0)
    v1: x_vpermq_pick(m, f1)
    v2: x_vpermq_pick(m, f2)
    v3: x_vpermq_pick(m, f3)
    x_xset(m, n, x_or(v0, x_shl64(v1, 32)), x_or(v2, x_shl64(v3, 32)))
    return x_go(m, q + 1)
x_vpermilpd m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    a: x_xrm_lo(m)
    b: x_xrm_hi(m)
    if peek_i64(m, 880) is not 15
        c: peek_i64(m, 720)
        x: peek_i64(m, 488)
        c0: x_mask(peek_i64(x, c * 32), 4)
        c1: x_mask(peek_i64(x, c * 32 + 8), 4)
        lo: a
        if x_and(c0, 1) is 1
            lo: b
        hi: a
        if x_and(c1, 1) is 1
            hi: b
        x_xset(m, n, lo, hi)
        return x_go(m, q)
    im: x_r8(m, q)
    f0: x_and(im, 1)
    f1: x_and(x_shr64(im, 2), 1)
    lo: a
    if f0 is 1
        lo: b
    hi: a
    if f1 is 1
        hi: b
    x_xset(m, n, lo, hi)
    return x_go(m, q + 1)
x_vpermq m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    im: peek_i64(m, 888)
    a: x_xrm_lo(m)
    b: x_xrm_hi(m)
    c: x_xrm_ylo(m)
    d: x_xrm_yhi(m)
    f0: x_and(im, 3)
    f1: x_and(x_shr64(im, 2), 3)
    f2: x_and(x_shr64(im, 4), 3)
    f3: x_and(x_shr64(im, 6), 3)
    poke_i64(m, 920, a)
    poke_i64(m, 928, b)
    poke_i64(m, 936, c)
    poke_i64(m, 944, d)
    v0: x_vpermq_pick(m, f0)
    v1: x_vpermq_pick(m, f1)
    v2: x_vpermq_pick(m, f2)
    v3: x_vpermq_pick(m, f3)
    poke_i64(m, 856, 1)
    x_xset(m, n, v0, v1)
    x_yset(m, n, v2, v3)
    return x_go(m, q + 1)

# one eight-byte piece chosen from the four the caller put in slots
x_vpermq_pick m k:
    if k is 0
        return peek_i64(m, 920)
    if k is 1
        return peek_i64(m, 928)
    if k is 2
        return peek_i64(m, 936)
    return peek_i64(m, 944)

# vpermps and vpermd: eight four-byte pieces, chosen by the eight
# four-byte controls in the vvvv register
x_vpermps m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    a: x_xrm_lo(m)
    b: x_xrm_hi(m)
    c: x_xrm_ylo(m)
    d: x_xrm_yhi(m)
    poke_i64(m, 920, x_mask(a, 4))
    poke_i64(m, 928, x_mask(x_shr64(a, 32), 4))
    poke_i64(m, 936, x_mask(b, 4))
    poke_i64(m, 944, x_mask(x_shr64(b, 32), 4))
    poke_i64(m, 952, x_mask(c, 4))
    poke_i64(m, 960, x_mask(x_shr64(c, 32), 4))
    poke_i64(m, 968, x_mask(d, 4))
    poke_i64(m, 976, x_mask(x_shr64(d, 32), 4))
    x: peek_i64(m, 488)
    r0: 0
    r1: 0
    r2: 0
    r3: 0
    i: 0
    as long as i < 8
        idx: x_mask(peek_i64(x, vv * 32 + i * 4), 4)
        k: x_and(idx, 7)
        v: x_vpermq_pick(m, k)
        if i < 2
            r0: x_or(r0, x_shl64(v, i * 32))
        if not
            if i < 4
                r1: x_or(r1, x_shl64(v, (i - 2) * 32))
            if not
                if i < 6
                    r2: x_or(r2, x_shl64(v, (i - 4) * 32))
                if not
                    r3: x_or(r3, x_shl64(v, (i - 6) * 32))
        i: i + 1
    poke_i64(m, 856, 1)
    x_xset(m, n, r0, r1)
    x_yset(m, n, r2, r3)
    return x_go(m, q)

# vperm2f128 and vperm2i128: each half of the answer is one of the
# four hundred and twenty-eight bit halves of the two sources, or
# nothing at all, as the immediate says
x_vperm2 m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    im: peek_i64(m, 888)
    vv: peek_i64(m, 720)
    poke_i64(m, 920, x_xlo(m, vv))
    poke_i64(m, 928, x_xhi(m, vv))
    poke_i64(m, 936, x_ylo(m, vv))
    poke_i64(m, 944, x_yhi(m, vv))
    poke_i64(m, 952, x_xrm_lo(m))
    poke_i64(m, 960, x_xrm_hi(m))
    poke_i64(m, 968, x_xrm_ylo(m))
    poke_i64(m, 976, x_xrm_yhi(m))
    x_vperm2_pick(m, x_and(im, 15))
    a: peek_i64(m, 984)
    b: peek_i64(m, 992)
    x_vperm2_pick(m, x_and(x_shr64(im, 4), 15))
    c: peek_i64(m, 984)
    d: peek_i64(m, 992)
    poke_i64(m, 856, 1)
    x_xset(m, n, a, b)
    x_yset(m, n, c, d)
    return x_go(m, q + 1)

# pick one hundred and twenty-eight bits, as the four-bit field says
x_vperm2_pick m f:
    if x_and(x_shr64(f, 2), 1) is 1
        poke_i64(m, 984, 0)
        poke_i64(m, 992, 0)
        return 0
    sel: x_and(f, 3)
    if sel is 0
        poke_i64(m, 984, peek_i64(m, 920))
        poke_i64(m, 992, peek_i64(m, 928))
        return 0
    if sel is 1
        poke_i64(m, 984, peek_i64(m, 936))
        poke_i64(m, 992, peek_i64(m, 944))
        return 0
    if sel is 2
        poke_i64(m, 984, peek_i64(m, 952))
        poke_i64(m, 992, peek_i64(m, 960))
        return 0
    poke_i64(m, 984, peek_i64(m, 968))
    poke_i64(m, 992, peek_i64(m, 976))
    return 0
x_vinsertf128 m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    im: peek_i64(m, 888)
    vv: peek_i64(m, 720)
    a: x_xlo(m, vv)
    b: x_xhi(m, vv)
    c: x_ylo(m, vv)
    d: x_yhi(m, vv)
    e: x_xrm_lo(m)
    f: x_xrm_hi(m)
    poke_i64(m, 856, 1)
    if x_and(im, 1) is 1
        x_xset(m, n, a, b)
        x_yset(m, n, e, f)
        return x_go(m, q + 1)
    x_xset(m, n, e, f)
    x_yset(m, n, c, d)
    return x_go(m, q + 1)

# vextractf128: one half of the second source, into the destination
# register or out to memory
x_vextractf128 m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    im: peek_i64(m, 888)
    poke_i64(m, 856, 1)
    if peek_i64(m, 360) is 1
        if x_and(im, 1) is 1
            a: x_xrm_ylo(m)
            b: x_xrm_yhi(m)
        if not
            a: x_xrm_lo(m)
            b: x_xrm_hi(m)
        x_xset(m, n, a, b)
        x_yset(m, n, 0, 0)
        return x_go(m, q + 1)
    if x_and(im, 1) is 1
        a: x_ylo(m, n)
        b: x_yhi(m, n)
    if not
        a: x_xlo(m, n)
        b: x_xhi(m, n)
    x_w64(m, peek_i64(m, 376), a)
    x_w64(m, peek_i64(m, 376) + 8, b)
    return x_go(m, q + 1)

# the broadcasts: one element, repeated across the whole register.
# The element size in bytes is in slot 888.
x_vbroadcast m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    sz: peek_i64(m, 888)
    if sz is 0
        sz: 4
    if sz is 1
        sz: 8
    poke_i64(m, 856, 1)
    e: x_mask(x_xrm_lo(m), sz)
    r: 0
    i: 0
    as long as i < 8 / sz
        r: x_or(r, x_shl64(e, i * sz * 8))
        i: i + 1
    if peek_i64(m, 736) is 0
        x_xset(m, n, r, r)
        x_yset(m, n, 0, 0)
        return x_go(m, q)
    x_xset(m, n, r, r)
    x_yset(m, n, r, r)
    return x_go(m, q)

# vpblendd: every four-byte piece comes from the destination or the
# second source, as one bit of the immediate says. The second pass
# of a two hundred and fifty-six bit one wants the top four bits.
x_vpblendd m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    im: peek_i64(m, 888)
    if peek_i64(m, 744) is 1
        im: x_shr64(im, 4)
    poke_i64(m, 920, x_xlo(m, n))
    poke_i64(m, 928, x_xrm_lo(m))
    poke_i64(m, 952, x_and(im, 3))
    a: x_vpblendd_2(m)
    poke_i64(m, 920, x_xhi(m, n))
    poke_i64(m, 928, x_xrm_hi(m))
    poke_i64(m, 952, x_and(x_shr64(im, 2), 3))
    b: x_vpblendd_2(m)
    x_xset(m, n, a, b)
    if peek_i64(m, 736) is 0
        x_yset(m, n, 0, 0)
    return x_go(m, q)

# two four-byte pieces blended by the two bits of slot 952
x_vpblendd_2 m:
    a: peek_i64(m, 920)
    b: peek_i64(m, 928)
    f: peek_i64(m, 952)
    lo: x_and(a, 4294967295)
    if x_and(f, 1) is 1
        lo: x_and(b, 4294967295)
    hi: x_and(a, 0 - 4294967296)
    if x_and(x_shr64(f, 1), 1) is 1
        hi: x_and(b, 0 - 4294967296)
    return x_or(lo, hi)

# the variable shifts: every piece shifts by its own count, which
# lives in the same piece of the second source. Slot 888 says how
# wide a piece is, slot 896 which way the shift goes.
x_vpshiftv m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    sz: peek_i64(m, 888)
    if sz is 0
        sz: 4
    if sz is 1
        sz: 8
    poke_i64(m, 952, sz)
    poke_i64(m, 960, peek_i64(m, 896))
    poke_i64(m, 920, x_xlo(m, vv))
    poke_i64(m, 936, x_xrm_lo(m))
    a: x_vshift_2(m)
    poke_i64(m, 920, x_xhi(m, vv))
    poke_i64(m, 936, x_xrm_hi(m))
    b: x_vshift_2(m)
    x_xset(m, n, a, b)
    if peek_i64(m, 736) is 0
        x_yset(m, n, 0, 0)
        return x_go(m, q)
    poke_i64(m, 920, x_ylo(m, vv))
    poke_i64(m, 936, x_xrm_ylo(m))
    a: x_vshift_2(m)
    poke_i64(m, 920, x_yhi(m, vv))
    poke_i64(m, 936, x_xrm_yhi(m))
    b: x_vshift_2(m)
    x_yset(m, n, a, b)
    return x_go(m, q)

# the pieces of one half, each shifted by its own count
x_vshift_2 m:
    a: peek_i64(m, 920)
    c: peek_i64(m, 936)
    sz: peek_i64(m, 952)
    dir: peek_i64(m, 960)
    if sz is 8
        # the count is used whole: sixty-four or more shifts it all
        # the way out
        if c >= 64
            if dir is 2
                if x_sval(a, 8) < 0
                    return 0 - 1
            return 0
        if dir is 0
            return x_shl(a, c, 8)
        if dir is 1
            return x_shr(a, c, 8)
        return x_sar64(a, c)
    r0: 0
    r1: 0
    c0: x_mask(c, 4)
    if c0 >= 32
        if dir is 2
            if x_sval(x_mask(a, 4), 4) < 0
                r0: 0 - 1
        if not
            if dir is 0
                r0: x_shl(x_mask(a, 4), c0, 4)
            if not
                if dir is 1
                    r0: x_shr(x_mask(a, 4), c0, 4)
                if not
                    r0: x_mask(x_sar64(x_sval(x_mask(a, 4), 4), c0), 4)
    c1: x_mask(x_shr64(c, 32), 4)
    if c1 >= 32
        if dir is 2
            if x_sval(x_mask(x_shr64(a, 32), 4), 4) < 0
                r1: 0 - 1
        if not
            if dir is 0
                r1: x_shl(x_mask(x_shr64(a, 32), 4), c1, 4)
            if not
                if dir is 1
                    r1: x_shr(x_mask(x_shr64(a, 32), 4), c1, 4)
                if not
                    r1: x_mask(x_sar64(x_sval(x_mask(x_shr64(a, 32), 4), 4), c1), 4)
    return x_or(r0, x_shl64(r1, 32))
x_fma_lane m:
    a: peek_i64(m, 920)
    b: peek_i64(m, 928)
    c: peek_i64(m, 936)
    ord: peek_i64(m, 896)
    sub: peek_i64(m, 904)
    neg: peek_i64(m, 912)
    m1: a
    m2: b
    ad: c
    if ord is 1
        m1: b
        m2: c
        ad: a
    if ord is 2
        m1: c
        m2: a
        ad: b
    x_unpack(m, m1)
    k1: x_up_kind(m)
    s1: x_up_sign(m)
    e1: x_up_exp(m)
    f1: x_up_frac(m)
    x_unpack(m, m2)
    k2: x_up_kind(m)
    s2: x_up_sign(m)
    e2: x_up_exp(m)
    f2: x_up_frac(m)
    x_unpack(m, ad)
    k3: x_up_kind(m)
    s3: x_up_sign(m)
    e3: x_up_exp(m)
    f3: x_up_frac(m)
    if k1 is X_F_NAN
        return X_QNAN
    if k2 is X_F_NAN
        return X_QNAN
    if k3 is X_F_NAN
        return X_QNAN
    ps: 0
    if s1 is not s2
        ps: 1
    if neg is 1
        ps: 1 - ps
    cs: s3
    if sub is 1
        cs: 1 - cs
    if k1 is X_F_INF
        if k2 is X_F_ZERO
            return X_QNAN
        if k3 is X_F_INF
            if cs is ps
                return x_bits_of(ps, 2047, 0)
            return X_QNAN
        return x_bits_of(ps, 2047, 0)
    if k2 is X_F_INF
        if k1 is X_F_ZERO
            return X_QNAN
        if k3 is X_F_INF
            if cs is ps
                return x_bits_of(ps, 2047, 0)
            return X_QNAN
        return x_bits_of(ps, 2047, 0)
    if k1 is X_F_ZERO
        if k3 is X_F_INF
            return x_bits_of(cs, 2047, 0)
        if k3 is X_F_ZERO
            if ps is cs
                return x_bits_of(ps, 0, 0)
            return 0
        if cs is s3
            return ad
        return x_fneg(ad)
    if k2 is X_F_ZERO
        if k3 is X_F_INF
            return x_bits_of(cs, 2047, 0)
        if k3 is X_F_ZERO
            if ps is cs
                return x_bits_of(ps, 0, 0)
            return 0
        if cs is s3
            return ad
        return x_fneg(ad)
    if k3 is X_F_INF
        return x_bits_of(cs, 2047, 0)
    # the ordinary path: everything is a real number
    hi: x_mulhi_un(f1, f2)
    lo: x_mul(f1, f2)
    e: x_add(e1, e2)
    sh: x_sub(e3, e)
    poke_i64(m, 920, hi)
    poke_i64(m, 928, lo)
    poke_i64(m, 936, f3)
    poke_i64(m, 944, sh)
    poke_i64(m, 952, e)
    poke_i64(m, 960, ps)
    poke_i64(m, 968, cs)
    return x_fma_sum(m)

# the whole sum in a one hundred and twenty-eight bit window, and
# one rounding. The slots hold the product halves, the addend, the
# shift that brings the addend to the product, the product exponent,
# and the two signs.
x_fma_sum m:
    hi: peek_i64(m, 920)
    lo: peek_i64(m, 928)
    f3: peek_i64(m, 936)
    sh: peek_i64(m, 944)
    e: peek_i64(m, 952)
    ps: peek_i64(m, 960)
    cs: peek_i64(m, 968)
    same: 0
    if ps is cs
        same: 1
    cbig: 0
    if sh < 0
        cbig: 0
    if not
        if sh > 74
            cbig: 1
        if not
            ch: 0
            cl: 0
            if sh < 64
                ch: x_shr64(f3, 64 - sh)
                cl: x_shl64(f3, sh)
            if not
                ch: x_shl64(f3, sh - 64)
            if ch > hi
                cbig: 1
            if not
                if ch is hi
                    if cl > lo
                        cbig: 1
    # the window: the bigger one sits whole, the smaller is shifted
    # down to it, and the dropped bits keep their guard and half
    wh: hi
    wl: lo
    ew: e
    bh: 0
    bl: 0
    k: 0
    guard: 0
    half: 0
    stic: 0
    if cbig is 1
        wh: x_shr64(f3, 11)
        wl: x_shl64(f3, 53)
        ew: x_sub(x_add(e, sh), 53)
        k: x_sub(sh, 53)
        if k > 127
            stic: 1
        if not
            if k > 63
                bl: x_shr64(hi, k - 64)
                if lo is not 0
                    stic: 1
                if k > 64
                    if x_and(hi, x_sub(x_shl64(1, k - 64), 1)) is not 0
                        stic: 1
                guard: x_bit(hi, k - 65)
                if guard is 1
                    half: 1
                    if lo is not 0
                        half: 0
                    if k > 64
                        if x_and(hi, x_sub(x_shl64(1, k - 65), 1)) is not 0
                            half: 0
            if not
                bh: x_shr64(hi, k)
                bl: x_or(x_shl64(hi, 64 - k), x_shr64(lo, k))
                if x_and(lo, x_sub(x_shl64(1, k), 1)) is not 0
                    stic: 1
                guard: x_bit(lo, k - 1)
                if guard is 1
                    half: 1
                    if x_and(lo, x_sub(x_shl64(1, k - 1), 1)) is not 0
                        half: 0
    if not
        if sh < 0
            k: x_sub(0, sh)
            if k > 53
                stic: 1
            if not
                bl: x_shr64(f3, k)
                if x_and(f3, x_sub(x_shl64(1, k), 1)) is not 0
                    stic: 1
                guard: x_bit(f3, k - 1)
                if guard is 1
                    half: 1
                    if x_and(f3, x_sub(x_shl64(1, k - 1), 1)) is not 0
                        half: 0
        if not
            if sh < 64
                bh: x_shr64(f3, 64 - sh)
                bl: x_shl64(f3, sh)
            if not
                bh: x_shl64(f3, sh - 64)
    if same is 1
        s: x_add(wl, bl)
        carry: 0
        if s < wl
            carry: 1
        if stic is 1
            s: x_or(s, 1)
        poke_i64(m, 920, x_add(x_add(wh, bh), carry))
        poke_i64(m, 928, s)
        poke_i64(m, 936, ps)
        poke_i64(m, 944, ew)
        return x_fma_norm(m)
    # the difference: borrow one for the fraction of the smaller one,
    # then the fraction decides the rounding of the integer part
    s: x_sub(wl, bl)
    borrow: 0
    if x_ult(wl, bl) is 1
        borrow: 1
    mh: x_sub(x_sub(wh, bh), borrow)
    ml: s
    if stic is 1
        ml: x_sub(ml, 1)
        if s is 0
            mh: x_sub(mh, 1)
    if stic is 1
        if guard is 0
            ml: x_add(ml, 1)
            if ml is 0
                mh: x_add(mh, 1)
        if not
            if half is 1
                if x_bit(ml, 0) is 1
                    ml: x_add(ml, 1)
                    if ml is 0
                        mh: x_add(mh, 1)
    if mh is 0
        if ml is 0
            return 0
    poke_i64(m, 920, mh)
    poke_i64(m, 928, ml)
    if cbig is 1
        poke_i64(m, 936, cs)
    if not
        poke_i64(m, 936, ps)
    poke_i64(m, 944, ew)
    return x_fma_norm(m)

# the one rounding, from the slots the sum was left in
x_fma_norm m:
    return x_norm106(m, peek_i64(m, 936), peek_i64(m, 944), peek_i64(m, 920), peek_i64(m, 928))

# the packed forms: a double in each half, or four singles. The
# second pass of a two hundred and fifty-six bit one runs the same
# work again on the swapped halves.
x_fma_pack m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    if peek_i64(m, 816) is 1
        poke_i64(m, 920, x_xlo(m, vv))
        poke_i64(m, 928, x_xrm_lo(m))
        poke_i64(m, 936, x_xlo(m, n))
        a: x_fma_lane(m)
        poke_i64(m, 920, x_xhi(m, vv))
        poke_i64(m, 928, x_xrm_hi(m))
        poke_i64(m, 936, x_xhi(m, n))
        b: x_fma_lane(m)
        x_xset(m, n, a, b)
        return x_go(m, q)
    poke_i64(m, 920, x_f2d(m, x_mask(x_xlo(m, vv), 4)))
    poke_i64(m, 928, x_f2d(m, x_mask(x_xrm_lo(m), 4)))
    poke_i64(m, 936, x_f2d(m, x_mask(x_xlo(m, n), 4)))
    r0: x_fma_lane(m)
    poke_i64(m, 920, x_f2d(m, x_mask(x_shr64(x_xlo(m, vv), 32), 4)))
    poke_i64(m, 928, x_f2d(m, x_mask(x_shr64(x_xrm_lo(m), 32), 4)))
    poke_i64(m, 936, x_f2d(m, x_mask(x_shr64(x_xlo(m, n), 32), 4)))
    r1: x_fma_lane(m)
    poke_i64(m, 920, x_f2d(m, x_mask(x_xhi(m, vv), 4)))
    poke_i64(m, 928, x_f2d(m, x_mask(x_xrm_hi(m), 4)))
    poke_i64(m, 936, x_f2d(m, x_mask(x_xhi(m, n), 4)))
    r2: x_fma_lane(m)
    poke_i64(m, 920, x_f2d(m, x_mask(x_shr64(x_xhi(m, vv), 32), 4)))
    poke_i64(m, 928, x_f2d(m, x_mask(x_shr64(x_xrm_hi(m), 32), 4)))
    poke_i64(m, 936, x_f2d(m, x_mask(x_shr64(x_xhi(m, n), 32), 4)))
    r3: x_fma_lane(m)
    f0: x_d2f(m, r0)
    f1: x_d2f(m, r1)
    f2: x_d2f(m, r2)
    f3: x_d2f(m, r3)
    x_xset(m, n, x_or(f0, x_shl64(f1, 32)), x_or(f2, x_shl64(f3, 32)))
    return x_go(m, q)

# the scalar forms: the bottom piece only, the rest already copied
# from the first source
x_fma_scalar m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    if peek_i64(m, 816) is 3
        poke_i64(m, 920, x_f2d(m, x_mask(x_xlo(m, vv), 4)))
        poke_i64(m, 928, x_f2d(m, x_mask(x_xrm_lo(m), 4)))
        poke_i64(m, 936, x_f2d(m, x_mask(x_xlo(m, n), 4)))
        r: x_fma_lane(m)
        keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
        x_xset(m, n, x_add(keep, x_d2f(m, r)), x_xhi(m, n))
        return x_go(m, q)
    poke_i64(m, 920, x_xlo(m, vv))
    poke_i64(m, 928, x_xrm_lo(m))
    poke_i64(m, 936, x_xlo(m, n))
    r: x_fma_lane(m)
    x_xset(m, n, r, x_xhi(m, n))
    return x_go(m, q)

# ---- BMI ----
# The bit manipulation instructions: andn, the three bit isolates,
# the bit field ones, mulx, and the variable shifts.

x_andn m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    sz: peek_i64(m, 824)
    a: x_reg(m, vv)
    b: x_rm_get(m, sz)
    x_rset(m, n, sz, x_and(x_not(a), b))
    return x_go(m, q)

# the three of a kind: blsr, blsmsk, blsi, all with the carry flag
# telling whether the source was nothing
x_blsr m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    sz: peek_i64(m, 824)
    s: x_rm_get(m, sz)
    r: x_and(s, x_sub(s, 1))
    x_rset(m, n, sz, r)
    if s is 0
        poke_i64(m, 152, 1)
    if not
        poke_i64(m, 152, 0)
    x_set_zs(m, r, sz)
    poke_i64(m, 160, 0)
    return x_go(m, q)

x_blsmsk m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    sz: peek_i64(m, 824)
    s: x_rm_get(m, sz)
    r: x_xor(s, x_sub(s, 1))
    x_rset(m, n, sz, r)
    if s is 0
        poke_i64(m, 152, 1)
    if not
        poke_i64(m, 152, 0)
    x_set_zs(m, r, sz)
    poke_i64(m, 160, 0)
    return x_go(m, q)

x_blsi m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    sz: peek_i64(m, 824)
    s: x_rm_get(m, sz)
    r: x_and(s, x_sub(0, s))
    x_rset(m, n, sz, r)
    if s is 0
        poke_i64(m, 152, 1)
    if not
        poke_i64(m, 152, 0)
    x_set_zs(m, r, sz)
    poke_i64(m, 160, 0)
    return x_go(m, q)

# bzhi: everything above a bit stays, everything from it on is
# cleared. The carry flag says the bit was past the end.
x_bzhi m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    sz: peek_i64(m, 824)
    a: x_reg(m, vv)
    idx: x_mask(x_rm_get(m, 8), 1)
    bits: x_bits(sz)
    if idx >= bits
        poke_i64(m, 152, 1)
        r: a
    if not
        poke_i64(m, 152, 0)
        r: x_and(a, x_sub(x_shl64(1, idx), 1))
    x_rset(m, n, sz, r)
    x_set_zs(m, r, sz)
    poke_i64(m, 160, 0)
    return x_go(m, q)

# pdep: the bits of the first source go into the places the mask
# says, one by one from the bottom
x_pdep m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    sz: peek_i64(m, 824)
    a: x_reg(m, vv)
    mk: x_rm_get(m, sz)
    r: 0
    k: 0
    i: 0
    as long as i < x_bits(sz)
        if x_bit(mk, i) is 1
            if x_bit(a, k) is 1
                r: x_or(r, x_shl(1, i, sz))
            k: k + 1
        i: i + 1
    x_rset(m, n, sz, r)
    return x_go(m, q)

# pext: the opposite: the bits where the mask says are gathered
# into the bottom
x_pext m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    sz: peek_i64(m, 824)
    a: x_reg(m, vv)
    mk: x_rm_get(m, sz)
    r: 0
    k: 0
    i: 0
    as long as i < x_bits(sz)
        if x_bit(mk, i) is 1
            if x_bit(a, i) is 1
                r: x_or(r, x_shl(1, k, sz))
            k: k + 1
        i: i + 1
    x_rset(m, n, sz, r)
    return x_go(m, q)

# mulx: the register field takes the high half of rdx times the
# second source, the vvvv field the low half
x_mulx m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    sz: peek_i64(m, 824)
    s: x_rm_get(m, sz)
    d: x_reg(m, 2)
    if sz is 8
        hi: x_mulhi_un(s, d)
        lo: x_mul(s, d)
    if not
        p: x_mul(s, d)
        hi: x_shr64(p, 32)
        lo: x_mask(p, 4)
    x_rset(m, n, sz, hi)
    x_rset(m, vv, sz, lo)
    return x_go(m, q)

# bextr: a field out of the first source, start and length in the
# second
x_bextr m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    sz: peek_i64(m, 824)
    a: x_reg(m, vv)
    ctl: x_rm_get(m, 8)
    st: x_mask(ctl, 1)
    ln: x_mask(x_shr64(ctl, 8), 1)
    bits: x_bits(sz)
    r: 0
    if st < bits
        if ln is not 0
            avail: x_sub(bits, st)
            if ln > avail
                ln: avail
            r: x_and(x_shr64(a, st), x_sub(x_shl64(1, ln), 1))
    x_rset(m, n, sz, r)
    poke_i64(m, 152, 0)
    x_set_zs(m, r, sz)
    poke_i64(m, 160, 0)
    return x_go(m, q)

# shlx, shrx and sarx: one shift, with the count in the second
# source
x_var_shift m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    vv: peek_i64(m, 720)
    sz: peek_i64(m, 824)
    a: x_reg(m, vv)
    c: x_rm_get(m, sz)
    cnt: x_mask(c, 1) % x_bits(sz)
    if peek_i64(m, 896) is 0
        r: x_shl(a, cnt, sz)
    if not
        if peek_i64(m, 896) is 1
            r: x_shr(a, cnt, sz)
        if not
            if sz is 8
                r: x_sar64(a, cnt)
            if not
                r: x_mask(x_sar64(x_sval(x_mask(a, 4), 4), cnt), 4)
    x_rset(m, n, sz, r)
    return x_go(m, q)

# rorx: a rotate by a fixed amount, no flags at all
x_rorx m:
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    sz: peek_i64(m, 824)
    im: peek_i64(m, 888)
    s: x_rm_get(m, sz)
    bits: x_bits(sz)
    c: x_and(im, x_sub(bits, 1))
    r: x_or(x_shr(s, c, sz), x_shl(s, x_sub(bits, c), sz))
    x_rset(m, n, sz, x_mask(r, sz))
    return x_go(m, q + 1)

x_vex_of m:
    op: peek_i64(m, 800)
    pre: peek_i64(m, 816)
    sz: peek_i64(m, 824)
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    if op is 16
        return x_vmov_in(m, q, n, pre)
    if op is 17
        return x_vmov_out(m, q, n, pre)
    if op is 40
        return x_vmov_in(m, q, n, pre)
    if op is 41
        return x_vmov_out(m, q, n, pre)
    if op is 43
        return x_vmov_out(m, q, n, pre)
    if op is 110
        return x_vmov_in(m, q, n, pre)
    if op is 111
        return x_vmov_in(m, q, n, pre)
    if op is 126
        return x_vmov_out(m, q, n, pre)
    if op is 127
        return x_vmov_out(m, q, n, pre)
    if op is 231
        return x_vmov_out(m, q, n, pre)
    if op is 42
        return x_cvt_i2f(m, q, n, pre, sz)
    if op is 44
        return x_cvt_f2i(m, q, n, pre, sz, 0)
    if op is 45
        return x_cvt_f2i(m, q, n, pre, sz, 1)
    if op is 90
