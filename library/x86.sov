    hi: 0
    lo: 0
    if sh >= 64
        hi: x_shl64(f, sh - 64)
    if not
        if sh > 0
            hi: x_shr64(f, 64 - sh)
        lo: x_shl64(f, sh)
    ee: (e - sh) / 2
