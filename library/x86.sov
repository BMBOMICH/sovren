    if op is 64
        return x_w_pmulld(m)
    if op is 120
        poke_i64(m, 888, 1)
        return x_vbroadcast(m)
    if op is 121
        poke_i64(m, 888, 2)
        return x_vbroadcast(m)
    if op is 200
        return x_w_sha1nexte(m)
    if op is 201
        return x_w_sha1msg1(m)
    if op is 202
        return x_w_sha1msg2(m)
    if op is 203
        return x_w_sha256rnds2(m)
    if op is 204
        return x_w_sha256msg1(m)
    if op is 205
        return x_w_sha256msg2(m)
    if op is 219
        return x_w_aesimc(m)
    if op is 220
        return x_w_aesenc(m)
    if op is 221
        return x_w_aesenclast(m)
    if op is 222
        return x_w_aesdec(m)
    if op is 223
        return x_w_aesdeclast(m)
    if op is 242
        return x_andn(m)
    if op is 243
        rg: x_md_reg(m)
        if rg % 8 is 1
            return x_blsr(m)
        if rg % 8 is 2
            return x_blsmsk(m)
        return x_blsi(m)
    if op is 245
        if pre is 1
            return x_bzhi(m)
        if pre is 2
            return x_pdep(m)
        return x_pext(m)
    if op is 246
        return x_mulx(m)
    if op is 247
        if pre is 0
            return x_bextr(m)
        if pre is 1
            poke_i64(m, 896, 0)
            return x_var_shift(m)
        if pre is 2
            poke_i64(m, 896, 1)
            return x_var_shift(m)
        poke_i64(m, 896, 2)
        return x_var_shift(m)
    # the FMA forms
    if op >= 152
        if op <= 191
            fw: peek_i64(m, 776)
            ord: 0
            if op >= 168
                ord: 1
            if op >= 184
                ord: 2
            poke_i64(m, 888, fw)
            poke_i64(m, 896, ord)
            poke_i64(m, 904, x_bit(op, 1))
            poke_i64(m, 912, x_bit(op, 3))
            if x_and(op, 1) is 1
                return x_fma_scalar(m)
            return x_fma_pack(m)
    return 0

x_vex_3a m:
    op: peek_i64(m, 800)
    pre: peek_i64(m, 816)
    sz: peek_i64(m, 824)
    rx: peek_i64(m, 784)
    q: peek_i64(m, 864)
    n: peek_i64(m, 872)
    if op is 2
        poke_i64(m, 888, x_r8(m, q))
        return x_vpblendd(m)
    if op is 4
        return x_vpermilps(m)
    if op is 5
        return x_vpermilpd(m)
    if op is 6
        poke_i64(m, 888, x_r8(m, q))
        poke_i64(m, 896, 0)
        return x_vperm2(m)
    if op is 8
        im: x_r8(m, q)
        return x_roundp(m, q + 1, n, 1, im)
    if op is 9
        im: x_r8(m, q)
        return x_roundp(m, q + 1, n, 8, im)
    if op is 10
        im: x_r8(m, q)
        return x_roundp(m, q + 1, n, 2, im)
    if op is 11
        im: x_r8(m, q)
        return x_roundp(m, q + 1, n, 4, im)
    if op is 14
        im: x_r8(m, q)
        return x_pblend_imm(m, q + 1, n, im, 2, 0)
    if op is 15
        im: x_r8(m, q)
        return x_palignr(m, q + 1, n, im)
    if op is 20
        im: x_r8(m, q)
        return x_pextr(m, q + 1, n, im, 1, rx)
    if op is 21
        im: x_r8(m, q)
        return x_pextr(m, q + 1, n, im, 2, rx)
    if op is 22
        im: x_r8(m, q)
        return x_pextr(m, q + 1, n, im, 4, rx)
    if op is 23
        im: x_r8(m, q)
        return x_pextr(m, q + 1, n, im, 4, 0)
    if op is 24
        poke_i64(m, 888, x_r8(m, q))
        return x_vinsertf128(m)
    if op is 25
        poke_i64(m, 888, x_r8(m, q))
        return x_vextractf128(m)
    if op is 32
        im: x_r8(m, q)
        return x_pinsr(m, q + 1, n, im, 1, rx)
    if op is 33
        im: x_r8(m, q)
        return x_insertps(m, q + 1, n, im)
    if op is 34
        im: x_r8(m, q)
        return x_pinsr(m, q + 1, n, im, 4, rx)
    if op is 40
        im: x_r8(m, q)
        return x_dpps(m, q + 1, n, im)
    if op is 41
        im: x_r8(m, q)
        return x_dppd(m, q + 1, n, im)
    if op is 44
        im: x_r8(m, q)
        return x_pclmulqdq(m, q + 1, n, im)
    if op is 70
        poke_i64(m, 888, x_r8(m, q))
        poke_i64(m, 896, 1)
        return x_vperm2(m)
    if op is 206
        im: x_r8(m, q)
        return x_sha1rnds4(m, q + 1, n, im)
    if op is 223
        im: x_r8(m, q)
        return x_aeskeygenassist(m, q + 1, n, im)
    if op is 240
        poke_i64(m, 888, x_r8(m, q))
        return x_rorx(m)
    return 0

# ---- SHA ----
# The SHA-1 and SHA-256 round instructions. Everything is whole
# numbers: a dword is kept in the low thirty-two bits and the sums
# wrap, which is what the hashes want.

x_d32 v:
    return x_and(v, 4294967295)

x_dadd a b:
    return x_d32(x_add(a, b))

x_dnot v:
    return x_d32(x_not(v))

x_drol v n:
    return x_d32(x_or(x_shl64(v, n), x_shr64(v, 32 - n)))

x_dror v n:
    return x_d32(x_or(x_shr64(v, n), x_shl64(v, 32 - n)))

# one dword of a vector register
x_xd m reg i:
    return x_d32(x_shr64(x_xlo(m, reg), i * 32))

x_xd_set m reg i v:
    t: x_xlo(m, reg)
    keep: x_sub(t, x_shl64(x_mask(x_shr64(t, i * 32), 4), i * 32))
    x_xset(m, reg, x_add(keep, x_shl64(x_d32(v), i * 32)), x_xhi(m, reg))
    return 0

# the four SHA-1 functions
x_f0 b c d:
    return x_d32(x_or(x_and(b, c), x_and(x_dnot(b), d)))

x_f1 b c d:
    return x_xor(x_xor(b, c), d)

x_f2 b c d:
    return x_xor(x_xor(x_and(b, c), x_and(b, d)), x_and(c, d))

# four rounds of SHA-1. The immediate picks the function and the
# round constant.
x_sha1rnds4 m q n im:
    a: x_xd(m, n, 3)
    b: x_xd(m, n, 2)
    c: x_xd(m, n, 1)
    d: x_xd(m, n, 0)
    rmi: peek_i64(m, 376)
    w0: x_xd(m, rmi, 3)
    w1: x_xd(m, rmi, 2)
    w2: x_xd(m, rmi, 1)
    w3: x_xd(m, rmi, 0)
    k: 1518500249
    f: x_f0(b, c, d)
    if im % 4 is 1
        k: 1859775393
        f: x_f1(b, c, d)
    if im % 4 is 2
        k: 2400959708
        f: x_f2(b, c, d)
    if im % 4 is 3
        k: 3395469782
        f: x_f1(b, c, d)
    e: 0
    t: x_dadd(x_dadd(f, x_drol(a, 5)), x_dadd(w0, k))
    e: d
    d: c
    c: x_drol(b, 30)
    b: a
    a: t
    k: 1518500249
    f: x_f0(b, c, d)
    if im % 4 is 1
        k: 1859775393
        f: x_f1(b, c, d)
    if im % 4 is 2
        k: 2400959708
        f: x_f2(b, c, d)
    if im % 4 is 3
        k: 3395469782
        f: x_f1(b, c, d)
    t: x_dadd(x_dadd(f, x_drol(a, 5)), x_dadd(w1, k))
    t: x_dadd(t, e)
    e: d
    d: c
    c: x_drol(b, 30)
    b: a
    a: t
    k: 1518500249
    f: x_f0(b, c, d)
    if im % 4 is 1
        k: 1859775393
        f: x_f1(b, c, d)
    if im % 4 is 2
        k: 2400959708
        f: x_f2(b, c, d)
    if im % 4 is 3
        k: 3395469782
        f: x_f1(b, c, d)
    t: x_dadd(x_dadd(f, x_drol(a, 5)), x_dadd(w2, k))
    t: x_dadd(t, e)
    e: d
    d: c
    c: x_drol(b, 30)
    b: a
    a: t
    k: 1518500249
    f: x_f0(b, c, d)
    if im % 4 is 1
        k: 1859775393
        f: x_f1(b, c, d)
    if im % 4 is 2
        k: 2400959708
        f: x_f2(b, c, d)
    if im % 4 is 3
        k: 3395469782
        f: x_f1(b, c, d)
    t: x_dadd(x_dadd(f, x_drol(a, 5)), x_dadd(w3, k))
    t: x_dadd(t, e)
    x_xd_set(m, n, 3, t)
    x_xd_set(m, n, 2, b)
    x_xd_set(m, n, 1, c)
    x_xd_set(m, n, 0, d)
    return x_go(m, q)

x_sha1nexte m q n:
    rmi: peek_i64(m, 376)
    t: x_drol(x_xd(m, n, 3), 30)
    v0: x_xd(m, rmi, 0)
    v1: x_xd(m, rmi, 1)
    v2: x_xd(m, rmi, 2)
    v3: x_dadd(x_xd(m, rmi, 3), t)
    x_xd_set(m, n, 0, v0)
    x_xd_set(m, n, 1, v1)
    x_xd_set(m, n, 2, v2)
    x_xd_set(m, n, 3, v3)
    return x_go(m, q)

x_sha1msg1 m q n:
    rmi: peek_i64(m, 376)
    w0: x_xd(m, n, 3)
    w1: x_xd(m, n, 2)
    w2: x_xd(m, n, 1)
    w3: x_xd(m, n, 0)
    w4: x_xd(m, rmi, 3)
    w5: x_xd(m, rmi, 2)
    x_xd_set(m, n, 3, x_xor(w2, w0))
    x_xd_set(m, n, 2, x_xor(w3, w1))
    x_xd_set(m, n, 1, x_xor(w4, w2))
    x_xd_set(m, n, 0, x_xor(w5, w3))
    return x_go(m, q)

x_sha1msg2 m q n:
    rmi: peek_i64(m, 376)
    w13: x_xd(m, rmi, 2)
    w14: x_xd(m, rmi, 1)
    w15: x_xd(m, rmi, 0)
    w16: x_drol(x_xor(x_xd(m, n, 3), w13), 1)
    w17: x_drol(x_xor(x_xd(m, n, 2), w14), 1)
    w18: x_drol(x_xor(x_xd(m, n, 1), w15), 1)
    w19: x_drol(x_xor(x_xd(m, n, 0), w16), 1)
    x_xd_set(m, n, 3, w16)
    x_xd_set(m, n, 2, w17)
    x_xd_set(m, n, 1, w18)
    x_xd_set(m, n, 0, w19)
    return x_go(m, q)

# the SHA-256 helpers
x_ch e f g:
    return x_xor(x_and(e, f), x_and(x_dnot(e), g))

x_maj a b c:
    return x_xor(x_xor(x_and(a, b), x_and(a, c)), x_and(b, c))

x_sg0 a:
    return x_xor(x_xor(x_dror(a, 2), x_dror(a, 13)), x_dror(a, 22))

x_sg1 e:
    return x_xor(x_xor(x_dror(e, 6), x_dror(e, 11)), x_dror(e, 25))

x_ss0 a:
    return x_xor(x_xor(x_dror(a, 7), x_dror(a, 18)), x_shr64(a, 3))

x_ss1 a:
    return x_xor(x_xor(x_dror(a, 17), x_dror(a, 19)), x_shr64(a, 10))

# two rounds of SHA-256, with the message-plus-constant from xmm0
x_sha256rnds2 m q n:
    rmi: peek_i64(m, 376)
    a: x_xd(m, rmi, 3)
    b: x_xd(m, rmi, 2)
    c: x_xd(m, n, 3)
    d: x_xd(m, n, 2)
    e: x_xd(m, rmi, 1)
    f: x_xd(m, rmi, 0)
    g: x_xd(m, n, 1)
    h: x_xd(m, n, 0)
    wk0: x_xd(m, 0, 0)
    wk1: x_xd(m, 0, 1)
    t1: x_dadd(x_dadd(x_dadd(x_ch(e, f, g), x_sg1(e)), wk0), h)
    t2: x_dadd(x_dadd(x_maj(a, b, c), x_sg0(a)), t1)
    h: g
    g: f
    f: e
    e: x_dadd(t1, d)
    d: c
    c: b
    b: a
    a: t2
    t1: x_dadd(x_dadd(x_dadd(x_ch(e, f, g), x_sg1(e)), wk1), h)
    t2: x_dadd(x_dadd(x_maj(a, b, c), x_sg0(a)), t1)
    h: g
    g: f
    f: e
    e: x_dadd(t1, d)
    d: c
    c: b
    b: a
    a: t2
    x_xd_set(m, n, 3, a)
    x_xd_set(m, n, 2, b)
    x_xd_set(m, n, 1, e)
    x_xd_set(m, n, 0, f)
    return x_go(m, q)

x_sha256msg1 m q n:
    rmi: peek_i64(m, 376)
    w0: x_xd(m, n, 3)
    w1: x_xd(m, n, 2)
    w2: x_xd(m, n, 1)
    w3: x_xd(m, n, 0)
    w4: x_xd(m, rmi, 0)
    x_xd_set(m, n, 3, x_dadd(w3, x_ss0(w4)))
    x_xd_set(m, n, 2, x_dadd(w2, x_ss0(w3)))
    x_xd_set(m, n, 1, x_dadd(w1, x_ss0(w2)))
    x_xd_set(m, n, 0, x_dadd(w0, x_ss0(w1)))
    return x_go(m, q)

x_sha256msg2 m q n:
    rmi: peek_i64(m, 376)
    w14: x_xd(m, rmi, 1)
    w15: x_xd(m, rmi, 2)
    w16: x_dadd(x_xd(m, n, 0), x_ss1(w14))
    w17: x_dadd(x_xd(m, n, 1), x_ss1(w15))
    w18: x_dadd(x_xd(m, n, 2), x_ss1(w16))
    w19: x_dadd(x_xd(m, n, 3), x_ss1(w17))
    x_xd_set(m, n, 3, w19)
    x_xd_set(m, n, 2, w18)
    x_xd_set(m, n, 1, w17)
    x_xd_set(m, n, 0, w16)
    return x_go(m, q)

x_zf m:
    return peek_i64(m, 136)

x_sf m:
    return peek_i64(m, 144)

x_cf m:
    return peek_i64(m, 152)

x_of m:
    return peek_i64(m, 160)

x_pf m:
    return peek_i64(m, 328)

x_af m:
    return peek_i64(m, 344)

x_df m:
    return peek_i64(m, 352)

# The parity flag counts the one bits in the LOW BYTE only, whatever
# the width of the sum, and is set when that count is even. Real
# programs test it after comparing floating point numbers.
x_parity v:
    b: x_mask(v, 1)
    n: 0
    i: 0
    as long as i < 8
        if b % 2 is 1
            n: n + 1
        b: b / 2
        i: i + 1
    if n % 2 is 0
        return 1
    return 0

x_set_zs m r size:
    z: 0
    if x_mask(r, size) is 0
        z: 1
    poke_i64(m, 136, z)
    poke_i64(m, 144, x_neg_at(r, size))
    poke_i64(m, 328, x_parity(r))
    return 0

# after a subtract or a compare
x_flags_sub m a b size:
    ua: x_mask(a, size)
    ub: x_mask(b, size)
    r: x_mask(x_sub(ua, ub), size)
    x_set_zs(m, r, size)
    c: 0
    if size is 8
        c: x_ult(ua, ub)
    if not
        if ua < ub
            c: 1
    poke_i64(m, 152, c)
    na: x_neg_at(ua, size)
    nb: x_neg_at(ub, size)
    nr: x_neg_at(r, size)
    o: 0
    if na is not nb
        if nr is not na
            o: 1
    poke_i64(m, 160, o)
    # the adjust flag: a borrow out of the low four bits
    af: 0
    if ua % 16 < ub % 16
        af: 1
    poke_i64(m, 344, af)
    return r

# after an add
x_flags_add m a b size:
    ua: x_mask(a, size)
    ub: x_mask(b, size)
    r: x_mask(x_add(ua, ub), size)
    x_set_zs(m, r, size)
    c: 0
    if size is 8
        c: x_ult(r, ua)
    if not
        if ua + ub >= x_wide(size)
            c: 1
    poke_i64(m, 152, c)
    na: x_neg_at(ua, size)
    nb: x_neg_at(ub, size)
    nr: x_neg_at(r, size)
    o: 0
    if na is nb
        if nr is not na
            o: 1
    poke_i64(m, 160, o)
    # the adjust flag: a carry out of the low four bits
    af: 0
    if ua % 16 + ub % 16 > 15
        af: 1
    poke_i64(m, 344, af)
    return r

# add with the carry joining in, and subtract with a borrow
x_flags_adc m a b size cin:
    ua: x_mask(a, size)
    ub: x_mask(b, size)
    r: x_mask(x_add(x_add(ua, ub), cin), size)
    x_set_zs(m, r, size)
    c: 0
    if size is 8
        # a carry happened if the answer did not get bigger
        if cin is 1
            if x_ult(r, ua) is 1
                c: 1
            if r is ua
                c: 1
        if not
            c: x_ult(r, ua)
    if not
        if ua + ub + cin >= x_wide(size)
            c: 1
    poke_i64(m, 152, c)
    na: x_neg_at(ua, size)
    nb: x_neg_at(ub, size)
    nr: x_neg_at(r, size)
    o: 0
    if na is nb
        if nr is not na
            o: 1
    poke_i64(m, 160, o)
    af: 0
    if ua % 16 + ub % 16 + cin > 15
        af: 1
    poke_i64(m, 344, af)
    return r

x_flags_sbb m a b size cin:
    ua: x_mask(a, size)
    ub: x_mask(b, size)
    r: x_mask(x_sub(x_sub(ua, ub), cin), size)
    x_set_zs(m, r, size)
    c: 0
    if size is 8
        if cin is 1
            if x_ult(ua, ub) is 1
                c: 1
            if ua is ub
                c: 1
        if not
            c: x_ult(ua, ub)
    if not
        if ua < ub + cin
            c: 1
    poke_i64(m, 152, c)
    na: x_neg_at(ua, size)
    nb: x_neg_at(ub, size)
    nr: x_neg_at(r, size)
    o: 0
    if na is not nb
        if nr is not na
            o: 1
    poke_i64(m, 160, o)
    af: 0
    if ua % 16 < ub % 16 + cin
        af: 1
    poke_i64(m, 344, af)
    return r

x_wide size:
    if size is 1
        return 256
    if size is 2
        return 65536
    return X_2_32

# after and, or, xor, test: no carry and no overflow
x_flags_logic m r size:
    x_set_zs(m, r, size)
    poke_i64(m, 152, 0)
    poke_i64(m, 160, 0)
    return x_mask(r, size)

# ---------------------------------------------------------------
# the sixteen conditions, by their number in the opcode
# ---------------------------------------------------------------

x_cond m c:
    if c is 0
        return x_of(m)
    if c is 1
        return 1 - x_of(m)
    if c is 2
        return x_cf(m)
    if c is 3
        return 1 - x_cf(m)
    if c is 4
        return x_zf(m)
    if c is 5
        return 1 - x_zf(m)
    if c is 6
        if x_cf(m) is 1
            return 1
        return x_zf(m)
    if c is 7
        if x_cf(m) is 1
            return 0
        return 1 - x_zf(m)
    if c is 8
        return x_sf(m)
    if c is 9
        return 1 - x_sf(m)
    if c is 10
        return x_pf(m)
    if c is 11
        return 1 - x_pf(m)
    if c is 12
        if x_sf(m) is not x_of(m)
            return 1
        return 0
    if c is 13
        if x_sf(m) is x_of(m)
            return 1
        return 0
    if c is 14
        if x_zf(m) is 1
            return 1
        if x_sf(m) is not x_of(m)
            return 1
        return 0
    if x_zf(m) is 0
        if x_sf(m) is x_of(m)
            return 1
    return 0

# ---------------------------------------------------------------
# taking an instruction apart
# ---------------------------------------------------------------
#
# The byte after the opcode says which registers, and may be followed
# by another byte and up to four more for an offset. The answer goes
# into the scratch slots because a job hands back one value.
#
#   360  is the second operand a register?
#   368  which register the reg field names
#   376  the register number, or the address
#   384  where the next byte is

x_md_isreg m:
    return peek_i64(m, 360)

x_md_reg m:
    return peek_i64(m, 368)

x_md_rm m:
    return peek_i64(m, 376)

x_md_next m:
    return peek_i64(m, 384)

# rex is the four low bits of the prefix, or zero when there was none.
# immlen is how many bytes of number follow, which only matters for
# the form that counts from the end of the instruction.
x_modrm m at rex immlen:
    b: x_r8(m, at)
    mod: b / 64
    reg: (b / 8) % 8 + ((rex / 4) % 2) * 8
    rm: b % 8
    p: at + 1
    poke_i64(m, 368, reg)
    if mod is 3
        poke_i64(m, 360, 1)
        poke_i64(m, 376, rm + (rex % 2) * 8)
        poke_i64(m, 384, p)
        return p
    poke_i64(m, 360, 0)
    ea: 0
    if rm is 4
        sib: x_r8(m, p)
        p: p + 1
        sc: sib / 64
        ix: (sib / 8) % 8 + ((rex / 2) % 2) * 8
        bs: sib % 8 + (rex % 2) * 8
        if ix is not 4
            ea: x_mul(x_reg(m, ix), x_scale(sc))
        if bs % 8 is 5
            if mod is 0
                ea: x_add(ea, x_i32(m, p))
                p: p + 4
            if not
                ea: x_add(ea, x_reg(m, bs))
        if not
            ea: x_add(ea, x_reg(m, bs))
    if not
        if rm is 5
            if mod is 0
                d: x_i32(m, p)
                p: p + 4
                poke_i64(m, 376, x_add(x_add(p, immlen), d))
                poke_i64(m, 384, p)
                return p
        ea: x_reg(m, rm + (rex % 2) * 8)
    if mod is 1
        ea: x_add(ea, x_i8(m, p))
        p: p + 1
    if mod is 2
        ea: x_add(ea, x_i32(m, p))
        p: p + 4
    # fs and gs move the whole address. Thread-local storage lives
    # behind fs on Linux and gs on Windows and Mac.
    sg: peek_i64(m, 432)
    if sg is 1
        ea: x_add(ea, peek_i64(m, 440))
    if sg is 2
        ea: x_add(ea, peek_i64(m, 448))
    poke_i64(m, 376, ea)
    poke_i64(m, 384, p)
    return p

x_scale sc:
    if sc is 0
        return 1
    if sc is 1
        return 2
    if sc is 2
        return 4
    return 8

# read the second operand, register or memory
x_rm_get m size:
    if peek_i64(m, 360) is 1
        if size is 1
            return x_b_get(m, peek_i64(m, 376), peek_i64(m, 392))
        return x_rget(m, peek_i64(m, 376), size)
    return x_load(m, peek_i64(m, 376), size)

# write the second operand
x_rm_set m size v:
    if peek_i64(m, 360) is 1
        if size is 1
            return x_b_set(m, peek_i64(m, 376), peek_i64(m, 392), v)
        return x_rset(m, peek_i64(m, 376), size, v)
    return x_store(m, peek_i64(m, 376), size, v)

# the register named by the reg field, at a width
x_reg_get m size:
    if size is 1
        return x_b_get(m, peek_i64(m, 368), peek_i64(m, 392))
    return x_rget(m, peek_i64(m, 368), size)

x_reg_set m size v:
    if size is 1
        return x_b_set(m, peek_i64(m, 368), peek_i64(m, 392), v)
    return x_rset(m, peek_i64(m, 368), size, v)

# ---------------------------------------------------------------
# the stack
# ---------------------------------------------------------------

x_push m v:
    sp: x_sub(x_sp(m), 8)
    x_set_sp(m, sp)
    x_w64(m, sp, v)
    return 0

x_pop m:
    sp: x_sp(m)
    v: x_r64(m, sp)
    x_set_sp(m, x_add(sp, 8))
    return v

# ---------------------------------------------------------------
# one instruction
# ---------------------------------------------------------------

# returns 1 to keep going, 0 to stop
x_step m:
    pc: x_rip(m)
    p: pc
    rex: 0
    hasrex: 0
    size: 4
    rep: 0
    seg: 0
    poke_i64(m, 424, 0)

    # ---- the prefixes ----
    # Almost every instruction has either no prefix at all or a
    # single REX, so those two are settled first without going near
    # the loop below. The loop is correct but it asks a dozen
    # questions per instruction, and this is the hottest code here.
    b: x_r8(m, p)
    if b >= 64
        if b <= 79
            n2: x_r8(m, p + 1)
            if x_is_prefix(n2) is 0
                rex: b - 64
                hasrex: 1
                if rex >= 8
                    size: 8
                poke_i64(m, 392, 1)
                poke_i64(m, 416, 0)
                poke_i64(m, 432, 0)
                return x_op(m, n2, p + 2, rex, size, 1)
    if x_is_prefix(b) is 0
        poke_i64(m, 392, 0)
        poke_i64(m, 416, 0)
        poke_i64(m, 432, 0)
        return x_op(m, b, p + 1, 0, 4, 0)

    # ---- the slow way, when there really are prefixes ----
    # Any number, in any order, and REX must be the last one before
    # the opcode. Anything else after a REX cancels it.
    more: 1
    as long as more is 1
        b: x_r8(m, p)
        if b is 102
            size: 2
            rex: 0
            hasrex: 0
            p: p + 1
        if not
            if b is 243
                rep: 1
                rex: 0
                hasrex: 0
                p: p + 1
            if not
                if b is 242
                    rep: 2
                    rex: 0
                    hasrex: 0
                    p: p + 1
                if not
                    if b is 240
                        poke_i64(m, 424, 1)
                        rex: 0
                        hasrex: 0
                        p: p + 1
                    if not
                        if b is 100
                            seg: 1
                            rex: 0
                            hasrex: 0
                            p: p + 1
                        if not
                            if b is 101
                                seg: 2
                                rex: 0
                                hasrex: 0
                                p: p + 1
                            if not
                                if b is 46
                                    p: p + 1
                                if not
                                    if b is 62
                                        p: p + 1
                                    if not
                                        if b is 54
                                            p: p + 1
                                        if not
                                            if b is 38
                                                p: p + 1
                                            if not
                                                if b is 103
                                                    p: p + 1
                                                if not
                                                    if b >= 64
                                                        if b <= 79
                                                            rex: b - 64
                                                            hasrex: 1
                                                            p: p + 1
                                                            if rex >= 8
                                                                size: 8
                                                        if not
                                                            more: 0
                                                    if not
                                                        more: 0
    b: x_r8(m, p)
    poke_i64(m, 392, hasrex)
    poke_i64(m, 416, rep)
    poke_i64(m, 432, seg)
    p: p + 1

    # a string instruction with a repeat in front is its own thing
    if rep is not 0
        if x_is_string(b) is 1
            return x_string(m, b, p, size, rep)
    return x_op(m, b, p, rex, size, hasrex)

# is this byte a prefix of any kind?
x_is_prefix b:
    if b is 102
        return 1
    if b is 243
        return 1
    if b is 242
        return 1
    if b is 240
        return 1
    if b is 100
        return 1
    if b is 101
        return 1
    if b is 46
        return 1
    if b is 62
        return 1
    if b is 54
        return 1
    if b is 38
        return 1
    if b is 103
        return 1
    if b >= 64
        if b <= 79
            return 1
    return 0

# the opcode itself, with the prefixes already dealt with
x_op m b p rex size hasrex:

    # a VEX prefix turns the instruction after it into its AVX form
    if b is 196
        return x_vex_enter(m, p - 1, size)
    if b is 197
        return x_vex_enter(m, p - 1, size)


    # mov r/m, r   and   mov r, r/m : more than half of all code
    if b is 137
        p: x_modrm(m, p, rex, 0)
        x_rm_set(m, size, x_rget(m, x_md_reg(m), size))
        return x_go(m, p)
    if b is 139
        p: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), size, x_rm_get(m, size))
        return x_go(m, p)
    if b is 136
        p: x_modrm(m, p, rex, 0)
        x_rm_set(m, 1, x_reg_get(m, 1))
        return x_go(m, p)
    if b is 138
        p: x_modrm(m, p, rex, 0)
        x_reg_set(m, 1, x_rm_get(m, 1))
        return x_go(m, p)

    # push and pop a register
    if b >= 80
        if b <= 87
            x_push(m, x_reg(m, b - 80 + (rex % 2) * 8))
            return x_go(m, p)
    if b >= 88
        if b <= 95
            x_setr(m, b - 88 + (rex % 2) * 8, x_pop(m))
            return x_go(m, p)

    # a number straight into a register
    if b >= 184
        if b <= 191
            r: b - 184 + (rex % 2) * 8
            if size is 8
                x_setr(m, r, x_make(x_r32(m, p + 4), x_r32(m, p)))
                return x_go(m, p + 8)
            if size is 2
                x_rset(m, r, 2, x_r16(m, p))
                return x_go(m, p + 2)
            x_rset(m, r, 4, x_r32(m, p))
            return x_go(m, p + 4)
    if b >= 176
        if b <= 183
            r: b - 176 + (rex % 2) * 8
            x_b_set(m, r, hasrex, x_r8(m, p))
            return x_go(m, p + 1)

    # call, jump, return
    if b is 232
        d: x_i32(m, p)
        nx: p + 4
        x_push(m, nx)
        return x_go(m, x_add(nx, d))
    if b is 233
        d: x_i32(m, p)
        return x_go(m, x_add(p + 4, d))
    if b is 235
        d: x_i8(m, p)
        return x_go(m, x_add(p + 1, d))
    if b is 195
        v: x_pop(m)
        if v is peek_i64(m, 320)
            poke_i64(m, 168, X_EXITED)
            return 0
        return x_go(m, v)
    if b is 201
        x_set_sp(m, x_reg(m, 5))
        x_setr(m, 5, x_pop(m))
        return x_go(m, p)

    # the two byte opcodes
    if b is 15
        return x_two(m, p, rex, size)

    # compare and test, the shapes the back end emits
    if b is 57
        p: x_modrm(m, p, rex, 0)
        x_flags_sub(m, x_rm_get(m, size), x_rget(m, x_md_reg(m), size), size)
        return x_go(m, p)
    if b is 59
        p: x_modrm(m, p, rex, 0)
        x_flags_sub(m, x_rget(m, x_md_reg(m), size), x_rm_get(m, size), size)
        return x_go(m, p)
    if b is 56
        p: x_modrm(m, p, rex, 0)
        x_flags_sub(m, x_rm_get(m, 1), x_reg_get(m, 1), 1)
        return x_go(m, p)
    if b is 58
        p: x_modrm(m, p, rex, 0)
        x_flags_sub(m, x_reg_get(m, 1), x_rm_get(m, 1), 1)
        return x_go(m, p)
    if b is 61
        x_flags_sub(m, x_rget(m, 0, size), x_imm(m, p, size), size)
        return x_go(m, p + x_immlen(size))
    if b is 60
        x_flags_sub(m, x_rget(m, 0, 1), x_r8(m, p), 1)
        return x_go(m, p + 1)
    if b is 133
        p: x_modrm(m, p, rex, 0)
        x_flags_logic(m, x_and(x_rm_get(m, size), x_rget(m, x_md_reg(m), size)), size)
        return x_go(m, p)
    if b is 132
        p: x_modrm(m, p, rex, 0)
        x_flags_logic(m, x_and(x_rm_get(m, 1), x_reg_get(m, 1)), 1)
        return x_go(m, p)

    # a short jump on a condition
    if b >= 112
        if b <= 127
            d: x_i8(m, p)
            if x_cond(m, b - 112) is 1
                return x_go(m, x_add(p + 1, d))
            return x_go(m, p + 1)

    return x_step2(m, b, p, rex, size)

# move the instruction pointer on and say carry on
x_go m to:
    poke_i64(m, 128, to)
    return 1

# ---- the number written into an instruction ----
#
# An instruction that carries a number carries FOUR bytes at eight
# and at thirty-two bits wide, but only TWO at sixteen. Reading four
# every time walks past the end of the instruction and everything
# after it decodes as rubbish. The 66 prefix is rare in code a
# compiler emits, which is why this went unnoticed until a C library
# turned up using it.
x_imm m p size:
    if size is 2
        return x_r16(m, p)
    return x_sext32(x_r32(m, p), size)

# how many bytes that number took
x_immlen size:
    if size is 2
        return 2
    return 4

# widen a four byte number to the width in use
x_sext32 v size:
    if size is 8
        if v >= X_2_31
            return v - X_2_32
        return v
    return v

# ---------------------------------------------------------------
# the rest of the instructions
# ---------------------------------------------------------------

x_step2 m b p rex size:
    # ---- the eight sums, in all six shapes ----
    #
    # add or adc sbb and sub xor cmp are laid out in a block: the
    # opcode is op*8 + shape, where shape 0..5 is
    #   0  r/m8, r8      1  r/m, r      2  r8, r/m8
    #   3  r, r/m        4  al, imm8    5  rax, imm32
    # Doing this once as a table instead of forty-eight times by
    # hand is shorter and cannot disagree with itself.
    if b < 64
        shape: b % 8
        if shape < 6
            op: b / 8
            if shape is 4
                x_rset(m, 0, 1, x_alu(m, op, x_rget(m, 0, 1), x_r8(m, p), 1))
                return x_go(m, p + 1)
            if shape is 5
                x_rset(m, 0, size, x_alu(m, op, x_rget(m, 0, size), x_imm(m, p, size), size))
                return x_go(m, p + x_immlen(size))
            w: size
            if shape % 2 is 0
                w: 1
            p: x_modrm(m, p, rex, 0)
            if shape < 2
                r: x_alu(m, op, x_rm_get(m, w), x_reg_get(m, w), w)
                if op is not 7
                    x_rm_set(m, w, r)
                return x_go(m, p)
            r: x_alu(m, op, x_reg_get(m, w), x_rm_get(m, w), w)
            if op is not 7
                x_reg_set(m, w, r)
            return x_go(m, p)

    # the group where the top bits of the second byte pick the sum
    if b is 129
        p: x_modrm(m, p, rex, x_immlen(size))
        return x_group1(m, p, size, x_imm(m, p, size), x_immlen(size))
    if b is 131
        p: x_modrm(m, p, rex, 1)
        return x_group1(m, p, size, x_i8(m, p), 1)
    if b is 128
        p: x_modrm(m, p, rex, 1)
        return x_group1(m, p, 1, x_r8(m, p), 1)

    # mov with the number written in
    if b is 199
        p: x_modrm(m, p, rex, x_immlen(size))
        x_rm_set(m, size, x_imm(m, p, size))
        return x_go(m, p + x_immlen(size))
    if b is 198
        p: x_modrm(m, p, rex, 1)
        x_rm_set(m, 1, x_r8(m, p))
        return x_go(m, p + 1)

    # the address of something, without touching it
    if b is 141
        p: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), size, x_md_rm(m))
        return x_go(m, p)

    # push a number
    if b is 104
        x_push(m, x_i32(m, p))
        return x_go(m, p + 4)
    if b is 106
        x_push(m, x_i8(m, p))
        return x_go(m, p + 1)

    # swap rax with another register
    if b >= 144
        if b <= 151
            r: b - 144 + (rex % 2) * 8
            if r is 0
                return x_go(m, p)
            t: x_reg(m, 0)
            x_setr(m, 0, x_reg(m, r))
            x_setr(m, r, t)
            return x_go(m, p)

    # spread the sign of rax across rdx, ready for a divide
    if b is 153
        if size is 8
            if x_reg(m, 0) < 0
                x_setr(m, 2, 0 - 1)
            if not
                x_setr(m, 2, 0)
            return x_go(m, p)
        if x_rget(m, 0, 4) >= X_2_31
            x_rset(m, 2, 4, X_2_32 - 1)
        if not
            x_rset(m, 2, 4, 0)
        return x_go(m, p)

    # widen four signed bytes into the whole register
    if b is 99
        p: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), 8, x_sval(x_rm_get(m, 4), 4))
        return x_go(m, p)

    # multiply with the number written in
    if b is 105
        p: x_modrm(m, p, rex, x_immlen(size))
        x_imul2(m, size, x_rm_get(m, size), x_imm(m, p, size))
        return x_go(m, p + x_immlen(size))
    if b is 107
        p: x_modrm(m, p, rex, 1)
        x_imul2(m, size, x_rm_get(m, size), x_i8(m, p))
        return x_go(m, p + 1)

    # rotate and shift
    if b is 209
        return x_group2(m, p, rex, size, 1, 0)
    if b is 208
        return x_group2(m, p, rex, 1, 1, 0)
    if b is 211
        return x_group2(m, p, rex, size, x_mask(x_reg(m, 1), 1), 0)
    if b is 210
        return x_group2(m, p, rex, 1, x_mask(x_reg(m, 1), 1), 0)
    if b is 193
        return x_group2(m, p, rex, size, 0 - 1, 1)
    if b is 192
        return x_group2(m, p, rex, 1, 0 - 1, 1)

    # the string instructions, without a repeat in front
    if x_is_string(b) is 1
        return x_string(m, b, p, size, 0)

    # test, not, negate, multiply, divide
    if b is 247
        return x_group3(m, p, rex, size)
    if b is 246
        return x_group3(m, p, rex, 1)

    # step up, step down, call, jump, push, through a register
    if b is 255
        return x_group5(m, p, rex, size)
    if b is 254
        return x_group5(m, p, rex, 1)

    # test with a number written in
    if b is 169
        x_flags_logic(m, x_and(x_rget(m, 0, size), x_imm(m, p, size)), size)
        return x_go(m, p + x_immlen(size))
    if b is 168
        x_flags_logic(m, x_and(x_rget(m, 0, 1), x_r8(m, p)), 1)
        return x_go(m, p + 1)

    # swap two registers or a register and memory
    if b is 135
        p: x_modrm(m, p, rex, 0)
        t: x_rm_get(m, size)
        x_rm_set(m, size, x_reg_get(m, size))
        x_reg_set(m, size, t)
        return x_go(m, p)
    if b is 134
        p: x_modrm(m, p, rex, 0)
        t: x_rm_get(m, 1)
        x_rm_set(m, 1, x_reg_get(m, 1))
        x_reg_set(m, 1, t)
        return x_go(m, p)

    # widen rax into itself: cbw, cwde, cdqe
    if b is 152
        if size is 8
            x_setr(m, 0, x_sval(x_rget(m, 0, 4), 4))
            return x_go(m, p)
        if size is 2
            x_rset(m, 0, 2, x_sval(x_rget(m, 0, 1), 1))
            return x_go(m, p)
        x_rset(m, 0, 4, x_sval(x_rget(m, 0, 2), 2))
        return x_go(m, p)

    # the flag instructions
    if b is 248
        poke_i64(m, 152, 0)
        return x_go(m, p)
    if b is 249
        poke_i64(m, 152, 1)
        return x_go(m, p)
    if b is 245
        poke_i64(m, 152, 1 - x_cf(m))
        return x_go(m, p)
    if b is 252
        poke_i64(m, 352, 0)
        return x_go(m, p)
    if b is 253
        poke_i64(m, 352, 1)
        return x_go(m, p)
    if b is 250
        return x_go(m, p)
    if b is 251
        return x_go(m, p)

    # push and pop the flags
    if b is 156
        x_push(m, x_flags_word(m))
        return x_go(m, p)
    if b is 157
        x_set_flags_word(m, x_pop(m))
        return x_go(m, p)

    # sahf and lahf
    if b is 158
        x_set_flags_word(m, x_b_get(m, 0, 0))
        return x_go(m, p)
    if b is 159
        x_b_set(m, 0, 0, x_add(x_flags_word(m) % 256, 2))
        return x_go(m, p)

    # return and drop some of the stack with it
    if b is 194
        n: x_r16(m, p)
        v: x_pop(m)
        x_set_sp(m, x_add(x_sp(m), n))
        if v is peek_i64(m, 320)
            poke_i64(m, 168, X_EXITED)
            return 0
        return x_go(m, v)

    # a jump if rcx has run down to nothing
    if b is 227
        d: x_i8(m, p)
        if x_reg(m, 1) is 0
            return x_go(m, x_add(p + 1, d))
        return x_go(m, p + 1)

    # loop, loope, loopne
    if b >= 224
        if b <= 226
            d: x_i8(m, p)
            c: x_sub(x_reg(m, 1), 1)
            x_setr(m, 1, c)
            go: 0
            if c is not 0
                go: 1
            if b is 225
                if x_zf(m) is 0
                    go: 0
            if b is 224
                if x_zf(m) is 1
                    go: 0
            if go is 1
                return x_go(m, x_add(p + 1, d))
            return x_go(m, p + 1)

    # a call the program will never come back from, on purpose
    if b is 204
        poke_i64(m, 168, X_FAULT)
        return 0

    # ---- the old maths unit ----
    #
    # Before there were vector registers, decimals were done on a
    # separate stack machine. A modern compiler does not use it for
    # arithmetic any more, but the C library still reads and writes
    # its control word to find out which way numbers are rounded.
    # Answering that is enough; the rest of it is not needed.
    if b >= 216
        if b <= 223
            return x_x87(m, p, rex)

    # nothing to do
    if b is 144
        return x_go(m, p)

    # halt. A program does not use this, but the instruction checker
    # puts one after the bytes it is testing so the run ends cleanly.
    if b is 244
        poke_i64(m, 168, X_EXITED)
        return 0

    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, b)
    return 0

# ---------------------------------------------------------------
# the groups, where the middle three bits of the second byte choose
# ---------------------------------------------------------------

# imul with two or three operands keeps only the low half, and sets
# the carry and overflow when the answer did not fit in it.
x_imul2 m size a b:
    if size is 8
        lo: x_mul(a, b)
        hi: x_mulhi_sg(a, b)
        c: 1
        if hi is 0
            if lo >= 0
                c: 0
        if hi is 0 - 1
            if lo < 0
                c: 0
        x_reg_set(m, 8, lo)
        x_set_zs(m, lo, 8)
        poke_i64(m, 152, c)
        poke_i64(m, 160, c)
        return lo
    r: x_sval(a, size) * x_sval(b, size)
    half: x_wide(size) / 2
    c: 1
    if r >= 0 - half
        if r < half
            c: 0
    lo: x_mask(r, size)
    x_reg_set(m, size, lo)
    x_set_zs(m, lo, size)
    poke_i64(m, 152, c)
    poke_i64(m, 160, c)
    return lo

# one of the eight sums, with the flags it leaves behind
x_alu m op a b size:
    if op is 0
        return x_flags_add(m, a, b, size)
    if op is 1
        return x_flags_logic(m, x_or(a, b), size)
    if op is 2
        return x_flags_adc(m, a, b, size, x_cf(m))
    if op is 3
        return x_flags_sbb(m, a, b, size, x_cf(m))
    if op is 4
        return x_flags_logic(m, x_and(a, b), size)
    if op is 5
        return x_flags_sub(m, a, b, size)
    if op is 6
        return x_flags_logic(m, x_xor(a, b), size)
    return x_flags_sub(m, a, b, size)

x_group1 m p size imm ilen:
    op: x_md_reg(m) % 8
    r: x_alu(m, op, x_rm_get(m, size), imm, size)
    if op is not 7
        x_rm_set(m, size, r)
    return x_go(m, p + ilen)

# The old maths unit, as far as anything still uses it. The control
# word says how to round: 0x037F is the usual setting, meaning round
# to nearest with the full width.
X_FCW: 895

# ---------------------------------------------------------------
# the old maths unit
# ---------------------------------------------------------------
#
# Before there were vector registers, decimals were done on a stack
# of eight registers. A modern compiler only reaches for it when a
# program asks for `long double`, and for reading the rounding mode,
# but both of those do happen, so it is here.
#
# The stack is a ring of eight with a pointer that counts DOWN as
# things are pushed. st(0) is the top, st(1) the one below, and so
# on. The real thing keeps eighty bits per register; this keeps
# sixty-four. That is the same arithmetic to fifty-three places
# rather than sixty-four, which is exactly what a program gets on
# any machine where `long double` and `double` are the same size,
# and is enough for everything short of deliberate precision games.

# where a numbered register sits, going round the ring
x_st_at m i:
    return (peek_i64(m, 616) + i) % 8

x_st_get m i:
    return peek_i64(peek_i64(m, 624), x_st_at(m, i) * 8)

x_st_put m i v:
    poke_i64(peek_i64(m, 624), x_st_at(m, i) * 8, v)
    poke_byte(peek_i64(m, 624) + 64, x_st_at(m, i), 1)
    return 0

# push a value on: the pointer steps back one, then the value goes
# into the new top
x_st_push m v:
    poke_i64(m, 616, (peek_i64(m, 616) + 7) % 8)
    return x_st_put(m, 0, v)

# take the top off
x_st_pop m:
    v: x_st_get(m, 0)
    poke_byte(peek_i64(m, 624) + 64, x_st_at(m, 0), 0)
    poke_i64(m, 616, (peek_i64(m, 616) + 1) % 8)
    return v

# ---- eighty bit numbers ----
#
# The old unit stores a number in ten bytes: a sign and fifteen bits
# of exponent, then sixty-four bits of fraction WITH the leading one
# written out, which the sixty-four bit kind leaves implied. These
# two turn one into the other.

x_ld_to_d m at:
    lo: x_r64(m, at)
    se: x_r16(m, at + 8)
    sign: 0
    if se >= 32768
        sign: 1
        se: se - 32768
    if se is 0
        if lo is 0
            return x_bits_of(sign, 0, 0)
    if se is 32767
        if lo is 0
            return x_bits_of(sign, 2047, 0)
        return X_QNAN
    # The exponent is counted from 16383 rather than 1023, and the
    # fraction has sixty-three places below the point rather than
    # fifty-two.
    #
    # That fraction is a full sixty-four bits, so its top bit is the
    # sign bit of an ordinary Sovren number. Everything downstream
    # expects a fraction that fits in fifty-three, so it is brought
    # down eleven places here, keeping what falls off for rounding.
    e: se - 16383 - 63
    guard: x_bit(lo, 10)
    st: 0
    if x_and(lo, 1023) is not 0
        st: 1
    f: x_shr64(lo, 11)
    return x_pack_round(sign, e + 11, f, guard, st)

x_d_to_ld m v at:
    x_unpack(m, v)
    k: x_up_kind(m)
    sg: x_up_sign(m)
    if k is X_F_ZERO
        x_w64(m, at, 0)
        x_w16(m, at + 8, x_shl64(sg, 15))
        return 0
    if k is X_F_INF
        x_w64(m, at, 0 - 9223372036854775807 - 1)
        x_w16(m, at + 8, x_or(x_shl64(sg, 15), 32767))
        return 0
    if k is X_F_NAN
        x_w64(m, at, 0 - 4611686018427387904)
        x_w16(m, at + 8, 32767)
        return 0
    e: x_up_exp(m)
    f: x_up_frac(m)
    # The fraction here has its top bit at the fifty-third place;
    # the eighty bit shape wants it at the sixty-fourth, so it moves
    # up eleven and the exponent comes down to match.
    i: 0
    as long as i < 11
        f: x_add(f, f)
        e: e - 1
        i: i + 1
    se: e + 63 + 16383
    x_w64(m, at, f)
    x_w16(m, at + 8, x_or(x_shl64(sg, 15), se))
    return 0

# ---- the status word ----
#
# Bits 8, 9, 10 and 14 say how the last comparison came out, and a
# program reads them with fnstsw to work out which way to branch.
x_st_status m:
    v: peek_i64(m, 632)
    return x_or(v, x_shl64(peek_i64(m, 616), 11))

x_st_set_cc m c:
    # c is 0 above, 1 below, 2 equal, 3 not comparable
    v: 0
    if c is 1
        v: 256
    if c is 2
        v: 16384
    if c is 3
        v: 17664
    poke_i64(m, 632, v)
    return 0

# ---- one instruction ----

x_x87 m p rex:
    b: x_r8(m, p - 1)
    nxt: x_r8(m, p)
    # The forms where the byte after the opcode is 0xC0 or more name
    # a whole instruction and a register, rather than a place in
    # memory. Those are taken apart by hand.
    if nxt >= 192
        return x_x87_reg(m, p, b, nxt)
    q: x_modrm(m, p, rex, 0)
    op: x_md_reg(m) % 8
    at: peek_i64(m, 376)

    # D9: load or store a four byte decimal, and the control word
    if b is 217
        if op is 0
            x_st_push(m, x_f2d(m, x_r32(m, at)))
            return x_go(m, q)
        if op is 2
            x_w32(m, at, x_d2f(m, x_st_get(m, 0)))
            return x_go(m, q)
        if op is 3
            x_w32(m, at, x_d2f(m, x_st_pop(m)))
            return x_go(m, q)
        if op is 4
            # load the whole state back. Nothing here keeps it, so
            # only the control word is taken.
            poke_i64(m, 608, x_r16(m, at + 4))
            return x_go(m, q)
        if op is 5
            poke_i64(m, 608, x_r16(m, at))
            return x_go(m, q)
        if op is 6
            # save the whole state: the control word, the status
            # word, and twenty more bytes nothing here uses
            i: 0
            as long as i < 28
                x_w8(m, at + i, 0)
                i: i + 1
            x_w16(m, at, peek_i64(m, 608))
            x_w16(m, at + 4, x_st_status(m))
            x_w16(m, at + 8, 65535)
            return x_go(m, q)
        if op is 7
            x_w16(m, at, peek_i64(m, 608))
            return x_go(m, q)

    # D8: arithmetic with a four byte number from memory
    if b is 216
        v: x_f2d(m, x_r32(m, at))
        return x_x87_do(m, q, op, x_st_get(m, 0), v, 0)

    # DC: the same with an eight byte one
    if b is 220
        v: x_r64(m, at)
        return x_x87_do(m, q, op, x_st_get(m, 0), v, 0)

    # DD: load or store an eight byte decimal
    if b is 221
        if op is 0
            x_st_push(m, x_r64(m, at))
            return x_go(m, q)
        if op is 2
            x_w64(m, at, x_st_get(m, 0))
            return x_go(m, q)
        if op is 3
            x_w64(m, at, x_st_pop(m))
            return x_go(m, q)
        if op is 7
            x_w16(m, at, x_st_status(m))
            return x_go(m, q)

    # DB: whole numbers four bytes wide, and the ten byte kind
    if b is 219
        if op is 0
            x_st_push(m, x_i2d(m, x_sval(x_r32(m, at), 4)))
            return x_go(m, q)
        if op is 2
            x_w32(m, at, x_mask(x_d2i(m, x_st_get(m, 0)), 4))
            return x_go(m, q)
        if op is 3
            x_w32(m, at, x_mask(x_d2i(m, x_st_pop(m)), 4))
            return x_go(m, q)
        if op is 5
            x_st_push(m, x_ld_to_d(m, at))
            return x_go(m, q)
        if op is 7
            x_d_to_ld(m, x_st_pop(m), at)
            return x_go(m, q)

    # DF: whole numbers two and eight bytes wide
    if b is 223
        if op is 0
            x_st_push(m, x_i2d(m, x_sval(x_r16(m, at), 2)))
            return x_go(m, q)
        if op is 3
            x_w16(m, at, x_mask(x_d2i(m, x_st_pop(m)), 2))
            return x_go(m, q)
        if op is 5
            x_st_push(m, x_i2d(m, x_r64(m, at)))
            return x_go(m, q)
        if op is 7
            x_w64(m, at, x_d2i(m, x_st_pop(m)))
            return x_go(m, q)

    # DA: whole numbers four bytes wide, as arithmetic
    if b is 218
        v: x_i2d(m, x_sval(x_r32(m, at), 4))
        return x_x87_do(m, q, op, x_st_get(m, 0), v, 0)

    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, b)
    return 0

# the eight sums the unit can do, by their number
x_x87_do m q op a b popit:
    r: 0
    if op is 0
        r: x_fadd(m, a, b)
    if op is 1
        r: x_fmul(m, a, b)
    if op is 2
        # compare, leaving the stack alone
        x_st_set_cc(m, x_x87_cc(m, a, b))
        return x_go(m, q)
    if op is 3
        x_st_set_cc(m, x_x87_cc(m, a, b))
        x_st_pop(m)
        return x_go(m, q)
    if op is 4
        r: x_fsub(m, a, b)
    if op is 5
        r: x_fsub(m, b, a)
    if op is 6
        r: x_fdiv(m, a, b)
    if op is 7
        r: x_fdiv(m, b, a)
    x_st_put(m, 0, r)
    if popit is 1
        x_st_pop(m)
    return x_go(m, q)

# how two numbers compare, in the shape the status word wants
x_x87_cc m a b:
    c: x_fcmp(m, a, b)
    if c is 3
        return 3
    if c is 2
        return 0
    if c is 0
        return 1
    return 2

# ---- the register to register forms ----

x_x87_reg m p b nxt:
    q: p + 1
    i: nxt % 8
    top: nxt / 8 % 8

    # D9: the odds and ends
    if b is 217
        if nxt >= 192
            if nxt <= 199
                # copy one of them to the top
                x_st_push(m, x_st_get(m, i))
                return x_go(m, q)
        if nxt >= 200
            if nxt <= 207
                # swap the top with another
                t: x_st_get(m, 0)
                x_st_put(m, 0, x_st_get(m, i))
                x_st_put(m, i, t)
                return x_go(m, q)
        if nxt is 224
            # change the sign
            x_st_put(m, 0, x_fneg(x_st_get(m, 0)))
            return x_go(m, q)
        if nxt is 225
            # drop the sign
            x_st_put(m, 0, x_and(x_st_get(m, 0), 9223372036854775807))
            return x_go(m, q)
        if nxt is 228
            # what kind of number is on top
            x_unpack(m, x_st_get(m, 0))
            k: x_up_kind(m)
            c: 0
            if k is X_F_ZERO
                c: 2
            if k is X_F_NAN
                c: 3
            if k is X_F_INF
                c: 1
            x_st_set_cc(m, c)
            return x_go(m, q)
        if nxt is 232
            x_st_push(m, 4607182418800017408)
            return x_go(m, q)
        if nxt is 238
            x_st_push(m, 0)
            return x_go(m, q)
        if nxt is 233
            # the logarithm of ten to base two
            x_st_push(m, 4614022425160083056)
            return x_go(m, q)
        if nxt is 234
            x_st_push(m, 4599094494223104511)
            return x_go(m, q)
        if nxt is 235
            # the circle constant
            x_st_push(m, 4614256656552045848)
            return x_go(m, q)
        if nxt is 236
            x_st_push(m, 4599094494223104511)
            return x_go(m, q)
        if nxt is 237
            x_st_push(m, 4604418534313441775)
            return x_go(m, q)
        if nxt is 250
            x_st_put(m, 0, x_fsqrt(m, x_st_get(m, 0)))
            return x_go(m, q)

    # D8 and DC: arithmetic between two registers
    if b is 216
        return x_x87_do(m, q, top, x_st_get(m, 0), x_st_get(m, i), 0)
    if b is 220
        # the answer goes into the other one, not the top
        r: x_x87_pair(m, top, x_st_get(m, i), x_st_get(m, 0))
        x_st_put(m, i, r)
        return x_go(m, q)
    if b is 222
        # the same, and then the top comes off
        if nxt is 217
            # multiply the two and pop
            r: x_fmul(m, x_st_get(m, 1), x_st_get(m, 0))
            x_st_pop(m)
            x_st_put(m, 0, r)
            return x_go(m, q)
        r: x_x87_pair(m, top, x_st_get(m, i), x_st_get(m, 0))
        x_st_put(m, i, r)
        x_st_pop(m)
        return x_go(m, q)

    # DD: move and drop
    if b is 221
        if nxt >= 192
            if nxt <= 199
                x_st_put(m, i, x_st_get(m, 0))
                return x_go(m, q)
        if nxt >= 208
            if nxt <= 215
                x_st_put(m, i, x_st_get(m, 0))
                return x_go(m, q)
        if nxt >= 216
            if nxt <= 223
                x_st_put(m, i, x_st_get(m, 0))
                x_st_pop(m)
                return x_go(m, q)

    # DB and DF: compare and put the answer in the ordinary flags
    if b is 219
        if nxt is 227
            poke_i64(m, 608, X_FCW)
            poke_i64(m, 616, 0)
            poke_i64(m, 632, 0)
            return x_go(m, q)
        if nxt >= 232
            if nxt <= 247
                x_x87_flags(m, x_st_get(m, 0), x_st_get(m, i))
                return x_go(m, q)
    if b is 223
        if nxt is 224
            # the status word into ax
            x_rset(m, 0, 2, x_st_status(m))
            return x_go(m, q)
        if nxt >= 232
            if nxt <= 247
                x_x87_flags(m, x_st_get(m, 0), x_st_get(m, i))
                x_st_pop(m)
                return x_go(m, q)

    # DE: the pair forms that pop
    if b is 218
        if nxt >= 232
            if nxt <= 239
                x_x87_flags(m, x_st_get(m, 0), x_st_get(m, i))
                return x_go(m, q)

    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, 61440 + b)
    return 0

# one sum between two registers, without touching the stack
x_x87_pair m op a b:
    if op is 0
        return x_fadd(m, a, b)
    if op is 1
        return x_fmul(m, a, b)
    if op is 4
        return x_fsub(m, a, b)
    if op is 5
        return x_fsub(m, b, a)
    if op is 6
        return x_fdiv(m, a, b)
    if op is 7
        return x_fdiv(m, b, a)
    return a

# compare and set the ORDINARY flags, which is what the newer
# instructions do so a program can branch straight away
x_x87_flags m a b:
    c: x_fcmp(m, a, b)
    poke_i64(m, 160, 0)
    poke_i64(m, 344, 0)
    if c is 3
        poke_i64(m, 136, 1)
        poke_i64(m, 328, 1)
        poke_i64(m, 152, 1)
        return 0
    poke_i64(m, 328, 0)
    if c is 1
        poke_i64(m, 136, 1)
        poke_i64(m, 152, 0)
        return 0
    if c is 0
        poke_i64(m, 136, 0)
        poke_i64(m, 152, 1)
        return 0
    poke_i64(m, 136, 0)
    poke_i64(m, 152, 0)
    return 0

# ---- the shifts and rotates ----
#
# The count is masked to six bits at sixty-four wide and five bits
# otherwise, and a count of nothing changes no flags at all. When
# `imm` is 1 the count byte follows the address bytes.
x_group2 m p rex size cnt imm:
    q: x_modrm(m, p, rex, imm)
    op: x_md_reg(m) % 8
    n: cnt
    if imm is 1
        n: x_r8(m, q)
        q: q + 1
    w: x_bits(size)
    if w is 64
        n: n % 64
    if not
        n: n % 32
    if n is 0
        # no bits move and no flag changes, but a thirty-two bit
        # instruction still clears the top half of the register
        if size is 4
            x_rm_set(m, 4, x_rm_get(m, 4))
        return x_go(m, q)
    v: x_rm_get(m, size)
    r: v
    cf: x_cf(m)
    if op is 4
        r: x_shl(v, n, size)
        cf: x_bit(x_mask(v, size), w - n)
    if op is 6
        r: x_shl(v, n, size)
        cf: x_bit(x_mask(v, size), w - n)
    if op is 5
        r: x_shr(v, n, size)
        cf: x_bit(x_mask(v, size), n - 1)
    if op is 7
        r: x_sar(v, n, size)
        cf: x_bit(x_mask(v, size), n - 1)
    if op is 0
        k: n % w
        if k is 0
            r: x_mask(v, size)
        if not
            r: x_or(x_shl(v, k, size), x_shr(v, w - k, size))
        cf: x_bit(r, 0)
    if op is 1
        k: n % w
        if k is 0
            r: x_mask(v, size)
        if not
            r: x_or(x_shr(v, k, size), x_shl(v, w - k, size))
        cf: x_bit(x_mask(r, size), w - 1)
    if op is 2
        r: x_rcl(m, v, n, size, w)
        cf: peek_i64(m, 456)
    if op is 3
        r: x_rcr(m, v, n, size, w)
        cf: peek_i64(m, 456)
    r: x_mask(r, size)
    if op < 2
        # a rotate leaves the zero and sign flags alone
        x_rm_set(m, size, r)
        poke_i64(m, 152, cf)
        of: 0
        if n is 1
            if op is 0
                if x_bit(r, w - 1) is not cf
                    of: 1
            if op is 1
                if x_bit(r, w - 1) is not x_bit(r, w - 2)
                    of: 1
        poke_i64(m, 160, of)
        return x_go(m, q)
    if op is 2
        x_rm_set(m, size, r)
        poke_i64(m, 152, cf)
        return x_go(m, q)
    if op is 3
        x_rm_set(m, size, r)
        poke_i64(m, 152, cf)
        return x_go(m, q)
    x_rm_set(m, size, r)
    x_set_zs(m, r, size)
    poke_i64(m, 152, cf)
    of: 0
    if n is 1
        if op is 4
            if x_bit(r, w - 1) is not cf
                of: 1
        if op is 6
            if x_bit(r, w - 1) is not cf
                of: 1
        if op is 5
            of: x_bit(x_mask(v, size), w - 1)
        if op is 7
            of: 0
    poke_i64(m, 160, of)
    return x_go(m, q)

# rotate through the carry: one bit at a time, because the carry
# joins the ring and makes it one bit wider than the value
x_rcl m v n size w:
    r: x_mask(v, size)
    c: x_cf(m)
    i: 0
    as long as i < n % (w + 1)
        top: x_bit(r, w - 1)
        r: x_mask(x_add(x_shl(r, 1, size), c), size)
        c: top
        i: i + 1
    poke_i64(m, 456, c)
    return r

x_rcr m v n size w:
    r: x_mask(v, size)
    c: x_cf(m)
    i: 0
    as long as i < n % (w + 1)
        bot: r % 2
        r: x_or(x_shr(r, 1, size), x_shl(c, w - 1, size))
        c: bot
        i: i + 1
    poke_i64(m, 456, c)
    return r

# ---- the flags, as the one word push and pop use ----
x_flags_word m:
    v: 2
    if x_cf(m) is 1
        v: v + 1
    if x_pf(m) is 1
        v: v + 4
    if x_af(m) is 1
        v: v + 16
    if x_zf(m) is 1
        v: v + 64
    if x_sf(m) is 1
        v: v + 128
    if x_df(m) is 1
        v: v + 1024
    if x_of(m) is 1
        v: v + 2048
    return v

x_set_flags_word m v:
    poke_i64(m, 152, v % 2)
    poke_i64(m, 328, (v / 4) % 2)
    poke_i64(m, 344, (v / 16) % 2)
    poke_i64(m, 136, (v / 64) % 2)
    poke_i64(m, 144, (v / 128) % 2)
    poke_i64(m, 352, (v / 1024) % 2)
    poke_i64(m, 160, (v / 2048) % 2)
    return 0

# ---- the string instructions ----
#
# movs stos lods scas cmps, each stepping rsi and rdi forward or
# back depending on the direction flag, optionally repeating until
# rcx runs out. This is how real code copies memory.

x_is_string b:
    if b >= 164
        if b <= 175
            if b is not 168
                if b is not 169
                    return 1
    return 0

x_string m b p size rep:
    w: size
    if b % 2 is 0
        w: 1
    step: w
    if x_df(m) is 1
        step: 0 - w
    n: 1
    if rep is not 0
        n: x_reg(m, 1)
        if n is 0
            return x_go(m, p)
    done: 0
    stop: 0
    as long as done < n
        si: x_reg(m, 6)
        di: x_reg(m, 7)
        if b is 164
            x_store(m, di, w, x_load(m, si, w))
            x_setr(m, 6, x_add(si, step))
            x_setr(m, 7, x_add(di, step))
        if b is 165
            x_store(m, di, w, x_load(m, si, w))
            x_setr(m, 6, x_add(si, step))
            x_setr(m, 7, x_add(di, step))
        if b is 170
            x_store(m, di, w, x_rget(m, 0, w))
            x_setr(m, 7, x_add(di, step))
        if b is 171
            x_store(m, di, w, x_rget(m, 0, w))
            x_setr(m, 7, x_add(di, step))
        if b is 172
            x_rset(m, 0, w, x_load(m, si, w))
            x_setr(m, 6, x_add(si, step))
        if b is 173
            x_rset(m, 0, w, x_load(m, si, w))
            x_setr(m, 6, x_add(si, step))
        if b is 174
            x_flags_sub(m, x_rget(m, 0, w), x_load(m, di, w), w)
            x_setr(m, 7, x_add(di, step))
        if b is 175
            x_flags_sub(m, x_rget(m, 0, w), x_load(m, di, w), w)
            x_setr(m, 7, x_add(di, step))
        if b is 166
            x_flags_sub(m, x_load(m, si, w), x_load(m, di, w), w)
            x_setr(m, 6, x_add(si, step))
            x_setr(m, 7, x_add(di, step))
        if b is 167
            x_flags_sub(m, x_load(m, si, w), x_load(m, di, w), w)
            x_setr(m, 6, x_add(si, step))
            x_setr(m, 7, x_add(di, step))
        done: done + 1
        if rep is not 0
            x_setr(m, 1, x_sub(n, done))
            # the two that compare stop early on the flag
            if b >= 166
                if x_test_rep(m, b, rep) is 1
                    done: n
        if peek_i64(m, 168) is not X_RUNNING
            done: n
            stop: 1
    if stop is 1
        return 0
    return x_go(m, p)

# repe stops when the compare fails, repne when it succeeds
x_test_rep m b rep:
    if b is 168
        return 0
    if b is 169
        return 0
    if b < 166
        return 0
    if b is 170
        return 0
    if b is 171
        return 0
    if b is 172
        return 0
    if b is 173
        return 0
    if rep is 1
        if x_zf(m) is 0
            return 1
        return 0
    if x_zf(m) is 1
        return 1
    return 0

x_group3 m p rex size:
    q: x_modrm(m, p, rex, 0)
    op: x_md_reg(m) % 8
    if op is 0
        imm: 0
        if size is 1
            imm: x_r8(m, q)
            q: q + 1
        if not
            imm: x_imm(m, q, size)
            q: q + x_immlen(size)
        x_flags_logic(m, x_and(x_rm_get(m, size), imm), size)
        return x_go(m, q)
    if op is 1
        imm: 0
        if size is 1
            imm: x_r8(m, q)
            q: q + 1
        if not
            imm: x_imm(m, q, size)
            q: q + x_immlen(size)
        x_flags_logic(m, x_and(x_rm_get(m, size), imm), size)
        return x_go(m, q)
    if op is 2
        x_rm_set(m, size, x_not(x_rm_get(m, size)))
        return x_go(m, q)
    if op is 3
        v: x_rm_get(m, size)
        x_rm_set(m, size, x_flags_sub(m, 0, v, size))
        # negate sets the carry unless the value was nothing
        c: 1
        if x_mask(v, size) is 0
            c: 0
        poke_i64(m, 152, c)
        return x_go(m, q)
    if op is 4
        return x_mul_un(m, q, size)
    if op is 5
        return x_mul_sg(m, q, size)
    if op is 6
        return x_div_un(m, q, size)
    if op is 7
        return x_div_sg(m, q, size)
    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, 247)
    return 0

# ---------------------------------------------------------------
# multiply and divide, the full width
# ---------------------------------------------------------------
#
# On this processor a multiply of two n-bit numbers makes a 2n-bit
# answer, the top half in rdx and the bottom in rax, and a divide
# takes a 2n-bit number from that same pair. Below sixty-four bits
# both halves fit in one Sovren number and it is easy. At sixty-four
# the pair is a hundred and twenty-eight bits wide, so the work is
# done in thirty-two bit pieces, the way long multiplication is done
# on paper.

# The top half of an unsigned sixty-four by sixty-four multiply.
#
# Long multiplication in thirty-two bit digits. Every partial
# product is at most (2^32-1)^2, which fits, and every running sum
# is kept under 2^63 by carrying immediately, so nothing overflows.
#
#   a = ah:al   b = bh:bl
#   a*b = ah*bh<<64 + (ah*bl + al*bh)<<32 + al*bl
#
# The answer wanted is everything from bit 64 up.
# The top half of an unsigned sixty-four by sixty-four multiply.
#
# In SIXTEEN bit digits, not thirty-two. Two thirty-two bit digits
# multiplied together reach almost 2^64, which is past what one
# Sovren number holds; two sixteen bit digits reach only 2^32, and
# a column of them with carries stays well under 2^63. This is the
# same long multiplication anyone does on paper, in base 65536.
X_16: 65536

x_mulhi_un a b:
    # a as four digits, lowest first
    a0: x_lo(a) % X_16
    a1: x_lo(a) / X_16
    a2: x_hiu(a) % X_16
    a3: x_hiu(a) / X_16
    b0: x_lo(b) % X_16
    b1: x_lo(b) / X_16
    b2: x_hiu(b) % X_16
    b3: x_hiu(b) / X_16
    # columns 0 to 6. Column k holds every product ai*bj with i+j=k.
    # The largest column has four products of at most (2^16-1)^2,
    # plus a carry, which is nowhere near the limit.
    c: a0 * b0
    c: c / X_16 + a0 * b1 + a1 * b0
    c: c / X_16 + a0 * b2 + a1 * b1 + a2 * b0
    c: c / X_16 + a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0
    # everything above is the bottom half and is thrown away.
    # column four is the first digit of the answer.
    c: c / X_16 + a1 * b3 + a2 * b2 + a3 * b1
    d4: c % X_16
    c: c / X_16 + a2 * b3 + a3 * b2
    d5: c % X_16
    c: c / X_16 + a3 * b3
    d6: c % X_16
    d7: c / X_16
    return x_make(d6 + d7 * X_16, d4 + d5 * X_16)

x_mul_un m q size:
    a: x_rget(m, 0, size)
    b: x_rm_get(m, size)
    if size is 8
        lo: x_mul(a, b)
        hi: x_mulhi_un(a, b)
        x_setr(m, 0, lo)
        x_setr(m, 2, hi)
        c: 0
        if hi is not 0
            c: 1
        poke_i64(m, 152, c)
        poke_i64(m, 160, c)
        return x_go(m, q)
    if size is 1
        r: a * b
        x_rset(m, 0, 2, r)
        c: 0
        if r > 255
            c: 1
        poke_i64(m, 152, c)
        poke_i64(m, 160, c)
        return x_go(m, q)
    r: a * b
    w: x_wide(size)
    lo: x_umod(r, w)
    hi: x_udiv(r, w)
    x_rset(m, 0, size, lo)
    x_rset(m, 2, size, hi)
    c: 0
    if hi is not 0
        c: 1
    poke_i64(m, 152, c)
    poke_i64(m, 160, c)
    return x_go(m, q)

# the top half of a signed multiply, worked out from the unsigned one
x_mulhi_sg a b:
    h: x_mulhi_un(a, b)
    if a < 0
        h: x_sub(h, b)
    if b < 0
        h: x_sub(h, a)
    return h

x_mul_sg m q size:
    if size is 8
        a: x_reg(m, 0)
        b: x_rm_get(m, 8)
        lo: x_mul(a, b)
        hi: x_mulhi_sg(a, b)
        x_setr(m, 0, lo)
        x_setr(m, 2, hi)
        # the carry says the top half was not just the sign
        c: 1
        if hi is 0
            if lo >= 0
                c: 0
        if hi is 0 - 1
            if lo < 0
                c: 0
        poke_i64(m, 152, c)
        poke_i64(m, 160, c)
        return x_go(m, q)
    a: x_sval(x_rget(m, 0, size), size)
    b: x_sval(x_rm_get(m, size), size)
    r: a * b
    if size is 1
        x_rset(m, 0, 2, x_mask(r, 2))
        c: 1
        if r >= 0 - 128
            if r <= 127
                c: 0
        poke_i64(m, 152, c)
        poke_i64(m, 160, c)
        return x_go(m, q)
    w: x_wide(size)
    x_rset(m, 0, size, x_mask(r, size))
    x_rset(m, 2, size, x_mask(x_sar64(r, x_bits(size)), size))
    c: 1
    half: w / 2
    if r >= 0 - half
        if r < half
            c: 0
    poke_i64(m, 152, c)
    poke_i64(m, 160, c)
    return x_go(m, q)

# a hundred and twenty-eight bit number divided by a sixty-four bit
# one, done the way long division is done by hand: one bit at a
# time, from the top. Slow, but it is only reached for the widest
# case, and it is right.
x_div128 m hi lo d:
    if x_ult(hi, d) is 0
        # the answer would not fit in sixty-four bits. Real hardware
        # raises a fault rather than giving a wrong number.
        poke_i64(m, 472, 1)
        return 0
    poke_i64(m, 472, 0)
    # The top half is already known to be smaller than the divisor,
    # so it is the running remainder to begin with. Then shift the
    # low half in, one bit at a time, from the top.
    r: hi
    q: 0
    i: 63
    as long as i >= 0
        # the remainder is below d, so doubling it cannot lose the
        # top bit unless d itself is above half, which is handled by
        # testing that top bit before the shift
        topbit: x_bit(r, 63)
        r: x_shl64(r, 1)
        r: x_or(r, x_bit(lo, i))
        if topbit is 1
            # the doubled remainder needs a sixty-fifth bit, so it
            # is certainly at least d
            r: x_sub(r, d)
            q: x_or(q, x_shl64(1, i))
        if not
            if x_ult(r, d) is 0
                r: x_sub(r, d)
                q: x_or(q, x_shl64(1, i))
        i: i - 1
    poke_i64(m, 480, r)
    return q

x_div_un m q size:
    d: x_rm_get(m, size)
    if x_mask(d, size) is 0
        poke_i64(m, 168, X_FAULT)
        return 0
    if size is 8
        hi: x_reg(m, 2)
        lo: x_reg(m, 0)
        if hi is 0
            x_setr(m, 0, x_udiv(lo, d))
            x_setr(m, 2, x_umod(lo, d))
            return x_go(m, q)
        quo: x_div128(m, hi, lo, d)
        if peek_i64(m, 472) is 1
            poke_i64(m, 168, X_FAULT)
            return 0
        x_setr(m, 0, quo)
        x_setr(m, 2, peek_i64(m, 480))
        return x_go(m, q)
    if size is 1
        n: x_rget(m, 0, 2)
        dd: x_mask(d, 1)
        if n / dd > 255
            poke_i64(m, 168, X_FAULT)
            return 0
        x_b_set(m, 0, 1, n / dd)
        x_b_set(m, 4, 0, n % dd)
        return x_go(m, q)
    w: x_wide(size)
    n: x_rget(m, 2, size) * w + x_rget(m, 0, size)
    dd: x_mask(d, size)
    quo: x_udiv(n, dd)
    if x_ult(quo, w) is 0
        poke_i64(m, 168, X_FAULT)
        return 0
    x_rset(m, 0, size, quo)
    x_rset(m, 2, size, x_umod(n, dd))
    return x_go(m, q)

x_div_sg m q size:
    d: x_sval(x_rm_get(m, size), size)
    if d is 0
        poke_i64(m, 168, X_FAULT)
        return 0
    if size is 8
        hi: x_reg(m, 2)
        lo: x_reg(m, 0)
        # when the top half is only the sign, one number is enough
        ok: 0
        if hi is 0
            if lo >= 0
                ok: 1
        if hi is 0 - 1
            if lo < 0
                ok: 1
        if ok is 1
            if lo is 0 - 9223372036854775807 - 1
                if d is 0 - 1
                    poke_i64(m, 168, X_FAULT)
                    return 0
            x_setr(m, 0, lo / d)
            x_setr(m, 2, lo % d)
            return x_go(m, q)
        # otherwise take the signs off, divide, and put them back
        neg: 0
        nh: hi
        nl: lo
        if hi < 0
            neg: 1
            nl: x_sub(0, lo)
            nh: x_sub(x_not(hi), 0)
            if lo is 0
                nh: x_add(nh, 1)
        dd: d
        if d < 0
            dd: 0 - d
            if neg is 1
                neg: 0
            if not
                neg: 1
        quo: x_div128(m, nh, nl, dd)
        if peek_i64(m, 472) is 1
            poke_i64(m, 168, X_FAULT)
            return 0
        rem: peek_i64(m, 480)
        if neg is 1
            quo: x_sub(0, quo)
        if hi < 0
            rem: x_sub(0, rem)
        x_setr(m, 0, quo)
        x_setr(m, 2, rem)
        return x_go(m, q)
    if size is 1
        n: x_sval(x_rget(m, 0, 2), 2)
        r: n / d
        if r > 127
            poke_i64(m, 168, X_FAULT)
            return 0
        if r < 0 - 128
            poke_i64(m, 168, X_FAULT)
            return 0
        x_b_set(m, 0, 1, x_mask(r, 1))
        x_b_set(m, 4, 0, x_mask(n % d, 1))
        return x_go(m, q)
    w: x_wide(size)
    n: x_sval(x_rget(m, 2, size), size) * w + x_rget(m, 0, size)
    r: n / d
    half: w / 2
    if r >= half
        poke_i64(m, 168, X_FAULT)
        return 0
    if r < 0 - half
        poke_i64(m, 168, X_FAULT)
        return 0
    x_rset(m, 0, size, x_mask(r, size))
    x_rset(m, 2, size, x_mask(n % d, size))
    return x_go(m, q)

x_group5 m p rex size:
    q: x_modrm(m, p, rex, 0)
    op: x_md_reg(m) % 8
    if op is 0
        v: x_rm_get(m, size)
        c: x_cf(m)
        x_rm_set(m, size, x_flags_add(m, v, 1, size))
        poke_i64(m, 152, c)
        return x_go(m, q)
    if op is 1
        v: x_rm_get(m, size)
        c: x_cf(m)
        x_rm_set(m, size, x_flags_sub(m, v, 1, size))
        poke_i64(m, 152, c)
        return x_go(m, q)
    if op is 2
        t: x_rm_get(m, 8)
        x_push(m, q)
        return x_go(m, t)
    if op is 4
        return x_go(m, x_rm_get(m, 8))
    if op is 6
        x_push(m, x_rm_get(m, 8))
        return x_go(m, q)
    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, 255)
    return 0

# ---------------------------------------------------------------
# the two byte opcodes
# ---------------------------------------------------------------

x_two m p rex size:
    b: x_r8(m, p)
    p: p + 1

    # a long jump on a condition
    if b >= 128
        if b <= 143
            d: x_i32(m, p)
            if x_cond(m, b - 128) is 1
                return x_go(m, x_add(p + 4, d))
            return x_go(m, p + 4)

    # set a byte to one or zero on a condition
    if b >= 144
        if b <= 159
            p: x_modrm(m, p, rex, 0)
            x_rm_set(m, 1, x_cond(m, b - 144))
            return x_go(m, p)

    # widen a byte or a half, with and without a sign
    if b is 182
        p: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), size, x_rm_get(m, 1))
        return x_go(m, p)
    if b is 183
        p: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), size, x_rm_get(m, 2))
        return x_go(m, p)
    if b is 190
        p: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), size, x_sval(x_rm_get(m, 1), 1))
        return x_go(m, p)
    if b is 191
        p: x_modrm(m, p, rex, 0)
        x_rset(m, x_md_reg(m), size, x_sval(x_rm_get(m, 2), 2))
        return x_go(m, p)

    # multiply, two operands
    if b is 175
        p: x_modrm(m, p, rex, 0)
        x_imul2(m, size, x_reg_get(m, size), x_rm_get(m, size))
        return x_go(m, p)

    # move on a condition. When the condition fails the value is
    # left alone, except that a thirty-two bit one still clears the
    # top half of the register, which the hardware always does.
    if b >= 64
        if b <= 79
            p: x_modrm(m, p, rex, 0)
            if x_cond(m, b - 64) is 1
                x_rset(m, x_md_reg(m), size, x_rm_get(m, size))
            if not
                if size is 4
                    x_rset(m, x_md_reg(m), 4, x_rget(m, x_md_reg(m), 4))
            return x_go(m, p)

    # ---- the bit instructions ----
    # bt tests one bit, bts sets it, btr clears it, btc flips it.
    # When the value is in memory the bit number can run past the
    # end of one word and pick a later one, which is why the address
    # is adjusted rather than the number masked.
    if b is 163
        return x_bitop(m, p, rex, size, 0)
    if b is 171
        return x_bitop(m, p, rex, size, 1)
    if b is 179
        return x_bitop(m, p, rex, size, 2)
    if b is 187
        return x_bitop(m, p, rex, size, 3)
    if b is 186
        q: x_modrm(m, p, rex, 1)
        op: x_md_reg(m) % 8
        n: x_r8(m, q) % x_bits(size)
        v: x_rm_get(m, size)
        poke_i64(m, 152, x_bit(x_mask(v, size), n))
        if op is 5
            x_rm_set(m, size, x_or(v, x_shl(1, n, size)))
        if op is 6
            x_rm_set(m, size, x_and(v, x_not(x_shl(1, n, size))))
        if op is 7
            x_rm_set(m, size, x_xor(v, x_shl(1, n, size)))
        return x_go(m, q + 1)

    # find the lowest or the highest one bit
    if b is 188
        # F3 in front turns bsf into tzcnt, which counts the low
        # zero bits and says so with the carry flag when there are
        # none. Without the prefix it is the old bsf.
        if peek_i64(m, 416) is 1
            p: x_modrm(m, p, rex, 0)
            v: x_mask(x_rm_get(m, size), size)
            r: x_bits(size)
            cf: 1
            if v is not 0
                cf: 0
                i: 0
                as long as x_bit(v, i) is 0
                    i: i + 1
                r: i
            x_reg_set(m, size, r)
            poke_i64(m, 152, cf)
            z: 0
            if r is 0
                z: 1
            poke_i64(m, 136, z)
            poke_i64(m, 144, 0)
            poke_i64(m, 160, 0)
            poke_i64(m, 328, 0)
            poke_i64(m, 344, 0)
            return x_go(m, p)
        p: x_modrm(m, p, rex, 0)
        v: x_mask(x_rm_get(m, size), size)
        if v is 0
            poke_i64(m, 136, 1)
            return x_go(m, p)
        poke_i64(m, 136, 0)
        i: 0
        as long as x_bit(v, i) is 0
            i: i + 1
        x_reg_set(m, size, i)
        return x_go(m, p)
    if b is 189
        # F3 in front turns bsr into lzcnt, which counts the high
        # zero bits. Without the prefix it is the old bsr.
        if peek_i64(m, 416) is 1
            p: x_modrm(m, p, rex, 0)
            v: x_mask(x_rm_get(m, size), size)
            r: x_bits(size)
            cf: 1
            if v is not 0
                cf: 0
                r: x_bits(size) - 1
                i: x_bits(size) - 1
                as long as x_bit(v, i) is 0
                    i: i - 1
                r: x_bits(size) - 1 - i
            x_reg_set(m, size, r)
            poke_i64(m, 152, cf)
            z: 0
            if r is 0
                z: 1
            poke_i64(m, 136, z)
            poke_i64(m, 144, 0)
            poke_i64(m, 160, 0)
            poke_i64(m, 328, 0)
            poke_i64(m, 344, 0)
            return x_go(m, p)
        p: x_modrm(m, p, rex, 0)
        v: x_mask(x_rm_get(m, size), size)
        if v is 0
            poke_i64(m, 136, 1)
            return x_go(m, p)
        poke_i64(m, 136, 0)
        i: x_bits(size) - 1
        as long as x_bit(v, i) is 0
            i: i - 1
        x_reg_set(m, size, i)
        return x_go(m, p)

    # count the low zero bits, and count the one bits
    if b is 188 + 0
        return x_go(m, p)
    if b is 184
        # popcnt: F3 0F B8. Without the prefix the byte is not an
        # instruction at all.
        if peek_i64(m, 416) is not 1
            poke_i64(m, 168, X_BADOP)
            poke_i64(m, 232, 184)
            return 0
        p: x_modrm(m, p, rex, 0)
        v: x_mask(x_rm_get(m, size), size)
        n: 0
        i: 0
        as long as i < x_bits(size)
            if x_bit(v, i) is 1
                n: n + 1
            i: i + 1
        x_reg_set(m, size, n)
        x_set_zs(m, n, size)
        poke_i64(m, 152, 0)
        poke_i64(m, 160, 0)
        return x_go(m, p)

    # turn the bytes of a register back to front
    if b >= 200
        if b <= 207
            r: b - 200 + (rex % 2) * 8
            v: x_reg(m, r)
            if size is 8
                o: 0
                i: 0
                as long as i < 8
                    o: x_or(x_shl64(o, 8), x_mask(x_shr64(v, i * 8), 1))
                    i: i + 1
                x_setr(m, r, o)
                return x_go(m, p)
            o: 0
            i: 0
            as long as i < 4
                o: x_or(x_shl64(o, 8), x_mask(x_shr64(v, i * 8), 1))
                i: i + 1
            x_rset(m, r, 4, o)
            return x_go(m, p)

    # swap and add, the two instructions locks are usually for
    if b is 193
        p: x_modrm(m, p, rex, 0)
        a: x_rm_get(m, size)
        bb: x_reg_get(m, size)
        x_reg_set(m, size, a)
        x_rm_set(m, size, x_flags_add(m, a, bb, size))
        return x_go(m, p)
    if b is 192
        p: x_modrm(m, p, rex, 0)
        a: x_rm_get(m, 1)
        bb: x_reg_get(m, 1)
        x_reg_set(m, 1, a)
        x_rm_set(m, 1, x_flags_add(m, a, bb, 1))
        return x_go(m, p)

    # compare and swap: the heart of every lock
    if b is 177
        return x_cmpxchg(m, p, rex, size)
    if b is 176
        return x_cmpxchg(m, p, rex, 1)

    # shift one value into another
    if b is 164
        q: x_modrm(m, p, rex, 1)
        n: x_r8(m, q) % x_bits(size)
        return x_shiftd(m, q + 1, size, n, 1)
    if b is 165
        q: x_modrm(m, p, rex, 0)
        n: x_mask(x_reg(m, 1), 1) % x_bits(size)
        return x_shiftd(m, q, size, n, 1)
    if b is 172
        q: x_modrm(m, p, rex, 1)
        n: x_r8(m, q) % x_bits(size)
        return x_shiftd(m, q + 1, size, n, 0)
    if b is 173
        q: x_modrm(m, p, rex, 0)
        n: x_mask(x_reg(m, 1), 1) % x_bits(size)
        return x_shiftd(m, q, size, n, 0)

    # ---- the vector instructions ----
    # These all live in the two-byte space and are told apart by the
    # 66 / F3 / F2 prefix in front of them.
    if x_is_vec(b) is 1
        return x_vec(m, b, p, rex, size)

    # ask the system for something
    if b is 5
        return x_syscall(m, p)

    # nothing to do, in several spellings
    if b is 31
        p: x_modrm(m, p, rex, 0)
        return x_go(m, p)
    if b is 11
        poke_i64(m, 168, X_BADOP)
        poke_i64(m, 232, 3851)
        return 0
    if b is 14
        return x_go(m, p)
    if b is 24
        p: x_modrm(m, p, rex, 0)
        return x_go(m, p)
    if b >= 25
        if b <= 30
            p: x_modrm(m, p, rex, 0)
            return x_go(m, p)
    if b is 174
        # the fence instructions, and endbr64 lives near here too
        p: x_modrm(m, p, rex, 0)
        return x_go(m, p)
    if b is 1
        p: x_modrm(m, p, rex, 0)
        return x_go(m, p)
    if b is 168 + 0
        return x_go(m, p)
    if b is 49
        # read the timer. Programs seed randomness with it.
        x_rset(m, 0, 4, peek_i64(m, 464) % X_2_32)
        x_rset(m, 2, 4, 0)
        poke_i64(m, 464, peek_i64(m, 464) + 1000)
        return x_go(m, p)
    if b is 162
        # what kind of processor this is. Say almost nothing, so a
        # program takes the plainest path it has.
        x_setr(m, 0, 0)
        x_setr(m, 3, 0)
        x_setr(m, 1, 0)
        x_setr(m, 2, 0)
        return x_go(m, p)

    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, 3840 + b)
    return 0

# ---- one bit, tested and maybe changed ----
x_bitop m p rex size op:
    q: x_modrm(m, p, rex, 0)
    n: x_sval(x_reg_get(m, size), size)
    w: x_bits(size)
    if peek_i64(m, 360) is 1
        n: n % w
        if n < 0
            n: n + w
    if not
        # a bit number past the end picks a later word
        off: n / w
        if n < 0
            off: (n - w + 1) / w
        poke_i64(m, 376, x_add(peek_i64(m, 376), off * size))
        n: n - off * w
    v: x_rm_get(m, size)
    poke_i64(m, 152, x_bit(x_mask(v, size), n))
    if op is 1
        x_rm_set(m, size, x_or(v, x_shl(1, n, size)))
    if op is 2
        x_rm_set(m, size, x_and(v, x_not(x_shl(1, n, size))))
    if op is 3
        x_rm_set(m, size, x_xor(v, x_shl(1, n, size)))
    return x_go(m, q)

# ---- compare and swap ----
x_cmpxchg m p rex size:
    q: x_modrm(m, p, rex, 0)
    d: x_rm_get(m, size)
    a: x_rget(m, 0, size)
    x_flags_sub(m, a, d, size)
    if x_mask(a, size) is x_mask(d, size)
        poke_i64(m, 136, 1)
        x_rm_set(m, size, x_reg_get(m, size))
    if not
        poke_i64(m, 136, 0)
        x_rset(m, 0, size, d)
    return x_go(m, q)

# ---- shift one value into another ----
x_shiftd m q size n left:
    if n is 0
        return x_go(m, q)
    w: x_bits(size)
    v: x_mask(x_rm_get(m, size), size)
    o: x_mask(x_reg_get(m, size), size)
    if left is 1
        r: x_or(x_shl(v, n, size), x_shr(o, w - n, size))
        cf: x_bit(v, w - n)
    if not
        r: x_or(x_shr(v, n, size), x_shl(o, w - n, size))
        cf: x_bit(v, n - 1)
    r: x_mask(r, size)
    x_rm_set(m, size, r)
    x_set_zs(m, r, size)
    poke_i64(m, 152, cf)
    return x_go(m, q)

# which two-byte opcodes are vector ones
x_is_vec b:
    if b is 16
        return 1
    if b is 17
        return 1
    if b is 40
        return 1
    if b is 41
        return 1
    if b is 110
        return 1
    if b is 111
        return 1
    if b is 126
        return 1
