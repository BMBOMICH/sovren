# ---------------------------------------------------------------
# the vector registers
# ---------------------------------------------------------------
#
# Sixteen registers of sixteen bytes each, held as two halves so an
# ordinary Sovren number can carry each one. Real programs reach for
# these constantly: glibc searches and copies memory sixteen bytes
# at a time, so a general-purpose emulator cannot skip them.
#
# Only the whole-number instructions are here. The floating point
# ones are a different job, and nothing in a normal program's
# start-up path needs them.

# peek_i64 and poke_i64 count in BYTES, not in whole numbers, so a
# register sixteen bytes wide starts at n * 16 and its top half is
# eight bytes further on. Getting this wrong made every vector
# register overlap the next one.
x_xlo m n:
    return peek_i64(peek_i64(m, 488), n * 16)

x_xhi m n:
    return peek_i64(peek_i64(m, 488), n * 16 + 8)

x_xset m n lo hi:
    x: peek_i64(m, 488)
    poke_i64(x, n * 16, lo)
    poke_i64(x, n * 16 + 8, hi)
    return 0

# one byte out of a vector register, counted from the bottom
x_xbyte m n i:
    if i < 8
        return x_mask(x_shr64(x_xlo(m, n), i * 8), 1)
    return x_mask(x_shr64(x_xhi(m, n), (i - 8) * 8), 1)

# the second operand of a vector instruction, as two halves. The
# answer goes in the two scratch slots so a job can hand back a pair.
x_xrm_lo m:
    if peek_i64(m, 360) is 1
        return x_xlo(m, peek_i64(m, 376))
    return x_r64(m, peek_i64(m, 376))

x_xrm_hi m:
    if peek_i64(m, 360) is 1
        return x_xhi(m, peek_i64(m, 376))
    return x_r64(m, x_add(peek_i64(m, 376), 8))

x_xrm_set m lo hi:
    if peek_i64(m, 360) is 1
        return x_xset(m, peek_i64(m, 376), lo, hi)
    x_w64(m, peek_i64(m, 376), lo)
    x_w64(m, x_add(peek_i64(m, 376), 8), hi)
    return 0

# compare sixteen pairs of bytes, one half at a time. `mode` is 0
# for equal and 1 for greater, and `w` is how wide each piece is.
x_pcmp_half a b mode w:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(a, i * w * 8), w)
        pb: x_mask(x_shr64(b, i * w * 8), w)
        hit: 0
        if mode is 0
            if pa is pb
                hit: 1
        if not
            if x_sval(pa, w) > x_sval(pb, w)
                hit: 1
        if hit is 1
            r: x_or(r, x_shl64(x_ones(w), i * w * 8))
        i: i + 1
    return r

# a run of one bits, w bytes wide
x_ones w:
    if w is 1
        return 255
    if w is 2
        return 65535
    if w is 4
        return 4294967295
    return 0 - 1

# the smaller or larger of each byte, counting upwards
x_pminmax_half a b big:
    r: 0
    i: 0
    as long as i < 8
        pa: x_mask(x_shr64(a, i * 8), 1)
        pb: x_mask(x_shr64(b, i * 8), 1)
        k: pa
        if big is 1
            if pb > pa
                k: pb
        if not
            if pb < pa
                k: pb
        r: x_or(r, x_shl64(k, i * 8))
        i: i + 1
    return r

# gather the top bit of all sixteen bytes into one number. This is
# how a program turns a vector compare into something it can branch
# on, and it is everywhere in glibc.
x_pmovmskb m n:
    r: 0
    i: 0
    as long as i < 16
        if x_xbyte(m, n, i) >= 128
            r: x_or(r, x_shl64(1, i))
