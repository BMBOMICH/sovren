# one vector instruction
x_vec m b p rex size:
    # Which prefix came in front decides what the instruction means:
    #   nothing  0  four narrow numbers side by side
    #   66       1  two wide ones side by side
    #   F2       2  one wide one on its own
    #   F3       3  one narrow one on its own
    # F3 is the repeat prefix and F2 the repeat-while-equal one, so
    # they arrive here as 1 and 2 and have to be told apart with
    # care: F2 is the WIDE one, which is the opposite way round from
    # how the numbers fall out.
    pre: 0
    if size is 2
        pre: 1
    r: peek_i64(m, 416)
    if r is 2
        pre: 2
    if r is 1
        pre: 3
    q: x_modrm(m, p, rex, 0)
    n: x_md_reg(m)

    # move sixteen bytes about, in all its spellings
    if b is 16
        # 10 with F2 or F3 in front is a SINGLE number, not sixteen
        # bytes. From memory the rest of the register is cleared;
        # from another register it is left alone. Copying all
        # sixteen either way leaves rubbish in the top half, and a
        # loop that adds up an array then reads it.
        if pre is 2
            if peek_i64(m, 360) is 1
                _v0: x_xrm_lo(m)
                _v1: x_xhi(m, n)
                x_xset(m, n, _v0, _v1)
                return x_go(m, q)
            x_xset(m, n, x_xrm_lo(m), 0)
            return x_go(m, q)
        if pre is 3
            v: x_mask(x_xrm_lo(m), 4)
            if peek_i64(m, 360) is 1
                keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
                x_xset(m, n, x_add(keep, v), x_xhi(m, n))
                return x_go(m, q)
            x_xset(m, n, v, 0)
            return x_go(m, q)
        return x_vmov_in(m, q, n, pre)
    if b is 111
        return x_vmov_in(m, q, n, pre)
    if b is 40
        return x_vmov_in(m, q, n, pre)
    if b is 18
        # the low half only
        _v0: x_xrm_lo(m)
        _v1: x_xhi(m, n)
        x_xset(m, n, _v0, _v1)
        return x_go(m, q)
    if b is 22
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        x_xset(m, n, _v0, _v1)
        return x_go(m, q)
    if b is 17
        if pre is 2
            if peek_i64(m, 360) is 1
                t: peek_i64(m, 376)
                a: x_xlo(m, n)
                b2: x_xhi(m, t)
                x_xset(m, t, a, b2)
                return x_go(m, q)
            x_w64(m, peek_i64(m, 376), x_xlo(m, n))
            return x_go(m, q)
        if pre is 3
            v: x_mask(x_xlo(m, n), 4)
            if peek_i64(m, 360) is 1
                t: peek_i64(m, 376)
                keep: x_sub(x_xlo(m, t), x_mask(x_xlo(m, t), 4))
                x_xset(m, t, x_add(keep, v), x_xhi(m, t))
                return x_go(m, q)
            x_w32(m, peek_i64(m, 376), v)
            return x_go(m, q)
        return x_vmov_out(m, q, n, pre)
    if b is 127
        # 7F with F3 in front is movdqu, a LOAD of sixteen bytes.
        # With 66 in front it is movdqa, a STORE. F3 arrives here as
        # pre 3, not pre 2: F2 is the wide-decimal prefix.
        if pre is 3
            return x_vmov_in(m, q, n, pre)
        return x_vmov_out(m, q, n, pre)
    if b is 41
        return x_vmov_out(m, q, n, pre)
    if b is 43
        return x_vmov_out(m, q, n, pre)
    if b is 231
        return x_vmov_out(m, q, n, pre)
    if b is 214
        # the low eight bytes only, and the top cleared when the
        # destination is a register
        if peek_i64(m, 360) is 1
            x_xset(m, peek_i64(m, 376), x_xlo(m, n), 0)
            return x_go(m, q)
        x_w64(m, peek_i64(m, 376), x_xlo(m, n))
        return x_go(m, q)
    if b is 19
        _v0: x_xlo(m, n)
        _v1: x_xrm_hi(m)
        x_xrm_set(m, _v0, _v1)
        return x_go(m, q)
    if b is 23
        _v0: x_xrm_lo(m)
        _v1: x_xhi(m, n)
        x_xrm_set(m, _v0, _v1)
        return x_go(m, q)

    # a plain register in or out of a vector one
    if b is 110
        if size is 8
            x_xset(m, n, x_rm_get(m, 8), 0)
            return x_go(m, q)
        x_xset(m, n, x_rm_get(m, 4), 0)
        return x_go(m, q)
    if b is 126
        # 6E/7E with F3 is movq, which takes the low eight bytes and
        # clears the top. F3 is pre 3.
        if pre is 3
            _a: x_xrm_lo(m)
            x_xset(m, n, _a, 0)
            return x_go(m, q)
        if size is 8
            x_rm_set(m, 8, x_xlo(m, n))
            return x_go(m, q)
        x_rm_set(m, 4, x_mask(x_xlo(m, n), 4))
        return x_go(m, q)

    # gather the top bit of every byte
    if b is 215
        x_rset(m, n, 8, x_pmovmskb(m, peek_i64(m, 376)))
        return x_go(m, q)

    # the bit by bit ones
    if b is 239
        return x_vbit(m, q, n, 0)
    if b is 87
        return x_vbit(m, q, n, 0)
    if b is 235
        return x_vbit(m, q, n, 1)
    if b is 86
        return x_vbit(m, q, n, 1)
    if b is 219
        return x_vbit(m, q, n, 2)
    if b is 84
        return x_vbit(m, q, n, 2)
    if b is 223
        return x_vbit(m, q, n, 3)
    if b is 85
        return x_vbit(m, q, n, 3)

    # compare every byte, or every four bytes
    if b is 116
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        _v2: x_xhi(m, n)
        _v3: x_xrm_hi(m)
        x_xset(m, n, x_pcmp_half(_v0, _v1, 0, 1), x_pcmp_half(_v2, _v3, 0, 1))
        return x_go(m, q)
    if b is 117
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        _v2: x_xhi(m, n)
        _v3: x_xrm_hi(m)
        x_xset(m, n, x_pcmp_half(_v0, _v1, 0, 2), x_pcmp_half(_v2, _v3, 0, 2))
        return x_go(m, q)
    if b is 118
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        _v2: x_xhi(m, n)
        _v3: x_xrm_hi(m)
        x_xset(m, n, x_pcmp_half(_v0, _v1, 0, 4), x_pcmp_half(_v2, _v3, 0, 4))
        return x_go(m, q)
    if b is 100
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        _v2: x_xhi(m, n)
        _v3: x_xrm_hi(m)
        x_xset(m, n, x_pcmp_half(_v0, _v1, 1, 1), x_pcmp_half(_v2, _v3, 1, 1))
        return x_go(m, q)
    if b is 101
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        _v2: x_xhi(m, n)
        _v3: x_xrm_hi(m)
        x_xset(m, n, x_pcmp_half(_v0, _v1, 1, 2), x_pcmp_half(_v2, _v3, 1, 2))
        return x_go(m, q)
    if b is 102
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        _v2: x_xhi(m, n)
        _v3: x_xrm_hi(m)
        x_xset(m, n, x_pcmp_half(_v0, _v1, 1, 4), x_pcmp_half(_v2, _v3, 1, 4))
        return x_go(m, q)

    # add or take away, piece by piece
    if b is 252
        return x_padd(m, q, n, 1, 0)
    if b is 253
        return x_padd(m, q, n, 2, 0)
    if b is 254
        return x_padd(m, q, n, 4, 0)
    # 0xD4, not 0xF4: 0xF4 is not a real instruction and a real
    # processor refuses it. glibc's static start of life reaches for
    # paddq, and this being wrong stopped every Ubuntu 24.04 build.
    if b is 212
        return x_padd(m, q, n, 8, 0)
    if b is 248
        return x_padd(m, q, n, 1, 1)
    if b is 249
        return x_padd(m, q, n, 2, 1)
    if b is 250
        return x_padd(m, q, n, 4, 1)
    if b is 251
        return x_padd(m, q, n, 8, 1)

    # the saturating ones: add or take away, and hold at the ends.
    # sat 1 holds at zero and the top; sat 2 holds at the two ends
    # of a signed range.
    if b is 216
        return x_padd_sat(m, q, n, 1, 1, 0)
    if b is 217
        return x_padd_sat(m, q, n, 2, 1, 0)
    if b is 220
        return x_padd_sat(m, q, n, 1, 1, 1)
    if b is 221
        return x_padd_sat(m, q, n, 2, 1, 1)
    if b is 232
        return x_padd_sat(m, q, n, 1, 2, 0)
    if b is 233
        return x_padd_sat(m, q, n, 2, 2, 0)
    if b is 236
        return x_padd_sat(m, q, n, 1, 2, 1)
    if b is 237
        return x_padd_sat(m, q, n, 2, 2, 1)

    # the average of every byte or every word, rounding up
    if b is 224
        return x_pavg(m, q, n, 1)
    if b is 227
        return x_pavg(m, q, n, 2)

    # the same shifts, but the count lives in another vector
    # register rather than being written into the instruction
    if b is 209
        return x_pshift_xmm(m, q, n, 2, 1)
    if b is 210
        return x_pshift_xmm(m, q, n, 4, 1)
    if b is 211
        return x_pshift_xmm(m, q, n, 8, 1)
    if b is 241
        return x_pshift_xmm(m, q, n, 2, 0)
    if b is 242
        return x_pshift_xmm(m, q, n, 4, 0)
    if b is 243
        return x_pshift_xmm(m, q, n, 8, 0)
    if b is 225
        return x_pshift_xmm(m, q, n, 2, 2)
    if b is 226
        return x_pshift_xmm(m, q, n, 4, 2)

    # the smallest or largest of every word, signed
    if b is 234
        return x_pminmax_w(m, q, n, 0)
    if b is 238
        return x_pminmax_w(m, q, n, 1)

    # the low half of every word times every word
    if b is 213
        return x_pmul_low(m, q, n)
    # the high half of every word times every word, signed or not
    if b is 228
        return x_pmul_high(m, q, n, 0)
    if b is 229
        return x_pmul_high(m, q, n, 1)
    # two dwords times two dwords, keeping the whole answer
    if b is 244
        return x_pmuludq(m, q, n)
    # words multiplied in pairs and added
    if b is 245
        return x_pmaddwd(m, q, n)
    # how far apart two rows of bytes are, added up
    if b is 246
        return x_psadbw(m, q, n)
    # write the bytes whose mask says so, to where rdi points
    if b is 247
        return x_maskmov(m, q, n)

    # squeeze words down to bytes, or dwords down to words. sgn 1
    # holds at the signed ends, sgn 0 at the unsigned top.
    if b is 99
        return x_packv(m, q, n, 1, 1)
    if b is 103
        return x_packv(m, q, n, 1, 0)
    if b is 107
        return x_packv(m, q, n, 2, 1)

    # interleave the high halves, byte by byte or word by word
    if b is 104
        return x_punpck(m, q, n, 1, 1)
    if b is 105
        return x_punpck(m, q, n, 2, 1)

    # shift each piece by a number written in
    if b is 113
        return x_pshift_imm(m, q, n, 2)
    if b is 114
        return x_pshift_imm(m, q, n, 4)

    # the smallest or largest of each byte
    if b is 218
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        _v2: x_xhi(m, n)
        _v3: x_xrm_hi(m)
        x_xset(m, n, x_pminmax_half(_v0, _v1, 0), x_pminmax_half(_v2, _v3, 0))
        return x_go(m, q)
    if b is 222
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        _v2: x_xhi(m, n)
        _v3: x_xrm_hi(m)
        x_xset(m, n, x_pminmax_half(_v0, _v1, 1), x_pminmax_half(_v2, _v3, 1))
        return x_go(m, q)

    # shift the whole sixteen bytes by a number written in
    if b is 115
        op: n % 8
        by: x_r8(m, q)
        t: peek_i64(m, 376)
        if op is 7
            x_pslldq(m, t, by)
            return x_go(m, q + 1)
        if op is 3
            x_psrldq(m, t, by)
            return x_go(m, q + 1)
        if op is 6
            _v0: x_xlo(m, t)
            _v1: x_xhi(m, t)
            x_xset(m, t, x_shl64(_v0, by), x_shl64(_v1, by))
            return x_go(m, q + 1)
        if op is 2
            _v0: x_xlo(m, t)
            _v1: x_xhi(m, t)
            x_xset(m, t, x_shr64(_v0, by), x_shr64(_v1, by))
            return x_go(m, q + 1)
        return x_go(m, q + 1)

    # interleave the low or high halves
    if b is 108
        _v0: x_xlo(m, n)
        _v1: x_xrm_lo(m)
        x_xset(m, n, _v0, _v1)
        return x_go(m, q)
    if b is 109
        _v0: x_xhi(m, n)
        _v1: x_xrm_hi(m)
        x_xset(m, n, _v0, _v1)
        return x_go(m, q)
    if b is 96
        return x_punpck(m, q, n, 1, 0)
    if b is 97
        return x_punpck(m, q, n, 2, 0)
    if b is 98
        return x_punpck(m, q, n, 4, 0)
    if b is 106
        return x_punpck(m, q, n, 4, 1)

    # shuffle four-byte pieces around. 66 is pshufd, F3 shuffles
    # the high four words, F2 the low four.
    if b is 112
        by: x_r8(m, q)
        if pre is 3
            return x_pshufhw(m, q + 1, n, by)
        if pre is 2
            return x_pshuflw(m, q + 1, n, by)
        return x_pshufd(m, q + 1, n, by)

    # a word from a plain register or memory into a vector register
    if b is 196
        by: x_r8(m, q)
        return x_pinsrw(m, q + 1, n, by)

    # whole numbers into narrow decimals, or the other way round
    if b is 91
        return x_cvt_dq(m, q, n, pre)
    # two wide ones and two whole numbers
    if b is 230
        return x_cvt_dq2(m, q, n, pre)

    # add or take away across the pieces, not within them
    if b is 124
        return x_hadd(m, q, n, pre, 0)
    if b is 125
        return x_hadd(m, q, n, pre, 1)

    # take two wide ones apart. The plain form of the opcode is the
    # same as the 66 one for the narrow ones, so only 66 is real.
    if b is 208
        return x_farith(m, q, n, 1, 1)

    # the reciprocal, and the reciprocal square root. Real processors
    # hand back a twelve bit guess here, which differs from one chip
    # to the next, so this computes them exactly instead. A program
    # that uses them is told by the manual to expect the error.
    if b is 82
        return x_recip(m, q, n, pre, 1)
    if b is 83
        return x_recip(m, q, n, pre, 0)

    # the two-byte families, where the third byte chooses the work.
    # p points at that third byte; the generic modrm read above was
    # against the wrong byte, so everything is read again in here.
    if b is 56
        return x_vec38(m, p, n, rex, size)
    if b is 58
        return x_vec3a(m, p, n, rex, size)

    # ---- decimal arithmetic ----
    # pre says which kind: 2 is one double, 3 is one single, 0 and 1
    # are the packed forms which do the same to each piece.
    if b is 88
        return x_farith(m, q, n, pre, 0)
    if b is 92
        return x_farith(m, q, n, pre, 1)
    if b is 89
        return x_farith(m, q, n, pre, 2)
    if b is 94
        return x_farith(m, q, n, pre, 3)
    if b is 95
        return x_farith(m, q, n, pre, 4)
    if b is 93
        return x_farith(m, q, n, pre, 5)
    if b is 81
        return x_farith(m, q, n, pre, 6)

    # a whole number into a decimal one
    if b is 42
        return x_cvt_i2f(m, q, n, pre, size)
    # a decimal one back to a whole number, throwing the rest away
    if b is 44
        return x_cvt_f2i(m, q, n, pre, size, 0)
    # the same, but rounding to the nearest whole number. The
    # rounding mode is nearest unless a program has changed it, and
    # nothing here changes it.
    if b is 45
        return x_cvt_f2i(m, q, n, pre, size, 1)
    # between the two widths
    if b is 90
        return x_cvt_ff(m, q, n, pre)

    # compare, leaving the answer as a mask rather than in the flags
    if b is 194
        return x_fcmp_mask(m, q, n, pre)

    # lace two together, which is how a program builds a pair
    if b is 20
        lo1: x_xlo(m, n)
        lo2: x_xrm_lo(m)
        x_xset(m, n, lo1, lo2)
        return x_go(m, q)
    if b is 21
        h1: x_xhi(m, n)
        h2: x_xrm_hi(m)
        x_xset(m, n, h1, h2)
        return x_go(m, q)

    # gather the sign bits
    if b is 80
        t: peek_i64(m, 376)
        r: 0
        if pre is 1
            if x_xlo(m, t) < 0
                r: 1
            if x_xhi(m, t) < 0
                r: r + 2
        if not
            if x_bit(x_xlo(m, t), 31) is 1
                r: 1
            if x_bit(x_xlo(m, t), 63) is 1
                r: r + 2
            if x_bit(x_xhi(m, t), 31) is 1
                r: r + 4
            if x_bit(x_xhi(m, t), 63) is 1
                r: r + 8
        x_rset(m, n, 8, r)
        return x_go(m, q)

    # compare two numbers and set the ordinary flags
    if b is 46
        return x_ucomis(m, q, n, pre)
    if b is 47
        return x_ucomis(m, q, n, pre)

    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, 3840 + b)
    return 0

# add or take away each piece on its own, with no carry between
x_padd m q n w sub:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    lo: x_padd_half(al, bl, w, sub)
    hi: x_padd_half(ah, bh, w, sub)
    x_xset(m, n, lo, hi)
    return x_go(m, q)

x_padd_half a b w sub:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(a, i * w * 8), w)
        pb: x_mask(x_shr64(b, i * w * 8), w)
        k: pa + pb
        if sub is 1
            k: pa - pb
        r: x_or(r, x_shl64(x_mask(k, w), i * w * 8))
        i: i + 1
    return r

# add or take away with the ends held on. sat 1 is unsigned (hold
# at zero and the top), sat 2 is signed (hold at both ends).
x_padd_sat m q n w sat add:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_padd_sat_half(al, bl, w, sat, add), x_padd_sat_half(ah, bh, w, sat, add))
    return x_go(m, q)

x_padd_sat_half a b w sat add:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(a, i * w * 8), w)
        pb: x_mask(x_shr64(b, i * w * 8), w)
        if sat is 2
            pa: x_sval(pa, w)
            pb: x_sval(pb, w)
        k: pa + pb
        if add is 0
            k: pa - pb
        if sat is 1
            hi2: 255
            if w is 2
                hi2: 65535
            if k < 0
                k: 0
            if k > hi2
                k: hi2
        if not
            if w is 1
                if k > 127
                    k: 127
                if k < 0 - 128
                    k: 0 - 128
            if not
                if k > 32767
                    k: 32767
                if k < 0 - 32768
                    k: 0 - 32768
        r: x_or(r, x_shl64(x_mask(k, w), i * w * 8))
        i: i + 1
    return r

# the average of every piece, (a + b + 1) / 2
x_pavg m q n w:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_pavg_half(al, bl, w), x_pavg_half(ah, bh, w))
    return x_go(m, q)

x_pavg_half a b w:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(a, i * w * 8), w)
        pb: x_mask(x_shr64(b, i * w * 8), w)
        k: (pa + pb + 1) / 2
        r: x_or(r, x_shl64(x_mask(k, w), i * w * 8))
        i: i + 1
    return r

# shift each piece by a count held in the low eight bytes of the
# other vector register
x_pshift_xmm m q n w way:
    by: x_xrm_lo(m)
    x_xset(m, n, x_pshift_half(x_xlo(m, n), by, w, way), x_pshift_half(x_xhi(m, n), by, w, way))
    return x_go(m, q)

# the smallest or largest of every word, signed. big 1 is the
# largest, big 0 the smallest.
x_pminmax_w m q n big:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_pminmax_w_half(al, bl, big), x_pminmax_w_half(ah, bh, big))
    return x_go(m, q)

x_pminmax_w_half a b big:
    r: 0
    i: 0
    as long as i < 4
        pa: x_sval(x_mask(x_shr64(a, i * 16), 2), 2)
        pb: x_sval(x_mask(x_shr64(b, i * 16), 2), 2)
        k: pa
        if big is 1
            if pb > pa
                k: pb
        if not
            if pb < pa
                k: pb
        r: x_or(r, x_shl64(x_mask(k, 2), i * 16))
        i: i + 1
    return r

# the low half of every word times every word
x_pmul_low m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_pmul_low_half(al, bl), x_pmul_low_half(ah, bh))
    return x_go(m, q)

x_pmul_low_half a b:
    r: 0
    i: 0
    as long as i < 4
        pa: x_mask(x_shr64(a, i * 16), 2)
        pb: x_mask(x_shr64(b, i * 16), 2)
        k: x_mask(pa * pb, 2)
        r: x_or(r, x_shl64(k, i * 16))
        i: i + 1
    return r

# the high half of every word times every word. sgn 1 treats the
# words as signed, sgn 0 as unsigned.
x_pmul_high m q n sgn:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_pmul_high_half(al, bl, sgn), x_pmul_high_half(ah, bh, sgn))
    return x_go(m, q)

x_pmul_high_half a b sgn:
    r: 0
    i: 0
    as long as i < 4
        pa: x_mask(x_shr64(a, i * 16), 2)
        pb: x_mask(x_shr64(b, i * 16), 2)
        if sgn is 1
            pa: x_sval(pa, 2)
            pb: x_sval(pb, 2)
            k: x_sar64(pa * pb, 16)
        if not
            k: x_shr64(pa * pb, 16)
        r: x_or(r, x_shl64(x_mask(k, 2), i * 16))
        i: i + 1
    return r

# two dwords times two dwords, the whole eight bytes kept
x_pmuludq m q n:
    al: x_mask(x_xlo(m, n), 4)
    ah: x_mask(x_xhi(m, n), 4)
    bl: x_mask(x_xrm_lo(m), 4)
    bh: x_mask(x_xrm_hi(m), 4)
    x_xset(m, n, al * bl, ah * bh)
    return x_go(m, q)

# words multiplied in pairs and added, four dwords out of eight
x_pmaddwd m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_pmaddwd_half(al, bl), x_pmaddwd_half(ah, bh))
    return x_go(m, q)

x_pmaddwd_half a b:
    r: 0
    i: 0
    as long as i < 2
        w0a: x_sval(x_mask(x_shr64(a, i * 32), 2), 2)
        w1a: x_sval(x_mask(x_shr64(a, i * 32 + 16), 2), 2)
        w0b: x_sval(x_mask(x_shr64(b, i * 32), 2), 2)
        w1b: x_sval(x_mask(x_shr64(b, i * 32 + 16), 2), 2)
        k: w0a * w0b + w1a * w1b
        r: x_or(r, x_shl64(x_mask(k, 4), i * 32))
        i: i + 1
    return r

# how far apart two rows of bytes are, added up, eight at a time
x_psadbw m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_psadbw_half(al, bl), x_psadbw_half(ah, bh))
    return x_go(m, q)

x_psadbw_half a b:
    r: 0
    i: 0
    as long as i < 8
        pa: x_mask(x_shr64(a, i * 8), 1)
        pb: x_mask(x_shr64(b, i * 8), 1)
        d: pa - pb
        if d < 0
            d: 0 - d
        r: r + d
        i: i + 1
    return r

# write the bytes whose mask says so, to where rdi points. The mask
# is the second operand; the data is the first.
x_maskmov m q n:
    base: x_reg(m, 7)
    rmi: peek_i64(m, 376)
    d: 0
    as long as d < 16
        if x_xbyte(m, rmi, d) >= 128
            x_w8(m, base + d, x_xbyte(m, n, d))
        d: d + 1
    return x_go(m, q)

# squeeze words down to bytes, or dwords down to words, holding at
# the ends. The first operand fills the first half of the answer.
x_packv m q n w sgn:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    if w is 1
        x_xset(m, n, x_or(x_pack_b_half(al, sgn), x_shl64(x_pack_b_half(ah, sgn), 32)), x_or(x_pack_b_half(bl, sgn), x_shl64(x_pack_b_half(bh, sgn), 32)))
    if not
        x_xset(m, n, x_or(x_pack_w_half(al), x_shl64(x_pack_w_half(ah), 32)), x_or(x_pack_w_half(bl), x_shl64(x_pack_w_half(bh), 32)))
    return x_go(m, q)

x_pack_b_half v sgn:
    r: 0
    i: 0
    as long as i < 4
        pa: x_mask(x_shr64(v, i * 16), 2)
        # the words are signed either way: packsswb holds at the two
        # signed ends, packuswb holds at nought and the top
        k: x_sval(pa, 2)
        if sgn is 1
            if k > 127
                k: 127
            if k < 0 - 128
                k: 0 - 128
        if not
            if k < 0
                k: 0
            if k > 255
                k: 255
        r: x_or(r, x_shl64(x_mask(k, 1), i * 8))
        i: i + 1
    return r

x_pack_w_half v:
    r: 0
    i: 0
    as long as i < 2
        pa: x_mask(x_shr64(v, i * 32), 4)
        k: x_sval(pa, 4)
        if k > 32767
            k: 32767
        if k < 0 - 32768
            k: 0 - 32768
        r: x_or(r, x_shl64(x_mask(k, 2), i * 16))
        i: i + 1
    return r

# shift each piece, left or right, by a number written in
x_pshift_imm m q n w:
    op: x_md_reg(m) % 8
    by: x_r8(m, q)
    t: peek_i64(m, 376)
    lo: x_xlo(m, t)
    hi: x_xhi(m, t)
    if op is 6
        x_xset(m, t, x_pshift_half(lo, by, w, 0), x_pshift_half(hi, by, w, 0))
        return x_go(m, q + 1)
    if op is 2
        x_xset(m, t, x_pshift_half(lo, by, w, 1), x_pshift_half(hi, by, w, 1))
        return x_go(m, q + 1)
    if op is 4
        x_xset(m, t, x_pshift_half(lo, by, w, 2), x_pshift_half(hi, by, w, 2))
        return x_go(m, q + 1)
    return x_go(m, q + 1)

x_pshift_half a by w way:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(a, i * w * 8), w)
        k: 0
        if by < w * 8
            if way is 0
                k: x_mask(x_shl64(pa, by), w)
            if way is 1
                k: x_shr64(pa, by)
            if way is 2
                k: x_mask(x_sar64(x_sval(pa, w), by), w)
        if not
            if way is 2
                k: 0
                if x_sval(pa, w) < 0
                    k: x_ones(w)
        r: x_or(r, x_shl64(k, i * w * 8))
        i: i + 1
    return r

# the 0F 38 family
# ---- the two-operand vector workers ----
#
# Each reads BOTH halves of the second operand into names before
# writing anything. Calling two jobs inside the arguments of a third
# leaves them fighting over the same scratch and the first answer is
# quietly lost. That bug corrupted memory a long way from here.

x_vbit m q n op:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    if op is 0
        x_xset(m, n, x_xor(al, bl), x_xor(ah, bh))
        return x_go(m, q)
    if op is 1
        x_xset(m, n, x_or(al, bl), x_or(ah, bh))
        return x_go(m, q)
    if op is 2
        x_xset(m, n, x_and(al, bl), x_and(ah, bh))
        return x_go(m, q)
    x_xset(m, n, x_and(x_not(al), bl), x_and(x_not(ah), bh))
    return x_go(m, q)

x_vcmp m q n mode w:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    lo: x_pcmp_half(al, bl, mode, w)
    hi: x_pcmp_half(ah, bh, mode, w)
    x_xset(m, n, lo, hi)
    return x_go(m, q)

x_vminmax m q n big:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    lo: x_pminmax_half(al, bl, big)
    hi: x_pminmax_half(ah, bh, big)
    x_xset(m, n, lo, hi)
    return x_go(m, q)

# a move into a vector register
x_vmov_in m q n pre:
    # read both halves into names first. Calling two jobs inside the
    # arguments of a third leaves them fighting over the same
    # scratch, and the first answer is lost.
    a: x_xrm_lo(m)
    b: x_xrm_hi(m)
    x_xset(m, n, a, b)
    return x_go(m, q)

# a move out of one
x_vmov_out m q n pre:
    _v0: x_xlo(m, n)
    _v1: x_xhi(m, n)
    x_xrm_set(m, _v0, _v1)
    return x_go(m, q)

# take the low halves of both and lace them together
x_punpck m q n w high:
    al: x_xlo(m, n)
    bl: x_xrm_lo(m)
    if high is 1
        al: x_xhi(m, n)
        bl: x_xrm_hi(m)
    lo: 0
    hi: 0
    per: 8 / w
    i: 0
    as long as i < per
        pa: x_mask(x_shr64(al, i * w * 8), w)
        pb: x_mask(x_shr64(bl, i * w * 8), w)
        at: i * 2 * w * 8
        if at < 64
            lo: x_or(lo, x_shl64(pa, at))
            lo: x_or(lo, x_shl64(pb, at + w * 8))
        if not
            hi: x_or(hi, x_shl64(pa, at - 64))
            hi: x_or(hi, x_shl64(pb, at - 64 + w * 8))
        i: i + 1
    x_xset(m, n, lo, hi)
    return x_go(m, q)

# rearrange the four four-byte pieces, as the byte says
x_pshufd m q n by:
    s0: x_vpiece(m, by % 4)
    s1: x_vpiece(m, (by / 4) % 4)
    s2: x_vpiece(m, (by / 16) % 4)
    s3: x_vpiece(m, (by / 64) % 4)
    x_xset(m, n, x_or(s0, x_shl64(s1, 32)), x_or(s2, x_shl64(s3, 32)))
    return x_go(m, q)

# one four-byte piece of the second operand
x_vpiece m i:
    if i < 2
        return x_mask(x_shr64(x_xrm_lo(m), i * 32), 4)
    return x_mask(x_shr64(x_xrm_hi(m), (i - 2) * 32), 4)

# ---- one decimal sum, at whichever width the prefix asked for ----
#
# pre 2 means a single double in the bottom of the register and the
# rest untouched. pre 3 means a single of the narrow kind. pre 1
# means two doubles side by side, pre 0 four of the narrow kind.

x_farith m q n pre op:
    if pre is 2
        a: x_xlo(m, n)
        b: x_xrm_lo(m)
        x_xset(m, n, x_fdo(m, op, a, b), x_xhi(m, n))
        return x_go(m, q)
    if pre is 3
        a: x_f2d(m, x_mask(x_xlo(m, n), 4))
        b: x_f2d(m, x_mask(x_xrm_lo(m), 4))
        r: x_d2f(m, x_fdo(m, op, a, b))
        keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
        x_xset(m, n, x_add(keep, r), x_xhi(m, n))
        return x_go(m, q)
    if pre is 1
        l: x_fdo(m, op, x_xlo(m, n), x_xrm_lo(m))
        h: x_fdo(m, op, x_xhi(m, n), x_xrm_hi(m))
        x_xset(m, n, l, h)
        return x_go(m, q)
    # four of the narrow kind
    l: x_pair32(m, op, x_xlo(m, n), x_xrm_lo(m))
    h: x_pair32(m, op, x_xhi(m, n), x_xrm_hi(m))
    x_xset(m, n, l, h)
    return x_go(m, q)

# two narrow ones held in one sixty-four bit half
x_pair32 m op a b:
    lo: x_d2f(m, x_fdo(m, op, x_f2d(m, x_mask(a, 4)), x_f2d(m, x_mask(b, 4))))
    hi: x_d2f(m, x_fdo(m, op, x_f2d(m, x_shr64(a, 32)), x_f2d(m, x_shr64(b, 32))))
    return x_or(lo, x_shl64(hi, 32))

x_fdo m op a b:
    if op is 0
        return x_fadd(m, a, b)
    if op is 1
        return x_fsub(m, a, b)
    if op is 2
        return x_fmul(m, a, b)
    if op is 3
        return x_fdiv(m, a, b)
    if op is 4
        return x_fmax(m, a, b)
    if op is 5
        return x_fmin(m, a, b)
    return x_fsqrt(m, b)

# four whole numbers into four narrow decimals, or the other way.
# 5B: 66 rounds to the nearest whole number, F3 throws the fraction
# away, and the plain form is whole numbers into decimals.
x_cvt_dq m q n pre:
    if pre is 3
        a: x_xrm_lo(m)
        b: x_xrm_hi(m)
        w0: x_mask(x_d2i(m, x_f2d(m, x_mask(a, 4))), 4)
        w1: x_mask(x_d2i(m, x_f2d(m, x_shr64(a, 32))), 4)
        w2: x_mask(x_d2i(m, x_f2d(m, x_mask(b, 4))), 4)
        w3: x_mask(x_d2i(m, x_f2d(m, x_shr64(b, 32))), 4)
        x_xset(m, n, x_or(w0, x_shl64(w1, 32)), x_or(w2, x_shl64(w3, 32)))
        return x_go(m, q)
    if pre is 1
        a: x_xrm_lo(m)
        b: x_xrm_hi(m)
        w0: x_mask(x_d2i(m, x_round_d(m, x_f2d(m, x_mask(a, 4)), 0)), 4)
        w1: x_mask(x_d2i(m, x_round_d(m, x_f2d(m, x_shr64(a, 32)), 0)), 4)
        w2: x_mask(x_d2i(m, x_round_d(m, x_f2d(m, x_mask(b, 4)), 0)), 4)
        w3: x_mask(x_d2i(m, x_round_d(m, x_f2d(m, x_shr64(b, 32)), 0)), 4)
        x_xset(m, n, x_or(w0, x_shl64(w1, 32)), x_or(w2, x_shl64(w3, 32)))
        return x_go(m, q)
    a: x_xrm_lo(m)
    b: x_xrm_hi(m)
    w0: x_d2f(m, x_i2d(m, x_sval(x_mask(a, 4), 4)))
    w1: x_d2f(m, x_i2d(m, x_sval(x_shr64(a, 32), 4)))
    w2: x_d2f(m, x_i2d(m, x_sval(x_mask(b, 4), 4)))
    w3: x_d2f(m, x_i2d(m, x_sval(x_shr64(b, 32), 4)))
    x_xset(m, n, x_or(w0, x_shl64(w1, 32)), x_or(w2, x_shl64(w3, 32)))
    return x_go(m, q)

# two wide ones into two whole numbers, or the other way. E6: 66
# throws the fraction away, F3 is whole numbers into wide decimals.
x_cvt_dq2 m q n pre:
    if pre is 1
        a: x_xrm_lo(m)
        b: x_xrm_hi(m)
        x_xset(m, n, x_or(x_mask(x_d2i(m, a), 4), x_shl64(x_mask(x_d2i(m, b), 4), 32)), 0)
        return x_go(m, q)
    a: x_xrm_lo(m)
    x_xset(m, n, x_i2d(m, x_sval(x_mask(a, 4), 4)), x_i2d(m, x_sval(x_shr64(a, 32), 4)))
    return x_go(m, q)

# add or take away across the pieces. F2 is four narrow ones in
# pairs, 66 is two wide ones, F3 is one narrow one on its own.
x_hadd m q n pre sub:
    if pre is 2
        al: x_xlo(m, n)
        ah: x_xhi(m, n)
        bl: x_xrm_lo(m)
        bh: x_xrm_hi(m)
        a0: x_f2d(m, x_mask(al, 4))
        a1: x_f2d(m, x_shr64(al, 32))
        a2: x_f2d(m, x_mask(ah, 4))
        a3: x_f2d(m, x_shr64(ah, 32))
        b0: x_f2d(m, x_mask(bl, 4))
        b1: x_f2d(m, x_shr64(bl, 32))
        b2: x_f2d(m, x_mask(bh, 4))
        b3: x_f2d(m, x_shr64(bh, 32))
        if sub is 1
            r0: x_fsub(m, a0, a1)
            r1: x_fsub(m, a2, a3)
            r2: x_fsub(m, b0, b1)
            r3: x_fsub(m, b2, b3)
        if not
            r0: x_fadd(m, a0, a1)
            r1: x_fadd(m, a2, a3)
            r2: x_fadd(m, b0, b1)
            r3: x_fadd(m, b2, b3)
        x_xset(m, n, x_or(x_d2f(m, r0), x_shl64(x_d2f(m, r1), 32)), x_or(x_d2f(m, r2), x_shl64(x_d2f(m, r3), 32)))
        return x_go(m, q)
    if pre is 3
        a0: x_f2d(m, x_mask(x_xlo(m, n), 4))
        a1: x_f2d(m, x_shr64(x_xlo(m, n), 32))
        keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
        if sub is 1
            r: x_fsub(m, a0, a1)
        if not
            r: x_fadd(m, a0, a1)
        x_xset(m, n, x_add(keep, x_d2f(m, r)), x_xhi(m, n))
        return x_go(m, q)
    # two wide ones: each side adds its own two pieces together
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    if sub is 1
        r0: x_fsub(m, al, ah)
        r1: x_fsub(m, bl, bh)
    if not
        r0: x_fadd(m, al, ah)
        r1: x_fadd(m, bl, bh)
    x_xset(m, n, r0, r1)
    return x_go(m, q)

# the reciprocal, and the reciprocal square root. Real chips return
# a twelve bit estimate which differs between models; this computes
# the exact answer instead, which is what the manuals say the
# estimate is for.
x_recip m q n pre sqrt:
    one: x_i2d(m, 1)
    if pre is 3
        v: x_f2d(m, x_mask(x_xrm_lo(m), 4))
        if sqrt is 1
            v: x_fsqrt(m, v)
        r: x_fdiv(m, one, v)
        keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
        x_xset(m, n, x_add(keep, x_d2f(m, r)), x_xhi(m, n))
        return x_go(m, q)
    a: x_xrm_lo(m)
    b: x_xrm_hi(m)
    if sqrt is 1
        r0: x_fdiv(m, one, x_fsqrt(m, x_f2d(m, x_mask(a, 4))))
        r1: x_fdiv(m, one, x_fsqrt(m, x_f2d(m, x_shr64(a, 32))))
        r2: x_fdiv(m, one, x_fsqrt(m, x_f2d(m, x_mask(b, 4))))
        r3: x_fdiv(m, one, x_fsqrt(m, x_f2d(m, x_shr64(b, 32))))
    if not
        r0: x_fdiv(m, one, x_f2d(m, x_mask(a, 4)))
        r1: x_fdiv(m, one, x_f2d(m, x_shr64(a, 32)))
        r2: x_fdiv(m, one, x_f2d(m, x_mask(b, 4)))
        r3: x_fdiv(m, one, x_f2d(m, x_shr64(b, 32)))
    x_xset(m, n, x_or(x_d2f(m, r0), x_shl64(x_d2f(m, r1), 32)), x_or(x_d2f(m, r2), x_shl64(x_d2f(m, r3), 32)))
    return x_go(m, q)

# round a double to a whole number. 0 is nearest with ties going to
# even, 1 is down, 2 is up, 3 is toward nought.
x_round_d m v mode:
    x_unpack(m, v)
    k: x_up_kind(m)
    if k is not X_F_NUM
        return v
    e: x_up_exp(m)
    if e >= 52
        return v
    i: x_d2i(m, v)
    t: x_i2d(m, i)
    if mode is 3
        return t
    if mode is 1
        if x_fcmp(m, v, t) is 0
            return x_fsub(m, t, x_i2d(m, 1))
        return t
    if mode is 2
        if x_fcmp(m, v, t) is 2
            return x_fadd(m, t, x_i2d(m, 1))
        return t
    f: x_fsub(m, v, t)
    if f < 0
        f: x_fsub(m, 0, f)
    half: x_fdiv(m, x_i2d(m, 1), x_i2d(m, 2))
    c: x_fcmp(m, f, half)
    if c is 2
        if i < 0
            return x_fsub(m, t, x_i2d(m, 1))
        return x_fadd(m, t, x_i2d(m, 1))
    if c is 1
        if x_and(i, 1) is 1
            if i < 0
                return x_fsub(m, t, x_i2d(m, 1))
            return x_fadd(m, t, x_i2d(m, 1))
    return t

# the same for a narrow decimal: widen, round, narrow again
x_round_s m v mode:
    return x_d2f(m, x_round_d(m, x_f2d(m, v), mode))

# shuffle the four words of one half of a vector register. F3 works
# on the high half, F2 on the low, and the other half is kept.
x_pshufhw m q n by:
    h: x_xhi(m, n)
    a: x_mask(x_shr64(h, 0), 2)
    b: x_mask(x_shr64(h, 16), 2)
    c: x_mask(x_shr64(h, 32), 2)
    d: x_mask(x_shr64(h, 48), 2)
    s0: a
    s1: a
    s2: a
    s3: a
    if by % 4 is 1
        s0: b
    if by % 4 is 2
        s0: c
    if by % 4 is 3
        s0: d
    if by / 4 % 4 is 1
        s1: b
    if by / 4 % 4 is 2
        s1: c
    if by / 4 % 4 is 3
        s1: d
    if by / 16 % 4 is 1
        s2: b
    if by / 16 % 4 is 2
        s2: c
    if by / 16 % 4 is 3
        s2: d
    if by / 64 % 4 is 1
        s3: b
    if by / 64 % 4 is 2
        s3: c
    if by / 64 % 4 is 3
        s3: d
    x_xset(m, n, x_xlo(m, n), x_or(x_or(x_or(s0, x_shl64(s1, 16)), x_shl64(s2, 32)), x_shl64(s3, 48)))
    return x_go(m, q)

x_pshuflw m q n by:
    l: x_xlo(m, n)
    a: x_mask(x_shr64(l, 0), 2)
    b: x_mask(x_shr64(l, 16), 2)
    c: x_mask(x_shr64(l, 32), 2)
    d: x_mask(x_shr64(l, 48), 2)
    s0: a
    s1: a
    s2: a
    s3: a
    if by % 4 is 1
        s0: b
    if by % 4 is 2
        s0: c
    if by % 4 is 3
        s0: d
    if by / 4 % 4 is 1
        s1: b
    if by / 4 % 4 is 2
        s1: c
    if by / 4 % 4 is 3
        s1: d
    if by / 16 % 4 is 1
        s2: b
    if by / 16 % 4 is 2
        s2: c
    if by / 16 % 4 is 3
        s2: d
    if by / 64 % 4 is 1
        s3: b
    if by / 64 % 4 is 2
        s3: c
    if by / 64 % 4 is 3
        s3: d
    x_xset(m, n, x_or(x_or(x_or(s0, x_shl64(s1, 16)), x_shl64(s2, 32)), x_shl64(s3, 48)), x_xhi(m, n))
    return x_go(m, q)

# put a word from a plain register or memory into one lane of a
# vector register. 0F C4.
x_pinsrw m q n by:
    v: x_rm_get(m, 2)
    lane: by % 8
    t: x_xlo(m, n)
    if lane >= 4
        t: x_xhi(m, n)
    keep: x_sub(t, x_shl64(x_mask(x_shr64(t, (lane % 4) * 16), 2), (lane % 4) * 16))
    t2: x_add(keep, x_shl64(x_mask(v, 2), (lane % 4) * 16))
    if lane >= 4
        x_xset(m, n, x_xlo(m, n), t2)
    if not
        x_xset(m, n, t2, x_xhi(m, n))
    return x_go(m, q)

# ---- the two byte families: 0F 38 and 0F 3A ----
# The generic decoder reads the third byte as if it were a modrm, so
# the real modrm has to be read again here.

x_vec38 m p n rex size:
    op: x_r8(m, p)
    q2: x_modrm(m, p + 1, rex, 0)
    n2: x_md_reg(m)
    # a plain-register load or store, with the bytes turned round.
    # F2 in front changes the meaning to the CRC instruction below.
    if op is 240
        if peek_i64(m, 416) is 2
            return x_crc32(m, q2, n2, rex, size, 1)
        return x_movbe(m, q2, n2, rex, size, 1)
    if op is 241
        if peek_i64(m, 416) is 2
            return x_crc32(m, q2, n2, rex, size, 0)
        return x_movbe(m, q2, n2, rex, size, 0)
    if op is 0
        return x_pshufb(m, q2, n2)
    if op is 1
        return x_phadd(m, q2, n2, 2, 0, 0)
    if op is 2
        return x_phadd(m, q2, n2, 4, 0, 0)
    if op is 3
        return x_phadd(m, q2, n2, 2, 0, 1)
    if op is 4
        return x_pmaddubsw(m, q2, n2)
    if op is 5
        return x_phadd(m, q2, n2, 2, 1, 0)
    if op is 6
        return x_phadd(m, q2, n2, 4, 1, 0)
    if op is 7
        return x_phadd(m, q2, n2, 2, 1, 1)
    if op is 8
        return x_psign(m, q2, n2, 1)
    if op is 9
        return x_psign(m, q2, n2, 2)
    if op is 10
        return x_psign(m, q2, n2, 4)
    if op is 11
        return x_pmulhrsw(m, q2, n2)
    if op is 12
        return x_pblendps(m, q2, n2)
    if op is 13
        return x_pblendpd(m, q2, n2)
    if op is 16
        return x_pblendvb(m, q2, n2)
    if op is 23
        return x_ptest(m, q2, n2)
    if op is 41
        return x_pcmpeqq(m, q2, n2)
    if op is 42
        v0: x_xrm_lo(m)
        v1: x_xrm_hi(m)
        x_xset(m, n2, v0, v1)
        return x_go(m, q2)
    if op is 43
        return x_packusdw(m, q2, n2)
    if op is 55
        return x_pcmpgtq(m, q2, n2)
    if op is 56
        return x_pminmax2(m, q2, n2, 1, 0, 1)
    if op is 57
        return x_pminmax2(m, q2, n2, 4, 0, 1)
    if op is 58
        return x_pminmax2(m, q2, n2, 2, 0, 0)
    if op is 59
        return x_pminmax2(m, q2, n2, 4, 0, 0)
    if op is 60
        return x_pminmax2(m, q2, n2, 1, 1, 1)
    if op is 61
        return x_pminmax2(m, q2, n2, 4, 1, 1)
    if op is 62
        return x_pminmax2(m, q2, n2, 2, 1, 0)
    if op is 63
        return x_pminmax2(m, q2, n2, 4, 1, 0)
    if op is 64
        return x_pmulld(m, q2, n2)
    if op is 28
        return x_pabs(m, q2, n2, 1)
    if op is 29
        return x_pabs(m, q2, n2, 2)
    if op is 30
        return x_pabs(m, q2, n2, 4)

    # the AES round instructions
    if op is 219
        return x_aesimc(m, q2, n2)
    if op is 220
        return x_aesenc(m, q2, n2)
    if op is 221
        return x_aesenclast(m, q2, n2)
    if op is 222
        return x_aesdec(m, q2, n2)
    if op is 223
        return x_aesdeclast(m, q2, n2)
    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, 14336 + op)
    return 0

x_vec3a m p n rex size:
    op: x_r8(m, p)
    q2: x_modrm(m, p + 1, rex, 0)
    n2: x_md_reg(m)
    # the four string instructions. A is always xmm1, B is the rm
    # operand, and the reg field is not an operand: the index goes to
    # ecx and the mask to xmm0 whatever it says.
    # the parameters travel in spare machine slots: the compiler
    # passes the arguments of a call through the same scratch it
    # keeps locals in, and a call from here with five values came
    # out with the third and fourth corrupted. Two values are safe.
    poke_i64(m, 640, x_r8(m, q2))
    if op is 96
        poke_i64(m, 648, 1)
        poke_i64(m, 656, 0)
        return x_pcmpstr(m, q2)
    if op is 97
        poke_i64(m, 648, 1)
        poke_i64(m, 656, 1)
        return x_pcmpstr(m, q2)
    if op is 98
        poke_i64(m, 648, 0)
        poke_i64(m, 656, 0)
        return x_pcmpstr(m, q2)
    if op is 99
        poke_i64(m, 648, 0)
        poke_i64(m, 656, 1)
        return x_pcmpstr(m, q2)
    # the carry-less multiply, and the round key helper. Both carry
    # a number of their own.
    if op is 68
        im44: x_r8(m, q2)
        return x_pclmulqdq(m, q2 + 1, n2, im44)
    if op is 223
        imdf: x_r8(m, q2)
        return x_aeskeygenassist(m, q2 + 1, n2, imdf)
    im: x_r8(m, q2)
    q3: q2 + 1
    if op is 8
        return x_roundp(m, q3, n2, 1, im)
    if op is 9
        return x_roundp(m, q3, n2, 8, im)
    if op is 10
        return x_roundp(m, q3, n2, 2, im)
    if op is 11
        return x_roundp(m, q3, n2, 4, im)
    if op is 14
        return x_pblendw(m, q3, n2, im)
    if op is 15
        return x_palignr(m, q3, n2, im)
    if op is 20
        return x_pextr(m, q3, n2, im, 1, rex)
    if op is 21
        return x_pextr(m, q3, n2, im, 2, rex)
    if op is 22
        return x_pextr(m, q3, n2, im, 4, rex)
    if op is 23
        return x_pextr(m, q3, n2, im, 4, 0)
    if op is 32
        return x_pinsr(m, q3, n2, im, 1, rex)
    if op is 33
        return x_insertps(m, q3, n2, im)
    if op is 34
        return x_pinsr(m, q3, n2, im, 4, rex)
    if op is 64
        return x_dpps(m, q3, n2, im)
    if op is 65
        return x_dppd(m, q3, n2, im)
    poke_i64(m, 168, X_BADOP)
    poke_i64(m, 232, 14848 + op)
    return 0

# shuffle the bytes of one register by the low nibbles of another,
# with the top bit meaning nought. 38 00.
x_pshufb m q n:
    rmi: peek_i64(m, 376)
    lo: 0
    hi: 0
    i: 0
    as long as i < 16
        ix: x_xbyte(m, rmi, i)
        b: 0
        if ix < 128
            b: x_xbyte(m, n, x_and(ix, 15))
        if i < 8
            lo: x_or(lo, x_shl64(b, i * 8))
        if not
            hi: x_or(hi, x_shl64(b, (i - 8) * 8))
        i: i + 1
    x_xset(m, n, lo, hi)
    return x_go(m, q)

# add or take away the pieces in pairs, across both halves of each
# operand. sat 1 holds a word sum at the signed ends.
x_phadd m q n w sub sat:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_phadd_half(al, ah, w, sub, sat), x_phadd_half(bl, bh, w, sub, sat))
    return x_go(m, q)

x_phadd_half a b w sub sat:
    r: 0
    p: 0
    as long as p < 8 / w / 2
        a1: x_sval(x_mask(x_shr64(a, p * w * 16), w), w)
        a2: x_sval(x_mask(x_shr64(a, p * w * 16 + w * 8), w), w)
        k: a1 + a2
        if sub is 1
            k: a1 - a2
        if sat is 1
            if k > 32767
                k: 32767
            if k < 0 - 32768
                k: 0 - 32768
        r: x_or(r, x_shl64(x_mask(k, w), p * w * 8))
        p: p + 1
    q: 0
    as long as q < 8 / w / 2
        b1: x_sval(x_mask(x_shr64(b, q * w * 16), w), w)
        b2: x_sval(x_mask(x_shr64(b, q * w * 16 + w * 8), w), w)
        k: b1 + b2
        if sub is 1
            k: b1 - b2
        if sat is 1
            if k > 32767
                k: 32767
            if k < 0 - 32768
                k: 0 - 32768
        r: x_or(r, x_shl64(x_mask(k, w), (q + 8 / w / 2) * w * 8))
        q: q + 1
    return r

# unsigned bytes of one times signed bytes of the other, added in
# pairs and held at the signed ends. 38 04.
x_pmaddubsw m q n:
    rmi: peek_i64(m, 376)
    lo: 0
    hi: 0
    i: 0
    as long as i < 8
        u0: x_xbyte(m, n, i * 2)
        s0: x_sval(x_xbyte(m, rmi, i * 2), 1)
        u1: x_xbyte(m, n, i * 2 + 1)
        s1: x_sval(x_xbyte(m, rmi, i * 2 + 1), 1)
        k: u0 * s0 + u1 * s1
        if k > 32767
            k: 32767
        if k < 0 - 32768
            k: 0 - 32768
        if i < 4
            lo: x_or(lo, x_shl64(x_mask(k, 2), i * 16))
        if not
            hi: x_or(hi, x_shl64(x_mask(k, 2), (i - 4) * 16))
        i: i + 1
    x_xset(m, n, lo, hi)
    return x_go(m, q)

# keep, nought, or negate each piece, as the sign of the other says.
x_psign m q n w:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_psign_half(al, bl, w), x_psign_half(ah, bh, w))
    return x_go(m, q)

x_psign_half a b w:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(a, i * w * 8), w)
        s: x_sval(x_mask(x_shr64(b, i * w * 8), w), w)
        k: pa
        if s < 0
            k: x_sub(0, pa)
        if s is 0
            k: 0
        r: x_or(r, x_shl64(x_mask(k, w), i * w * 8))
        i: i + 1
    return r

# each word times each word, the middle fifteen bits. 38 0B.
x_pmulhrsw m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_pmulhrsw_half(al, bl), x_pmulhrsw_half(ah, bh))
    return x_go(m, q)

x_pmulhrsw_half a b:
    r: 0
    i: 0
    as long as i < 4
        pa: x_sval(x_mask(x_shr64(a, i * 16), 2), 2)
        pb: x_sval(x_mask(x_shr64(b, i * 16), 2), 2)
        k: x_sar64(pa * pb + 16384, 15)
        r: x_or(r, x_shl64(x_mask(k, 2), i * 16))
        i: i + 1
    return r

# take the sign off every piece of the source. 38 1C 1D 1E.
x_pabs m q n w:
    b0: x_xrm_lo(m)
    b1: x_xrm_hi(m)
    x_xset(m, n, x_pabs_half(b0, w), x_pabs_half(b1, w))
    return x_go(m, q)

x_pabs_half v w:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_sval(x_mask(x_shr64(v, i * w * 8), w), w)
        k: pa
        if k < 0
            k: x_sub(0, k)
        r: x_or(r, x_shl64(x_mask(k, w), i * w * 8))
        i: i + 1
    return r

# blend the pieces of two registers by the bits of the number, or by
# the top bit of each byte of the implicit third one.
x_pblendps m q n:
    im: x_r8(m, q)
    return x_pblend_imm(m, q + 1, n, im, 4, 0)

x_pblendpd m q n:
    im: x_r8(m, q)
    return x_pblend_imm(m, q + 1, n, im, 8, 0)

x_pblendw m q n im:
    return x_pblend_imm(m, q, n, im, 2, 0)

x_pblend_imm m q n im w isbyte:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    rlo: 0
    rhi: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(al, i * w * 8), w)
        pb: x_mask(x_shr64(bl, i * w * 8), w)
        k: pa
        if x_and(x_shr64(im, i), 1) is 1
            k: pb
        rlo: x_or(rlo, x_shl64(k, i * w * 8))
        i: i + 1
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(ah, i * w * 8), w)
        pb: x_mask(x_shr64(bh, i * w * 8), w)
        k: pa
        if x_and(x_shr64(im, i + 8 / w), 1) is 1
            k: pb
        rhi: x_or(rhi, x_shl64(k, i * w * 8))
        i: i + 1
    x_xset(m, n, rlo, rhi)
    return x_go(m, q)

x_pblendvb m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    rlo: 0
    rhi: 0
    i: 0
    as long as i < 16
        pa: x_xbyte(m, n, i)
        pb: x_xbyte(m, peek_i64(m, 376), i)
        k: pa
        if x_xbyte(m, 0, i) >= 128
            k: pb
        if i < 8
            rlo: x_or(rlo, x_shl64(k, i * 8))
        if not
            rhi: x_or(rhi, x_shl64(k, (i - 8) * 8))
        i: i + 1
    x_xset(m, n, rlo, rhi)
    return x_go(m, q)

# test the AND and the AND-NOT of two registers, and set the flags
# the way a branch wants. 38 17.
x_ptest m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    ab: x_or(x_and(al, bl), x_and(ah, bh))
    anb: x_or(x_and(al, x_not(bl)), x_and(ah, x_not(bh)))
    if ab is 0
        poke_i64(m, 136, 1)
    if not
        poke_i64(m, 136, 0)
    if anb is 0
        poke_i64(m, 152, 1)
    if not
        poke_i64(m, 152, 0)
    poke_i64(m, 144, 0)
    poke_i64(m, 160, 0)
    poke_i64(m, 328, 0)
    poke_i64(m, 344, 0)
    return x_go(m, q)

# every eight bytes the same, or ordered. 38 29 and 38 37.
x_pcmpeqq m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    a: 0
    b: 0
    if al is bl
        a: 0 - 1
    if ah is bh
        b: 0 - 1
    x_xset(m, n, a, b)
    return x_go(m, q)

x_pcmpgtq m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    a: 0
    b: 0
    if al > bl
        a: 0 - 1
    if ah > bh
        b: 0 - 1
    x_xset(m, n, a, b)
    return x_go(m, q)

# four whole numbers down to four words, holding at the ends. The
# words are taken as signed; nought and the top are the ends.
x_packusdw m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_or(x_packusdw_half(al), x_shl64(x_packusdw_half(ah), 32)), x_or(x_packusdw_half(bl), x_shl64(x_packusdw_half(bh), 32)))
    return x_go(m, q)

x_packusdw_half v:
    r: 0
    i: 0
    as long as i < 2
        pa: x_sval(x_mask(x_shr64(v, i * 32), 4), 4)
        k: pa
        if k < 0
            k: 0
        if k > 65535
            k: 65535
        r: x_or(r, x_shl64(k, i * 16))
        i: i + 1
    return r

# the smaller or larger of every piece, signed or not. big 1 is the
# larger, sgn 1 treats the pieces as signed.
x_pminmax2 m q n w big sgn:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_pminmax2_half(al, bl, w, big, sgn), x_pminmax2_half(ah, bh, w, big, sgn))
    return x_go(m, q)

x_pminmax2_half a b w big sgn:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(a, i * w * 8), w)
        pb: x_mask(x_shr64(b, i * w * 8), w)
        if sgn is 1
            pa: x_sval(pa, w)
            pb: x_sval(pb, w)
        k: pa
        if big is 1
            if pb > pa
                k: pb
        if not
            if pb < pa
                k: pb
        r: x_or(r, x_shl64(x_mask(k, w), i * w * 8))
        i: i + 1
    return r

# the low half of every whole number times every whole number. 38 40.
x_pmulld m q n:
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    x_xset(m, n, x_pmulld_half(al, bl), x_pmulld_half(ah, bh))
    return x_go(m, q)

x_pmulld_half a b:
    r: 0
    i: 0
    as long as i < 2
        pa: x_mask(x_shr64(a, i * 32), 4)
        pb: x_mask(x_shr64(b, i * 32), 4)
        k: x_mask(pa * pb, 4)
        r: x_or(r, x_shl64(k, i * 32))
        i: i + 1
    return r

# round every piece, or one piece, to a whole number. 3A 08 09 0A 0B.
# The number's low two bits choose the way, and the mask bits say
# which pieces are left alone.
x_roundp m q n w im:
    mode: x_and(im, 3)
    if w is 1
        al: x_xlo(m, n)
        ah: x_xhi(m, n)
        bl: x_xrm_lo(m)
        bh: x_xrm_hi(m)
        m0: x_and(x_shr64(im, 4), 1)
        m1: x_and(x_shr64(im, 5), 1)
        rlo: al
        rhi: ah
        if m0 is 0
            rlo: x_or(x_mask(x_round_s(m, x_mask(bl, 4), mode), 4), x_shl64(x_round_s(m, x_shr64(bl, 32), mode), 32))
        if m1 is 0
            rhi: x_or(x_mask(x_round_s(m, x_mask(bh, 4), mode), 4), x_shl64(x_round_s(m, x_shr64(bh, 32), mode), 32))
        x_xset(m, n, rlo, rhi)
        return x_go(m, q)
    if w is 8
        m0: x_and(x_shr64(im, 4), 1)
        m1: x_and(x_shr64(im, 5), 1)
        rlo: x_xlo(m, n)
        rhi: x_xhi(m, n)
        if m0 is 0
            rlo: x_round_d(m, x_xrm_lo(m), mode)
        if m1 is 0
            rhi: x_round_d(m, x_xrm_hi(m), mode)
        x_xset(m, n, rlo, rhi)
        return x_go(m, q)
    if w is 2
        m0: x_and(x_shr64(im, 4), 1)
        bl: x_xrm_lo(m)
        keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
        if m0 is 0
            x_xset(m, n, x_add(keep, x_mask(x_round_s(m, x_mask(bl, 4), mode), 4)), x_xhi(m, n))
        if not
            x_xset(m, n, x_xlo(m, n), x_xhi(m, n))
        return x_go(m, q)
    m0: x_and(x_shr64(im, 4), 1)
    if m0 is 0
        x_xset(m, n, x_round_d(m, x_xrm_lo(m), mode), x_xhi(m, n))
    if not
        x_xset(m, n, x_xlo(m, n), x_xhi(m, n))
    return x_go(m, q)

# line the two registers up and shift the joined row right by the
# number of bytes in the instruction. 3A 0F.
x_palignr m q n im:
    rmi: peek_i64(m, 376)
    lo: 0
    hi: 0
    i: 0
    as long as i < 16
        j: i + im
        b: 0
        if j < 16
            b: x_xbyte(m, rmi, j)
        if not
            if j < 32
                b: x_xbyte(m, n, j - 16)
        if i < 8
            lo: x_or(lo, x_shl64(b, i * 8))
        if not
            hi: x_or(hi, x_shl64(b, (i - 8) * 8))
        i: i + 1
    x_xset(m, n, lo, hi)
    return x_go(m, q)

# take one piece out of a vector register into a plain register or
# memory. 3A 14 15 16 17. A register that small is filled up with
# noughts, as the hardware does.
x_pextr m q n im w rex:
    rmi: peek_i64(m, 376)
    v: 0
    if w is 1
        v: x_xbyte(m, n, x_and(im, 15))
    if w is 2
        lane: x_and(im, 7)
        t: x_xlo(m, n)
        if lane >= 4
            t: x_xhi(m, n)
        v: x_mask(x_shr64(t, (lane % 4) * 16), 2)
    if w is 4
        if x_and(rex, 8) is 8
            v: x_xlo(m, n)
            if x_and(im, 1) is 1
                v: x_xhi(m, n)
        if not
            lane: x_and(im, 3)
            t: x_xlo(m, n)
            if lane >= 2
                t: x_xhi(m, n)
            v: x_mask(x_shr64(t, (lane % 2) * 32), 4)
    if peek_i64(m, 360) is 1
        if x_and(rex, 8) is 8
            x_rset(m, rmi, 8, v)
        if not
            x_rset(m, rmi, 4, v)
    if not
        if w is 1
            x_w8(m, rmi, v)
        if w is 2
            x_w16(m, rmi, v)
        if w is 4
            if x_and(rex, 8) is 8
                x_w64(m, rmi, v)
            if not
                x_w32(m, rmi, v)
    return x_go(m, q)

# put a piece from a plain register or memory into a vector one.
# 3A 20 22, and 0F C4 for the word.
x_pinsr m q n im w rex:
    rmi: peek_i64(m, 376)
    v: 0
    if peek_i64(m, 360) is 1
        if w is 1
            v: x_mask(x_reg(m, rmi), 1)
        if not
            if x_and(rex, 8) is 8
                v: x_reg(m, rmi)
            if not
                v: x_mask(x_reg(m, rmi), 4)
    if not
        if w is 1
            v: x_mask(x_load(m, rmi, 1), 1)
        if not
            v: x_load(m, rmi, 8)
    if w is 1
        # only the one byte changes; the rest of the word it sits in
        # is left alone, as the hardware does
        lane: x_and(im, 15)
        t: x_xlo(m, n)
        if lane >= 8
            t: x_xhi(m, n)
        keep: x_sub(t, x_shl64(x_mask(x_shr64(t, (lane % 8) * 8), 1), (lane % 8) * 8))
        t2: x_add(keep, x_shl64(x_mask(v, 1), (lane % 8) * 8))
        if lane >= 8
            x_xset(m, n, x_xlo(m, n), t2)
        if not
            x_xset(m, n, t2, x_xhi(m, n))
    if not
        lane: x_and(im, 1)
        if x_and(rex, 8) is 8
            if lane is 1
                x_xset(m, n, x_xlo(m, n), v)
            if not
                x_xset(m, n, v, x_xhi(m, n))
        if not
            lane: x_and(im, 3)
            t: x_xlo(m, n)
            if lane >= 2
                t: x_xhi(m, n)
            keep: x_sub(t, x_shl64(x_mask(x_shr64(t, (lane % 2) * 32), 4), (lane % 2) * 32))
            t2: x_add(keep, x_shl64(x_mask(v, 4), (lane % 2) * 32))
            if lane >= 2
                x_xset(m, n, x_xlo(m, n), t2)
            if not
                x_xset(m, n, t2, x_xhi(m, n))
    return x_go(m, q)

# move one narrow piece about inside a vector register. 3A 21.
x_insertps m q n im:
    rmi: peek_i64(m, 376)
    src: x_and(x_shr64(im, 6), 3)
    dst: x_and(x_shr64(im, 4), 3)
    v: 0
    if src is not 3
        t: x_xlo(m, rmi)
        if src >= 2
            t: x_xhi(m, rmi)
        v: x_mask(x_shr64(t, (src % 2) * 32), 4)
    rlo: x_xlo(m, n)
    rhi: x_xhi(m, n)
    i: 0
    as long as i < 4
        if x_and(x_shr64(im, i), 1) is 1
            if i < 2
                keep: x_sub(rlo, x_shl64(x_mask(x_shr64(rlo, i * 32), 4), i * 32))
                rlo: x_add(keep, 0)
            if not
                keep: x_sub(rhi, x_shl64(x_mask(x_shr64(rhi, (i - 2) * 32), 4), (i - 2) * 32))
                rhi: x_add(keep, 0)
        i: i + 1
    if dst < 2
        keep: x_sub(rlo, x_shl64(x_mask(x_shr64(rlo, dst * 32), 4), dst * 32))
        rlo: x_add(keep, x_shl64(v, dst * 32))
    if not
        keep: x_sub(rhi, x_shl64(x_mask(x_shr64(rhi, (dst - 2) * 32), 4), (dst - 2) * 32))
        rhi: x_add(keep, x_shl64(v, (dst - 2) * 32))
    x_xset(m, n, rlo, rhi)
    return x_go(m, q)

# the pieces multiplied in pairs and added, keeping the chosen ones.
# 3A 40 is four narrow ones, 3A 41 is two wide ones.
x_dpps m q n im:
    # the four high bits of the number pick which products are
    # added; the four low bits pick which pieces of the answer get
    # the sum. The other way round would be a quiet wrong answer,
    # checked against a real processor.
    al: x_xlo(m, n)
    ah: x_xhi(m, n)
    bl: x_xrm_lo(m)
    bh: x_xrm_hi(m)
    p0: x_fmul(m, x_f2d(m, x_mask(al, 4)), x_f2d(m, x_mask(bl, 4)))
    p1: x_fmul(m, x_f2d(m, x_shr64(al, 32)), x_f2d(m, x_shr64(bl, 32)))
    p2: x_fmul(m, x_f2d(m, x_mask(ah, 4)), x_f2d(m, x_mask(bh, 4)))
    p3: x_fmul(m, x_f2d(m, x_shr64(ah, 32)), x_f2d(m, x_shr64(bh, 32)))
    s: x_i2d(m, 0)
    if x_and(x_shr64(im, 4), 1) is 1
        s: x_fadd(m, s, p0)
    if x_and(x_shr64(im, 5), 1) is 1
        s: x_fadd(m, s, p1)
    if x_and(x_shr64(im, 6), 1) is 1
        s: x_fadd(m, s, p2)
    if x_and(x_shr64(im, 7), 1) is 1
        s: x_fadd(m, s, p3)
    f: x_d2f(m, s)
    rlo: 0
    rhi: 0
    if x_and(im, 1) is 1
        rlo: x_or(rlo, f)
    if x_and(im, 2) is 1
        rlo: x_or(rlo, x_shl64(f, 32))
    if x_and(im, 4) is 1
        rhi: x_or(rhi, f)
    if x_and(im, 8) is 1
        rhi: x_or(rhi, x_shl64(f, 32))
    x_xset(m, n, rlo, rhi)
    return x_go(m, q)

x_dppd m q n im:
    p0: x_fmul(m, x_xlo(m, n), x_xrm_lo(m))
    p1: x_fmul(m, x_xhi(m, n), x_xrm_hi(m))
    s: x_i2d(m, 0)
    if x_and(x_shr64(im, 4), 1) is 1
        s: x_fadd(m, s, p0)
    if x_and(x_shr64(im, 5), 1) is 1
        s: x_fadd(m, s, p1)
    rlo: 0
    rhi: 0
    if x_and(im, 1) is 1
        rlo: s
    if x_and(im, 2) is 1
        rhi: s
    x_xset(m, n, rlo, rhi)
    return x_go(m, q)

# one element of a vector register, counted from the bottom. w is
# one or two bytes.
x_sel m reg i w:
    if w is 1
        return x_xbyte(m, reg, i)
    t: x_xlo(m, reg)
    if i < 4
        return x_mask(x_shr64(t, i * 16), 2)
    t2: x_xhi(m, reg)
    return x_mask(x_shr64(t2, (i - 4) * 16), 2)

# where a string ends: the first zero element
x_elen m reg w N:
    i: 0
    as long as i < N
        if x_sel(m, reg, i, w) is 0
            return i
        i: i + 1
    return N

# compare two strings, as the SSE4.2 instructions do. explicit says
# the lengths are in eax and edx; without it the strings end at the
# first zero. wantidx says the answer is an index (in ecx) rather
# than a mask (in xmm0).
x_pcmpstr m q:
    # compare two strings, as the SSE4.2 instructions do. The result
    # is per element of the SECOND string (the reg/mem operand), and
    # the lengths are eax/edx when explicit or at the first zero
    # when not. The reg field of the modrm is not an operand: the
    # index goes to ecx and the mask to xmm0 whatever it says.
    explicit: peek_i64(m, 648)
    wantidx: peek_i64(m, 656)
    im: peek_i64(m, 640)
    dt: x_and(im, 3)
    agg: x_and(x_shr64(im, 2), 3)
    pol: x_and(x_shr64(im, 4), 1)
    bit5: x_and(x_shr64(im, 5), 1)
    idxsel: x_and(x_shr64(im, 6), 1)
    w: 1
    if dt is 1
        w: 2
    if dt is 3
        w: 2
    signed: 0
    if dt >= 2
        signed: 1
    N: 16 / w
    src: peek_i64(m, 376)
    lenA: 0
    lenB: 0
    if explicit is 1
        lenA: x_reg(m, 0)
        if lenA < 0
            lenA: x_sub(0, lenA)
        if lenA > N
            lenA: N
        lenB: x_reg(m, 2)
        if lenB < 0
            lenB: x_sub(0, lenB)
        if lenB > N
            lenB: N
    if not
        lenA: x_elen(m, 1, w, N)
        lenB: x_elen(m, src, w, N)
    r1: 0
    j: 0
    as long as j < N
        ok: 0
        if agg is 0
            # equal any: B[j] equals some A[i], both inside
            if j < lenB
                bj: x_sel(m, src, j, w)
                i: 0
                as long as i < lenA
                    ai: x_sel(m, 1, i, w)
                    if bj is ai
                        ok: 1
                    i: i + 1
        if agg is 1
            # ranges: B[j] inside any pair of A, both ends inside
            if j < lenB
                k: 0
                as long as k * 2 + 1 < lenA
                    lo2: x_sel(m, 1, k * 2, w)
                    hi2: x_sel(m, 1, k * 2 + 1, w)
                    v: x_sel(m, src, j, w)
                    if signed is 1
                        lo2: x_sval(lo2, w)
                        hi2: x_sval(hi2, w)
                        v: x_sval(v, w)
                    if v >= lo2
                        if v <= hi2
                            ok: 1
                    k: k + 1
        if agg is 2
            # equal each: B[j] equals A[j]. A pair with both ends
            # outside is forced true, any other half-outside pair
            # forced false.
            if j < lenB
                if j < lenA
                    bj: x_sel(m, src, j, w)
                    aj: x_sel(m, 1, j, w)
                    if bj is aj
                        ok: 1
            if not
                if j >= lenA
                    ok: 1
        if agg is 3
            # equal ordered: B starting at j matches A from the
            # start. Where A runs out the pair is forced true, and
            # where B runs out first it is forced false.
            ok: 1
            t: 0
            as long as t < N - j
                if t < lenA
                    if j + t < lenB
                        bt: x_sel(m, src, j + t, w)
                        at: x_sel(m, 1, t, w)
                        if bt is not at
                            ok: 0
                    if not
                        ok: 0
                t: t + 1
        if pol is 1
            if bit5 is 1
                # masked: turn over only the bits inside B
                if j < lenB
                    if ok is 1
                        ok: 0
                    if not
                        ok: 1
            if not
                if ok is 1
                    ok: 0
                if not
                    ok: 1
        if ok is 1
            r1: x_or(r1, x_shl64(1, j))
        j: j + 1
    cf: 0
    if r1 is not 0
        cf: 1
    poke_i64(m, 152, cf)
    poke_i64(m, 160, x_bit(r1, 0))
    poke_i64(m, 328, 0)
    poke_i64(m, 344, 0)
    zf: 0
    sf: 0
    if explicit is 1
        # set when the length handed in is below the full width
        ea: x_reg(m, 0)
        ed: x_reg(m, 2)
        if ea < 0
            ea: x_sub(0, ea)
        if ed < 0
            ed: x_sub(0, ed)
        if ed < N
            zf: 1
        if ea < N
            sf: 1
    if not
        # set when the register holds a zero element anywhere
        if x_elen(m, src, w, N) < N
            zf: 1
        if x_elen(m, 1, w, N) < N
            sf: 1
    poke_i64(m, 136, zf)
    poke_i64(m, 144, sf)
    if wantidx is 1
        # the first or last set bit, or the full width when none
        ix: N
        if idxsel is 0
            i: 0
            as long as i < N
                if x_bit(r1, i) is 1
                    ix: i
                    i: N
                i: i + 1
        if not
            i: N - 1
            as long as i >= 0
                if x_bit(r1, i) is 1
                    ix: i
                    i: 0 - 1
                i: i - 1
        x_rset(m, 1, 8, ix)
    if not
        # the mask: the number itself, or one whole piece per bit
        if idxsel is 0
            x_xset(m, 0, r1, 0)
        if not
            rlo: 0
            rhi: 0
            i: 0
            as long as i < N
                e: 0
                if x_bit(r1, i) is 1
                    e: x_ones(w)
                if w is 1
                    if i < 8
                        rlo: x_or(rlo, x_shl64(e, i * 8))
                    if not
                        rhi: x_or(rhi, x_shl64(e, (i - 8) * 8))
                if not
                    if i < 4
                        rlo: x_or(rlo, x_shl64(e, i * 16))
                    if not
                        rhi: x_or(rhi, x_shl64(e, (i - 4) * 16))
                i: i + 1
            x_xset(m, 0, rlo, rhi)
    # the instruction is six bytes long: the imm byte is still
    # to be stepped over
    return x_go(m, q + 1)



# ---- AES ----
# The AES-NI instructions, done in whole numbers. The field is
# GF(2^8) with the usual polynomial, and a byte is a number from
# nought to two hundred and fifty-five.

# multiply in the field
x_gf_mul a b:
    r: 0
    i: 0
    as long as i < 8
        if x_and(a, 1) is 1
            r: x_xor(r, b)
        h: x_and(b, 128)
        b: x_and(x_shl64(b, 1), 255)
        if h is not 0
            b: x_xor(b, 27)
        a: x_shr64(a, 1)
        i: i + 1
    return r

# raise to a power, which is how the inverse is found: x^254
x_gf_pow a e:
    r: 1
    as long as e > 0
        if x_and(e, 1) is 1
            r: x_gf_mul(r, a)
        a: x_gf_mul(a, a)
        e: x_shr64(e, 1)
    return r

# one byte of the S-box: the inverse, then the affine turn
x_sbox_byte x:
    inv: x_gf_pow(x, 254)
    b1: x_or(x_shl64(inv, 1), x_shr64(inv, 7))
    b2: x_or(x_shl64(inv, 2), x_shr64(inv, 6))
    b3: x_or(x_shl64(inv, 3), x_shr64(inv, 5))
    b4: x_or(x_shl64(inv, 4), x_shr64(inv, 4))
    s: x_xor(x_xor(x_xor(x_xor(inv, b1), b2), b3), x_xor(b4, 99))
    return x_and(s, 255)

# look a byte up in the S-box, or the inverse one
x_sb m b:
    return peek_byte(peek_i64(m, 704), b)

x_isb m b:
    return peek_byte(peek_i64(m, 704) + 256, b)

# one byte of a vector register
x_xbyte_set m n i v:
    x: peek_i64(m, 488)
    poke_byte(x, n * 32 + i, v)
    return 0

# the rows of the state, moved round. inv does it the other way.
x_ashift m n inv:
    tlo: 0
    thi: 0
    i: 0
    as long as i < 16
        r: i % 4
        c: i / 4
        sc: c + r
        if inv is 1
            sc: c + 4 - r
        sc: sc % 4
        s: x_xbyte(m, n, r + 4 * sc)
        if i < 8
            tlo: x_or(tlo, x_shl64(s, i * 8))
        if not
            thi: x_or(thi, x_shl64(s, (i - 8) * 8))
        i: i + 1
    x_xset(m, n, tlo, thi)
    return 0

# the S-box, or its inverse, over every byte of the state
x_asubs m n inv:
    # every call here is one-argument, with the rest of the values
    # in machine slots: the compiler loses the first call's answer
    # when a job has several calls, and these are the hottest jobs
    # in the cipher
    poke_i64(m, 920, n)
    i: 0
    as long as i < 16
        poke_i64(m, 928, i)
        b: x_xbyte1(m)
        poke_i64(m, 944, b)
        if inv is 1
            s: x_isb1(m)
        if not
            s: x_sb1(m)
        poke_i64(m, 936, s)
        x_xbyte_set1(m)
        i: i + 1
    return 0

# one byte of a vector register, by slots
x_xbyte1 m:
    return x_xbyte(m, peek_i64(m, 920), peek_i64(m, 928))

# one byte written, by slots
x_xbyte_set1 m:
    return x_xbyte_set(m, peek_i64(m, 920), peek_i64(m, 928), peek_i64(m, 936))

# a byte of the S-box, or its inverse, by slots
x_sb1 m:
    return peek_byte(peek_i64(m, 704), peek_i64(m, 944))

x_isb1 m:
    return peek_byte(x_add(peek_i64(m, 704), 256), peek_i64(m, 944))

# multiply in the field, by slots
x_gf_mul1 m:
    return x_gf_mul(peek_i64(m, 976), peek_i64(m, 944))

# exclusive or, by slots
x_xor1 m:
    return x_xor(peek_i64(m, 984), peek_i64(m, 992))


x_amix m n inv:
    # the four bytes of a column sit next to each other: the first
    # four bytes of the state are column nought, the next four are
    # column one, and so on. Every call is one-argument, with its
    # values in the machine slots, so the compiler cannot lose the
    # first answer of a busy job.
    poke_i64(m, 920, n)
    i: 0
    as long as i < 4
        poke_i64(m, 928, i * 4)
        a0: x_xbyte1(m)
        poke_i64(m, 928, i * 4 + 1)
        a1: x_xbyte1(m)
        poke_i64(m, 928, i * 4 + 2)
        a2: x_xbyte1(m)
        poke_i64(m, 928, i * 4 + 3)
        a3: x_xbyte1(m)
        if inv is 1
            poke_i64(m, 976, 14)
            poke_i64(m, 944, a0)
            p0: x_gf_mul1(m)
            poke_i64(m, 976, 11)
            poke_i64(m, 944, a1)
            p1: x_gf_mul1(m)
            poke_i64(m, 976, 13)
            poke_i64(m, 944, a2)
            p2: x_gf_mul1(m)
            poke_i64(m, 976, 9)
            poke_i64(m, 944, a3)
            p3: x_gf_mul1(m)
            poke_i64(m, 984, p0)
            poke_i64(m, 992, p1)
            b0: x_xor1(m)
            poke_i64(m, 984, b0)
            poke_i64(m, 992, p2)
            b0: x_xor1(m)
            poke_i64(m, 984, b0)
            poke_i64(m, 992, p3)
            b0: x_xor1(m)
            poke_i64(m, 976, 9)
            poke_i64(m, 944, a0)
            p0: x_gf_mul1(m)
            poke_i64(m, 976, 14)
            poke_i64(m, 944, a1)
            p1: x_gf_mul1(m)
            poke_i64(m, 976, 11)
            poke_i64(m, 944, a2)
            p2: x_gf_mul1(m)
            poke_i64(m, 976, 13)
            poke_i64(m, 944, a3)
            p3: x_gf_mul1(m)
            poke_i64(m, 984, p0)
            poke_i64(m, 992, p1)
            b1: x_xor1(m)
            poke_i64(m, 984, b1)
            poke_i64(m, 992, p2)
            b1: x_xor1(m)
            poke_i64(m, 984, b1)
            poke_i64(m, 992, p3)
            b1: x_xor1(m)
            poke_i64(m, 976, 13)
            poke_i64(m, 944, a0)
            p0: x_gf_mul1(m)
            poke_i64(m, 976, 9)
            poke_i64(m, 944, a1)
            p1: x_gf_mul1(m)
            poke_i64(m, 976, 14)
            poke_i64(m, 944, a2)
            p2: x_gf_mul1(m)
            poke_i64(m, 976, 11)
            poke_i64(m, 944, a3)
            p3: x_gf_mul1(m)
            poke_i64(m, 984, p0)
            poke_i64(m, 992, p1)
            b2: x_xor1(m)
            poke_i64(m, 984, b2)
            poke_i64(m, 992, p2)
            b2: x_xor1(m)
            poke_i64(m, 984, b2)
            poke_i64(m, 992, p3)
            b2: x_xor1(m)
            poke_i64(m, 976, 11)
            poke_i64(m, 944, a0)
            p0: x_gf_mul1(m)
            poke_i64(m, 976, 13)
            poke_i64(m, 944, a1)
            p1: x_gf_mul1(m)
            poke_i64(m, 976, 9)
            poke_i64(m, 944, a2)
            p2: x_gf_mul1(m)
            poke_i64(m, 976, 14)
            poke_i64(m, 944, a3)
            p3: x_gf_mul1(m)
            poke_i64(m, 984, p0)
            poke_i64(m, 992, p1)
            b3: x_xor1(m)
            poke_i64(m, 984, b3)
            poke_i64(m, 992, p2)
            b3: x_xor1(m)
            poke_i64(m, 984, b3)
            poke_i64(m, 992, p3)
            b3: x_xor1(m)
        if not
            poke_i64(m, 976, 2)
            poke_i64(m, 944, a0)
            p0: x_gf_mul1(m)
            poke_i64(m, 976, 3)
            poke_i64(m, 944, a1)
            p1: x_gf_mul1(m)
            poke_i64(m, 984, p0)
            poke_i64(m, 992, p1)
            b0: x_xor1(m)
            poke_i64(m, 984, b0)
            poke_i64(m, 992, a2)
            b0: x_xor1(m)
            poke_i64(m, 984, b0)
            poke_i64(m, 992, a3)
            b0: x_xor1(m)
            poke_i64(m, 976, 2)
            poke_i64(m, 944, a1)
            p0: x_gf_mul1(m)
            poke_i64(m, 976, 3)
            poke_i64(m, 944, a2)
            p1: x_gf_mul1(m)
            poke_i64(m, 984, a0)
            poke_i64(m, 992, p0)
            b1: x_xor1(m)
            poke_i64(m, 984, b1)
            poke_i64(m, 992, p1)
            b1: x_xor1(m)
            poke_i64(m, 984, b1)
            poke_i64(m, 992, a3)
            b1: x_xor1(m)
            poke_i64(m, 976, 2)
            poke_i64(m, 944, a2)
            p0: x_gf_mul1(m)
            poke_i64(m, 976, 3)
            poke_i64(m, 944, a3)
            p1: x_gf_mul1(m)
            poke_i64(m, 984, a0)
            poke_i64(m, 992, a1)
            b2: x_xor1(m)
            poke_i64(m, 984, b2)
            poke_i64(m, 992, p0)
            b2: x_xor1(m)
            poke_i64(m, 984, b2)
            poke_i64(m, 992, p1)
            b2: x_xor1(m)
            poke_i64(m, 976, 3)
            poke_i64(m, 944, a0)
            p0: x_gf_mul1(m)
            poke_i64(m, 976, 2)
            poke_i64(m, 944, a3)
            p1: x_gf_mul1(m)
            poke_i64(m, 984, p0)
            poke_i64(m, 992, a1)
            b3: x_xor1(m)
            poke_i64(m, 984, b3)
            poke_i64(m, 992, a2)
            b3: x_xor1(m)
            poke_i64(m, 984, b3)
            poke_i64(m, 992, p1)
            b3: x_xor1(m)
        poke_i64(m, 928, i * 4)
        poke_i64(m, 936, b0)
        x_xbyte_set1(m)
        poke_i64(m, 928, i * 4 + 1)
        poke_i64(m, 936, b1)
        x_xbyte_set1(m)
        poke_i64(m, 928, i * 4 + 2)
        poke_i64(m, 936, b2)
        x_xbyte_set1(m)
        poke_i64(m, 928, i * 4 + 3)
        poke_i64(m, 936, b3)
        x_xbyte_set1(m)
        i: i + 1
    return 0

x_aesenc m q n:
    klo: x_xrm_lo(m)
    khi: x_xrm_hi(m)
    x_ashift(m, n, 0)
    x_asubs(m, n, 0)
    x_amix(m, n, 0)
    x_xset(m, n, x_xor(x_xlo(m, n), klo), x_xor(x_xhi(m, n), khi))
    return x_go(m, q)

x_aesenclast m q n:
    klo: x_xrm_lo(m)
    khi: x_xrm_hi(m)
    x_ashift(m, n, 0)
    x_asubs(m, n, 0)
    x_xset(m, n, x_xor(x_xlo(m, n), klo), x_xor(x_xhi(m, n), khi))
    return x_go(m, q)

# one round of decryption, the other way round
x_aesdec m q n:
    klo: x_xrm_lo(m)
    khi: x_xrm_hi(m)
    x_ashift(m, n, 1)
    x_asubs(m, n, 1)
    x_amix(m, n, 1)
    x_xset(m, n, x_xor(x_xlo(m, n), klo), x_xor(x_xhi(m, n), khi))
    return x_go(m, q)

x_aesdeclast m q n:
    klo: x_xrm_lo(m)
    khi: x_xrm_hi(m)
    x_ashift(m, n, 1)
    x_asubs(m, n, 1)
    x_xset(m, n, x_xor(x_xlo(m, n), klo), x_xor(x_xhi(m, n), khi))
    return x_go(m, q)

# the columns unmixed on their own, which is what a decryption round
# key needs
x_aesimc m q n:
    s0: x_xrm_lo(m)
    s1: x_xrm_hi(m)
    x_xset(m, n, s0, s1)
    x_amix(m, n, 1)
    return x_go(m, q)

# the S-box over the four bytes of a whole number
x_subword m d:
    s0: x_sb(m, x_and(d, 255))
    s1: x_sb(m, x_and(x_shr64(d, 8), 255))
    s2: x_sb(m, x_and(x_shr64(d, 16), 255))
    s3: x_sb(m, x_and(x_shr64(d, 24), 255))
    return x_or(x_or(x_or(s0, x_shl64(s1, 8)), x_shl64(s2, 16)), x_shl64(s3, 24))

# the round key helper: two of the words are S-boxed, the other two
# are S-boxed and turned round, and the whole immediate is the round
# constant
x_aeskeygenassist m q n im:
    x1: x_shr64(x_xrm_lo(m), 32)
    x3: x_shr64(x_xrm_hi(m), 32)
    rcon: x_and(im, 255)
    s1: x_subword(m, x1)
    s3: x_subword(m, x3)
    d0: s1
    d1: x_xor(x_or(x_shr64(s1, 8), x_shl64(s1, 24)), rcon)
    d2: s3
    d3: x_xor(x_or(x_shr64(s3, 8), x_shl64(s3, 24)), rcon)
    x_xset(m, n, x_or(d0, x_shl64(d1, 32)), x_or(d2, x_shl64(d3, 32)))
    return x_go(m, q)

# multiply two halves without carrying, the whole answer kept
x_pclmulqdq m q n im:
    s1: x_and(im, 1)
    s2: x_and(x_shr64(im, 4), 1)
    a: x_xlo(m, n)
    if s1 is 1
        a: x_xhi(m, n)
    b: x_xrm_lo(m)
    if s2 is 1
        b: x_xrm_hi(m)
    rlo: 0
    rhi: 0
    i: 0
    as long as i < 64
        if x_bit(a, i) is 1
            rlo: x_xor(rlo, x_shl64(b, i))
            if i is not 0
                rhi: x_xor(rhi, x_shr64(b, 64 - i))
        i: i + 1
    x_xset(m, n, rlo, rhi)
    return x_go(m, q)

x_crc32 m q n rex size eight:
    w: 1
    if eight is 0
        w: size
        if w is 2
            w: 2
    v: 0
    if eight is 1
        v: x_rm_get(m, 1)
    if not
        v: x_rm_get(m, w)
    c: x_mask(x_reg(m, n), 4)
    b: 0
    as long as b < w
        c: x_xor(c, x_mask(x_shr64(v, b * 8), 1))
        bit: 0
        as long as bit < 8
            if x_and(c, 1) is 1
                c: x_xor(x_shr64(c, 1), 2197175160)
            if not
                c: x_shr64(c, 1)
            bit: bit + 1
        b: b + 1
    if rex >= 8
        x_rset(m, n, 8, c)
    if not
        x_rset(m, n, 4, c)
    return x_go(m, q)

# load or store with the bytes turned round. The rm operand is the
# memory end; the reg field is the plain register end.
x_movbe m q n rex size eight:
    if eight is 1
        v: x_rm_get(m, size)
        o: 0
        i: 0
        as long as i < size
            o: x_or(x_shl64(o, 8), x_mask(x_shr64(v, i * 8), 1))
            i: i + 1
        x_rset(m, n, size, o)
        return x_go(m, q)
    v: x_reg(m, n)
    o: 0
    i: 0
    as long as i < size
        o: x_or(x_shl64(o, 8), x_mask(x_shr64(v, i * 8), 1))
        i: i + 1
    x_rm_set(m, size, o)
    return x_go(m, q)

# the larger of two, and the smaller. When they cannot be compared
# the hardware hands back the second one, whatever it is.
x_fmax m a b:
    c: x_fcmp(m, a, b)
    if c is 2
        return a
    return b

x_fmin m a b:
    c: x_fcmp(m, a, b)
    if c is 0
        return a
    return b

# ---- moving between whole and decimal numbers ----

x_cvt_i2f m q n pre size:
    v: 0
    if size is 8
        v: x_rm_get(m, 8)
    if not
        v: x_sval(x_rm_get(m, 4), 4)
    d: x_i2d(m, v)
    if pre is 3
        keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
        x_xset(m, n, x_add(keep, x_d2f(m, d)), x_xhi(m, n))
        return x_go(m, q)
    x_xset(m, n, d, x_xhi(m, n))
    return x_go(m, q)

x_cvt_f2i m q n pre size round:
    d: 0
    if pre is 3
        d: x_f2d(m, x_mask(x_xrm_lo(m), 4))
    if not
        d: x_xrm_lo(m)
    if round is 1
        d: x_round_d(m, d, 0)
    v: x_d2i(m, d)
    if size is 8
        x_rset(m, n, 8, v)
        return x_go(m, q)
    # a thirty-two bit answer, stretched out with the sign, as the
    # hardware does for these instructions
    x_rset(m, n, 8, x_sval(x_mask(v, 4), 4))
    return x_go(m, q)

x_cvt_ff m q n pre:
    if pre is 3
        # narrow to wide
        _v0: x_xrm_lo(m)
        _v1: x_xhi(m, n)
        x_xset(m, n, x_f2d(m, x_mask(_v0, 4)), _v1)
        return x_go(m, q)
    if pre is 2
        # wide to narrow
        keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
        _v0: x_xrm_lo(m)
        _v1: x_xhi(m, n)
        x_xset(m, n, x_add(keep, x_d2f(m, _v0)), _v1)
        return x_go(m, q)
    if pre is 1
        # two wide ones into two narrow ones
        a: x_d2f(m, x_xrm_lo(m))
        b: x_d2f(m, x_xrm_hi(m))
        x_xset(m, n, x_or(a, x_shl64(b, 32)), 0)
        return x_go(m, q)
    # two narrow ones into two wide ones
    lo: x_xrm_lo(m)
    x_xset(m, n, x_f2d(m, x_mask(lo, 4)), x_f2d(m, x_shr64(lo, 32)))
    return x_go(m, q)

# ---- comparing, the two ways ----

# the answer goes in the ordinary flags, the way a branch wants it.
# Unordered means all three of zero, parity and carry are set, which
# is how a program spots a not-a-number.
x_ucomis m q n pre:
    a: 0
    b: 0
    if pre is 1
        a: x_xlo(m, n)
        b: x_xrm_lo(m)
    if not
        a: x_f2d(m, x_mask(x_xlo(m, n), 4))
        b: x_f2d(m, x_mask(x_xrm_lo(m), 4))
    c: x_fcmp(m, a, b)
    poke_i64(m, 160, 0)
    poke_i64(m, 344, 0)
    if c is 3
        poke_i64(m, 136, 1)
        poke_i64(m, 328, 1)
        poke_i64(m, 152, 1)
        return x_go(m, q)
    poke_i64(m, 328, 0)
    if c is 1
        poke_i64(m, 136, 1)
        poke_i64(m, 152, 0)
        return x_go(m, q)
    if c is 0
        poke_i64(m, 136, 0)
        poke_i64(m, 152, 1)
        return x_go(m, q)
    poke_i64(m, 136, 0)
    poke_i64(m, 152, 0)
    return x_go(m, q)

# the answer goes in the register as all ones or all noughts
x_fcmp_mask m q n pre:
    which: x_r8(m, q)
    a: 0
    b: 0
    if pre is 2
        a: x_xlo(m, n)
        b: x_xrm_lo(m)
    if not
        a: x_f2d(m, x_mask(x_xlo(m, n), 4))
        b: x_f2d(m, x_mask(x_xrm_lo(m), 4))
    c: x_fcmp(m, a, b)
    hit: x_cmp_kind(c, which % 8)
    r: 0
    if hit is 1
        r: 0 - 1
    if pre is 2
        x_xset(m, n, r, x_xhi(m, n))
        return x_go(m, q + 1)
    keep: x_sub(x_xlo(m, n), x_mask(x_xlo(m, n), 4))
    x_xset(m, n, x_add(keep, x_mask(r, 4)), x_xhi(m, n))
    return x_go(m, q + 1)

# the eight questions a compare can ask
x_cmp_kind c which:
    if which is 0
        if c is 1
            return 1
        return 0
    if which is 1
        if c is 0
            return 1
        return 0
    if which is 2
        if c is 0
            return 1
        if c is 1
            return 1
        return 0
    if which is 3
        if c is 3
            return 1
        return 0
    if which is 4
        if c is 1
            return 0
        return 1
    if which is 5
        if c is 0
            return 0
        return 1
    if which is 6
        if c is 2
            return 1
        if c is 3
            return 1
        return 0
    if c is 3
        return 0
    return 1

# ---------------------------------------------------------------
# decimal numbers, the way the hardware keeps them
# ---------------------------------------------------------------
#
# A double is sixty-four bits: one for the sign, eleven for the
# exponent, fifty-two for the fraction. The value is
#
#     sign * 1.fraction * 2^(exponent - 1023)
#
# except when the exponent is nought, which means a very small
# number with no leading one, or all ones, which means infinity or
# not-a-number.
#
# Sovren has no decimals, so all of this is done with whole numbers.
# The fraction is carried as a fifty-three bit integer and the
# exponent separately, which is exactly what the hardware does
# underneath.
#
# The pieces are handed back through slots because a job returns one
# value: 576 sign, 584 exponent, 592 the fraction, 600 what kind.

X_F_ZERO: 0
X_F_NUM: 1
X_F_INF: 2
X_F_NAN: 3

X_BIAS: 1023
X_HIDDEN: 4503599627370496

# take a double apart
x_unpack m v:
    sign: 0
    if v < 0
        sign: 1
    ex: x_mask(x_shr64(v, 52), 2) % 2048
    fr: x_and(v, 4503599627370495)
    poke_i64(m, 576, sign)
    if ex is 2047
        if fr is 0
            poke_i64(m, 600, X_F_INF)
            return 0
        poke_i64(m, 600, X_F_NAN)
        return 0
    if ex is 0
        if fr is 0
            poke_i64(m, 600, X_F_ZERO)
            poke_i64(m, 584, 0)
            poke_i64(m, 592, 0)
            return 0
        # A very small number: no hidden one. Bring it up until the
        # top bit is where a normal number keeps it, so everything
        # after this can treat all numbers the same way.
        poke_i64(m, 600, X_F_NUM)
        e2: 1 - X_BIAS - 52
        f2: fr
        as long as f2 < X_HIDDEN
            f2: x_add(f2, f2)
            e2: e2 - 1
        poke_i64(m, 584, e2)
        poke_i64(m, 592, f2)
        return 0
    poke_i64(m, 600, X_F_NUM)
    poke_i64(m, 584, ex - X_BIAS - 52)
    poke_i64(m, 592, fr + X_HIDDEN)
    return 0

x_up_sign m:
    return peek_i64(m, 576)

x_up_exp m:
    return peek_i64(m, 584)

x_up_frac m:
    return peek_i64(m, 592)

x_up_kind m:
    return peek_i64(m, 600)

# put one back together, rounding to nearest and settling ties by
# whichever way leaves the last bit even, which is what the hardware
# does and what makes sums repeatable.
x_pack sign ex fr:
    if fr is 0
        if sign is 1
            return 0 - 9223372036854775807 - 1
        return 0
    e: ex
    f: fr
    # bring it up until the hidden one is in place
    as long as f < X_HIDDEN
        f: x_add(f, f)
        e: e - 1
    # and down if it went past, keeping what falls off for rounding
    lost: 0
    half: 0
    as long as f >= X_HIDDEN + X_HIDDEN
        if f % 2 is 1
            lost: 1
        half: 0
        if f % 2 is 1
            half: 1
        f: x_shr64(f, 1)
        e: e + 1
    return x_finish(sign, e, f, 0, 0)

# the same, told exactly what fell off the bottom
x_pack_round sign ex fr guard sticky:
    if fr is 0
        if guard is 0
            if sticky is 0
                if sign is 1
                    return 0 - 9223372036854775807 - 1
                return 0
    e: ex
    f: fr
    g: guard
    st: sticky
    as long as f < X_HIDDEN
        f: x_add(f, f)
        e: e - 1
        f: f + g
        g: st
        st: 0
    as long as f >= X_HIDDEN + X_HIDDEN
        if g is 1
            st: 1
        g: f % 2
        f: x_shr64(f, 1)
        e: e + 1
    return x_finish(sign, e, f, g, st)

# round, then lay the three pieces out as sixty-four bits
x_finish sign e f guard sticky:
    ee: e
    ff: f
    if guard is 1
        up: 0
        if sticky is 1
            up: 1
        if not
            # a tie: round to the even one
            if ff % 2 is 1
                up: 1
        if up is 1
            ff: ff + 1
            if ff >= X_HIDDEN + X_HIDDEN
                ff: x_shr64(ff, 1)
                ee: ee + 1
    # what the exponent field will hold
    be: ee + X_BIAS + 52
    if be >= 2047
        # too big to say: infinity
        return x_bits_of(sign, 2047, 0)
    if be <= 0
        # too small to say with a hidden one: shift it down instead
        sh: 1 - be
        if sh > 63
            if sign is 1
                return 0 - 9223372036854775807 - 1
            return 0
        g: 0
        if sh >= 1
            g: x_bit(ff, sh - 1)
        rest: 0
        if sh > 1
            if x_and(ff, x_sub(x_shl64(1, sh - 1), 1)) is not 0
                rest: 1
        sub: x_shr64(ff, sh)
        if g is 1
            if rest is 1
                sub: sub + 1
            if not
                if sub % 2 is 1
                    sub: sub + 1
        if sub >= X_HIDDEN
            return x_bits_of(sign, 1, sub - X_HIDDEN)
        return x_bits_of(sign, 0, sub)
    return x_bits_of(sign, be, ff - X_HIDDEN)

x_bits_of sign be fr:
    v: x_or(x_shl64(be, 52), fr)
    if sign is 1
        return x_or(v, 0 - 9223372036854775807 - 1)
    return v

X_QNAN: 9221120237041090560

# ---- adding two of them ----
x_fadd m a b:
    x_unpack(m, a)
    ka: x_up_kind(m)
    sa: x_up_sign(m)
    ea: x_up_exp(m)
    fa: x_up_frac(m)
    x_unpack(m, b)
    kb: x_up_kind(m)
    sb: x_up_sign(m)
    eb: x_up_exp(m)
    fb: x_up_frac(m)
    if ka is X_F_NAN
        return X_QNAN
    if kb is X_F_NAN
        return X_QNAN
    if ka is X_F_INF
        if kb is X_F_INF
            if sa is not sb
                return X_QNAN
            return a
        return a
    if kb is X_F_INF
        return b
    if ka is X_F_ZERO
        if kb is X_F_ZERO
            if sa is 1
                if sb is 1
                    return a
            return 0
        return b
    if kb is X_F_ZERO
        return a
    # line the two up on the same exponent, keeping what falls off
    return x_add_aligned(m, sa, ea, fa, sb, eb, fb)

# Both numbers scaled up three bits, so the bits that would fall off
# the bottom stay in the sum where the rounding can see them. That is
# simpler than carrying guard bits alongside, and it is right: three
# spare bits are exactly what round-to-nearest needs.
x_add_aligned m sa ea fa sb eb fb:
    s1: sa
    e1: ea
    f1: fa
    s2: sb
    e2: eb
    f2: fb
    # the one with the bigger exponent goes first; on a tie, the
    # bigger fraction, so the subtraction below cannot go negative
    swap: 0
    if e2 > e1
        swap: 1
    if e2 is e1
        if f2 > f1
            swap: 1
    if swap is 1
        s1: sb
        e1: eb
        f1: fb
        s2: sa
        e2: ea
        f2: fa
    d: e1 - e2
    big: x_shl64(f1, 3)
    small: 0
    if d > 60
        # too far apart to matter, but not nothing
        if f2 is not 0
            small: 1
    if not
        wide: x_shl64(f2, 3)
        small: x_shr64(wide, d)
        if d > 0
            if x_and(wide, x_sub(x_shl64(1, d), 1)) is not 0
                small: x_or(small, 1)
    r: 0
    sg: s1
    if s1 is s2
        r: x_add(big, small)
    if not
        r: x_sub(big, small)
    if r is 0
        return 0
    if r < 0
        r: x_sub(0, r)
        sg: 1 - s1
    guard: x_bit(r, 2)
    st: 0
    if x_and(r, 3) is not 0
        st: 1
    return x_pack_round(sg, e1, x_shr64(r, 3), guard, st)

x_fsub m a b:
    return x_fadd(m, a, x_fneg(b))

x_fneg v:
    return x_xor(v, 0 - 9223372036854775807 - 1)

# ---- multiplying ----
x_fmul m a b:
    x_unpack(m, a)
    ka: x_up_kind(m)
    sa: x_up_sign(m)
    ea: x_up_exp(m)
    fa: x_up_frac(m)
    x_unpack(m, b)
    kb: x_up_kind(m)
    sb: x_up_sign(m)
    eb: x_up_exp(m)
    fb: x_up_frac(m)
    sg: 0
    if sa is not sb
        sg: 1
    if ka is X_F_NAN
        return X_QNAN
    if kb is X_F_NAN
        return X_QNAN
    if ka is X_F_INF
        if kb is X_F_ZERO
            return X_QNAN
        return x_bits_of(sg, 2047, 0)
    if kb is X_F_INF
        if ka is X_F_ZERO
            return X_QNAN
        return x_bits_of(sg, 2047, 0)
    if ka is X_F_ZERO
        return x_bits_of(sg, 0, 0)
    if kb is X_F_ZERO
        return x_bits_of(sg, 0, 0)
    # two fifty-three bit numbers make a hundred and six bit answer,
    # so the top half comes from the wide multiply and the bottom
    # half decides the rounding
    hi: x_mulhi_un(fa, fb)
    lo: x_mul(fa, fb)
    e: ea + eb
    # bring the answer down to fifty-three bits
    return x_norm106(m, sg, e, hi, lo)

# a hundred and six bit answer, squeezed back into fifty-three
x_norm106 m sg e hi lo:
    h: hi
    l: lo
    ex: e
    # find the top bit
    n: 0
    if h is not 0
        n: 64
        as long as x_bit(h, n - 64 + 63) is 0
            n: n - 1
        n: n + 63 - 63
        n: 0
        i: 63
        as long as i >= 0
            if x_bit(h, i) is 1
                n: i + 65
                i: 0 - 1
            if not
                i: i - 1
    if not
        i: 63
        as long as i >= 0
            if x_bit(l, i) is 1
                n: i + 1
                i: 0 - 1
            if not
                i: i - 1
    if n is 0
        return x_bits_of(sg, 0, 0)
    # we want the top fifty-three bits of those n
    sh: n - 53
    if sh <= 0
        return x_pack_round(sg, ex - sh, l, 0, 0)
    return x_shift_down(m, sg, ex + sh, h, l, sh)

# take the top fifty-three bits out of a hundred and twenty-eight
x_shift_down m sg ex h l sh:
    f: 0
    guard: 0
    sticky: 0
    if sh < 64
        f: x_or(x_shr64(l, sh), x_shl64(h, 64 - sh))
        guard: x_bit(l, sh - 1)
        if sh > 1
            if x_and(l, x_sub(x_shl64(1, sh - 1), 1)) is not 0
                sticky: 1
    if not
        f: x_shr64(h, sh - 64)
        if sh is 64
            guard: x_bit(l, 63)
            if x_and(l, 9223372036854775807) is not 0
                sticky: 1
        if not
            guard: x_bit(h, sh - 65)
            if l is not 0
                sticky: 1
            if sh > 65
                if x_and(h, x_sub(x_shl64(1, sh - 65), 1)) is not 0
                    sticky: 1
    return x_pack_round(sg, ex, f, guard, sticky)

# ---- dividing ----
x_fdiv m a b:
    x_unpack(m, a)
    ka: x_up_kind(m)
    sa: x_up_sign(m)
    ea: x_up_exp(m)
    fa: x_up_frac(m)
    x_unpack(m, b)
    kb: x_up_kind(m)
    sb: x_up_sign(m)
    eb: x_up_exp(m)
    fb: x_up_frac(m)
    sg: 0
    if sa is not sb
        sg: 1
    if ka is X_F_NAN
        return X_QNAN
    if kb is X_F_NAN
        return X_QNAN
    if ka is X_F_INF
        if kb is X_F_INF
            return X_QNAN
        return x_bits_of(sg, 2047, 0)
    if kb is X_F_INF
        return x_bits_of(sg, 0, 0)
    if kb is X_F_ZERO
        if ka is X_F_ZERO
            return X_QNAN
        return x_bits_of(sg, 2047, 0)
    if ka is X_F_ZERO
        return x_bits_of(sg, 0, 0)
    # Long division in binary, fifty-five bits of answer: fifty-three
    # to keep, then a guard bit and a sticky bit for the rounding.
    #
    # The running remainder is doubled each round. It is always below
    # the divisor, and the divisor is at most fifty-three bits, so
    # after doubling it needs fifty-four — comfortably inside a
    # number. Doubling the remainder AND the top bit together, which
    # is what the obvious loop does, is what overflows.
    # Long division in binary. Each round doubles the remainder and
    # asks whether the divisor fits. The remainder has to stay below
    # the divisor for that to work, so when the dividend starts out
    # the larger of the two, the divisor comes off first and that
    # counts as the leading bit of the answer.
    q: 0
    r: fa
    lead: 0
    if r >= fb
        r: r - fb
        lead: 1
    i: 0
    as long as i < 54
        r: x_add(r, r)
        q: x_add(q, q)
        if r >= fb
            r: r - fb
            q: q + 1
        i: i + 1
    st: 0
    if r is not 0
        st: 1
    # the whole answer is the leading bit followed by those fifty-four
    full: x_or(x_shl64(lead, 54), q)
    guard: full % 2
    f: x_shr64(full, 1)
    e: ea - eb - 53
    return x_pack_round(sg, e, f, guard, st)

# ---- comparing ----
# returns 0 below, 1 equal, 2 above, 3 not comparable
x_fcmp m a b:
    x_unpack(m, a)
    ka: x_up_kind(m)
    x_unpack(m, b)
    kb: x_up_kind(m)
    if ka is X_F_NAN
        return 3
    if kb is X_F_NAN
        return 3
    # nought and minus nought are the same number
    if ka is X_F_ZERO
        if kb is X_F_ZERO
            return 1
    sa: 0
    if a < 0
        sa: 1
    sb: 0
    if b < 0
        sb: 1
    if sa is not sb
        if sa is 1
            return 0
        return 2
    # same sign: the bits happen to sort the right way round
    ua: x_and(a, 9223372036854775807)
    ub: x_and(b, 9223372036854775807)
    if ua is ub
        return 1
    below: 0
    if x_ult(ua, ub) is 1
        below: 1
    if sa is 1
        below: 1 - below
    if below is 1
        return 0
    return 2

# ---- whole numbers to and from ----
x_i2d m n:
    if n is 0
        return 0
    sg: 0
    v: n
    if v < 0
        sg: 1
        if v is 0 - 9223372036854775807 - 1
            # no positive twin: this one is exactly -2^63
            return x_bits_of(1, 1086, 0)
        v: 0 - v
    return x_pack_round(sg, 0, v, 0, 0)

# a double back to a whole number, throwing away the fraction, which
# is what the hardware does when a program writes (int)x
x_d2i m v:
    x_unpack(m, v)
    k: x_up_kind(m)
    if k is X_F_ZERO
        return 0
    if k is X_F_NAN
        return 0 - 9223372036854775807 - 1
    if k is X_F_INF
        return 0 - 9223372036854775807 - 1
    sg: x_up_sign(m)
    e: x_up_exp(m)
    f: x_up_frac(m)
    if e >= 0
        # the fraction is fifty-three bits, so anything shifted up
        # more than ten places will not fit in sixty-three
        if e > 10
            return 0 - 9223372036854775807 - 1
        r: x_shl64(f, e)
        if r < 0
            return 0 - 9223372036854775807 - 1
        if sg is 1
            return x_sub(0, r)
        return r
    sh: 0 - e
    if sh > 63
        return 0
    r: x_shr64(f, sh)
    if sg is 1
        return x_sub(0, r)
    return r

# ---- the single-width kind, which is the same idea in thirty-two
#      bits. Converting to a double and back is exact both ways, so
#      the work is only in the laying out. ----
x_f2d m v:
    u: x_lo(v)
    sign: x_bit(u, 31)
    ex: x_shr64(x_and(u, 2139095040), 23)
    fr: x_and(u, 8388607)
    if ex is 255
        if fr is 0
            return x_bits_of(sign, 2047, 0)
        return X_QNAN
    if ex is 0
        if fr is 0
            return x_bits_of(sign, 0, 0)
        return x_pack_round(sign, 0 - 149, fr, 0, 0)
    return x_bits_of(sign, ex - 127 + X_BIAS, x_shl64(fr, 29))

x_d2f m v:
    x_unpack(m, v)
    k: x_up_kind(m)
    sg: x_up_sign(m)
    if k is X_F_ZERO
        return x_shl64(sg, 31)
    if k is X_F_NAN
        return 2143289344
    if k is X_F_INF
        return x_or(x_shl64(sg, 31), 2139095040)
    e: x_up_exp(m)
    f: x_up_frac(m)
    # a single keeps twenty-four bits, a double fifty-three
    guard: x_bit(f, 28)
    st: 0
    if x_and(f, 268435455) is not 0
        st: 1
    ff: x_shr64(f, 29)
    ee: e + 29
    if guard is 1
        up: 0
        if st is 1
            up: 1
        if not
            if ff % 2 is 1
                up: 1
        if up is 1
            ff: ff + 1
            if ff >= 16777216
                ff: x_shr64(ff, 1)
                ee: ee + 1
    be: ee + 127 + 23
    if be >= 255
        return x_or(x_shl64(sg, 31), 2139095040)
    if be <= 0
        sh: 1 - be
        if sh > 31
            return x_shl64(sg, 31)
        return x_or(x_shl64(sg, 31), x_shr64(ff, sh))
    return x_or(x_shl64(sg, 31), x_or(x_shl64(be, 23), ff - 8388608))

# ---- the square root ----
#
# Long division in binary, the way it is done on paper but in base
# four: two bits of the number come in, one bit of the answer goes
# out. Fifty-four rounds give fifty-four bits, which is one more
# than a double keeps, so the last one decides the rounding.
#
# The number is scaled to a hundred and eight bits, held as two
# halves, because a fifty-three bit fraction squared needs that
# much. The running remainder never passes twice the root, so it
# stays comfortably inside one number.
x_fsqrt m v:
    x_unpack(m, v)
    k: x_up_kind(m)
    if k is X_F_ZERO
        return v
    if k is X_F_NAN
        return X_QNAN
    sg: x_up_sign(m)
    if sg is 1
        # the square root of a number below nothing is not a number
        return X_QNAN
    if k is X_F_INF
        return v
    e: x_up_exp(m)
    f: x_up_frac(m)
    # the exponent has to be even to halve exactly
    if e % 2 is not 0
        f: x_add(f, f)
        e: e - 1
    return x_sqrt_bits(m, e, f)

x_sqrt_bits m e f:
    # how many bits the fraction has
    nb: 0
    i: 63
    as long as i >= 0
        if x_bit(f, i) is 1
            nb: i + 1
            i: 0 - 1
        if not
            i: i - 1
    sh: 108 - nb
    if sh % 2 is not 0
        sh: sh - 1
    # the value shifted up, as two halves
    hi: 0
    lo: 0
    if sh >= 64
        hi: x_shl64(f, sh - 64)
    if not
        if sh > 0
            hi: x_shr64(f, 64 - sh)
        lo: x_shl64(f, sh)
    ee: (e - sh) / 2
    return x_sqrt_loop(m, ee, hi, lo)

x_sqrt_loop m ee hi lo:
    r: 0
    rem: 0
    i: 0
    as long as i < 54
        pos: 106 - 2 * i
        two: 0
        if pos >= 64
            two: x_and(x_shr64(hi, pos - 64), 3)
        if not
            two: x_and(x_shr64(lo, pos), 3)
        rem: x_add(x_shl64(rem, 2), two)
        t: x_add(x_shl64(r, 2), 1)
        r: x_add(r, r)
        if x_ult(rem, t) is 0
            rem: x_sub(rem, t)
            r: r + 1
        i: i + 1
    st: 0
    if rem is not 0
        st: 1
    return x_pack_round(0, ee, r, 0, st)

# ---------------------------------------------------------------
# the vector registers
# ---------------------------------------------------------------
#
# Sixteen registers of sixteen bytes each, held as two halves so an
# ordinary Sovren number can carry each one. Real programs reach for
# these constantly: glibc searches and copies memory sixteen bytes
# at a time, so a general-purpose emulator cannot skip them.
#
# Only the whole-number instructions are here. The floating point
# ones are a different job, and nothing in a normal program's
# start-up path needs them.

# peek_i64 and poke_i64 count in BYTES, not in whole numbers, so a
# register sixteen bytes wide starts at n * 16 and its top half is
# eight bytes further on. Getting this wrong made every vector
# register overlap the next one.
x_xlo m n:
    return peek_i64(peek_i64(m, 488), n * 32)

x_xhi m n:
    return peek_i64(peek_i64(m, 488), n * 32 + 8)

x_xset m n lo hi:
    x: peek_i64(m, 488)
    poke_i64(x, n * 32, lo)
    poke_i64(x, n * 32 + 8, hi)
    return 0

# one byte out of a vector register, counted from the bottom
x_xbyte m n i:
    if i < 8
        return x_mask(x_shr64(x_xlo(m, n), i * 8), 1)
    return x_mask(x_shr64(x_xhi(m, n), (i - 8) * 8), 1)

# the second operand of a vector instruction, as two halves. The
# answer goes in the two scratch slots so a job can hand back a pair.
x_xrm_lo m:
    if peek_i64(m, 360) is 1
        return x_xlo(m, peek_i64(m, 376))
    return x_r64(m, peek_i64(m, 376))

x_xrm_hi m:
    if peek_i64(m, 360) is 1
        return x_xhi(m, peek_i64(m, 376))
    return x_r64(m, x_add(peek_i64(m, 376), 8))

x_xrm_set m lo hi:
    if peek_i64(m, 360) is 1
        return x_xset(m, peek_i64(m, 376), lo, hi)
    x_w64(m, peek_i64(m, 376), lo)
    x_w64(m, x_add(peek_i64(m, 376), 8), hi)
    return 0

# compare sixteen pairs of bytes, one half at a time. `mode` is 0
# for equal and 1 for greater, and `w` is how wide each piece is.
x_pcmp_half a b mode w:
    r: 0
    i: 0
    as long as i < 8 / w
        pa: x_mask(x_shr64(a, i * w * 8), w)
        pb: x_mask(x_shr64(b, i * w * 8), w)
        hit: 0
        if mode is 0
            if pa is pb
                hit: 1
        if not
            if x_sval(pa, w) > x_sval(pb, w)
                hit: 1
        if hit is 1
            r: x_or(r, x_shl64(x_ones(w), i * w * 8))
        i: i + 1
    return r

# a run of one bits, w bytes wide
x_ones w:
    if w is 1
        return 255
    if w is 2
        return 65535
    if w is 4
        return 4294967295
    return 0 - 1

# the smaller or larger of each byte, counting upwards
x_pminmax_half a b big:
    r: 0
    i: 0
    as long as i < 8
        pa: x_mask(x_shr64(a, i * 8), 1)
        pb: x_mask(x_shr64(b, i * 8), 1)
        k: pa
        if big is 1
            if pb > pa
                k: pb
        if not
            if pb < pa
                k: pb
        r: x_or(r, x_shl64(k, i * 8))
        i: i + 1
    return r

# gather the top bit of all sixteen bytes into one number. This is
# how a program turns a vector compare into something it can branch
# on, and it is everywhere in glibc.
x_pmovmskb m n:
    r: 0
    i: 0
    as long as i < 16
        if x_xbyte(m, n, i) >= 128
            r: x_or(r, x_shl64(1, i))
        i: i + 1
    return r

# shift the whole sixteen bytes left or right by whole bytes
x_pslldq m n by:
    if by >= 16
        return x_xset(m, n, 0, 0)
    lo: x_xlo(m, n)
    hi: x_xhi(m, n)
    if by is 0
        return 0
    if by < 8
        nh: x_or(x_shl64(hi, by * 8), x_shr64(lo, (8 - by) * 8))
        return x_xset(m, n, x_shl64(lo, by * 8), nh)
    return x_xset(m, n, 0, x_shl64(lo, (by - 8) * 8))

x_psrldq m n by:
    if by >= 16
        return x_xset(m, n, 0, 0)
    lo: x_xlo(m, n)
    hi: x_xhi(m, n)
    if by is 0
        return 0
    if by < 8
        nl: x_or(x_shr64(lo, by * 8), x_shl64(hi, (8 - by) * 8))
        return x_xset(m, n, nl, x_shr64(hi, by * 8))
    return x_xset(m, n, x_shr64(hi, (by - 8) * 8), 0)

# ---------------------------------------------------------------
# what the program asks the system for
# ---------------------------------------------------------------

# Hand out a slab well past the program itself.
#
# The Sovren runtime asks for a gigabyte of heap up front and then
# uses a sliver of it. Handing back nothing because a gigabyte will
# not fit turns into a write to address zero, so the reservation is
# capped: the program gets a real address, and the parts of that
# gigabyte it never touches cost nothing.
X_SLAB: 33554432

# Where things sit inside the block, counted from the bottom:
#   0                the program itself
#   X_BRK_TOP        as far as brk may grow
#   X_STACK_AT       the stack, growing down from here
#   X_SLABS          everything mmap hands out, growing up
X_BRK_TOP: 67108864
X_STACK_AT: 100663296
X_SLABS: 134217728

# The heap that brk grows and the slabs that mmap hands out must not
# land on each other. brk starts just above the program and grows
# upwards; mmap starts a long way above that and also grows up.
# Hand out a piece of memory.
#
# A program often RESERVES far more than it will ever touch: the
# Sovren runtime asks for a gigabyte and uses a sliver. Refusing
# that would stop it dead, so a reservation larger than the slab
# area is trimmed to what is left. A program that then writes past
# the trimmed end is caught by the range check, which is the honest
# answer: this machine did not have the room.
x_give m n:
    lo: peek_i64(m, 216)
    floor: lo + X_SLABS
    top: peek_i64(m, 224)
    if top < floor
        top: floor
    want: n
    if want < 4096
        want: 4096
    want: (want / 4096) * 4096 + 4096
    room: lo + X_MEM - 4096 - top
    if want > room
        if room < 1048576
            # genuinely nothing left
            return 0 - 12
        want: room
    poke_i64(m, 224, top + want)
    return top

# a guest address as an address here
x_here m a:
    return peek_i64(m, 176) + a - peek_i64(m, 216)

x_syscall m nx:
    poke_i64(m, 272, 1)
    os: peek_i64(m, 240)
    if os is X_WIN
        # real Windows has no Linux kernel behind it. Wine hides this
        # because Wine runs on Linux. This does not hide it.
        poke_i64(m, 168, X_RAWSYS)
        return 0
    nr: x_reg(m, 0)
    if os is X_MAC
        if nr < 33554432
            # a Linux number on a Mac. It would fail on real hardware.
            poke_i64(m, 168, X_RAWSYS)
            poke_i64(m, 232, nr)
            return 0
        nr: x_mac_to_linux(nr - 33554432)
    return x_do_call(m, nx, nr)

# macOS counts its calls differently. Turn the Mac number into the
# Linux one this emulator already knows how to answer.
x_mac_to_linux n:
    if n is 1
        return 60
    if n is 3
        return 0
    if n is 4
        return 1
    if n is 5
        return 257
    if n is 6
        return 3
    if n is 199
        return 8
    if n is 197
        return 9
    if n is 20
        return 39
    if n is 10
        return 87
    if n is 136
        return 83
    if n is 12
        return 80
    if n is 73
        return 11
    if n is 33
        return 21
    if n is 54
        return 16
    return 0 - 1

x_do_call m nx nr:
    a0: x_reg(m, 7)
    a1: x_reg(m, 6)
    a2: x_reg(m, 2)
    a3: x_reg(m, 10)
    if nr is 1
        if a0 is 1
            x_say(m, a1, a2)
            x_setr(m, 0, a2)
            return x_go(m, nx)
        if a0 is 2
            x_grumble(m, a1, a2)
            x_setr(m, 0, a2)
            return x_go(m, nx)
        x_setr(m, 0, sys_write(a0, x_here(m, a1), a2))
        return x_go(m, nx)
    if nr is 0
        x_setr(m, 0, sys_read(a0, x_here(m, a1), a2))
        return x_go(m, nx)
    if nr is 257
        x_setr(m, 0, sys_open(x_here(m, a1), a2))
        return x_go(m, nx)
    if nr is 2
        x_setr(m, 0, sys_open(x_here(m, a0), a1))
        return x_go(m, nx)
    if nr is 3
        x_setr(m, 0, sys_close(a0))
        return x_go(m, nx)
    if nr is 8
        x_setr(m, 0, sys_seek(a0, a1, a2))
        return x_go(m, nx)
    if nr is 9
        # A fresh piece of memory from the system always arrives
        # blank. malloc keeps its bookkeeping in the first bytes and
        # goes wrong in confusing ways if they hold rubbish.
        got: x_give(m, a1)
        if got is not 0
            k: 0
            n: a1
            if n > X_SLAB
                n: X_SLAB
            as long as k < n
                x_w8(m, got + k, 0)
                k: k + 1
        x_setr(m, 0, got)
        return x_go(m, nx)
    if nr is 11
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 10
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 60
        poke_i64(m, 208, x_mask(a0, 1))
        poke_i64(m, 168, X_EXITED)
        return 0
    if nr is 231
        poke_i64(m, 208, x_mask(a0, 1))
        poke_i64(m, 168, X_EXITED)
        return 0
    # ---- the calls a C library makes before it will start ----
    if nr is 158
        # set or read the thread pointer. glibc asks for this early.
        if a0 is 4098
            poke_i64(m, 440, a1)
            x_setr(m, 0, 0)
            return x_go(m, nx)
        if a0 is 4097
            x_setr(m, 0, peek_i64(m, 440))
            return x_go(m, nx)
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 12
        # move the top of the heap. Nought asks where it is.
        # This is its own area, kept well clear of the slabs mmap
        # hands out, so the two can never tread on each other.
        cur: peek_i64(m, 520)
        if cur is 0
            cur: peek_i64(m, 568)
            poke_i64(m, 520, cur)
        if a0 is 0
            x_setr(m, 0, cur)
            return x_go(m, nx)
        if a0 > cur
            lo: peek_i64(m, 216)
            if a0 - lo > X_BRK_TOP - 65536
                x_setr(m, 0, cur)
                return x_go(m, nx)
            # the new part must start blank
            k: cur
            as long as k < a0
                x_w8(m, k, 0)
                k: k + 1
        poke_i64(m, 520, a0)
        x_setr(m, 0, a0)
        return x_go(m, nx)
    if nr is 218
        x_setr(m, 0, 1)
        return x_go(m, nx)
    if nr is 39
        x_setr(m, 0, 1)
        return x_go(m, nx)
    if nr is 20
        # writing several pieces at once
        cnt: a2
        total: 0
        i: 0
        as long as i < cnt
            base: x_add(a1, i * 16)
            buf: x_r64(m, base)
            len: x_r64(m, base + 8)
            if len > 0
                if a0 is 1
                    x_say(m, buf, len)
                if not
                    if a0 is 2
                        x_grumble(m, buf, len)
                    if not
                        sys_write(a0, x_here(m, buf), len)
                total: total + len
            i: i + 1
        x_setr(m, 0, total)
        return x_go(m, nx)
    if nr is 16
        # asking a device a question. Say it is a terminal.
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 5
        # what kind of thing this file is. The C library asks before
        # it decides how to buffer, and reads the answer whatever it
        # is told, so the block must be filled in.
        if a1 is 0
            x_setr(m, 0, 0 - 14)
            return x_go(m, nx)
        i: 0
        as long as i < 144
            x_w8(m, a1 + i, 0)
            i: i + 1
        # a character device, readable and writable by everyone
        x_w32(m, a1 + 24, 8630)
        x_w64(m, a1 + 48, 4096)
        x_setr(m, 0, 0)
        return x_go(m, nx)
    if nr is 262
        if a2 is not 0
            i: 0
            as long as i < 144
                x_w8(m, a2 + i, 0)
                i: i + 1
            x_w32(m, a2 + 24, 8630)
            x_w64(m, a2 + 48, 4096)
        x_setr(m, 0, 0)
        return x_go(m, nx)

    # anything else: say it worked and carry on
    x_setr(m, 0, 0)
    return x_go(m, nx)

# ---------------------------------------------------------------
# the stand-in Windows library
# ---------------------------------------------------------------
#
# A Windows program does not talk to the kernel directly; it calls
# kernel32. The loader points every imported name at an address here.
# When the instruction pointer lands on one, this answers it and
# returns, the same way the real library would.

# Windows hands out handles, not file numbers. Ten, eleven and twelve
# are the three standard ones; everything the program opens gets a
# number well clear of those, so a file can never be mistaken for the
# console no matter how many are open at once.
X_HBASE: 1000

x_fd h:
    if h >= X_HBASE
        return h - X_HBASE
    if h is 10
        return 0
    if h is 11
        return 1
    if h is 12
        return 2
    return h

x_win_call m which:
    nm: list_get(peek_i64(m, 288), which)
    a1: x_reg(m, 1)
    a2: x_reg(m, 2)
    a3: x_reg(m, 8)
    a4: x_reg(m, 9)
    sp: x_sp(m)
    a5: x_r64(m, x_add(sp, 40))
    if str_eq(nm, "GetStdHandle") is 1
        h: x_lo(a1)
        if h is 4294967286
            x_setr(m, 0, 10)
        if not
            if h is 4294967284
                x_setr(m, 0, 12)
            if not
                x_setr(m, 0, 11)
        return 1
    if str_eq(nm, "WriteFile") is 1
        if a1 is 11
            x_say(m, a2, a3)
        if not
            if a1 is 12
                x_grumble(m, a2, a3)
            if not
                sys_write(x_fd(a1), x_here(m, a2), a3)
        if a4 is not 0
            x_w32(m, a4, a3)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "ReadFile") is 1
        n: 0
        if a1 is 10
            n: sys_read(0, x_here(m, a2), a3)
        if not
            if a1 > 12
                n: sys_read(x_fd(a1), x_here(m, a2), a3)
        if n < 0
            n: 0
        if a4 is not 0
            x_w32(m, a4, n)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "CreateFileA") is 1
        flags: 0
        if x_lo(a2) is 1073741824
            flags: 577
        if x_lo(a5) is 2
            flags: 577
        fd: sys_open(x_here(m, a1), flags)
        if fd < 0
            x_setr(m, 0, 0 - 1)
            return 1
        x_setr(m, 0, X_HBASE + fd)
        return 1
    if str_eq(nm, "CloseHandle") is 1
        if a1 > 12
            sys_close(x_fd(a1))
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "VirtualAlloc") is 1
        # Windows says no with nought, not with a number
        got: x_give(m, a2)
        if got < 0
            got: 0
        x_setr(m, 0, got)
        return 1
    if str_eq(nm, "ExitProcess") is 1
        poke_i64(m, 208, x_mask(a1, 1))
        poke_i64(m, 168, X_EXITED)
        return 0
    if str_eq(nm, "GetCommandLineA") is 1
        x_setr(m, 0, peek_i64(m, 248))
        return 1
    if str_eq(nm, "SetFilePointerEx") is 1
        w: x_lo(a4)
        r: sys_seek(x_fd(a1), a2, w)
        if a3 is not 0
            x_w64(m, a3, r)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "GetConsoleMode") is 1
        if a2 is not 0
            x_w32(m, a2, 3)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "SetConsoleMode") is 1
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "GetFileSizeEx") is 1
        f: x_fd(a1)
        here: sys_seek(f, 0, 1)
        end: sys_seek(f, 0, 2)
        sys_seek(f, here, 0)
        if a2 is not 0
            x_w64(m, a2, end)
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "LoadLibraryA") is 1
        # Opening another Windows library. Nothing here can really
        # load user32 or gdi32 — those are Windows itself — so a
        # made-up handle comes back and any function asked for
        # inside it is answered with nought. A program checks for
        # that and says it cannot draw, which is the truth here.
        x_setr(m, 0, 305419896)
        return 1
    if str_eq(nm, "GetProcAddress") is 1
        x_setr(m, 0, 0)
        return 1
    if str_eq(nm, "DeleteFileA") is 1
        x_setr(m, 0, 1)
        return 1
    if str_eq(nm, "CreateDirectoryA") is 1
        x_setr(m, 0, 1)
        return 1
    # a name nobody taught it: say nothing happened, note it, carry on
    x_note_missing(m, nm)
    x_setr(m, 0, 0)
    return 1

x_note_missing m nm:
    o: peek_i64(m, 296)
    used: peek_i64(m, 304)
    t: str_cat("no stand-in for ", nm)
    t: str_cat(t, "\n")
    n: str_len(t)
    i: 0
    as long as i < n
        if used < X_OUT - 2
            poke_byte(o, used, peek_byte(t, i))
            used: used + 1
        i: i + 1
    poke_byte(o, used, 0)
    poke_i64(m, 304, used)
    return 0

# ---------------------------------------------------------------
# the loop
# ---------------------------------------------------------------

x86_run m:
    return x86_run_for(m, 400000000)

x86_run_for m limit:
    n: 0
    going: 1
    tb: peek_i64(m, 280)
    nt: peek_i64(m, 312)
    as long as going is 1
        if n >= limit
            poke_i64(m, 168, X_TOOLONG)
            going: 0
        if not
            pc: peek_i64(m, 128)
            hit: 0
            if nt > 0
                if pc >= tb
                    if pc < tb + nt * 16
                        hit: 1
            if hit is 1
                going: x_win_call(m, (pc - tb) / 16)
                if going is 1
                    x_set_rip(m, x_pop(m))
            if not
                going: x_step(m)
            # a read or write outside the block is a fault, and the
            # step that caused it must not be allowed to continue
            if peek_i64(m, 168) is not X_RUNNING
                going: 0
            n: n + 1
    return peek_i64(m, 168)

x86_steps m:
    return peek_i64(m, 328)

# ---------------------------------------------------------------
# loading an ELF, the Linux shape
# ---------------------------------------------------------------

x86_load_elf m path:
    d: file_read_all(path)
    if d is 0
        return 0
    poke_i64(m, 240, X_LINUX)
    entry: peek_i64(d, 24)
    phoff: peek_i64(d, 32)
    phnum: peek_byte(d, 56) + peek_byte(d, 57) * 256
    phsz: peek_byte(d, 54) + peek_byte(d, 55) * 256
    # the lowest address any piece wants to sit at
    lo: 0
    i: 0
    as long as i < phnum
        o: phoff + i * phsz
        t: peek_byte(d, o) + peek_byte(d, o + 1) * 256
        if t is 1
            va: peek_i64(d, o + 16)
            if lo is 0
                lo: va
            if va < lo
                lo: va
        i: i + 1
    if lo is 0
        lo: 4194304
    poke_i64(m, 216, lo)
    x_rebase(m)
    # copy each piece in, and zero whatever it asked for beyond what
    # the file holds. That tail is the program's blank workspace and
    # a program that finds rubbish there goes wrong in odd ways.
    top: lo
    i: 0
    as long as i < phnum
        o: phoff + i * phsz
        t: peek_byte(d, o) + peek_byte(d, o + 1) * 256
        if t is 1
            off: peek_i64(d, o + 8)
            va: peek_i64(d, o + 16)
            fsz: peek_i64(d, o + 32)
            msz: peek_i64(d, o + 40)
            k: 0
            as long as k < fsz
                x_w8(m, va + k, peek_byte(d, off + k))
                k: k + 1
            as long as k < msz
                x_w8(m, va + k, 0)
                k: k + 1
            if va + msz > top
                top: va + msz
        # the thread-local piece, which is copied fresh per thread
        if t is 7
            poke_i64(m, 496, peek_i64(d, o + 8))
            poke_i64(m, 504, peek_i64(d, o + 32))
            poke_i64(m, 512, peek_i64(d, o + 40))
        i: i + 1
    # the heap starts above everything the file asked for
    poke_i64(m, 568, (top / 4096) * 4096 + 65536)
    poke_i64(m, 520, peek_i64(m, 568))
    # what the auxiliary table needs to say about this program
    poke_i64(m, 528, lo + phoff)
    poke_i64(m, 536, phnum)
    poke_i64(m, 544, entry)
    x_setup_tls_elf(m, d)
    x_set_rip(m, entry)
    x_start_stack(m, path)
    return 1

# ---- thread-local storage ----
#
# A real program keeps per-thread things behind the fs register:
# the stack guard, the thread pointer, errno. glibc reads fs:[0x10]
# before it does anything else. Give it a block, with the thread
# pointer at nought pointing back at itself, which is the shape the
# system sets up.
# For an ELF that carries a thread-local piece, the block sits just
# BELOW the thread pointer and the pointer itself is at the top. The
# program reaches its own variables with a negative offset from fs,
# which is why there has to be room underneath.
x_setup_tls_elf m d:
    lo: peek_i64(m, 216)
    room: peek_i64(m, 512)
    if room < 512
        room: 512
    room: (room / 64) * 64 + 128
    base: lo + X_STACK_AT + 1048576
    tp: base + room
    poke_i64(m, 440, tp)
    poke_i64(m, 448, tp)
    i: 0
    as long as i < room + 2048
        x_w8(m, base + i, 0)
        i: i + 1
    # the program's own starting values go right below the pointer
    fsz: peek_i64(m, 504)
    off: peek_i64(m, 496)
    k: 0
    as long as k < fsz
        x_w8(m, tp - room + k, peek_byte(d, off + k))
        k: k + 1
    x_w64(m, tp, tp)
    x_w64(m, tp + 16, tp)
    x_w64(m, tp + 40, 5089731888844279321)
    return 0

x_setup_tls m:
    lo: peek_i64(m, 216)
    tls: lo + X_STACK_AT + 1048576
    poke_i64(m, 440, tls)
    poke_i64(m, 448, tls)
    i: 0
    as long as i < 2048
        x_w8(m, tls + i, 0)
        i: i + 1
    # the thread pointer, which points at itself
    x_w64(m, tls, tls)
    # the pointer to this thread's own block
    x_w64(m, tls + 16, tls)
    # a stack guard value that is not zero
    x_w64(m, tls + 40, 5089731888844279321)
    return 0

# argc, argv and an empty environment, the way Linux leaves them
# The stack the way Linux hands it over: the count of arguments, the
# arguments, a nought, the environment, a nought, and then the
# auxiliary table. A small program ignores all but the first few. A
# program built on the C library reads the auxiliary table before it
# does anything else, and gives up in confusing ways if it is not
# there, so it is worth setting out properly.
x_start_stack m path:
    lo: peek_i64(m, 216)
    sp: lo + X_STACK_AT
    # the program name and a couple of environment lines sit above
    np: lo + X_STACK_AT + 131072
    n: str_len(path)
    i: 0
    as long as i < n
        x_w8(m, np + i, peek_byte(path, i))
        i: i + 1
    x_w8(m, np + n, 0)
    # sixteen bytes of something for the random slot in the table
    rnd: np + 256
    i: 0
    as long as i < 16
        x_w8(m, rnd + i, i * 37 + 11)
        i: i + 1
    # an empty name, for the slots that want a piece of text
    empty: np + 320
    x_w8(m, empty, 0)
    x_set_sp(m, sp)
    a: sp
    x_w64(m, a, 1)
    a: a + 8
    x_w64(m, a, np)
    a: a + 8
    x_w64(m, a, 0)
    a: a + 8
    # no environment
    x_w64(m, a, 0)
    a: a + 8
    # the auxiliary table, in pairs
    a: x_aux(m, a, 6, 4096)
    a: x_aux(m, a, 17, 100)
    a: x_aux(m, a, 11, 1000)
    a: x_aux(m, a, 12, 1000)
    a: x_aux(m, a, 13, 1000)
    a: x_aux(m, a, 14, 1000)
    a: x_aux(m, a, 23, 0)
    a: x_aux(m, a, 25, rnd)
    a: x_aux(m, a, 31, np)
    a: x_aux(m, a, 15, empty)
    a: x_aux(m, a, 16, 0)
    a: x_aux(m, a, 3, peek_i64(m, 528))
    a: x_aux(m, a, 4, 56)
    a: x_aux(m, a, 5, peek_i64(m, 536))
    a: x_aux(m, a, 9, peek_i64(m, 544))
    a: x_aux(m, a, 7, 0)
    a: x_aux(m, a, 8, 0)
    a: x_aux(m, a, 0, 0)
    return 0

# one pair of the auxiliary table
x_aux m a k v:
    x_w64(m, a, k)
    x_w64(m, a + 8, v)
    return a + 16

# ---------------------------------------------------------------
# loading a Mach-O, the Mac shape
# ---------------------------------------------------------------

x86_load_macho m path:
    d: file_read_all(path)
    if d is 0
        return 0
    magic: peek_byte(d, 0) + peek_byte(d, 1) * 256 + peek_byte(d, 2) * 65536 + peek_byte(d, 3) * 16777216
    if magic is not 4277009103
        return 0
    poke_i64(m, 240, X_MAC)
    ncmds: peek_byte(d, 16) + peek_byte(d, 17) * 256 + peek_byte(d, 18) * 65536 + peek_byte(d, 19) * 16777216
    entry: 0
    lo: 0
    off: 32
    i: 0
    as long as i < ncmds
        cmd: peek_byte(d, off) + peek_byte(d, off + 1) * 256 + peek_byte(d, off + 2) * 65536 + peek_byte(d, off + 3) * 16777216
        sz: peek_byte(d, off + 4) + peek_byte(d, off + 5) * 256 + peek_byte(d, off + 6) * 65536 + peek_byte(d, off + 7) * 16777216
        if cmd is 25
            vmaddr: peek_i64(d, off + 24)
            filesz: peek_i64(d, off + 48)
            if filesz > 0
                if lo is 0
                    lo: vmaddr
                if vmaddr < lo
                    lo: vmaddr
        off: off + sz
        i: i + 1
    if lo is 0
        lo: 4294967296
    poke_i64(m, 216, lo)
    x_rebase(m)
    off: 32
    i: 0
    as long as i < ncmds
        cmd: peek_byte(d, off) + peek_byte(d, off + 1) * 256 + peek_byte(d, off + 2) * 65536 + peek_byte(d, off + 3) * 16777216
        sz: peek_byte(d, off + 4) + peek_byte(d, off + 5) * 256 + peek_byte(d, off + 6) * 65536 + peek_byte(d, off + 7) * 16777216
        if cmd is 25
            vmaddr: peek_i64(d, off + 24)
            fileoff: peek_i64(d, off + 40)
            filesz: peek_i64(d, off + 48)
            k: 0
            as long as k < filesz
                x_w8(m, vmaddr + k, peek_byte(d, fileoff + k))
                k: k + 1
        if cmd is 5
            entry: peek_i64(d, off + 144)
        if cmd is 2147483688
            entry: x_add(lo, peek_i64(d, off + 8))
        off: off + sz
        i: i + 1
    if entry is 0
        return 0
    x_setup_tls(m)
    x_set_rip(m, entry)
    x_start_stack(m, path)
    return 1

# ---------------------------------------------------------------
# loading a PE, the Windows shape
# ---------------------------------------------------------------

x86_load_pe m path:
    d: file_read_all(path)
    if d is 0
        return 0
    if peek_byte(d, 0) is not 77
        return 0
    if peek_byte(d, 1) is not 90
        return 0
    poke_i64(m, 240, X_WIN)
    pe: peek_byte(d, 60) + peek_byte(d, 61) * 256 + peek_byte(d, 62) * 65536 + peek_byte(d, 63) * 16777216
    nsec: peek_byte(d, pe + 6) + peek_byte(d, pe + 7) * 256
    opt: pe + 24
    entry_rva: x_u32d(d, opt + 16)
    base: peek_i64(d, opt + 24)
    imp_rva: x_u32d(d, opt + 112 + 8)
    poke_i64(m, 216, base)
    x_rebase(m)
    # Real Windows maps the headers at the load address as well as
    # the sections. A program that wants to look at its own import
    # table reads them from there, and found nothing but zeroes
    # while only the sections were being copied.
    hsz: x_u32d(d, opt + 60)
    if hsz < 1024
        hsz: 1024
    k: 0
    as long as k < hsz
        x_w8(m, base + k, peek_byte(d, k))
        k: k + 1
    i: 0
    as long as i < nsec
        o: pe + 24 + 240 + i * 40
        va: x_u32d(d, o + 12)
        rs: x_u32d(d, o + 16)
        ra: x_u32d(d, o + 20)
        k: 0
        as long as k < rs
            x_w8(m, base + va + k, peek_byte(d, ra + k))
            k: k + 1
        i: i + 1
    x86_bind_imports(m, base, imp_rva)
    # the command line, and a return address that means "all done"
    cmd: base + X_MEM - 65536
    n: str_len(path)
    i: 0
    as long as i < n
        x_w8(m, cmd + i, peek_byte(path, i))
        i: i + 1
    x_w8(m, cmd + n, 0)
    poke_i64(m, 248, cmd)
    x_setup_tls(m)
    x_set_sp(m, base + X_MEM - 262144)
    x_push(m, peek_i64(m, 320))
    x_set_rip(m, base + entry_rva)
    return 1

# Hand the program its command line, the way Windows does. Must be
# called after loading, because the loader chooses where it goes.
x_set_cmdline m line:
    p: peek_i64(m, 248)
    if p is 0
        return 0
    n: str_len(line)
    if n > 4000
        n: 4000
    i: 0
    as long as i < n
        x_w8(m, p + i, peek_byte(line, i))
        i: i + 1
    x_w8(m, p + n, 0)
    return 1

x_u32d d a:
    return peek_byte(d, a) + peek_byte(d, a + 1) * 256 + peek_byte(d, a + 2) * 65536 + peek_byte(d, a + 3) * 16777216

# Point every imported name at an address of our own. When the code
# calls it, the loop notices and answers instead.
x86_bind_imports m base imp_rva:
    if imp_rva is 0
        return 0
    tb: base + 201326592
    poke_i64(m, 280, tb)
    names: peek_i64(m, 288)
    count: 0
    k: 0
    going: 1
    as long as going is 1
        desc: base + imp_rva + k * 20
        iat: x_r32(m, desc + 16)
        nm: x_r32(m, desc + 12)
        if nm is 0
            going: 0
        if not
            j: 0
            more: 1
            as long as more is 1
                slot: base + iat + j * 8
                v: x_r64(m, slot)
                if v is 0
                    more: 0
                if not
                    fname: x_cstr(m, base + x_lo(v) + 2)
                    names: list_add(names, fname)
                    x_w64(m, slot, tb + count * 16)
                    count: count + 1
                    j: j + 1
            k: k + 1
    poke_i64(m, 288, names)
    poke_i64(m, 312, count)
    return count

# a run of bytes in guest memory, up to the zero, as text
x_cstr m a:
    n: 0
    as long as x_r8(m, a + n) is not 0
        n: n + 1
        if n > 250
            n: 250
            return as text x_grab(m, a, n)
    return as text x_grab(m, a, n)

x_grab m a n:
    s: mem_new(n + 1)
    i: 0
    as long as i < n
        poke_byte(s, i, x_r8(m, a + i))
        i: i + 1
    poke_byte(s, i, 0)
    return s

# ---------------------------------------------------------------
# a whole run, start to finish
# ---------------------------------------------------------------
#
# Work out what kind of file it is, load it, run it, and hand back
# what it printed. Returns "" when the file cannot be run.

x86_load m path:
    d: file_read_all(path)
    if d is 0
        return 0
    b0: peek_byte(d, 0)
    b1: peek_byte(d, 1)
    if b0 is 77
        if b1 is 90
            return x86_load_pe(m, path)
    if b0 is 127
        if b1 is 69
            return x86_load_elf(m, path)
    return x86_load_macho(m, path)

# a short word for why it stopped
x86_reason m:
    w: peek_i64(m, 168)
    if w is X_EXITED
        return "done"
    if w is X_BADOP
        return "an instruction it does not know"
    if w is X_TOOLONG
        return "it ran too long"
    if w is X_RAWSYS
        return "a raw syscall, which does not work there"
    if w is X_FAULT
        return "it divided by nothing"
    if w is X_OOB
        return "it reached outside its own memory"
    return "still running"
