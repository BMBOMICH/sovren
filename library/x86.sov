    ka: x_up_kind(m)
    sa: x_up_sign(m)
    ea: x_up_exp(m)
    fa: x_up_frac(m)
    x_unpack(m, b)
    kb: x_up_kind(m)
    sb: x_up_sign(m)
    eb: x_up_exp(m)
    fb: x_up_frac(m)
    if ka is X_F_NAN
        return X_QNAN
    if kb is X_F_NAN
        return X_QNAN
    if ka is X_F_INF
        if kb is X_F_INF
            if sa is not sb
                return X_QNAN
            return a
        return a
    if kb is X_F_INF
        return b
