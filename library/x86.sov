x_sqrt_loop m ee hi lo:
    r: 0
    rem: 0
    i: 0
    as long as i < 54
        pos: 106 - 2 * i
        two: 0
        if pos >= 64
            two: x_and(x_shr64(hi, pos - 64), 3)
        if not
            two: x_and(x_shr64(lo, pos), 3)
        rem: x_add(x_shl64(rem, 2), two)
        t: x_add(x_shl64(r, 2), 1)
        r: x_add(r, r)
        if x_ult(rem, t) is 0
            rem: x_sub(rem, t)
            r: r + 1
