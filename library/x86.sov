        f: x_shr64(h, sh - 64)
        if sh is 64
            guard: x_bit(l, 63)
            if x_and(l, 9223372036854775807) is not 0
                sticky: 1
        if not
            guard: x_bit(h, sh - 65)
            if l is not 0
                sticky: 1
            if sh > 65
                if x_and(h, x_sub(x_shl64(1, sh - 65), 1)) is not 0
                    sticky: 1
