# the bottom stay in the sum where the rounding can see them. That is
# simpler than carrying guard bits alongside, and it is right: three
# spare bits are exactly what round-to-nearest needs.
x_add_aligned m sa ea fa sb eb fb:
    s1: sa
    e1: ea
    f1: fa
    s2: sb
    e2: eb
    f2: fb
    # the one with the bigger exponent goes first; on a tie, the
    # bigger fraction, so the subtraction below cannot go negative
    swap: 0
    if e2 > e1
        swap: 1
    if e2 is e1
        if f2 > f1
            swap: 1
    if swap is 1
        s1: sb
        e1: eb
        f1: fb
        s2: sa
        e2: ea
        f2: fa
    d: e1 - e2
    big: x_shl64(f1, 3)
    small: 0
    if d > 60
