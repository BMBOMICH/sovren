    # how many bits the fraction has
    nb: 0
    i: 63
    as long as i >= 0
        if x_bit(f, i) is 1
            nb: i + 1
            i: 0 - 1
        if not
            i: i - 1
    sh: 108 - nb
    if sh % 2 is not 0
        sh: sh - 1
