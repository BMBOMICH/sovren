use file
use sys
lock_take path:
    if file_exists(path) is 1 -> return 0
    return file_write_all(path, "1")
lock_drop path:
    return file_delete(path)
mutex_new:
    p: _sov_alloc(8)
    atomic_store(p, 0)
    return p
mutex_try m:
    old: atomic_swap(m, 1)
    if old is 0 -> return 1
mutex_lock m:
    old: atomic_swap(m, 1)
    as long as old is 1
        old: atomic_swap(m, 1)
mutex_unlock m:
    atomic_store(m, 0)
