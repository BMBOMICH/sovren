tp_js: 0
tp_ts: 0
# C / JS / TS expression lowering and target runtime preambles.
tp_num s:
    s: tp_validate_number(s)
    if tp_js = 1
        return str_join3("BigInt.asIntN(64,", s, "n)")
    return str_join3("((int64_t)UINT64_C(", s, "))")

tp_binary left op right:
    if tp_eq(op, "is") = 1 or tp_eq(op, "=") = 1
        op: "=="
    if tp_eq(op, "and") = 1 or tp_eq(op, "or") = 1
        if tp_eq(op, "and") = 1
            op: "&&"
        if not
            op: "||"
        if tp_js = 1
            return str_cat(str_join3("(((", left, ")!==0n)"), str_cat(op, str_join3("((", right, ")!==0n)?1n:0n)")))
        return str_cat(str_join3("((", left, ")"), str_cat(op, str_join3("(", right, "))")))
    p: tp_prec(op)
    if p <= 4
        ex: str_cat(str_join3("((", left, ")"), str_cat(op, str_join3("(", right, "))")))
        if tp_js = 1
            return str_join3("(", ex, "?1n:0n)")
        return ex
    fn: "sv_add"
    if tp_eq(op, "-") = 1
        fn: "sv_sub"
    if tp_eq(op, "*") = 1
        fn: "sv_mul"
    if tp_eq(op, "/") = 1
        fn: "sv_div"
    if tp_eq(op, "%") = 1
        fn: "sv_mod"
    return str_cat(str_join3(fn, "(", left), str_join3(",", right, ")"))

tp_string tok:
    n: str_len(tok)
    quote: peek_byte(tok, 0)
    if quote != 34 and quote != 39
        tp_fail("expected text literal")
    if peek_byte(tok, n - 1) != quote
        tp_fail("unterminated text")
    r: "\""
    i: 1
    as long as i < n - 1
        c: peek_byte(tok, i)
        if c = 92
            r: str_cat(r, str_cut(tok, i, i + 2))
            i: i + 2
        if not
            if c = 34
                r: str_cat(r, "\\")
            r: str_cat(r, str_cut(tok, i, i + 1))
            i: i + 1
    return str_cat(r, "\"")

tp_signature fn:
    name: as text _sov_list_get(fn, 0)
    ps: _sov_list_get(fn, 1)
    if tp_js = 1
        tp_emit("function ")
    if not
        tp_emit("static int64_t ")
    tp_emit(str_join3("svf_", name, "("))
    i: 0
    as long as i < _sov_list_len(ps)
        if i > 0
            tp_emit(",")
        if tp_js = 0
            tp_emit("int64_t ")
        tp_emit(str_cat("svv_", as text _sov_list_get(ps, i)))
        if tp_ts = 1
            tp_emit(": bigint")
        i: i + 1
    if tp_js = 0 and i = 0
        tp_emit("void")
    tp_emit(")")
    if tp_ts = 1
        tp_emit(": bigint")
    return 0



tp_lower_expr id:
    node: _sov_list_get(sir_nodes, id)
    kind: as text _sov_list_get(node, 0)
    text: as text _sov_list_get(node, 1)
    if tp_eq(kind, "integer") = 1
        return tp_num(text)
    if tp_eq(kind, "negative-integer") = 1
        value: tp_num(text)
        if tp_js = 1
            return str_join3("BigInt.asIntN(64,-(", value, "))")
        return str_join3("((int64_t)(UINT64_C(0)-(uint64_t)(", value, ")))")
    if tp_eq(kind, "local") = 1
        return str_cat("svv_", text)
    if tp_eq(kind, "binary") = 1
        left: tp_lower_expr(_sov_list_get(node, 2))
        right: tp_lower_expr(_sov_list_get(node, 3))
        if tp_js = 0 and tp_eq(text, "and") = 0 and tp_eq(text, "or") = 0
            lt: tp_temporary(_sov_list_get(node, 2))
            rt: tp_temporary(_sov_list_get(node, 3))
            prefix: str_join3("(", lt, "=")
            prefix: str_cat(prefix, left)
            prefix: str_cat(prefix, str_join3(",", rt, "="))
            prefix: str_cat(prefix, right)
            return str_cat(prefix, str_join3(",", tp_binary(lt, text, rt), ")"))
        return tp_binary(left, text, right)
    if tp_eq(kind, "call") = 1
        fn: _sov_list_get(tp_funcs, _sov_list_get(node, 7))
        result: str_join3("svf_", as text _sov_list_get(fn, 0), "(")
        children: _sov_list_get(node, 4)
        sequence: "("
        i: 0
        as long as i < _sov_list_len(children)
            if i > 0
                result: str_cat(result, ",")
            child: _sov_list_get(children, i)
            value: tp_lower_expr(child)
            if tp_js = 0
                temporary: tp_temporary(child)
                sequence: str_cat(sequence, str_join3(temporary, "=", value))
                sequence: str_cat(sequence, ",")
                value: temporary
            result: str_cat(result, value)
            i: i + 1
        result: str_cat(result, ")")
        if tp_js = 0 and i > 0
            return str_cat(sequence, str_cat(result, ")"))
        return result
    tp_fail("unknown SIR expression kind")
    return as text ""

tp_entry mainargs:
    if tp_js = 1
        tp_emit("process.exit(Number(BigInt.asUintN(8,svf_main(")
    if not
        tp_emit("int main(int argc,char **argv){return (unsigned char)svf_main(")
    if mainargs > 0
        if tp_js = 1
            tp_emit("BigInt(process.argv.length-1)")
        if not
            tp_emit("argc")
    if mainargs > 1
        if tp_js = 1
            tp_emit(",0n")
        if not
            tp_emit(",0")
    if tp_js = 1
        tp_emit("))));\n")
    if not
        tp_emit(");}\n")
    return 0

tp_lower_statement statement:
    kind: as text _sov_list_get(statement, 2)
    root: _sov_list_get(statement, 3)
    text: as text _sov_list_get(statement, 4)
    auxiliary: _sov_list_get(statement, 5)
    expression: ""
    if root >= 0
        expression: tp_lower_expr(root)
    if tp_eq(kind, "if") = 1 or tp_eq(kind, "while") = 1
        if tp_js = 1
            expression: str_join3("(", expression, ")!==0n")
        tp_emit(str_join3(kind, " (", expression))
        tp_emit(") {\n")
        return 0
    if tp_eq(kind, "end") = 1
        return tp_emit("}\n")
    if tp_eq(kind, "else") = 1
        return tp_emit("else {\n")
    if tp_eq(kind, "break") = 1
        return tp_emit("break;\n")
    if tp_eq(kind, "print-text") = 1
        if auxiliary >= 0
            count: tp_lower_expr(auxiliary)
            if tp_js = 1
                tp_emit(str_join3("for(let sv_repeat=0n;sv_repeat<", count, ";sv_repeat++){\n"))
            if not
                tp_emit(str_join3("for(int64_t sv_repeat=0;sv_repeat<", count, ";sv_repeat++){\n"))
        literal: tp_string(text)
        if tp_js = 1
            tp_emit(str_join3("console.log(", literal, ");\n"))
        if not
            tp_emit(str_join3("puts(", literal, ");\n"))
        if auxiliary >= 0
            tp_emit("}\n")
        return 0
    if tp_eq(kind, "print-i64") = 1
        if tp_js = 1
            return tp_emit(str_join3("console.log((", expression, ").toString());\n"))
        return tp_emit(str_join3("printf(\"%lld\\\\n\",(long long)(", expression, "));\n"))
    if tp_eq(kind, "return") = 1
        return tp_emit(str_join3("return ", expression, ";\n"))
    if tp_eq(kind, "return-default") = 1
        return tp_emit(str_join3("return ", tp_num("0"), ";\n"))
    if tp_eq(kind, "assign") = 1
        tp_emit(str_join3("svv_", text, "="))
        return tp_emit(str_cat(expression, ";\n"))
    if tp_eq(kind, "expression") = 1
        return tp_emit(str_cat(expression, ";\n"))
    tp_fail("unknown SIR statement kind")
    return 0

tp_lower_module:
    tp_output: _sov_list_new()
    tp_preamble()
    f: 0
    cursor: 0
    node_cursor: 0
    as long as f < _sov_list_len(tp_funcs)
        fn: _sov_list_get(tp_funcs, f)
        tp_signature(fn)
        tp_emit(" {\n")
        if tp_js = 0
            as long as node_cursor < _sov_list_len(sir_nodes)
                node: _sov_list_get(sir_nodes, node_cursor)
                if _sov_list_get(node, 6) != f
                    leave
                tp_emit(str_join3("int64_t ", tp_temporary(node_cursor), ";\n"))
                node_cursor: node_cursor + 1
        locals: _sov_list_get(fn, 3)
        j: 0
        as long as j < _sov_list_len(locals)
            name: as text _sov_list_get(locals, j)
            if tp_js = 1
                tp_emit(str_join3("let svv_", name, "=0n;\n"))
            if not
                tp_emit(str_join3("int64_t svv_", name, "=0;\n"))
            j: j + 1
        as long as cursor < _sov_list_len(sir_statements)
            statement: _sov_list_get(sir_statements, cursor)
            if _sov_list_get(statement, 0) != f
                leave
            tp_lower_statement(statement)
            cursor: cursor + 1
        tp_emit("}\n")
        f: f + 1
    mainfn: _sov_list_get(tp_funcs, tp_get(tp_symbols, "main") - 1)
    tp_entry(_sov_list_len(_sov_list_get(mainfn, 1)))
    return tp_flush()

tp_temporary id:
    return str_cat("sv_expr_", num_text(id))
