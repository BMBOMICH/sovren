use sys
use num
use string
key_raw_on:
    t: _sov_alloc(64)
    sys_ioctl(0, 21505, t)
    flags: peek_i64(t, 12)
    flags: flags - (flags % 65536)
    poke_i64(t, 12, flags)
    sys_ioctl(0, 21506, t)
    return 1
key_read:
    b: _sov_alloc(2)
    n: sys_read(0, b, 1)
    if n < 1 -> return 0 - 1
    return peek_byte(b, 0)
key_waiting:
    return key_waiting_for(0)
key_waiting_for ms:
    p: _sov_alloc(16)
    poke_u32(p, 0, 0)
    poke_u16(p, 4, 1)
    poke_u16(p, 6, 0)
    if sys_poll(p, 1, ms) < 1 -> return 0
    return 1
key_read_now:
    if key_waiting() is 0 -> return 0 - 2
    return key_read()
key_read_soon ms:
    if key_waiting_for(ms) is 0 -> return 0 - 2
    return key_read()
key_line cap:
    buf: _sov_alloc(cap + 1)
    i: 0
    as long as i < cap
        c: key_read()
        if c < 0
            poke_byte(buf, i, 0)
            return as text buf
        if c is 10
            poke_byte(buf, i, 0)
            return as text buf
        if c is 13
            poke_byte(buf, i, 0)
            return as text buf
        poke_byte(buf, i, c)
        i: i + 1
    poke_byte(buf, i, 0)
    return as text buf
input_line:
    return as text key_line(512)
input_num:
    return str_num(key_line(64))
input_ask q:
    _sov_print(q)
    return as text key_line(512)
input_yes q:
    _sov_print(q)
    a: key_line(8)
    if str_len(a) is 0 -> return 0
    c: peek_byte(a, 0)
    if c is 121 -> return 1
    if c is 89 -> return 1
