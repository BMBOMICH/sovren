# key.sov — read keys from the keyboard

use sys
key_raw_on:
    t: _sov_alloc(64)
    sys_ioctl(0, 21505, t)
    flags: peek_i64(t, 12)
    flags: flags - (flags % 65536)
    poke_i64(t, 12, flags)
    sys_ioctl(0, 21506, t)
    return 1

key_read:
    b: _sov_alloc(2)
    n: sys_read(0, b, 1)
    if n < 1
        return 0 - 1
    return peek_byte(b, 0)

key_line cap:
    buf: _sov_alloc(cap + 1)
    i: 0
    as long as i < cap
        c: key_read()
        if c < 0
            poke_byte(buf, i, 0)
            return as text buf
        if c is 10
            poke_byte(buf, i, 0)
            return as text buf
        if c is 13
            poke_byte(buf, i, 0)
            return as text buf
        poke_byte(buf, i, c)
        i: i + 1
    poke_byte(buf, i, 0)
    return as text buf
