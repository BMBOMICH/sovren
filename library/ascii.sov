# ascii.sov — what kind of byte is this

ascii_digit c:
    if c > 47
        if c < 58
            return 1
    return 0

ascii_letter c:
    if c > 64
        if c < 91
            return 1
    if c > 96
        if c < 123
            return 1
    return 0

ascii_space c:
    if c is 32
        return 1
    if c is 9
        return 1
    if c is 10
        return 1
    if c is 13
        return 1
    return 0

ascii_print c:
    if c > 31
        if c < 127
            return 1
    return 0
