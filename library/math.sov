# math.sov — numbers

abs x:
    if x < 0
        return 0 - x
    return x

min a b:
    if a < b
        return a
    return b

max a b:
    if a > b
        return a
    return b

clamp x lo hi:
    if x < lo
        return lo
    if x > hi
        return hi
    return x

sign x:
    if x < 0
        return 0 - 1
    if x > 0
        return 1
    return 0

gcd a b:
    x: abs(a)
    y: abs(b)
    as long as y > 0
        t: x % y
        x: y
        y: t
    return x

pow_int b e:
    r: 1
    i: 0
    as long as i < e
        r: r * b
        i: i + 1
    return r
