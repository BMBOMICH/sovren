use web
use jsonp
use string
use num
use mem
use list
use tool
use file
use tls
DC_MAX: 32
DC_API: "https://discord.com/api/v10"
dc_new token:
    d: mem_new(64)
    i: 0
    as long as i < 64
        poke_byte(d, i, 0)
        i: i + 1
    poke_i64(d, 0, token)
    poke_i64(d, 24, mem_new(DC_MAX * 8))
    return d
dc_ready:
    return web_secure_ready()
dc_base d url:
    poke_i64(d, 40, url)
dc_url d path:
    b: peek_i64(d, 40)
    if b is 0 -> return as text str_cat(DC_API, path)
    return as text str_cat(as text b, path)
dc_call d method path body:
    if web_secure_ready() is 0
        poke_i64(d, 16, 0)
        return blank
    url: dc_url(d, path)
    host: web_host(url)
    port: web_port(url)
    req: str_cat(method, " ")
    req: str_cat(req, path)
    req: str_cat(req, " HTTP/1.1\r\nHost: ")
    req: str_cat(req, host)
    req: str_cat(req, "\r\nAuthorization: Bot ")
    req: str_cat(req, as text peek_i64(d, 0))
    if str_len(body) > 0
        req: str_cat(req, "\r\nContent-Type: application/json\r\nContent-Length: ")
        req: str_cat(req, num_text(str_len(body)))
    req: str_cat(req, "\r\nConnection: close\r\n\r\n")
    if str_len(body) > 0 -> req: str_cat(req, body)
    out: _sov_heap_alloc(60000)
    n: tl_send_req(host, port, req, out, 60000)
    if n > 0
        poke_byte(out, n, 0)
        r: web_body(as text out)
        poke_i64(d, 16, r)
        return as text r
    if web_find_helper() is 0
        poke_i64(d, 16, 0)
        return blank
    a: list_new()
    a: list_add(a, "-s")
    a: list_add(a, "-X")
    a: list_add(a, method)
    a: list_add(a, "-H")
    a: list_add(a, as text str_cat("Authorization: Bot ", as text peek_i64(d, 0)))
    if str_len(body) > 0
        file_write_all("/tmp/sov-dc-body", body)
        a: list_add(a, "-H")
        a: list_add(a, "Content-Type: application/json")
        a: list_add(a, "--data-binary")
        a: list_add(a, "@/tmp/sov-dc-body")
    a: list_add(a, dc_url(d, path))
    r: tool_outv("/usr/bin/curl", a)
    poke_i64(d, 16, r)
    return as text r
dc_me d:
    r: dc_call(d, "GET", "/users/@me", "")
    if str_len(r) is 0 -> return blank
    return as text jp_get(r, "username")
dc_say d channel words:
    body: "{\"content\":"
    body: str_cat(body, web_quote(words))
    body: str_cat(body, "}")
    path: str_cat("/channels/", channel)
    path: str_cat(path, "/messages")
    r: dc_call(d, "POST", as text path, as text body)
    if str_len(r) is 0 -> return 0
    return 1
dc_reply d channel to words:
    body: "{\"content\":"
    body: str_cat(body, web_quote(words))
    body: str_cat(body, ",\"message_reference\":{\"message_id\":\"")
    body: str_cat(body, to)
    body: str_cat(body, "\"}}")
    path: str_cat("/channels/", channel)
    path: str_cat(path, "/messages")
    r: dc_call(d, "POST", as text path, as text body)
    if str_len(r) is 0 -> return 0
    return 1
dc_read d channel:
    path: str_cat("/channels/", channel)
    path: str_cat(path, "/messages?limit=10")
    r: dc_call(d, "GET", as text path, "")
    poke_i64(d, 8, 0)
    if str_len(r) is 0 -> return 0
    return dc_split(d, r)
dc_split d r:
    n: 0
    i: 0
    as long as i < str_len(r)
        if peek_byte(r, i) is 91
            i: i + 1
            i: i - 1
            i: i + 1
            slots: peek_i64(d, 24)
            depth: 0
            start: 0 - 1
            as long as i < str_len(r)
                c: peek_byte(r, i)
                if c is 123
                    if depth is 0 -> start: i
                    depth: depth + 1
                if c is 125
                    depth: depth - 1
                    if depth is 0
                        if n < DC_MAX
                            poke_i64(slots, n * 8, str_cut(r, start, i + 1))
                            n: n + 1
                i: i + 1
            poke_i64(d, 8, n)
            return n
        i: i + 1
dc_count d:
    return peek_i64(d, 8)
dc_raw d i:
    if i < 0 -> return blank
    if i >= peek_i64(d, 8) -> return blank
    return as text peek_i64(peek_i64(d, 24), i * 8)
dc_text d i:
    return as text jp_get(dc_raw(d, i), "content")
dc_id d i:
    return as text jp_get(dc_raw(d, i), "id")
dc_from d i:
    return as text jp_get(dc_raw(d, i), "username")
dc_channel d channel:
    path: str_cat("/channels/", channel)
    return dc_call(d, "GET", as text path, "")
dc_last d:
    v: peek_i64(d, 16)
    if v is 0 -> return blank
    return as text v
