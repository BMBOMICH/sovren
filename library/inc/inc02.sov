compile_host src dst:
    sys_unlink(dst)
    av: _sov_heap_alloc(48)
    n: 0
    n: aadd(av, n, str_cat(ROOTS, '/sovren'))
    n: aadd(av, n, src)
    n: aadd(av, n, '-o')
    n: aadd(av, n, dst)
    aend(av, n)
    spawn_cd(ROOTS, av, 120)
WW: 360
WH: 230
ev_push type x y:
    w: peek_raw64(EVW, 0)
    q: EVQ + band(w, 31) * 24
    poke_raw64(q, 0, type)
    poke_raw64(q + 8, 0, x)
    poke_raw64(q + 16, 0, y)
    poke_raw64(EVW, 0, w + 1)
    poke_raw64(EVN, 0, peek_raw64(EVN, 0) + 1)
ev_pop:
    r: peek_raw64(EVR, 0)
    if r >= peek_raw64(EVN, 0) -> return 0
    poke_raw64(EVR, 0, r + 1)
    return EVQ + band(r, 31) * 24
ev_x q:
    return peek_raw64(q + 8, 0)
ev_y q:
    return peek_raw64(q + 16, 0)
ev_t q:
ev_hit mx my x y w h:
    if mx < x -> return 0
    if mx >= x + w -> return 0
    if my < y -> return 0
    if my >= y + h -> return 0
    return 1
win_x w:
    return peek_raw64(WXCELL + w * 8, 0)
win_y w:
    return peek_raw64(WYCELL + w * 8, 0)
win_at x y:
    if peek_raw64(TOPW, 0) = 1 -> if ev_hit(x, y, win_x(1), win_y(1), WW, WH) = 1
            return 1
        if ev_hit(x, y, win_x(0), win_y(0), WW, WH) = 1 -> return 0
        return 0 - 1
    if ev_hit(x, y, win_x(0), win_y(0), WW, WH) = 1 -> return 0
    if peek_raw64(CLOSED, 0) = 0 -> if ev_hit(x, y, win_x(1), win_y(1), WW, WH) = 1
            return 1
    return 0 - 1
TITF: 5263562
win_draw w:
    wx: win_x(w)
    wy: win_y(w)
    fill_rect(wx, wy, WW, WH, WBRD)
    fill_rect(wx + 3, wy + 3, WW - 6, WH - 6, WBDY)
    if peek_raw64(FOC, 0) = w -> fill_rect(wx + 3, wy + 3, WW - 6, 22, TITF)
    if not -> fill_rect(wx + 3, wy + 3, WW - 6, 22, TITU)
    fill_rect(wx + WW - 24, wy + 6, 18, 14, 12570666)
    rect_border(wx + WW - 24, wy + 6, 18, 14, INKW)
    damage_note()
