a_ldseg d fszn o bias:
    poff: peek_i64(d, o + 8)
    pva: peek_i64(d, o + 16)
    pfsz: peek_i64(d, o + 32)
    pmsz: peek_i64(d, o + 40)
    endv: poff + pfsz
    if u64_lt(fszn, endv) = 1 -> return 0
    j: 0
    as long as j < pmsz
        sv: 0
        if j < pfsz -> sv: peek_byte(d, poff + j)
        poke_byte(a_m, pva + bias + j, sv)
        j: j + 1
    return 1

arm64_outbyte a i:
    ob: peek_i64(a_m, 524552)
    return peek_byte(ob, i)

arm64_am a:
    return a_m
