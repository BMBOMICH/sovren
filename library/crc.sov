# crc.sov — CRC-32 of bytes
# needs _sov_list
use bit

crc32_step crc b:
    c: bit_xor(crc % 256, b % 256)
    i: 0
    as long as i < 8
        if c % 2 is 1
            c: bit_xor(c / 2, 3988292384)
        if not
            c: c / 2
        i: i + 1
    return bit_xor(crc / 256, c)

crc32 p n:
    crc: 4294967295
    i: 0
    as long as i < n
        crc: crc32_step(crc, peek_byte(p, i))
        i: i + 1
    return bit_xor(crc, 4294967295)
