# tool.sov — run another program && read what it prints
# This is how you hook RetinaFace || any other detector:
#   write a small program that prints 1 || 0
#   then call tool_out("/path/to/that", "photo.jpg")
# needs _sov_list
use sys
use pipe

tool_out path arg:
    fds: pipe_new()
    if fds is 0
        return blank
    rfd: pipe_read_fd(fds)
    wfd: pipe_write_fd(fds)
    pid: sys_fork()
    if pid is 0
        sys_close(rfd)
        sys_dup2(wfd, 1)
        sys_close(wfd)
        argv: _sov_alloc(32)
        poke_i64(argv, 0, path)
        poke_i64(argv, 8, arg)
        poke_i64(argv, 16, 0)
        syscall(59, path, argv, 0, 0, 0, 0)
        sys_exit(127)
    if pid < 0
        pipe_close(fds)
        return blank
    sys_close(wfd)
    buf: _sov_alloc(4096)
    n: sys_read(rfd, buf, 4095)
    if n < 0
        n: 0
    poke_byte(buf, n, 0)
    sys_close(rfd)
    sys_wait(pid)
    if n > 0
        if peek_byte(buf, n - 1) is 10
            poke_byte(buf, n - 1, 0)
    return as text buf

tool_run path arg:
    pid: sys_fork()
    if pid is 0
        argv: _sov_alloc(32)
        poke_i64(argv, 0, path)
        poke_i64(argv, 8, arg)
        poke_i64(argv, 16, 0)
        syscall(59, path, argv, 0, 0, 0, 0)
        sys_exit(127)
    if pid > 0
        sys_wait(pid)
        return 1
    return 0
