# testrun.sov — run Sovren programs and check what they print.
#
# This is what a test suite needs: write a small program, compile it,
# run it, and compare the output with what you expected. All of it in
# Sovren, so the tests are written in the language they test.

use file
use tool
use string
use num
use x86

tr_pass: 0
tr_fail: 0

# where the compiler is. set this once at the start.
tr_sov: 0

tr_use compiler:
    tr_sov: compiler
    return 1

# a shell line, written to a file and run, so we get its output.
# tool_out hands the child one argument only, hence the script.
tr_shell line:
    body: "#!/bin/sh\n"
    body: str_cat(body, line)
    body: str_cat(body, "\n")
    file_write_all("/tmp/sov-tr.sh", body)
    return as text tool_out("/bin/sh", "/tmp/sov-tr.sh")

# compile a source file, return what the compiler said
tr_build src out:
    line: as text tr_sov
    line: str_cat(line, " ")
    line: str_cat(line, src)
    line: str_cat(line, " -o ")
    line: str_cat(line, out)
    line: str_cat(line, " 2>&1")
    return as text tr_shell(line)

# compile for another machine
tr_build_for src out flag:
    line: as text tr_sov
    line: str_cat(line, " ")
    line: str_cat(line, src)
    line: str_cat(line, " ")
    line: str_cat(line, flag)
    line: str_cat(line, " -o ")
    line: str_cat(line, out)
    line: str_cat(line, " 2>&1")
    return as text tr_shell(line)

# run a built program and return what it printed
tr_run path:
    return as text tr_shell(str_cat(path, " 2>&1"))

# say how it went
tr_ok name:
    write_out("ok ")
    print as text name
    tr_pass: tr_pass + 1
    return 1

tr_bad name got want:
    write_out("FAIL ")
    print as text name
    write_out("  got  ")
    print as text got
    write_out("  want ")
    print as text want
    tr_fail: tr_fail + 1
    return 0

# the common case: this source should print this
tr_expect name src want:
    file_write_all("/tmp/sov-tr.sov", src)
    msg: tr_build("/tmp/sov-tr.sov", "/tmp/sov-tr.bin")
    if str_has(msg, "Error") is 1
        tr_bad(name, msg, want)
        return 0
    got: str_trim(tr_run("/tmp/sov-tr.bin"))
    if str_eq(got, want) is 1
        return tr_ok(name)
    return tr_bad(name, got, want)

# this source must be refused by the compiler
tr_reject name src:
    file_write_all("/tmp/sov-tr.sov", src)
    msg: tr_build("/tmp/sov-tr.sov", "/tmp/sov-tr.bin")
    if str_has(msg, "Error") is 1
        return tr_ok(name)
    return tr_bad(name, "it compiled", "an error")

# this source must build without complaint
tr_builds name src:
    file_write_all("/tmp/sov-tr.sov", src)
    msg: tr_build("/tmp/sov-tr.sov", "/tmp/sov-tr.bin")
    if str_has(msg, "Error") is 1
        return tr_bad(name, msg, "a clean build")
    if str_has(msg, "Warning") is 1
        return tr_bad(name, msg, "no warnings")
    return tr_ok(name)

# and for another machine
tr_builds_for name src flag:
    file_write_all("/tmp/sov-tr.sov", src)
    msg: tr_build_for("/tmp/sov-tr.sov", "/tmp/sov-tr.bin", flag)
    if str_has(msg, "Error") is 1
        return tr_bad(name, msg, "a clean build")
    return tr_ok(name)

# the tally at the end. returns 0 when everything passed.
tr_report:
    print ""
    write_out(num_text(tr_pass))
    write_out(" passed, ")
    write_out(num_text(tr_fail))
    print " failed"
    if tr_fail is 0
        print "all checks passed"
        return 0
    print "some checks failed"
    return 1

# ---- running for another machine, on the emulator written in Sovren ----
#
# Build this source for Windows or for Mac, run the result on the
# x86 emulator in library/x86.sov, and compare what it printed. No
# Wine, no Python, no Unicorn: Sovren checks its own output by
# running it.

tr_emu name src want flag:
    file_write_all("/tmp/sov-tr.sov", src)
    msg: tr_build_for("/tmp/sov-tr.sov", "/tmp/sov-tr.out", flag)
    if str_has(msg, "Error") is 1
        return tr_bad(name, msg, "a clean build")
    m: x86_new()
    if x86_load(m, "/tmp/sov-tr.out") is 0
        return tr_bad(name, "could not load it", want)
    x86_run(m)
    if x86_why(m) is not 1
        return tr_bad(name, x86_reason(m), want)
    got: str_trim(x86_out(m))
    if str_eq(got, want) is 1
        return tr_ok(name)
    return tr_bad(name, got, want)

# this source, built for that machine, must be REFUSED by the
# emulator. Used to prove the strict rules really bite.
tr_emu_reject name src flag why:
    file_write_all("/tmp/sov-tr.sov", src)
    tr_build_for("/tmp/sov-tr.sov", "/tmp/sov-tr.out", flag)
    m: x86_new()
    x86_load(m, "/tmp/sov-tr.out")
    x86_run(m)
    if x86_why(m) is why
        return tr_ok(name)
    return tr_bad(name, x86_reason(m), "a refusal")
