use string
use list
use split

rsz lay:
    return list_len(lay) * 8

ral lay:
    p: _sov_alloc(rsz(lay))
    i: 0
    as long as i < rsz(lay)
        poke_byte(p, i, 0)
        i: i + 1
    return p

rsl lay name:
    i: 0
    as long as i < list_len(lay)
        if str_eq(list_get(lay, i), name) is 1
            return i
        i: i + 1
    return 0 - 1
