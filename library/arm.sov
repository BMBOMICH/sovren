    k: 0
    as long as k < dynsz
        tag: arm_r64(m, dynva + k)
        val: arm_r64(m, dynva + k + 8)
        if tag is 5 -> strtab: val
        if tag is 6 -> symtab: val
        if tag is 11 -> syment: val
        if tag is 0 -> k: dynsz
        if not -> k: k + 16
    if symtab is 0 -> return 0
    want: _sov_strlen(name)
    i: 1
    as long as i < 64
        sp: symtab + i * syment
        nameoff: arm_r8(m, sp) + arm_r8(m, sp + 1) * 256 + arm_r8(m, sp + 2) * 65536 + arm_r8(m, sp + 3) * 16777216
        value: arm_r64(m, sp + 8)
        if value > 0
            if arm_name_is(m, strtab + nameoff, name, want) is 1 -> return value
        i: i + 1
arm_name_is m at name n:
    i: 0
    as long as i < n
        if arm_r8(m, at + i) is not peek_byte(name, i) -> return 0
        i: i + 1
    if arm_r8(m, at + n) is not 0 -> return 0
    return 1
arm_run_symbol m name:
    a: arm_symbol(m, name)
    if a is 0 -> return 0 - 1
    arm_set_pc(m, a)
    return arm_run(m)
