# toml.sov — read simple key = value files
use file
use string
use list

toml_get path key:
    t: file_read_all(path)
    if t is 0
        return as text ""
    n: str_len(t)
    start: 0
    i: 0
    as long as i <= n
        stop: 0
        if i is n
            stop: 1
        if not
            if peek_byte(t, i) is 10
                stop: 1
        if stop is 1
            line: str_trim(str_cut(t, start, i))
            eq: str_find(line, "=")
            if eq > 0
                k: str_trim(str_cut(line, 0, eq))
                if str_eq(k, key) is 1
                    v: str_trim(str_cut(line, eq + 1, str_len(line)))
                    if str_len(v) > 1
                        if peek_byte(v, 0) is 34
                            v: str_cut(v, 1, str_len(v) - 1)
                    return as text v
            start: i + 1
        i: i + 1
    return as text ""

toml_num path key:
    return str_num(toml_get(path, key))

toml_has path key:
    if str_len(toml_get(path, key)) > 0
        return 1
    return 0

toml_set path key value:
    line: str_join3(key, " = ", value)
    return file_append(path, str_cat(line, "\n"))
