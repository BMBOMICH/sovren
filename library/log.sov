# log.sov — print labeled lines
use sys
use string

log_line tag s:
    write_out("[")
    write_out(tag)
    write_out("] ")
    write_out(s)
    n: _sov_alloc(2)
    poke_byte(n, 0, 10)
    poke_byte(n, 1, 0)
    sys_write(1, n, 1)
    return 1

log_info s:
    return log_line("info", s)

log_err s:
    return log_line("err", s)
