# unsafe-module
sc c:
    as long as 1 is 1
        if band(port_in8(1021), 32) is not 0 -> leave
    port_out8(1016, c)
inline_sputs rdi:
    i: 0
    as long as 1 is 1
        c: peek_byte(rdi + i)
        if c is 0 -> leave
        as long as 1 is 1
            if band(port_in8(1021), 32) is not 0 -> leave
        port_out8(1016, c)
        i: i + 1
sputs s:
    i: 0
    as long as 1 is 1
        c: peek_byte(s, i)
        if c is 0 -> leave
        sc(c)
        i: i + 1
sinit:
    port_out8(1017, 0)
    port_out8(1019, 128)
    port_out8(1016, 3)
    port_out8(1017, 0)
    port_out8(1019, 3)
    port_out8(1018, 199)
    port_out8(1020, 11)
