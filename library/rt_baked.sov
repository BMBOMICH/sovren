rt_b64_val c9:
    if c9 > 64
        if c9 < 91
            return c9 - 65
    if c9 > 96
        if c9 < 123
            return c9 - 71
    if c9 > 47
        if c9 < 58
            return c9 + 4
    if c9 is 43
        return 62
    if c9 is 47
        return 63
    return 0 - 1

rt_baked_text:
    s9: rt_b64_cat()
    sn: length(s9)
    out: _sov_heap_alloc(sn)
    oi: 0
    i: 0
    as long as i + 4 <= sn
        a1: rt_b64_val(peek_byte(s9, i))
        a2: rt_b64_val(peek_byte(s9, i + 1))
        a3: rt_b64_val(peek_byte(s9, i + 2))
        a4: rt_b64_val(peek_byte(s9, i + 3))
        if a3 < 0
            a3: 0
        if a4 < 0
            a4: 0
        w9: a1 * 262144 + a2 * 4096 + a3 * 64 + a4
        dummy9: _sov_set_byte(out, oi, bshr(w9, 16))
        dummy9: _sov_set_byte(out, oi + 1, band(bshr(w9, 8), 255))
        dummy9: _sov_set_byte(out, oi + 2, band(w9, 255))
        oi: oi + 3
        i: i + 4
    dummy9: _sov_set_byte(out, oi, 0)
    return out
