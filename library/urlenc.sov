# urlenc.sov — percent encoding for web addresses
use string
use mem

ue_hexd v:
    if v < 10
        return 48 + v
    return 55 + v

ue_safe c:
    if c >= 48
        if c <= 57
            return 1
    if c >= 65
        if c <= 90
            return 1
    if c >= 97
        if c <= 122
            return 1
    if c is 45
        return 1
    if c is 95
        return 1
    if c is 46
        return 1
    if c is 126
        return 1
    return 0

ue_encode s:
    n: str_len(s)
    out: _sov_alloc(n * 3 + 1)
    o: 0
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        if ue_safe(c) is 1
            poke_byte(out, o, c)
            o: o + 1
        if not
            poke_byte(out, o, 37)
            poke_byte(out, o + 1, ue_hexd(c / 16))
            poke_byte(out, o + 2, ue_hexd(c % 16))
            o: o + 3
        i: i + 1
    poke_byte(out, o, 0)
    return as text out

ue_unhex c:
    if c >= 48
        if c <= 57
            return c - 48
    if c >= 65
        if c <= 70
            return c - 55
    if c >= 97
        if c <= 102
            return c - 87
    return 0

ue_decode s:
    n: str_len(s)
    out: _sov_alloc(n + 1)
    o: 0
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 37
            if i + 2 < n
                poke_byte(out, o, ue_unhex(peek_byte(s, i + 1)) * 16 + ue_unhex(peek_byte(s, i + 2)))
                o: o + 1
                i: i + 3
            if not
                i: n
        if not
            if c is 43
                poke_byte(out, o, 32)
            if not
                poke_byte(out, o, c)
            o: o + 1
            i: i + 1
    poke_byte(out, o, 0)
    return as text out
