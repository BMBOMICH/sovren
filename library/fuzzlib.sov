# fuzzlib.sov — random program generator and checker, written in Sovren.
#
# This is check/fuzz.py, rewritten in Sovren: it builds a random
# program — an arithmetic expression, an if condition, or a loop —
# works out the answer with its own evaluator, writes the same thing
# as a Sovren program, compiles it, runs it, and compares. A
# mismatch is a compiler bug nobody thought to test for.
#
# check/fuzz_run.sov is the driver that runs it.

use rand
use string
use num
use file
use vec
use shell

fz_seed: 12345

fz_next:
    fz_seed: (fz_seed * 1103515245 + 12345) % 2147483648
    if fz_seed < 0
        fz_seed: fz_seed + 2147483648
    return fz_seed

fz_pick n:
    if n <= 0
        return 0
    return fz_next() % n

# --- build an expression and its value at the same time ---
fz_txt: ""
fz_val: 0

fz_atom:
    v: fz_pick(50)
    fz_txt: num_text(v)
    return v

fz_build depth:
    if depth <= 0
        return fz_atom()
    if fz_pick(10) < 3
        return fz_atom()
    a: fz_build(depth - 1)
    at: fz_txt
    op: fz_pick(5)
    b: fz_build(depth - 1)
    bt: fz_txt
    if op is 3
        if b is 0
            b: 1
            bt: "1"
    if op is 4
        if b is 0
            b: 1
            bt: "1"
    r: 0
    ot: " + "
    if op is 0
        r: a + b
    if op is 1
        r: a - b
        ot: " - "
    if op is 2
        r: a * b
        ot: " * "
    if op is 3
        r: a / b
        ot: " / "
    if op is 4
        r: a % b
        ot: " % "
    fz_txt: str_join3("(", str_join3(at, ot, bt), ")")
    return r

# --- write, compile, run, compare ---
fz_try src want:
    d: file_write_all("/tmp/sovfz.sov", src)
    d: shell_sh("./sovren /tmp/sovfz.sov -o /tmp/sovfz.bin >/dev/null 2>&1")
    d: shell_sh("chmod +x /tmp/sovfz.bin 2>/dev/null; /tmp/sovfz.bin > /tmp/sovfz.out 2>&1")
    got: file_read_all("/tmp/sovfz.out")
    if got is 0
        return 0
    if str_num(str_trim(got)) is want
        return 1
    print "MISMATCH"
    print "src" : src
    print "got" : str_trim(got)
    print "want" : want
    return 0

# --- an expression: print <expr> ---
fz_expr:
    e: fz_build(3)
    src: str_join3("print ", fz_txt, "\n")
    return fz_try(src, e)

# --- a condition: if <a> <op> <b> then print 1 else print 0 ---
fz_cond:
    a: fz_build(1)
    at: fz_txt
    b: fz_build(1)
    bt: fz_txt
    op: fz_pick(6)
    want: 0
    ot: "<"
    if op is 0
        if a < b
            want: 1
    if op is 1
        ot: ">"
        if a > b
            want: 1
    if op is 2
        ot: "<="
        if a <= b
            want: 1
    if op is 3
        ot: ">="
        if a >= b
            want: 1
    if op is 4
        ot: "is"
        if a is b
            want: 1
    if op is 5
        ot: "is not"
        if a is not b
            want: 1
    src: str_join3("if ", at, " ")
    src: str_join3(src, ot, " ")
    src: str_join3(src, bt, "\n")
    src: str_join3(src, "    print 1\n", "")
    src: str_join3(src, "if not\n", "")
    src: str_join3(src, "    print 0\n", "")
    return fz_try(src, want)

# --- a loop: accumulate while idx < lim ---
fz_loop:
    lim: fz_pick(13)
    step: 1 + fz_pick(4)
    src: str_join3("acc: 0\nidx: 0\nas long as idx < ", num_text(lim), "\n")
    src: str_join3(src, "    acc: acc + idx\n", "")
    src: str_join3(src, "    idx: idx + ", num_text(step))
    src: str_join3(src, "\nprint acc\n", "")
    e: 0
    i: 0
    as long as i < lim
        e: e + i
        i: i + step
    return fz_try(src, e)

# --- one random program: expression, condition or loop ---
fz_one:
    mode: fz_pick(100)
    if mode < 55
        return fz_expr()
    if mode < 80
        return fz_cond()
    return fz_loop()

fz_run n:
    bad: 0
    i: 0
    as long as i < n
        if fz_one() is 0
            bad: bad + 1
        i: i + 1
    return bad
