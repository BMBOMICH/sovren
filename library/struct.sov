# struct.sov — named fields over a block of memory
#
# the language has no record type, so a struct here is a layout — the
# ordered list of field names — plus a block of 8-byte slots. the
# layout is a value you pass around, which means two structs with the
# same fields are interchangeable and a task can take any struct
# without knowing its shape ahead of time. fields are looked up by
# name, so reordering a layout is a source change, not a silent shift
# in what a slot means.
#
# every field is 8 bytes because that is the only width the memory
# builtins address as a value. a field that needs less still costs 8;
# a field that needs more belongs in its own allocation with a
# pointer kept in the slot.
#
# note the hoisting in struct_alloc and struct_dump: the size is put
# in a local before it reaches _sov_alloc. handing _sov_alloc a call
# expression directly makes it take a size 48 bytes larger than the
# one the call returned, and the block it hands back then overlaps
# live heap - a list allocated before the call reads back as empty
# afterwards. pinned by the check "alloc takes the size a call
# returned". until that is fixed in the compiler, hoist.
use string
use list
use split
use num

struct_new fields:
    return split_byte(fields, 44)

struct_len lay:
    return list_len(lay)

struct_size lay:
    return list_len(lay) * 8

struct_alloc lay:
    nb: struct_size(lay)
    p: _sov_alloc(nb)
    i: 0
    as long as i < nb
        poke_byte(p, i, 0)
        i: i + 1
    return p

# the slot a name lives in, or -1 when the layout has no such field
struct_slot lay name:
    n: list_len(lay)
    i: 0
    as long as i < n
        if str_eq(list_get(lay, i), name) is 1
            return i
        i: i + 1
    return 0 - 1

struct_has lay name:
    if struct_slot(lay, name) < 0
        return 0
    return 1

# 1 when the field was set, 0 when the layout does not have it. the
# return is the only signal a caller gets, so a typo in a field name
# shows up instead of quietly writing past the block
struct_set lay p name v:
    s: struct_slot(lay, name)
    if s < 0
        return 0
    off: s * 8
    poke_i64(p, off, v)
    return 1

struct_get lay p name:
    s: struct_slot(lay, name)
    if s < 0
        return 0
    off: s * 8
    return peek_i64(p, off)

# by position, for walking a struct without naming every field
struct_at lay p i:
    n: list_len(lay)
    if i < 0
        return 0
    if i >= n
        return 0
    off: i * 8
    return peek_i64(p, off)

struct_name lay i:
    n: list_len(lay)
    if i < 0
        return ""
    if i >= n
        return ""
    return str_cat(list_get(lay, i), "")

struct_copy lay src:
    d: struct_alloc(lay)
    n: list_len(lay)
    i: 0
    as long as i < n
        off: i * 8
        poke_i64(d, off, peek_i64(src, off))
        i: i + 1
    return d

# "name=value" pairs, one per line, for a dump or a test failure
struct_dump lay p:
    out: ""
    n: list_len(lay)
    i: 0
    as long as i < n
        nm: list_get(lay, i)
        off: i * 8
        out: str_cat(out, str_cat(nm, "="))
        out: str_cat(out, num_text(peek_i64(p, off)))
        out: str_cat(out, "\n")
        i: i + 1
    return out
