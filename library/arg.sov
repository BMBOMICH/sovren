# arg.sov — the words typed after the program name.
#
# The runtime keeps argc and argv from the moment the program
# starts, on every system. That is what this reads. An older
# version read /proc/self/cmdline, which only exists on Linux, so
# arguments were always empty on Windows and Mac.
# needs _sov_list

use string

arg_count:
    return _sov_argc()

# argument 0 is the program itself, 1 is the first real one
arg_at k:
    if k < 0
        return blank
    if k >= _sov_argc()
        return blank
    p: _sov_argv_get(k)
    if p is 0
        return blank
    return as text p

# every argument after the program name, as one line
arg_line:
    out: ""
    i: 1
    as long as i < _sov_argc()
        if i > 1
            out: str_cat(out, " ")
        out: str_cat(out, as text arg_at(i))
        i: i + 1
    return as text out

# is this flag present?
arg_has name:
    i: 1
    as long as i < _sov_argc()
        if str_eq(as text arg_at(i), name) is 1
            return 1
        i: i + 1
    return 0

# the word after a flag, for things like -o out.txt
arg_after name:
    i: 1
    as long as i < _sov_argc()
        if str_eq(as text arg_at(i), name) is 1
            if i + 1 < _sov_argc()
                return as text arg_at(i + 1)
            return blank
        i: i + 1
    return blank
