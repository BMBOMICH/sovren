    if kiommu_hw_enable(base, limit) is not 1
        kiommu_hw_disable(base, limit)
        return 0
    poke_raw64(record + 32, 0, root)
    poke_raw64(record + 8, 0, KIOMMU_UNIT_ACTIVE)
    return 1
kiommu_units_activate_all registry capacity count root limit:
    if registry is 0 -> return 0
    if count < 1 -> return 0
    if count > capacity -> return 0
    slot: 0
    as long as slot < count
        generation: kiommu_unit_generation(registry, capacity, slot)
        if kiommu_unit_state(registry, capacity, slot, generation) is not KIOMMU_UNIT_READY -> return 0
        slot: slot + 1
    slot: 0
    as long as slot < count
        generation: kiommu_unit_generation(registry, capacity, slot)
        if kiommu_unit_activate(registry, capacity, slot, generation, root, limit) is not 1
            rollback: slot
            as long as rollback > 0
                rollback: rollback - 1
                rollback_generation: kiommu_unit_generation(registry, capacity, rollback)
                kiommu_unit_deactivate(registry, capacity, rollback, rollback_generation, limit)
            return 0
        slot: slot + 1
    return 1
kiommu_units_global_invalidate registry capacity count limit:
    if registry is 0 -> return 0
    if count < 1 -> return 0
    if count > capacity -> return 0
    slot: 0
    as long as slot < count
        generation: kiommu_unit_generation(registry, capacity, slot)
        if kiommu_unit_state(registry, capacity, slot, generation) is not KIOMMU_UNIT_ACTIVE -> return 0
        slot: slot + 1
    slot: 0
    as long as slot < count
        record: registry + slot * KIOMMU_UNIT_STRIDE
        base: peek_raw64(record + 16, 0)
        extended: peek_raw64(record + 24, 0)
        if kiommu_hw_context_global_invalidate(base, limit) is not 1 -> return 0
        if kiommu_hw_iotlb_global_invalidate(base, extended, limit) is not 1 -> return 0
        slot: slot + 1
    return 1
kiommu_units_deactivate_all registry capacity count limit:
    if registry is 0 -> return 0
    if count < 1 -> return 0
    if count > capacity -> return 0
    slot: count
    as long as slot > 0
        slot: slot - 1
        generation: kiommu_unit_generation(registry, capacity, slot)
        if kiommu_unit_deactivate(registry, capacity, slot, generation, limit) is not 1 -> return 0
    return 1
kiommu_unit_deactivate registry capacity slot generation limit:
    if kiommu_unit_state(registry, capacity, slot, generation) is not KIOMMU_UNIT_ACTIVE -> return 0
    record: registry + slot * KIOMMU_UNIT_STRIDE
    base: peek_raw64(record + 16, 0)
    if kiommu_hw_disable(base, limit) is not 1 -> return 0
    poke_raw64(record + 32, 0, 0)
    poke_raw64(record + 8, 0, KIOMMU_UNIT_READY)
    return 1
kiommu_unit_release registry capacity slot generation:
    if kiommu_unit_state(registry, capacity, slot, generation) is not KIOMMU_UNIT_READY -> return 0
    record: registry + slot * KIOMMU_UNIT_STRIDE
    next: peek_raw64(record, 0) + 1
    if next is 0 -> next: 1
    poke_raw64(record + 16, 0, 0)
    poke_raw64(record + 24, 0, 0)
    poke_raw64(record + 32, 0, 0)
    poke_raw64(record + 40, 0, 0)
    poke_raw64(record + 8, 0, KIOMMU_UNIT_FREE)
    poke_raw64(record, 0, next)
    return 1
kiommu_fault_offset capability:
    return band(bshr(capability, 24), 1023) * 16
kiommu_fault_read base capability record:
    if base < KIOMMU_PAGE_SIZE -> return 0
    if record is 0 -> return 0
    offset: kiommu_fault_offset(capability)
    if offset < 64 -> return 0
    status: peek_raw32(base + 52, 0)
    high: peek_raw64(base + offset + 8, 0)
    if band(status, KIOMMU_FSTS_PPF) is 0 -> return 0
    if band(high, bshl(1, 63)) is 0 -> return 0
    poke_raw64(record, 0, peek_raw64(base + offset, 0))
    poke_raw64(record + 8, 0, high)
    poke_raw64(record + 16, 0, status)
    return 1
kiommu_fault_address record:
    if record is 0 -> return 0
    return peek_raw64(record, 0) - peek_raw64(record, 0) % KIOMMU_PAGE_SIZE
kiommu_fault_source record:
    if record is 0 -> return 0 - 1
    return band(peek_raw64(record + 8, 0), 65535)
kiommu_fault_reason record:
    if record is 0 -> return 0 - 1
    return band(bshr(peek_raw64(record + 8, 0), 32), 255)
kiommu_fault_ir_index record:
    if record is 0 -> return 0 - 1
    reason: kiommu_fault_reason(record)
    if reason < 32 -> return 0 - 1
    if reason > 47 -> return 0 - 1
    return band(bshr(peek_raw64(record, 0), 48), 65535)
kiommu_fault_account_init account:
    if account is 0 -> return 0
    offset: 0
    as long as offset < KIOMMU_FAULT_ACCOUNT_STRIDE
        poke_raw64(account + offset, 0, 0)
        offset: offset + 8
    return 1
kiommu_fault_account record domains domain_capacity owners owner_capacity account:
    if record is 0 -> return 0
    if account is 0 -> return 0
    reason: kiommu_fault_reason(record)
    source: kiommu_fault_source(record)
    if reason < 0 -> return 0
    if source < 0 -> return 0
    domain_id: 0
    ir_owner: 0
    index: 65536
    flags: 0
    domain_slot: kiommu_domain_find_requester(domains, domain_capacity, source)
    if domain_slot >= 0
        domain_generation: kiommu_domain_generation(domains, domain_capacity, domain_slot)
        domain_id: kiommu_domain_id(domains, domain_capacity, domain_slot, domain_generation)
        if domain_id is not 0 -> flags: bor(flags, KIOMMU_FAULT_ACCOUNT_DOMAIN)
    if reason >= 32
        if reason <= 47
            index: kiommu_fault_ir_index(record)
            owner_slot: kiommu_ir_owner_find_index(owners, owner_capacity, index)
            if owner_slot >= 0
                owner_generation: kiommu_ir_owner_generation(owners, owner_capacity, owner_slot)
                ir_owner: kiommu_ir_owner_identity(owners, owner_capacity, owner_slot, owner_generation)
                if ir_owner is not 0 -> flags: bor(flags, KIOMMU_FAULT_ACCOUNT_INTERRUPT)
    count: peek_raw64(account, 0) + 1
    poke_raw64(account, 0, count)
    poke_raw64(account + 8, 0, reason)
    poke_raw64(account + 16, 0, source)
    poke_raw64(account + 24, 0, index)
    poke_raw64(account + 32, 0, domain_id)
    poke_raw64(account + 40, 0, ir_owner)
    poke_raw64(account + 48, 0, flags)
    poke_raw64(account + 56, 0, 0)
    return flags
kiommu_fault_policy_valid policies capacity:
    if policies is 0 -> return 0
    if capacity < 1 -> return 0
    if capacity > 256 -> return 0
    if peek_raw64(policies + 8, 0) is not capacity -> return 0
    return 1
kiommu_fault_policy_lock policies:
    spin: 0
    as long as spin < KIOMMU_FAULT_POLICY_LOCK_LIMIT
        if atomic_cas(policies, 0, 1) is 0 -> return 1
        spin: spin + 1
kiommu_fault_policy_unlock policies:
    atomic_store(policies, 0)
    return 1
kiommu_fault_policy_record policies slot:
    return policies + KIOMMU_FAULT_POLICY_HEADER + slot * KIOMMU_FAULT_POLICY_STRIDE
kiommu_fault_policies_init policies capacity:
    if policies is 0 -> return 0
    if capacity < 1 -> return 0
    if capacity > 256 -> return 0
    poke_raw64(policies, 0, 0)
    poke_raw64(policies + 8, 0, capacity)
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        offset: 0
        as long as offset < KIOMMU_FAULT_POLICY_STRIDE
            poke_raw64(record + offset, 0, 0)
            offset: offset + 8
        slot: slot + 1
    return 1
kiommu_fault_policy_configure policies capacity domain threshold window quota recovery_limit:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0
    if domain < 1 -> return 0
    if threshold < 1 -> return 0
    if window < 0 -> return 0
    if quota < 0 -> return 0
    if recovery_limit < 0 -> return 0
    if window is 0
        if quota is not 0 -> return 0
    if window is not 0
        if quota < 1 -> return 0
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0
    selected: 0 - 1
    free_slot: 0 - 1
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        current: peek_raw64(record, 0)
        if current is domain
            selected: slot
            slot: capacity
        if current is 0
            if free_slot < 0 -> free_slot: slot
        slot: slot + 1
    if selected < 0 -> selected: free_slot
    if selected < 0
        kiommu_fault_policy_unlock(policies)
        return 0
    record: kiommu_fault_policy_record(policies, selected)
    current: peek_raw64(record, 0)
    if current is domain
        same: 1
        if peek_raw64(record + 48, 0) is not threshold -> same: 0
        if peek_raw64(record + 56, 0) is not window -> same: 0
        if peek_raw64(record + 64, 0) is not quota -> same: 0
        if peek_raw64(record + 80, 0) is not recovery_limit -> same: 0
        kiommu_fault_policy_unlock(policies)
        return same
    poke_raw64(record, 0, domain)
    poke_raw64(record + 8, 0, 0)
    poke_raw64(record + 16, 0, KIOMMU_FAULT_POLICY_MONITOR)
    poke_raw64(record + 24, 0, 0)
    poke_raw64(record + 32, 0, 0)
    poke_raw64(record + 40, 0, 0)
    poke_raw64(record + 48, 0, threshold)
    poke_raw64(record + 56, 0, window)
    poke_raw64(record + 64, 0, quota)
    poke_raw64(record + 72, 0, 0)
    poke_raw64(record + 80, 0, recovery_limit)
    poke_raw64(record + 88, 0, 0)
    kiommu_fault_policy_unlock(policies)
    return 1
kiommu_fault_policy_note_at policies capacity account now:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0 - 1
    if account is 0 -> return 0 - 1
    if now < 0 -> return 0 - 1
    domain: peek_raw64(account + 32, 0)
    if domain is 0 -> return 0 - 1
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0 - 1
    selected: 0 - 1
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        if peek_raw64(record, 0) is domain
            selected: slot
            slot: capacity
        slot: slot + 1
    if selected < 0
        kiommu_fault_policy_unlock(policies)
        return 0 - 1
    record: kiommu_fault_policy_record(policies, selected)
    count: peek_raw64(record + 8, 0)
    last: peek_raw64(record + 88, 0)
    if count > 0
        if now < last
            kiommu_fault_policy_unlock(policies)
            return 0 - 1
    count: count + 1
    window: peek_raw64(record + 56, 0)
    quota: peek_raw64(record + 64, 0)
    window_count: 0
    window_start: now
    if window > 0
        window_count: peek_raw64(record + 40, 0)
        window_start: peek_raw64(record + 32, 0)
        if window_count is 0
            window_start: now
            window_count: 1
        if not
            if now - window_start >= window
                window_start: now
                window_count: 1
            if not -> window_count: window_count + 1
    action: peek_raw64(record + 16, 0)
    if action is not KIOMMU_FAULT_POLICY_BLOCK
        if action is not KIOMMU_FAULT_POLICY_QUARANTINE
            action: KIOMMU_FAULT_POLICY_MONITOR
            if count >= peek_raw64(record + 48, 0) -> action: KIOMMU_FAULT_POLICY_QUARANTINE
            if window > 0
                if window_count > quota -> action: KIOMMU_FAULT_POLICY_QUARANTINE
            if action is KIOMMU_FAULT_POLICY_QUARANTINE
                recovery_limit: peek_raw64(record + 80, 0)
                if recovery_limit > 0
                    if peek_raw64(record + 72, 0) >= recovery_limit -> action: KIOMMU_FAULT_POLICY_BLOCK
    poke_raw64(record + 8, 0, count)
    poke_raw64(record + 16, 0, action)
    poke_raw64(record + 24, 0, peek_raw64(account + 8, 0))
    poke_raw64(record + 32, 0, window_start)
    poke_raw64(record + 40, 0, window_count)
    poke_raw64(record + 88, 0, now)
    kiommu_fault_policy_unlock(policies)
    return action
kiommu_fault_policy_note policies capacity account threshold:
    if account is 0 -> return 0 - 1
    domain: peek_raw64(account + 32, 0)
    if kiommu_fault_policy_configure(policies, capacity, domain, threshold, 0, 0, 0) is not 1 -> return 0 - 1
    now: peek_raw64(account, 0)
    return kiommu_fault_policy_note_at(policies, capacity, account, now)
kiommu_fault_policy_count policies capacity domain:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0 - 1
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0 - 1
    result: 0
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        if peek_raw64(record, 0) is domain
            result: peek_raw64(record + 8, 0)
            slot: capacity
        slot: slot + 1
    kiommu_fault_policy_unlock(policies)
    return result
kiommu_fault_policy_action policies capacity domain:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0
    result: 0
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        if peek_raw64(record, 0) is domain
            result: peek_raw64(record + 16, 0)
            slot: capacity
        slot: slot + 1
    kiommu_fault_policy_unlock(policies)
    return result
kiommu_fault_policy_window_count policies capacity domain:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0 - 1
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0 - 1
    result: 0
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        if peek_raw64(record, 0) is domain
            result: peek_raw64(record + 40, 0)
            slot: capacity
        slot: slot + 1
    kiommu_fault_policy_unlock(policies)
    return result
kiommu_fault_policy_recoveries policies capacity domain:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0 - 1
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0 - 1
    result: 0
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        if peek_raw64(record, 0) is domain
            result: peek_raw64(record + 72, 0)
            slot: capacity
        slot: slot + 1
    kiommu_fault_policy_unlock(policies)
    return result
kiommu_fault_policy_reset policies capacity domain:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0
    if domain is 0 -> return 0
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        if peek_raw64(record, 0) is domain
            if peek_raw64(record + 16, 0) is not KIOMMU_FAULT_POLICY_QUARANTINE
                kiommu_fault_policy_unlock(policies)
                return 0
            poke_raw64(record + 8, 0, 0)
            poke_raw64(record + 16, 0, KIOMMU_FAULT_POLICY_MONITOR)
            poke_raw64(record + 24, 0, 0)
            poke_raw64(record + 32, 0, 0)
            poke_raw64(record + 40, 0, 0)
            poke_raw64(record + 72, 0, peek_raw64(record + 72, 0) + 1)
            poke_raw64(record + 88, 0, 0)
            kiommu_fault_policy_unlock(policies)
            return 1
        slot: slot + 1
    kiommu_fault_policy_unlock(policies)
kiommu_fault_policy_release policies capacity domain:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0
    if domain is 0 -> return 0
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        if peek_raw64(record, 0) is domain
            offset: 0
            as long as offset < KIOMMU_FAULT_POLICY_STRIDE
                poke_raw64(record + offset, 0, 0)
                offset: offset + 8
            kiommu_fault_policy_unlock(policies)
            return 1
        slot: slot + 1
    kiommu_fault_policy_unlock(policies)
kiommu_fault_policy_active policies capacity:
    if kiommu_fault_policy_valid(policies, capacity) is not 1 -> return 0 - 1
    if kiommu_fault_policy_lock(policies) is not 1 -> return 0 - 1
    active: 0
    slot: 0
    as long as slot < capacity
        record: kiommu_fault_policy_record(policies, slot)
        if peek_raw64(record, 0) is not 0 -> active: active + 1
        slot: slot + 1
    kiommu_fault_policy_unlock(policies)
    return active
kiommu_fault_clear base capability:
    if base < KIOMMU_PAGE_SIZE -> return 0
    offset: kiommu_fault_offset(capability)
    if offset < 64 -> return 0
    poke_raw64(base + offset + 8, 0, bshl(1, 63))
    poke_raw32(base + 52, 0, 1)
    return 1
