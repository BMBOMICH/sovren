kiommu_zero_page page:
    if page < KIOMMU_PAGE_SIZE -> return 0
    if page % KIOMMU_PAGE_SIZE is not 0 -> return 0
    i: 0
    as long as i < KIOMMU_PAGE_SIZE
        poke_raw64(page + i, 0, 0)
        i: i + 8
    return 1
kiommu_pool_init pool base pages bitmap bitmap_bytes:
    if pool is 0 -> return 0
    if base < KIOMMU_PAGE_SIZE -> return 0
    if base % KIOMMU_PAGE_SIZE is not 0 -> return 0
    if pages < 1 -> return 0
    if bitmap is 0 -> return 0
    if bitmap_bytes < 1 -> return 0
    if pages > bitmap_bytes * 8 -> return 0
    if base + pages * KIOMMU_PAGE_SIZE < base -> return 0
    i: 0
    as long as i < bitmap_bytes
        poke_raw8(bitmap + i, 0, 0)
        i: i + 1
    poke_raw64(pool, 0, base)
    poke_raw64(pool + 8, 0, pages)
    poke_raw64(pool + 16, 0, bitmap)
    poke_raw64(pool + 24, 0, bitmap_bytes)
    return 1
kiommu_pool_alloc pool:
    if pool is 0 -> return 0
    base: peek_raw64(pool, 0)
    pages: peek_raw64(pool + 8, 0)
    bitmap: peek_raw64(pool + 16, 0)
    bitmap_bytes: peek_raw64(pool + 24, 0)
    if base < KIOMMU_PAGE_SIZE -> return 0
    if pages < 1 -> return 0
    if bitmap is 0 -> return 0
    if pages > bitmap_bytes * 8 -> return 0
    page: 0
    as long as page < pages
        byte_index: page / 8
        mask: bshl(1, page % 8)
        value: peek_raw8(bitmap + byte_index, 0)
        if band(value, mask) is 0
            poke_raw8(bitmap + byte_index, 0, bor(value, mask))
            address: base + page * KIOMMU_PAGE_SIZE
            if kiommu_zero_page(address) is not 1
                poke_raw8(bitmap + byte_index, 0, value)
                return 0
            return address
        page: page + 1
kiommu_pool_free pool address:
    if pool is 0 -> return 0
    base: peek_raw64(pool, 0)
    pages: peek_raw64(pool + 8, 0)
    bitmap: peek_raw64(pool + 16, 0)
    if address < base -> return 0
    if address >= base + pages * KIOMMU_PAGE_SIZE -> return 0
    if address % KIOMMU_PAGE_SIZE is not 0 -> return 0
    page: (address - base) / KIOMMU_PAGE_SIZE
    byte_index: page / 8
    mask: bshl(1, page % 8)
    value: peek_raw8(bitmap + byte_index, 0)
    if band(value, mask) is 0 -> return 0
    if kiommu_zero_page(address) is not 1 -> return 0
    poke_raw8(bitmap + byte_index, 0, band(value, 255 - mask))
    return 1
