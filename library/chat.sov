# chat.sov — chat lines over a socket, with sender and text
use sock
use string
use list
use num

chat_pack from text:
    return as text str_join3(from, "\t", text)

chat_send fd from text:
    return sock_send(fd, str_cat(chat_pack(from, text), "\n"))

chat_recv fd:
    return as text sock_recv(fd, 4096)

chat_from line:
    p: str_find(line, "\t")
    if p < 0
        return as text ""
    return as text str_cut(line, 0, p)

chat_text line:
    p: str_find(line, "\t")
    if p < 0
        return as text line
    n: str_len(line)
    e: n
    if n > 0
        if peek_byte(line, n - 1) is 10
            e: n - 1
    return as text str_cut(line, p + 1, e)

chat_split blob:
    out: list_new()
    start: 0
    i: 0
    n: str_len(blob)
    as long as i < n
        if peek_byte(blob, i) is 10
            if i > start
                out: list_add(out, str_cut(blob, start, i))
            start: i + 1
        i: i + 1
    if start < n
        out: list_add(out, str_cut(blob, start, n))
    return out
