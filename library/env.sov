# env.sov — the settings the program was started with.
#
# These come off the stack, where the system leaves them when the
# program starts: the arguments, then a nought, then the settings,
# then another nought. Reading them from there always works.
#
# /proc/self/environ is not an option: it does not exist on Windows
# or on a Mac, and it is not readable at all in some places on Linux.
# Reading the environ pointer instead works on every machine, so
# the setting was plainly there.

use string

# how many settings there are
env_count:
    n: 0
    as long as str_len(_sov_env_at(n)) > 0
        n: n + 1
        if n > 4096
            return n
    return n

# the whole line, name and value, at this place
env_line i:
    return as text _sov_env_at(i)

# does this line begin with this name followed by an equals sign?
env_is line key:
    n: str_len(key)
    if str_len(line) < n + 1
        return 0
    i: 0
    as long as i < n
        if peek_byte(line, i) is not peek_byte(key, i)
            return 0
        i: i + 1
    if peek_byte(line, n) is not 61
        return 0
    return 1

# the value of one setting, or an empty word when there is none
env_get name:
    i: 0
    as long as i < 4096
        line: as text _sov_env_at(i)
        if str_len(line) is 0
            return blank
        if env_is(line, name) is 1
            n: str_len(name)
            return str_cut(line, n + 1, str_len(line))
        i: i + 1
    return blank

# is this setting there at all, even if it is empty?
env_has name:
    i: 0
    as long as i < 4096
        line: as text _sov_env_at(i)
        if str_len(line) is 0
            return 0
        if env_is(line, name) is 1
            return 1
        i: i + 1
    return 0

# the value, or this instead when it is not set
env_or name other:
    v: env_get(name)
    if str_len(v) is 0
        return other
    return v
