# env.sov — environment from /proc/self/environ (null-separated)
# needs _sov_list
use file
use string

env_raw:
    return file_read_max("/proc/self/environ", 8191)

env_match raw i key:
    klen: str_len(key)
    j: 0
    as long as j < klen
        if peek_byte(raw, i + j) is not peek_byte(key, j)
            return 0
        j: j + 1
    return 1

env_get name:
    raw: env_raw()
    if raw is 0
        return blank
    key: str_cat(name, "=")
    i: 0
    as long as i < 8192
        if peek_byte(raw, i) is 0
            return blank
        if env_match(raw, i, key) is 1
            j: i + str_len(key)
            e: j
            as long as peek_byte(raw, e) is not 0
                e: e + 1
            n: e - j
            out: _sov_alloc(n + 1)
            k: 0
            as long as k < n
                poke_byte(out, k, peek_byte(raw, j + k))
                k: k + 1
            poke_byte(out, n, 0)
            return as text out
        as long as peek_byte(raw, i) is not 0
            i: i + 1
        i: i + 1
    return blank
