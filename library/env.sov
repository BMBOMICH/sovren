use string
env_count:
    n: 0
    as long as str_len(_sov_env_at(n)) > 0
        n: n + 1
        if n > 4096 -> return n
    return n
env_line i:
    return as text _sov_env_at(i)
env_is line key:
    n: str_len(key)
    if str_len(line) < n + 1 -> return 0
    i: 0
    as long as i < n
        if peek_byte(line, i) is not peek_byte(key, i) -> return 0
        i: i + 1
    if peek_byte(line, n) is not 61 -> return 0
    return 1
env_get name:
    i: 0
    as long as i < 4096
        line: as text _sov_env_at(i)
        if str_len(line) is 0 -> return blank
        if env_is(line, name) is 1
            n: str_len(name)
            return str_cut(line, n + 1, str_len(line))
        i: i + 1
    return blank
env_has name:
    i: 0
    as long as i < 4096
        line: as text _sov_env_at(i)
        if str_len(line) is 0 -> return 0
        if env_is(line, name) is 1 -> return 1
        i: i + 1
env_or name other:
    v: env_get(name)
    if str_len(v) is 0 -> return other
    return v
