use sovsys_abi
SOVSYS_SERVICE_REGISTER: 40
SOVSYS_SERVICE_LOOKUP: 41
SOVSYS_SERVICE_SEND: 42
SOVSYS_SERVICE_RECV: 43
SOVSYS_SERVICE_UNREGISTER: 44
SOVSYS_PROCESS_SELF: 45
SOVSYS_SERVICE_SEND_ASYNC: 46
SOVSYS_SERVICE_CANCEL: 47
SOVSYS_SERVICE_POLL: 48
SOVSYS_SERVICE_WAIT: 49
SOVSYS_PROCESS_INTERRUPT: 50
SOVSYS_PROCESS_SIGNAL: 51
SOVSYS_SIGNAL_MASK: 52
SOVSYS_SIGNAL_PENDING: 53
SOVSYS_PROCESS_NAMESPACE_CREATE: 54
SOVSYS_PROCESS_INFO: 55
SOVSYS_SIGNAL_NEXT: 56
SOVSYS_SERVICE_GRANT: 57
SOVSYS_SERVICE_GRANT_WAIT: 58
SOVSYS_SERVICE_REVOKE: 59
sov_SERVICE_REGISTER a0:
    return sovcall(SOVSYS_SERVICE_REGISTER, a0)
sov_SERVICE_LOOKUP a0:
    return sovcall(SOVSYS_SERVICE_LOOKUP, a0)
sov_SERVICE_SEND a0 a1 a2:
    return sovcall(SOVSYS_SERVICE_SEND, a0, a1, a2)
sov_SERVICE_RECV a0 a1 a2:
    return sovcall(SOVSYS_SERVICE_RECV, a0, a1, a2)
sov_SERVICE_UNREGISTER a0:
    return sovcall(SOVSYS_SERVICE_UNREGISTER, a0)
sov_PROCESS_SELF:
    return sovcall(SOVSYS_PROCESS_SELF)
sov_SERVICE_SEND_ASYNC a0 a1 a2:
    return sovcall(SOVSYS_SERVICE_SEND_ASYNC, a0, a1, a2)
sov_SERVICE_CANCEL a0 a1:
    return sovcall(SOVSYS_SERVICE_CANCEL, a0, a1)
sov_SERVICE_POLL a0:
    return sovcall(SOVSYS_SERVICE_POLL, a0)
sov_SERVICE_WAIT a0 a1 a2:
    return sovcall(SOVSYS_SERVICE_WAIT, a0, a1, a2)
sov_PROCESS_INTERRUPT a0:
    return sovcall(SOVSYS_PROCESS_INTERRUPT, a0)
sov_PROCESS_SIGNAL a0 a1:
    return sovcall(SOVSYS_PROCESS_SIGNAL, a0, a1)
sov_SIGNAL_MASK a0:
    return sovcall(SOVSYS_SIGNAL_MASK, a0)
sov_SIGNAL_PENDING:
    return sovcall(SOVSYS_SIGNAL_PENDING)
sov_PROCESS_NAMESPACE_CREATE:
    return sovcall(SOVSYS_PROCESS_NAMESPACE_CREATE)
sov_PROCESS_INFO a0 a1:
    return sovcall(SOVSYS_PROCESS_INFO, a0, a1)
sov_SIGNAL_NEXT:
    return sovcall(SOVSYS_SIGNAL_NEXT)
sov_SERVICE_GRANT a0 a1:
    return sovcall(SOVSYS_SERVICE_GRANT, a0, a1)
sov_SERVICE_GRANT_WAIT a0 a1:
    return sovcall(SOVSYS_SERVICE_GRANT_WAIT, a0, a1)
sov_SERVICE_REVOKE a0 a1:
    return sovcall(SOVSYS_SERVICE_REVOKE, a0, a1)
