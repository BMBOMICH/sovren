# sort.sov — sort a list of numbers
# needs _sov_list
use list

sort_ints lst:
    n: list_len(lst)
    a: 0
    as long as a < n
        b: 0
        as long as b + 1 < n
            x: list_get(lst, b)
            y: list_get(lst, b + 1)
            if x > y
                list_set(lst, b, y)
                list_set(lst, b + 1, x)
            b: b + 1
        a: a + 1
    return lst
