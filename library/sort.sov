# sort.sov — sort a list
use list
use string
use vec

sort_ints lst:
    n: list_len(lst)
    a: 0
    as long as a < n
        b: 0
        as long as b + 1 < n
            x: list_get(lst, b)
            y: list_get(lst, b + 1)
            if x > y
                list_set(lst, b, y)
                list_set(lst, b + 1, x)
            b: b + 1
        a: a + 1
    return lst

sort_ints_desc lst:
    n: list_len(lst)
    a: 0
    as long as a < n
        b: 0
        as long as b + 1 < n
            x: list_get(lst, b)
            y: list_get(lst, b + 1)
            if x < y
                list_set(lst, b, y)
                list_set(lst, b + 1, x)
            b: b + 1
        a: a + 1
    return lst

sort_strs lst:
    n: list_len(lst)
    a: 0
    as long as a < n
        b: 0
        as long as b + 1 < n
            x: list_get(lst, b)
            y: list_get(lst, b + 1)
            if str_eq(x, y) is 0
                if str_less(x, y) is 0
                    list_set(lst, b, y)
                    list_set(lst, b + 1, x)
            b: b + 1
        a: a + 1
    return lst

sort_strs_desc lst:
    n: list_len(lst)
    a: 0
    as long as a < n
        b: 0
        as long as b + 1 < n
            x: list_get(lst, b)
            y: list_get(lst, b + 1)
            if str_eq(x, y) is 0
                if str_less(x, y) is 1
                    list_set(lst, b, y)
                    list_set(lst, b + 1, x)
            b: b + 1
        a: a + 1
    return lst

# ---- quicksort and binary search on vecs (from sortx.sov) ----
use vec

sx_swap v i j:
    t: vec_get(v, i)
    vec_set(v, i, vec_get(v, j))
    vec_set(v, j, t)
    return v

sx_part v lo hi:
    pivot: vec_get(v, hi)
    i: lo - 1
    j: lo
    as long as j < hi
        if vec_get(v, j) <= pivot
            i: i + 1
            sx_swap(v, i, j)
        j: j + 1
    sx_swap(v, i + 1, hi)
    return i + 1

sx_qs v lo hi:
    if lo < hi
        p: sx_part(v, lo, hi)
        sx_qs(v, lo, p - 1)
        sx_qs(v, p + 1, hi)
    return v

sx_sort v:
    return sx_qs(v, 0, vec_len(v) - 1)

sx_search v x:
    lo: 0
    hi: vec_len(v) - 1
    as long as lo <= hi
        mid: (lo + hi) / 2
        m: vec_get(v, mid)
        if m is x
            return mid
        if m < x
            lo: mid + 1
        if not
            hi: mid - 1
    return 0 - 1

sx_sorted v:
    i: 1
    as long as i < vec_len(v)
        if vec_get(v, i - 1) > vec_get(v, i)
            return 0
        i: i + 1
    return 1
