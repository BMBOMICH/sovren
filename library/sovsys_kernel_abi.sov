sovsys_audit_write record sequence number result:
    poke_raw64(record, 0, SOVSYS_AUDIT_RECORD_VERSION)
    poke_raw64(record + 8, 0, sequence)
    poke_raw64(record + 16, 0, number)
    poke_raw64(record + 24, 0, result)
sovsys_audit_version record:
    return peek_raw64(record, 0)
sovsys_audit_sequence record:
    return peek_raw64(record + 8, 0)
sovsys_audit_number record:
    return peek_raw64(record + 16, 0)
sovsys_audit_result record:
    return peek_raw64(record + 24, 0)
