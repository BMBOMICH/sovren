# filesystem.sov — file system operations
# Real implementation with syscalls

use sys

# Open file
fs_open path, flags, mode:
    return syscall(2, path, flags, mode)

# Close file
fs_close fd:
    return syscall(3, fd)

# Read from file
fs_read fd, buf, count:
    return syscall(0, fd, buf, count)

# Write to file
fs_write fd, buf, count:
    return syscall(1, fd, buf, count)

# Seek in file
fs_seek fd, offset, whence:
    return syscall(8, fd, offset, whence)

# Get file status
fs_stat path, statbuf:
    return syscall(4, path, statbuf)

# Get file status (by fd)
fs_fstat fd, statbuf:
    return syscall(5, fd, statbuf)

# Create directory
fs_mkdir path, mode:
    return syscall(83, path, mode)

# Remove directory
fs_rmdir path:
    return syscall(84, path)

# Delete file
fs_unlink path:
    return syscall(87, path)

# Rename file
fs_rename oldpath, newpath:
    return syscall(38, oldpath, newpath)

# Change working directory
fs_chdir path:
    return syscall(80, path)

# Get current directory
fs_getcwd buf, size:
    return syscall(79, buf, size)

# Get file size
fs_size fd:
    statbuf: _sov_alloc(144)
    fs_fstat(fd, statbuf)
    size: peek_i64(statbuf, 48)
    return size

# Check if file exists
fs_exists path:
    statbuf: _sov_alloc(144)
    result: fs_stat(path, statbuf)
    if result = 0
        return 1
    return 0

# Read entire file into buffer
fs_read_all path:
    fd: fs_open(path, 0, 0)
    if fd < 0
        return 0
    size: fs_size(fd)
    buf: _sov_alloc(size + 1)
    fs_read(fd, buf, size)
    poke_byte(buf, size, 0)
    fs_close(fd)
    return buf

# Write buffer to file
fs_write_all path, buf, size:
    fd: fs_open(path, 65, 420)
    if fd < 0
        return -1
    fs_write(fd, buf, size)
    fs_close(fd)
    return 0
