use string
use sys
use key
use mem
secret_mask s:
    n: str_len(s)
    out: _sov_alloc(n + 1)
    i: 0
    as long as i < n
        poke_byte(out, i, 42)
        i: i + 1
    poke_byte(out, n, 0)
    return as text out
secret_wipe s:
    wipe s
    return 1
secret_wipe_bytes p n:
    i: 0
    as long as i < n
        poke_byte(p, i, 0)
        i: i + 1
    return 1
secret_lockdown:
    syscall(157, 4, 0, 0, 0, 0, 0)
    return 1
secret_noswap:
    secret_harden()
    if heap_ptr is 0
        rt_heap()
    base: heap_end - 67108864
    want: heap_ptr - base
    if want < 4096
        want: 4096
    as long as want >= 4096
        got: syscall(149, base, want, 0, 0, 0, 0)
        if got is 0
            return want
        want: want / 2
secret_harden:
    if heap_ptr is 0
        rt_heap()
    base: heap_end - 67108864
    a: syscall(28, base, 67108864, 16, 0, 0, 0)
    b: syscall(28, base, 67108864, 18, 0, 0, 0)
    n: 0
    if a is 0
        n: n + 1
    if b is 0
        n: n + 1
    return n
g_secret_code: 0
secret_die code:
    g_secret_code: code
    if heap_ptr is 0
        rt_heap()
    base: heap_end - 67108864
    used: heap_ptr - base
    used: used + 4095
    used: used - used % 4096
    syscall(28, base, used, 4, 0, 0, 0)
    syscall(60, g_secret_code, 0, 0, 0, 0, 0)
secret_line cap:
    t: _sov_alloc(64)
    ok: sys_ioctl(0, 21505, t)
    save: 0 - 1
    if ok is 0
        save: peek_i64(t, 12)
        flags: save
        flags: flags - (flags % 16) / 8 * 8
        poke_i64(t, 12, flags)
        sys_ioctl(0, 21506, t)
    line: key_line(cap)
    if ok is 0
        poke_i64(t, 12, save)
        sys_ioctl(0, 21506, t)
        sys_write(1, "\n", 1)
    return line
secret_scrub_argv:
    private
    i: 0
    as long as i < _sov_argc()
        p: _sov_argv_get(i)
        j: 0
        as long as _sov_byte_at(p, j) is not 0
            poke_byte(p, j, 0)
            j: j + 1
        i: i + 1
    return _sov_argc()
secret_scrub_env:
    private
    base: g_argv + (_sov_argc() + 1) * 8
    n: 0
    as long as peek_ptr(base, n) is not 0
        p: peek_ptr(base, n)
        j: 0
        as long as _sov_byte_at(p, j) is not 0
            poke_byte(p, j, 0)
            j: j + 1
        n: n + 1
    return n
secret_stacktop:
    return g_argv
secret_stackwalk:
    if heap_ptr is 0
        rt_heap()
    top: g_argv
    p: top - top % 4096
    vec: _sov_alloc(16)
    n: 0
    going: 1
    as long as going is 1
        r: syscall(27, p, 4096, vec, 0, 0, 0)
        if r is 0
            n: n + 1
            p: p - 4096
        if not
            going: 0
        if p < top - 67108864
            going: 0
    return n

use chacha20
use rand
use constant
secret_seal pt n key:
    # box: 'S' 'e' 'c' '1' magic + 12-byte getrandom nonce + keystream-xor payload
    box: _sov_alloc(n + 16)
    poke_byte(box, 0, 83)
    poke_byte(box, 1, 101)
    poke_byte(box, 2, 99)
    poke_byte(box, 3, 49)
    rand_bytes_into(box + 4, 12)
    i: 0
    as long as i * 64 < n
        blk: _sov_alloc(64)
        chacha_block(key, i, box + 4, blk)
        j: 0
        as long as j < 64
            if i * 64 + j < n
                poke_byte(box, 16 + i * 64 + j, wxor(peek_byte(pt, i * 64 + j), peek_byte(blk, j)))
            j: j + 1
        secret_wipe_bytes(blk, 64)
        i: i + 1
    return box
secret_open box n key:
    rt: _sov_alloc(n + 1)
    i: 0
    as long as i * 64 < n
        blk: _sov_alloc(64)
        chacha_block(key, i, box + 4, blk)
        j: 0
        as long as j < 64
            if i * 64 + j < n
                poke_byte(rt, i * 64 + j, wxor(peek_byte(box, 16 + i * 64 + j), peek_byte(blk, j)))
            j: j + 1
        secret_wipe_bytes(blk, 64)
        i: i + 1
    poke_byte(rt, n, 0)
    return rt
secret_reveal p:
    # the single, greppable gate: call this and you have chosen to expose the
    # buffer. every other path keeps the caller holding ciphertext.
    return p
secret_is_box box:
    hdr: _sov_alloc(4)
    poke_byte(hdr, 0, 83)
    poke_byte(hdr, 1, 101)
    poke_byte(hdr, 2, 99)
    poke_byte(hdr, 3, 49)
    ok: ct_eq(box, hdr, 4)
    secret_wipe_bytes(hdr, 4)
    return ok
