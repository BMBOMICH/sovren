# secret.sov — handling private data honestly.
#
# What wipe covers: the bytes of the buffer you name, right now.
# What it cannot cover by itself:
#   - copies made earlier (str_cat, slicing, concat all allocate new
#     buffers; the bump allocator never frees, so every intermediate
#     copy lives in the heap until the process dies - wipe each copy
#     where you make it, or keep secret data in one buffer only)
#   - stack and register residue from computing with the values
#   - the swap partition if the kernel pages the heap out (mlock can
#     pin a small region; the default memlock rlimit is tiny)
#   - the page cache and the disk if the secret was ever written to
#     a file
# The compiler helps where it can: any program whose statements
# include `wipe` or `private` gets prctl(PR_SET_DUMPABLE, 0) before
# main - no core dumps, no /proc/pid/mem, no ptrace.
#
# needs _sov_list
use string
use sys
use key
use mem

# mask a word for display: fixed stars, no length leak beyond chars
secret_mask s:
    n: str_len(s)
    out: _sov_alloc(n + 1)
    i: 0
    as long as i < n
        poke_byte(out, i, 42)
        i: i + 1
    poke_byte(out, n, 0)
    return as text out

# wipe a NUL-terminated string, byte by byte
secret_wipe s:
    wipe s
    return 1

# wipe exactly n bytes of any buffer - use this for crypto material
# (keys, schedules, plaintext buffers) whose size you know; the
# `wipe` statement is length-driven by strlen and needs a NUL
secret_wipe_bytes p n:
    i: 0
    as long as i < n
        poke_byte(p, i, 0)
        i: i + 1
    return 1

# belt and braces for programs that did not say `wipe` anywhere but
# handle secrets anyway: same prctl the compiler emits, callable at
# any point (call it early). blocks core dumps, /proc/pid/mem and
# ptrace attach for the rest of the process lifetime
secret_lockdown:
    syscall(157, 4, 0, 0, 0, 0, 0)
    return 1

# ---- keeping secrets out of swap and off the dying heap ----
#
# The heap is one 64 MB anonymous mmap. The kernel may page any of
# it out to swap; wiping RAM does not clean swap, and the bump
# allocator never frees, so every copy a program ever made stays
# in that region until the process dies.

# Best-effort mlock of the used part of the heap, falling back to
# ever smaller chunks until the rlimit lets one through. Returns
# the bytes locked - zero means the kernel refused everything.
secret_noswap:
    secret_harden()
    if heap_ptr is 0
        rt_heap()
    base: heap_end - 67108864
    want: heap_ptr - base
    if want < 4096
        want: 4096
    as long as want >= 4096
        got: syscall(149, base, want, 0, 0, 0, 0)
        if got is 0
            return want
        want: want / 2
    return 0

# Two madvise flags over the whole heap, best effort:
#   16 - MADV_DONTDUMP: the region is excluded from any core dump
#        that does happen, whatever prctl missed
#   18 - MADV_WIPEONFORK: a forked child gets these pages ZEROED,
#        not copied - secrets do not propagate into children
# Returns 1 when both took.
secret_harden:
    if heap_ptr is 0
        rt_heap()
    base: heap_end - 67108864
    a: syscall(28, base, 67108864, 16, 0, 0, 0)
    b: syscall(28, base, 67108864, 18, 0, 0, 0)
    n: 0
    if a is 0
        n: n + 1
    if b is 0
        n: n + 1
    return n

# Zero every byte the heap ever handed out, then exit. This is the
# whole-life cleanup the bump allocator cannot do itself: every
# str_cat copy, every spilled key schedule, every digest - gone
# before the kernel reclaims the pages. Call this instead of
# falling off the end of main when the program held secrets.
# the exit code rides here: .data survives both wipes below
g_secret_code: 0

secret_die code:
    g_secret_code: code
    if heap_ptr is 0
        rt_heap()
    # every byte the bump allocator ever handed out - discarded,
    # not overwritten: MADV_DONTNEED on anonymous memory makes the
    # kernel drop the pages outright, and whatever is touched again
    # reads back as fresh zeros. no userland store ever runs, so
    # the machine's own bookkeeping in that region is not walked
    # byte by byte on the way out. the length is rounded up to a
    # page so the advice covers whole pages only.
    base: heap_end - 67108864
    used: heap_ptr - base
    used: used + 4095
    used: used - used % 4096
    syscall(28, base, used, 4, 0, 0, 0)
    syscall(60, g_secret_code, 0, 0, 0, 0, 0)
    return 0

# Read one line with the terminal echo turned off - passwords
# entered this way never reach the screen or the scrollback.
# Only the ECHO bit is cleared, so the line stays canonical and
# backspace still works; the saved terminal state is restored the
# moment the line is in (or input ends), and a newline is printed
# so the caller's next output starts on a fresh line. When stdin
# is not a terminal - a pipe, a file - there is no echo to turn
# off and the line is simply read.
secret_line cap:
    t: _sov_alloc(64)
    ok: sys_ioctl(0, 21505, t)
    save: 0 - 1
    if ok is 0
        save: peek_i64(t, 12)
        flags: save
        # clear the ECHO bit (0x8) alone, in plain integers
        flags: flags - (flags % 16) / 8 * 8
        poke_i64(t, 12, flags)
        sys_ioctl(0, 21506, t)
    line: key_line(cap)
    if ok is 0
        poke_i64(t, 12, save)
        sys_ioctl(0, 21506, t)
        sys_write(1, "\n", 1)
    return line

# ---- what the neighborhood can read out of /proc ----
#
# Any user on the machine can read /proc/<pid>/cmdline and
# /proc/<pid>/environ while the process lives. A secret passed as
# an argument or an environment line is therefore public for the
# whole run - scrub them in place the moment they are consumed.
# The kernel keeps no second copy: both files read these very
# bytes, so zeroing them here empties the files too.

# Zero every argument string where it lies on the stack.
# /proc/<pid>/cmdline goes blank. Call after os.args work is done.
secret_scrub_argv:
    private
    i: 0
    as long as i < _sov_argc()
        p: _sov_argv_get(i)
        j: 0
        as long as _sov_byte_at(p, j) is not 0
            poke_byte(p, j, 0)
            j: j + 1
        i: i + 1
    return _sov_argc()

# Zero every environment line the same way. The environment sits
# on the stack right after the arguments, so this walks the same
# memory the kernel serves /proc/<pid>/environ from. Nothing that
# reads the environment afterwards will find these lines again -
# call this last, after anything env-dependent.
secret_scrub_env:
    private
    base: g_argv + (_sov_argc() + 1) * 8
    n: 0
    as long as peek_ptr(base, n) is not 0
        p: peek_ptr(base, n)
        j: 0
        as long as _sov_byte_at(p, j) is not 0
            poke_byte(p, j, 0)
            j: j + 1
        n: n + 1
    return n

# the initial stack pointer array, for calibration below
secret_stacktop:
    return g_argv

# how many mapped pages run downward from the argv array - the
# stack-wipe epilogue's reach, and whether anything sits adjacent
secret_stackwalk:
    if heap_ptr is 0
        rt_heap()
    top: g_argv
    p: top - top % 4096
    vec: _sov_alloc(16)
    n: 0
    going: 1
    as long as going is 1
        r: syscall(27, p, 4096, vec, 0, 0, 0)
        if r is 0
            n: n + 1
            p: p - 4096
        if not
            going: 0
        if p < top - 67108864
            going: 0
    return n
