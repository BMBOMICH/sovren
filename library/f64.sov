# f64.sov - IEEE-754 binary64 floating point on pure integer ops.
# A double is held as its exact 64-bit pattern inside an i64:
#   bit 63 = sign, bits 62..52 = biased exponent (1023 = 2^0), bits 51..0 = mantissa.
# Exact, correctly rounded (round-to-nearest-even, one rounding step per op):
# from_i64, to_i64, add, sub, mul, div, cmp, neg, abs, from_frac.
# Transcendentals log/exp/pow/sin/cos/tan: correctly rounded primitives +
# polynomial kernels - a few ULP (not correctly rounded).
# inf/NaN produced by overflow, x/0, 0/0, inf-inf, 0*inf, and reported by cmp as 2.
F64_MANH: 4503599627370496
F64_MANL: 4503599627370495
F64_INFB: 9218868437227405312
F64_QNAN: 9221120237041090560
F64C_ONE: 4607182418800017408
F64C_HALF: 4602678819172646912
F64C_TWO: 4611686018427387904
F64C_LN2: 4604418534313441775
F64C_LN2HI: 4604418534311723008
F64C_LN2LO: 4461442080421002358
F64C_INVLN2: 4609176140021203710
F64C_PIO2HI: 4609753056924401664
F64C_PIO2LO: 4454258360616903473
F64C_INVPIO2: 4603909380684499075
F64C_SQRTH: 4604544271217802189
F64C_R3: 4599676419421066581
F64C_R5: 4596373779694328218
F64C_R7: 4594314991293244562
F64C_R9: 4592670820000712476
F64C_R11: 4591215111030249286
F64C_R13: 4590207312512236308
F64C_R15: 4589468260265693457
F64C_F2: 4602678819172646912
F64C_F3: 4595172819793696085
F64C_F4: 4586165620538955093
F64C_F5: 4575957461383581969
F64C_F6: 4564047942368979991
F64C_F7: 4551452160554016794
F64C_F8: 4537941361671905306
F64C_F9: 4523617214285662004
F64C_F10: 4508805057796939612
F64C_F11: 4493156764026750180
F64C_F12: 4477122120089393304
F64C_F13: 4460272573143870729
F64C_R2: 4602678819172646912
F64C_R4: 4598175219545276416
F64C_R6: 4595172819793696085
F64C_R8: 4593671619917905920
F64C_R10: 4591870180066957722
F64C_R12: 4590669220166325589
F64C_R14: 4589811391665874066
F64C_SQRT2: 4609047870845172685
F64C_PIO2H1: 4609753056584663040
F64C_PIO2H2: 4500296887714185216
F64C_PIO2H3: 4393339057712419184
F64C_R17: 4588638185040256542
F64C_R19: 4587745830934523688
F64C_SS6: 4595172819793696085
F64C_SS20: 4587366580439587226
F64C_SS42: 4582519849412036120
F64C_SS72: 4579160021118600988
F64C_SS110: 4576394174074720926
F64C_SS156: 4574040544619111450
F64C_G15: 4572140124556572692
F64C_G17: 4570623786530774558
F64C_G19: 4568888653547405120
F64C_CC2: 4602678819172646912
F64C_CC12: 4590669220166325589
F64C_CC30: 4584964660638322961
F64C_CC56: 4580804192411133074
F64C_CC90: 4577558741251091479
F64C_CC132: 4575384275976462088
F64C_H14: 4572984755695478807
F64C_H16: 4571453861756211473
F64C_H18: 4569681857196945435
f64_rq: 0
f64_o_sign: 0
f64_o_exp: 0
f64_o_man: 0
q_hi: 0
q_lo: 0
q_lw: 0
q_ln: 0
q_si: 0
q_st: 0
q_g: 0
q_r: 0
ua_r: 0
ua_c: 0

# mod-2^64 pattern add: ua_r = (a + b) mod 2^64, ua_c = carry bit.
# 32-bit carry-split — no signed overflow is ever possible.
u64_add a b:
    c: 0
    ls: band(a, 4294967295) + band(b, 4294967295)
    if ls >= 4294967296 -> c: 1
    hs: band(bshr(a, 32), 4294967295) + band(bshr(b, 32), 4294967295) + c
    ua_c: 0
    if hs >= 4294967296 -> ua_c: 1
    ua_r: bor(bshl(band(hs, 4294967295), 32), band(ls, 4294967295))
    return 0

f64_sign x:
    if x < 0 -> return 1
    return 0

f64_absbits x:
    return band(x, 9223372036854775807)

f64_is_zero x:
    if band(f64_absbits(x), 9223372036854775807) = 0 -> return 1
    return 0

f64_is_inf x:
    if band(f64_absbits(x), 9223372036854775807) = F64_INFB -> return 1
    return 0

f64_is_nan x:
    a: f64_absbits(x)
    if a <= F64_INFB -> return 0
    if band(a, F64_MANL) = 0 -> return 0
    return 1

f64_neg x:
    return bxor(x, bshl(1, 63))

f64_abs x:
    return band(x, 9223372036854775807)

# unpack into f64_o_sign/f64_o_exp/f64_o_man:
# value = man * 2^exp, man in [2^52, 2^53) for normals (subnormal: man < 2^52)
f64_unpack x:
    a: f64_absbits(x)
    f64_o_sign: f64_sign(x)
    e: band(bshr(a, 52), 2047)
    m: band(a, F64_MANL)
    if e = 2047
        f64_o_exp: 0 - 1000000
        f64_o_man: a
        return 0
    if e = 0
        if m = 0
            f64_o_exp: 0 - 2000000
            f64_o_man: 0
            return 0
        f64_o_exp: 0 - 1074
        f64_o_man: m
        return 0
    f64_o_exp: e - 1075
    f64_o_man: bor(m, F64_MANH)
    return 0

# highest set bit index (0..63), 0 - 1 if none
f64_top v:
    n: 63
    found: 0
    as long as found = 0
        if band(bshr(v, n), 1) = 1 -> found: 1
        if not -> n: n - 1
    if found = 0 -> return 0 - 1
    return n

f64_mk sign exp man:
    return bor(bshl(sign, 63), bor(bshl(exp, 52), man))

# ---- final rounding of an exact magnitude ----
# value = (q_lo + q_lw/2^q_ln) * 2^exp + q_si * tiny, q_lo >= 0, 0 <= q_lw < 2^q_ln.
# q_lw carries the dropped bits EXACTLY so renormalization can shift them back.
# Round-to-nearest-even, one rounding step, no double rounding.
f64_round sign exp:
    if q_lo = 0
        if q_lw = 0 -> return 0
        ntop: f64_top(q_lw)
        sh: 52 - ntop
        q_lo: bshl(q_lw, sh)
        exp: exp - q_ln - sh
        q_lw: 0
        q_ln: 0
    ntop: f64_top(q_lo)
    sh: ntop - 52
    as long as sh > 0
        q_lw: bor(bshl(band(q_lo, 1), q_ln), q_lw)
        q_ln: q_ln + 1
        q_lo: bshr(q_lo, 1)
        exp: exp + 1
        sh: sh - 1
    as long as ntop < 52
        qb: 0
        if q_ln > 0 -> qb: band(bshr(q_lw, q_ln - 1), 1)
        q_lo: bor(bshl(q_lo, 1), qb)
        if q_ln > 0 -> q_lw: band(q_lw, bshl(1, q_ln - 1) - 1)
        if q_ln > 0 -> q_ln: q_ln - 1
        exp: exp - 1
        ntop: f64_top(q_lo)
    q_g: 0
    q_r: 0
    q_st: q_si
    if q_ln > 0 -> q_g: band(bshr(q_lw, q_ln - 1), 1)
    if q_ln > 1 -> q_r: band(bshr(q_lw, q_ln - 2), 1)
    if q_ln > 2 -> if band(q_lw, bshl(1, q_ln - 2) - 1) != 0 -> q_st: 1
    man: band(q_lo, F64_MANL)
    inc: 0
    if q_g = 1 -> inc: q_r
    if q_g = 1 -> if inc = 0 -> inc: q_st
    if q_g = 1 -> if inc = 0 -> inc: band(man, 1)
    if inc = 1 -> q_lo: q_lo + 1
    if q_lo >= 9007199254740992
        q_lo: 4503599627370496
        exp: exp + 1
    e: exp + 1075
    if e >= 2047 -> return bor(bshl(sign, 63), F64_INFB)
    if e <= 0
        sh: 1 - e
        if sh > 62 -> return 0
        st0: 0
        if q_lw != 0 -> st0: 1
        if q_si != 0 -> st0: 1
        lg: 0
        st: st0
        as long as sh > 0
            if lg = 1 -> st: 1
            lg: band(q_lo, 1)
            q_lo: bshr(q_lo, 1)
            sh: sh - 1
        inc: 0
        if lg = 1 -> inc: st
        if lg = 1 -> if inc = 0 -> inc: band(q_lo, 1)
        if inc = 1 -> q_lo: q_lo + 1
        if q_lo = 0 -> return 0
        return bor(bshl(sign, 63), q_lo)
    return f64_mk(sign, e, band(q_lo, F64_MANL))

f64_from_i64 n:
    q_lw: 0
    q_ln: 0
    q_si: 0
    if n = 0 -> return 0
    sign: 0
    m: n
    if m < 0
        sign: 1
        m: 0 - m
    e: 0
    m0: m
    as long as m >= 9007199254740992
        m: bshr(m, 1)
        e: e + 1
    if e > 0
        q_lw: band(m0, bshl(1, e) - 1)
        q_ln: e
    q_lo: m
    return f64_round(sign, e)

f64_to_i64 x:
    if f64_is_nan(x) -> return 0
    if f64_is_zero(x) -> return 0
    if f64_is_inf(x)
        if f64_sign(x) = 1 -> return bshl(1, 63)
        return 9223372036854775807
    f64_unpack(x)
    if f64_o_exp < 0
        if f64_o_exp <= 0 - 54 -> return 0
        k: 0 - f64_o_exp
        out: bshr(f64_o_man, k)
        if f64_o_sign = 1 -> return 0 - out
        return out
    # value = man * 2^exp with man in [2^52, 2^53): exp >= 11 cannot fit i64.
    # Saturate sign-aware: INT64_MIN is its own pattern; INT64_MAX is a legal literal.
    if f64_o_exp > 10
        if f64_o_sign = 1 -> return bshl(1, 63)
        return 9223372036854775807
    m: f64_o_man
    as long as f64_o_exp > 0
        m: bshl(m, 1)
        f64_o_exp: f64_o_exp - 1
    as long as f64_o_exp < 0
        m: bshr(m, 1)
        f64_o_exp: f64_o_exp + 1
    if f64_o_sign = 1 -> return 0 - m
    return m

# exact magnitude addition/subtraction at aligned exponents, then one rounding
f64_addm aman aexp bman bexp:
    q_lw: 0
    q_ln: 0
    q_si: 0
    d: aexp - bexp
    ad: d
    if ad < 0 -> ad: 0 - ad
    if ad > 53 -> q_si: 1
    if ad > 53 -> ad: 53
    d0: 0
    b0: 0
    if d > 0 -> d0: ad
    if d > 0 -> b0: bman
    as long as d > 0
        bman: bshr(bman, 1)
        d: d - 1
    if d0 > 0 -> q_lw: band(b0, bshl(1, d0) - 1)
    if d0 > 0 -> q_ln: d0
    d2: aexp - bexp
    if d2 > 0 -> q_lo: aman + bman
    if d2 > 0 -> return f64_round(0, aexp)
    d3: 0
    a0: 0
    if d2 < 0 -> d3: 0 - d2
    if d2 < 0 -> a0: aman
    as long as d2 < 0
        aman: bshr(aman, 1)
        d2: d2 + 1
    if d3 > 0 -> q_lw: band(a0, bshl(1, d3) - 1)
    if d3 > 0 -> q_ln: d3
    q_lo: aman + bman
    return f64_round(0, bexp)

f64_subm aman aexp bman bexp:
    q_lw: 0
    q_ln: 0
    q_si: 0
    pos: 0
    if aexp > bexp -> pos: 1
    d: aexp - bexp
    ad: d
    if ad < 0 -> ad: 0 - ad
    if ad > 53 -> q_si: 1
    if ad > 53 -> ad: 53
    d0: 0
    s0: 0
    if d > 0 -> d0: ad
    if d > 0 -> s0: bman
    if d < 0 -> d0: ad
    if d < 0 -> s0: aman
    as long as d > 0
        bman: bshr(bman, 1)
        d: d - 1
    as long as d < 0
        aman: bshr(aman, 1)
        d: d + 1
    if d0 > 0 -> q_lw: band(s0, bshl(1, d0) - 1)
    if d0 > 0 -> q_ln: d0
    rexp: bexp
    if pos = 1 -> rexp: aexp
    man: bman - aman
    if man < 0 -> man: 0 - man
    if man = 0
        if q_lw = 0 -> return 0
        q_lo: 0
        return f64_round(0, rexp)
    q_lo: man - 1
    q_lw: bshl(1, d0) - q_lw
    full: 0
    if q_lw = bshl(1, d0) -> full: 1
    if full = 1 -> q_lw: 0
    if full = 1 -> q_lo: man
    return f64_round(0, rexp)

f64_add x y:
    if f64_is_nan(x) -> return x
    if f64_is_nan(y) -> return y
    sx: f64_sign(x)
    sy: f64_sign(y)
    if f64_is_inf(x)
        if f64_is_inf(y)
            if sx != sy -> return f64_mk(0, 2047, 1)
            return x
        return x
    if f64_is_inf(y) -> return y
    f64_unpack(x)
    ax: f64_o_man
    ex: f64_o_exp
    f64_unpack(y)
    ay: f64_o_man
    ey: f64_o_exp
    if sx = sy
        r: f64_addm(ax, ex, ay, ey)
        return bor(bshl(sx, 63), r)
    r: f64_subm(ax, ex, ay, ey)
    if r = 0 -> return 0
    # result sign = sign of the operand with the larger magnitude
    # (lexicographic (exp, man) compare; exp/man are unpack outputs)
    gt: 1
    if ey > ex -> gt: 0
    if ex = ey -> if ax < ay -> gt: 0
    if gt = 1 -> return bor(bshl(sx, 63), band(r, 9223372036854775807))
    return bor(bshl(sy, 63), band(r, 9223372036854775807))

f64_sub x y:
    return f64_add(x, f64_neg(y))

f64_mul x y:
    if f64_is_nan(x) -> return x
    if f64_is_nan(y) -> return y
    sign: bxor(f64_sign(x), f64_sign(y))
    if f64_is_inf(x)
        if f64_is_zero(y) -> return f64_mk(0, 2047, 1)
        return bor(bshl(sign, 63), F64_INFB)
    if f64_is_inf(y)
        if f64_is_zero(x) -> return f64_mk(0, 2047, 1)
        return bor(bshl(sign, 63), F64_INFB)
    f64_unpack(x)
    aman: f64_o_man
    aexp: f64_o_exp
    f64_unpack(y)
    bman: f64_o_man
    bexp: f64_o_exp
    if aman = 0 -> return bshl(sign, 63)
    if bman = 0 -> return bshl(sign, 63)
    ah: bshr(aman, 26)
    al: band(aman, 67108863)
    bh: bshr(bman, 26)
    bl: band(bman, 67108863)
    p1: ah * bh
    p2: ah * bl + al * bh
    p3: al * bl
    # V = p1*2^52 + p2*2^26 + p3, assembled as 128-bit (H, L).
    # Every 64-bit wrap goes through u64_add — no signed overflow traps.
    # p3 lands in L, so every dropped bit feeds g/r/st: exact rounding.
    u64_add(p3, bshl(p2, 26))
    L: ua_r
    c: ua_c
    u64_add(L, bshl(band(p1, 4095), 52))
    L: ua_r
    H: bshr(p1, 12) + bshr(p2, 38) + c + ua_c
    # V in [2^104, 2^106) => H > 0, ntop = 64 + top(H) in {104, 105}
    ntop: 64 + f64_top(H)
    sh: ntop - 63
    # window: top 63 bits of V; g/r/st from the bits dropped below it
    q_lo: bor(bshl(H, 64 - sh), band(bshr(L, sh), bshl(1, 64 - sh) - 1))
    q_lw: band(L, bshl(1, sh) - 1)
    q_ln: sh
    q_si: 0
    exp: aexp + bexp + ntop - 63
    return f64_round(sign, exp)

f64_div x y:
    if f64_is_nan(x) -> return x
    if f64_is_nan(y) -> return y
    sign: bxor(f64_sign(x), f64_sign(y))
    if f64_is_inf(x)
        if f64_is_inf(y) -> return f64_mk(0, 2047, 1)
        return bor(bshl(sign, 63), F64_INFB)
    if f64_is_inf(y) -> return bshl(sign, 63)
    if f64_is_zero(y)
        if f64_is_zero(x) -> return f64_mk(0, 2047, 1)
        return bor(bshl(sign, 63), F64_INFB)
    if f64_is_zero(x) -> return bshl(sign, 63)
    f64_unpack(x)
    aman: f64_o_man
    aexp: f64_o_exp
    f64_unpack(y)
    bman: f64_o_man
    bexp: f64_o_exp
    # long division: 56 quotient bits; invariant rem < bman < 2^53.
    # Both mantissas are in [2^52, 2^53), so aman may be >= bman (x > y):
    # peel one divisor first: the quotient's leading 1 enters at weight 1
    # and the 56 doublings land it at 2^56; normalization below absorbs it.
    q: 0
    rem: aman
    if aman >= bman
        rem: rem - bman
        q: 1
    i: 0
    as long as i < 56
        rem: rem * 2
        q: q * 2
        if rem >= bman
            rem: rem - bman
            q: q + 1
        i: i + 1
    # q = floor(aman/bman * 2^56) in [2^52, 2^55); st from remainder
    ntop: f64_top(q)
    sh2: ntop - 52
    q_lo: bshr(q, sh2)
    q_lw: band(q, bshl(1, sh2) - 1)
    q_ln: sh2
    if rem > 0 -> q_lw: bor(bshl(q_lw, 1), 1)
    if rem > 0 -> q_ln: sh2 + 1
    if rem = 0 -> q_lw: bshl(q_lw, 1)
    if rem = 0 -> q_ln: sh2 + 1
    q_si: 0
    return f64_round(sign, aexp - bexp - 56 + sh2)

f64_from_frac num den:
    return f64_div(f64_from_i64(num), f64_from_i64(den))

f64_cmp x y:
    if f64_is_nan(x) -> return 2
    if f64_is_nan(y) -> return 2
    zx: f64_is_zero(x)
    zy: f64_is_zero(y)
    if zx = 1
        if zy = 1 -> return 0
        if f64_sign(y) = 0 -> return 0 - 1
        return 1
    if zy = 1
        if f64_sign(x) = 0 -> return 1
        return 0 - 1
    if f64_sign(x) != f64_sign(y)
        if f64_sign(x) = 1 -> return 0 - 1
        return 1
    ax: f64_absbits(x)
    ay: f64_absbits(y)
    if ax = ay -> return 0
    if ax > ay -> r: 1
    if not -> r: 0 - 1
    if f64_sign(x) = 1 -> r: 0 - r
    return r

f64_lt x y:
    if f64_cmp(x, y) = 0 - 1 -> return 1
    return 0

f64_eq x y:
    if f64_cmp(x, y) = 0 -> return 1
    return 0

# correctly-rounded sqrt: bit-recurrence root (54 bits) + sticky via f64_round.
f64_sqrt x:
    if f64_is_nan(x) = 1 -> return x
    fa: f64_absbits(x)
    if fa = 0 -> return x
    if x < 0 -> return F64_QNAN
    if fa = F64_INFB -> return x
    dummy: f64_unpack(x)
    sm: f64_o_man
    se: f64_o_exp
    tp: f64_top(sm)
    as long as tp < 52
        sm: bshl(sm, 1)
        se: se - 1
        tp: tp + 1
    if band(se, 1) = 1
        sm: bshl(sm, 1)
        se: se - 1
    rt: 0
    rm: 0
    si: 26
    as long as si >= 0
        rm: bshl(rm, 2) + band(bshr(sm, si + si), 3)
        tr: bshl(rt, 2) + 1
        rt: bshl(rt, 1)
        if rm >= tr
            rm: rm - tr
            rt: rt + 1
        si: si - 1
    sj: 27
    as long as sj > 0
        rm: bshl(rm, 2)
        tr: bshl(rt, 2) + 1
        rt: bshl(rt, 1)
        if rm >= tr
            rm: rm - tr
            rt: rt + 1
        sj: sj - 1
    q_lo: rt
    q_lw: 0
    q_ln: 0
    q_si: 0
    if rm != 0 -> q_si: 1
    return f64_round(0, se / 2 - 27)
# ---- transcendentals (built on the exact primitives; a few ULP) ----
f64_nanx:
    return F64_QNAN
f64_pow2i k:
    # 2^k for k in [-1022, 1023] as a bit pattern
    return bshl(k + 1023, 52)
f64_roundi x:
    if f64_sign(x) is 1
        return f64_to_i64(f64_sub(x, F64C_HALF))
    return f64_to_i64(f64_add(x, F64C_HALF))
f64_ldexp x k:
    if f64_is_zero(x) is 1
        return x
    if k > 1023
        return f64_ldexp(f64_mul(x, F64C_TWO), k - 1)
    if k < 0 - 1022
        return f64_ldexp(f64_mul(x, F64C_HALF), k + 1)
    return f64_mul(x, f64_pow2i(k))
f64_log x:
    if f64_is_nan(x) is 1
        return x
    if f64_sign(x) is 1
        return f64_nanx()
    if f64_is_zero(x) is 1
        return bor(F64_INFB, bshl(1, 63))
    if f64_is_inf(x) is 1
        return x
    # x = m * 2^e with m in [sqrt(1/2), sqrt(2)); log m by atanh series,
    # z = (m-1)/(m+1) has |z| <= 0.1716 so z^15 tail is below 1e-17.
    dummy: f64_unpack(x)
    e: f64_o_exp + 52
    man: f64_o_man
    as long as band(man, F64_MANH) is 0
        man: bshl(man, 1)
        e: e - 1
    m: bor(bshl(1023, 52), man - F64_MANH)
    if f64_cmp(m, F64C_SQRTH) < 0
        m: f64_mul(m, F64C_TWO)
        e: e - 1
    if f64_cmp(m, F64C_SQRT2) >= 0
        m: f64_mul(m, F64C_HALF)
        e: e + 1
    z: f64_div(f64_sub(m, F64C_ONE), f64_add(m, F64C_ONE))
    z2: f64_mul(z, z)
    term: z
    s: z
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R3))
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R5))
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R7))
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R9))
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R11))
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R13))
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R15))
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R17))
    term: f64_mul(term, z2)
    s: f64_add(s, f64_mul(term, F64C_R19))
    lgm: f64_mul(F64C_TWO, s)
    if e is 0
        return lgm
    ef: f64_from_i64(e)
    hh: f64_add(f64_mul(ef, F64C_LN2HI), lgm)
    return f64_add(hh, f64_mul(ef, F64C_LN2LO))
f64_exp x:
    if f64_is_nan(x) is 1
        return x
    if f64_is_inf(x) is 1
        if f64_sign(x) is 1
            return 0
        return x
    if f64_is_zero(x) is 1
        return F64C_ONE
    if f64_cmp(x, f64_from_i64(710)) > 0
        return F64_INFB
    if f64_cmp(x, f64_from_i64(0 - 746)) < 0
        return 0
    k: f64_roundi(f64_mul(x, F64C_INVLN2))
    kf: f64_from_i64(k)
    r: f64_sub(x, f64_mul(kf, F64C_LN2HI))
    r: f64_sub(r, f64_mul(kf, F64C_LN2LO))
    # Taylor: term_{n} = term_{n-1} * r / n, |r| <= ln2/2 + eps
    s: F64C_ONE
    term: F64C_ONE
    term: f64_mul(term, r)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R2)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R3)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R4)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R5)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R6)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R7)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R8)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R9)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R10)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R11)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R12)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R13)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r), F64C_R14)
    s: f64_add(s, term)
    return f64_ldexp(s, k)
f64_pow x y:
    if f64_is_zero(y) is 1
        return F64C_ONE
    if f64_is_nan(x) is 1
        return x
    if f64_is_nan(y) is 1
        return y
    if f64_cmp(x, F64C_ONE) is 0
        return F64C_ONE
    yi: f64_roundi(y)
    if f64_cmp(f64_from_i64(yi), y) is 0
        if yi < 1048576
            if yi > 0 - 1048576
                n: yi
                neg: 0
                if n < 0
                    neg: 1
                    n: 0 - n
                res: F64C_ONE
                bs: x
                as long as n > 0
                    if band(n, 1) is 1
                        res: f64_mul(res, bs)
                    n: bshr(n, 1)
                    if n > 0
                        bs: f64_mul(bs, bs)
                if neg is 1
                    return f64_div(F64C_ONE, res)
                return res
    if f64_sign(x) is 1
        return f64_nanx()
    if f64_is_zero(x) is 1
        if f64_sign(y) is 1
            return F64_INFB
        return 0
    return f64_exp(f64_mul(y, f64_log(x)))
f64_red x:
    # three-part pi/2: H1/H2 carry 24 significant bits each, so q*H is
    # exact for |q| < 2^29 and the reduced argument stays accurate to
    # ~1e-16 even at |x| ~ 1e8 (beyond that it degrades gracefully).
    q: f64_roundi(f64_mul(x, F64C_INVPIO2))
    qf: f64_from_i64(q)
    r: f64_sub(x, f64_mul(qf, F64C_PIO2H1))
    r: f64_sub(r, f64_mul(qf, F64C_PIO2H2))
    r: f64_sub(r, f64_mul(qf, F64C_PIO2H3))
    f64_rq: q
    return r
f64_poly_sin r:
    r2: f64_mul(r, r)
    term: r
    s: r
    term: f64_mul(f64_mul(term, r2), F64C_SS6)
    s: f64_sub(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_SS20)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_SS42)
    s: f64_sub(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_SS72)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_SS110)
    s: f64_sub(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_SS156)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_G15)
    s: f64_sub(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_G17)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_G19)
    s: f64_sub(s, term)
    return s
f64_poly_cos r:
    r2: f64_mul(r, r)
    term: F64C_ONE
    s: F64C_ONE
    term: f64_mul(f64_mul(term, r2), F64C_CC2)
    s: f64_sub(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_CC12)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_CC30)
    s: f64_sub(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_CC56)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_CC90)
    s: f64_sub(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_CC132)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_H14)
    s: f64_sub(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_H16)
    s: f64_add(s, term)
    term: f64_mul(f64_mul(term, r2), F64C_H18)
    s: f64_sub(s, term)
    return s
f64_sin x:
    if f64_is_nan(x) is 1
        return x
    if f64_is_inf(x) is 1
        return f64_nanx()
    if f64_is_zero(x) is 1
        return x
    r: f64_red(x)
    q: band(f64_rq, 3)
    if q is 0
        return f64_poly_sin(r)
    if q is 1
        return f64_poly_cos(r)
    if q is 2
        return f64_neg(f64_poly_sin(r))
    return f64_neg(f64_poly_cos(r))
f64_cos x:
    if f64_is_nan(x) is 1
        return x
    if f64_is_inf(x) is 1
        return f64_nanx()
    if f64_is_zero(x) is 1
        return F64C_ONE
    r: f64_red(x)
    q: band(f64_rq, 3)
    if q is 0
        return f64_poly_cos(r)
    if q is 1
        return f64_neg(f64_poly_sin(r))
    if q is 2
        return f64_neg(f64_poly_cos(r))
    return f64_poly_sin(r)
f64_tan x:
    return f64_div(f64_sin(x), f64_cos(x))
