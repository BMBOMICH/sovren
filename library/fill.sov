use string
fill_bytes p n v:
    i: 0
    as long as i < n
        poke_byte(p, i, v)
        i: i + 1
    return p
fill_u64 p i v:
    k: 0
    as long as k < 8
        poke_byte(p, i + k, v % 256)
        v: v / 256
        k: k + 1
fill_str s n:
    out: ""
    i: 0
    as long as i < n
        out: str_cat(out, s)
        i: i + 1
    return out
