# array.sov — fixed-size number array in raw memory
use mem

arr_new n:
    p: mem_new(n * 8 + 8)
    poke_i64(p, 0, n)
    return p

arr_len a:
    return peek_i64(a, 0)

arr_get a i:
    if i < 0
        return 0
    if i > arr_len(a) - 1
        return 0
    return peek_i64(a, 8 + i * 8)

arr_set a i v:
    if i < 0
        return a
    if i > arr_len(a) - 1
        return a
    poke_i64(a, 8 + i * 8, v)
    return a

arr_fill a v:
    i: 0
    as long as i < arr_len(a)
        arr_set(a, i, v)
        i: i + 1
    return a

arr_sum a:
    t: 0
    i: 0
    as long as i < arr_len(a)
        t: t + arr_get(a, i)
        i: i + 1
    return t

arr_max a:
    if arr_len(a) is 0
        return 0
    m: arr_get(a, 0)
    i: 1
    as long as i < arr_len(a)
        v: arr_get(a, i)
        if v > m
            m: v
        i: i + 1
    return m

arr_min a:
    if arr_len(a) is 0
        return 0
    m: arr_get(a, 0)
    i: 1
    as long as i < arr_len(a)
        v: arr_get(a, i)
        if v < m
            m: v
        i: i + 1
    return m
