kacpi_dmar_rmrr_scope_at table maximum index scope_index record:
    if record is 0 -> return 0
    if index < 0 -> return 0
    if scope_index < 0 -> return 0
    if kacpi_dmar_valid(table, maximum) is not 1 -> return 0
    length: peek_raw32(table + 4, 0)
    found: 0
    offset: 48
    as long as offset < length
        typ: peek_raw16(table + offset, 0)
        size: peek_raw16(table + offset + 2, 0)
        if typ is 1
            if peek_raw16(table + offset + 6, 0) is 0
                if found is index
