kacpi_dmar_rmrr_match_direct table maximum index requester:
    if requester < 0 -> return 0 - 1
    if requester > 65535 -> return 0 - 1
    if index < 0 -> return 0 - 1
    if kacpi_dmar_valid(table, maximum) is not 1 -> return 0 - 1
    length: peek_raw32(table + 4, 0)
    found: 0
    offset: 48
    as long as offset < length
        typ: peek_raw16(table + offset, 0)
        size: peek_raw16(table + offset + 2, 0)
        if typ is 1
            if peek_raw16(table + offset + 6, 0) is 0
                if found is index
                    unresolved: 0
                    scope: 24
                    as long as scope < size
                        scope_type: peek_raw8(table + offset + scope, 0)
                        scope_size: peek_raw8(table + offset + scope + 1, 0)
                        if scope_type is 1
                            if scope_size is 8
                                bus: peek_raw8(table + offset + scope + 5, 0)
                                device: peek_raw8(table + offset + scope + 6, 0)
                                function: peek_raw8(table + offset + scope + 7, 0)
                                scoped: bus * 256 + device * 8 + function
                                if scoped is requester -> return 1
                            if not -> unresolved: 1
                        if not -> unresolved: 1
                        scope: scope + scope_size
                    if unresolved is 1 -> return 0 - 2
                    return 0
                found: found + 1
        offset: offset + size
    return 0 - 1
kacpi_dmar_first_rmrr table maximum record:
    return kacpi_dmar_rmrr_at(table, maximum, 0, record)
