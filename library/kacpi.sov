                    as long as scope < size
                        scope_size: peek_raw8(table + offset + scope + 1, 0)
                        if ordinal is scope_index
                            path_count: (scope_size - 6) / 2
                            poke_raw64(record, 0, peek_raw8(table + offset + scope, 0))
                            poke_raw64(record + 8, 0, peek_raw8(table + offset + scope + 5, 0))
                            poke_raw64(record + 16, 0, peek_raw8(table + offset + scope + 4, 0))
                            poke_raw64(record + 24, 0, path_count)
                            path: 0
                            as long as path < path_count
                                device: peek_raw8(table + offset + scope + 6 + path * 2, 0)
                                function: peek_raw8(table + offset + scope + 7 + path * 2, 0)
