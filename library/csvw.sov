# csvw.sov — write CSV with proper quoting
use string
use file
use list

cw_needs s:
    i: 0
    as long as i < str_len(s)
        c: peek_byte(s, i)
        if c is 44
            return 1
        if c is 34
            return 1
        if c is 10
            return 1
        i: i + 1
    return 0

cw_quote s:
    if cw_needs(s) is 0
        return as text s
    n: str_len(s)
    out: _sov_alloc(n * 2 + 3)
    o: 0
    poke_byte(out, o, 34)
    o: o + 1
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 34
            poke_byte(out, o, 34)
            o: o + 1
        poke_byte(out, o, c)
        o: o + 1
        i: i + 1
    poke_byte(out, o, 34)
    poke_byte(out, o + 1, 0)
    return as text out

cw_row items:
    line: ""
    i: 0
    as long as i < list_len(items)
        if i > 0
            line: str_cat(line, ",")
        line: str_cat(line, cw_quote(list_get(items, i)))
        i: i + 1
    return as text line

cw_write path items:
    return file_append(path, str_cat(cw_row(items), "\n"))
