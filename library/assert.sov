# assert.sov — checks that stop the program when wrong
use string
use num

as_pass: 0
as_fail: 0

as_eq name got want:
    if got is want
        as_pass: as_pass + 1
        return 1
    as_fail: as_fail + 1
    print "FAIL" : name
    print "got" : got
    print "want" : want
    return 0

as_true name v:
    return as_eq(name, v, 1)

as_false name v:
    return as_eq(name, v, 0)

as_text name got want:
    if str_eq(got, want) is 1
        as_pass: as_pass + 1
        return 1
    as_fail: as_fail + 1
    print "FAIL" : name
    print "got" : got
    print "want" : want
    return 0

as_report:
    print "passed" : as_pass
    print "failed" : as_fail
    if as_fail > 0
        return 1
    return 0
