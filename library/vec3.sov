use fixed
use mem
v3_new x y z:
    v: _sov_alloc(24)
    poke_i64(v, 0, x)
    poke_i64(v, 8, y)
    poke_i64(v, 16, z)
    return v
v3_x v:
    return peek_i64(v, 0)
v3_y v:
    return peek_i64(v, 8)
v3_z v:
    return peek_i64(v, 16)
v3_add a b:
    return v3_new(fx_add(v3_x(a), v3_x(b)), fx_add(v3_y(a), v3_y(b)), fx_add(v3_z(a), v3_z(b)))
v3_sub a b:
    return v3_new(fx_sub(v3_x(a), v3_x(b)), fx_sub(v3_y(a), v3_y(b)), fx_sub(v3_z(a), v3_z(b)))
v3_dot a b:
    return fx_add(fx_add(fx_mul(v3_x(a), v3_x(b)), fx_mul(v3_y(a), v3_y(b))), fx_mul(v3_z(a), v3_z(b)))
v3_len v:
    return fx_sqrt(v3_dot(v, v))
