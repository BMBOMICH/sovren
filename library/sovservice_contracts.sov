sovservice_dependency service:
    if service is 1 -> return 0
    if service is 2 -> return 1
    if service is 3 -> return 2
    if service is 4 -> return 3
    if service is 5 -> return 3
    if service is 6 -> return 5
    if service is 7 -> return 4
    if service is 8 -> return 4
    return 0 - 1
sovservice_restart_limit service:
    if service is 1 -> return 0
    if service is 2 -> return 2
    if service is 3 -> return 1
    if service is 4 -> return 1
    if service is 5 -> return 1
    if service is 6 -> return 1
    if service is 7 -> return 1
    if service is 8 -> return 1
    return 0 - 1
sovservice_health_ticks service:
    if service is 1 -> return 0
    if service is 2 -> return 200
    if service is 3 -> return 200
    if service is 4 -> return 500
    if service is 5 -> return 500
    if service is 6 -> return 500
    if service is 7 -> return 500
    if service is 8 -> return 500
    return 0 - 1
sovservice_shutdown_order service:
    if service is 1 -> return 8
    if service is 2 -> return 7
    if service is 3 -> return 6
    if service is 4 -> return 5
    if service is 5 -> return 4
    if service is 6 -> return 3
    if service is 7 -> return 2
    if service is 8 -> return 1
    return 0 - 1
sovservice_runtime service:
    if service is 1 -> return 0
    if service is 2 -> return 1
    if service is 3 -> return 2
    if service is 4 -> return 3
    if service is 5 -> return 3
    if service is 6 -> return 3
    if service is 7 -> return 3
    if service is 8 -> return 3
    return 0 - 1
sovservice_primary_message service:
    if service is 2 -> return 1
    if service is 2 -> return 2
    if service is 3 -> return 1
    if service is 4 -> return 1
    if service is 5 -> return 1
    if service is 6 -> return 1
    if service is 7 -> return 1
    if service is 8 -> return 1
    return 0 - 1
