# boot.sov — boot and initialization
# Real implementation

use sys
use process
use filesystem

# Initialize system
boot_init:
    # Set up signal handlers
    boot_setup_signals
    # Initialize memory allocator
    boot_init_memory
    # Initialize stdio
    boot_init_stdio
    return 0

# Set up signal handlers
boot_setup_signals:
    # Ignore SIGPIPE
    syscall(134, 13, 1, 0)
    # Handle SIGCHLD
    syscall(134, 17, 0, 0)

# Initialize memory
boot_init_memory:
    heap_init
    return 0

# Initialize stdio
boot_init_stdio:
    stdin_fd: 0
    stdout_fd: 1
    stderr_fd: 2
    return 0

# Load configuration
boot_load_config path:
    data: fs_read_all(path)
    if data = 0
        return 0
    return data

# Parse command line arguments
boot_parse_args argc, argv:
    args: _sov_alloc(argc * 8)
    i: 0
    as long as i < argc:
        arg_ptr: peek_i64(argv, i * 8)
        poke_i64(args, i * 8, arg_ptr)
        i: i + 1
    return args

# Get environment variable
boot_getenv name:
    return syscall(279, name)

# Set environment variable
boot_setenv name, value, overwrite:
    return syscall(280, name, value, overwrite)

# Clean shutdown
boot_shutdown code:
    # Flush buffers
    sys_sync
    # Exit
    proc_exit(code)

# Daemon mode
boot_daemonize:
    pid: proc_fork()
    if pid < 0
        return -1
    if pid > 0
        proc_exit(0)
    # Create new session
    syscall(112)
    # Fork again
    pid2: proc_fork()
    if pid2 < 0
        return -1
    if pid2 > 0
        proc_exit(0)
    # Change working directory
    fs_chdir("/")
    # Close file descriptors
    sys_close(0)
    sys_close(1)
    sys_close(2)
    # Redirect to /dev/null
    sys_open("/dev/null", 0)
    sys_open("/dev/null", 1)
    sys_open("/dev/null", 1)
    return 0
