# winapi.sov — reaching the rest of Windows.
#
# A Sovren program built for Windows brings thirteen names with it,
# and two of those are the keys to everything else: LoadLibraryA
# opens any library on the machine, and GetProcAddress finds a
# function inside it. So the program does not need every name it
# might ever want written into it at build time. It asks for them
# when it runs.
#
#   use winapi
#   main:
#       u: dll_open("user32.dll")
#       f: dll_find(u, "MessageBoxA")
#       wincall(f, 0, "hello", "Sovren", 0)
#
# This only works in a program built with --windows. Everywhere
# else dll_open hands back nought, which is the honest answer.

use sys
use string
use mem
use num

# The two names the loader brought with it live in the import
# table. Their addresses are found by walking that table, which is
# at a fixed place in every program this compiler writes.
wa_loadlib: 0
wa_getproc: 0
wa_ready: 0

# Find the import table and pull out the two entries wanted. The
# table sits in .rdata, which begins one page after the code, and
# the entries are in the order the compiler writes them: the
# twelfth is LoadLibraryA and the thirteenth is GetProcAddress.
wa_init:
    if wa_ready is 1
        if wa_loadlib is 0
            return 0
        return 1
    wa_ready: 1
    base: wa_image_base()
    if base is 0
        return 0
    # the IAT directory in the optional header points straight at the
    # import table; LoadLibraryA and GetProcAddress are always the
    # last two entries, so their addresses are the last two before
    # the null terminator.
    pe: peek_u32(base, 60)
    if pe < 64
        return 0
    iat_rva: peek_u32(base, pe + 24 + 112 + 96)
    iat_size: peek_u32(base, pe + 24 + 112 + 96 + 4)
    if iat_size < 32
        return 0
    n: iat_size / 8
    wa_loadlib: peek_raw64(base + iat_rva, (n - 3) * 8)
    wa_getproc: peek_raw64(base + iat_rva, (n - 2) * 8)
    if wa_loadlib is 0
        return 0
    return 1

# Where this program was loaded. The windows compiler replaces
# _sov_image_base with a PEB read, which is right under ASLR.
# 4194304 is the ImageBase the header asks for, used when that
# helper is not there.
_sov_image_base:
    return 0

_sov_ccall fn argv:
    return 0

wa_image_base:
    return _sov_image_base()

# These read the program's own memory at a fixed address, which is
# not the same as reading inside a piece of memory it was given.
# peek_byte counts from a block; peek_raw8 goes anywhere.
peek_u32 p off:
    return peek_raw8(p, off) + peek_raw8(p, off + 1) * 256 + peek_raw8(p, off + 2) * 65536 + peek_raw8(p, off + 3) * 16777216

peek_u16 p off:
    return peek_raw8(p, off) + peek_raw8(p, off + 1) * 256

# is any of this available?
dll_ok:
    return wa_init()

# one argument block for _sov_ccall. That is the Windows calling
# convention the compiler actually emits. cfunc is not used here:
# a zero return is a real Windows answer (the window did not open,
# the message loop ended) and must not be treated as a failed call.
wa_pack a b c d e:
    av: mem_new(96)
    poke_i64(av, 0, a)
    poke_i64(av, 8, b)
    poke_i64(av, 16, c)
    poke_i64(av, 24, d)
    poke_i64(av, 32, e)
    poke_i64(av, 40, 0)
    poke_i64(av, 48, 0)
    poke_i64(av, 56, 0)
    poke_i64(av, 64, 0)
    poke_i64(av, 72, 0)
    poke_i64(av, 80, 0)
    poke_i64(av, 88, 0)
    return av

wa_call f a b c d e:
    if f is 0
        return 0
    return _sov_ccall(f, wa_pack(a, b, c, d, e))

# open a library by name, or nought when it is not there
dll_open name:
    if wa_init() is 0
        return 0
    return wa_call(wa_loadlib, name, 0, 0, 0, 0)

# find something inside one
dll_find lib name:
    if lib is 0
        return 0
    if wa_init() is 0
        return 0
    return wa_call(wa_getproc, lib, name, 0, 0, 0)

# call it, with up to six values
wincall f a b c d e:
    return wa_call(f, a, b, c, d, e)

wincall0 f:
    return wa_call(f, 0, 0, 0, 0, 0)

wincall1 f a:
    return wa_call(f, a, 0, 0, 0, 0)

wincall2 f a b:
    return wa_call(f, a, b, 0, 0, 0)

wincall3 f a b c:
    return wa_call(f, a, b, c, 0, 0)

wincall4 f a b c d:
    return wa_call(f, a, b, c, d, 0)

wincall12 f argv:
    if f is 0
        return 0
    return _sov_ccall(f, argv)
