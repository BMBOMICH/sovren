# bit32.sov — 32-bit word helpers (pure Sovren)

M32: 4294967296

w32 x:
    r: x % M32
    if r < 0
        r: r + M32
    return r

wand a b:
    return band(w32(a), w32(b))

wor a b:
    return bor(w32(a), w32(b))

wxor a b:
    return bxor(w32(a), w32(b))

wnot a:
    return w32(4294967295 - w32(a))

shr a n:
    r: w32(a)
    i: 0
    as long as i < n
        r: r / 2
        i: i + 1
    return r

shl a n:
    r: w32(a)
    i: 0
    as long as i < n
        r: w32(r * 2)
        i: i + 1
    return r

rotr a n:
    return wor(shr(a, n), shl(a, 32 - n))

wadd a b:
    return w32(w32(a) + w32(b))
