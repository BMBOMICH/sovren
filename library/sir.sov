# IDs are stable within a module. Children precede parents; calls bind task IDs.
sir_version: 1
sir_nodes: 0
sir_sites: 0
sir_dump_mode: 0

sir_make kind text left right children symbol:
    node: _sov_list_new()
    node: _sov_list_add(node, kind)
    node: _sov_list_add(node, text)
    node: _sov_list_add(node, left)
    node: _sov_list_add(node, right)
    node: _sov_list_add(node, children)
    node: _sov_list_add(node, tp_line)
    node: _sov_list_add(node, tp_fidx)
    node: _sov_list_add(node, symbol)
    id: _sov_list_len(sir_nodes)
    sir_nodes: _sov_list_add(sir_nodes, node)
    return id

sir_site id:
    site: _sov_list_new()
    site: _sov_list_add(site, tp_fidx)
    site: _sov_list_add(site, tp_line)
    site: _sov_list_add(site, id)
    sir_sites: _sov_list_add(sir_sites, site)
    return 0

sir_quote value:
    tp_emit(str_chr(34))
    i: 0
    as long as i < str_len(value)
        c: peek_byte(value, i)
        if c = 34 or c = 92
            tp_emit(str_chr(92))
            tp_emit(str_chr(c))
        if not
            if c = 10
                tp_emit(str_cat(str_chr(92), "n"))
            if not
                if c = 13
                    tp_emit(str_cat(str_chr(92), "r"))
                if not
                    if c = 9
                        tp_emit(str_cat(str_chr(92), "t"))
                    if not
                        if c < 32
                            tp_fail("unsupported control byte in SIR export")
                        tp_emit(str_chr(c))
        i: i + 1
    tp_emit(str_chr(34))
    return 0

sir_export:
    tp_output: _sov_list_new()
    tp_emit("{\"format\":\"Sovren SIR\",\"version\":1,\"integer_type\":\"checked-i64\",\"functions\":[")
    i: 0
    as long as i < _sov_list_len(tp_funcs)
        if i > 0
            tp_emit(",")
        fn: _sov_list_get(tp_funcs, i)
        tp_emit("{\"id\":")
        tp_emit(num_text(i))
        tp_emit(",\"name\":")
        sir_quote(as text _sov_list_get(fn, 0))
        tp_emit(",\"parameters\":[")
        params: _sov_list_get(fn, 1)
        j: 0
        as long as j < _sov_list_len(params)
            if j > 0
                tp_emit(",")
            sir_quote(as text _sov_list_get(params, j))
            j: j + 1
        tp_emit("],\"locals\":[")
        locals: _sov_list_get(fn, 3)
        j: 0
        as long as j < _sov_list_len(locals)
            if j > 0
                tp_emit(",")
            sir_quote(as text _sov_list_get(locals, j))
            j: j + 1
        tp_emit("],\"first_row\":")
        tp_emit(num_text(_sov_list_get(fn, 2)))
        tp_emit("}")
        i: i + 1
    tp_emit("],\"overflow\":")
    if tp_unsafe = 1
        sir_quote("wrap")
    if not
        sir_quote("trap")
    tp_emit(",\"nodes\":[")
    i: 0
    as long as i < _sov_list_len(sir_nodes)
        if i > 0
            tp_emit(",")
        node: _sov_list_get(sir_nodes, i)
        tp_emit("{\"id\":")
        tp_emit(num_text(i))
        tp_emit(",\"type\":\"i64\",\"kind\":")
        sir_quote(as text _sov_list_get(node, 0))
        tp_emit(",\"text\":")
        sir_quote(as text _sov_list_get(node, 1))
        tp_emit(",\"left\":")
        tp_emit(num_text(_sov_list_get(node, 2)))
        tp_emit(",\"right\":")
        tp_emit(num_text(_sov_list_get(node, 3)))
        tp_emit(",\"arguments\":[")
        children: _sov_list_get(node, 4)
        if children != 0
            j: 0
            as long as j < _sov_list_len(children)
                if j > 0
                    tp_emit(",")
                tp_emit(num_text(_sov_list_get(children, j)))
                j: j + 1
        tp_emit("],\"line\":")
        tp_emit(num_text(_sov_list_get(node, 5)))
        tp_emit(",\"function\":")
        tp_emit(num_text(_sov_list_get(node, 6)))
        tp_emit(",\"symbol\":")
        tp_emit(num_text(_sov_list_get(node, 7)))
        tp_emit("}")
        i: i + 1
    tp_emit("],\"expression_sites\":[")
    i: 0
    as long as i < _sov_list_len(sir_sites)
        if i > 0
            tp_emit(",")
        site: _sov_list_get(sir_sites, i)
        tp_emit("[")
        tp_emit(num_text(_sov_list_get(site, 0)))
        tp_emit(",")
        tp_emit(num_text(_sov_list_get(site, 1)))
        tp_emit(",")
        tp_emit(num_text(_sov_list_get(site, 2)))
        tp_emit("]")
        i: i + 1
    tp_emit("],\"statements\":[")
    i: 0
    as long as i < _sov_list_len(sir_statements)
        if i > 0
            tp_emit(",")
        statement: _sov_list_get(sir_statements, i)
        tp_emit("{\"function\":")
        tp_emit(num_text(_sov_list_get(statement, 0)))
        tp_emit(",\"line\":")
        tp_emit(num_text(_sov_list_get(statement, 1)))
        tp_emit(",\"kind\":")
        sir_quote(as text _sov_list_get(statement, 2))
        tp_emit(",\"expression\":")
        tp_emit(num_text(_sov_list_get(statement, 3)))
        tp_emit(",\"text\":")
        sir_quote(as text _sov_list_get(statement, 4))
        tp_emit(",\"auxiliary\":")
        tp_emit(num_text(_sov_list_get(statement, 5)))
        tp_emit("}")
        i: i + 1
    tp_emit("],\"rows\":[")
    i: 0
    as long as i < _sov_list_len(tp_rows)
        if i > 0
            tp_emit(",")
        row: _sov_list_get(tp_rows, i)
        tp_emit("{\"indent\":")
        tp_emit(num_text(_sov_list_get(row, 0)))
        tp_emit(",\"line\":")
        tp_emit(num_text(_sov_list_get(row, 1)))
        tp_emit(",\"tokens\":[")
        tokens: _sov_list_get(row, 2)
        j: 0
        as long as j < _sov_list_len(tokens)
            if j > 0
                tp_emit(",")
            sir_quote(as text _sov_list_get(tokens, j))
            j: j + 1
        tp_emit("]}")
        i: i + 1
    tp_emit("]}\n")
    return tp_flush()

sir_statements: 0

sir_statement kind expression text auxiliary:
    statement: _sov_list_new()
    statement: _sov_list_add(statement, tp_fidx)
    statement: _sov_list_add(statement, tp_line)
    statement: _sov_list_add(statement, kind)
    statement: _sov_list_add(statement, expression)
    statement: _sov_list_add(statement, text)
    statement: _sov_list_add(statement, auxiliary)
    sir_statements: _sov_list_add(sir_statements, statement)
    return 0
