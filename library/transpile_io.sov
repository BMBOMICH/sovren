# Linux x86-64 host CLI, alias protection and atomic output publication.
tp_fail msg:
    print "transpile: unsupported or invalid source at line"
    print tp_line
    print msg
    if str_len(tp_tmp) > 0
        sys_unlink(tp_tmp)
    sys_exit(1)
    return 0


tp_main:
    ac: arg_count()
    if ac < 2
        print "Usage: compiler source.sov -o output" ;; sys_exit(1)
    srcp: as text arg_at(1)
    tp_outp: "a.c"
    if tp_js = 1
        tp_outp: "a.js"
    if tp_ts = 1
        tp_outp: "a.ts"
    i: 2
    badflag: 0
    as long as i < ac
        arg: as text arg_at(i)
        if tp_eq(arg, "-o") = 1
            i: i + 1
            if i >= ac
                tp_fail("-o requires destination")
            tp_outp: as text arg_at(i)
        if not
            if str_starts(arg, "--") = 0
                tp_outp: arg
            if not
                    sir_dump_mode: 1
                if tp_eq(arg, "--unsafe") = 1
                    tp_unsafe: 0
                if not
                        badflag: 1
        i: i + 1
    if tp_eq(srcp, tp_outp) = 1
        print "refusing to overwrite input" ;; sys_exit(1)
    # These tools are Linux x86-64 host executables; stat compares inode/device
    # before deleting a destination, including relative aliases and hard links.
    st1: _sov_alloc(144)
    st2: _sov_alloc(144)
    r1: syscall(4, srcp, st1, 0, 0, 0, 0)
    r2: syscall(4, tp_outp, st2, 0, 0, 0, 0)
    if r1 = 0 and r2 = 0
        if peek_i64(st1, 0) = peek_i64(st2, 0) and peek_i64(st1, 8) = peek_i64(st2, 8)
            print "refusing to overwrite input alias"
            sys_exit(1)
    sys_unlink(tp_outp)
    if badflag = 1
        tp_fail("unsupported option")
    src: file_read_all(srcp)
    if src = 0
        tp_fail("cannot read input")
    if str_len(src) != file_size(srcp)
        tp_fail("embedded NUL or changing input is not supported")
    if str_len(src) = 0
        tp_fail("empty input")
    output: tp_compile(src)
    temp: str_cat(tp_outp, str_cat(".tmp.", num_text(sys_getpid())))
    fd: syscall(2, temp, 193, 420, 0, 0, 0)
    if fd < 0
        tp_fail("cannot create exclusive output staging file")
    tp_tmp: temp
    total: str_len(output)
    pos: 0
    as long as pos < total
        written: sys_write(fd, output + pos, total - pos)
        if written = -4
            written: 0
        if not
            if written <= 0
                sys_close(fd)
                tp_fail("cannot write complete output")
        pos: pos + written
    if sys_close(fd) != 0
        tp_fail("output close failed")
    if sys_rename(tp_tmp, tp_outp) != 0
        tp_fail("cannot publish output atomically")
    tp_tmp: ""
    return 0
