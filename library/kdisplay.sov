# unsafe-module
kdsp_mode_valid width height pitch bytes:
    if width < 1 -> return 0
    if height < 1 -> return 0
    if width > 16384 -> return 0
    if height > 16384 -> return 0
    if pitch < width * 4 -> return 0
    if pitch % 4 is not 0 -> return 0
    if bytes < pitch -> return 0
    if height > bytes / pitch -> return 0
    return 1
kdsp_span32 framebuffer width height x y source pixels:
    if framebuffer is 0 -> return 0
    if source is 0 -> return 0
    if width < 1 -> return 0
    if height < 1 -> return 0
    if width > 16384 -> return 0
    if height > 16384 -> return 0
    if x < 0 -> return 0
    if y < 0 -> return 0
    if y >= height -> return 0
    if pixels < 1 -> return 0
    if pixels > width -> return 0
    if x > width - pixels -> return 0
    pitch: width * 4
    target: framebuffer + y * pitch + x * 4
    i: 0
    as long as i < pixels
        poke_raw32(target + i * 4, 0, peek_raw32(source + i * 4, 0))
        i: i + 1
    return pixels
kdsp_fill32 framebuffer width height origin extent color:
    if framebuffer is 0 -> return 0
    if width < 1 -> return 0
    if height < 1 -> return 0
    if width > 16384 -> return 0
    if height > 16384 -> return 0
    x: band(origin, 65535)
    y: band(bshr(origin, 16), 65535)
    rect_width: band(extent, 65535)
    rect_height: band(bshr(extent, 16), 65535)
    if rect_width < 1 -> return 0
    if rect_height < 1 -> return 0
    if rect_width > width -> return 0
    if rect_height > height -> return 0
    if x > width - rect_width -> return 0
    if y > height - rect_height -> return 0
    pitch: width * 4
    row: 0
    as long as row < rect_height
        target: framebuffer + (y + row) * pitch + x * 4
        column: 0
        as long as column < rect_width
            poke_raw32(target + column * 4, 0, color)
            column: column + 1
        row: row + 1
    return rect_width * rect_height
