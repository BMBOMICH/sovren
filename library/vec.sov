# vec: growable 64-bit vector.
vec_new n:
    v: _sov_list_new()
    return v
vec_push v x:
    v: _sov_list_add(v, x)
    return v
vec_get v i:
    return _sov_list_get(v, i)
vec_set v i x:
    dummy: _sov_list_set(v, i, x)
    return v
vec_len v:
    return _sov_list_len(v)
vec_find v x:
    n: _sov_list_len(v)
    i: 0
    as long as i < n
        if _sov_list_get(v, i) = x -> return i
        i: i + 1
    return 0 - 1
vec_pop v:
    n: _sov_list_len(v)
    if n is 0 -> return 0
    r: _sov_list_get(v, n - 1)
    dummy: poke_i64(v, 8, n - 1)
    return r
