# network.sov — network operations
# Real implementation with syscalls

use sys

# Create socket
net_socket domain, type, protocol:
    return syscall(41, domain, type, protocol)

# Bind socket to address
net_bind sockfd, addr, addrlen:
    return syscall(49, sockfd, addr, addrlen)

# Listen for connections
net_listen sockfd, backlog:
    return syscall(50, sockfd, backlog)

# Accept connection
net_accept sockfd, addr, addrlen:
    return syscall(43, sockfd, addr, addrlen)

# Connect to server
net_connect sockfd, addr, addrlen:
    return syscall(42, sockfd, addr, addrlen)

# Send data
net_send sockfd, buf, len, flags:
    return syscall(44, sockfd, buf, len, flags)

# Receive data
net_recv sockfd, buf, len, flags:
    return syscall(45, sockfd, buf, len, flags)

# Send to address
net_sendto sockfd, buf, len, flags, dest_addr, addrlen:
    return syscall(44, sockfd, buf, len, flags, dest_addr, addrlen)

# Receive from address
net_recvfrom sockfd, buf, len, flags, src_addr, addrlen:
    return syscall(45, sockfd, buf, len, flags, src_addr, addrlen)

# Close socket
net_close sockfd:
    return syscall(3, sockfd)

# Set socket option
net_setsockopt sockfd, level, optname, optval, optlen:
    return syscall(54, sockfd, level, optname, optval, optlen)

# Get socket option
net_getsockopt sockfd, level, optname, optval, optlen:
    return syscall(55, sockfd, level, optname, optval, optlen)

# Shutdown socket
net_shutdown sockfd, how:
    return syscall(48, sockfd, how)

# IPv4 socket address
net_addr4 ip, port:
    addr: _sov_alloc(16)
    poke_u16(addr, 0, 2)
    poke_u16(addr, 2, port)
    poke_u32(addr, 4, ip)
    return addr

# IPv6 socket address
net_addr6 ip6, port:
    addr: _sov_alloc(28)
    poke_u16(addr, 0, 10)
    poke_u16(addr, 2, port)
    poke_u32(addr, 4, 0)
    poke_i64(addr, 8, ip6)
    return addr

# Create TCP socket
net_tcp:
    return net_socket(2, 1, 0)

# Create UDP socket
net_udp:
    return net_socket(2, 2, 0)
