        rl: tl_clen
        seq: seq + 1
        sock_send_raw(fd, en, rl)
        i: i + cl
    tl_wipe(ckey, 16)
    tl_wipe(civ, 12)
    return 1
tl13_step_read fd sap out outmax:
    skey: _sov_heap_alloc(16)
    siv: _sov_heap_alloc(12)
    tl13_key(sap, skey)
    tl13_iv(sap, siv)
    pt: _sov_alloc(20000)
    seq: 0
    tot: 0
    more: 1
    as long as more is 1
        r: tl_recv(fd)
        if r is not 0 -> more: 0
        if not
            if tl_rtype is 20 -> more: more
            if not
                if tl_rtype is not 23 -> more: 0
                if not
                    ok: tl13_dec(tl_rb, tl_rlen, skey, siv, seq, pt)
                    seq: seq + 1
                    if ok is 0 -> more: 0
                    if not
                        if tl13_ptype is 23
                            j: 0
                            as long as j < tl13_pn
                                if tot + j < outmax -> poke_byte(out, tot + j, peek_byte(pt, j))
                                j: j + 1
                            tot: tot + tl13_pn
                        if tl13_ptype is 21 -> more: 0
    tl_wipe(skey, 16)
    tl_wipe(siv, 12)
    tl_gtot: tot
    return 1
tl13_client fd host req out outmax:
    tl_cur_host: host
    tl_seq_c: 0
    tl_seq_s: 0
    hs: _sov_alloc(20000)
    epriv: _sov_alloc(32)
    epub: _sov_alloc(32)
    spub: _sov_alloc(32)
    cts: _sov_alloc(32)
    sts: _sov_alloc(32)
    cap: _sov_alloc(32)
    sap: _sov_alloc(32)
    hsec: 0
    mb: _sov_alloc(272)
    eb: _sov_alloc(8)
    r: tl13_step_ch(fd, host, hs, epriv, epub)
    if r is 0 -> return tl13_wipe(epriv, cts, sts, cap, sap, hsec, 0)
    hlen: tl_hslen
    r: tl13_step_sh(fd, hs, spub)
    if r is 0 -> return tl13_wipe(epriv, cts, sts, cap, sap, hsec, 0)
    hlen: tl_hslen
    r: tl13_hs_keys(epriv, spub, hs, hlen, cts, sts)
    if r is 0 -> return tl13_wipe(epriv, cts, sts, cap, sap, hsec, 0)
    tl13_hss: 0
    r: tl13_flight(fd, hs, hlen, sts, mb, eb)
    if r is 0 -> return tl13_wipe(epriv, cts, sts, cap, sap, hsec, 0)
    hfin: tl_hslen
    hsec: tl13_hs_secret(epriv, spub)
    r: tl13_app_keys(hsec, hs, hfin, cts, sts, cap, sap)
    if r is 0 -> return tl13_wipe(epriv, cts, sts, cap, sap, hsec, 0)
    tl_wipe(epriv, 32)
    tl_wipe(hsec, 32)
    r: tl13_step_cfin(fd, hs, hfin, cts)
    if r is 0 -> return tl13_wipe(epriv, cts, sts, cap, sap, hsec, 0)
    r: tl13_step_send(fd, req, cap)
    if r is 0 -> return tl13_wipe(epriv, cts, sts, cap, sap, hsec, 0)
    r: tl13_step_read(fd, sap, out, outmax)
    tl_len: tl_gtot
    return tl13_wipe(epriv, cts, sts, cap, sap, hsec, tl_gtot)
tl13_hs_secret epriv spub:
    ss: _sov_heap_alloc(32)
    x19(ss, epriv, spub)
    zero: _sov_heap_alloc(32)
    i: 0
    as long as i < 32
        poke_byte(zero, i, 0)
        i: i + 1
    early: _sov_heap_alloc(32)
    hkdf_extract(zero, 32, zero, 32, early)
    h0r: _sov_heap_alloc(64)
    sha256_bytes(zero, 0, h0r)
    h0: _sov_heap_alloc(32)
    tl13_pack32(h0r, h0)
    lab: _sov_heap_alloc(80)
    i: 0
    as long as i < 7
        poke_byte(lab, i, peek_byte("derived", i))
        i: i + 1
    i: 0
    as long as i < 32
        poke_byte(lab, 33 + i, peek_byte(h0, i))
        i: i + 1
    salt: _sov_heap_alloc(32)
    tl13_derive(early, lab, salt)
    hssec: _sov_alloc(32)
    hkdf_extract(salt, 32, ss, 32, hssec)
    tl_wipe(ss, 32)
    tl_wipe(early, 32)
    tl_wipe(salt, 32)
    return hssec
tl13_send_req host port req out outmax:
    ip: web_lookup(host)
    if str_len(ip) is 0 -> return 0
    tl_parse_ip(ip)
    fd: sock_connect(tl_a0, tl_a1, tl_a2, tl_a3, port)
    if fd < 0 -> return 0
    tot: tl13_client(fd, host, req, out, outmax)
    sock_close(fd)
    return tot
tl13_get host port path out outmax:
    req: str_cat("GET ", path)
    req: str_cat(req, " HTTP/1.1\r\nHost: ")
    req: str_cat(req, host)
    req: str_cat(req, "\r\nConnection: close\r\n\r\n")
    return tl13_send_req(host, port, req, out, outmax)
tl_get_best host port path out outmax:
    tot: tl13_get(host, port, path, out, outmax)
    if tot > 0 -> return tot
    return tl_get(host, port, path, out, outmax)
tl13_mgf1 h out n:
    c: 0
    filled: 0
    as long as filled < n
        b: _sov_alloc(36)
        i: 0
        as long as i < 32
            poke_byte(b, i, peek_byte(h, i))
            i: i + 1
        poke_byte(b, 32, wand(shr(c, 24), 255))
        poke_byte(b, 33, wand(shr(c, 16), 255))
        poke_byte(b, 34, wand(shr(c, 8), 255))
        poke_byte(b, 35, c % 256)
        o: _sov_alloc(64)
        sha256_bytes(b, 36, o)
        p: _sov_alloc(32)
        tl13_pack32(o, p)
        i: 0
        as long as i < 32
            if filled + i < n -> poke_byte(out, filled + i, peek_byte(p, i))
            i: i + 1
        filled: filled + 32
        c: c + 1
tl13_cv_pss sg sl mb eb hb:
    k: peek_i64(mb, 256)
    ck: _sov_alloc(600)
    tl_rsa_enc(sg, sl, ck, mb, k, eb, peek_i64(mb, 264))
    hh: _sov_alloc(32)
    i: 0
    as long as i < 32
        poke_byte(hh, i, peek_byte(ck, k - 33 + i))
        i: i + 1
    dbl: k - 33
    mask: _sov_heap_alloc(dbl)
    tl13_mgf1(hh, mask, dbl)
    db: _sov_heap_alloc(dbl)
    i: 0
    as long as i < dbl
        poke_byte(db, i, wxor(peek_byte(ck, i), peek_byte(mask, i)))
        i: i + 1
    if wand(peek_byte(db, 0), 127) is not 0 -> return 0
    i: 1
    as long as i < dbl - 33
        if peek_byte(db, i) is not 0 -> return 0
        i: i + 1
    if peek_byte(db, dbl - 33) is not 1 -> return 0
    mp: _sov_heap_alloc(72)
    i: 0
    as long as i < 8
        poke_byte(mp, i, 0)
        i: i + 1
    i: 0
    as long as i < 32
        poke_byte(mp, 8 + i, peek_byte(hb, i))
        poke_byte(mp, 40 + i, peek_byte(db, dbl - 32 + i))
        i: i + 1
    h2r: _sov_alloc(64)
    sha256_bytes(mp, 72, h2r)
    h2: _sov_alloc(32)
    tl13_pack32(h2r, h2)
    i: 0
    as long as i < 32
        if peek_byte(h2, i) is not peek_byte(hh, i) -> return 0
        i: i + 1
    return 1
tl10_n: 0
tl10_flen: 0
tl10_stream out secret slen hashwhich lseed llen:
    s: _sov_alloc(24)
    if hashwhich is 0 -> hmac_md5(secret, slen, lseed, llen, s)
    if not -> hmac_sha1(secret, slen, lseed, llen, s)
    sl: 16
    if hashwhich is not 0 -> sl: 20
    pos: 0
    blk: _sov_alloc(20)
    am: _sov_alloc(sl + llen)
    as long as pos < tl10_n
        j: 0
        as long as j < sl
            poke_byte(am, j, peek_byte(s, j))
            j: j + 1
        j: 0
        as long as j < llen
            poke_byte(am, sl + j, peek_byte(lseed, j))
            j: j + 1
        if hashwhich is 0 -> hmac_md5(secret, slen, am, sl + llen, blk)
        if not -> hmac_sha1(secret, slen, am, sl + llen, blk)
        j: 0
        as long as j < sl
            if pos + j < tl10_n -> poke_byte(out, pos + j, peek_byte(blk, j))
            j: j + 1
        if hashwhich is 0 -> hmac_md5(secret, slen, s, 16, s)
        if not -> hmac_sha1(secret, slen, s, 20, s)
        pos: pos + sl
tl10_prf out secret slen label llen seed slen2:
    half: (slen + 1) / 2
    lseed: _sov_heap_alloc(llen + slen2 + 1)
    j: 0
    as long as j < llen
        poke_byte(lseed, j, peek_byte(label, j))
        j: j + 1
    j: 0
    as long as j < slen2
        poke_byte(lseed, llen + j, peek_byte(seed, j))
        j: j + 1
    want: tl10_n
    s2: _sov_alloc(half + 1)
    j: 0
    as long as j < half
        poke_byte(s2, j, peek_byte(secret, slen - half + j))
        j: j + 1
    d5: _sov_alloc(want)
    d1: _sov_alloc(want)
    tl10_n: want
    tl10_stream(d5, secret, half, 0, lseed, llen + slen2)
    tl10_stream(d1, s2, half, 1, lseed, llen + slen2)
    j: 0
    as long as j < want
        poke_byte(out, j, wxor(peek_byte(d5, j), peek_byte(d1, j)))
        j: j + 1
    tl10_n: want
tl10_hh hs hlen out:
    m: md5_bytes(hs, hlen)
    j: 0
    as long as j < 16
        poke_byte(out, j, peek_byte(m, j))
        j: j + 1
    sw: sha1_bytes(hs, hlen)
    j: 0
    as long as j < 5
        v: peek_i64(sw, j * 8)
        poke_byte(out, 16 + j * 4, wand(shr(v, 24), 255))
        poke_byte(out, 17 + j * 4, wand(shr(v, 16), 255))
        poke_byte(out, 18 + j * 4, wand(shr(v, 8), 255))
        poke_byte(out, 19 + j * 4, wand(v, 255))
        j: j + 1
tl10_cbc_enc ctx out typ body blen seq side:
    ver: peek_byte(ctx, 0)
    explicit: peek_i64(ctx, 8)
    wk: ctx + 64 + side * 16
    mk: ctx + 16 + side * 24
    iv: ctx + 96 + side * 16
    rk: _sov_alloc(176)
    ae_expand(wk, rk)
    macin: _sov_alloc(8 + 5 + blen)
    j: 0
    as long as j < 8
        q: shr(seq, (7 - j) * 8)
        poke_byte(macin, j, q % 256)
        j: j + 1
    poke_byte(macin, 8, typ)
    poke_byte(macin, 9, 3)
    poke_byte(macin, 10, ver)
    poke_byte(macin, 11, blen / 256)
    poke_byte(macin, 12, blen % 256)
    j: 0
    as long as j < blen
        poke_byte(macin, 13 + j, peek_byte(body, j))
        j: j + 1
    mac: _sov_heap_alloc(20)
    hmac_sha1(mk, 20, macin, 13 + blen, mac)
    frag: blen + 20
    l: 16 - frag % 16
    if l is 0 -> l: 16
    pt: _sov_heap_alloc(frag + l + 16)
    j: 0
    as long as j < blen
        poke_byte(pt, j, peek_byte(body, j))
        j: j + 1
    j: 0
    as long as j < 20
        poke_byte(pt, blen + j, peek_byte(mac, j))
        j: j + 1
    j: 0
    as long as j < l
        poke_byte(pt, frag + j, l - 1)
        j: j + 1
    w: 0
    if explicit is 1
        j: 0
        as long as j < 16
            poke_byte(out, 5 + j, peek_byte(iv, j))
            j: j + 1
        w: 16
    prev: _sov_alloc(16)
    j: 0
    as long as j < 16
        poke_byte(prev, j, peek_byte(iv, j))
        j: j + 1
    blk: _sov_alloc(16)
    p: 0
    as long as p < frag + l
        j: 0
        as long as j < 16
            poke_byte(blk, j, wxor(peek_byte(pt, p + j), peek_byte(prev, j)))
            j: j + 1
        ae_enc_block(rk, blk, out + 5 + w)
        j: 0
        as long as j < 16
            poke_byte(prev, j, peek_byte(out, 5 + w + j))
            j: j + 1
        w: w + 16
        p: p + 16
    j: 0
    as long as j < 16
        poke_byte(iv, j, peek_byte(prev, j))
        j: j + 1
    tl_clen: 5 + w
    poke_byte(out, 0, typ)
    poke_byte(out, 1, 3)
    poke_byte(out, 2, ver)
    poke_byte(out, 3, (tl_clen - 5) / 256)
    poke_byte(out, 4, (tl_clen - 5) % 256)
tl10_cbc_dec ctx in blen typ out seq side:
    ver: peek_byte(ctx, 0)
    explicit: peek_i64(ctx, 8)
    wk: ctx + 64 + side * 16
    mk: ctx + 16 + side * 24
    iv: ctx + 96 + side * 16
    p: 0
    ivc: _sov_alloc(16)
    if explicit is 1
        j: 0
        as long as j < 16
            poke_byte(ivc, j, peek_byte(in, j))
            j: j + 1
        p: 16
    if not
        j: 0
        as long as j < 16
            poke_byte(ivc, j, peek_byte(iv, j))
            j: j + 1
    ctlen: blen - p
    if ctlen < 32 -> return 0
    if ctlen % 16 is not 0 -> return 0
    rk: _sov_alloc(176)
    ae_expand(wk, rk)
    pt: _sov_alloc(ctlen + 1)
    db: _sov_alloc(16)
    w: 0
    as long as w < ctlen
        ae_dec_block(rk, in + p + w, db)
        j: 0
        as long as j < 16
            poke_byte(pt, w + j, wxor(peek_byte(db, j), peek_byte(ivc, j)))
            j: j + 1
        j: 0
        as long as j < 16
            poke_byte(ivc, j, peek_byte(in, p + w + j))
            j: j + 1
        w: w + 16
    j: 0
    as long as j < 16
        poke_byte(iv, j, peek_byte(in, p + ctlen - 16 + j))
        j: j + 1
    l: peek_byte(pt, ctlen - 1)
    if l > 15 -> return 0
    frag: ctlen - l - 1 - 20
    if frag < 0 -> return 0
    macin: _sov_alloc(8 + 5 + frag)
    j: 0
    as long as j < 8
        q: shr(seq, (7 - j) * 8)
        poke_byte(macin, j, q % 256)
        j: j + 1
    poke_byte(macin, 8, typ)
    poke_byte(macin, 9, 3)
    poke_byte(macin, 10, ver)
    poke_byte(macin, 11, frag / 256)
    poke_byte(macin, 12, frag % 256)
    j: 0
    as long as j < frag
        poke_byte(macin, 13 + j, peek_byte(pt, j))
        j: j + 1
    mac: _sov_heap_alloc(20)
    hmac_sha1(mk, 20, macin, 13 + frag, mac)
    bad: 0
    j: 0
    as long as j < 20
        if peek_byte(mac, j) is not peek_byte(pt, frag + j) -> bad: 1
        j: j + 1
    if bad is 1 -> return 0
    j: 0
    as long as j < frag
        poke_byte(out, j, peek_byte(pt, j))
        j: j + 1
    tl10_flen: frag
    return 1
tl10_step_ch fd rcrs hs ver:
    ch: _sov_alloc(80)
    poke_byte(ch, 0, 3)
    poke_byte(ch, 1, ver)
    i: 0
    as long as i < 32
        poke_byte(ch, 2 + i, peek_byte(rcrs, i))
        i: i + 1
    poke_byte(ch, 34, 0)
    poke_byte(ch, 35, 0)
    poke_byte(ch, 36, 2)
    poke_byte(ch, 37, 192)
    poke_byte(ch, 38, 19)
    poke_byte(ch, 39, 1)
    poke_byte(ch, 40, 0)
    poke_byte(ch, 41, 0)
    poke_byte(ch, 42, 22)
    poke_byte(ch, 43, 0)
    poke_byte(ch, 44, 13)
    poke_byte(ch, 45, 0)
    poke_byte(ch, 46, 4)
    poke_byte(ch, 47, 0)
    poke_byte(ch, 48, 2)
    poke_byte(ch, 49, 4)
    poke_byte(ch, 50, 1)
    poke_byte(ch, 51, 0)
    poke_byte(ch, 52, 10)
    poke_byte(ch, 53, 0)
    poke_byte(ch, 54, 4)
    poke_byte(ch, 55, 0)
    poke_byte(ch, 56, 2)
    poke_byte(ch, 57, 0)
    poke_byte(ch, 58, 29)
    poke_byte(ch, 59, 0)
    poke_byte(ch, 60, 11)
    poke_byte(ch, 61, 0)
    poke_byte(ch, 62, 2)
    poke_byte(ch, 63, 1)
    poke_byte(ch, 64, 0)
    tl_hs_add(hs, 0, 1, ch, 65)
    rec: _sov_alloc(128)
    poke_byte(rec, 0, 22)
    poke_byte(rec, 1, 3)
    poke_byte(rec, 2, ver)
    poke_byte(rec, 3, tl_hslen / 256)
    poke_byte(rec, 4, tl_hslen % 256)
    i: 0
    as long as i < tl_hslen
        poke_byte(rec, 5 + i, peek_byte(hs, i))
        i: i + 1
    sock_send_raw(fd, rec, 5 + tl_hslen)
    return 1
tl10_step_shcert fd rcrs mb eb hs:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    sh: tl_rb + 4
    gotver: peek_byte(sh, 1)
    i: 0
    as long as i < 32
        poke_byte(rcrs, 32 + i, peek_byte(sh, 2 + i))
        i: i + 1
    tl_hs_add(hs, tl_hslen, 2, sh, tl_rlen - 4)
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    cbody: tl_rb + 4
    clen: peek_byte(cbody, 3) * 65536 + peek_byte(cbody, 4) * 256 + peek_byte(cbody, 5)
    cert: cbody + 6
    tl_hs_add(hs, tl_hslen, 11, cbody, tl_rlen - 4)
    if tl_chain12(cbody) is 0 -> return 0
    tl_cert_key(cert, clen)
    mem_copy(mb, tl_mod, tl_modlen)
    poke_i64(mb, 256, tl_modlen)
    j: 0
    as long as j < 8
        poke_byte(eb, j, peek_byte(tl_exp, j))
        j: j + 1
    poke_i64(mb, 264, tl_explen)
    return gotver
tl10_step_ske fd rcrs mb eb spub hs:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    if peek_byte(tl_rb, 0) is not 12 -> return 0
    prm: tl_rb + 4
    i: 0
    as long as i < 32
        poke_byte(spub, i, peek_byte(prm, 4 + i))
        i: i + 1
    tl_hs_add(hs, tl_hslen, 12, tl_rb + 4, tl_rlen - 4)
    hi: _sov_heap_alloc(100)
    i: 0
    as long as i < 32
        poke_byte(hi, i, peek_byte(rcrs, i))
        poke_byte(hi, 32 + i, peek_byte(rcrs, 32 + i))
        i: i + 1
    i: 0
    as long as i < 36
        poke_byte(hi, 64 + i, peek_byte(prm, i))
        i: i + 1
    hh: _sov_alloc(36)
    tl10_hh(hi, 100, hh)
    sl: peek_byte(tl_rb, 40) * 256 + peek_byte(tl_rb, 41)
    sg: tl_rb + 42
    k: peek_i64(mb, 256)
    ck: _sov_alloc(512)
    tl_rsa_enc(sg, sl, ck, mb, k, eb, peek_i64(mb, 264))
    if peek_byte(ck, 0) is not 0 -> return 0
    if peek_byte(ck, 1) is not 1 -> return 0
    if peek_byte(ck, 2) is not 255 -> return 0
    bad: 0
    j: 0
    as long as j < 36
        if peek_byte(ck, k - 36 + j) is not peek_byte(hh, j) -> bad: 1
        j: j + 1
    if bad is 1 -> return 0
    return 1
tl10_step_cke fd epu hs ver:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    tl_hs_add(hs, tl_hslen, 14, tl_rb + 4, tl_rlen - 4)
    cke: _sov_heap_alloc(40)
    poke_byte(cke, 0, 32)
    j: 0
    as long as j < 32
        poke_byte(cke, 1 + j, peek_byte(epu, j))
        j: j + 1
    tl_hs_add(hs, tl_hslen, 16, cke, 33)
    rec: _sov_alloc(64)
    poke_byte(rec, 0, 22)
    poke_byte(rec, 1, 3)
    poke_byte(rec, 2, ver)
    l: 4 + 33
    poke_byte(rec, 3, l / 256)
    poke_byte(rec, 4, l % 256)
    poke_byte(rec, 5, 16)
    poke_byte(rec, 6, 0)
    poke_byte(rec, 7, 0)
    poke_byte(rec, 8, 33)
    j: 0
    as long as j < 33
        poke_byte(rec, 9 + j, peek_byte(cke, j))
        j: j + 1
    sock_send_raw(fd, rec, 9 + 33)
    return 1
tl10_step_keys ctx rcrs pm pmlen:
    ms: ctx + 128
    tl10_n: 48
    tl10_prf(ms, pm, pmlen, "master secret", 13, rcrs, 64)
    seed2: _sov_heap_alloc(64)
    j: 0
    as long as j < 32
        poke_byte(seed2, j, peek_byte(rcrs, 32 + j))
        poke_byte(seed2, 32 + j, peek_byte(rcrs, j))
        j: j + 1
    kb: _sov_heap_alloc(104)
    tl10_n: 104
    tl10_prf(kb, ms, 48, "key expansion", 13, seed2, 64)
    j: 0
    as long as j < 20
        poke_byte(ctx, 16 + j, peek_byte(kb, j))
        poke_byte(ctx, 40 + j, peek_byte(kb, 20 + j))
        j: j + 1
    j: 0
    as long as j < 16
        poke_byte(ctx, 64 + j, peek_byte(kb, 40 + j))
        poke_byte(ctx, 80 + j, peek_byte(kb, 56 + j))
        poke_byte(ctx, 96 + j, peek_byte(kb, 72 + j))
        poke_byte(ctx, 112 + j, peek_byte(kb, 88 + j))
        j: j + 1
    return 1
    tl_wipe(kb, 104)
tl10_step_finish ctx fd hs hlen:
    ver: peek_byte(ctx, 0)
    ms: ctx + 128
    hh: _sov_heap_alloc(36)
    tl10_hh(hs, hlen, hh)
    fv: _sov_alloc(16)
    tl10_n: 12
    tl10_prf(fv, ms, 48, "client finished", 15, hh, 36)
    fm: _sov_heap_alloc(16)
    poke_byte(fm, 0, 20)
    poke_byte(fm, 1, 0)
    poke_byte(fm, 2, 0)
    poke_byte(fm, 3, 12)
    j: 0
    as long as j < 12
        poke_byte(fm, 4 + j, peek_byte(fv, j))
        j: j + 1
    en: _sov_alloc(160)
    tl10_cbc_enc(ctx, en, 22, fm, 16, 0, 0)
    both: _sov_alloc(192)
    poke_byte(both, 0, 20)
    poke_byte(both, 1, 3)
    poke_byte(both, 2, ver)
    poke_byte(both, 3, 0)
    poke_byte(both, 4, 1)
    poke_byte(both, 5, 1)
    i: 0
    as long as i < tl_clen
        poke_byte(both, 6 + i, peek_byte(en, i))
        i: i + 1
    sock_send_raw(fd, both, 6 + tl_clen)
    tl_hs_add(hs, tl_hslen, 20, fv, 12)
    return 1
tl10_step_vfinish ctx fd hs hlen:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 20 -> return 0
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    d: _sov_alloc(512)
    ok: tl10_cbc_dec(ctx, tl_rb, tl_rlen, tl_rtype, d, 0, 1)
    if ok is 0 -> return 0
    ms: ctx + 128
    hh: _sov_heap_alloc(36)
    tl10_hh(hs, hlen, hh)
    sv: _sov_alloc(16)
    tl10_n: 12
    tl10_prf(sv, ms, 48, "server finished", 15, hh, 36)
    bad: 0
    j: 0
    as long as j < 12
        if peek_byte(sv, j) is not peek_byte(d, 4 + j) -> bad: 1
        j: j + 1
    if bad is 1 -> return 0
    return 1
tl10_step_send ctx fd req:
    n: str_len(req)
    sq: 1
    i: 0
    as long as i < n
        cl: 4096
        if n - i < 4096 -> cl: n - i
        chunk: _sov_heap_alloc(4096)
        j: 0
        as long as j < cl
            poke_byte(chunk, j, peek_byte(req, i + j))
            j: j + 1
        en: _sov_heap_alloc(4200)
        tl10_cbc_enc(ctx, en, 23, chunk, cl, sq, 0)
        sq: sq + 1
        sock_send_raw(fd, en, tl_clen)
        i: i + cl
    return 1
tl10_step_read ctx fd out outmax:
    tot: 0
    ss: 1
    more: 1
    as long as more is 1
        r: tl_recv(fd)
        if r is not 0 -> more: 0
        if not
            if tl_rtype is 23
                d: _sov_heap_alloc(20000)
                ok: tl10_cbc_dec(ctx, tl_rb, tl_rlen, tl_rtype, d, ss, 1)
                ss: ss + 1
                if ok is 1
                    j: 0
                    as long as j < tl10_flen
                        if tot + j < outmax -> poke_byte(out, tot + j, peek_byte(d, j))
                        j: j + 1
                    tot: tot + tl10_flen
            if not -> more: 0
    tl_gtot: tot
    return 1
tl10_client fd host req out outmax minor:
    tl_cur_host: host
    ver: 1
    explicit: 0
    if minor is 1
        ver: 2
        explicit: 1
    ctx: _sov_alloc(176)
    poke_byte(ctx, 0, ver)
    poke_i64(ctx, 8, explicit)
    rcrs: _sov_alloc(64)
    pm: _sov_alloc(48)
    ep: _sov_heap_alloc(32)
    epu: _sov_heap_alloc(32)
    spub: _sov_heap_alloc(32)
    b9: _sov_heap_alloc(32)
    mb: _sov_heap_alloc(272)
    eb: _sov_heap_alloc(8)
    hs: _sov_heap_alloc(20000)
    rb: rand_bytes(32)
    i: 0
    as long as i < 32
        poke_byte(rcrs, i, peek_byte(rb, i))
        i: i + 1
    poke_byte(b9, 0, 9)
    r: tl10_step_ch(fd, rcrs, hs, ver)
    if r is 0 -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    r: tl10_step_shcert(fd, rcrs, mb, eb, hs)
    if r is 0 -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    if r is not ver -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    r: tl10_step_ske(fd, rcrs, mb, eb, spub, hs)
    if r is 0 -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    tl_step_ep(ep, epu, spub, pm, b9)
    r: tl10_step_cke(fd, epu, hs, ver)
    if r is 0 -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    r: tl10_step_keys(ctx, rcrs, pm, 32)
    if r is 0 -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    tl_wipe(ep, 32)
    tl_wipe(pm, 48)
    hlen: tl_hslen
    r: tl10_step_finish(ctx, fd, hs, hlen)
    if r is 0 -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    hlen: tl_hslen
    r: tl10_step_vfinish(ctx, fd, hs, hlen)
    if r is 0 -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    tl_wipe(ctx + 128, 48)
    r: tl10_step_send(ctx, fd, req)
    if r is 0 -> return tl10_wipe(ctx, rcrs, pm, ep, rb, 0)
    r: tl10_step_read(ctx, fd, out, outmax)
    tl_len: tl_gtot
    return tl10_wipe(ctx, rcrs, pm, ep, rb, tl_gtot)
tl10_send_req host port req out outmax minor:
    ip: web_lookup(host)
    if str_len(ip) is 0 -> return 0
    fd: sock_connect(web_part(ip, 0), web_part(ip, 1), web_part(ip, 2), web_part(ip, 3), port)
    if fd < 0 -> return 0
    n: tl10_client(fd, host, req, out, outmax, minor)
    sys_close(fd)
    return n
tl10_get host port path out outmax minor:
    req: str_cat("GET ", path)
    req: str_cat(req, " HTTP/1.0\r\nHost: ")
    req: str_cat(req, host)
    req: str_cat(req, "\r\nUser-Agent: sovren\r\nConnection: close\r\n\r\n")
    return tl10_send_req(host, port, req, out, outmax, minor)
