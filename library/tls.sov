    i: 0
    as long as i < 6
        poke_byte(out, 3 + i, peek_byte("tls13 ", i))
        i: i + 1
    i: 0
    as long as i < ln
        poke_byte(out, 9 + i, peek_byte(label, i))
        i: i + 1
    poke_byte(out, 9 + ln, 0)
    tl13_ln: 10 + ln
tl13_key secret out:
    info: _sov_heap_alloc(32)
    tl13_info0(info, 16, "key")
    n: tl13_ln
    hkdf_expand(secret, info, n, 16, out)
tl13_iv secret out:
    info: _sov_heap_alloc(32)
    tl13_info0(info, 12, "iv")
    n: tl13_ln
    hkdf_expand(secret, info, n, 12, out)
tl13_fk secret out:
    info: _sov_heap_alloc(32)
    tl13_info0(info, 32, "finished")
