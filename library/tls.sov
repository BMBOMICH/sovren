tl13_hss: 0
tl13_flight fd hs hlen sts mb eb:
    seq: 0
    pt: _sov_alloc(20000)
    body: _sov_alloc(16384)
    done: 0
    finvd: _sov_alloc(32)
    as long as done is 0
        r: tl_recv(fd)
        if r is not 0 -> return 0
        if tl_rtype is 20 -> done: done
        if not
            if tl_rtype is not 23 -> return 0
            srk: _sov_alloc(16)
            sriv: _sov_alloc(12)
            tl13_key(sts, srk)
            tl13_iv(sts, sriv)
            ok: tl13_dec(tl_rb, tl_rlen, srk, sriv, seq, pt)
            seq: seq + 1
            tl_wipe(srk, 16)
            tl_wipe(sriv, 12)
            if ok is 0 -> return 0
            off: 0
            pl: tl13_pn
            as long as off < pl
                mt: peek_byte(pt, off)
                ml: peek_byte(pt, off + 1) * 65536 + peek_byte(pt, off + 2) * 256 + peek_byte(pt, off + 3)
                i: 0
                as long as i < ml
                    poke_byte(body, i, peek_byte(pt, off + 4 + i))
                    i: i + 1
                if mt is 8
                    tl_hs_add(hs, hlen, 8, body, ml)
                    hlen: tl_hslen
                if mt is 11
                    tl_hs_add(hs, hlen, 11, body, ml)
                    hlen: tl_hslen
                    clen: peek_byte(body, 4) * 65536 + peek_byte(body, 5) * 256 + peek_byte(body, 6)
                    der: _sov_alloc(clen + 4)
                    i: 0
                    as long as i < clen
                        poke_byte(der, i, peek_byte(body, 7 + i))
                        i: i + 1
                    if tl_chain13(body) is 0 -> return 0
                    tl_cert_key(der, clen)
                    mem_copy(mb, tl_mod, tl_modlen)
                    mem_copy(eb, tl_exp, tl_explen)
                    poke_i64(mb, 256, tl_modlen)
                    poke_i64(mb, 264, tl_explen)
                if mt is 15
                    thr: _sov_alloc(64)
                    sha256_bytes(hs, hlen, thr)
                    th: _sov_heap_alloc(32)
                    tl13_pack32(thr, th)
                    content: _sov_heap_alloc(160)
                    i: 0
                    as long as i < 64
                        poke_byte(content, i, 32)
                        i: i + 1
                    sig33: "TLS 1.3, server CertificateVerify"
                    i: 0
                    as long as i < 33
                        poke_byte(content, 64 + i, peek_byte(sig33, i))
                        i: i + 1
                    poke_byte(content, 97, 0)
                    i: 0
                    as long as i < 32
                        poke_byte(content, 98 + i, peek_byte(th, i))
                        i: i + 1
                    hb: _sov_heap_alloc(64)
                    sha256_bytes(content, 130, hb)
                    fseed: _sov_heap_alloc(32)
                    j: 0
                    as long as j < 8
                        v: peek_i64(hb, j * 8)
                        poke_byte(fseed, j * 4, wand(shr(v, 24), 255))
                        poke_byte(fseed, j * 4 + 1, wand(shr(v, 16), 255))
                        poke_byte(fseed, j * 4 + 2, wand(shr(v, 8), 255))
                        poke_byte(fseed, j * 4 + 3, wand(v, 255))
                        j: j + 1
                    k: peek_i64(mb, 256)
                    expd: _sov_alloc(512)
                    j: 0
                    as long as j < k
                        poke_byte(expd, j, 255)
                        j: j + 1
                    poke_byte(expd, 0, 0)
                    poke_byte(expd, 1, 1)
                    poke_byte(expd, k - 52, 0)
                    poke_byte(expd, k - 51, 48)
                    poke_byte(expd, k - 50, 49)
                    poke_byte(expd, k - 49, 48)
                    poke_byte(expd, k - 48, 13)
                    poke_byte(expd, k - 47, 6)
                    poke_byte(expd, k - 46, 9)
                    poke_byte(expd, k - 45, 96)
                    poke_byte(expd, k - 44, 134)
                    poke_byte(expd, k - 43, 72)
                    poke_byte(expd, k - 42, 1)
                    poke_byte(expd, k - 41, 101)
                    poke_byte(expd, k - 40, 3)
                    poke_byte(expd, k - 39, 4)
                    poke_byte(expd, k - 38, 2)
                    poke_byte(expd, k - 37, 1)
                    poke_byte(expd, k - 36, 5)
                    poke_byte(expd, k - 35, 0)
                    poke_byte(expd, k - 34, 4)
                    poke_byte(expd, k - 33, 32)
                    j: 0
                    as long as j < 32
                        poke_byte(expd, k - 32 + j, peek_byte(fseed, j))
                        j: j + 1
                    sl: peek_byte(body, 2) * 256 + peek_byte(body, 3)
                    sg: _sov_alloc(sl + 4)
                    i: 0
                    as long as i < sl
                        poke_byte(sg, i, peek_byte(body, 4 + i))
                        i: i + 1
                    alg: peek_byte(body, 0) * 256 + peek_byte(body, 1)
                    if sl > 0 -> kk: peek_i64(mb, 256)
                    cvok: 0
                    if alg is 2052 -> cvok: tl13_cv_pss(sg, sl, mb, eb, fseed)
                    if alg is 1025
                        ck: _sov_alloc(512)
                        tl_rsa_enc(sg, sl, ck, mb, k, eb, peek_i64(mb, 264))
                        bad: 0
                        j: 0
                        as long as j < k
                            if peek_byte(ck, j) is not peek_byte(expd, j) -> bad: 1
                            j: j + 1
                        if bad is 0 -> cvok: 1
                    if cvok is 0 -> return 0
                    tl_hs_add(hs, hlen, 15, body, ml)
                    hlen: tl_hslen
                if mt is 20
                    th2r: _sov_alloc(64)
                    sha256_bytes(hs, hlen, th2r)
                    th2: _sov_alloc(32)
                    tl13_pack32(th2r, th2)
                    fk: _sov_alloc(32)
                    tl13_fk(sts, fk)
                    hmac_raw(fk, 32, th2, 32, finvd)
                    tl_wipe(fk, 32)
                    bad2: 0
                    i: 0
                    as long as i < 32
                        if peek_byte(finvd, i) is not peek_byte(body, i) -> bad2: 1
                        i: i + 1
                    if bad2 is 1 -> return 0
                    tl_hs_add(hs, hlen, 20, body, ml)
                    hlen: tl_hslen
                    done: 1
                off: off + 4 + ml
    return 1
