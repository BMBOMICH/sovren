tl13_step_sh fd hs spub:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    if peek_byte(tl_rb, 0) is not 2 -> return 0
    sh: tl_rb + 4
    p: 35 + peek_byte(sh, 34)
    p: p + 5
    tl_hs_add(hs, tl_hslen, 2, sh, tl_rlen - 4)
    pend: p + peek_byte(sh, p - 2) * 256 + peek_byte(sh, p - 1)
    got13: 0
    gotshare: 0
    as long as p < pend
        et: peek_byte(sh, p) * 256 + peek_byte(sh, p + 1)
        el: peek_byte(sh, p + 2) * 256 + peek_byte(sh, p + 3)
        if et is 43
            if peek_byte(sh, p + 4) is 3
                if peek_byte(sh, p + 5) is 4 -> got13: 1
        if et is 51
            if peek_byte(sh, p + 4) is 0
                if peek_byte(sh, p + 5) is 29
                    i: 0
                    as long as i < 32
                        poke_byte(spub, i, peek_byte(sh, p + 8 + i))
                        i: i + 1
                    gotshare: 1
        p: p + 4 + el
    if got13 is 0 -> return 0
    if gotshare is 0 -> return 0
    return 1
