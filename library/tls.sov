    poke_byte(aad, 2, 3)
    l: blen + 1 + 16
    poke_byte(aad, 3, l / 256)
    poke_byte(aad, 4, l % 256)
    inner: _sov_heap_alloc(blen + 1)
    i: 0
    as long as i < blen
