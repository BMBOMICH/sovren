    poke_byte(out, 1, 3)
    poke_byte(out, 2, 3)
    poke_byte(out, 3, (blen + 17) / 256)
    poke_byte(out, 4, (blen + 17) % 256)
    i: 0
    as long as i < blen + 1
        poke_byte(out, 5 + i, peek_byte(ct, i))
        i: i + 1
    i: 0
    as long as i < 16
        poke_byte(out, 5 + blen + 1 + i, peek_byte(gm_tag, i))
        i: i + 1
    tl_clen: rl
    return 0
tl13_pn: 0
tl13_ptype: 0
tl13_dec in blen key iv seq out:
    aad: _sov_alloc(13)
    poke_byte(aad, 0, 23)
    poke_byte(aad, 1, 3)
    poke_byte(aad, 2, 3)
    poke_byte(aad, 3, blen / 256)
    poke_byte(aad, 4, blen % 256)
    nnc: _sov_alloc(12)
    tl13_nonce(iv, seq, nnc)
    pt: _sov_alloc(blen)
    n: blen - 16
    ct: _sov_alloc(n + 16)
    i: 0
    as long as i < n + 16
        poke_byte(ct, i, peek_byte(in, i))
        i: i + 1
    gm_ctr_dec(key, nnc, ct, n, pt)
    gm_tag_of(key, nnc, aad, 5, ct, n)
    bad: 0
    i: 0
    as long as i < 16
        if peek_byte(gm_tag, i) is not peek_byte(ct, n + i) -> bad: 1
        i: i + 1
    if bad is 1 -> return 0
    m: n
    as long as m > 0
        if peek_byte(pt, m - 1) is not 0 -> leave
        m: m - 1
    if m < 1 -> return 0
    tl13_ptype: peek_byte(pt, m - 1)
    tl13_pn: m - 1
    i: 0
    as long as i < m - 1
        poke_byte(out, i, peek_byte(pt, i))
        i: i + 1
    return 1
tl13_step_ch fd host hs epriv epub:
