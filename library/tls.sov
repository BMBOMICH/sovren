    tl_wipe(ss, 32)
    tl_wipe(early, 32)
    tl_wipe(salt, 32)
    tl_wipe(hs_secret, 32)
    return 1
tl13_info0 out want label:
    ln: str_len(label)
    poke_byte(out, 0, want / 256)
    poke_byte(out, 1, want % 256)
