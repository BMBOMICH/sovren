TL_V10: 769
TL_V11: 770
TL_V12: 771
TL_V13: 772 
tl13_ln: 0
tl13_info out want label:
    ln: str_len(label)
    poke_byte(out, 0, want / 256)
    poke_byte(out, 1, want % 256)
    poke_byte(out, 2, 6 + ln)
    i: 0
    as long as i < 6
        poke_byte(out, 3 + i, peek_byte("tls13 ", i))
        i: i + 1
    i: 0
    as long as i < ln
        poke_byte(out, 9 + i, peek_byte(label, i))
        i: i + 1
    o: 9 + ln
    poke_byte(out, o, 32)
    i: 0
    as long as i < 32
        poke_byte(out, o + 1 + i, peek_byte(label, 33 + i))
        i: i + 1
    tl13_ln: o + 33
tl13_expl secret label want out:
    info: _sov_alloc(128)
    tl13_info(info, want, label)
    n: tl13_ln
    hkdf_expand(secret, info, n, want, out)
tl13_derive secret label out:
    tl13_expl(secret, label, 32, out)
tl13_nonce iv seq out:
    i: 0
    as long as i < 12
        poke_byte(out, i, peek_byte(iv, i))
        i: i + 1
    s: seq
    i: 11
    as long as i > 3
        poke_byte(out, i, wxor(peek_byte(iv, i), s % 256))
        s: s / 256
        i: i - 1
tl13_enc out body blen key iv seq itype:
