ROOT_NB_6: 17881920
ROOT_NA_6: 31031999 
ROOT_KEYS: 0
tl_root_hex i:
    if i is 0 -> return str_cat(ROOT_HA_DIGICERT_ROOT, ROOT_HB_DIGICERT_ROOT)
    if i is 1 -> return str_cat(ROOT_HA_DIGICERT_G2, ROOT_HB_DIGICERT_G2)
    if i is 2 -> return str_cat(ROOT_HA_ISRG_X1, ROOT_HB_ISRG_X1)
    if i is 3 -> return str_cat(ROOT_HA_GTS_R1, ROOT_HB_GTS_R1)
    if i is 4 -> return str_cat(ROOT_HA_COMODO_RSA, ROOT_HB_COMODO_RSA)
    if i is 5 -> return str_cat(ROOT_HA_GODADDY_G2, ROOT_HB_GODADDY_G2)
    return str_cat(ROOT_HA_AAA, ROOT_HB_AAA)
tl_root_nb i:
    if i is 0 -> return ROOT_NB_0
    if i is 1 -> return ROOT_NB_1
    if i is 2 -> return ROOT_NB_2
    if i is 3 -> return ROOT_NB_3
    if i is 4 -> return ROOT_NB_4
    if i is 5 -> return ROOT_NB_5
    return ROOT_NB_6
tl_root_na i:
    if i is 0 -> return ROOT_NA_0
    if i is 1 -> return ROOT_NA_1
    if i is 2 -> return ROOT_NA_2
    if i is 3 -> return ROOT_NA_3
    if i is 4 -> return ROOT_NA_4
    if i is 5 -> return ROOT_NA_5
    return ROOT_NA_6
tl_hexv c:
    if c >= 97 -> return c - 87
    if c >= 65 -> return c - 55
    return c - 48
tl_roots_build:
    if ROOT_KEYS is not 0 -> return 0
    ROOT_KEYS: _sov_alloc(ROOT_N * 600)
    r: 0
    as long as r < ROOT_N
        h: tl_root_hex(r)
        slot: ROOT_KEYS + r * 600
        hn: str_len(h)
        nb: hn / 2
        j: 0
        as long as j < nb
            poke_byte(slot, j, tl_hexv(peek_byte(h, j * 2)) * 16 + tl_hexv(peek_byte(h, j * 2 + 1)))
            j: j + 1
        poke_i64(slot, 512, nb)
        poke_byte(slot, 520, 1)
        poke_byte(slot, 521, 0)
        poke_byte(slot, 522, 1)
        poke_i64(slot, 528, 3)
        r: r + 1
tl_days_civil y m d:
    y2: y
    if m <= 2 -> y2: y - 1
    era: y2 / 400
    yoe: y2 - era * 400
    mp: m + 9
    if m > 2 -> mp: m - 3
    doy: (153 * mp + 2) / 5 + d - 1
    doe: yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
tl_ztime p i:
    tl_len(p, i)
    a: tl_vstart
    n: tl_vend - a
    yi: 2
    if n > 13 -> yi: 4
    v: 0
    j: 0
    as long as j < yi
        v: v * 10 + peek_byte(p, a + j) - 48
        j: j + 1
    yr: v + 2000
    if yi is 4 -> yr: v
    if v >= 50
        if yi is 2 -> yr: v + 1900
    mo: (peek_byte(p, a + yi) - 48) * 10 + peek_byte(p, a + yi + 1) - 48
    da: (peek_byte(p, a + yi + 2) - 48) * 10 + peek_byte(p, a + yi + 3) - 48
    hh: (peek_byte(p, a + yi + 4) - 48) * 10 + peek_byte(p, a + yi + 5) - 48
    mi: (peek_byte(p, a + yi + 6) - 48) * 10 + peek_byte(p, a + yi + 7) - 48
    return tl_days_civil(yr, mo, da) * 1440 + hh * 60 + mi
tl_cert_valid cert:
    tbs: tl_child(cert, 0, 0)
    val: tl_child(cert, tbs, 4)
    nb: tl_child(cert, val, 0)
    na: tl_child(cert, val, 1)
    nowmin: time_now() / 60
    if nowmin < tl_ztime(cert, nb) -> return 0
    if nowmin > tl_ztime(cert, na) -> return 0
    return 1
tl_key_of cert mb:
    tl_cert_key(cert, 0)
    mem_copy(mb, tl_mod, tl_modlen)
    eb: mb + 520
    mem_copy(eb, tl_exp, tl_explen)
    poke_i64(mb, 512, tl_modlen)
    poke_i64(mb, 528, tl_explen)
tl_tbs_digest cert which out:
    tbs: tl_child(cert, 0, 0)
    tl_len(cert, tbs)
    start: cert + tbs
    n: tl_vend - tbs
    if which is 1
        sw: sha1_bytes(start, n)
        j: 0
        as long as j < 5
            v: peek_i64(sw, j * 8)
            poke_byte(out, j * 4, wand(shr(v, 24), 255))
            poke_byte(out, j * 4 + 1, wand(shr(v, 16), 255))
            poke_byte(out, j * 4 + 2, wand(shr(v, 8), 255))
            poke_byte(out, j * 4 + 3, wand(v, 255))
            j: j + 1
        return 0
    sha256_bytes(start, n, out)
tl_cert_signed cert mb:
    sigtag: tl_child(cert, 0, 2)
    tl_len(cert, sigtag)
    sg: tl_vstart + 1
    sl: tl_vend - tl_vstart - 1
    k: peek_i64(mb, 512)
    dg: _sov_alloc(32)
    ck: _sov_alloc(512)
    expd: _sov_alloc(528)
    which: 0
    as long as which < 2
        dlen: 32
        if which is 1 -> dlen: 20
        j: 0
        as long as j < k
            poke_byte(expd, j, 255)
            j: j + 1
        poke_byte(expd, 0, 0)
        poke_byte(expd, 1, 1)
        if which is 0
            poke_byte(expd, k - 51, 0)
            poke_byte(expd, k - 50, 48)
            poke_byte(expd, k - 49, 49)
            poke_byte(expd, k - 48, 13)
            poke_byte(expd, k - 47, 6)
            poke_byte(expd, k - 46, 9)
            poke_byte(expd, k - 45, 96)
            poke_byte(expd, k - 44, 134)
            poke_byte(expd, k - 43, 72)
            poke_byte(expd, k - 42, 1)
            poke_byte(expd, k - 41, 101)
            poke_byte(expd, k - 40, 3)
            poke_byte(expd, k - 39, 4)
            poke_byte(expd, k - 38, 2)
            poke_byte(expd, k - 37, 1)
            poke_byte(expd, k - 36, 5)
            poke_byte(expd, k - 35, 0)
            poke_byte(expd, k - 34, 4)
            poke_byte(expd, k - 33, 32)
        if not
            poke_byte(expd, k - 39, 0)
            poke_byte(expd, k - 38, 48)
            poke_byte(expd, k - 37, 33)
            poke_byte(expd, k - 36, 48)
            poke_byte(expd, k - 35, 9)
            poke_byte(expd, k - 34, 6)
            poke_byte(expd, k - 33, 5)
            poke_byte(expd, k - 32, 43)
            poke_byte(expd, k - 31, 14)
            poke_byte(expd, k - 30, 3)
            poke_byte(expd, k - 29, 2)
            poke_byte(expd, k - 28, 26)
            poke_byte(expd, k - 27, 5)
            poke_byte(expd, k - 26, 0)
            poke_byte(expd, k - 25, 4)
            poke_byte(expd, k - 24, 20)
        tl_tbs_digest(cert, which, dg)
        j: 0
        as long as j < dlen
            poke_byte(expd, k - dlen + j, peek_byte(dg, j))
            j: j + 1
        ebase: mb + 520
        elen: peek_i64(mb, 528)
        tl_rsa_enc(sg, sl, ck, mb, k, ebase, elen)
        bad: 0
        j: 0
        as long as j < k
            if peek_byte(ck, j) is not peek_byte(expd, j) -> bad: 1
            j: j + 1
        if bad is 0 -> return 1
        which: which + 1
tl_key_is_root mb:
    tl_roots_build()
    r: 0
    as long as r < ROOT_N
        slot: ROOT_KEYS + r * 600
        k: peek_i64(slot, 512)
        if k is peek_i64(mb + 512)
            same: 1
            j: 0
            as long as j < k
                if peek_byte(slot + j) is not peek_byte(mb + j) -> same: 0
                j: j + 1
            if same is 1
                nowmin: time_now() / 60
                if nowmin < tl_root_nb(r) -> return 0
                if nowmin > tl_root_na(r) -> return 0
                return 1
        r: r + 1
tl_chain_ok offs n:
    tl_roots_build()
    i: 0
    as long as i < n
        if tl_cert_valid(peek_i64(offs, i * 8)) is 0 -> return 0
        i: i + 1
    topkey: _sov_alloc(600)
    tl_key_of(peek_i64(offs, n - 1), topkey)
    trusted: tl_key_is_root(topkey)
    if trusted is 0
        r: 0
        as long as r < ROOT_N
            if trusted is 0
                if tl_cert_signed(peek_i64(offs, n - 1), ROOT_KEYS + r * 600) is 1
                    nowmin: time_now() / 60
                    if nowmin >= tl_root_nb(r)
                        if nowmin <= tl_root_na(r) -> trusted: 1
            r: r + 1
    if trusted is 0 -> return 0
    i: 0
    as long as i < n - 1
        upper: _sov_alloc(600)
        tl_key_of(peek_i64(offs, i + 1), upper)
        if tl_cert_signed(peek_i64(offs, i), upper) is 0 -> return 0
        i: i + 1
    if tl_cert_host_ok(peek_i64(offs, 0), tl_cur_host) is 0 -> return 0
    return 1
tl_chain12 cbody:
    offs: _sov_alloc(64)
    listlen: peek_byte(cbody, 0) * 65536 + peek_byte(cbody, 1) * 256 + peek_byte(cbody, 2)
    endp: cbody + 3 + listlen
    p: cbody + 3
    n: 0
    as long as n < 8
        if p + 3 > endp -> leave
        tlen: peek_byte(p, 0) * 65536 + peek_byte(p, 1) * 256 + peek_byte(p, 2)
        if p + 3 + tlen > endp -> leave
        poke_i64(offs, n * 8, p + 3)
        n: n + 1
        p: p + 3 + tlen
    if n is 0 -> return 0
    return tl_chain_ok(offs, n)
tl_chain13 body:
    offs: _sov_alloc(64)
    listlen: peek_byte(body, 1) * 65536 + peek_byte(body, 2) * 256 + peek_byte(body, 3)
    endp: body + 4 + listlen
    p: body + 4
    n: 0
    as long as n < 8
        if p + 4 > endp -> leave
        clen: peek_byte(p, 0) * 65536 + peek_byte(p, 1) * 256 + peek_byte(p, 2)
        poke_i64(offs, n * 8, p + 3)
        n: n + 1
        extlen: peek_byte(p, 3 + clen) * 256 + peek_byte(p, 4 + clen)
        p: p + 3 + clen + 2 + extlen
    if n is 0 -> return 0
    return tl_chain_ok(offs, n)
tl_cur_host: 0
tl_lc b:
    if b >= 65
        if b <= 90 -> return b + 32
    return b
tl_host_len host:
    n: 0
    as long as peek_byte(host, n) is not 0
        n: n + 1
    return n
tl_name_eq pat plen host hoff hlen:
    if plen is not hlen -> return 0
    j: 0
    as long as j < plen
        if tl_lc(peek_byte(pat, j)) is not tl_lc(peek_byte(host, hoff + j)) -> return 0
        j: j + 1
    return 1
tl_name_match pat plen host:
    hlen: tl_host_len(host)
    if plen >= 3
        if peek_byte(pat, 0) is 42
            if peek_byte(pat, 1) is 46
                d: 0
                as long as d < hlen
                    if peek_byte(host, d) is 46 -> leave
                    d: d + 1
                if d is 0 -> return 0
                if d >= hlen -> return 0
                return tl_name_eq(pat + 1, plen - 1, host, d, hlen - d)
    return tl_name_eq(pat, plen, host, 0, hlen)
tl_oid3 p off a b c:
    tl_len(p, off)
    if tl_vend - tl_vstart is not 3 -> return 0
    if peek_byte(p, tl_vstart) is not a -> return 0
    if peek_byte(p, tl_vstart + 1) is not b -> return 0
    if peek_byte(p, tl_vstart + 2) is not c -> return 0
    return 1
tl_cert_host_ok cert host:
    if host is 0 -> return 0
    if peek_byte(host, 0) is 0 -> return 0
    tbs: tl_child(cert, 0, 0)
    tl_len(cert, tbs)
    at: tl_vstart
    tend: tl_vend
    ext: 0 - 1
    as long as at < tend
        if peek_byte(cert, at) is 163 -> ext: at
        tl_len(cert, at)
        at: tl_vend
    if ext >= 0
        tl_len(cert, ext)
        seq: tl_vstart
        tl_len(cert, seq)
        e: tl_vstart
        eend: tl_vend
        as long as e < eend
            tl_len(cert, e)
            xend: tl_vend
            oid: tl_vstart
            if tl_oid3(cert, oid, 85, 29, 17) is 1
                v: tl_vend
                if peek_byte(cert, v) is 1
                    tl_len(cert, v)
                    v: tl_vend
                tl_len(cert, v)
                san: cert + tl_vstart
                tl_len(san, 0)
                g: tl_vstart
                gend: tl_vend
                as long as g < gend
                    tag: peek_byte(san, g)
                    tl_len(san, g)
                    vs: tl_vstart
                    ve: tl_vend
                    if tag is 130
                        if tl_name_match(san + vs, ve - vs, host) is 1 -> return 1
                    g: ve
                return 0
            e: xend
    subj: tl_child(cert, tbs, 5)
    tl_len(cert, subj)
    r: tl_vstart
    rend: tl_vend
    as long as r < rend
        tl_len(cert, r)
        nrdn: tl_vend
        s2: tl_vstart
        send: tl_vend
        as long as s2 < send
            tl_len(cert, s2)
            aend: tl_vend
            aoid: tl_vstart
            if tl_oid3(cert, aoid, 85, 4, 3) is 1
                vv: tl_vend
                tl_len(cert, vv)
                if tl_name_match(cert + tl_vstart, tl_vend - tl_vstart, host) is 1 -> return 1
            s2: aend
        r: nrdn
    return 0
tl_n: 0
tl_prf out secret slen label llen seed slen2:
    a: _sov_alloc(32 + slen2)
    j: llen
    mem_copy(a, label, llen)
    j: 0
    as long as j < slen2
        poke_byte(a, llen + j, peek_byte(seed, j))
        j: j + 1
    alen: llen + slen2
    pos: 0
    na: _sov_alloc(32)
    blk: _sov_alloc(32)
    as long as pos < tl_n
        hmac_raw(secret, slen, a, alen, na)
        j: 32
        mem_copy(a, na, 32)
        alen: 32
        buf: _sov_alloc(32 + llen + slen2 + 1)
        j: 32
        mem_copy(buf, a, 32)
        j: 0
        as long as j < llen
            poke_byte(buf, 32 + j, peek_byte(label, j))
            j: j + 1
        j: 0
        as long as j < slen2
            poke_byte(buf, 32 + llen + j, peek_byte(seed, j))
            j: j + 1
        hmac_raw(secret, slen, buf, 32 + llen + slen2, blk)
        j: 0
        as long as j < 32
            if pos + j < tl_n -> poke_byte(out, pos + j, peek_byte(blk, j))
            j: j + 1
        pos: pos + 32
    return 0
tl_clen: 0
tl_rsa_enc m mlen out mod modlen exp explen:
    n: bi_from_bytes(mod, modlen)
    ev: 0
    j: 0
    as long as j < explen
        ev: ev * 256 + peek_byte(exp, j)
        j: j + 1
    mb: bi_from_bytes(m, mlen)
    c: bi_modpow17(mb, ev, n)
    bi_to_bytes(c, out, modlen)
    tl_clen: modlen
    return 0
tl_seq_c: 0
tl_seq_s: 0
tl_rec_enc out typ body blen key iv:
    sq: tl_seq_c
    poke_byte(out, 0, typ)
    poke_byte(out, 1, 3)
    poke_byte(out, 2, 3)
    clen: blen + 16 + 8
    poke_byte(out, 3, clen / 256)
    poke_byte(out, 4, clen % 256)
    i: 0
    as long as i < 8
        poke_byte(out, 5 + i, wand(shr(sq, (7 - i) * 8), 255))
        i: i + 1
    aad: _sov_heap_alloc(16)
    i: 0
    as long as i < 8
        poke_byte(aad, i, wand(shr(sq, (7 - i) * 8), 255))
        i: i + 1
    poke_byte(aad, 8, typ)
    poke_byte(aad, 9, 3)
    poke_byte(aad, 10, 3)
    poke_byte(aad, 11, blen / 256)
    poke_byte(aad, 12, blen % 256)
    nonce: _sov_heap_alloc(16)
    i: 4
    mem_copy(nonce, iv, 4)
    i: 0
    as long as i < 8
        poke_byte(nonce, 4 + i, wand(shr(sq, (7 - i) * 8), 255))
        i: i + 1
    ct: _sov_alloc(blen + 16)
    gmt: gm_enc(key, nonce, aad, 13, body, blen, ct)
    i: 0
    as long as i < blen
        poke_byte(out, 13 + i, peek_byte(ct, i))
        i: i + 1
    i: 0
    as long as i < 16
        poke_byte(out, 13 + blen + i, peek_byte(gm_tag, i))
        i: i + 1
    tl_seq_c: sq + 1
    tl_clen: 5 + 8 + blen + 16
    return 5 + 8 + blen + 16
tl_rec_dec in blen typ out key iv:
    ss: tl_seq_s
    nonce: _sov_heap_alloc(16)
    i: 4
    mem_copy(nonce, iv, 4)
    i: 0
    as long as i < 8
        poke_byte(nonce, 4 + i, peek_byte(in, i))
        i: i + 1
    n: blen - 8 - 16
    aad: _sov_heap_alloc(16)
    i: 0
    as long as i < 8
        poke_byte(aad, i, wand(shr(ss, (7 - i) * 8), 255))
        i: i + 1
    poke_byte(aad, 8, typ)
    poke_byte(aad, 9, 3)
    poke_byte(aad, 10, 3)
    poke_byte(aad, 11, n / 256)
    poke_byte(aad, 12, n % 256)
    ct: _sov_alloc(n)
    i: 0
    as long as i < n
        poke_byte(ct, i, peek_byte(in, 8 + i))
        i: i + 1
    gm_ctr_dec(key, nonce, ct, n, out)
    gm_tag_of(key, nonce, aad, 13, ct, n)
    bad: 0
    i: 0
    as long as i < 16
        if peek_byte(gm_tag, i) is not peek_byte(in, 8 + n + i) -> bad: 1
        i: i + 1
    tl_seq_s: ss + 1
    if bad is 0 -> return 1
    return 0
tl_rb: 0
tl_rtype: 0
tl_rlen: 0
tl_recv fd:
    hdr: _sov_alloc(8)
    got: 0
    as long as got < 5
        n: sock_recv_raw(fd, hdr + got, 5 - got)
        if n < 1 -> return 0 - 1
        got: got + n
    tl_rtype: peek_byte(hdr, 0)
    l: peek_byte(hdr, 3) * 256 + peek_byte(hdr, 4)
    tl_rlen: l
    if tl_rb is 0 -> tl_rb: _sov_alloc(20000)
    got: 0
    as long as got < l
        n: sock_recv_raw(fd, tl_rb + got, l - got)
        if n < 1 -> return 0 - 1
        got: got + n
    return 0
tl_hslen: 0
tl_hs_add hs at typ body blen:
    poke_byte(hs, at, typ)
    poke_byte(hs, at + 1, blen / 65536)
    poke_byte(hs, at + 2, (blen / 256) % 256)
    poke_byte(hs, at + 3, blen % 256)
    i: 0
    as long as i < blen
        poke_byte(hs, at + 4 + i, peek_byte(body, i))
        i: i + 1
    tl_hslen: at + 4 + blen
tl_client fd host req out outmax:
    tl_cur_host: host
    tl_seq_c: 0
    tl_seq_s: 0
    rcrs: _sov_alloc(64)
    ms: _sov_alloc(48)
    pm: _sov_alloc(48)
    ep: _sov_heap_alloc(32)
    epu: _sov_heap_alloc(32)
    spub: _sov_heap_alloc(32)
    b9: _sov_heap_alloc(32)
    sk: _sov_alloc(16)
    civ: _sov_alloc(4)
    rk: _sov_alloc(16)
    riv: _sov_alloc(4)
    mb: _sov_heap_alloc(272)
    eb: _sov_heap_alloc(8)
    hs: _sov_heap_alloc(20000)
    hlen: 0
    rb: rand_bytes(32)
    i: 0
    as long as i < 32
        poke_byte(rcrs, i, peek_byte(rb, i))
        i: i + 1
    poke_byte(b9, 0, 9)
    r: tl_step_ch(fd, rcrs, hs)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    hlen: tl_hslen
    r: tl_step_sh(fd, rcrs, hs, hlen)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    hlen: tl_hslen
    r: tl_step_cert(fd, mb, eb, hs, hlen)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    hlen: tl_hslen
    r: tl_step_ske(fd, rcrs, mb, eb, spub, hs, hlen)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    hlen: tl_hslen
    r: tl_step_ep(ep, epu, spub, pm, b9)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    r: tl_step_shd(fd, hs, hlen)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    hlen: tl_hslen
    r: tl_step_cke(fd, epu, hs, hlen)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    hlen: tl_hslen
    r: tl_step_keys(rcrs, pm, ms, sk, civ, rk, riv)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    tl_wipe(ep, 32)
    tl_wipe(pm, 48)
    tl_seq_c: 0
    r: tl_step_finish(fd, sk, civ, ms, hs, hlen)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    hlen: tl_hslen
    r: tl_step_vfinish(fd, rk, riv, ms, hs, hlen)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    tl_wipe(ms, 48)
    tl_seq_c: 1
    r: tl_step_send(fd, sk, civ, req, out, outmax)
    if r is 0 -> return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, 0))
    r: tl_step_read(fd, rk, riv, out, outmax)
    tl_len: tl_gtot
    return tl12_wipe_b(sk, civ, rk, riv, tl12_wipe_a(rcrs, ms, pm, ep, rb, tl_gtot))
tl_gtot: 0
tl_step_send fd sk civ req out outmax:
    n: str_len(req)
    sq: 1
    i: 0
    as long as i < n
        cl: 4096
        if n - i < 4096 -> cl: n - i
        chunk: _sov_heap_alloc(4096)
        j: 0
        as long as j < cl
            poke_byte(chunk, j, peek_byte(req, i + j))
            j: j + 1
        en: _sov_heap_alloc(4200)
        tl_seq_c: sq
        tl_rec_enc(en, 23, chunk, cl, sk, civ)
        rl: tl_clen
        sq: sq + 1
        sock_send_raw(fd, en, rl)
        i: i + cl
    return 1
tl_step_read fd rk riv out outmax:
    tot: 0
    ss: tl_seq_s
    more: 1
    as long as more is 1
        r: tl_recv(fd)
        if r is not 0 -> more: 0
        if not
            if tl_rtype is 23
                d: _sov_heap_alloc(20000)
                tl_seq_s: ss
                ok: tl_rec_dec(tl_rb, tl_rlen, tl_rtype, d, rk, riv)
                ss: tl_seq_s
                if ok is 1
                    n: tl_rlen - 24
                    j: 0
                    as long as j < n
                        if tot + j < outmax -> poke_byte(out, tot + j, peek_byte(d, j))
                        j: j + 1
                    tot: tot + n
            if not -> more: 0
    tl_gtot: tot
    return 1
tl_step_ch fd rcrs hs:
    ch: _sov_alloc(80)
    poke_byte(ch, 0, 3)
    poke_byte(ch, 1, 3)
    i: 0
    as long as i < 32
        poke_byte(ch, 2 + i, peek_byte(rcrs, i))
        i: i + 1
    poke_byte(ch, 34, 0)
    poke_byte(ch, 35, 0)
    poke_byte(ch, 36, 2)
    poke_byte(ch, 37, 192)
    poke_byte(ch, 38, 47)
    poke_byte(ch, 39, 1)
    poke_byte(ch, 40, 0)
    poke_byte(ch, 41, 0)
    poke_byte(ch, 42, 22)
    poke_byte(ch, 43, 0)
    poke_byte(ch, 44, 13)
    poke_byte(ch, 45, 0)
    poke_byte(ch, 46, 4)
    poke_byte(ch, 47, 0)
    poke_byte(ch, 48, 2)
    poke_byte(ch, 49, 4)
    poke_byte(ch, 50, 1)
    poke_byte(ch, 51, 0)
    poke_byte(ch, 52, 10)
    poke_byte(ch, 53, 0)
    poke_byte(ch, 54, 4)
    poke_byte(ch, 55, 0)
    poke_byte(ch, 56, 2)
    poke_byte(ch, 57, 0)
    poke_byte(ch, 58, 29)
    poke_byte(ch, 59, 0)
    poke_byte(ch, 60, 11)
    poke_byte(ch, 61, 0)
    poke_byte(ch, 62, 2)
    poke_byte(ch, 63, 1)
    poke_byte(ch, 64, 0)
    tl_hs_add(hs, 0, 1, ch, 65)
    rec: _sov_alloc(64)
    poke_byte(rec, 0, 22)
    poke_byte(rec, 1, 3)
    poke_byte(rec, 2, 3)
    poke_byte(rec, 3, tl_hslen / 256)
    poke_byte(rec, 4, tl_hslen % 256)
    i: 0
    as long as i < tl_hslen
        poke_byte(rec, 5 + i, peek_byte(hs, i))
        i: i + 1
    sock_send_raw(fd, rec, 5 + tl_hslen)
    return 1
tl_step_sh fd rcrs hs hlen:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    sh: tl_rb + 4
    i: 0
    as long as i < 32
        poke_byte(rcrs, 32 + i, peek_byte(sh, 2 + i))
        i: i + 1
    tl_hs_add(hs, hlen, 2, sh, tl_rlen - 4)
    return 1
tl_step_cert fd mb eb hs hlen:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    cbody: tl_rb + 4
    clen: peek_byte(cbody, 3) * 65536 + peek_byte(cbody, 4) * 256 + peek_byte(cbody, 5)
    cert: cbody + 6
    tl_hs_add(hs, hlen, 11, cbody, tl_rlen - 4)
    if tl_chain12(cbody) is 0 -> return 0
    tl_cert_key(cert, clen)
    j: tl_modlen
    mem_copy(mb, tl_mod, tl_modlen)
    mem_copy(eb, tl_exp, tl_explen)
    poke_i64(mb, 256, tl_modlen)
    poke_i64(mb, 264, tl_explen)
    return 1
tl_step_shd fd hs hlen:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    tl_hs_add(hs, hlen, 14, tl_rb + 4, tl_rlen - 4)
    return 1
tl_step_ep ep epu spub pm b9:
    rb: rand_bytes(32)
    i: 0
    as long as i < 32
        poke_byte(ep, i, peek_byte(rb, i))
        i: i + 1
    x19(epu, ep, b9)
    x19(pm, ep, spub)
    return 1
tl_step_ske fd rcrs mb eb spub hs hlen:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    if peek_byte(tl_rb, 0) is not 12 -> return 0
    prm: tl_rb + 4
    i: 0
    as long as i < 32
        poke_byte(spub, i, peek_byte(prm, 4 + i))
        i: i + 1
    tl_hs_add(hs, hlen, 12, tl_rb + 4, tl_rlen - 4)
    hi: _sov_heap_alloc(100)
    i: 0
    as long as i < 32
        poke_byte(hi, i, peek_byte(rcrs, i))
        poke_byte(hi, 32 + i, peek_byte(rcrs, 32 + i))
        i: i + 1
    i: 0
    as long as i < 36
        poke_byte(hi, 64 + i, peek_byte(prm, i))
        i: i + 1
    hb: _sov_heap_alloc(64)
    sha256_bytes(hi, 100, hb)
    fseed: _sov_heap_alloc(32)
    j: 0
    as long as j < 8
        v: peek_i64(hb, j * 8)
        poke_byte(fseed, j * 4, wand(shr(v, 24), 255))
        poke_byte(fseed, j * 4 + 1, wand(shr(v, 16), 255))
        poke_byte(fseed, j * 4 + 2, wand(shr(v, 8), 255))
        poke_byte(fseed, j * 4 + 3, wand(v, 255))
        j: j + 1
    k: peek_i64(mb, 256)
    expd: _sov_alloc(512)
    j: 0
    as long as j < k
        poke_byte(expd, j, 255)
        j: j + 1
    poke_byte(expd, 0, 0)
    poke_byte(expd, 1, 1)
    poke_byte(expd, k - 52, 0)
    poke_byte(expd, k - 51, 48)
    poke_byte(expd, k - 50, 49)
    poke_byte(expd, k - 49, 48)
    poke_byte(expd, k - 48, 13)
    poke_byte(expd, k - 47, 6)
    poke_byte(expd, k - 46, 9)
    poke_byte(expd, k - 45, 96)
    poke_byte(expd, k - 44, 134)
    poke_byte(expd, k - 43, 72)
    poke_byte(expd, k - 42, 1)
    poke_byte(expd, k - 41, 101)
    poke_byte(expd, k - 40, 3)
    poke_byte(expd, k - 39, 4)
    poke_byte(expd, k - 38, 2)
    poke_byte(expd, k - 37, 1)
    poke_byte(expd, k - 36, 5)
    poke_byte(expd, k - 35, 0)
    poke_byte(expd, k - 34, 4)
    poke_byte(expd, k - 33, 32)
    j: 0
    as long as j < 32
        poke_byte(expd, k - 32 + j, peek_byte(fseed, j))
        j: j + 1
    sl: peek_byte(tl_rb, 42) * 256 + peek_byte(tl_rb, 43)
    sg: tl_rb + 44
    ck: _sov_alloc(512)
    tl_rsa_enc(sg, sl, ck, mb, k, eb, peek_i64(mb, 264))
    bad: 0
    j: 0
    as long as j < k
        if peek_byte(ck, j) is not peek_byte(expd, j) -> bad: 1
        j: j + 1
    if bad is 1 -> return 0
    return 1
tl_step_cke fd epu hs hlen:
    cke: _sov_heap_alloc(40)
    poke_byte(cke, 0, 32)
    j: 0
    as long as j < 32
        poke_byte(cke, 1 + j, peek_byte(epu, j))
        j: j + 1
    tl_hs_add(hs, hlen, 16, cke, 33)
    rec: _sov_alloc(45)
    poke_byte(rec, 0, 22)
    poke_byte(rec, 1, 3)
    poke_byte(rec, 2, 3)
    l: 4 + 33
    poke_byte(rec, 3, l / 256)
    poke_byte(rec, 4, l % 256)
    poke_byte(rec, 5, 16)
    poke_byte(rec, 6, 0)
    poke_byte(rec, 7, 0)
    poke_byte(rec, 8, 33)
    j: 0
    as long as j < 33
        poke_byte(rec, 9 + j, peek_byte(cke, j))
        j: j + 1
    sock_send_raw(fd, rec, 9 + 33)
    return 1
tl_step_keys rcrs pm ms sk civ rk riv:
    tl_n: 48
    tl_prf(ms, pm, 48, "master secret", 13, rcrs, 64)
    seed2: _sov_heap_alloc(64)
    j: 0
    as long as j < 32
        poke_byte(seed2, j, peek_byte(rcrs, 32 + j))
        poke_byte(seed2, 32 + j, peek_byte(rcrs, j))
        j: j + 1
    kb: _sov_heap_alloc(40)
    tl_n: 40
    tl_prf(kb, ms, 48, "key expansion", 13, seed2, 64)
    j: 0
    as long as j < 16
        poke_byte(sk, j, peek_byte(kb, j))
        poke_byte(rk, j, peek_byte(kb, 16 + j))
        j: j + 1
    j: 0
    as long as j < 4
        poke_byte(civ, j, peek_byte(kb, 32 + j))
        poke_byte(riv, j, peek_byte(kb, 36 + j))
        j: j + 1
    return 1
    tl_wipe(kb, 40)
tl_step_finish fd sk civ ms hs hlen:
    hs2: _sov_heap_alloc(64)
    sha256_bytes(hs, hlen, hs2)
    fseed: _sov_heap_alloc(32)
    j: 0
    as long as j < 8
        v: peek_i64(hs2, j * 8)
        poke_byte(fseed, j * 4, wand(shr(v, 24), 255))
        poke_byte(fseed, j * 4 + 1, wand(shr(v, 16), 255))
        poke_byte(fseed, j * 4 + 2, wand(shr(v, 8), 255))
        poke_byte(fseed, j * 4 + 3, wand(v, 255))
        j: j + 1
    fv: _sov_alloc(32)
    tl_n: 12
    tl_prf(fv, ms, 48, "client finished", 15, fseed, 32)
    fm: _sov_heap_alloc(16)
    poke_byte(fm, 0, 20)
    poke_byte(fm, 1, 0)
    poke_byte(fm, 2, 0)
    poke_byte(fm, 3, 12)
    j: 0
    as long as j < 12
        poke_byte(fm, 4 + j, peek_byte(fv, j))
        j: j + 1
    en: _sov_alloc(64)
    tl_seq_c: 0
    tl_rec_enc(en, 22, fm, 16, sk, civ)
    rl: tl_clen
    both: _sov_alloc(80)
    poke_byte(both, 0, 20)
    poke_byte(both, 1, 3)
    poke_byte(both, 2, 3)
    poke_byte(both, 3, 0)
    poke_byte(both, 4, 1)
    poke_byte(both, 5, 1)
    i: 0
    as long as i < rl
        poke_byte(both, 6 + i, peek_byte(en, i))
        i: i + 1
    sock_send_raw(fd, both, 6 + rl)
    tl_hs_add(hs, hlen, 20, fv, 12)
    return 1
tl_step_vfinish fd rk riv ms hs hlen:
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 20 -> return 0
    r: tl_recv(fd)
    if r is not 0 -> return 0
    if tl_rtype is not 22 -> return 0
    d: _sov_alloc(200)
    ok: tl_rec_dec(tl_rb, tl_rlen, tl_rtype, d, rk, riv)
    if ok is 0 -> return 0
    hs2: _sov_heap_alloc(64)
    sha256_bytes(hs, hlen, hs2)
    fseed: _sov_heap_alloc(32)
    j: 0
    as long as j < 8
        v: peek_i64(hs2, j * 8)
        poke_byte(fseed, j * 4, wand(shr(v, 24), 255))
        poke_byte(fseed, j * 4 + 1, wand(shr(v, 16), 255))
        poke_byte(fseed, j * 4 + 2, wand(shr(v, 8), 255))
        poke_byte(fseed, j * 4 + 3, wand(v, 255))
        j: j + 1
    sv: _sov_alloc(32)
    tl_n: 12
    tl_prf(sv, ms, 48, "server finished", 15, fseed, 32)
    bad: 0
    j: 0
    as long as j < 12
        if peek_byte(sv, j) is not peek_byte(d, 4 + j) -> bad: 1
        j: j + 1
    if bad is 1 -> return 0
    return 1
tl_len: 0
tl_send_req host port req out outmax:
    ip: web_lookup(host)
    if str_len(ip) is 0 -> return 0
    tl_parse_ip(ip)
    fd: sock_connect(tl_a0, tl_a1, tl_a2, tl_a3, port)
    if fd < 0 -> return 0
    tot: tl_client(fd, host, req, out, outmax)
    sock_close(fd)
    return tot
tl_get host port path out outmax:
    req: str_cat("GET ", path)
    req: str_cat(req, " HTTP/1.1\r\nHost: ")
    req: str_cat(req, host)
    req: str_cat(req, "\r\nConnection: close\r\n\r\n")
    return tl_send_req(host, port, req, out, outmax)
tl_a0: 0
tl_a1: 0
tl_a2: 0
tl_a3: 0
tl_parse_ip s:
    a: 0
    b: 0
    c: 0
    d: 0
    tl_a0: 0
    tl_a1: 0
    tl_a2: 0
    tl_a3: 0
    n: str_len(s)
    v: 0
    part: 0
    i: 0
    as long as i < n
        ch: peek_byte(s, i)
        if ch is 46
            if part is 0 -> tl_a0: v
            if part is 1 -> tl_a1: v
            if part is 2 -> tl_a2: v
            part: part + 1
            v: 0
