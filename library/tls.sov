# TRUST MODEL (honest scope, 2026-10-30): TLS 1.0/1.2/1.3 clients verify
# the certificate chain to 7 embedded RSA roots (signatures RSA PKCS#1 v1.5
# SHA-256/SHA-1), certificate validity windows, and the hostname (SAN
# dNSName with single-label wildcards; CN fallback only when no SAN).
# NOT covered: chains anchored at other/ECDSA roots, revocation
# (CRL/OCSP), certificate Transparency. Widen the root set before
# claiming general-web coverage.
use mem
use bigint
use bit32
use gcm
use hkdf
use hmac
use num
use sha256
use rand
use aes
use md5
use sha1
use sock
use string
use sys
use time
use web
use x25519
tl_vstart: 0
tl_vend: 0
tl_wipe p n:
    if p is 0 -> return 0
    wi: 0
    as long as wi < n
        poke_byte(p, wi, 0)
        wi: wi + 1
    return 0
tl12_wipe_a rcrs ms pm ep rb ret:
    tl_wipe(rcrs, 64)
    tl_wipe(ms, 48)
    tl_wipe(pm, 48)
    tl_wipe(ep, 32)
    tl_wipe(rb, 32)
    return ret
tl12_wipe_b sk civ rk riv ret:
    tl_wipe(sk, 16)
    tl_wipe(civ, 4)
    tl_wipe(rk, 16)
    tl_wipe(riv, 4)
    return ret
tl13_wipe epriv cts sts cap sap hsec ret:
    tl_wipe(epriv, 32)
    tl_wipe(cts, 32)
    tl_wipe(sts, 32)
    tl_wipe(cap, 32)
    tl_wipe(sap, 32)
    tl_wipe(hsec, 32)
    return ret
tl10_wipe ctx rcrs pm ep rb ret:
    tl_wipe(ctx, 176)
    tl_wipe(rcrs, 64)
    tl_wipe(pm, 48)
    tl_wipe(ep, 32)
    tl_wipe(rb, 32)
    return ret
tl_len p i:
    l: peek_byte(p, i + 1)
    if l < 128
        tl_vstart: i + 2
        tl_vend: i + 2 + l
        return 0
    if l is 129
        tl_vstart: i + 3
        tl_vend: i + 3 + peek_byte(p, i + 2)
        return 0
    if l is 130
        tl_vstart: i + 4
        tl_vend: i + 4 + peek_byte(p, i + 2) * 256 + peek_byte(p, i + 3)
        return 0
    return 0 - 1
tl_child p i k:
    tl_len(p, i)
    at: tl_vstart
    c: 0
    as long as c < k
        tl_len(p, at)
        at: tl_vend
        c: c + 1
    return at
tl_integer p i out:
    tl_len(p, i)
    a: tl_vstart
    n: tl_vend - tl_vstart
    if n > 1
        if peek_byte(p, a) is 0
            a: a + 1
            n: n - 1
    j: 0
    as long as j < n
        poke_byte(out, j, peek_byte(p, a + j))
        j: j + 1
    return n
tl_mod: 0
tl_modlen: 0
tl_exp: 0
tl_explen: 0
tl_cert_key cert clen:
    tbs: tl_child(cert, 0, 0)
    spki: tl_child(cert, tbs, 6)
    bs: tl_child(cert, spki, 1)
    tl_len(cert, bs)
    rsa: tl_vstart + 1
    modi: tl_child(cert, rsa, 0)
    expi: tl_child(cert, rsa, 1)
    if tl_mod is 0 -> tl_mod: _sov_alloc(512)
    if tl_exp is 0 -> tl_exp: _sov_alloc(8)
    tl_modlen: tl_integer(cert, modi, tl_mod)
    tl_explen: tl_integer(cert, expi, tl_exp)
    return 0
ROOT_N: 7
ROOT_HA_DIGICERT_ROOT: "E23BE11172DEA8A4D3A357AA50A28F0B7790C9A2A5EE12CE965B010920CC0193A74E30B753F743C46900579DE28D22DD870640008109CECE1B83BFDFCD3B7146E2D666C705B37627168F7B9E1E957DEEB748A308DAD6AF7A0C3906657F4A5D1FBC17F8ABBEEE28D7747F7A78995985686E5C23324BBF4EC0E85A6DE370BF7710"
ROOT_HB_DIGICERT_ROOT: "BFFC01F685D9A844105832A97518D5D1A2BE47E2276AF49A33F84908608BD45FB43A84BFA1AA4A4C7D3ECF4F5F6C765EA04B37919EDC22E66DCE141A8E6ACBFECDB3146417C75B299E32BFF2EEFAD30B42D4ABB74132DA0CD4EFF881D5BB8D583FB51BE84928A270DA3104DDF7B216F24C0A4E07A8ED4A3D5EB57FA390C3AF27"
