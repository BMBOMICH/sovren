        poke_byte(dst, j * 4 + 1, wand(shr(v, 16), 255))
        poke_byte(dst, j * 4 + 2, wand(shr(v, 8), 255))
        poke_byte(dst, j * 4 + 3, wand(v, 255))
        j: j + 1
    return 0
