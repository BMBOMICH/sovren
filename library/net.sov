# net.sov — same as sock, shorter names
use sock

net_listen port:
    return sock_listen(port)

net_accept fd:
    return sock_accept(fd)

net_connect a b c d port:
    return sock_connect(a, b, c, d, port)

net_send fd s:
    return sock_send(fd, s)

net_recv fd n:
    return sock_recv(fd, n)

net_close fd:
    return sock_close(fd)
