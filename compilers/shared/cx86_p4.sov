        return 0
    if oid is kid_opwadd
        add_rax_rcx()
        return 0
    if oid is kid_opwsub
        sub_rax_rcx()
        return 0
    if oid is kid_opwmul
        imul_rax_rcx()
        return 0
    cmp_rax_rcx()
    setcc_k(oid)
