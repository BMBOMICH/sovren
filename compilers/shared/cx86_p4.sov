ez_t: 0
ez_a: 0
ez_b: 0
ez_c: 0
ez_d: 0
ez_n: 0
# pad line so main is not first
# unsafe-module
oc_n: 0
oc_cap: 0
ocgrow:
    pc_gr: pc_gr + 1
    # `oc` itself is already declared by the kits' 0: global list; do not
    # re-declare it here (that is a duplicate top-level definition).
    # the code buffer is a raw arena: emit() stores one byte and bumps oc_n.
    # (Was: a list with one eight-byte slot per emitted byte, two calls per
    # byte.  Same byte sequence out, ~1/4 the memory traffic, no calls.)
    n: 4194304
    if oc_cap > 0
        n: oc_cap * 2
    nb: _sov_heap_alloc(n)
    k: 0
    as long as k + 8 <= oc_n
        dummy: poke_i64(nb, k, peek_i64(oc, k))
        k: k + 8
    as long as k < oc_n
        dummy: poke_byte(nb, k, peek_byte(oc, k))
        k: k + 1
    oc: nb
    oc_cap: n
ocd: 0
ocput2 a v:
    # receiver for the source's per-line map form (`ocd: ocput2:` + block)
    ocput(v)
    return 0
ocget i:
    # the old list_get answered 0 outside the buffer; keep that (a raw peek
    # would return whatever memory happens to be there)
    if i < 0
        return 0
    if i >= oc_n
        return 0
    return peek_byte(oc, i)
ocset i v:
    # the old list_set dropped out-of-range stores; the branch patcher really
    # does hand `put` stale positions, and a raw poke would write outside the
    # arena (measured: at = 0x158d4000 with 230 bytes of code)
    if i > 0 - 1
        if i < oc_n
            poke_byte(oc, i, band(v, 255))
oc_here a:
    # px01:116 builds `here()` as `%2(%3)`; %3 stays `oc` so the template line
    # still parses, %2 is this one-line shim for the arena length.
    return oc_n
ocput v:
    if oc_n >= oc_cap
        ocgrow()
    poke_byte(oc, oc_n, band(v, 255))
    oc_n: oc_n + 1
oc_from_list l:
    # the dce filters rebuild the buffer as a list of kept bytes; this copies
    # that list back into the arena (same bytes, in order).
    oc_n: 0
    oi: 0
    as long as oi < _sov_list_len(l)
        ocput(peek_i64(l, 16 + oi * 8))
        oi: oi + 1
emit n:
    x: band(n, 255)
    if x > 87
        if x < 96
            if push_live is 1
                push_live: 0
                if x is 88
                    oc_n: oc_n - 1
                    return
                if x is 89
                    oc_n: oc_n - 1
                    ocd: ocput2(ocd, 72)
                    ocd: ocput2(ocd, 137)
                    ocd: ocput2(ocd, 193)
                    return
                if x is 90
                    oc_n: oc_n - 1
                    ocd: ocput2(ocd, 72)
                    ocd: ocput2(ocd, 137)
                    ocd: ocput2(ocd, 194)
                    return
                if x is 94
                    oc_n: oc_n - 1
                    ocd: ocput2(ocd, 72)
                    ocd: ocput2(ocd, 137)
                    ocd: ocput2(ocd, 198)
                    return
                if x is 95
                    oc_n: oc_n - 1
                    ocd: ocput2(ocd, 72)
                    ocd: ocput2(ocd, 137)
                    ocd: ocput2(ocd, 199)
                    return
    push_live: 0
    if oc_n + 16 > oc_cap
        ocgrow()
    poke_byte(oc, oc_n, x)
    oc_n: oc_n + 1
emit2 a b:
    if oc_n + 2 > oc_cap
        ocgrow()
    poke_byte(oc, oc_n, band(a, 255))
    poke_byte(oc, oc_n + 1, band(b, 255))
    oc_n: oc_n + 2
emit3 a b c:
    if oc_n + 3 > oc_cap
        ocgrow()
    poke_byte(oc, oc_n, band(a, 255))
    poke_byte(oc, oc_n + 1, band(b, 255))
    poke_byte(oc, oc_n + 2, band(c, 255))
    oc_n: oc_n + 3
emit4 n:
    v: n
    if v < 0
        v: v + 4294967296
    if oc_n + 4 > oc_cap
        ocgrow()
    poke_byte(oc, oc_n, band(v, 255))
    poke_byte(oc, oc_n + 1, band(bshr(v, 8), 255))
    poke_byte(oc, oc_n + 2, band(bshr(v, 16), 255))
    poke_byte(oc, oc_n + 3, band(bshr(v, 24), 255))
    oc_n: oc_n + 4
emit8 n:
    if oc_n + 8 > oc_cap
        ocgrow()
    poke_i64(oc, oc_n, n)
    oc_n: oc_n + 8
emit_addsub_slot dd sd is_sub:
    dn: 3
    if dd > 0
        dn: 11 + dd
    sn: 3
    if sd > 0
        sn: 11 + sd
    rex: 72
    if sn > 7
        rex: rex + 4
    if dn > 7
        rex: rex + 1
    emit(rex)
    if is_sub is 1
        emit(41)
    if not
        emit(1)
    emit(192 + (sn % 8) * 8 + (dn % 8))
emit_cmov_x_rdi cc xs:
    rx: 72
    if xs > 0
        rx: rx + 4
    emit(rx)
    emit(15)
    emit(cc)
    emit(192 + (xs + 3) * 8 + 7)
emit_cmp_jge cond:
    return fuse_cmp(cond, 1)
emit_cmp_rax_scaled bs i2 dp:
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    emit(rx)
    emit(59)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + nd * 64
    emit(m)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
emit_cmp_rcx_scaled bs i2 dp:
    rx: 72
