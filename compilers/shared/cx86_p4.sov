    emit(disp % 256)
emit_lea_rdi_xs xs di:
    if xs is 1
        emit3(73, 141, 124)
        emit(36)
        emit(di)
        return 0
    rx: 72
    if xs > 0
        rx: rx + 1
    emit(rx)
    emit(141)
    emit(123 + xs)
    emit(di)
emit_lea_slot2p1 sd dd:
    rx: 72
