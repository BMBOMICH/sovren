    return
emit_name_or_imm e:
    e: strip(e)
    if length(e) is 0
        xor_rax()
        return
    if digitb(peek_byte(e, 0)) is 1
        rax_imm(num_of(e))
        return
    if peek_byte(e, 0) is 45
        if length(e) > 1
            if digitb(peek_byte(e, 1)) is 1
                rax_imm(0 - num_of(cut(e, 1, length(e))))
                return
    loadv(repl(e, " ", "_"))
emit_op op:
    return emit_op_k(intern_kid(op))

emit_op_k oid:
    if oid is kid_opadd
        add_rax_rcx()
        chk_ov()
        return 0
    if oid is kid_opsub
        sub_rax_rcx()
        chk_ov()
        return 0
    if oid is kid_opmul
        imul_rax_rcx()
        chk_ov()
        return 0
    if oid is kid_opdiv
        chk_zrcx()
        chk_div_overflow(-1)
        emit3(72, 153, 72)
        emit2(247, 249)
        return 0
    if oid is kid_opmod
        chk_zrcx()
        chk_div_overflow(-1)
        emit3(72, 153, 72)
        emit3(247, 249, 72)
        emit(146)
        return 0
    if oid is kid_opband
        emit3(72, 33, 200)
        return 0
    if oid is kid_opbor
        emit3(72, 9, 200)
        return 0
    if oid is kid_opbxor
        emit3(72, 49, 200)
        return 0
    if oid is kid_opbshl
