        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        emit(nd * 64 + (vr + 3) * 8 + 4)
        emit(36)
    if not
        emit(nd * 64 + (vr + 3) * 8 + bs + 3)
    if nd is 1
        emit(imm)
    if nd is 2
        emit4(imm)
emit_store_abs_rax bs imm:
    rx: 72
    if bs > 0
        rx: rx + 1
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if imm > 0
        if imm < 128
            nd: 1
        if not
            nd: 2
    if bs is 1
        emit(nd * 64 + 4)
        emit(36)
    if not
        emit(nd * 64 + bs + 3)
    if nd is 1
        emit(imm)
    if nd is 2
        emit4(imm)
emit_store_scaled_rax bs i2 dp:
    rx: 72
    if bs > 0
        rx: rx + 1
    if i2 > 0
        rx: rx + 2
    emit(rx)
    emit(137)
    nd: 0
    if bs is 2
        nd: 1
    if dp is not 0
        nd: 1
    m: 4 + nd * 64
    emit(m)
    emit(192 + (i2 + 3) * 8 + bs + 3)
    if nd is 1
        emit(dp)
        lb: dp % 256
        if lb < 0
            lb: lb + 256
        if lb > 211
            if lb < 252
                if lb % 8 is 0
                    emit(144)
emit_streq:
    fn_names: _sov_list_add(fn_names, "_sov_str_eq")
    fn_offs: _sov_list_add(fn_offs, here())
    dhs0: plog_h0()
    # str_eq v3: SSE2. fast first-word path (single (a|b) page-room
    # check), then 32B/16B vector loops inside page segments; any
    # vector with a difference or a NUL is decided by a bounded byte
    # walk. identical pointers (incl both null) -> 1; one null -> 0.
