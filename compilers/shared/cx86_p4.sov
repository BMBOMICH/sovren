emit_lea_arg ai sl disp:
    dn: 7
    if ai is 1
        dn: 6
    if ai is 2
        dn: 2
    if ai is 3
        dn: 1
    if ai is 4
        dn: 8
    if ai is 5
        dn: 9
    sn: 11 + sl
    if sl is 0
        sn: 3
    rex: 72
    if dn > 7
        rex: rex + 4
    if sn > 7
        rex: rex + 1
    emit(rex)
    emit(141)
    emit(64 + (dn % 8) * 8 + (sn % 8))
    if sl is 1
        emit(36)
    emit(disp % 256)
emit_lea_rax sl disp:
    sn: 11 + sl
    if sl is 0
        sn: 3
    rex: 72
    if sn > 7
        rex: rex + 1
    emit(rex)
    emit(141)
    emit(64 + (sn % 8))
    if sl is 1
