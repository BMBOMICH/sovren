    if kid is kid_opbor
        emit(9)
    if kid is kid_opbxor
        emit(49)
    if kid is kid_wrap_add
        emit(1)
    if kid is kid_wrap_sub
        emit(41)
    if kid is kid_opbshl
        emit(211)
        emit(224 + lo)
