            ag1: 0
        if li >= 0
            le: cfind1n(src, li, sn, 10)
            lnn: le
            if le < 0
                lnn: sn
            if sp_inc_spec(src, li, lnn) is 0
                return 0
            cur: lnn + 1
            if le < 0
                ag1: 0
