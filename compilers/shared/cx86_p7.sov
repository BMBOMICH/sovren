sp_lskip s:
    k: 0
    as long as 1
        b: peek_byte(s, k)
        if b is 32
            k: k + 1
        if not
            if b is 9
                k: k + 1
            if not
                if b is 10
                    k: k + 1
                if not
                    if b is 13
                        k: k + 1
                    if not
                        return s + k
sp_has_include t:
    # 1 iff some line's first non-whitespace bytes are `include ` -- the
    # only shape the long splice path acts on.  Plain Sovren here for
    # other backends; on x86 try_native_body plants emit_nt_sp_inc.
    lim: length(t)
    i: 0
    as long as i < lim
        j: i
        ws: 1
        as long as ws is 1
            if j >= lim
                ws: 0
            if ws is 1
                b: peek_byte(t, j)
                if b is 32
                    j: j + 1
                if not
                    if b is 9
                        j: j + 1
                    if not
                        if b is 13
                            j: j + 1
                        if not
                            ws: 0
        if j + 8 <= lim
            if peek_i64(t, j) is 2334382437353877097
                return 1
        e: cfind1n(t, i, lim, 10)
        if e < 0
            return 0
        i: e + 1
    return 0

sp_tdepth: 0
sp_slo: 0
sp_shi: 0

sp_find_inc t st lim:
    # line-start index of the next line at/after st whose sp_lskip
    # begins with "include ", or -1 (mirrors pu_find_use's walk).
    i: st
