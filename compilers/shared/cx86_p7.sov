sp_splice_text src base:
    # Textual splice for files whose own include lines are all plain:
    # raw source segments and recursively spliced file texts are
    # joined in one buffer -- the same bytes the line path produces
    # (it rejoins every line with a newline), without splitting every
    # included file into a line list first.  Returns 0 to decline.
    sn: length(src)
    cur: 0
    ag1: 1
    as long as ag1 is 1
        li: sp_find_inc(src, cur, sn)
