    # dead loop line 2 (placeholder keeps include ranges stable)
    # dead loop line 3 (placeholder keeps include ranges stable)
    # dead loop line 4 (placeholder keeps include ranges stable)
    # dead loop line 5 (placeholder keeps include ranges stable)
    # dead loop line 6 (placeholder keeps include ranges stable)
    # dead loop line 7 (placeholder keeps include ranges stable)
    one: repl(strip(cut(p, start, n)), " ", "_")
    if length(one) > 0
        lst: _sov_list_add(lst, one)
    return lst
prep_main names params bodies:
    thin_main: 0
