            cp2: join(base, pname)
            cp3: join("library/", pname)
            f: load_file(cp1)
            if f is 0
                f: load_file(cp2)
            if f is 0
                f: load_file(cp3)
            if f is 0
                print "Error: include not found:"
                _sov_print(pname)
                err_where()
                had_err: 1
                fail()
            if sp_tdepth > 63
                print "Error: include nesting too deep (cycle?)"
                fail()
            sp_tdepth: sp_tdepth + 1
            inner: splice_inc(f, base)
            sp_tdepth: sp_tdepth - 1
            if li > seg
                segp: _sov_list_add(segp, src + seg)
                segl: _sov_list_add(segl, li - seg)
                tot: tot + li - seg
            inl: length(inner)
            if inl > 0
                segp: _sov_list_add(segp, inner)
                segl: _sov_list_add(segl, inl)
                tot: tot + inl
            if tot > 134217728
                print "Error: include expansion runaway (span includes itself?)"
                _sov_print(pname)
                err_where()
                had_err: 1
                fail()
            seg: lnn + 1
            if le < 0
                seg: sn
            cur: seg
            if le < 0
                bg1: 0
    if seg < sn
        segp: _sov_list_add(segp, src + seg)
        segl: _sov_list_add(segl, sn - seg)
        tot: tot + sn - seg
    buf: _sov_heap_alloc(tot + 2)
    w: 0
    ci: 0
    cn: _sov_list_len(segp)
    as long as ci < cn
        cln: peek_i64(segl, 16 + ci * 8)
        dummy: _sov_mem_copy(buf + w, peek_i64(segp, 16 + ci * 8), cln)
        w: w + cln
        ci: ci + 1
    if w > 0
        if peek_byte(buf, w - 1) is not 10
            poke_byte(buf, w, 10)
            w: w + 1
    poke_byte(buf, w, 0)
    return buf

splice_inc src base:
    # include-free sources (the common fresh-build case) pay one anchored
    # probe here instead of the full line-split round trip; the rebuilt
    # buffer the long path returns ends with exactly one newline, so
    # mirror that.  (The old anywhere-substring probe degenerated its
    # Boyer-Moore skip on the needle's trailing space.)
    if sp_has_include(src) is 0
        sn: length(src)
        if sn is 0
            return src
        if peek_byte(src, sn - 1) is 10
            return src
        nlb: _sov_heap_alloc(2)
        d1: _sov_set_byte(nlb, 0, 10)
        d2: _sov_set_byte(nlb, 1, 0)
        return str_cat(src, nlb)
    sp_tx: sp_splice_text(src, base)
    if sp_tx is not 0
        return sp_tx
    b: base
    # one splice asks for the same handful of files thousands of times
    # (the inc/* patchworks): read and split each distinct file once per
    # splice instead of once per include line.  In-run only, like a
    # symbol table; nothing is kept between compilations.
    inc_mp: _sov_list_new()
    inc_mf: _sov_list_new()
    inc_hint_n: 0
    # lines_of already returns the SWAR descriptor list; keep this splice on
    # the fast splitter explicitly (identical records, no per-line copies).
    lst: lines_of_fast(src)
    pass: 0
    pass_count: 0
    go: 1
    as long as go is 1
        go: 0
        pass: pass + 1
        pass_count: pass
        # PS42ek: the pass cap was 8, so a legal acyclic chain nine-plus deep
        # died with a bogus "cycle?" error (the parity harness nests 12).
        # 64 keeps the cycle terminator (a cycle still spins out) and lets
        # real include trees through; chains of eight or fewer never reach
        # the changed branch, so their products are byte-identical.
        if pass > 64
            print "Error: include nesting too deep (cycle?)"
            fail()
        acc: _sov_list_new()
        acc_bytes: 0
        i: 0
        n: _sov_list_len(lst)
        as long as i < n
            line: peek_i64(lst, 16 + i * 8)
            t: sp_lskip(line)
            if _sov_starts_with(t, "include ") is 1
                # no new pass is needed for this line itself; a pass only runs
                # again when a spliced line is itself an include
                spec: strip(cut(t, 8, length(t)))
                pname: spec
                from: 0
                nlin: 0
                dgh: 0
                pars: _sov_list_new()
                op: look(spec, "(")
                if op > 0 - 1
                    # values for a shared block: include inc/incNN.sov 4 3 (7 8 9)
                    pars: sg_toks(cut(spec, op + 1, length(spec) - 1))
                    spec: strip(cut(spec, 0, op))
                sp1: look(spec, " ")
                if sp1 > 0 - 1
                    pname: cut(spec, 0, sp1)
                    w2: strip(cut(spec, sp1 + 1, length(spec)))
                    sp2: look(w2, " ")
                    if sp2 > 0 - 1
                        from: num_of(cut(w2, 0, sp2))
                        rest2: strip(cut(w2, sp2 + 1, length(w2)))
                        sp3: look(rest2, " ")
                        if sp3 > 0 - 1
                            nlin: num_of(cut(rest2, 0, sp3))
                            dgs: strip(cut(rest2, sp3 + 1, length(rest2)))
                            if peek_byte(dgs, 0) is 35
                                dgh: num_of(cut(dgs, 1, length(dgs)))
                            if peek_byte(dgs, 0) is not 35
                                # older spans pin the hash bare, with no
                                # leading '#': an unchecked pin is how
                                # drifted spans spliced wrong lines silently
                                dgh: num_of(dgs)
                        if not
                            nlin: num_of(rest2)
                    if not
                        nlin: num_of(w2)
                cp1: pname
                cp2: join(b, pname)
                cp3: join("library/", pname)
                fl: 0
                mi: 0
                as long as mi < _sov_list_len(inc_mp)
                    mk: _sov_list_get(inc_mp, mi)
                    if _sov_str_eq(mk, cp1) is 1
                        fl: _sov_list_get(inc_mf, mi)
                    if _sov_str_eq(mk, cp2) is 1
                        fl: _sov_list_get(inc_mf, mi)
                    if _sov_str_eq(mk, cp3) is 1
                        fl: _sov_list_get(inc_mf, mi)
                    mi: mi + 1
                if fl is 0
                    f: load_file(cp1)
                    cp: cp1
                    if f is 0
                        f: load_file(cp2)
                        cp: cp2
                    if f is 0
                        f: load_file(cp3)
                        cp: cp3
                    if f is 0
                        print "Error: include not found:"
                        _sov_print(pname)
                        err_where()
                        had_err: 1
                        fail()
                    fl: lines_of_fast(f)
                    inc_mp: _sov_list_add(inc_mp, cp)
                    inc_mf: _sov_list_add(inc_mf, fl)
                ipc: 0
                as long as peek_byte(line, ipc) is 32
                    ipc: ipc + 1
                ip: cut(line, 0, ipc)
                j: 0
                m: _sov_list_len(fl)
                if nlin > 0
                    if from > 0
                        j: from - 1
                    m: j + nlin
                    if m > _sov_list_len(fl)
                        m: _sov_list_len(fl)
                sj: j
                sm: m
                as long as j < m
                    fj: _sov_list_get(fl, j)
                    fs: sp_lskip(fj)
                    if length(pars) > 0
                        if peek_byte(fs, 0) is not 0
                            fj: sg_psub(fj, pars)
                            fs: sp_lskip(fj)
                    if _sov_starts_with(fs, "include ") is 1
                        go: 1
                    if peek_byte(fs, 0) is not 0
                        if length(ip) > 0
                            fj: join(ip, fj)
                    acc_bytes: acc_bytes + length(fj)
                    if acc_bytes > 134217728
                        # nested indented includes can also blow up by
                        # line LENGTH (indent prefixes accrete per pass)
                        # while the line count stays small: bound bytes
                        print "Error: include expansion runaway (span includes itself?)"
                        _sov_print(pname)
                        err_where()
                        had_err: 1
                        fail()
                    acc: _sov_list_add(acc, fj)
                    if _sov_list_len(acc) > 1048576
                        # a span that includes its own include line
                        # multiplies the text every pass and eats all
                        # memory before the pass cap can speak: bound
                        # the expansion itself, mid-pass, and refuse
                        print "Error: include expansion runaway (span includes itself?)"
                        _sov_print(pname)
                        err_where()
                        had_err: 1
                        fail()
                    j: j + 1
                # pin protocol: a positive pin (with or without '#') is a
                # strict anchor; a negative pin is a tolerant drift-hint:
                # report the found hash (the 9901001 line tools/
                # lineage_repinline.py harvests) but only when it really
                # drifted, and at most twenty times a splice - the old
                # unconditional print made gigabyte logs on big splices
                if dgh > 0
                    if inc_span_hash(fl, sj, sm) is not dgh
                        print "Error: include drifted (edit above a span?):"
                        _sov_print(pname)
                        print from
                        print nlin
                        print inc_span_hash(fl, sj, sm)
                        err_where()
                        had_err: 1
                        fail()
                if dgh < 0
                    hh: inc_span_hash(fl, sj, sm)
                    if hh is not dgh
                        if inc_hint_n < 20
                            print 9901001
                            _sov_print(pname)
                            print from
                            print nlin
                            print hh
                            inc_hint_n: inc_hint_n + 1
            if not
                acc: _sov_list_add(acc, line)
            i: i + 1
        lst: acc
    total: 0
    i: 0
    n: _sov_list_len(lst)
    as long as i < n
        total: total + length(_sov_list_get(lst, i)) + 1
        i: i + 1
    buf: _sov_heap_alloc(total + 1)
    pos: 0
    i: 0
    as long as i < n
        ln: _sov_list_get(lst, i)
        k: 0
        lnlen: length(ln)
        as long as k < lnlen
            dset: _sov_set_byte(buf, pos, peek_byte(ln, k))
            pos: pos + 1
            k: k + 1
        dset: _sov_set_byte(buf, pos, 10)
        pos: pos + 1
        i: i + 1
    dset: _sov_set_byte(buf, pos, 0)
    return buf

# inc_span_hash — deterministic digest of an include span (raw lines a..b-1).
# Used by the "#<digest>" include form so an edit above any span fails the
# build loudly instead of silently splicing the wrong region.
inc_span_hash fl a b:
    h: 7
    i: a
    as long as i < b
        ln: _sov_list_get(fl, i)
        j: 0
        ih_ln: length(ln)
        as long as j < ih_ln
            h: bxor(h * 16777619, peek_byte(ln, j))
            j: j + 1
        i: i + 1
    return h

# dup_check_now — post-parse duplicate-name + arity rejection (see PS9).
# Runs after the deep-cache merge so `names`/`params` are the final lists.
dup_check_now:
    dn: _sov_list_len(names)
    dht: _sov_heap_alloc(16384 * 16)
    di: 0
    as long as di < 16384
        poke_i64(dht, di * 16, 0)
        di: di + 1
    di: 0
    as long as di < dn
        dnm: peek_i64(names, 16 + di * 8)
        dsl: band(nhash(dnm), 16383)
        dfound: 0
        dj: 0
        as long as dj < 16384
            dslot: peek_i64(dht, dsl * 16)
            if dslot is 0
                dj: 16384
            if dfound is 1
                dj: 16384
            if dslot is not 0
                if _sov_str_eq(dslot, dnm) is 1
                    dfound: 1
                if dfound is 0
                    dsl: dsl + 1
                if dsl is 16384
                    dsl: 0
                if dfound is 0
                    dj: dj + 1
        if dfound is 1
            print "Error: two with the same name"
            _sov_print(dnm)
            had_err: 1
        if dfound is 0
            poke_i64(dht, dsl * 16, dnm)
        di: di + 1
    dp2: _sov_list_len(params)
    di: 0
    as long as di < dp2
        dpl: peek_i64(params, 16 + di * 8)
        if _sov_list_len(dpl) > 7
            print "Error: too many parameters (7 max)"
            _sov_print(peek_i64(names, 16 + di * 8))
            had_err: 1
        di: di + 1
    return 0
