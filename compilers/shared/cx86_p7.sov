tparams line:
    lst: _sov_list_new()
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if _sov_starts_with(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            s: strip(cut(s, wp + 6, length(s)))
        if not
            sp: look(s, " ")
            if sp < 0
                return lst
            s: strip(cut(s, sp + 1, length(s)))
        p: repl(s, ",", " ")
        p: repl(p, " and ", " ")
        start: 0
        i: 0
        n: length(p)
        one: blank
        as long as i < n
            tp_c: peek_byte(p, i)
            tp_sp: 0
            if tp_c is 32
                tp_sp: 1
            if tp_sp is 1
                one: strip(cut(p, start, i))
            tp_ap: 0
            if tp_sp is 1
                tp_ap: 1
            if length(one) is 0
                tp_ap: 0
            if tp_ap is 1
                lst: _sov_list_add(lst, one)
            if tp_sp is 1
                start: i + 1
            i: i + 1
        one: strip(cut(p, start, n))
        if length(one) > 0
            lst: _sov_list_add(lst, one)
        return lst
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp < 0
        return lst
    p: repl(cut(rest, wp + 6, length(rest)), ",", " and ")
    start: 0
    i: 0
