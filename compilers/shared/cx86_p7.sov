tsc_ops: blank
tsc_opr: blank
sc_allowed kid:
    if kid is kid_opband
        return 1
    if kid is kid_opbor
        return 1
    if kid is kid_opbxor
        return 1
    if kid is kid_opbshl
        return 1
    if kid is kid_opbshr
        return 1
    if kid is kid_opbsar
        return 1
    if kid is kid_wrap_add
        return 1
    if kid is kid_wrap_sub
        return 1
    if kid is kid_wrap_mul
        return 1
    return 0
