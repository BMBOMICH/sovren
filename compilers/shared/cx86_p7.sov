    if kid is kid_opband
        return 1
    if kid is kid_opbor
        return 1
    if kid is kid_opbxor
        return 1
    if kid is kid_wrap_add
        return 1
    if kid is kid_wrap_mul
        return 1
    return 0
sc_balanced t lp:
    d: 0
    i: lp
    n: length(t)
    as long as i < n
        b: peek_byte(t, i)
        if b is 40
            d: d + 1
        if b is 41
