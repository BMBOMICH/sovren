# pad line: keeps the user first line off the last chunk line
# unsafe-module
sel_a: blank
sel_b: blank
sel_d: blank
sel_c: blank
sel_ka: 0
sel_kb: 0
sel_cc: 0
sel_axx: blank
sel_bxx: blank
sel_opl: 3
sf_ak: 0
sf_asl: 0
sf_anm: blank
sf_av: 0
sf_bk: 0
sf_bsl: 0
sf_bnm: blank
sf_bv: 0
sf_cc: 0
so_kind: 0
so_sl: 0
so_nm: blank
sf_dnm: blank
sf_dv: 0
sf_al3: 0
sf_aex: 0
try_scaled_mem name argc argl:
    nid: ik_cached(name)
    tvd: val_dead
    val_dead: 0
    if nid is kid_per
        if argc is 2
            q1: _sov_list_get(argl, 0)
            q2: _sov_list_get(argl, 1)
            if name_ok(q1) is 1
                qbs: reg_slot(q1)
                if qbs > 0 - 1
                    qk: raw_scaled(q2)
                    if qk > 0 - 1
                        cflush(q1)
                        emit_rax_scaled(qbs, qk / 4096, qk % 4096 - 128)
                        return 1
    if nid is kid_pkr
        if argc is 3
            q1: _sov_list_get(argl, 0)
            q2: _sov_list_get(argl, 1)
            q3: _sov_list_get(argl, 2)
            if name_ok(q1) is 1
                qbs: reg_slot(q1)
                if qbs > 0 - 1
                    if name_ok(q3) is 1
                        qv: reg_slot(q3)
                        if qv > 0 - 1
                            qk: raw_scaled(q2)
                            if qk > 0 - 1
                                cflush(q1)
                                cflush(q3)
                                emit_scaled_reg(qbs, qk / 4096, qv, qk % 4096 - 128)
                                return 1
                    qk2: raw_scaled(q2)
                    if qk2 > 0 - 1
                        mv2: mem_scaled(q3)
                        if mv2 > 0 - 1
                            mb2: mv2 / 65536
                            mq2: mv2 % 65536
                            cflush(q1)
                            emit_rax_scaled(mb2, mq2 / 4096, mq2 % 4096 - 128)
                            emit_store_scaled_rax(qbs, qk2 / 4096, qk2 % 4096 - 128)
                            return 1
                        ma2: memabs_scaled(q3)
                        if ma2 > 0 - 1
                            mb2: ma2 / 4294967296 - 1
                            mi2: ma2 % 4294967296
                            cflush(q1)
                            emit_rax_abs(mb2, mi2)
                            emit_store_scaled_rax(qbs, qk2 / 4096, qk2 % 4096 - 128)
                            return 1
                        if name_ok(q3) is 1
                            if reg_slot(q3) < 0
                                if lsh_find_s(q3) > 0 - 1
                                    cflush(q1)
                                    loadv(q3)
                                    emit_store_scaled_rax(qbs, qk2 / 4096, qk2 % 4096 - 128)
                                    return 1
                    if is_imm(q2) is 1
                        mi3: num_of(q2)
                        if mi3 > 0 - 1
                            if mi3 < 2147483648
                                if name_ok(q3) is 1
                                    qv3: reg_slot(q3)
                                    if qv3 > 0 - 1
                                        cflush(q1)
                                        cflush(q3)
                                        emit_store_abs(qbs, qv3, mi3)
                                        return 1
                                    if reg_slot(q3) < 0
                                        if lsh_find_s(q3) > 0 - 1
                                            cflush(q1)
                                            loadv(q3)
                                            emit_store_abs_rax(qbs, mi3)
                                            return 1
    if nid is kid_peek_i64
        if argc is 2
            a1: _sov_list_get(argl, 0)
            a2: _sov_list_get(argl, 1)
            if name_ok(a1) is 1
                hp: peek_home(a2)
                if is_imm(a2) is 1
                    mi4: num_of(a2)
                    if mi4 >= 0
                        if mi4 < 2147483648
                            loadv_rdi(a1)
                            chk_mem(8)
                            if mi4 < 128
                                emit(72)
                                emit(139)
                                emit(71)
                                emit(mi4)
                            if not
                                emit(72)
                                emit(139)
                                emit(135)
                                emit4(mi4)
                            return 1
                ii4: is_imm(a2)
                if ii4 is 0
                    sd: sc_disp(a2)
                    if sd >= 0
                        sx: sc_dx
                        loadv_rdi(a1)
                        chk_mem(8)
                        loadv_rsi(sx)
                            if sd < 128
                                emit(72)
                                emit(139)
                                emit(68)
                                emit(247)
                                emit(sd)
                            if not
                                emit(72)
                                emit(139)
                                emit(132)
                                emit(247)
                                emit4(sd)
                            return 1
                if hp > 0 - 1
                    loadv_rdi(a1)
                    chk_mem(8)
                    peek_rax_h(hp)
                    return 1
                if scaled_rsi(a2) is 1
                    loadv_rdi(a1)
                    chk_mem(8)
                    emit(72)
                    emit(139)
                    emit(4)
                    emit(247)
                    return 1
    if nid is kid_peek_byte
        if argc is 2
            a1: _sov_list_get(argl, 0)
            a2: _sov_list_get(argl, 1)
            if has_vm is 1
                if name_ok(a1) is 1
                    fbs: reg_slot(a1)
                    if fbs > 0 - 1
                        if name_ok(a2) is 1
                            fis: reg_slot(a2)
                            if fis > 0 - 1
                                cflush(a1)
                                cflush(a2)
                                emit_movzx_rax_bi(fbs, fis)
                                return 1
                        if is_imm(a2) is 1
                            fmi: num_of(a2)
                            if fmi >= 0
                                if fmi < 2147483648
                                    cflush(a1)
                                    frx: 64
                                    if fbs > 0
                                        frx: frx + 1
                                    if frx > 64
                                        emit(frx)
                                    emit(15)
                                    emit(182)
                                    if fmi is 0
                                        if fbs is not 2
                                            emit(fbs + 3)
                                            if fbs is 1
                                                emit(36)
                                            return 1
                                    if fmi < 128
                                        emit(64 + fbs + 3)
                                        if fbs is 1
                                            emit(36)
                                        emit(fmi)
                                        return 1
                                    emit(128 + fbs + 3)
                                    if fbs is 1
                                        emit(36)
                                    emit4(fmi)
                                    return 1
            if name_ok(a1) is 1
                if is_imm(a2) is 1
                    mi4: num_of(a2)
                    if mi4 >= 0
                        if mi4 < 2147483648
                            loadv_rdi(a1)
                            chk_mem(1)
                            if mi4 < 128
                                emit(15)
                                emit(182)
                                emit(71)
                                emit(mi4)
                            if not
                                emit(15)
                                emit(182)
                                emit(135)
                                emit4(mi4)
                            return 1
                if name_ok(a2) is 1
                    loadv_rdi(a1)
                    chk_mem(1)
                    loadv_rsi(a2)
                    emit(15)
                    emit(182)
                    emit(4)
                    emit(55)
                    return 1
    if nid is kid_poke_byte
        if argc is 3
            c1: _sov_list_get(argl, 0)
            c2: _sov_list_get(argl, 1)
            c3: _sov_list_get(argl, 2)
            if name_ok(c1) is 1
                if is_imm(c2) is 1
                    mj4: num_of(c2)
                    if mj4 >= 0
                        if mj4 < 2147483648
                            if is_imm(c3) is 1
                                v: num_of(c3) % 256
                                loadv_rdi(c1)
                                chk_mem(1)
                                if v is 0
                                    emit(198)
                                    if mj4 < 128
                                        emit(71)
                                        emit(mj4)
                                    if not
                                        emit(135)
                                        emit4(mj4)
                                    emit(0)
                                if v is not 0
                                    emit(176)
                                    emit(v)
                                    if mj4 < 128
                                        emit(136)
                                        emit(71)
                                        emit(mj4)
                                    if not
                                        emit(136)
                                        emit(135)
                                        emit4(mj4)
                                if tvd is 0
                                    mov_rax_rdi()
                                return 1
                            val_ok2: 0
                            if name_ok(c3) is 1
                                loadv(c3)
                                val_ok2: 1
                            if val_ok2 is 0
                                typ2: expr(c3)
                                val_ok2: 1
                            if val_ok2 is 1
                                push_rax()
                                loadv_rdi(c1)
                                chk_mem(1)
                                pop_rax()
                                if mj4 < 128
                                    emit(136)
                                    emit(71)
                                    emit(mj4)
                                if not
                                    emit(136)
                                    emit(135)
                                    emit4(mj4)
                                if tvd is 0
                                    mov_rax_rdi()
                                return 1
                if name_ok(c2) is 1
                    if name_ok(c3) is 1
                        loadv(c3)
                        push_rax()
                        loadv_rdi(c1)
                        chk_mem(1)
                        loadv_rsi(c2)
                        pop_rax()
                        emit(136)
                        emit(4)
                        emit(55)
                        if tvd is 0
                            mov_rax_rdi()
                        return 1
    if nid is kid_poke_i64
        if argc is 3
            b1: _sov_list_get(argl, 0)
            b2: _sov_list_get(argl, 1)
            b3: _sov_list_get(argl, 2)
            if name_ok(b1) is 1
                if scaled_shape(b2) is 1
                    if has_vm is 1
                        if pkacc(b1, b2, b3) is 1
                            if pure_mul_term(pk_t) is 1
                                loadv_rdi(b1)
                                hp: peek_home(b2)
                                if hp > 0 - 1
                                    expr(pk_t)
                                    accadd_rax_h(hp)
                                    if tvd is 0
                                        mov_rax_rdi()
                                    return 1
                                if scaled_rsi(b2) is 1
                                    expr(pk_t)
                                    emit(72)
                                    emit(1)
                                    emit(4)
                                    emit(247)
                                    if tvd is 0
                                        mov_rax_rdi()
                                    return 1
                            expr(pk_t)
                            mov_rcx_rax()
                            loadv_rdi(b1)
                            hp: peek_home(b2)
                            if hp > 0 - 1
                                accadd_rcx_h(hp)
                                if tvd is 0
                                    mov_rax_rdi()
                                return 1
                            if scaled_rsi(b2) is 1
                                emit(72)
                                emit(1)
                                emit(12)
                                emit(247)
                                if tvd is 0
                                    mov_rax_rdi()
                                return 1
                    val_ok: 0
                    if name_ok(b3) is 1
                        if is_imm(b3) is 0
                            loadv(b3)
                            val_ok: 1
                    if is_imm(b3) is 1
                        rax_imm(num_of(b3))
                        val_ok: 1
                    if val_ok is 0
                        typ: expr(b3)
                        val_ok: 1
                    if val_ok is 1
                        push_rax()
                        loadv_rdi(b1)
                        hp: peek_home(b2)
                        if hp > 0 - 1
                            pop_rax()
                            emit(72)
                            emit(137)
                            emit(194)
                            chk_mem(8)
                            store_rdx_h(hp)
                            if tvd is 0
                                mov_rax_rdi()
                            return 1
                        if scaled_rsi(b2) is 1
                            pop_rax()
                            emit(72)
                            emit(137)
                            emit(194)
                            chk_mem(8)
                            emit(72)
                            emit(137)
                            emit(20)
                            emit(247)
                            if tvd is 0
                                mov_rax_rdi()
                            return 1
                        pop_rax()
sel_ccb cc:
    if cc is 0
        return 76
    if cc is 1
        return 79
    if cc is 2
        return 78
    if cc is 3
        return 77
    if cc is 4
        return 68
    return 69
sel_ccswap cc:
    if cc is 0
        return 1
    if cc is 1
        return 0
    if cc is 2
        return 3
    if cc is 3
        return 2
    return cc
# classify a plain variable for the branchless select fast path:
# 0 = register home (so_sl holds the bin_rslot), 1 = frame slot, 2 = rip global
sel_oper name:
    so_nm: name
    b: bin_rslot(name)
    if b > 0 - 1
        so_sl: b
        return 0
    l: lsh_find_s(name)
    if l > 0 - 1
        so_sl: l
        return 1
    if is_rel() is 1
        if gn_lookup(name) > 0 - 1
            return 2
    return 0 - 1
sel_lo3 sl:
    return (sl + 3) % 8
# emit cmp a, b from the sf_ fields (a is never an immediate here; sel_fast
# swaps the operands and the condition when it is).  kinds: 0 reg, 1 frame,
# 2 rip global, 3 immediate.
sel_emit_cmp:
    if sf_ak is 0
        al: sf_al3
        if sf_bk is 0
            rx: 72 + sf_aex
            if sf_bsl > 0
                rx: rx + 4
            emit3(rx, 57, 192 + sel_lo3(sf_bsl) * 8 + al)
            return 0
        if sf_bk is 3
            rx2: 72 + sf_aex
            emit(rx2)
            if sf_bv > 0 - 129
                if sf_bv < 128
                    emit2(131, 248 + al)
                    emit(band(sf_bv, 255))
                    return 0
            emit2(129, 248 + al)
            emit4(sf_bv)
            return 0
        rx3: 72 + sf_aex * 4
        emit2(rx3, 59)
        if sf_bk is 1
            emit(128 + al * 8 + 5)
            emit4(loc_off(sf_bsl))
            return 0
        emit(al * 8 + 5)
        ba: here()
        emit4(0)
        addp(ba, "grel", sf_bnm)
        return 0
    if sf_bk is 0
        bl: sel_lo3(sf_bsl)
        rx4: 72
        if sf_bsl > 0
            rx4: rx4 + 4
        emit2(rx4, 57)
        if sf_ak is 1
            emit(128 + bl * 8 + 5)
            emit4(loc_off(sf_asl))
            return 0
        emit(bl * 8 + 5)
        aa: here()
        emit4(0)
        addp(aa, "grel", sf_anm)
        return 0
    # memory a against an immediate b
    emit(72)
    sm: 0
    if sf_bv > 0 - 129
        if sf_bv < 128
            sm: 1
    if sm is 1
        emit(131)
    if not
        emit(129)
    if sf_ak is 1
        emit(189)
        emit4(loc_off(sf_asl))
    if not
        emit(61)
        ga: here()
        emit4(0)
        addp(ga, "grel", sf_anm)
    if sm is 1
        emit(band(sf_bv, 255))
    if not
        emit4(sf_bv)
    return 0
# branchless select fast path: `if a <op> b` + one body line `c: d` where c is
# register-homed and a/b/d are each a register home, a frame slot, a global,
# or an integer immediate.  Emits compare + cmov directly on the homes, with
# no staging through rax/rdi/rsi/rdx and no store round-trip.  All legality
# is decided before the first byte is emitted.
sel_fast:
    ck: sel_oper(sel_c)
    if ck < 0
        return 0
    csl: so_sl
    sf_cc: sel_cc
    if sel_ka is 2
        sf_ak: 3
        sf_av: num_of(sel_a)
        sf_anm: blank
    if not
        sf_ak: sel_oper(sel_a)
        if sf_ak < 0
            return 0
        sf_asl: so_sl
        sf_anm: sel_a
    if sel_kb is 2
        sf_bk: 3
        sf_bv: num_of(sel_b)
        sf_bnm: blank
    if not
        sf_bk: sel_oper(sel_b)
        if sf_bk < 0
            return 0
        sf_bsl: so_sl
        sf_bnm: sel_b
    if sf_ak is 3
        if sf_bk is 3
            return 0
        tk: sf_ak
        sf_ak: sf_bk
        sf_bk: tk
        tsl: sf_asl
        sf_asl: sf_bsl
        sf_bsl: tsl
        tnm: sf_anm
        sf_anm: sf_bnm
        sf_bnm: tnm
        tvv: sf_av
        sf_av: sf_bv
        sf_bv: tvv
        sf_cc: sel_ccswap(sf_cc)
    sf_al3: sel_lo3(sf_asl)
    sf_aex: 0
    if sf_ak is 0
        if sf_asl > 0
            sf_aex: 1
    arcx: 0
    if sf_ak > 0
        if sf_bk is 1
            arcx: 1
        if sf_bk is 2
            arcx: 1
    dk: 0
    dsl: 0
    dv: 0
    if sf_dv is 2
        dk: 3
        dv: num_of(sf_dnm)
    if not
        dk: sel_oper(sf_dnm)
        if dk < 0
            return 0
        dsl: so_sl
    if sel_ka is 0
        cflush(sel_a)
    if sel_kb is 0
        cflush(sel_b)
    if sf_dv is 0
        cflush(sf_dnm)
    cflush(sel_c)
    cl: sel_lo3(csl)
    cex: 0
    if ck is 0
        if csl > 0
            cex: 4
    if not
        cl: 2
    if dk is 3
        rax_imm(dv)
    if ck is 1
        emit3(72, 139, 149)
        emit4(loc_off(csl))
    if ck is 2
        emit3(72, 139, 21)
        ca: here()
        emit4(0)
        addp(ca, "grel", sel_c)
    if arcx is 1
        if sf_ak is 1
            emit3(72, 139, 141)
            emit4(loc_off(sf_asl))
        if not
            emit3(72, 139, 13)
            gca: here()
            emit4(0)
            addp(gca, "grel", sf_anm)
        sf_ak: 0
        sf_al3: 1
        sf_aex: 0
    sel_emit_cmp()
    ccb: sel_ccb(sf_cc)
    if dk is 3
        rx: 72 + cex
        emit3(rx, 15, ccb)
        emit(192 + cl * 8)
    if dk is 0
        rx2: 72 + cex
        if dsl > 0
            rx2: rx2 + 1
        emit3(rx2, 15, ccb)
        emit(192 + cl * 8 + sel_lo3(dsl))
    if dk is 1
        rx3: 72 + cex
        emit3(rx3, 15, ccb)
        emit(128 + cl * 8 + 5)
        emit4(loc_off(dsl))
    if dk is 2
        rx4: 72 + cex
        emit3(rx4, 15, ccb)
        emit(cl * 8 + 5)
        da: here()
        emit4(0)
        addp(da, "grel", sf_dnm)
    if ck is 1
        emit3(72, 137, 149)
        emit4(loc_off(csl))
    if ck is 2
        emit3(72, 137, 21)
        cb: here()
        emit4(0)
        addp(cb, "grel", sel_c)
    return 1
try_sel_if cond lines li ind:
    nx: li + 1
    if nx > _sov_list_len(lines) - 1
        return 0
    r1: _sov_list_get(lines, nx)
    t1: strip(r1)
    if length(t1) is 0
        return 0
    if peek_byte(t1, 0) is 35
        return 0
    bi1: nind(r1)
    if bi1 < ind + 1
        return 0
    n2: li + 2
    if n2 < _sov_list_len(lines)
        r2: _sov_list_get(lines, n2)
        t2: strip(r2)
        if length(t2) > 0
            if peek_byte(t2, 0) is not 35
                if nind(r2) > ind
                    return 0
                if nind(r2) is ind
                    if word_id(t2) is kid_if
                        if length(t2) is 6
                            return 0
                        if word_id(strip(cut(t2, 3, length(t2)))) is kid_not
                            return 0
    tc: look(t1, ": ")
    if tc < 0
        return 0
    sel_c: strip(cut(t1, 0, tc))
    sel_d: strip(cut(t1, tc + 2, length(t1)))
    if plain_name(sel_c) is 0
        return 0
    sel_dn2: sel_d
    sel_di: 0
    sel_dv: 0
    if plain_name(sel_d) is 0
        if is_imm(sel_d) is 1
            if cfind1(sel_d, 46) < 0
                sel_dv: 2
        if sel_dv is 0
            pd: look(sel_d, " + ")
            pds: 1
            if pd < 0
                pd: look(sel_d, " - ")
                pds: 0 - 1
            if pd < 0
                return 0
            dn2: strip(cut(sel_d, 0, pd))
            di2: strip(cut(sel_d, pd + 3, length(sel_d)))
            if plain_name(dn2) is 0
                return 0
            if is_imm(di2) is 0
                return 0
            if num_of(di2) > 127
                return 0
            sel_dn2: dn2
            sel_di: num_of(di2)
            sel_dv: pds
    if is_imm(sel_dn2) is 1
        if sel_dv is not 2
            return 0
    c0: strip(cond)
    sel_cc: 0
    sel_opl: 3
    ps: look(c0, " < ")
    if ps < 0
        ps: look(c0, " > ")
        sel_cc: 1
    if ps < 0
        ps: look(c0, " <= ")
        sel_cc: 2
        sel_opl: 4
    if ps < 0
        ps: look(c0, " >= ")
        sel_cc: 3
        sel_opl: 4
    if ps < 0
        return 0
    av: strip(cut(c0, 0, ps))
    bv: strip(cut(c0, ps + sel_opl, length(c0)))
    ka: sel_val(av)
    if ka < 0
        if is_imm(av) is 1
            if cfind1(av, 46) < 0
                ka: 2
    if ka < 0
        return 0
    sel_ka: ka
    if ka is 1
        sel_a: pk_g
        sel_axx: pk_x
    if ka is 0
        sel_a: av
    if ka is 2
        sel_a: av
    kb: sel_val(bv)
    if kb < 0
        if is_imm(bv) is 1
            if cfind1(bv, 46) < 0
                kb: 2
    if kb < 0
        return 0
    sel_kb: kb
    if kb is 1
        sel_b: pk_g
        sel_bxx: pk_x
    if kb is 0
        sel_b: bv
    if kb is 2
        sel_b: bv
    twin: 0
    if sel_ka is 1
        if sel_kb is 1
            if _sov_str_eq(sel_a, sel_b) is 1
                if twin_idx(sel_axx, sel_bxx) is 1
                    twin: 1
    sf_dnm: sel_dn2
    sf_dv: sel_dv
    sf_try: 0
    if sel_dv is 0
        sf_try: 1
    if sel_dv is 2
        sf_try: 1
    if twin is 0
        if sf_try is 1
            if sel_ka is not 1
                if sel_kb is not 1
                    if sel_fast() is 1
                        return 1
    if sel_cc > 1
        return 0
    if sel_ka is 2
        return 0
    if sel_kb is 2
        return 0
    if sel_dv is 2
        return 0
    rt: 0
    rbs: 0 - 1
    rxs: 0 - 1
    if twin is 1
        if sel_dv is not 0
            if _sov_str_eq(sel_c, tw_x) is 1
                if _sov_str_eq(sel_dn2, tw_x) is 1
                    rbs: reg_slot(sel_a)
                    rxs: reg_slot(tw_x)
                    if rbs > 0 - 1
                        if rxs > 0 - 1
                            rt: 1
    if rt is 1
        cflush_all()
        emit_mov_rcx_scaled(rbs, rxs, 0)
        emit_cmp_rcx_scaled(rbs, rxs, 8)
        if sel_dv is 1
            emit_lea_rdi_xs(rxs, sel_di)
        if sel_dv is 0 - 1
            emit_lea_rdi_xs(rxs, 0 - sel_di)
        emit_cmov_x_rdi(76 + sel_cc * 3, rxs)
