oc_n: 0
oc_cap: 0
ocgrow:
    # `oc` itself is already declared by the kits' 0: global list; do not
    # re-declare it here (that is a duplicate top-level definition).
    # the code buffer is a raw arena: emit() stores one byte and bumps oc_n.
    # (Was: a list with one eight-byte slot per emitted byte, two calls per
    # byte.  Same byte sequence out, ~1/4 the memory traffic, no calls.)
    n: 1048576
    if oc_cap > 0 -> n: oc_cap * 2
    nb: _sov_heap_alloc(n)
    k: 0
    as long as k + 8 <= oc_n -> dummy: poke_i64(nb, k, peek_i64(oc, k))
        k: k + 8
    as long as k < oc_n -> dummy: poke_byte(nb, k, peek_byte(oc, k))
        k: k + 1
    oc: nb ;; oc_cap: n
ocd: 0
ocput2 a v:
    # receiver for the source's per-line map form (`ocd: ocput2:` + block)
    ocput(v)
    return 0
ocget i:
    # the old list_get answered 0 outside the buffer; keep that (a raw peek
    # would return whatever memory happens to be there)
    if i < 0 -> return 0
    if i >= oc_n -> return 0
    return peek_byte(oc, i)
ocset i v:
    # the old list_set dropped out-of-range stores; the branch patcher really
    # does hand `put` stale positions, and a raw poke would write outside the
    # arena (measured: at = 0x158d4000 with 230 bytes of code)
    if i > 0 - 1 -> if i < oc_n
            poke_byte(oc, i, band(v, 255))
oc_here a:
    # px01:116 builds `here()` as `%2(%3)`; %3 stays `oc` so the template line
    # still parses, %2 is this one-line shim for the arena length.
    return oc_n
ocput v:
    if oc_n >= oc_cap -> ocgrow()
    poke_byte(oc, oc_n, band(v, 255))
    oc_n: oc_n + 1
oc_from_list l:
    # the dce filters rebuild the buffer as a list of kept bytes; this copies
    # that list back into the arena (same bytes, in order).
    oc_n: 0
    oi: 0
    as long as oi < _sov_list_len(l) -> ocput(_sov_list_get(l, oi))
        oi: oi + 1
