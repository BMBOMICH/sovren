# One pass over the flat line buffer; emits 16-byte records:
#   [0] absolute offset into flat buffer
#   [8] len * 256 + kind   (kind: 1 name, 2 number, 3 string, 5 symbol)
# Comments (#-to-EOL) end a line's tokens.  Records never copy text.
tk_buf: 0
tk_dump: 0
tk_run: 0
tk_vfy: 0
tk_cap: 0
tk_n: 0
tk_lin: 0

tk_grow:
    ddd: 0
    if tk_cap is 0
        tk_cap: 262144
        tk_buf: _sov_heap_alloc(tk_cap * 16)
    if tk_n + 4096 > tk_cap
        nc: tk_cap * 2
        nb: _sov_heap_alloc(nc * 16)
        ddd: _sov_mem_copy(nb, tk_buf, tk_n * 16)
        ddd: _sov_free(tk_buf)
        tk_buf: nb
        tk_cap: nc
    return 0

tk_push off ln kd:
    dummy: tk_grow()
    poke_i64(tk_buf, tk_n * 16, off)
    poke_i64(tk_buf, tk_n * 16 + 8, ln * 256 + kd)
    tk_n: tk_n + 1
    return 0

tk_is_name b:
    if b >= 97
        if b <= 122
            return 1
    if b >= 65
        if b <= 90
            return 1
    if b is 95
        return 1
    if b is 46
        return 2
    if b >= 48
        if b <= 57
            return 3
    return 0

tk_lsa: 0
tk_lct: 0
tk_lin0: 0
tk_lfl: 0

tk_lex lines:
    tk_n: 0
    nl: _sov_list_len(lines)
    if tk_lsa is 0
        tk_lsa: _sov_heap_alloc(16 + 131072 * 8)
        tk_lct: _sov_heap_alloc(16 + 131072 * 8)
        tk_lin0: _sov_heap_alloc(16 + 131072 * 8)
        tk_lfl: _sov_heap_alloc(16 + 131072 * 8)
    li: 0
    as long as li < nl
        lp: peek_i64(lines, 16 + li * 8)
        if li < 131072
            poke_i64(tk_lsa, 16 + li * 8, tk_n)
        i: 0
        go: 1
        as long as go is 1
            b: peek_byte(lp, i)
            if b is 0
                go: 0
            if b is 10
                go: 0
            if go is 1
                if b is 32
                    i: i + 1
                if not
                    if b is 9
                        i: i + 1
                    if not
                        if b is 35
                            go: 0
                        if not
                            if b is 34
                                j: i + 1
                                gq: 1
                                as long as gq is 1
                                    c9: peek_byte(lp, j)
                                    if c9 is 0
                                        gq: 0
                                    if c9 is 10
                                        gq: 0
                                    if c9 is 92
                                        j: j + 1
                                    if not
                                        if c9 is 34
                                            gq: 0
                                    if gq is 1
                                        j: j + 1
                                tk_push(lp + i, j - i + 1, 3)
                                i: j + 1
                            if not
                                kd: tk_is_name(b)
                                if kd is 3
                                    st0: i
                                    gn2: 1
                                    as long as gn2 is 1
                                        k8: tk_is_name(peek_byte(lp, i))
                                        if k8 is 3
                                            i: i + 1
                                        if not
                                            gn2: 0
                                    tk_push(lp + st0, i - st0, 2)
                                if kd is 1
                                    st0: i
                                    gn2: 1
                                    as long as gn2 is 1
                                        c8: peek_byte(lp, i)
                                        k8: tk_is_name(c8)
                                        if k8 >= 1
                                            if k8 <= 3
                                                i: i + 1
                                            if not
                                                gn2: 0
                                        if not
                                            gn2: 0
                                    tk_push(lp + st0, i - st0, 1)
                                if kd is 2
                                    tk_push(lp + i, 1, 5)
                                    i: i + 1
                                if kd is 0
                                    tk_push(lp + i, 1, 5)
                                    i: i + 1
        if li < 131072
            poke_i64(tk_lct, 16 + li * 8, tk_n - peek_i64(tk_lsa, 16 + li * 8))
            if tk_n - peek_i64(tk_lsa, 16 + li * 8) > 0
                poke_i64(tk_lin0, 16 + li * 8, peek_i64(tk_buf, peek_i64(tk_lsa, 16 + li * 8) * 16) - lp)
            if not
                poke_i64(tk_lin0, 16 + li * 8, 0 - 1)
            fl0: 0
            if peek_byte(lp, 0) is 9
                fl0: 1
            if peek_byte(lp, 0) is 32
                fsp: 0
                as long as peek_byte(lp, fsp) is 32
                    fsp: fsp + 1
                if peek_byte(lp, fsp) is 9
                    fl0: 1
            rn9: 0
            ln8: 0
            as long as peek_byte(lp, ln8) > 0
                ln8: ln8 + 1
            if ln8 > 0
                tw9: ln8 - 1
                as long as tw9 >= 0
                    tb9: peek_byte(lp, tw9)
                    if tb9 < 33
                        rn9: rn9 + 1
                        tw9: tw9 - 1
                    if not
                        tw9: 0 - 1
            if rn9 > 0
                fl0: fl0 + 2
            poke_i64(tk_lfl, 16 + li * 8, fl0)
        li: li + 1
    tk_lin: nl
    return tk_n

