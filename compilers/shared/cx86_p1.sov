emit_divmod_imm v ismod:
    # rax = n / v (ismod 0) or n % v (ismod 1) for table divisor v, n in
    # rax.  push n; rcx = M; imul rcx leaves the signed high half in rdx;
    # pop rcx restores n for the add variant / sign fix / remainder.
    emit(80)
    emit2(72, 185)
    emit8(dm_m)
    emit3(72, 247, 233)
    emit(89)
    if dm_a is 1
        emit3(72, 1, 202)
    if dm_s > 0
        emit3(72, 193, 250)
        emit(dm_s)
    emit3(72, 137, 200)
    emit3(72, 193, 232)
    emit(63)
    emit3(72, 1, 208)
    if ismod is 1
        emit3(72, 105, 192)
        emit4(v)
        emit3(72, 41, 193)
        emit3(72, 137, 200)
    return 0

arith_imm op v:
    if v >= 2147483648
        return 0 - 1
    if v < 0 - 2147483648
        return 0 - 1
    oid: intern_kid(op)
    mo: 0
    if oid is kid_opmul
        mo: 1
    if oid is kid_opwmul
        mo: 1
    # lea/shl multiply forms don't set OF the way imul does, so they are
    # only legal where no overflow trap can be emitted after them:
    # runtime-providing programs, --unsafe, or wrap_mul.
    leaok: 0
    if has_vm is 1
        leaok: 1
    if opt_nochk is 1
        leaok: 1
    if oid is kid_opwmul
        leaok: 1
    if oid is kid_opbshl
        emit3(72, 193, 224)
        emit(v % 256)
        return 0
    if oid is kid_opbshr
        emit3(72, 193, 232)
        emit(v % 256)
        return 0
    if oid is kid_opbsar
        emit3(72, 193, 248)
        emit(v % 256)
        return 0
    if oid is kid_opband
        emit2(72, 37)
        emit4(v)
        return 0
    if oid is kid_opbor
        emit2(72, 13)
        emit4(v)
        return 0
    if oid is kid_opbxor
        emit2(72, 53)
        emit4(v)
        return 0
    if oid is kid_opdiv
        if v is 1
            return 0
        if v < 2
            return 0 - 1
        k: 0
        q: v
        pw: 1
        as long as q > 1
            if q % 2 is 1
                pw: 0
                q: 1
            if not
                q: q / 2
                k: k + 1
        if pw is 1
            emit3(72, 137, 194)
            emit3(72, 193, 250)
            emit3(63, 72, 193)
            emit(234)
            emit(64 - k)
            emit3(72, 1, 208)
            emit3(72, 193, 248)
            emit(k)
            return 0
        if div_magic(v) is 1
            return emit_divmod_imm(v, 0)
        return 0 - 1
    if oid is kid_opmod
        if v is 1
            emit2(49, 192)
            return 0
        if v < 2
            return 0 - 1
        k: 0
        q: v
        pw: 1
        as long as q > 1
            if q % 2 is 1
                pw: 0
                q: 1
            if not
                q: q / 2
                k: k + 1
        if pw is 1
            emit3(72, 137, 194)
            emit3(72, 193, 250)
            emit(63)
            emit3(72, 193, 234)
            emit(64 - k)
            emit3(72, 1, 208)
            emit2(72, 37)
            emit4(v - 1)
            emit3(72, 41, 208)
            return 0
        if div_magic(v) is 1
            return emit_divmod_imm(v, 1)
        return 0 - 1
    if mo is 1
        if v is 2
            emit3(72, 1, 192)
            return 0
        if leaok is 1
            if v is 3
                emit3(72, 141, 4)
                emit(64)
                return 0
            if v is 5
                emit3(72, 141, 4)
                emit(128)
                return 0
            if v is 9
                emit3(72, 141, 4)
                emit(192)
                return 0
            if v is 4
                emit3(72, 193, 224)
                emit(2)
                return 0
            if v is 8
                emit3(72, 193, 224)
                emit(3)
                return 0
            if v is 16
                emit3(72, 193, 224)
                emit(4)
                return 0
            if v is 32
                emit3(72, 193, 224)
                emit(5)
                return 0
    if v >= 0 - 128
        if v < 128
            if oid is kid_opadd
                emit3(72, 131, 192)
                emit(v % 256)
            if oid is kid_opsub
                emit3(72, 131, 232)
                emit(v % 256)
            if mo is 1
                emit3(72, 107, 192)
                emit(v % 256)
            return 0
    if oid is kid_opadd
        emit2(72, 5)
        emit4(v)
    if oid is kid_opsub
        emit2(72, 45)
        emit4(v)
    if mo is 1
        emit3(72, 105, 192)
        emit4(v)
bin_regop_k oid sl:
    if oid is kid_opadd
        add_rax_reg(sl)
        chk_ov()
        return 0
    if oid is kid_opsub
        sub_rax_reg(sl)
        chk_ov()
        return 0
    if oid is kid_opmul
        imul_rax_reg(sl)
        chk_ov()
        return 0
    if oid is kid_opdiv
        chk_zreg(sl)
        chk_div_overflow(sl)
        emit2(72, 153)
        idiv_reg(sl)
        return 0
    if oid is kid_opmod
        chk_zreg(sl)
        chk_div_overflow(sl)
        emit2(72, 153)
        idiv_reg(sl)
        emit2(72, 146)
        return 0
    if oid is kid_opband
        and_rax_reg(sl)
        return 0
    if oid is kid_opbor
        or_rax_reg(sl)
        return 0
    if oid is kid_opbxor
        xor_rax_reg(sl)
        return 0
    if oid is kid_opbshl
        mov_rcx_reg(sl)
        emit3(72, 211, 224)
        return 0
    if oid is kid_opbshr
        mov_rcx_reg(sl)
        emit3(72, 211, 232)
        return 0
    if oid is kid_opbsar
        mov_rcx_reg(sl)
        emit3(72, 211, 248)
        return 0
    if oid is kid_opwadd
        add_rax_reg(sl)
