# --- f64 soft-float mirrors on SSE2 scalar ops.  Hardware addsd/subsd/
# mulsd/divsd/sqrtsd are correctly rounded (round-to-nearest-even), exactly
# the library's contract, so finite results are bit-identical.  What does
# NOT match by default is NaN production: the library returns a NaN input
# unchanged (x first, then y) and the pattern 0x7FF0000000000001 for
# generated NaNs (inf-inf, 0*inf, 0/0, inf/inf), while the hardware quiets
# sNaNs and returns the sign-set indefinite QNaN.  The canonicalizer below
# restores the library's exact bit patterns.  NaN test in the integer
# domain: (v + v) unsigned-greater than 0xFFE0000000000000, i.e.
# rdx=0xFFE0.. >= rcx=(v+v) means NOT NaN.  Args arrive as i64 bit patterns
# in rdi/rsi, result leaves in rax, rcx/rdx/xmm0/xmm1 clobbered.
emit_nt_f64bin op neg:
    emit3(102, 72, 15)
    emit(110)
    emit(199)
    emit3(102, 72, 15)
    emit(110)
    emit(206)
    if neg is 1
        rcx_imm(0 - 9223372036854775807 - 1)
        emit3(72, 49, 206)
    emit(242)
    emit(15)
    if op is 0
        emit(88)
    if op is 1
        emit(92)
    if op is 2
        emit(89)
    if op is 3
        emit(94)
    emit(193)
    emit3(102, 72, 15)
    emit(126)
    emit(192)
    emit_f64_canon()
    leave()
    ret()
    return 1

emit_f64_canon:
    # post-op NaN canonicalizer shared by the body plants and the call_args
    # fast paths (which historically skipped it, so Linux returned the
    # hardware indefinite QNaN where the library spec -- and every other
    # backend -- returns a NaN input unchanged (x first, then y; for sub
    # the caller pre-flips rsi's sign) or 0x7FF0000000000001 when the NaN is
    # generated.  In: rax=result bits, xmm0=result, rdi=x, rsi=y.
    # Fast path is comisd+jnp on the FP result itself (3 uops, perfectly
    # predicted); the integer-domain selection below runs only for NaN.
    # Clobbers rcx/rdx.
    emit3(102, 15, 47)
    emit(192)
    f6ok: jnp()
    emit_f64_canon_slow()
    patch(f6ok)
    return 1

emit_f64_canon_slow:
    # NaN-result selection in the integer domain: rdi=x bits, rsi=y bits
    # (for sub the caller pre-flips rsi's sign).  Returns x if x is NaN,
    # else y if y is NaN, else the generated-NaN pattern, in rax.
    # Clobbers rcx/rdx.
    emit(72)
    emit(186)
    emit8(0 - 9007199254740992)
    emit3(72, 137, 249)
    emit3(72, 1, 201)
    emit3(72, 57, 202)
    f6n1: jae()
    emit3(72, 137, 248)
    f6e1: jmp()
    patch(f6n1)
    emit3(72, 137, 241)
    emit3(72, 1, 201)
    emit3(72, 57, 202)
    f6n2: jae()
    emit3(72, 137, 240)
    f6e2: jmp()
    patch(f6n2)
    rax_imm(9218868437227405313)
    patch(f6e1)
    patch(f6e2)
    return 1

emit_f64_canon1:
    # sqrt form: rax=sqrtsd result bits, xmm0=result, rdi=x.  NaN result
    # with NaN x -> x unchanged; NaN result from x<0 -> F64_QNAN.
    # Clobbers rcx/rdx.
    emit3(102, 15, 47)
    emit(192)
    f6q0: jnp()
    emit_f64_canon1_slow()
    patch(f6q0)
    return 1

emit_f64_canon1_slow:
    # NaN sqrt result: rdi=x bits.  rax = x if x is NaN else F64_QNAN.
    # Clobbers rcx/rdx.
    emit(72)
    emit(186)
    emit8(0 - 9007199254740992)
    emit3(72, 137, 249)
    emit3(72, 1, 201)
    emit3(72, 57, 202)
    f6q1: jae()
    emit3(72, 137, 248)
    f6q2: jmp()
    patch(f6q1)
    rax_imm(9221120237041090560)
    patch(f6q2)
    return 1

emit_nt_f64add:
    return emit_nt_f64bin(0, 0)
emit_nt_f64sub:
    return emit_nt_f64bin(1, 1)
emit_nt_f64mul:
    return emit_nt_f64bin(2, 0)
emit_nt_f64div:
    return emit_nt_f64bin(3, 0)
emit_nt_f64sqrt:
    emit3(102, 72, 15)
    emit(110)
    emit(199)
    emit3(242, 15, 81)
    emit(192)
    emit3(102, 72, 15)
    emit(126)
    emit(192)
    emit_f64_canon1()
    leave()
    ret()
    return 1

