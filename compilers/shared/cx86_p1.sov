emit_nt_strcat:
    # lengths via _sov_strlen (SWAR): the old byte-scan heads cost ~2-3
    # cycles per byte on each operand, which dominated every big concat
    # (16 MB doubling chain: ~19 ms of pure strlen).  Copies already rep
    # movsb below.  _sov_strlen's s < 4096 -> 0 rule preserves the old
    # null/small-pointer behavior exactly.
    emit:
        73 137 250 73 137 243 77 49 192 73 129 250 0 16 0 0 114 16 65 82 65 83
    calln("_sov_strlen")
    emit:
        65 91 65 90 73 137 192 77 49 201 73 129 251 0 16 0 0 114 27 76 137 223 65 80 65 81 65 82 65 83
    calln("_sov_strlen")
    emit:
        65 91 65 90 65 89 65 88 73 137 193 75 141 124 8 1 65
        80 65 81 65 82 65 83
    prof_emit("prof_bytes_copied", 8)
    prof_emit("prof_bytes_copied", 9)
    calln("_sov_heap_alloc")
    emit:
        65 91 65 90 65 89 65 88 72 137 194 77 133 192 116 11
        72 137 215 76 137 214 76 137 193 243 164 77 133 201 116 12
        74 141 60 2 76 137 222 76 137 201 243 164 77 1 200 66
        198 4 2 0 72 137 208
    leave()
    ret()
    return 1

intern_ensure:
    if intern_ht > 0
        return 0
    intern_ht: _sov_heap_alloc(8388608)
    dummy: poke_i64(intern_ht, 0, 0)
    sl: 0
    if strb > 0
        sl: peek_i64(strb, 8)
    nb: _sov_heap_alloc(16 + 65536)
    dummy: poke_i64(nb, 0, 65536)
    dummy: poke_i64(nb, 8, sl)
    if sl > 0
        si: 0
        as long as si + 8 <= sl
            dummy: poke_i64(nb, 16 + si, peek_i64(strb, 16 + si))
            si: si + 8
        as long as si < sl
            dummy: poke_byte(nb, 16 + si, peek_byte(strb, 16 + si))
            si: si + 1
    strb: nb
    return 0
intern_fast_do s:
    if intern_ht = 0
        intern_ensure()
    h: 5381
    k: 0
    go: 1
    ue: 0
    as long as go is 1
        # Unaligned qwords must not cross a page boundary: the source's
        # NUL may be the final readable byte immediately before a guard.
        # The existing byte tail handles the short boundary fragment.
        q: 0
        if band(s + k, 4095) < 4089
            q: peek_i64(s, k)
        z: band(band(q - 72340172838076673, bxor(q, 0 - 1)), -9187201950435737472)
        if z = 0
            c: band(q, 255)
            if c is 92 -> ue: 1
            h: h * 33 + c
            c: band(bshr(q, 8), 255)
            if c is 92 -> ue: 1
            h: h * 33 + c
            c: band(bshr(q, 16), 255)
            if c is 92 -> ue: 1
            h: h * 33 + c
            c: band(bshr(q, 24), 255)
            if c is 92 -> ue: 1
            h: h * 33 + c
            c: band(bshr(q, 32), 255)
            if c is 92 -> ue: 1
            h: h * 33 + c
            c: band(bshr(q, 40), 255)
            if c is 92 -> ue: 1
            h: h * 33 + c
            c: band(bshr(q, 48), 255)
            if c is 92 -> ue: 1
            h: h * 33 + c
            c: band(bshr(q, 56), 255)
            if c is 92 -> ue: 1
            h: h * 33 + c
            k: k + 8
        if not
            as long as go is 1
                b: peek_byte(s, k)
                if b is 0
                    go: 0
                if not
                    if b is 92 -> ue: 1
                    h: h * 33 + b
                    k: k + 1
    if ue is 1
        s: unesc(s)
        h: 5381
        k: 0
        go: 1
        as long as go is 1
            b: peek_byte(s, k)
            if b is 0
                go: 0
            if not
                h: h * 33 + b
                k: k + 1
    n: k
    p: band(h, 1048575)
    guard: 0
    as long as guard < 1048576 -> idx: peek_i64(intern_ht, p * 8)
        if idx = 0
            off: _sov_buf_len(strb)
            need: off + n + 1
            copied: 0
            if strb > 0
                if need <= peek_i64(strb, 0)
                    dst: strb + 16 + off
                    k: 0
                    as long as k + 8 <= n
                        dummy: poke_i64(dst, k, peek_i64(s, k))
                        k: k + 8
                    as long as k < n
                        dummy: poke_byte(dst, k, peek_byte(s, k))
                        k: k + 1
                    dummy: poke_byte(dst, n, 0)
                    poke_i64(strb, 8, need)
                    copied: 1
            if copied is 0
                k: 0
                as long as k < n
                    strb: _sov_buf_u8(strb, peek_byte(s, k))
                    k: k + 1
                strb: _sov_buf_u8(strb, 0)
            str_keys: _sov_list_add(str_keys, s)
            str_pos: _sov_list_add(str_pos, off)
            poke_i64(intern_ht, p * 8, off + 1)
            return off
        off: idx - 1
        if _sov_str_eq(strb + 16 + off, s) = 1 -> return off
        p: p + 1
        if p = 1048576 -> p: 0
        guard: guard + 1
    print "Error: intern table exhausted (over 1048576 unique names)"
    fail()
    return 0
intern_fast s:
    return intern_fast_do(s)
intern_kid_h s h0 n0:
    # Lookup s in kid_ht with pre-computed djb2 hash h0 and length n0.
    # Tables start small (guest compiles) and grow to fit (self-compile);
    # pool growth copies at identical offsets so stored pointers stay valid.
    if kid_ht is 0
        # pre-sized: a guest compile interns ~1.4k strings of compiler
        # keyword constants before the first user line is parsed, which
        # used to walk the 256->...->4096 rehash chain every run; 8192
        # slots (64KiB, one fresh mmap - the old 2KiB bzero stays dead)
        # covers 2730 strings at the 1/3 load trigger with zero rehash.
        kid_ht: _sov_heap_alloc(65536)
        kid_slots: 8192
        kid_pool: _sov_heap_alloc(65536)
        kid_poolcap: 65528
        dummy: poke_i64(kid_pool, 0, 0)
    if kcnt * 3 > kid_slots -> dgy: kgrow_ht(kg_tbl_g())
    h: h0
    n: n0
    slot: band(h, kid_slots - 1)
    guard: 0
    as long as guard < kid_slots
        idx: peek_i64(kid_ht, slot * 8)
        if idx is 0
            off: peek_i64(kid_pool, 0)
            if off + n + 2 > kid_poolcap -> dgp: kgrow_pool()
            off: peek_i64(kid_pool, 0)
            dst: kid_pool + 8 + off
            i: 0
            as long as i < n
                dummy: poke_byte(dst, i, peek_byte(s, i))
                i: i + 1
            dummy: poke_byte(dst, n, 0)
            dummy: poke_i64(kid_pool, 0, off + n + 1)
            dummy: poke_i64(kid_ht, slot * 8, dst)
            kcnt: kcnt + 1
            return dst
        if idx is s
            return idx
        if _sov_str_eq(idx, s) is 1
            return idx
        slot: slot + 1
        if slot is kid_slots
            slot: 0
        guard: guard + 1
    return 0

pk_sync:
    # rebuild patch_kid (interned patch kinds) from patch_kind in one
    # pass.  Called once after the walk: addp is emit_nt-planted, so
    # the kid list cannot be maintained incrementally there; interning
    # ~50k kinds once here replaces re-interning them in every post
    # pass (dce/dce_stores/dce_litter/dce_globals/flat).  The post-pass
    # list filters copy patch_kid entries in parallel with patch_kind.
    patch_kid: _sov_list_new()
    pks_i: 0
    pks_n: _sov_list_len(patch_kind)
    as long as pks_i < pks_n
        patch_kid: _sov_list_add(patch_kid, intern_kid(peek_i64(patch_kind, 16 + pks_i * 8)))
        pks_i: pks_i + 1

ik_cached nm:
    # expr_body interns each call's name slice once and parks the pair
    # in ik_nm_ptr/ik_nm_kid; the try_* layers it then drives would
    # otherwise re-intern the identical slice.  Call-name slices live
    # in the cut arena (append-only, never freed, never recycled), so
    # pointer identity is exact here; any other pointer (literals,
    # heap strings) simply misses and interns.  Do NOT generalize this
    # into intern_kid itself: heap-backed inputs DO recycle addresses.
    if nm is ik_nm_ptr
        return ik_nm_kid
    return intern_kid(nm)

# verbatim twin of intern_kid: emit_nt_intern_kid delegates every
# non-hit path (init, insert, growth, probe exhaustion) here.
intern_kid_full s:
    if kid_ht is 0
        kid_ht: _sov_heap_alloc(65536)
        kid_slots: 8192
        kid_pool: _sov_heap_alloc(65536)
        kid_poolcap: 65528
        dummy: poke_i64(kid_pool, 0, 0)
    h: 5381
    k: 0
    go: 1
    as long as go is 1
        # eight bytes per step while the qword has no NUL; the recurrence
        # h = h*33 + b is applied in the same order, so the hash and the
        # length are unchanged.  64-bit wrap-around is the same arithmetic
        # the byte loop already relied on.
        # Unaligned qwords must not cross a page boundary: the source's
        # NUL may be the final readable byte immediately before a guard.
        # The existing byte tail handles the short boundary fragment.
        q: 0
        if band(s + k, 4095) < 4089
            q: peek_i64(s, k)
        z: band(band(q - 72340172838076673, bxor(q, 0 - 1)), -9187201950435737472)
        if z = 0
            h: h * 33 + band(q, 255)
            h: h * 33 + band(bshr(q, 8), 255)
            h: h * 33 + band(bshr(q, 16), 255)
            h: h * 33 + band(bshr(q, 24), 255)
            h: h * 33 + band(bshr(q, 32), 255)
            h: h * 33 + band(bshr(q, 40), 255)
            h: h * 33 + band(bshr(q, 48), 255)
            h: h * 33 + band(bshr(q, 56), 255)
            k: k + 8
        if not
            as long as go is 1
                b: peek_byte(s, k)
                if b is 0
                    go: 0
                if not
                    h: h * 33 + b
                    k: k + 1
    n: k
    if kcnt * 3 > kid_slots -> dgy: kgrow_ht(kg_tbl_g())
    slot: band(h, kid_slots - 1)
    guard: 0
    as long as guard < kid_slots
        idx: peek_i64(kid_ht, slot * 8)
        if idx is 0
            off: peek_i64(kid_pool, 0)
            if off + n + 2 > kid_poolcap -> dgp: kgrow_pool()
            off: peek_i64(kid_pool, 0)
            dst: kid_pool + 8 + off
            i: 0
            as long as i < n
                dummy: poke_byte(dst, i, peek_byte(s, i))
                i: i + 1
            dummy: poke_byte(dst, n, 0)
            dummy: poke_i64(kid_pool, 0, off + n + 1)
            dummy: poke_i64(kid_ht, slot * 8, dst)
            kcnt: kcnt + 1
            return dst
        if idx is s
            return idx
        if _sov_str_eq(idx, s) is 1
            return idx
        slot: slot + 1
        if slot is kid_slots
            slot: 0
        guard: guard + 1
    return 0


intern_kid s:
    if kid_ht is 0
        kid_ht: _sov_heap_alloc(65536)
        kid_slots: 8192
        kid_pool: _sov_heap_alloc(65536)
        kid_poolcap: 65528
        dummy: poke_i64(kid_pool, 0, 0)
    h: 5381
    k: 0
    go: 1
    as long as go is 1
        # eight bytes per step while the qword has no NUL; the recurrence
        # h = h*33 + b is applied in the same order, so the hash and the
        # length are unchanged.  64-bit wrap-around is the same arithmetic
        # the byte loop already relied on.
        # Unaligned qwords must not cross a page boundary: the source's
        # NUL may be the final readable byte immediately before a guard.
        # The existing byte tail handles the short boundary fragment.
        q: 0
        if band(s + k, 4095) < 4089
            q: peek_i64(s, k)
        z: band(band(q - 72340172838076673, bxor(q, 0 - 1)), -9187201950435737472)
        if z = 0
            h: h * 33 + band(q, 255)
            h: h * 33 + band(bshr(q, 8), 255)
            h: h * 33 + band(bshr(q, 16), 255)
            h: h * 33 + band(bshr(q, 24), 255)
            h: h * 33 + band(bshr(q, 32), 255)
            h: h * 33 + band(bshr(q, 40), 255)
            h: h * 33 + band(bshr(q, 48), 255)
            h: h * 33 + band(bshr(q, 56), 255)
            k: k + 8
        if not
            as long as go is 1
                b: peek_byte(s, k)
                if b is 0
                    go: 0
                if not
                    h: h * 33 + b
                    k: k + 1
    n: k
    if kcnt * 3 > kid_slots -> dgy: kgrow_ht(kg_tbl_g())
    slot: band(h, kid_slots - 1)
    guard: 0
    as long as guard < kid_slots
        idx: peek_i64(kid_ht, slot * 8)
        if idx is 0
            off: peek_i64(kid_pool, 0)
            if off + n + 2 > kid_poolcap -> dgp: kgrow_pool()
            off: peek_i64(kid_pool, 0)
            dst: kid_pool + 8 + off
            i: 0
            as long as i < n
                dummy: poke_byte(dst, i, peek_byte(s, i))
                i: i + 1
            dummy: poke_byte(dst, n, 0)
            dummy: poke_i64(kid_pool, 0, off + n + 1)
            dummy: poke_i64(kid_ht, slot * 8, dst)
            kcnt: kcnt + 1
            return dst
        if idx is s
            return idx
        if _sov_str_eq(idx, s) is 1
            return idx
        slot: slot + 1
        if slot is kid_slots
            slot: 0
        guard: guard + 1
    return 0

intern_kid_n_full s n:
    if kid_ht is 0
        kid_ht: _sov_heap_alloc(65536)
        kid_slots: 8192
        kid_pool: _sov_heap_alloc(65536)
        kid_poolcap: 65528
        dummy: poke_i64(kid_pool, 0, 0)
    h: 5381
    k: 0
    as long as k < n
        h: h * 33 + peek_byte(s, k)
        k: k + 1
    if kcnt * 3 > kid_slots -> dgy: kgrow_ht(kg_tbl_g())
    slot: band(h, kid_slots - 1)
    guard: 0
    as long as guard < kid_slots
        idx: peek_i64(kid_ht, slot * 8)
        if idx is 0
            off: peek_i64(kid_pool, 0)
            if off + n + 2 > kid_poolcap -> dgp: kgrow_pool()
            off: peek_i64(kid_pool, 0)
            dst: kid_pool + 8 + off
            i: 0
            as long as i < n
                dummy: poke_byte(dst, i, peek_byte(s, i))
                i: i + 1
            dummy: poke_byte(dst, n, 0)
            dummy: poke_i64(kid_pool, 0, off + n + 1)
            dummy: poke_i64(kid_ht, slot * 8, dst)
            kcnt: kcnt + 1
            return dst
        if peek_byte(idx, n) is 0
            eq: 1
            i: 0
            as long as i < n
                if peek_byte(idx, i) is not peek_byte(s, i)
                    eq: 0
                    leave
                i: i + 1
            if eq is 1
                return idx
        slot: slot + 1
        if slot is kid_slots
            slot: 0
        guard: guard + 1
    return 0

intern_kid_n s n:
    if s is 0 -> return 0
    return intern_kid_n_full(s, n)

fsem_slot nid:
    if fsem_key is 0 -> return 0 - 1
    fsl: band(wrap_mul(bshr(nid, 3), 2654435761), fsem_cap - 1)
    as long as 1 is 1
        fk: peek_i64(fsem_key, fsl * 8)
        if fk is 0 -> return 0 - 1
        if fk is nid -> return fsl
        fsl: fsl + 1
        if fsl is fsem_cap -> fsl: 0

fsem_put nid val tgt cah:
    fsl: band(wrap_mul(bshr(nid, 3), 2654435761), fsem_cap - 1)
    as long as 1 is 1
        fk: peek_i64(fsem_key, fsl * 8)
        if fk is 0
            poke_i64(fsem_key, fsl * 8, nid)
            poke_i64(fsem_val, fsl * 8, val)
            poke_i64(fsem_tgt, fsl * 8, tgt)
            poke_i64(fsem_cah, fsl * 8, cah)
            return fsl
        if fk is nid
            poke_i64(fsem_val, fsl * 8, bor(peek_i64(fsem_val, fsl * 8), val))
            if tgt is not 0 -> poke_i64(fsem_tgt, fsl * 8, tgt)
            if cah is not 0 -> poke_i64(fsem_cah, fsl * 8, cah)
            return fsl
        fsl: fsl + 1
        if fsl is fsem_cap -> fsl: 0

fsem_mark_str nid:
    if fsem_key is 0 -> return 0
    fsl: fsem_slot(nid)
    if fsl >= 0
        poke_i64(fsem_val, fsl * 8, bor(peek_i64(fsem_val, fsl * 8), 1))
    if not
        fsem_put(nid, 1, nid, 0)
    return 0

kgrow_pool:
    # double the string pool; the copy keeps every offset, so pointers
    # already stored in kid_ht stay valid without a rehash
    used: peek_i64(kid_pool, 0)
    np2: _sov_heap_alloc(kid_poolcap + kid_poolcap + 16)
    i3: 0
    as long as i3 < used + 8
        dummy: poke_byte(np2, i3, peek_byte(kid_pool, i3))
        i3: i3 + 1
    kid_pool: np2
    kid_poolcap: kid_poolcap + kid_poolcap
    return 1

# --- kgrow_ht twin: the C port is planted from compilers/linux/
# kgrow_native.sov (generated from tools/native_kgrow.c) for the
# self-hosted build; the Sovren body below stays the portable fallback.
# One publish per growth (kg_pub sets kid_ht+kid_slots together, the
# same two globals the interpreted tail assigns); the rehash walk, the
# djb2 hash and the linear probe are 1:1, so the grown table layout is
# identical.
kg_tbl: 0
kg_tbl_init:
    kg_tbl: _sov_heap_alloc(40)
    poke_i64(kg_tbl, 0, 4)
    poke_i64(kg_tbl, 8, addr_of kg_g_ht)
    poke_i64(kg_tbl, 16, addr_of kg_g_slots)
    poke_i64(kg_tbl, 24, addr_of _sov_heap_alloc)
    poke_i64(kg_tbl, 32, addr_of kg_pub)
    return 0
kg_tbl_g:
    if kg_tbl is 0
        kg_tbl_init()
    return kg_tbl
kg_g_ht:
    return kid_ht
kg_g_slots:
    return kid_slots
kg_pub ht slots:
    kid_ht: ht
    kid_slots: slots
    return 0
kgrow_ht tbl:
    # double the slot array and re-insert every tabled string by hash.
    # Walk the OLD TABLE (not the pool): the pointers already handed out
    # stay the canonical ones, so pointer-identity comparisons
    # (tid is kid_*, kind is kg_*) survive growth.  Old pools are never
    # freed, so those pointers stay valid for the life of the process.
    kh_ns: kid_slots + kid_slots
    kh_nht: _sov_heap_alloc(kid_slots * 16)
    # >64KiB allocations are fresh mmaps (kernel-zeroed; large blocks are
    # munmapped on free, never recycled) - the bzero was dead work.
    if kid_slots * 16 <= 65536
        dummy: _sov_bzero(kh_nht, kid_slots * 16)
    kh_oi: 0
    as long as kh_oi < kid_slots
        kh_sp: peek_i64(kid_ht, kh_oi * 8)
        if kh_sp is not 0
            kh_h: 5381
            kh_k: 0
            kh_go: 1
            as long as kh_go is 1
                kh_b: peek_byte(kh_sp, kh_k)
                if kh_b is 0 -> kh_go: 0
                if not
                    kh_h: kh_h * 33 + kh_b
                    kh_k: kh_k + 1
            kh_slot: band(kh_h, kh_ns - 1)
            kh_g: 0
            as long as kh_g < kh_ns
                kh_ex: peek_i64(kh_nht, kh_slot * 8)
                if kh_ex is 0
                    dummy: poke_i64(kh_nht, kh_slot * 8, kh_sp)
                    kh_g: kh_ns
                if not
                    kh_slot: kh_slot + 1
                    if kh_slot is kh_ns -> kh_slot: 0
                kh_g: kh_g + 1
        kh_oi: kh_oi + 1
    kid_ht: kh_nht
    kid_slots: kh_ns
    return 1
