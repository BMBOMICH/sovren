accadd_rax_h h:
    emit(rexx(h))
    emit2(1, 4)
    emit(sibx(h))
accadd_rcx_h h:
    emit(rexx(h))
    emit2(1, 12)
    emit(sibx(h))
add_imm dest n:
    asl: lshf2(dest)
    if asl > 0 - 1
        if n >= 0 - 128
            if n < 128
                if asl < 5
                    cflush(dest)
                    arx: 72
                    if asl > 0
                        arx: 73
                    if n is 1
                        emit(arx)
                        emit(255)
                        emit(195 + asl)
                        return
                    emit(arx)
                    emit(131)
                    emit(195 + asl)
                    emit(n)
                    return
                if leaf8 is 1
                    cflush(dest)
                    if n is 1
                        emit2(73, 255)
                        emit(192 + asl - 5)
                        return
                    emit2(73, 131)
                    emit(192 + asl - 5)
                    emit(n)
                    return
                of: loc_off(asl)
                if of >= 0 - 128
                    cflush(dest)
                    if n is 1
                        emit3(72, 255, 69)
                        emit(of)
                        return
                    emit3(72, 131, 69)
                    emit(of)
                    emit(n)
                    return
    loadv(dest)
    emit2(72, 185)
    emit8(n)
    add_rax_rcx()
    storev(dest)
add_into dest src:
    sd: regslot2(src)
    if sd > 0 - 1
        dd: regslot2(dest)
        if dd > 0 - 1
            cflush(dest)
            cflush(src)
            emit_addsub_slot(dd, sd, 0)
            return
    loadv(src)
    sl: lshf2(dest)
    if sl is 0
        emit3(72, 1, 195)
        return
    if sl is 1
        emit3(73, 1, 196)
        return
    if sl is 2
        emit3(73, 1, 197)
        return
    if sl is 3
        emit3(73, 1, 198)
        return
    if sl is 4
        emit3(73, 1, 199)
        return
    mov_rcx_rax()
    loadv(dest)
    add_rax_rcx()
    storev(dest)
add_rax_mem sl:
    if leaf8 is 1
        if sl is 5
            emit3(73, 1, 192)
            return
        if sl is 6
            emit3(73, 1, 193)
            return
        if sl is 7
            emit3(73, 1, 194)
            return
        if sl is 8
            emit3(73, 1, 195)
            return
    of: loc_off(sl)
    emit2(72, 1)
    if of > 0 - 129
        emit(69)
        emit(of)
        return
    emit(133)
    emit4(of)
    return
add_rax_rcx:
    emit3(72, 1, 200)
add_rax_reg sl:
    emit(op_rex_r(sl))
    emit(1)
    emit(192 + op_low3(sl) * 8)
and_rax_reg sl:
    emit(op_rex_r(sl))
    emit(33)
    emit(192 + op_low3(sl) * 8)
or_rax_reg sl:
    emit(op_rex_r(sl))
    emit(9)
    emit(192 + op_low3(sl) * 8)
xor_rax_reg sl:
    emit(op_rex_r(sl))
    emit(49)
    emit(192 + op_low3(sl) * 8)
mov_rcx_reg sl:
    emit(op_rex_b(sl))
    emit(139)
    emit(200 + op_low3(sl))
add_rax_slot sl:
    if sl is 0
        emit3(72, 1, 195)
        return 0
    if sl is 1
        emit3(73, 1, 196)
        return 0
    if sl is 2
        emit3(73, 1, 197)
        return 0
    if sl is 3
        emit3(73, 1, 198)
        return 0
    if sl is 4
        emit3(73, 1, 199)
        return 0
    return 0 - 1
addp at kind val:
    patch_at: _sov_list_add(patch_at, at)
    patch_kind: _sov_list_add(patch_kind, kind)
    if patch_kid is not 0
        patch_kid: _sov_list_add(patch_kid, intern_kid(kind))
    patch_val: _sov_list_add(patch_val, val)
    patch_line: _sov_list_add(patch_line, err_line)
dm_m: 0
dm_s: 0
dm_a: 0
div_magic d:
    # Baked Hacker's Delight signed-division magic (M, shift, add-flag),
    # computed offline and verified against truncating division over the
    # full boundary set plus millions of random 64-bit dividends.
    if d is 3
        dm_m: 6148914691236517206
        dm_s: 0
        dm_a: 0
        return 1
    if d is 5
        dm_m: 7378697629483820647
