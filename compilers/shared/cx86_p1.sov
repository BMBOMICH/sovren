# unsafe-module
scut s st en:
    # strip(cut(s, st, en)) fused into one pass: _sov_substring's exact
    # clamps, then _sov_trim's whitespace runs bounded to [st, en), one
    # alloc, one copy. Result content == strip(cut(s, st, en)) in every
    # case (both always return a fresh heap string).
    if s < 4096
        return blank
    n: _sov_strlen(s)
    if st < 0
        st: 0
    if en > n
        en: n
    if en < st
        en: st
    a: st
    go: 1
    as long as go is 1
        if a >= en
            go: 0
        if not
            ch: peek_byte(s, a)
            if ch is 32
                a: a + 1
            if not
                if ch is 9
                    a: a + 1
                if not
                    if ch is 10
                        a: a + 1
                    if not
                        if ch is 13
                            a: a + 1
                        if not
                            go: 0
    b: en
    go: 1
    as long as go is 1
        if b <= a
            go: 0
        if not
            ch: peek_byte(s, b - 1)
            if ch is 32
                b: b - 1
            if not
                if ch is 9
                    b: b - 1
                if not
                    if ch is 10
                        b: b - 1
                    if not
                        if ch is 13
                            b: b - 1
                        if not
                            go: 0
    L: b - a
    r: _sov_heap_alloc(L + 1)
    dummy: _sov_memcpy(r, s + a, L)
    dummy: poke_byte(r, L, 0)
    return r
scutr s st:
    # strip(cut(s, st, length(s))) fused: the length probe the sites used
    # is absorbed into scut's own strlen.
    return scut(s, st, length(s))

