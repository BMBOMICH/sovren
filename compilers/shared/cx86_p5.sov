    br_at: _sov_list_add(br_at, at)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, at)
    br_st: _sov_list_add(br_st, 0)
    return at
join a b:
    if a is 0
        return b
    if peek_byte(a, 0) is 0
        return b
    if b is 0
        return a
    if peek_byte(b, 0) is 0
        return a
    return _sov_strcat(a, b)
jz:
    
    emit2(15, 132)
    at: here()
    emit4(0)
    br_at: _sov_list_add(br_at, at)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, at)
    br_st: _sov_list_add(br_st, 0)
    return at
lea_ok ag:
    p: look(ag, " - ")
    neg: 1
    if p < 0
        p: look(ag, " + ")
        neg: 0
    if p < 0
        return 0
    nm: strip(cut(ag, 0, p))
    cs: strip(cut(ag, p + 3, length(ag)))
    if plain_name(nm) is 0
        return 0
    if is_imm(cs) is 0
        return 0
    v: num_of(cs)
    if neg is 1
        v: 0 - v
    if v > 127
        return 0
    if v < 0 - 128
        return 0
    if v is 0
        return 0
    if reg_slot(nm) < 0
        return 0
    return 1
leaf8_scan lines:

    li: 0
    li_ln: _sov_list_len(lines)
    as long as li < li_ln
        s: peek_i64(lines, 16 + li * 8)
        as long as peek_byte(s, 0) is 32
            s: s + 1
        as long as peek_byte(s, 0) is 9
            s: s + 1
        skip: 0
        if peek_byte(s, 0) is 0
            skip: 1
        if peek_byte(s, 0) is 35
            skip: 1
        if skip is 0
            cm: cfind1(s, 35)
            if cm > 0 - 1
                s: cut(s, 0, cm)
            if look(s, "_sov_") > 0 - 1
                return 0
            if look(s, "print") > 0 - 1
                return 0
            if look(s, "syscall") > 0 - 1
                return 0
            if look(s, "raise") > 0 - 1
                return 0
            if cfind1(s, 34) > 0 - 1
                return 0
            if look(s, "length of ") > 0 - 1
                return 0
            wd: word_id(s)
            if wd is kid_wipe
                return 0
            if wd is kid_join
                return 0
            if wd is kid_try
                return 0
            if wd is kid_except
                return 0
            p: 0
            as long as peek_byte(s, p) > 0
                if peek_byte(s, p) is 40
                    q: p
                    go: 1
                    as long as go is 1
                        if q is 0
                            go: 0
                        if not
                            b: peek_byte(s, q - 1)
                            if wordchar(b) is 1
                                q: q - 1
                            if not
                                go: 0
                    tn: p - q
                    ok: 0
                    if tn is 3
                        if sg_match(s, q, "bor") is 1
                            ok: 1
                    if tn is 4
                        if sg_match(s, q, "band") is 1
                            ok: 1
                        if sg_match(s, q, "bxor") is 1
                            ok: 1
                        if sg_match(s, q, "bshl") is 1
                            ok: 1
                        if sg_match(s, q, "bshr") is 1
                            ok: 1
                        if sg_match(s, q, "bsar") is 1
                            ok: 1
                    if tn is 8
                        if sg_match(s, q, "peek_i64") is 1
                            ok: 1
                        if sg_match(s, q, "poke_i64") is 1
                            ok: 1
                        if sg_match(s, q, "wrap_add") is 1
                            ok: 1
                        if sg_match(s, q, "wrap_sub") is 1
                            ok: 1
                        if sg_match(s, q, "wrap_mul") is 1
                            ok: 1
                    if tn is 9
                        if sg_match(s, q, "peek_byte") is 1
                            ok: 1
                        if sg_match(s, q, "poke_byte") is 1
                            ok: 1
                    if tn is 10
                        if sg_match(s, q, "peek_raw64") is 1
                            ok: 1
                        if sg_match(s, q, "poke_raw64") is 1
                            ok: 1
                    if ok is 0
                        return 0
                p: p + 1
        li: li + 1
    return 1
length s:
    if s < 4096
        return 0
    return _sov_strlen(s)
letter t i:

    if letter_tab is 0
        letter_tab: _sov_heap_alloc(512)
        k: 0
        as long as k < 256
            poke_byte(letter_tab, k * 2, k)
            poke_byte(letter_tab, k * 2 + 1, 0)
            k: k + 1
    if t < 4096
        return letter_tab
    if i < 0
        return letter_tab
    return letter_tab + peek_byte(t, i) * 2
lim_const lim:
    if _sov_str_eq(lim, kn) is 1
        if kv > 0
            if kv < 2147483648
                return kv
    if is_imm(lim) is 1
        v: num_of(lim)
        if v > 0
            if v < 2147483648
                return v
lim_source_const lines li lim:
    jj: li - 1
    pref: join(lim, ": ")
    loopind: nind(peek_i64(lines, 16 + li * 8))
    as long as jj >= 0
        raw: peek_i64(lines, 16 + jj * 8)
        pl: strip(raw)
        if length(pl) > 0
            if peek_byte(pl, 0) is not 35
                if _sov_starts_with(pl, pref) is 1
                    if nind(raw) <= loopind
                        vs: strip(cut(pl, length(pref), length(pl)))
                        if digitb(peek_byte(vs, 0)) is 1
                            if look(vs, " ") < 0
                                return num_of(vs)
                    return 0
        jj: jj - 1
lines_of source:
    lst: _sov_list_new()
    start: 0
    i: 0
    return lines_of_fast(source)
    # fast line descriptors share one backing allocation.
    #
    #
    #
    #
    #
load_file path:
    fd: _sov_open(path, 0)
    if fd < 0
        return 0
    sz: _sov_lseek(fd, 0, 2)
    _sov_lseek(fd, 0, 0)
    if sz < 1
        _sov_close(fd)
        return 0
    buf: _sov_heap_alloc(sz + 1)
    got: _sov_read(fd, buf, sz)
    _sov_close(fd)
    dummy: poke_byte(buf, got, 0)
    return buf
load_loc slot:
    if slot is 0
        emit3(72, 137, 216)
        return
    if slot is 1
        emit3(76, 137, 224)
        return
    if slot is 2
        emit3(76, 137, 232)
        return
    if slot is 3
        emit3(76, 137, 240)
        return
    if slot is 4
        emit3(76, 137, 248)
        return
    if slot is 5
        if leaf8 is 1
            emit3(76, 137, 192)
            return
    if slot is 6
        if leaf8 is 1
            emit3(76, 137, 200)
            return
    if slot is 7
        if leaf8 is 1
            emit3(76, 137, 208)
            return
    if slot is 8
        if leaf8 is 1
            emit3(76, 137, 216)
            return
    emit3(72, 139, 133)
    emit4(loc_off(slot))
loadv name:
    if peek_byte(name, 0) is 98
        if word_id(name) is kid_blank
            rax_str("")
            return
    fl_x5: fl_expand(name)
    if peek_byte(fl_x5, 0) is not 0
        dummy: expr(fl_x5)
        return
    cflush(name)
    i: lsh_find_s(name)
    if i > 0 - 1
        load_loc(i)
        return
    g: gn_lookup(name)
    if g > 0 - 1
        load_glob(name)
        return
    # undeclared reads auto-register (stale-era tolerance; k*-tests rely on it)
    if wr_used is 0
        wr_used: _sov_list_new()
    if list_find(wr_used, name) is 0 - 1
        wr_used: _sov_list_add(wr_used, name)
        print "Warning: undeclared read, auto-registers as a local starting at 0"
        _sov_print(name)
        err_where()
    load_loc(slot(name))
loadv_rcx name:
    loadv(name)
    li: lsh_find_s(name)
    if li > 0 - 1
        if li < 5
            if oc_n > 0
                lb: peek_byte(oc, oc_n - 1)
                if lb is 216
                    dummy: ocset(oc_n - 1, 217)
                if lb is 224
                    dummy: ocset(oc_n - 1, 225)
                if lb is 232
                    dummy: ocset(oc_n - 1, 233)
                if lb is 240
                    dummy: ocset(oc_n - 1, 241)
                if lb is 248
                    dummy: ocset(oc_n - 1, 249)
                return 0
        if leaf8 is 1
            if li < 9
                if oc_n > 0
                    lb: peek_byte(oc, oc_n - 1)
                    if lb is 192
                        dummy: ocset(oc_n - 1, 193)
                    if lb is 200
                        dummy: ocset(oc_n - 1, 201)
                    if lb is 208
                        dummy: ocset(oc_n - 1, 209)
                    if lb is 216
                        dummy: ocset(oc_n - 1, 217)
                    return 0
    mov_rcx_rax()
loadv_rdi name:
    g9: gn_lookup(name)
    if g9 > 0 - 1
        if lsh_find_s(name) < 0
            cflush(name)
            emit3(72, 139, 61)
            at: here()
            emit4(0)
            addp(at, "grel", name)
            return 0
