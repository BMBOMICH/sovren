        poke_byte(pn_bad, 38, 1)
        poke_byte(pn_bad, 40, 1)
        poke_byte(pn_bad, 41, 1)
        poke_byte(pn_bad, 42, 1)
        poke_byte(pn_bad, 43, 1)
        poke_byte(pn_bad, 45, 1)
        poke_byte(pn_bad, 47, 1)
        poke_byte(pn_bad, 60, 1)
        poke_byte(pn_bad, 61, 1)
        poke_byte(pn_bad, 62, 1)
        poke_byte(pn_bad, 91, 1)
        poke_byte(pn_bad, 93, 1)
        poke_byte(pn_bad, 124, 1)
    if s < 4096
        return 1
    i: 0
    as long as 1
        b: peek_byte(s, i)
        if b is 0
            return 1
        if peek_byte(pn_bad, b) is 1
            return 0
        i: i + 1
