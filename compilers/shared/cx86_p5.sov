# pad line so main is not first
# unsafe-module
frame_wipe:
    emit3(72, 137, 239)
    emit3(72, 129, 239)
    fw_a: here()
    br_at: _sov_list_add(br_at, fw_a)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, fw_a)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    emit(185)
    fw_b: here()
    br_at: _sov_list_add(br_at, fw_b)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, fw_b)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    emit3(49, 192, 243)
    emit(170)
    fw_pos: _sov_list_add(fw_pos, fw_a)
    fw_pos: _sov_list_add(fw_pos, fw_b)
fuse_cmp cond inv:
    e: strip(cops(cond))
    if cfind1(e, 38) > 0 - 1
        if look(e, "&&") > 0 - 1
            return 0 - 1
    if cfind1(e, 124) > 0 - 1
        if look(e, "||") > 0 - 1
            return 0 - 1
    if look(e, " and ") > 0 - 1
        return 0 - 1
    if look(e, " or ") > 0 - 1
        return 0 - 1
    p: fop(e, "==")
    op: "eq"
    ow: 2
    if p < 0
        p: fop(e, "!=")
        op: "ne"
        ow: 2
    if p < 0
        p: fop(e, "<=")
        op: "le"
        ow: 2
    if p < 0
        p: fop(e, ">=")
        op: "ge"
        ow: 2
    if p < 0
        p: fop(e, "<")
        op: "lt"
        ow: 1
    if p < 0
        p: fop(e, ">")
        op: "gt"
        ow: 1
    if p < 0
        return 0 - 1
    oid: intern_kid(op)
    le: strip(cut(e, 0, p))
    re: strip(cut(e, p + ow, length(e)))
    if look(le, "(") > 0 - 1
        expr(le)
        if is_imm(re) is 1
            cmp_rax_imm(num_of(re))
            return fuse_jcc(op, inv)
        push_rax()
        expr(re)
        mov_rcx_rax()
        pop_rax()
        cmp_rax_rcx()
        return fuse_jcc(op, inv)
    if oid is kid_opeq
        if peek_byte(re, 0) is 34
            expr(le)
            push_rax()
            expr(re)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            cmp_rax_imm(1)
            return fuse_jcc("eq", inv)
        if peek_byte(le, 0) is 34
            expr(re)
            push_rax()
            expr(le)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            cmp_rax_imm(1)
            return fuse_jcc("eq", inv)
    if oid is kid_opne
        if peek_byte(re, 0) is 34
            expr(le)
            push_rax()
            expr(re)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            cmp_rax_imm(1)
            return fuse_jcc("ne", inv)
        if peek_byte(le, 0) is 34
            expr(re)
            push_rax()
            expr(le)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            cmp_rax_imm(1)
            return fuse_jcc("ne", inv)
    if is_imm(re) is 1
        if is_imm(le) is 0
            sl: bin_rslot(le)
            if sl > 0 - 1
                cflush(le)
                cmp_reg_imm(sl, num_of(re))
            if not
                expr(le)
                cmp_rax_imm(num_of(re))
            return fuse_jcc(op, inv)
    if is_imm(le) is 1
        if is_imm(re) is 0
            sl: bin_rslot(re)
            if sl > 0 - 1
                cflush(re)
                cmp_reg_imm(sl, num_of(le))
            if not
                expr(re)
                cmp_rax_imm(num_of(le))
            return fuse_jcc(swap_op(op), inv)
    la: reg_slot(le)
    ra: reg_slot(re)
    if la > 0 - 1
        if ra > 0 - 1
            cflush(le)
            cflush(re)
            cmp_reg_reg(la, ra)
            return fuse_jcc(op, inv)
        mr: mem_scaled(re)
        if mr > 0 - 1
            mb: mr / 65536
            mq: mr % 65536
            cflush(le)
            emit_cmp_reg_scaled(la, mb, mq / 4096, mq % 4096 - 128)
            return fuse_jcc(op, inv)
        cflush(le)
        expr(re)
        cmp_reg_rax(la)
        return fuse_jcc(op, inv)
    if ra > 0 - 1
        ml: mem_scaled(le)
        if ml > 0 - 1
            mb: ml / 65536
            mq: ml % 65536
            cflush(re)
            emit_cmp_reg_scaled(ra, mb, mq / 4096, mq % 4096 - 128)
            return fuse_jcc(swap_op(op), inv)
        cflush(re)
        expr(le)
        cmp_rax_reg(ra)
        return fuse_jcc(op, inv)
    ml: mem_scaled(le)
    if ml > 0 - 1
        mr: mem_scaled(re)
        if mr > 0 - 1
            mb: ml / 65536
            mq: ml % 65536
            nb: mr / 65536
            nq: mr % 65536
            emit_rax_scaled(mb, mq / 4096, mq % 4096 - 128)
            emit_cmp_rax_scaled(nb, nq / 4096, nq % 4096 - 128)
            return fuse_jcc(op, inv)
    expr(le)
    push_rax()
    expr(re)
    mov_rcx_rax()
    pop_rax()
    cmp_rax_rcx()
    return fuse_jcc(op, inv)
fuse_jcc op inv:
    oid: intern_kid(op)
    if oid is kid_opeq
        if inv is 1
            return jne()
        return jz()
    if oid is kid_opne
        if inv is 1
            return jz()
        return jne()
    if oid is kid_oplt
        if inv is 1
            return jge()
        return jl()
    if oid is kid_ople
        if inv is 1
            return jg()
        return jle()
    if oid is kid_opgt
        if inv is 1
            return jle()
        return jg()
    if oid is kid_opge
        if inv is 1
            return jl()
        return jge()
    return 0 - 1
here:
    return oc_here(oc)
homereg name:
    sl: reg_slot(name)
    if sl > 0 - 1
        if sl is 0
            return 3
        return sl + 11
    if leaf8 is 1
        sl8: lsh_find_s(name)
        if sl8 > 4
            if sl8 < 9
                return sl8 + 3
    return 0 - 1
i2s n:
    r: ""
    v: n
    if v is 0
        return "0\n"
    neg: 0
    if v < 0
        neg: 1
    as long as v is not 0
        d: v % 10
        if d < 0
            d: 0 - d
        r: join(cut("0123456789", d, d + 1), r)
        v: v / 10
    if neg is 1
        r: join("-", r)
    return join(r, "\n")
idiv_reg sl:
    emit(op_rex_b(sl))
    emit(247)
    emit(248 + op_low3(sl))
list_idx lst name:
    # one open-addressed probe replaces the old O(names) walk; a hit
    # is verified against the live list, so a rebuilt list cannot alias.
    i: list_find(lst, name)
    if i > 0 - 1
        return i
    return 0 - 1
imul_rax_rcx:
    emit3(72, 15, 175)
    emit(193)
imul_rax_reg sl:
    emit(op_rex_b(sl))
    emit2(15, 175)
    emit(192 + op_low3(sl))
inc_var name:
    sl: lsh_find_s(name)
    if sl is 0
        emit3(72, 255, 195)
        return
    if sl is 1
        emit3(73, 255, 196)
        return
    if sl is 2
        emit3(73, 255, 197)
        return
    if sl is 3
        emit3(73, 255, 198)
        return
    if sl is 4
        emit3(73, 255, 199)
        return
    if sl < 0
        loadv(name)
        emit3(72, 255, 192)
        storev(name)
        return
    if sl is 5
        if leaf8 is 1
            emit3(73, 255, 192)
            return
    if sl is 6
        if leaf8 is 1
            emit3(73, 255, 193)
            return
    if sl is 7
        if leaf8 is 1
            emit3(73, 255, 194)
            return
    if sl is 8
        if leaf8 is 1
            emit3(73, 255, 195)
            return
    cflush(name)
    of: loc_off(sl)
    emit2(72, 255)
    if of > 0 - 129
        emit(69)
        emit(of)
        return
    emit(133)
    emit4(of)
    return
intern s:
    return intern_fast_do(s)
intern_nz s:

    # Raw, already-decoded bytes. The general interner decodes escapes;
    # shield literal backslashes so it cannot decode a print payload twice.
    if look(s, str_chr(92)) < 0
        return intern_fast_do(s)
    n: length(s)
    raw: _sov_heap_alloc(n * 2 + 1)
    i: 0
    j: 0
    as long as i < n
        b: peek_byte(s, i)
        if b is 92
            poke_byte(raw, j, 92)
            j: j + 1
        poke_byte(raw, j, b)
        j: j + 1
        i: i + 1
    poke_byte(raw, j, 0)
    return intern_fast_do(raw)
is_imm s:
    n: length(s)
    if n is 0
        return 0
    i: 0
    if peek_byte(s, 0) is 45
        i: 1
    if i >= n
        return 0
    as long as i < n
        if digitb(peek_byte(s, i)) is 0
            return 0
        i: i + 1
    return 1
cval: 0
cvop: 0
cspl: 0
cstk: 0
opt_peep: 1
opt_dce: 0
lcut lst n:
    out: _sov_list_new()
    i: 0
    as long as i < n
        out: _sov_list_add(out, peek_i64(lst, 16 + i * 8))
        i: i + 1
    return out
include constant_eval.sov
is_task_hdr s:
    n: length(s)
    if n < 2
        return 0
    if peek_byte(s, 0) is 35
        return 0
    if peek_byte(s, n - 1) is 58
        return 1
jae:
    emit2(15, 131)
    at: here()
    emit4(0)
    br_at: _sov_list_add(br_at, at)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, at)
    br_st: _sov_list_add(br_st, 0)
    return at
