    if v < 0 - 2147483648
        emit2(72, 185)
        emit8(v)
        cmp_rax_rcx()
        return 0
    emit2(72, 61)
    emit4(v)
cmp_rax_rcx:
    emit3(72, 57, 200)
cmp_rax_reg slot:
    if slot is 0
