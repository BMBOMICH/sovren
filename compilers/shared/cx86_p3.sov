                                                                                                                    _sov_print(ev)
                                                                                                                    err_where()
                                                                                                                    had_err: 1
                                                        load_glob("err_top")
                                                                                                            emit(72)
                                                        emit3(137, 194, 72)
                                                        emit3(139, 66, 8)
                                                        store_glob("err_top")
                                                        emit3(72, 131, 196)
                                                        emit(32)
                                                        tb: jmp()
                                                        bs: _sov_list_set(bs, last, tb)
                                                                                                            put(peek_i64(br, 16 + last * 8), here() - (peek_i64(br, 16 + last * 8) + 4))
                                                                                                            load_glob("err_val")
                                                        store_loc(slot(ev))
                                                                                                            bk: _sov_list_add(bk, kid_except)
                                                                                                            bw: _sov_list_add(bw, "")
                                                        bi: _sov_list_add(bi, ind)
                                                        bj: _sov_list_add(bj, 0)
                                                        bs: _sov_list_add(bs, 0)
                                                        be: _sov_list_add(be, _sov_list_new())
                                                        br: _sov_list_add(br, 0)
                                                        bx: _sov_list_add(bx, _sov_list_new())
                                                        br_depth: br_depth + 1
                                                    if not
                                                        print "Error: except without try"
                                                        _sov_print(s)
                                                        err_where()
                                                        had_err: 1
                                                if not
                                                    print "Error: except without try"
                                                    _sov_print(s)
                                                    err_where()
                                                    had_err: 1
                                            if not
                                                if wid is kid_raise
                                                    expr(cut(s, 6, length(s)))
                                                    if gn_lookup("err_val") is 0 - 1
                                                        glob_names: _sov_list_add(glob_names, "err_val")
                                                    if gn_lookup("err_top") is 0 - 1
                                                        glob_names: _sov_list_add(glob_names, "err_top")
                                                    store_glob("err_val")
                                                    load_glob("err_top")
                                                    emit3(72, 137, 194)
                                                    emit3(72, 133, 210)
                                                    zz: jz()
                                                    emit3(72, 139, 66)
                                                    emit(8)
                                                    store_glob("err_top")
                                                    emit3(72, 139, 106)
                                                    emit3(16, 72, 139)
                                                    emit3(98, 24, 255)
                                                    emit2(98, 0)
                                                    patch(zz)
                                                    if zz < 0
                                                        print "PN503"
                                                    load_glob("err_val")
                                                    mov_rdi_rax()
                                                    used_pi: 1
                                                    calln("_sov_print_int")
                                                    emit(191)
                                                    emit4(1)
                                                    emit_sys_exit()
                                                if not
                                                                                                        bd_s: s
                                                    bd_slen: 0 - 1
                                                    if s is hs
                                                        bd_slen: hsl
                                                    stmt(s)
                i: i + 1
    as long as _sov_list_len(bk) > 0
        popblk()
fast_ret line:
    if dbg_mode is 1
        return 0
    i: 0
    as long as peek_byte(line, i) is 32
        i: i + 1
    if peek_byte(line, i) is not 114
        return 0
    if peek_byte(line, i + 1) is not 101
        return 0
    if peek_byte(line, i + 2) is not 116
        return 0
    if peek_byte(line, i + 3) is not 117
        return 0
    if peek_byte(line, i + 4) is not 114
        return 0
    if peek_byte(line, i + 5) is not 110
        return 0
    if peek_byte(line, i + 6) is not 32
        return 0
    return fast_ret_do(line, i)
fast_ret_do line i:
    ln: length(line)
    if ln - i < 8
        return 0
    if peek_byte(line, ln - 1) is 32
        return 0
    if peek_byte(line, ln - 1) is 9
        return 0
    if peek_byte(line, ln - 1) is 13
        return 0
    j: i + 7
    k: j
    seen: 0
    prev: 32
    as long as k < ln
        b: peek_byte(line, k)
        if b is not 32
            seen: 1
        if b is 34
            return 0
        if b is 35
            return 0
        if b is 39
            return 0
        if b is 58
            return 0
        if b is 59
            return 0
        if b is 92
            return 0
        if b is 9
            return 0
        if b is 13
            return 0
        if b < 32
            return 0
        if b > 126
            return 0
        if b is 61
            if prev is 43
                return 0
            if prev is 45
                return 0
            if prev is 42
                return 0
            if prev is 47
                return 0
            if prev is 38
                return 0
            if prev is 124
                return 0
            if prev is 94
                return 0
        prev: b
        k: k + 1
    if seen is 0
        return 0
    ex: cut(line, j, ln)
    typ: expr(ex)
    if typ is 1
        saw_str: 1
    if in_entry_now is 1
        if sxe_mode is 1
            leave()
            ret()
    if in_entry_now is 1
        if sxe_mode is not 1
            emit3(72, 137, 199)
            emit_sys_num(60)
            emit_sys_do()
    if in_entry_now is 1
        return 1
    if fw_on is 1
        if no_frame is 0
            canary_check()
            emit(80)
            restores()
            frame_wipe()
            emit(88)
            stmt_leave_op()
            ret()
            return 1
    leave()
    ret()
    return 1
rpx_dec v9:
    r: ""
    if v9 is 0
        return "0"
    as long as v9 > 0
        r: join(cut("0123456789", v9 % 10, v9 % 10 + 1), r)
        v9: v9 / 10
    return r
lex_txt: 0
lit_expr_len rhs:
    # length of a compile-time-known string rhs: a quoted literal, or a
    # str_cat whose two args each resolve to literal text (quoted, or
    # the currently tracked cp var).  On success lex_txt holds the
    # joined escaped-form inner text; -1 when not known.
    lex_txt: 0
    if is_lit(rhs) is 1
        lex_txt: cut(rhs, 1, length(rhs) - 1)
        return lit_len(rhs)
    if _sov_starts_with(rhs, "str_cat(") is 1
        if peek_byte(rhs, length(rhs) - 1) is 41
            la: _sov_list_new()
            la: split_args(cut(rhs, 8, length(rhs) - 1), la)
            if _sov_list_len(la) is 2
                a1: strip(peek_i64(la, 16))
                a2: strip(peek_i64(la, 24))
                x1: 0
                n1: 0 - 1
                if is_lit(a1) is 1
                    x1: cut(a1, 1, length(a1) - 1)
                    n1: lit_len(a1)
                if not
                    t1: cp_txt_of(a1)
                    if t1 is not 0
                        x1: t1
                        n1: cp_ln
                x2: 0
                n2: 0 - 1
                if is_lit(a2) is 1
                    x2: cut(a2, 1, length(a2) - 1)
                    n2: lit_len(a2)
                if not
                    t2: cp_txt_of(a2)
                    if t2 is not 0
                        x2: t2
                        n2: cp_ln
                if n1 > 0 - 1
                    if n2 > 0 - 1
                        lex_txt: join(x1, x2)
                        return n1 + n2
    return 0 - 1

rhs_pure rhs:
    # 1 when every "(" in rhs belongs to a str_len( call, so compiling
    # rhs cannot mutate a tracked string before a str_len fold reads it.
    n: length(rhs)
    i: 0
    opn: 0
    sln: 0
    as long as i < n
        if peek_byte(rhs, i) is 40
            opn: opn + 1
            if i > 6
                if sg_match(rhs, i - 7, "str_len(") is 1
                    sln: sln + 1
        i: i + 1
    if opn is sln
        return 1
    return 0

stmt line:
    # bt tables describe the source line body() is compiling.  Nested stmt
    # calls (multi-line inliner synthetics) must not inherit the cursor, or
    # they slice the synthetic line with the outer line's colon/quote data.
    st_ci: bt_ci
    st_sh: bt_sh
    bt_ci: 0 - 1
    if cp_pend_kill is 1
        cp_nm: 0
        cp_pend_kill: 0
    # fast_ret below compiles `return <expr>` on its own, so the keyword/op ids
    # one-line return otherwise reaches bin/emit_op with every kid_op* still 0
    # and the operator falls into the cmp fallback.
    kid_init()
    tzz0: peek_byte(line, 0)
    if tzz0 is 114
        if try_tail_call(line) is 1
            return
    if tzz0 is 32
        if try_tail_call(line) is 1
            return
    if fast_ret(line) is 1
        return
    if dbg_mode is 1
        if oc != 0
            dbg_pcs: _sov_list_add(dbg_pcs, here())
            dbg_lns: _sov_list_add(dbg_lns, err_line)
    im_skip: 0
    s: line
    if peek_byte(line, 0) < 33
        s: strip(line)
    if not
        ln: 0 - 1
        if line is bd_s
            ln: bd_slen
        if ln < 0
            ln: length(line)
        if ln > 0
            if peek_byte(line, ln - 1) < 33
                s: strip(line)
    if peek_byte(s, 0) is 0
        return
    if peek_byte(s, 0) is 35
        return
    if _sov_starts_with(s, "fxreg___|") is 1
        if fx_region_stmt(s) is 1
            return
    s: compound(s)
    st_sl: length(s)
    rax_small: 0
    bt_hasq: 0 - 1
    if bt_ok is 1
        if st_ci is not 0 - 1
            bq_raw: peek_i64(bt_m, 16 + st_ci * 8)
            if bq_raw is not 0 - 1
                bt_hasq: bq_raw - st_sh
    if bt_hasq is 0 - 1
        bt_hasq: cfind1(s, 34)
    if bt_hasq > 0 - 1
        q: 0
        qi: 0
        as long as qi < st_sl
            if peek_byte(s, qi) is 92
                qi: qi + 1
            if not
                if peek_byte(s, qi) is 34
                    q: q + 1
            qi: qi + 1
        if q % 2 is not 0
            print "Error: unterminated text"
            _sov_print(s)
            err_where()
            had_err: 1
            return
    if st_sl > 1000
        print "Error: line too long, split it up"
        err_where()
        had_err: 1
        return
    wid: 0 - 1
    if wid_hp is s
        wid: wid_hv
    if wid is 0 - 1
        wid: word_id(s)
    if wid is kid_use
        return
    if wid is kid_immutable
            rest: strip(cut(s, 10, length(s)))
            t: find_col(rest)
            if t < 1
                print "Error: immutable needs a name and a value"
                err_where()
                had_err: 1
                return
            im_names: _sov_list_add(im_names, strip(cut(rest, 0, t)))
            dhim: plog_str(6, _sov_list_get(im_names, _sov_list_len(im_names) - 1))
            im_skip: 1
            s: rest
    col: 0 - 1
    bt_hasc: 0
    if bt_ok is 1
        if st_ci is not 0 - 1
            if im_skip is 0
                bc_raw: peek_i64(bt_col, 16 + st_ci * 8)
                bt_hasc: 1
                if bc_raw is not 0 - 1
                    col: bc_raw - st_sh
    if bt_hasc is 0
        if im_skip is 0
            # bt_hasq already answers "has quote" for this exact s (computed
            # above on the post-compound text), so find_col's two cfind1
            # probes would just repeat it.  Same result either way:
            # find_col(s) = cfind1(s,58) when no quote, else find_col_q(s).
            if bt_hasq < 0
                col: cfind1(s, 58)
            if not
                col: find_col_q(s)
        if not
            if cfind1(s, 58) > 0 - 1
                col: find_col(s)
    if col > 0
        if col < length(s) - 1
            ds_go: 0
            if tk_run is 0
                if ds_ok is 1
                    ds_go: 1
                if inl_depth > 0
                    ds_go: 1
            if ds_go is 1
                # destructive split: s is this line's private span
                # (flat split buffer view or a strip copy).  Nothing
                # re-reads the untruncated line after this point:
                # analysis passes ran pre-walk, and every inline
                # expansion rebuilds its text.  var/rhs become
                # in-place spans -- trim ends NUL-poked, name spaces
                # rewritten to '_', exactly mirroring strip+repl.
                dsv: col
                dsgo: 1
                as long as dsgo is 1
                    dsb: peek_byte(s, dsv - 1)
                    if dsb is 32
                        dsv: dsv - 1
                    if not
                        if dsb is 9
                            dsv: dsv - 1
                        if not
                            if dsb is 10
                                dsv: dsv - 1
                            if not
                                if dsb is 13
                                    dsv: dsv - 1
                                if not
                                    dsgo: 0
                dummy: poke_byte(s, dsv, 0)
                dsi: 0
                as long as dsi < dsv
                    if peek_byte(s, dsi) is 32
                        dummy: poke_byte(s, dsi, 95)
                    dsi: dsi + 1
                var: s
                dsr: col + 1
                dsgo: 1
                as long as dsgo is 1
                    dsb: peek_byte(s, dsr)
                    if dsb is 32
                        dsr: dsr + 1
                    if not
                        if dsb is 9
                            dsr: dsr + 1
                        if not
                            if dsb is 10
                                dsr: dsr + 1
                            if not
                                if dsb is 13
                                    dsr: dsr + 1
                                if not
                                    dsgo: 0
                dse: st_sl
                dsgo: 1
                as long as dsgo is 1
                    if dse <= dsr
                        dsgo: 0
                    if dsgo is 1
                        dsb: peek_byte(s, dse - 1)
                        if dsb is 32
                            dse: dse - 1
                        if not
                            if dsb is 9
                                dse: dse - 1
                            if not
                                if dsb is 10
                                    dse: dse - 1
                                if not
                                    if dsb is 13
                                        dse: dse - 1
                                    if not
                                        dsgo: 0
                dummy: poke_byte(s, dse, 0)
                rhs: s + dsr
            if not
                var: repl(strip(cutn(s, 0, col, st_sl)), " ", "_")
                rhs: strip(cutn(s, col + 1, st_sl, st_sl))
            ix_w: ix_find(var, length(var))
            if ix_w > 0
                if ix_name_ok(cut(var, 0, ix_w)) is 1
                    ix_bn: cut(var, 0, ix_w)
                    ix_bi: cut(var, ix_w + 1, length(var) - 1)
                    rhs: str_cat("_sov_list_set(", str_cat(ix_bn, str_cat(", ", str_cat(ix_bi, str_cat(", ", str_cat(rhs, ")"))))))
                    var: ix_bn
            if _sov_list_len(im_names) > 0
                if list_find(im_names, var) > 0 - 1
                    if im_skip is 0
                        print join("Error: ", join(var, " is immutable, it cannot be assigned again"))
                        _sov_print(s)
                        err_where()
                        had_err: 1
                        return
                    im_skip: 0
            vn: length(var)
            rn: length(rhs)
            cpx_p: lit_expr_len(rhs)
            cpx_t: lex_txt
            if cpx_p > 0 - 1
                # literal-valued rhs: the pending entry is applied at the
                # generic tail after the store, so folds inside this very
                # rhs still read the OLD tracked value (t: str_cat(t, "!")
                # must not see its own result).  A same-var entry is
                # cleared now in case a fast path stores and returns first.
                if cp_nm is not 0
                    if _sov_str_eq(var, cp_nm) is 1
                        cp_nm: 0
            if not
                if cp_nm is not 0
                    if _sov_str_eq(var, cp_nm) is 1
                        cp_nm: 0
                    if not
                        if rhs_pure(rhs) is 0
                            if look(rhs, cp_nm) < 0
                                cp_nm: 0
                            if not
                                cp_pend_kill: 1
            if rn is vn + 4
                if sg_match(rhs, 0, var) is 1
                    if sg_match(rhs, vn, " + 1") is 1
                        inc_var(var)
                        return
                    if sg_match(rhs, vn, " - 1") is 1
                        dec_var(var)
                        return
            if try_slot_forms(var, rhs) is 1
                drop_str(var)
                return
            if try_def_peek(var, rhs) is 1
                drop_str(var)
                return
            if try_self_chain(var, rhs) is 1
                drop_str(var)
                return
            if try_self_infix(var, rhs) is 1
                drop_str(var)
                return
            if try_stmt_inline(var, rhs) is 1
                return
            if rn > vn + 3
                if sg_match(rhs, 0, var) is 1
                    if sg_match(rhs, vn, " + ") is 1
                        other: strip(cut(rhs, vn + 3, rn))
                        if length(other) > 0
                            if look(other, "(") < 0
                                if look(other, " ") < 0
                                    if digitb(peek_byte(other, 0)) is 1
                                        add_imm(var, num_of(other))
                                        drop_str(var)
                                        return
                                    add_into(var, repl(other, " ", "_"))
                                    drop_str(var)
                                    return
                                rs: reg_slot(var)
                                if rs > 0 - 1
                                    cflush(var)
                                    cp_ok: 1
                                    cp_kill: 0
                                    expr(other)
                                    cp_ok: 0
                                    add_rax_slot(rs)
                                    drop_str(var)
                                    return
                                if not
                                    sl6: lsh_find_s(var)
                                    if sl6 > 4
                                        mm3: mem_scaled(other)
                                        if mm3 > 0 - 1
                                            cflush(var)
                                            ms3: mm3 / 65536
                                            mq3: mm3 % 65536
                                            emit_rax_scaled(ms3, mq3 / 4096, mq3 % 4096 - 128)
                                            add_rax_mem(sl6)
                                            drop_str(var)
                                            return
                                        mm4: memabs_scaled(other)
                                        if mm4 > 0 - 1
                                            cflush(var)
                                            emit_rax_abs(mm4 / 4294967296 - 1, mm4 % 4294967296)
                                            add_rax_mem(sl6)
                                            drop_str(var)
                                            return
            if rn > vn + 3
                if sg_match(rhs, 0, var) is 1
                    if sg_match(rhs, vn, " - ") is 1
                        other: strip(cut(rhs, vn + 3, rn))
                        if length(other) > 0
                            if look(other, "(") < 0
                                if look(other, " ") < 0
                                    if digitb(peek_byte(other, 0)) is 1
                                        add_imm(var, 0 - num_of(other))
                                        drop_str(var)
                                        return
                                    sub_into(var, repl(other, " ", "_"))
                                    drop_str(var)
                                    return
                                rs: reg_slot(var)
                                if rs > 0 - 1
                                    cflush(var)
                                    cp_ok: 1
                                    cp_kill: 0
                                    expr(other)
                                    cp_ok: 0
                                    sub_rax_slot(rs)
                                    drop_str(var)
                                    return
            if length(rhs) > 0
                if digitb(peek_byte(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        if br_depth is 0
                            nv: num_of(rhs)
                            if cfind1(rhs, 46) < 0
                                cset(var, nv)
                            if nv > 0
                                kn: var
                                kv: nv
                                dhkn: plog_kn(nv, var)
                            drop_str(var)
                            if has_vm is 0
                                if cfind1(rhs, 46) < 0
                                    return
            if try_alloc_imm(var, rhs) is 1
                mark_str(var)
                return
            if length(rhs) is 1
                if peek_byte(rhs, 0) is 48
                    zl: lsh_find_s(var)
                    if zl > 0 - 1
                        if gn_lookup(var) < 0
                            if zl < 5
                                cset(var, 0)
                                if zl is 0
                                    emit3(72, 49, 219)
                                if not
                                    emit2(77, 49)
                                    emit(192 + 9 * (zl + 3))
                                zi: cn_lookup(var)
                                cemt: _sov_list_set(cemt, zi, 1)
                                dhf_z1: plog_str(4, var)
                                drop_str(var)
                                return
                            if leaf8 is 1
                                if zl < 9
                                    cset(var, 0)
                                    emit2(77, 49)
                                    emit(192 + 9 * (zl - 5))
                                    zi: cn_lookup(var)
                                    cemt: _sov_list_set(cemt, zi, 1)
                                    dhf_z2: plog_str(4, var)
                                    drop_str(var)
                                    return
            fa0: peek_byte(rhs, 0)
            fa_go: 0
            if digitb(fa0) is 1
                if cfind1(rhs, 32) < 0
                    if _sov_starts_with(rhs, "0x") is 1
                        rax_imm(num_of(rhs))
                        fa_go: 1
                    if fa_go is 0
                        if _sov_starts_with(rhs, "0b") is 1
                            rax_imm(num_of(rhs))
                            fa_go: 1
                    if fa_go is 0
                        if is_imm(rhs) is 1
                            rax_imm(num_of(rhs))
                            fa_go: 1
            if fa_go is 0
                if look(rhs, " ") < 0
                    if look(rhs, "(") < 0
                        if expr_atom(rhs) is 1
                            if expr_atom_word(rhs) is 1
                                loadv(rhs)
                                fa_go: 1
            if fa_go is 1
                typ: 0
                storev(var)
                drop_str(var)
                return
            cp_ok: 1
            cp_kill: 0
            typ: expr(rhs)
            cp_ok: 0
            storev(var)
            if cpx_p > 0 - 1
                cp_nm: var
                cp_ln: cpx_p
                cp_txt: cpx_t
                cp_bid0: cp_bid
                cp_gen0: cp_gen
                cp_dep0: _sov_list_len(bk)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if _sov_starts_with(rhs, "_sov_strlen(") is 1
                if did_stos is 1
                    if kv > 0
                        kn: var
            return
    cp_nm: 0
    if wid is kid_private
        fw_on: 1
        return
    if wid is kid_wipe
            expr(strip(cut(s, 5, length(s))))
            mov_rdi_rax()
            emit3(72, 133, 255)
            wsk: jz()
            emit(87)
            used_sl: 1
            calln("_sov_strlen")
            emit3(72, 137, 193)
            emit(95)
            xor_rax()
            emit3(252, 243, 170)
            patch(wsk)
            return
    if wid is kid_join
        expr(strip(cut(s, 5, length(s))))
        stmt_join_op()
        return
    if wid is kid_print
            arg: strip(cut(s, 6, length(s)))
            if ends_times(arg) is 1
                head: strip(cut(arg, 0, length(arg) - 6))
                sp: find_last_sp(head)
                if sp > 0 - 1
                    do_print_times(strip(cut(head, 0, sp)), strip(cut(head, sp + 1, length(head))))
                    return
            if length(arg) >= 8
                if sg_match(arg, length(arg) - 8, " as text") is 1
                    expr(cut(arg, 0, length(arg) - 8))
                    mov_rdi_rax()
                    used_pr: 1
                    calln("_sov_print")
                    return
            if length(arg) >= 7
                if sg_match(arg, length(arg) - 7, " as ptr") is 1
                    expr(cut(arg, 0, length(arg) - 7))
                    mov_rdi_rax()
                    used_pr: 1
                    calln("_sov_print")
                    return
            if length(arg) > 1
                if peek_byte(arg, 0) is 34
                    lit: unesc(cut(arg, 1, length(arg) - 1))
                    emit_write_lit(join(lit, "\n"))
                    return
            if _sov_starts_with(arg, "peek_byte(") is 1
                if opt_imm > 0
                    emit_write_lit(i2s(opt_imm))
                    return
            if print_const(arg) is 1
                return
            typ: expr(arg)
            mov_rdi_rax()
            if typ is 1
                used_pr: 1
                calln("_sov_print")
            if not
                used_pi: 1
                calln("_sov_print_int")
            return
    if wid is kid_return
        if peek_byte(s, 6) is 0
            if in_entry_now is 1
                if sxe_mode is 1
                    xor_rax()
                    leave()
                    ret()
                if not
                    emit2(49, 255)
                    emit_sys_num(60)
                    emit_sys_do()
                return
            if fw_on is 1
                if no_frame is 0
                    canary_check()
                    xor_rax()
                    restores()
                    frame_wipe()
                    stmt_leave_op()
                    ret()
                    return
            xor_rax()
            leave()
            ret()
            return
    if wid is kid_return
        if peek_byte(s, 6) is 32
            typ: expr(cut(s, 7, length(s)))
            if typ is 1
                saw_str: 1
            if in_entry_now is 1
                if sxe_mode is 1
                    leave()
                    ret()
                if not
                    emit3(72, 137, 199)
                    emit_sys_num(60)
                    emit_sys_do()
                return
            if fw_on is 1
                if no_frame is 0
                    canary_check()
                    emit(80)
                    restores()
                    frame_wipe()
                    emit(88)
                    stmt_leave_op()
                    ret()
                    return
            leave()
            ret()
            return
    if wid is kid_stop
            emit2(49, 255)
            emit_sys_num(60)
            emit_sys_do()
            return
    if wid is kid_leave
            ld: _sov_list_len(bk) - 1
            lfound: 0
            lbad: 0
            as long as ld > 0 - 1
                lkind: peek_i64(bk, 16 + ld * 8)
                if lkind is kid_try
                    lbad: 1
                    ld: 0 - 1
                if not
                    if lkind is kid_except
                        lbad: 1
                        ld: 0 - 1
                    if not
                        if lkind is kid_while
                            lfound: ld + 1
                            ld: 0 - 1
                        if not
                            if lkind is kid_forever
                                lfound: ld + 1
                                ld: 0 - 1
                            if not
                                if lkind is kid_repeat
                                    lfound: ld + 1
                                    ld: 0 - 1
                                if not
                                    ld: ld - 1
            if lbad is 1
                print "Error: leave cannot cross try"
                _sov_print(s)
                err_where()
                had_err: 1
                return
            if lfound is 0
                print "Error: leave needs a loop around it"
                _sov_print(s)
                err_where()
                had_err: 1
                return
            ld: lfound - 1
            cflush_all()
            lx: peek_i64(bx, 16 + ld * 8)
            lx: _sov_list_add(lx, jmp())
            bx: _sov_list_set(bx, ld, lx)
            return
    if look(s, "(") < 0
        print "Error: bad line"
        _sov_print(s)
        err_where()
        had_err: 1
        return
    val_dead: 1
    expr(s)
    val_dead: 0
try_alloc_imm var rhs:
    if _sov_starts_with(rhs, "_sov_heap_alloc(") is 0
        return 0
    if _sov_str_eq(var, skip_al) is 1
        return 1
    r: try_sbss(var, rhs)
    if r is 1
        return 1
    if has_vm is 0
        if peek_byte(rhs, length(rhs) - 1) is 41 is 1
            inn: strip(cut(rhs, 11, length(rhs) - 1))
            asz: 0
            if _sov_str_eq(inn, kn) is 1
                if kv > 0
                    asz: kv
            if asz is 0
                if length(inn) > 0
                    if digitb(peek_byte(inn, 0)) is 1
                        if look(inn, " ") < 0
                            asz: num_of(inn)
            if asz > 511
                emit_mmap_k(asz)
                storev(var)
                return 1
emit_used:
    
    plat_used()
    if used_al is 1
        if gn_lookup("heap_ptr") is 0 - 1
            glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_alloc()
    if used_pr is 1
        used_sl: 1
    if used_sl is 1
        emit_strlen()
    if used_eq is 1
        emit_streq()
    if used_pr is 1
        emit_print()
    if used_pi is 1
        emit_print_int()
    if used_tr is 1
        emit_trap_stub()
    plat_canary()
leave:
    if no_frame is 1
        if fn_save_n > 4
            emit(65)
            emit(95)
        if fn_save_n > 3
            emit(65)
            emit(94)
        if fn_save_n > 2
            emit(65)
            emit(93)
        if fn_save_n > 1
            emit(65)
            emit(92)
        if fn_save_n > 0
            emit(91)
        return 0
    leave_reload()
    restores()
    stmt_leave_op()
spawn_emit name argc:
    
    ai: argc - 1
    as long as ai > 0 - 1
        pop_rax()
        spawn_arg(ai)
        ai: ai - 1
    spawn_finish(name)
emit_trap_stub:
    fn_names: _sov_list_add(fn_names, "_sov_trap")
    fn_offs: _sov_list_add(fn_offs, here())
    dht0: plog_h0()
    emit_write_lit("trap\n")
    emit2(106, 1)
    emit(95)
    emit_sys_num(60)
    emit_sys_do()
    dht1: plog_h1("_sov_trap")
load_glob name:
    r: is_rel()
    if r is 1
        emit3(72, 139, 5)
        at: here()
        emit4(0)
        addp(at, "grel", name)
        return 0
    if not
        emit2(73, 187)
        at: here()
        emit8(0)
        addp(at, "glob", name)
        emit3(73, 139, 3)
        return 0
store_glob name:
    r: is_rel()
    if r is 1
        emit3(72, 137, 5)
        at: here()
        emit4(0)
        addp(at, "grel", name)
        return 0
    if not
        emit2(73, 187)
        at: here()
        emit8(0)
        addp(at, "glob", name)
        emit3(73, 137, 3)
        return 0
emit_canary_fail:
    fn_names: _sov_list_add(fn_names, "_sov_canary_fail")
    fn_offs: _sov_list_add(fn_offs, here())
    dhc0: plog_h0()
    emit_write_lit("stack\n")
    canary_die()
    dhc1: plog_h1("_sov_canary_fail")
canary_check:
    can_used: 1
    emit3(72, 139, 13)
    cat: here()
    emit4(0)
    addp(cat, "grel", "g_canary")
    emit3(72, 57, 141)
    cat2: here()
    emit4(0)
    cd_at: _sov_list_add(cd_at, cat2)
    br_at: _sov_list_add(br_at, cat2)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, cat2)
    br_st: _sov_list_add(br_st, 0)
    emit2(15, 133)
    cat3: here()
    emit4(0)
    addp(cat3, "rel", "_sov_canary_fail")
canary_store:
    can_used: 1
    emit3(72, 139, 5)
    cst: here()
    emit4(0)
    addp(cst, "grel", "g_canary")
    emit3(72, 137, 133)
    cst2: here()
    emit4(0)
    cd_at: _sov_list_add(cd_at, cst2)
    br_at: _sov_list_add(br_at, cst2)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, cst2)
    br_st: _sov_list_add(br_st, 0)
cflush name:
    dhf_b: plog_str(4, name)
    ci: cn_lookup(name)
    if ci < 0
        return
    if peek_i64(cemt, 16 + ci * 8) is 1
        return
    if peek_i64(cvls, 16 + ci * 8) is 0
        cl: lsh_find_s(name)
        if cl > 0 - 1
            if cl is 0
                emit3(72, 49, 219)
                cemt: _sov_list_set(cemt, ci, 1)
                return
            if cl < 5
                emit2(77, 49)
                emit(192 + 9 * (cl + 3))
                cemt: _sov_list_set(cemt, ci, 1)
                return
            if leaf8 is 1
                if cl < 9
                    emit2(77, 49)
                    emit(192 + 9 * (cl - 5))
                    cemt: _sov_list_set(cemt, ci, 1)
                    return
    rax_imm(peek_i64(cvls, 16 + ci * 8))
    cemt: _sov_list_set(cemt, ci, 1)
    if lsh_find_s(name) < 0
        if gn_lookup(name) > 0 - 1
            store_glob(name)
            return
    store_loc(slot(name))
cflush_all:
    dhf_a: plog_mark(3)
    # dirty-stack drain: cset records every (re)dirtied index, so this is
    # O(dirty events) instead of O(all tracked names) per call (measured
    # 3.18M scan steps per self-compile before).  Swap-out first so a
    # re-entrant cflush_all sees a fresh stack; stale entries are no-ops
    # via the cemt check (cflush also early-outs on emitted entries).
    if cn_dstk is 0
        return
    stk: cn_dstk
    cn_dstk: 0
    sn: _sov_list_len(stk)
    i: 0
    as long as i < sn
        di: peek_i64(stk, 16 + i * 8)
        if peek_i64(cemt, 16 + di * 8) is 0
            cflush(peek_i64(cnms, 16 + di * 8))
        i: i + 1
cflush_globs:
    dhf_c: plog_mark(5)
    if cn_dstk is 0
        return
    stk: cn_dstk
    cn_dstk: 0
    sn: _sov_list_len(stk)
    i: 0
    as long as i < sn
        di: peek_i64(stk, 16 + i * 8)
        if peek_i64(cemt, 16 + di * 8) is 0
            nm: peek_i64(cnms, 16 + di * 8)
            did: 0
            if gn_lookup(nm) > 0 - 1
                if lsh_find_s(nm) < 0
                    cflush(nm)
                    did: 1
            if did is 0
                if peek_i64(cemt, 16 + di * 8) is 0
                    if cn_dstk is 0
                        cn_dstk: _sov_list_new()
                    cn_dstk: _sov_list_add(cn_dstk, di)
        i: i + 1
chk_mem extra:
    if has_vm is 1
        return
    if opt_nochk is 1
        return
    used_tr: 1
    emit3(72, 133, 255)
    emit2(15, 132)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")
    if extra is 1
        emit3(72, 59, 119)
        emit3(248, 15, 131)
        at: here()
        emit4(0)
        addp(at, "rel", "_sov_trap")
    if not
        emit3(72, 141, 70)
        emit3(8, 72, 59)
        emit3(71, 248, 15)
        emit(135)
        at: here()
        emit4(0)
        addp(at, "rel", "_sov_trap")
chk_ov:
    if has_vm is 1
