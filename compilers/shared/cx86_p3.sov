# unsafe-module
# ---- C.5 ID/hash twin dispatch -------------------------------------------
# intern_kid() returns the canonical interned pointer for a string, so
# comparing tid/wtid to these once-computed pointers is exactly equivalent to
# _sov_str_eq(tnm, "name") while removing 44 interpreted string-compare calls
# per compiled task. Pure compile-time state, one table per process, no cache.
nt_id_ready: 0
ntk__sov_c0_parse: 0
ntk__sov_base_scan: 0
ntk__sov_collect_body: 0
ntk__sov_cx_read: 0
ntk__sov_dce: 0
ntk__sov_dce_litter: 0
ntk__sov_dce_stores: 0
ntk__sov_emit_tw: 0
ntk__sov_flat_pass: 0
ntk__sov_inl2_scan: 0
ntk__sov_licm_scan: 0
ntk__sov_lines_of_fast: 0
ntk__sov_lord_build2: 0
ntk__sov_sg_extra_ls: 0
ntk__sov_st_build: 0
ntk__sov_stmt: 0
ntk_front_scan: 0
ntk_intern_kid_n: 0
ntk_kgrow_ht: 0
ntk_list_find: 0
ntk_syntax_build: 0
ntk_syntax_statement_build: 0
ntk_u_scan_wide: 0
nt_id_init:
    if nt_id_ready is 1
        return
    ntk__sov_c0_parse: intern_kid("_sov_c0_parse")
    ntk__sov_base_scan: intern_kid("_sov_base_scan")
    ntk__sov_collect_body: intern_kid("_sov_collect_body")
    ntk__sov_cx_read: intern_kid("_sov_cx_read")
    ntk__sov_dce: intern_kid("_sov_dce")
    ntk__sov_dce_litter: intern_kid("_sov_dce_litter")
    ntk__sov_dce_stores: intern_kid("_sov_dce_stores")
    ntk__sov_emit_tw: intern_kid("_sov_emit_tw")
    ntk__sov_flat_pass: intern_kid("_sov_flat_pass")
    ntk__sov_inl2_scan: intern_kid("_sov_inl2_scan")
    ntk__sov_licm_scan: intern_kid("_sov_licm_scan")
    ntk__sov_lines_of_fast: intern_kid("_sov_lines_of_fast")
    ntk__sov_lord_build2: intern_kid("_sov_lord_build2")
    ntk__sov_sg_extra_ls: intern_kid("_sov_sg_extra_ls")
    ntk__sov_st_build: intern_kid("_sov_st_build")
    ntk__sov_stmt: intern_kid("_sov_stmt")
    ntk_front_scan: intern_kid("front_scan")
    ntk_intern_kid_n: intern_kid("intern_kid_n")
    ntk_kgrow_ht: intern_kid("kgrow_ht")
    ntk_list_find: intern_kid("list_find")
    ntk_syntax_build: intern_kid("syntax_build")
    ntk_syntax_statement_build: intern_kid("syntax_statement_build")
    ntk_u_scan_wide: intern_kid("u_scan_wide")
    nt_id_ready: 1
    return 0

nt_will_twin tnm:
    # 1 exactly when try_native_body will plant a volatile-only,
    # frameless-safe twin for this fn: pre-wall leaf twins fire in
    # every program; the rest need the compiler-internals gate.
    kid_init()
    nt_id_init()
    wtid: intern_kid(tnm)
    if wtid is kid__sov_str_eq -> return 1
    if wtid is kid__sov_starts_with -> return 1
    if wtid is kid__sov_memcpy -> return 1
    if wtid is kid__sov_trim -> return 1
    if wtid is kid__sov_strlen -> return 1
    if wtid is kid__sov_list_get -> return 1
    if wtid is kid__sov_find_text -> return 1
    if nat_gate is 0 - 1
        nat_gate: 0
        if nm_lookup("emit3") > 0 - 1
            if nm_lookup("emit") > 0 - 1
                if nm_lookup("ocgrow") > 0 - 1
                    nat_gate: 1
    if nat_gate is 0 -> return 0
    if wtid is ntk_syntax_build -> return 1
    if wtid is ntk__sov_emit_tw -> return 1
    if wtid is ntk__sov_collect_body -> return 1
    if wtid is ntk__sov_lines_of_fast -> return 1
    if wtid is ntk_front_scan
        if nm_lookup("emit_nt_front_scan") > 0 - 1
            return 1
    if wtid is ntk__sov_sg_extra_ls
        if nm_lookup("emit_nt_sg_extra_ls") > 0 - 1
            return 1
    if wtid is ntk__sov_base_scan
        if nm_lookup("emit_nt_base_scan") > 0 - 1
            return 1
    if wtid is ntk__sov_st_build -> return 1
    if wtid is ntk__sov_lord_build2 -> return 1
    if wtid is ntk__sov_dce -> return 1
    if wtid is ntk__sov_dce_stores -> return 1
    if wtid is ntk__sov_dce_litter -> return 1
    if wtid is ntk_kgrow_ht -> return 1
    if wtid is ntk_list_find -> return 1
    if wtid is ntk_u_scan_wide -> return 1
    if wtid is ntk_syntax_statement_build -> return 1
    if wtid is ntk_intern_kid_n -> return 1
    if wtid is ntk__sov_cx_read -> return 1
    if wtid is ntk__sov_licm_scan -> return 1
    if wtid is ntk__sov_inl2_scan -> return 1
    if wtid is ntk__sov_c0_parse -> return 1
    if wtid is ntk__sov_stmt -> return 1
    if wtid is ntk__sov_flat_pass -> return 1
    if wtid is kid__sov_list_add -> return 1
    if wtid is kid__sov_list_len -> return 1
    if wtid is kid__sov_list_new -> return 1
    if wtid is kid_rax_imm -> return 1
    if wtid is kid_reg_slot -> return 1
    if wtid is kid_set_h -> return 1
    if wtid is kid_look -> return 1
    if wtid is kid_strip_span -> return 1
    if wtid is kid_indent_of -> return 1
    if wtid is kid_nl_count_lines -> return 1
    if wtid is kid_rpx_nonspace -> return 1
    return 0

try_native_body:
    # A native body may call compiler internals (emit3, emit, ocgrow). Those only
    # resolve when the program being compiled is the compiler itself, so gate the
    # whole mechanism on the program actually providing them. Without this a user
    # program that merely defines a colliding name gets a body full of unresolved
    # relocations - which is why 40 of the 155 target sources failed to build.
    tnm: peek_i64(fn_names, 16 + (_sov_list_len(fn_names) - 1) * 8)
    kid_init()
    nt_id_init()
    tid: intern_kid(tnm)
    # leaf native bodies that call nothing and exactly mirror their
    # runtime tasks are safe in every program; the bodies below this
    # point may reference compiler internals and stay behind nat_gate.
    if tid is kid__sov_find_text -> return emit_nt_find()
    if tid is kid__sov_list_set -> return emit_nt_list_set()
    if tid is kid__sov_str_eq -> return emit_nt_streq()
    if tid is kid__sov_starts_with -> return emit_nt_starts()
    if tid is kid__sov_memcpy -> return emit_nt_memcpy()
    if tid is kid__sov_trim -> return emit_nt_trim()
    if tid is kid__sov_strlen -> return emit_nt_strlen()
    # emit_nt_list_get is a pure leaf mirror of the runtime body (incl.
    # out-of-range -> 0). The generic compile of that body loses the zero
    # on the fused range check, so route it before the nat_gate wall.
    if tid is kid__sov_list_get -> return emit_nt_list_get()
    # f64 library mirrors on SSE2: bit-exact incl. NaN payload policy
    # (see emit_nt_f64bin).  Pure leaves, safe in every program.
    if tid is kid_f64_add -> return emit_nt_f64add()
    if tid is kid_f64_sub -> return emit_nt_f64sub()
    if tid is kid_f64_mul -> return emit_nt_f64mul()
    if tid is kid_f64_div -> return emit_nt_f64div()
    if tid is kid_f64_cmp -> return emit_nt_f64cmp()
    if tid is kid_f64_sqrt -> return emit_nt_f64sqrt()
    if tid is kid_f64_from_i64 -> return emit_nt_f64from()
    if tid is kid_f64_to_i64 -> return emit_nt_f64to()
    if tid is kid_pu_find_use -> return emit_nt_pu_find()
    if tid is kid_sp_hinc_lim -> return emit_nt_sp_inc()
    if nat_gate is 0 - 1
        nat_gate: 0
        if nm_lookup("emit3") > 0 - 1
            if nm_lookup("emit") > 0 - 1
                if nm_lookup("ocgrow") > 0 - 1
                    nat_gate: 1
    if nat_gate is 0 -> return 0
    if tid is ntk_syntax_build -> return emit_nt_syntax_build()
    if tid is ntk__sov_emit_tw -> return emit_nt_syntax_emit_tw()
    if tid is ntk__sov_collect_body -> return emit_nt_collect_body()
    if tid is ntk__sov_lines_of_fast -> return emit_nt_lines_of_fast()
    # C.2/C.11 fused front-end scan. Guarded by the emitter's own presence
    # so a user program that merely defines a task named front_scan can
    # never pick up an unresolved symbol.
    if tid is ntk_front_scan
        if nm_lookup("emit_nt_front_scan") > 0 - 1
            return emit_nt_front_scan()
    if tid is ntk__sov_sg_extra_ls
        if nm_lookup("emit_nt_sg_extra_ls") > 0 - 1
            return emit_nt_sg_extra_ls()
    if tid is ntk__sov_base_scan
        if nm_lookup("emit_nt_base_scan") > 0 - 1
            return emit_nt_base_scan()
    if tid is ntk__sov_st_build -> return emit_nt_st_build()
    if tid is ntk__sov_lord_build2 -> return emit_nt_lord_build()
    if tid is ntk__sov_dce -> return emit_nt_dce()
    if tid is ntk__sov_dce_stores -> return emit_nt_dce_stores()
    if tid is ntk__sov_dce_litter -> return emit_nt_dce_litter()
    if tid is ntk_kgrow_ht -> return emit_nt_kgrow_ht()
    if tid is ntk_list_find -> return emit_nt_list_find()
    if tid is ntk_u_scan_wide -> return emit_nt_u_scan_core()
    if tid is ntk_syntax_statement_build -> return emit_nt_syntax_statements()
    if tid is ntk__sov_cx_read -> return emit_nt_cx_read()
    if tid is ntk__sov_licm_scan -> return emit_nt_licm_scan()
    if tid is ntk__sov_inl2_scan -> return emit_nt_inl2_scan()
    if tid is ntk__sov_c0_parse -> return emit_nt_c0_parse()
    if tid is ntk__sov_stmt -> return emit_nt_stmt()
    if tid is ntk__sov_flat_pass -> return emit_nt_flat_pass()
    if tid is ntk_intern_kid_n -> return emit_nt_intern_kid_n()
    if tid is kid_intern_kid -> return emit_nt_intern_kid()
    if tid is kid_word_id -> return emit_nt_word_id()
    if tid is kid_nhash -> return emit_nt_nhash()
    if tid is kid_intern_fast -> return emit_nt_intern_fast()
    # emit_nt_look disabled: its needle-length-dispatched scan reads 4-6
    # bytes past the haystack NUL; on exact-fit large buffers that hits the
    # allocator guard page (banded segfaults by input size). Sovren look via
    # bounded _sov_find_text is used until the twin is bounds-fixed.
    # (2026-10-29 re-test: current emit_nt_look is a thin dispatcher to the
    # same plants; enabling measured 0.0 ms -- the wrapper is already thin.)
    if tid is kid_length -> return emit_nt_length()
    if tid is kid_cut -> return emit_nt_cut()
    # PARKED (2026-11-07): the Phase-3 lsh twins diverge from the
    # interpreted bodies through the lord-seeding/home machinery (spilled
    # register homes, then undeclared-name cascades in runtime compiles);
    # probes pass but real compiles diverge. The twins stay off until the
    # divergence is root-caused; the interpreted path below is the
    # certified one (oracle-clean, fixed point one shot).
    if 0 is 1 -> return emit_nt_lsh_find()
    if tid is kid_reg_slot -> return emit_nt_reg_slot()
    if tid is kid_rax_imm -> return emit_nt_rax_imm()
    if 0 is 1 -> return emit_nt_lsh_add()
    if tid is kid_lb_words -> return emit_nt_lb_words()
    if tid is kid_set_h -> return emit_nt_set_h()
    if tid is kid_cx_info -> return emit_nt_cx_info()
    if tid is kid_fl_span_tally -> return emit_nt_fl_tally()
    if tid is kid_fl_span_count -> return emit_nt_fl_count()
    if tid is kid_fl_span_newt -> return emit_nt_fl_newt()
    # DISP-OFF: if tid is kid_split_args -> return emit_nt_split_args()
    #   (destructive span split landed: the .sov body pokes NULs into the
    #   private inside buffer and stores in-place pointers, so the twin's
    #   per-arg cut+strip calls would re-introduce the allocs the rewrite
    #   removed)
    if tid is kid_strip -> return emit_nt_strip()
    if tid is kid_same -> return emit_nt_same()
    if tid is kid_expr_atom -> return emit_nt_expr_atom()
    if tid is kid_digitb -> return emit_nt_digitb()
    if tid is kid_find_col -> return emit_nt_find_col()
    if tid is kid_find_col_q -> return emit_nt_find_col_q()
    if tid is kid_is_imm -> return emit_nt_is_imm()
    if tid is kid_wordchar -> return emit_nt_wordchar()
    if tid is kid_plain_name -> return emit_nt_plain_name()
    if tid is kid_starts -> return emit_nt_starts()
    if tid is kid_unesc -> return emit_nt_unesc()
    if tid is kid_unquote -> return emit_nt_unquote()
    if tid is kid_find_sep_do -> return emit_nt_find_sep_do()
    if tid is kid_join -> return emit_nt_join()
    if tid is kid_letter -> return emit_nt_letter()
    if tid is kid_sg_bare -> return emit_nt_sg_bare()
    if tid is kid_sg_word -> return emit_nt_sg_word()
    if tid is kid_name_ok -> return emit_nt_name_ok()
    if tid is kid_sg_match_n -> return emit_nt_sg_match_n()
    if tid is kid_sg_match -> return emit_nt_sg_match()
    if tid is kid_sg_thresh -> return emit_nt_sg_thresh()
    if tid is kid_bt_prep -> return emit_nt_bt_prep()
    if tid is kid_sg_marks -> return emit_nt_sg_marks()
    if tid is kid_sg_plain -> return emit_nt_sg_plain()
    if tid is kid_sg_cut_at -> return emit_nt_sg_cut_at()
    if tid is kid_next_evt -> return emit_nt_next_evt()
    if tid is kid_sg_cat2 -> return emit_nt_sg_cat2()
    if tid is kid_sg_cat3 -> return emit_nt_sg_cat3()
    if tid is kid_sg_cat4 -> return emit_nt_sg_cat4()
    if tid is kid_sg_cat5 -> return emit_nt_sg_cat5()
    if tid is kid_sg_cat6 -> return emit_nt_sg_cat6()
    if tid is kid_list_reuse -> return emit_nt_list_reuse()
    if tid is kid_ocgrow -> return emit_nt_ocgrow()
    if tid is kid_ocput -> return emit_nt_ocput()
    if tid is kid_emit2 -> return emit_nt_emit2()
    if tid is kid_emit3 -> return emit_nt_emit3()
    if tid is kid_emit4 -> return emit_nt_emit4()
    if tid is kid_emit8 -> return emit_nt_emit8()
    if tid is kid_here -> return emit_nt_here()
    if tid is kid_oc_here -> return emit_nt_here()
    if tid is kid_emit -> return emit_nt_emit()
    if tid is kid_ocget -> return emit_nt_ocget()
    if tid is kid_ocset -> return emit_nt_ocset()
    if tid is kid_jz -> return emit_nt_jcc(132)
    if tid is kid_jnz -> return emit_nt_jcc(133)
    if tid is kid_jne -> return emit_nt_jcc(133)
    if tid is kid_jae -> return emit_nt_jcc(131)
    if tid is kid_jb -> return emit_nt_jcc(130)
    if tid is kid_jg -> return emit_nt_jcc(143)
    if tid is kid_jge -> return emit_nt_jcc(141)
    if tid is kid_jl -> return emit_nt_jcc(140)
    if tid is kid_jle -> return emit_nt_jcc(142)
    if tid is kid_jmp -> return emit_nt_jmp()
    if tid is kid_ret -> return emit_nt_ret()
    if tid is kid_test_rax -> return emit_nt_test_rax()
    if tid is kid_rexx -> return emit_nt_rexx()
    if tid is kid_patch -> return emit_nt_patch()
    if tid is kid_addp -> return emit_nt_addp()
    if tid is kid_pop_rax -> return emit_nt_e1(88)
    if tid is kid_pop_rcx -> return emit_nt_e1(89)
    if tid is kid_xor_rax -> return emit_nt_e3(72, 49, 192)
    if tid is kid_add_rax_rcx -> return emit_nt_e3(72, 1, 200)
    if tid is kid_cmp_rax_rcx -> return emit_nt_e3(72, 57, 200)
    if tid is kid_mov_rax_rcx -> return emit_nt_e3(72, 137, 200)
    if tid is kid_mov_rax_rdi -> return emit_nt_e3(72, 137, 248)
    if tid is kid_mov_rax_rsi -> return emit_nt_e3(72, 137, 240)
    if tid is kid_mov_rcx_rsi -> return emit_nt_e3(72, 137, 241)
    if tid is kid_mov_rcx_rax -> return emit_nt_e3(72, 137, 193)
    if tid is kid_mov_rdi_rax -> return emit_nt_e3(72, 137, 199)
    if tid is kid_mov_rsi_rax -> return emit_nt_e3(72, 137, 198)
    if tid is kid_mov_rcx_rdx -> return emit_nt_e3(72, 137, 209)
    if tid is kid_sub_rax_rcx -> return emit_nt_e3(72, 41, 200)
    if tid is kid_sysc_raw -> return emit_nt_e2(15, 5)
    if tid is kid_push_rax -> return emit_nt_push_rax()
    if tid is kid_sibx -> return emit_nt_sibx()
    if tid is kid_imul_rax_rcx -> return emit_nt_imul_rax_rcx()
    if tid is kid_poke8 -> return emit_nt_poke8()
    if tid is kid_poke4 -> return emit_nt_poke4()
    if tid is kid_emit_peek_rax -> return emit_nt_emit_peek_rax()
    if tid is kid_dir_of -> return emit_nt_dir_of()
    if tid is kid__sov_strlen -> return emit_nt_strlen()
    if tid is kid__sov_str_eq -> return emit_nt_streq()
    if tid is kid__sov_starts_with -> return emit_nt_starts()
    if tid is kid_cfind1 -> return emit_nt_cfind1()
    if tid is kid_cfind1n -> return emit_nt_cfind1n()
    # emit_nt_look re-enabled (session 9): the current shape is the thin
    # dispatcher (one-byte needles -> the bounds-safe cfind1 twin, longer
    # needles -> _sov_find_text); the 2026-10-29 re-test verified it runs
    # clean, and the fnmap shows the interpreted wrapper at ~1% of self.
    if tid is kid_look -> return emit_nt_look()
    if tid is kid_strip_span -> return emit_nt_strip_span()
    if tid is kid_indent_of -> return emit_nt_indent_of()
    if tid is kid_nl_count_lines -> return emit_nt_nl_count_lines()
    if tid is kid_rpx_nonspace -> return emit_nt_rpx_nonspace()
    # DISP-OFF: if tid is kid_split_args -> return emit_nt_split_args()
    if tid is kid__sov_list_len -> return emit_nt_list_len()
    if tid is kid__sov_list_get -> return emit_nt_list_get()
    if tid is kid__sov_list_new -> return emit_nt_list_new()
    if tid is kid__sov_list_add -> return emit_nt_list_add()
    if tid is kid_sg_ind -> return emit_nt_sg_ind()
    if tid is kid_sg_sqok -> return emit_nt_sg_sqok()
    if tid is kid_intern -> return emit_nt_intern()
    if tid is kid__sov_bzero -> return emit_nt_bzero()
    if tid is kid__sov_substring -> return emit_nt_substr()
    if tid is kid__sov_strcat -> return emit_nt_strcat()
    return 0

sln_n: 0
# strip/indent come from the classify pass instead of re-deriving them.
bxs_st: 0
bxs_ix: 0
bxs_si: 0
bxs_r: 0
ds_ok: 0
lh_tab: 0
lh_tgs: 0
lh_slots: 0
lh_mask: 0
lh_srclen: 0
lh_gen: 1
lh_alloc:
    # Phase-3 name table: pre-sized from the source length so the table
    # never fills mid-function. The old fixed 65536 slots wrapped idx into
    # the gen field past 65536 live locals (vars4m segfault) and turned
    # every probe into a near-full scan at 100k (loc100k 26.5s). Slots =
    # pow2 >= u_srclen/12, floor 16384 so both arrays stay >64KiB (fresh
    # mmap, zero-filled, no explicit clear) even for tiny files. Keys and
    # tags are separate arrays so the native twins address each with a
    # plain [base+s*8].
    if lh_tab is not 0
        return 0
    n: 16384
    as long as n * 12 < lh_srclen
        n: n + n
    lh_slots: n
    lh_mask: n - 1
    lh_tab: _sov_heap_alloc(n * 8)
    lh_tgs: _sov_heap_alloc(n * 8)
    if n * 8 <= 65536
        dummy: _sov_bzero(lh_tab, n * 8)
        dummy: _sov_bzero(lh_tgs, n * 8)
    return 0
lh_grow:
    # safety valve: a function with more unique locals than slots doubles
    # the table and rehashes the current generation (tag keeps gen and
    # idx, so probe results are unchanged). The old arrays leak: growth is
    # a rare event and the process exits after the compile.
    nn: lh_slots + lh_slots
    nk: _sov_heap_alloc(nn * 8)
    nt: _sov_heap_alloc(nn * 8)
    if nn * 8 <= 65536
        dummy: _sov_bzero(nk, nn * 8)
        dummy: _sov_bzero(nt, nn * 8)
    i: 0
    as long as i < lh_slots
        ok: peek_i64(lh_tab, i * 8)
        if ok is not 0
            tg: peek_i64(lh_tgs, i * 8)
            if tg / 4294967296 is lh_gen
                h: nhash(ok)
                s: band(h, nn - 1)
                as long as peek_i64(nk, s * 8) is not 0
                    s: band(s + 1, nn - 1)
                dummy: poke_i64(nk, s * 8, ok)
                dummy: poke_i64(nt, s * 8, tg)
        i: i + 1
    lh_tab: nk
    lh_tgs: nt
    lh_slots: nn
    lh_mask: nn - 1
    return 0
lsh_reset:
    if lh_tab is 0
        d: lh_alloc()
    lh_gen: lh_gen + 1
    return 0
sh_sig: 0
sh_len: 0 - 1
gl_sig: 0
gl_len: 0 - 1
sig_tab_build lst:
    tab: _sov_heap_alloc(65536)
    dummy: _sov_bzero(tab, 65536)
    q: 0
    ln: _sov_list_len(lst)
    as long as q < ln
        sv: peek_i64(lst, 16 + q * 8)
        a: peek_byte(sv, 0)
        b: peek_byte(sv, 1)
        dummy: poke_byte(tab, a * 256 + b, 1)
        q: q + 1
    return tab
sig_maybe tab v:
    a: peek_byte(v, 0)
    b: peek_byte(v, 1)
    return peek_byte(tab, a * 256 + b)
lsh_shadow_warn v:
    if glob_names is not 0
        if gl_len is not _sov_list_len(glob_names)
            gl_sig: sig_tab_build(glob_names)
            gl_len: _sov_list_len(glob_names)
        ga: peek_byte(v, 0)
        gb: peek_byte(v, 1)
        if peek_byte(gl_sig, ga * 256 + gb) is 1
            if gn_lookup(v) > 0 - 1
                print "Warning: local shadows a global with the same name"
                _sov_print(v)
                err_where()
    if names is not 0
        if sh_len is not _sov_list_len(names)
            sh_sig: sig_tab_build(names)
            sh_len: _sov_list_len(names)
        sa: peek_byte(v, 0)
        sb: peek_byte(v, 1)
        if peek_byte(sh_sig, sa * 256 + sb) is 1
            if nm_lookup(v) > 0 - 1
                print "Warning: local shadows a function name"
                _sov_print(v)
                err_where()
lsh_add_full v:
    # probe first, append only when the name is new: slot indices stay
    # dense (0..uniques-1) and _sov_list_len(locals) is the unique count
    # the frame patcher sizes by.  The old append-always form left a
    # duplicate entry per re-add, inflating later indices past the
    # ranked register slots preseed computes.  The shadow warning is
    # gone with the parked twins: the certified binary's lsh path never
    # warned (the old twins bypassed lsh_shadow_warn), so warning here
    # would change refuse-parity stdout (addons/run gained two).
    if lh_tab is 0
        d: lh_alloc()
    h: nhash(v)
    s: band(h, lh_mask)
    g: 0
    as long as g < lh_slots
        ve: peek_i64(lh_tab, s * 8)
        if ve is 0
            idx: _sov_list_len(locals)
            locals: _sov_list_add(locals, v)
            dummy: poke_i64(lh_tab, s * 8, v)
            dummy: poke_i64(lh_tgs, s * 8, lh_gen * 4294967296 + idx + 1)
            return idx
        ve2: peek_i64(lh_tgs, s * 8)
        if ve2 / 4294967296 is not lh_gen
            idx: _sov_list_len(locals)
            locals: _sov_list_add(locals, v)
            dummy: poke_i64(lh_tab, s * 8, v)
            dummy: poke_i64(lh_tgs, s * 8, lh_gen * 4294967296 + idx + 1)
            return idx
        if ve is v
            return (ve2 % 4294967296) - 1
        if _sov_str_eq(ve, v) is 1
            return (ve2 % 4294967296) - 1
        s: band(s + 1, lh_mask)
        g: g + 1
    d: lh_grow()
    idx: _sov_list_len(locals)
    locals: _sov_list_add(locals, v)
    h2: nhash(v)
    s2: band(h2, lh_mask)
    as long as peek_i64(lh_tab, s2 * 8) is not 0
        s2: band(s2 + 1, lh_mask)
    dummy: poke_i64(lh_tab, s2 * 8, v)
    dummy: poke_i64(lh_tgs, s2 * 8, lh_gen * 4294967296 + idx + 1)
    return idx

lsha2 v:
    # probe first, append only when the name is new: slot indices stay
    # dense (0..uniques-1) and _sov_list_len(locals) is the unique count
    # the frame patcher sizes by.  The old append-always form left a
    # duplicate entry per re-add, inflating later indices past the
    # ranked register slots preseed computes.
    if lh_tab is 0
        d: lh_alloc()
    h: nhash(v)
    s: band(h, lh_mask)
    g: 0
    as long as g < lh_slots
        ve: peek_i64(lh_tab, s * 8)
        if ve is 0
            idx: _sov_list_len(locals)
            locals: _sov_list_add(locals, v)
            dummy: poke_i64(lh_tab, s * 8, v)
            dummy: poke_i64(lh_tgs, s * 8, lh_gen * 4294967296 + idx + 1)
            return idx
        ve2: peek_i64(lh_tgs, s * 8)
        if ve2 / 4294967296 is not lh_gen
            idx: _sov_list_len(locals)
            locals: _sov_list_add(locals, v)
            dummy: poke_i64(lh_tab, s * 8, v)
            dummy: poke_i64(lh_tgs, s * 8, lh_gen * 4294967296 + idx + 1)
            return idx
        if ve is v
            return (ve2 % 4294967296) - 1
        if _sov_str_eq(ve, v) is 1
            return (ve2 % 4294967296) - 1
        s: band(s + 1, lh_mask)
        g: g + 1
    d: lh_grow()
    idx: _sov_list_len(locals)
    locals: _sov_list_add(locals, v)
    h2: nhash(v)
    s2: band(h2, lh_mask)
    as long as peek_i64(lh_tab, s2 * 8) is not 0
        s2: band(s2 + 1, lh_mask)
    dummy: poke_i64(lh_tab, s2 * 8, v)
    dummy: poke_i64(lh_tgs, s2 * 8, lh_gen * 4294967296 + idx + 1)
    return idx

lsh_find_full v:
    if locals is 0
        return 0 - 1
    if lh_tab is 0
        if _sov_list_len(locals) is 0
            return 0 - 1
        d0: lsh_reset()
        li: 0
        ln: _sov_list_len(locals)
        as long as li < ln
            lv2: peek_i64(locals, 16 + li * 8)
            h9: nhash(lv2)
            s9: band(h9, lh_mask)
            g9: 0
            as long as g9 < lh_slots
                if peek_i64(lh_tab, s9 * 8) is 0
                    dummy: poke_i64(lh_tab, s9 * 8, lv2)
                    dummy: poke_i64(lh_tgs, s9 * 8, lh_gen * 4294967296 + li + 1)
                    g9: lh_slots
                s9: band(s9 + 1, lh_mask)
                g9: g9 + 1
            li: li + 1
    h: nhash(v)
    s: band(h, lh_mask)
    g: 0
    as long as g < lh_slots
        ve: peek_i64(lh_tab, s * 8)
        if ve is 0
            return 0 - 1
        ve2: peek_i64(lh_tgs, s * 8)
        if ve2 / 4294967296 is lh_gen
            idx: (ve2 % 4294967296) - 1
            if ve is v
                return idx
            if _sov_str_eq(ve, v) is 1
                return idx
        s: band(s + 1, lh_mask)
        g: g + 1
    return 0 - 1

lshf2 v:
    if locals is 0
        return 0 - 1
    if lh_tab is 0
        if _sov_list_len(locals) is 0
            return 0 - 1
        d0: lsh_reset()
        li: 0
        ln: _sov_list_len(locals)
        as long as li < ln
            lv2: peek_i64(locals, 16 + li * 8)
            h9: nhash(lv2)
            s9: band(h9, lh_mask)
            g9: 0
            as long as g9 < lh_slots
                if peek_i64(lh_tab, s9 * 8) is 0
                    dummy: poke_i64(lh_tab, s9 * 8, lv2)
                    dummy: poke_i64(lh_tgs, s9 * 8, lh_gen * 4294967296 + li + 1)
                    g9: lh_slots
                s9: band(s9 + 1, lh_mask)
                g9: g9 + 1
            li: li + 1
    h: nhash(v)
    s: band(h, lh_mask)
    g: 0
    as long as g < lh_slots
        ve: peek_i64(lh_tab, s * 8)
        if ve is 0
            return 0 - 1
        ve2: peek_i64(lh_tgs, s * 8)
        if ve2 / 4294967296 is lh_gen
            idx: (ve2 % 4294967296) - 1
            if ve is v
                return idx
            if _sov_str_eq(ve, v) is 1
                return idx
        s: band(s + 1, lh_mask)
        g: g + 1
    return 0 - 1

nl_s: 0
nl_ind: 0
nl_prep raw:
    nl_s: raw
    nl_ind: 0
    c: 0
    i: 0
    lw: 1
    as long as lw is 1
        b: peek_byte(raw, i)
        if b is 0
            lw: 0
        if not
            if b is 9
                print "Error: tab indent, use spaces"
                _sov_print(raw)
                err_where()
                had_err: 1
                lw: 0
            if not
                if b is not 32
                    lw: 0
                if not
                    c: c + 1
                    i: i + 1
    nl_ind: c
    if peek_byte(raw, 0) < 33
        nl_s: strip(raw)
    if not
        rl: length(raw)
        rz: 0
        as long as rz < rl
            if peek_byte(raw, rl - 1 - rz) < 33
                rz: rz + 1
            if not -> leave
        lnq: rl - rz
        nl_s: raw
        if lnq > 0
            if peek_byte(raw, lnq - 1) < 33
                nl_s: strip(raw)
    return 0
bt_ok: 0
wid_hp: 0
wid_hv: 0
bt_cap: 0
bt_m: 0
bt_ind: 0
bt_col: 0
bt_eq: 0
bt_tab: 0
bt_tr: 0
bt_n: 0
bt_ci: 0
bt_sh: 0
kid_switch: 0
kid_case: 0
sk_txt: 0
sk_ind: 0
sk_dep: 0
sk_stx: 0
sk_sin: 0

bt_prep lines:
    bn: _sov_list_len(lines)
    bt_n: bn
    if bn > bt_cap
        bt_cap: 65536
        bt_m: _sov_heap_alloc(16 + bt_cap * 8)
        bt_ind: _sov_heap_alloc(16 + bt_cap * 8)
        bt_col: _sov_heap_alloc(16 + bt_cap * 8)
        bt_eq: _sov_heap_alloc(16 + bt_cap * 8)
        bt_tab: _sov_heap_alloc(16 + bt_cap * 8)
        bt_tr: _sov_heap_alloc(16 + bt_cap * 8)
    if bn > 65536
        bt_n: 0 - 1
        return 0
    bt2: 0
    as long as bt2 < bn
        btp: peek_i64(lines, 16 + bt2 * 8)
        btins: 0
        btspace: 1
        bind2: 0
        bcol: 0 - 1
        beq: 0 - 1
        bquote: 0 - 1
        btab: 0
        bj: 0
        bbb: peek_byte(btp, bj)
        as long as bbb > 0
            if btspace is 1
                if bbb is 32
                    bind2: bind2 + 1
                if not
                    btspace: 0
            if btins is 1
                if bbb is 92
                    bj: bj + 1
                if not
                    if bbb is 34
                        btins: 0
            if not
                if bbb is 9
                    btab: 1
                if not
                    if bbb is 34
                        btins: 1
                        if bquote < 0
                            bquote: bj
                    if not
                        if bbb is 58
                            if bcol < 0
                                bcol: bj
                        if not
                            if bbb is 61
                                if beq < 0
                                    beq: bj
            bj: bj + 1
            bbb: peek_byte(btp, bj)
        btr: 0
        if bj > 0
            if peek_byte(btp, bj - 1) < 33
                btr: 1
        poke_i64(bt_m, 16 + bt2 * 8, bquote)
        poke_i64(bt_ind, 16 + bt2 * 8, bind2)
        poke_i64(bt_col, 16 + bt2 * 8, bcol)
        poke_i64(bt_eq, 16 + bt2 * 8, beq)
        poke_i64(bt_tab, 16 + bt2 * 8, btab)
        poke_i64(bt_tr, 16 + bt2 * 8, btr)
        bt2: bt2 + 1
    return 0

bd_s: 0
bd_slen: 0

body lines:
    cp_bid: cp_bid + 1
    # stmt's destructive split only on bodies whose line buffers
    # nothing re-reads at walk time: ml/inl-eligible bodies are
    # captured as text pointers (mq_txt/inl_es) for later inline
    # expansion into other functions, so they keep the copying path.
    ds_ok: 0
    if walk_nm is not 0
        if ml_lookup(walk_nm) < 0
            if inl_lookup(walk_nm) < 0
                ds_ok: 1

    if try_native_body() = 1 -> return
    # locals register lazily at first use via slot(); params were
    # added by walk_range.  (The frequency-ordered preseed pass was
    # deleted: a full extra body walk whose only load-bearing effect
    # was masking err_where's read of the then-undeclared walk_nm.)
    # fx regions: splice runs of `name: <f64 tree>` into marker lines
    # (vars live in xmm8-15 across the run; stmt() routes the marker to
    # fx_region_stmt).  Skipped under tk_run (bt tables are per-line).
    if tk_run is 0
        if fx_scan(lines) is 1
            lines: fx_scan_out
            if fx_scan_sln is not 0
                stmt_lns: fx_scan_sln
    if syntax_mode > 0
        syntax_prepare_statements(lines)
        bt_ok: 1
    if not
        # bt lane always on (pass-fusion step 1): one bt_prep pass per
        # body fills the per-line indent/quote/colon/eq/tab/trailing
        # tables that the loop below and stmt read through the bt_ci
        # cursor.  The cursor is set only for simple lines (no tab, no
        # trailing ws, no outside-string '=' -- the eq gate keeps
        # compound()'s += rewrites off the cursor path, so the bt_m/
        # bt_col offsets always address the same bytes cfind1 would).
        # Tables are refilled per body; nothing reads them between
        # body() calls (collect_body is syntax-lane only).
        dummy: bt_prep(lines)
        bt_ok: 1
    if kid_switch is 0
        kid_switch: word_id("switch")
        kid_case: word_id("case")
    if sk_txt is 0
        sk_txt: blank
    if sk_stx is 0
        sk_stx: _sov_list_new()
        sk_sin: _sov_list_new()
    n: _sov_list_len(lines) ;; if n > 0 -> kid_init()
    sln_n: _sov_list_len(stmt_lns)
    i: 0
    bk: list_reuse(bk)
        bi: list_reuse(bi)
        bj: list_reuse(bj)
        bs: list_reuse(bs)
        be: list_reuse(be)
        br: list_reuse(br)
        # bx bw sk_pos sk_to reuse at the next span
        bx: list_reuse(bx)
        bw: list_reuse(bw)
        sk_pos: list_reuse(sk_pos)
        sk_to: list_reuse(sk_to)
    as long as i < n
        raw: peek_i64(lines, 16 + i * 8)
        s: raw
        hs: 0
        hsl: 0 - 1
        ind: 0
        bxs_r: 0 - 1
        if bxs_si is not 0
            bxs_r: peek_i64(bxs_si, 16 + i * 8)
        if bxs_r is not 0 - 1
            s: peek_i64(bxs_st, 16 + bxs_r * 8)
            ind: peek_i64(bxs_ix, 16 + bxs_r * 8)
        if bxs_r is 0 - 1
            if bt_ok is 0
                if peek_byte(raw, 0) < 33
                    ind: nind(raw)
                    if peek_byte(raw, 0) is 32
                        # lines are NUL-terminated in the flat split buffer,
                        # so raw+ind is the stripped line with no copy; only
                        # trailing whitespace still needs the copying strip.
                        s: raw + ind
                        rl0: length(s)
                        hs: s
                        hsl: rl0
                        if rl0 > 0
                            if peek_byte(s, rl0 - 1) < 33
                                s: strip(raw)
                    if not
                        s: strip(raw)
                if not
                    # s stays raw here: the old trailing scan could only
                    # ever find raw[ln-1] >= 33, so its strip was dead.
                    rl: length(raw)
                    hs: s
                    hsl: rl
            if not
                bsok: 0
                if bt_ok is 1
                    if i < bt_n
                        if peek_i64(bt_tab, 16 + i * 8) is 0
                            bi9: peek_i64(bt_ind, 16 + i * 8)
                            s: raw + bi9
                            ind: bi9
                            if peek_i64(bt_tr, 16 + i * 8) is 1
                                s: strip(raw)
                            bsok: 1
                        if not
                            nl_prep(raw)
                            s: nl_s
                            ind: nl_ind
                    if not
                        nl_prep(raw)
                        s: nl_s
                        ind: nl_ind
                if not
                    nl_prep(raw)
                    s: nl_s
                    ind: nl_ind
        syntax_select_statement(lines, i, raw, s)
        if bxs_r is not 0 - 1 -> syntax_stmt_tree: 0
        bt_ci: 0 - 1
        if bt_ok is 1
            if i < bt_n
                if bxs_r is 0 - 1
                    if peek_i64(bt_tab, 16 + i * 8) is 0
                        if peek_i64(bt_tr, 16 + i * 8) is 0
                            if peek_i64(bt_eq, 16 + i * 8) < 0
                                bt_ci: i
                                bt_sh: ind
        err_line: i + 1
        if sln_n > i
            err_line: peek_i64(stmt_lns, 16 + i * 8)
        if dbg_collect is 1
            dbg_emit: dbg_active
            if dbg_tops is 1
                dbg_emit: 0
                if i < _sov_list_len(tops_users)
                    dbg_emit: peek_i64(tops_users, 16 + i * 8)
            if dbg_emit is 1
                if peek_byte(s, 0) > 32
                    if peek_byte(s, 0) is not 35
                        addp(here(), "debug", err_line)
        if peek_byte(s, 0) = 0
            i: i + 1
        if not
            if peek_byte(s, 0) = 35
                i: i + 1
            if not
                # role fast path (item-7 stage 1): the statements blob tags
                # every line; roles 1/3/4/5/6/7/9 (set/print/return/call/
                # join/wipe/stop) are never openers (openers are role 2:
                # if/while/do-while/as-long-as) and never case/switch/try/
                # except/repeat/raise (role 0 or 8 -- case and friends have
                # no tree, raise is 8).  Such lines still owe the sk_dep
                # dedent pop and the popgo block pops (identical loops with
                # isel=0, which their roles guarantee), then go straight to
                # stmt with the tree the blob built -- the opener cascade's
                # checks provably cannot fire for them.
                sxf: 0
                if syntax_mode is 1
                    if syntax_stmt_tree is not 0
                        sxr: syntax_stmt_role
                        # simple roles 1/3/4/5/6/7/9 (set/print/return/call/
                        # join/wipe/stop) as one bitmask test: 2+8+16+32+64+128+512
                        if band(bshr(762, sxr), 1) is 1
                            sxf: 1
                if sxf is 1
                    if sk_dep > 0
                        skf_ind: _sov_list_get(sk_sin, sk_dep - 1)
                        if ind < skf_ind + 1
                            sk_dep: sk_dep - 1
                    popf: 1
                    as long as popf is 1
                        bknf: _sov_list_len(bk)
                        if bknf is 0
                            popf: 0
                        if not
                            lastf: bknf - 1
                            if ind > peek_i64(bi, 16 + lastf * 8)
                                popf: 0
                            if not
                                popblk()
                    bd_s: s
                    bd_slen: 0 - 1
                    if s is hs
                        bd_slen: hsl
                    if st_tbl is 0
                        st_tbl_init()
                    _sov_stmt(s, st_tbl)
                if not
                    isel: 0
                    ifn: 0
                    wid: word_id(s)
                    wid_hp: s
                    wid_hv: wid
                    if sk_dep > 0
                        sk_ind: _sov_list_get(sk_sin, sk_dep - 1)
                        if ind < sk_ind + 1
                            sk_dep: sk_dep - 1
                    if wid is kid_case
                        if sk_dep > 0
                            sk_txt: _sov_list_get(sk_stx, sk_dep - 1)
                            sk_ind: _sov_list_get(sk_sin, sk_dep - 1)
                        if sk_dep is 0
                            sk_txt: blank
                        if length(sk_txt) is 0
                            print "Error: case outside switch"
                            _sov_print(s)
                            err_where()
                            had_err: 1
                        if not
                            if ind < sk_ind + 1
                                print "Error: case must stay inside its switch"
                                _sov_print(s)
                                err_where()
                                had_err: 1
                            if not
                                ca_arg: scutr(s, 4)
                                if cfind1(ca_arg, 58) > 0 - 1
                                    print "Error: case with colon not supported"
                                    _sov_print(s)
                                    err_where()
                                    had_err: 1
                                if not
                                    s: str_cat("if (", str_cat(sk_txt, str_cat(") is ", ca_arg)))
                                    wid: word_id(s)
                    if wid is kid_switch
                        sk_stx: _sov_list_add(sk_stx, scutr(s, 6))
                        sk_sin: _sov_list_add(sk_sin, ind)
                        sk_dep: sk_dep + 1
                        sk_txt: _sov_list_get(sk_stx, sk_dep - 1)
                        sk_ind: ind
                        s: "#"
                    if wid is kid_if
                        if length(s) is 6
                            if word_id_at(s, 3) is kid_not
                                isel: 1
                                ifn: 1
                    if wid is kid_except
                        isel: 1
                    popgo: 1
                    as long as popgo is 1
                        bkn: _sov_list_len(bk)
                        if bkn is 0
                            popgo: 0
                        if not
                            last: bkn - 1
                            if ind > peek_i64(bi, 16 + last * 8)
                                popgo: 0
                            if not
                                stay: 0
                                if isel is 1
                                    if ind is peek_i64(bi, 16 + last * 8)
                                        if peek_i64(bk, 16 + last * 8) is kid_if
                                            stay: 1
                                        if peek_i64(bk, 16 + last * 8) is kid_try
                                            stay: 1
                                if stay is 1
                                    popgo: 0
                                if not
                                    popblk()
                    if wid is kid_repeat
                        if _sov_starts_with(s, "__removed_repeat") is 0
                            print "Error: do not know these words"
                            _sov_print(s)
                            err_where()
                            had_err: 1
                    loop_ok: 0
                    wcond6: 0
                    if wid is kid_as
                        al_p: 2
                        as long as peek_byte(s, al_p) > 0 and peek_byte(s, al_p) < 33
                            al_p: al_p + 1
                        if word_id_at(s, al_p) is kid_long
                            al_p: al_p + 4
                            if peek_byte(s, al_p) > 0 and peek_byte(s, al_p) < 33
                                as long as peek_byte(s, al_p) > 0 and peek_byte(s, al_p) < 33
                                    al_p: al_p + 1
                                if word_id_at(s, al_p) is kid_as
                                    al_p: al_p + 2
                                    if peek_byte(s, al_p) is 0 or peek_byte(s, al_p) < 33
                                        as long as peek_byte(s, al_p) > 0 and peek_byte(s, al_p) < 33
                                            al_p: al_p + 1
                                        wcond6: s + al_p
                                        loop_ok: 1
                    do_if: 0
                    if wid is kid_if
                        do_if: 1
                    if do_if is 1
                        if ifn is 0
                            if word_id_at(s, 3) is not kid_not
                                selhit: 0
                                cond_if: s + 3
                                if try_sel_if(cond_if, lines, i, ind) is 1
                                    i: skip_body(lines, i + 1, ind)
                                    i: i - 1
                                    selhit: 1
                                if selhit is 0
                                    cflush_all()
                                    z: syntax_stmt_fuse(syntax_stmt_tree, syntax_stmt_role, cond_if, 1)
                                    if z is 0 - 1
                                        expr(cond_if)
                                        test_rax()
                                        z: jz()
                                    bk: _sov_list_add(bk, kid_if)
                                    bw: _sov_list_add(bw, "")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, z)
                                    bs: _sov_list_add(bs, 0)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                    bx: _sov_list_add(bx, _sov_list_new())
                                    br_depth: br_depth + 1
                            if not
                                                            bd_s: s
                                bd_slen: 0 - 1
                                if s is hs
                                    bd_slen: hsl
                        if not
                            last: _sov_list_len(bk) - 1
                            if last > 0 - 1
                                je: jmp()
                                bq2: peek_i64(bj, 16 + last * 8)
                                if bq2 > 0 - 1
                                    patch(bq2)
                                old: peek_i64(be, 16 + last * 8)
                                old: _sov_list_add(old, je)
                                be: _sov_list_set(be, last, old)
                                bk: _sov_list_set(bk, last, kid_else)
                                bj: _sov_list_set(bj, last, 0 - 1)
                    if not
                        if _sov_str_eq(s, "\x00__removed_and_if_not") is 1
                            last: _sov_list_len(bk) - 1
                            if last > 0 - 1
                                je: jmp()
                                bq2: peek_i64(bj, 16 + last * 8)
                                if bq2 > 0 - 1
                                    patch(bq2)
                                old: peek_i64(be, 16 + last * 8)
                                old: _sov_list_add(old, je)
                                be: _sov_list_set(be, last, old)
                                bk: _sov_list_set(bk, last, kid_else)
                                bj: _sov_list_set(bj, last, 0 - 1)
                        if not
                            do_wh: 0
                            if wid is kid_do
                                if word_id_at(s, 3) is kid_while
                                    do_wh: 1
                            if do_wh is 1
                                if cb_tbl is 0 -> cb_tbl_init()
                                bln: _sov_collect_body(lines, i + 1, ind, cb_tbl)
                                filw: 0
                                wcond9: s + 9
                                if try_listsum_while(wcond9, bln, lines, i) is 1
                                    filw: 1
                                if filw is 0
                                    if try_opt_while(wcond9, bln) is 1
                                        filw: 1
                                if not
                                    if try_fill_while(wcond9, bln, lines, i) is 1
                                        filw: 1
                                if filw is 0
                                    if try_fp_dot(wcond9, bln, lines, i) is 1
                                        filw: 1
