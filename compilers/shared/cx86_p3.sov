fast_ret line:
    if dbg_mode is 1
        return 0
    i: 0
    as long as peek_byte(line, i) is 32
        i: i + 1
    if peek_byte(line, i) is not 114
        return 0
    if peek_byte(line, i + 1) is not 101
        return 0
    if peek_byte(line, i + 2) is not 116
        return 0
    if peek_byte(line, i + 3) is not 117
        return 0
    if peek_byte(line, i + 4) is not 114
        return 0
    if peek_byte(line, i + 5) is not 110
        return 0
    if peek_byte(line, i + 6) is not 32
        return 0
    return fast_ret_do(line, i)
fast_ret_do line i:
    ln: length(line)
    if ln - i < 8
        return 0
    if peek_byte(line, ln - 1) is 32
        return 0
    if peek_byte(line, ln - 1) is 9
        return 0
    if peek_byte(line, ln - 1) is 13
        return 0
    j: i + 7
    k: j
    seen: 0
    prev: 32
    as long as k < ln
        b: peek_byte(line, k)
        if b is not 32
            seen: 1
        if b is 34
            return 0
        if b is 35
            return 0
        if b is 39
            return 0
        if b is 58
            return 0
        if b is 59
            return 0
        if b is 92
            return 0
        if b is 9
            return 0
        if b is 13
            return 0
        if b < 32
            return 0
        if b > 126
            return 0
        if b is 61
            if prev is 43
                return 0
            if prev is 45
                return 0
            if prev is 42
                return 0
            if prev is 47
                return 0
            if prev is 38
                return 0
            if prev is 124
                return 0
            if prev is 94
                return 0
        prev: b
        k: k + 1
    if seen is 0
        return 0
    typ: 0
    if syntax_mode is 1 and line is syntax_stmt_line and syntax_stmt_role is 4 and syntax_stmt_tree is not 0
        typ: syntax_stmt_lower(syntax_stmt_tree)
    if not
        ex: cut(line, j, ln)
        typ: expr(ex)
    if typ is 1
        saw_str: 1
    if in_entry_now is 1
        if sxe_mode is 1
            leave()
            ret()
    if in_entry_now is 1
        if sxe_mode is not 1
            emit3(72, 137, 199)
            emit_sys_num(60)
            emit_sys_do()
    if in_entry_now is 1
        return 1
    if fw_on is 1
        if no_frame is 0
            canary_check()
            emit(80)
            restores()
            frame_wipe()
            emit(88)
            stmt_leave_op()
            ret()
            return 1
    leave()
    ret()
    return 1
rpx_dec v9:
    r: ""
    if v9 is 0
        return "0"
    as long as v9 > 0
        r: join(cut("0123456789", v9 % 10, v9 % 10 + 1), r)
        v9: v9 / 10
    return r
lex_txt: 0
lit_expr_len rhs:
    # length of a compile-time-known string rhs: a quoted literal, or a
    # str_cat whose two args each resolve to literal text (quoted, or
    # the currently tracked cp var).  On success lex_txt holds the
    # joined escaped-form inner text; -1 when not known.
    lex_txt: 0
    if is_lit(rhs) is 1
        lex_txt: cut(rhs, 1, length(rhs) - 1)
        return lit_len(rhs)
    if _sov_starts_with(rhs, "str_cat(") is 1
        if peek_byte(rhs, length(rhs) - 1) is 41
            la: _sov_list_new()
            la: split_args(cut(rhs, 8, length(rhs) - 1), la)
            if _sov_list_len(la) is 2
                a1: strip(peek_i64(la, 16))
                a2: strip(peek_i64(la, 24))
                x1: 0
                n1: 0 - 1
                if is_lit(a1) is 1
                    x1: cut(a1, 1, length(a1) - 1)
                    n1: lit_len(a1)
                if not
                    t1: cp_txt_of(a1)
                    if t1 is not 0
                        x1: t1
                        n1: cp_ln
                x2: 0
                n2: 0 - 1
                if is_lit(a2) is 1
                    x2: cut(a2, 1, length(a2) - 1)
                    n2: lit_len(a2)
                if not
                    t2: cp_txt_of(a2)
                    if t2 is not 0
                        x2: t2
                        n2: cp_ln
                if n1 > 0 - 1
                    if n2 > 0 - 1
                        lex_txt: join(x1, x2)
                        return n1 + n2
    return 0 - 1

rhs_pure rhs:
    # 1 when every "(" in rhs belongs to a str_len( call, so compiling
    # rhs cannot mutate a tracked string before a str_len fold reads it.
    n: length(rhs)
    i: 0
    opn: 0
    sln: 0
    as long as i < n
        if peek_byte(rhs, i) is 40
            opn: opn + 1
            if i > 6
                if sg_match(rhs, i - 7, "str_len(") is 1
                    sln: sln + 1
        i: i + 1
    if opn is sln
        return 1
    return 0

stmt line:
    sx_stree: 0
    sx_srole: 0
    if line is syntax_stmt_line
        sx_stree: syntax_stmt_tree
        sx_srole: syntax_stmt_role
    # bt tables describe the source line body() is compiling.  Nested stmt
    # calls (multi-line inliner synthetics) must not inherit the cursor, or
