                        if word_id(r2) is kid_as
                            s: join("while ", strip(cut(r2, 3, length(r2))))
                            loop_ok: 1
                do_if: 0
                if wid is kid_if
                    do_if: 1
                if do_if is 1
                    if ifn is 0
                        if word_id_at(s, 3) is not kid_not
                            selhit: 0
                            cond_if: cut(s, 3, length(s))
                            if try_sel_if(cond_if, lines, i, ind) is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                                selhit: 1
                            if selhit is 0
                                cflush_all()
                                z: fuse_cmp(cond_if, 1)
                                if z is 0 - 1
                                    expr(cond_if)
                                    test_rax()
