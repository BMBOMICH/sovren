                                        cs: lsh_find_s(cn)
                                        align32()
                                        st: here()
                                        load_loc(rs)
                                        push_rax()
                                        load_loc(cs)
                                        mov_rcx_rax()
                                        pop_rax()
                                        cmp_rax_rcx()
                                        setcc("lt")
                                        test_rax()
                                        z: jz()
                                        bk: _sov_list_add(bk, kid_repeat)
                                        bw: _sov_list_add(bw, "")
                                        bi: _sov_list_add(bi, ind)
                                        bj: _sov_list_add(bj, z)
                                        bs: _sov_list_add(bs, st)
                                        be: _sov_list_add(be, _sov_list_new())
                                        br: _sov_list_add(br, rs)
                                        bx: _sov_list_add(bx, _sov_list_new())
                                        br_depth: br_depth + 1
                                        s: "#"
                                    if not
                                        if wid is kid_try
                                            cflush_all()
                                            if gn_lookup("err_top") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_top")
                                            if gn_lookup("err_val") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_val")
                                            emit2(84, 85)
                                            load_glob("err_top")
                                            emit(80)
                                            emit3(72, 141, 13)
                                            ta: here()
                                            br_at: _sov_list_add(br_at, ta)
                                            br_pv: _sov_list_add(br_pv, pad_ver)
                                            br_id: _sov_list_add(br_id, ta)
                                            br_st: _sov_list_add(br_st, 0)
                                            emit4(0)
                                            emit3(81, 72, 137)
                                            emit3(225, 72, 137)
                                            emit(200)
                                            store_glob("err_top")
                                            bk: _sov_list_add(bk, kid_try)
                                            bw: _sov_list_add(bw, "")
                                            bi: _sov_list_add(bi, ind)
                                            bj: _sov_list_add(bj, 0)
                                            bs: _sov_list_add(bs, 0)
                                            be: _sov_list_add(be, _sov_list_new())
                                            br: _sov_list_add(br, ta)
                                            bx: _sov_list_add(bx, _sov_list_new())
                                            br_depth: br_depth + 1
                                        if not
