    return stmt(line)
try_alloc_imm var rhs:
    if _sov_starts_with(rhs, "_sov_heap_alloc(") is 0
        return 0
    if _sov_str_eq(var, skip_al) is 1
        return 1
    r: try_sbss(var, rhs)
    if r is 1
        return 1
    if has_vm is 0
        if peek_byte(rhs, length(rhs) - 1) is 41 is 1
            inn: scut(rhs, 11, length(rhs) - 1)
            asz: 0
            if _sov_str_eq(inn, kn) is 1
                if kv > 0
                    asz: kv
            if asz is 0
                if length(inn) > 0
                    if digitb(peek_byte(inn, 0)) is 1
                        if look(inn, " ") < 0
                            asz: num_of(inn)
            if asz > 511
                emit_mmap_k(asz)
                storev(var)
                return 1
emit_used:
    
    plat_used()
    if used_al is 1
        if gn_lookup("heap_ptr") is 0 - 1
            glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_alloc()
    if used_pr is 1
        used_sl: 1
    if used_sl is 1
        emit_strlen()
    if used_eq is 1
        emit_streq()
    if used_pr is 1
        emit_print()
    if used_pi is 1
        emit_print_int()
    if used_tr is 1
        emit_trap_stub()
    plat_canary()
leave:
    if no_frame is 1
        if fn_save_n > 4
            emit(65)
            emit(95)
        if fn_save_n > 3
            emit(65)
            emit(94)
        if fn_save_n > 2
            emit(65)
            emit(93)
        if fn_save_n > 1
            emit(65)
            emit(92)
        if fn_save_n > 0
            emit(91)
        return 0
    leave_reload()
    restores()
    stmt_leave_op()
spawn_emit name argc:
    
    ai: argc - 1
    as long as ai > 0 - 1
        pop_rax()
        spawn_arg(ai)
        ai: ai - 1
    spawn_finish(name)
emit_trap_stub:
    fn_names: _sov_list_add(fn_names, "_sov_trap")
    fn_offs: _sov_list_add(fn_offs, here())
    dht0: plog_h0()
    emit_write_lit("trap\n")
    emit2(106, 1)
    emit(95)
    emit_sys_num(60)
    emit_sys_do()
    dht1: plog_h1("_sov_trap")
load_glob name:
    r: is_rel()
    if r is 1
        emit3(72, 139, 5)
        at: here()
        emit4(0)
        addp(at, "grel", name)
        return 0
    if not
        emit2(73, 187)
        at: here()
        emit8(0)
        addp(at, "glob", name)
        emit3(73, 139, 3)
        return 0
