                                        bs: _sov_list_add(bs, st)
                                        be: _sov_list_add(be, _sov_list_new())
                                        br: _sov_list_add(br, 0)
                                        bx: _sov_list_add(bx, _sov_list_new())
                                        br_depth: br_depth + 1
                                if not
                                    if _sov_starts_with(s, "\x00__removed_repeat ") is 1
                                        cflush_all()
                                        tmp: cut(s, 7, length(s))
                                        tp: look(tmp, " times")
                                        if tp > 0 - 1
                                            tmp: cut(tmp, 0, tp)
                                        expr(tmp)
                                        cn: "__rep_c"
                                        inn: "__rep_i"
                                        storev(cn)
                                        xor_rax()
                                        storev(inn)
