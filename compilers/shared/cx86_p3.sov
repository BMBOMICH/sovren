    emit(133)
    emit(192 + op_low3(sl) * 9)
    emit2(15, 132)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")
cmp_rax_imm v:
    if v >= 0 - 128
        if v < 128
            emit3(72, 131, 248)
            emit(v % 256)
