collect_body lines start bind:
    out: _sov_list_new()
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: peek_i64(lines, 16 + j * 8)
        s: strip(raw)
        if peek_byte(s, 0) is 0
            j: j + 1
        if not
            if peek_byte(s, 0) is 35
                j: j + 1
            if not
                if nind(raw) > bind
                    out: _sov_list_add(out, s)
                    j: j + 1
                if not
                    return out
    return out
cops text:
    if cfind1(text, 32) < 0
        return text
    r: text
    if look(text, " is ") > 0 - 1
        r: repl(r, " is not ", " != ")
        r: repl(r, " is ", " == ")
    if look(text, " and ") > 0 - 1
        r: repl(r, " and ", " && ")
    if look(text, " or ") > 0 - 1
        r: repl(r, " or ", " || ")
    return r
cn_dstk: 0
cset name val:
    dhc_x: plog_cset(name, val)
    if cn_dstk is 0
        cn_dstk: _sov_list_new()
    ci: cn_lookup(name)
    if ci > 0 - 1
        cvls: _sov_list_set(cvls, ci, val)
        cemt: _sov_list_set(cemt, ci, 0)
        cn_dstk: _sov_list_add(cn_dstk, ci)
        return
    cn_dstk: _sov_list_add(cn_dstk, _sov_list_len(cnms))
    cnms: _sov_list_add(cnms, name)
    cvls: _sov_list_add(cvls, val)
    cemt: _sov_list_add(cemt, 0)
cut_arena: 0
cut_used: 0
cut_cap: 0
cut t a b:
    return cut_full(t, a, b)

cut_full t a b:
    tn: length(t)
    if b is tn
        if a > 0 - 1
            if a <= b
                return t + a
    if a > 0 - 1
        if b >= a
            if b <= tn
                n: b - a
                need: cut_used + n + 1
                if need > cut_cap
                    nc: 1048576
                    if cut_cap > 0
                        nc: cut_cap * 2
                    as long as nc < need
                        nc: nc * 2
                    nb: _sov_heap_alloc(nc)
                    k: 0
                    as long as k + 8 <= cut_used
                        dummy: poke_i64(nb, k, peek_i64(cut_arena, k))
                        k: k + 8
                    as long as k < cut_used
                        dummy: poke_byte(nb, k, peek_byte(cut_arena, k))
                        k: k + 1
                    cut_arena: nb
                    cut_cap: nc
                d: cut_arena + cut_used
                k: 0
                src: t + a
                as long as k + 8 <= n
                    dummy: poke_i64(d, k, peek_i64(src, k))
                    k: k + 8
                as long as k < n
                    dummy: poke_byte(d, k, peek_byte(src, k))
                    k: k + 1
                dummy: poke_byte(d, n, 0)
                cut_used: need
                return d
    cr: _sov_substring(t, a, b)
    return cr
cutn t a b tn:
    # cut_full with caller-supplied length: skips the strlen when en is known.
    if b is tn
        if a > 0 - 1
            if a <= b
                return t + a
    if a > 0 - 1
        if b >= a
            if b <= tn
                n: b - a
                need: cut_used + n + 1
                if need > cut_cap
                    nc: 1048576
                    if cut_cap > 0
                        nc: cut_cap * 2
                    as long as nc < need
                        nc: nc * 2
                    nb: _sov_heap_alloc(nc)
                    k: 0
                    as long as k + 8 <= cut_used
                        dummy: poke_i64(nb, k, peek_i64(cut_arena, k))
                        k: k + 8
                    as long as k < cut_used
                        dummy: poke_byte(nb, k, peek_byte(cut_arena, k))
                        k: k + 1
                    cut_arena: nb
                    cut_cap: nc
                d: cut_arena + cut_used
                k: 0
                src: t + a
                as long as k + 8 <= n
                    dummy: poke_i64(d, k, peek_i64(src, k))
                    k: k + 8
                as long as k < n
                    dummy: poke_byte(d, k, peek_byte(src, k))
                    k: k + 1
                dummy: poke_byte(d, n, 0)
                cut_used: need
                return d
    cr: _sov_substring(t, a, b)
    return cr
dce_globals:
    # Keep the globals a relocation actually names.  The old shape asked every
    # global about every patch (G x P compares, even with the hash prefilter);
    # collect the patch-named globals into one list first, then each global is
    # a single hashed lookup.  P + G instead of G x P, same answer.
    # (patch_kind and patch_val are frozen for the whole pass.)
    live: _sov_list_new()
    dg_named: _sov_list_new()
    dg_cap: 16
    dg_i: 0
    dg_n: _sov_list_len(patch_kind)
    as long as dg_i < dg_n
        dgk: peek_i64(patch_kid, 16 + dg_i * 8)
        if dgk is kid_kglob
            dg_named: _sov_list_add(dg_named, peek_i64(patch_val, 16 + dg_i * 8))
        if dgk is kid_kgrel
            dg_named: _sov_list_add(dg_named, peek_i64(patch_val, 16 + dg_i * 8))
        dg_i: dg_i + 1
    # one hashed membership probe per global instead of a str_eq walk
    as long as dg_cap < _sov_list_len(dg_named) * 2 + 2
        dg_cap: dg_cap + dg_cap
    dg_tbl: _sov_heap_alloc(dg_cap * 8)
    dummy: _sov_bzero(dg_tbl, dg_cap * 8)
    dg_i: 0
    as long as dg_i < _sov_list_len(dg_named)
        dummy: set_add(dg_tbl, dg_cap, peek_i64(dg_named, 16 + dg_i * 8))
        dg_i: dg_i + 1
    lv_tbl: _sov_heap_alloc(4096 * 8)
    dummy: _sov_bzero(lv_tbl, 4096 * 8)
    gi: 0
    gi_ln: _sov_list_len(glob_names)
    as long as gi < gi_ln
        gnm: peek_i64(glob_names, 16 + gi * 8)
        if set_has(dg_tbl, dg_cap, gnm) is 1
            if set_has(lv_tbl, 4096, gnm) is 0
                live: _sov_list_add(live, gnm)
                dummy: set_add(lv_tbl, 4096, gnm)
        gi: gi + 1
    glob_names: live
dce_litter:
    if had_err is 1
        return
    # bucket every branch/patch site into its function once, up front, so the
    # per-function loop below reads flags instead of re-scanning all sites.
    dl_nf: _sov_list_len(fn_offs)
    dl_brbad: _sov_list_new()
    dl_pbad: _sov_list_new()
    dl_pbk: _sov_list_new()
    dl_iz: 0
    as long as dl_iz < dl_nf
        dl_brbad: _sov_list_add(dl_brbad, 0)
        dl_pbad: _sov_list_add(dl_pbad, 0)
        dl_pbk: _sov_list_add(dl_pbk, _sov_list_new())
        dl_iz: dl_iz + 1
    dl_ocln: oc_n
    dl_j: 0
    dl_jn: _sov_list_len(br_at)
    as long as dl_j < dl_jn
        dl_bq: peek_i64(br_at, 16 + dl_j * 8)
        dl_real: 0
        dl_dead: 0
        if peek_i64(br_st, 16 + dl_j * 8) is 4
            dl_dead: 1
        if dl_dead is 0
            if ocget(dl_bq - 1) is 233
                dl_real: 1
            if dl_bq >= 2
                if ocget(dl_bq - 2) is 15
                    dl_pb: ocget(dl_bq - 1)
                    if dl_pb >= 128
                        if dl_pb < 136
                            dl_real: 1
        if dl_real is 1
            dl_jf: bsearch_le(fn_offs, dl_bq)
            if dl_jf >= 0
                dl_je: dl_ocln
                if dl_jf + 1 < dl_nf
                    dl_je: peek_i64(fn_offs, 16 + (dl_jf + 1) * 8)
                if dl_bq < dl_je
                    dl_brbad: _sov_list_set(dl_brbad, dl_jf, 1)
        dl_j: dl_j + 1
    dl_k: 0
    dl_kn: _sov_list_len(patch_at)
    as long as dl_k < dl_kn
        dl_pa: peek_i64(patch_at, 16 + dl_k * 8)
        dl_kf: bsearch_le(fn_offs, dl_pa)
        if dl_kf >= 0
            dl_ke: dl_ocln
            if dl_kf + 1 < dl_nf
                dl_ke: peek_i64(fn_offs, 16 + (dl_kf + 1) * 8)
            if dl_pa < dl_ke
                dl_bk: peek_i64(dl_pbk, 16 + dl_kf * 8)
                dl_bk: _sov_list_add(dl_bk, dl_pa)
                dl_pbk: _sov_list_set(dl_pbk, dl_kf, dl_bk)
                dl_pk: peek_i64(patch_kind, 16 + dl_k * 8)
                if peek_i64(patch_kid, 16 + dl_k * 8) is kid_krel
                    dl_pbad: _sov_list_set(dl_pbad, dl_kf, 1)
        dl_k: dl_k + 1
    
    dl_rng_at: _sov_list_new()
    dl_rng_len: _sov_list_new()
    dl_fi: 0
    as long as dl_fi < _sov_list_len(fn_offs)
        dl_s: peek_i64(fn_offs, 16 + dl_fi * 8)
        dl_e: oc_n
        if dl_fi + 1 < _sov_list_len(fn_offs)
            dl_e: peek_i64(fn_offs, 16 + (dl_fi + 1) * 8)
        dl_ok: 1
        if peek_i64(dl_brbad, 16 + dl_fi * 8) is 1
            dl_ok: 0
        if peek_i64(dl_pbad, 16 + dl_fi * 8) is 1
            dl_ok: 0
        if dl_ok is 1
            dl_ist: 0
            dl_ilen: 0
            dl_idst: 0
            dl_isrc: 0
            dl_irm: 0
            dl_live: 0
            dl_dead: 0
            dl_pos: dl_s
            dl_runst: 0
            dl_noprun: 0
            as long as dl_pos < dl_e
                dl_b: peek_byte(oc, dl_pos)
                dl_len: 0
                dl_dst: 0 - 1
                dl_src: 0 - 1
                dl_rm: 0
                dl_term: 0
                if dl_b is 144
                    dl_len: 1
                    dl_rm: 1
                if dl_len is 0
                    if dl_b is 49
                        dl_n2: ocget(dl_pos + 1)
                        dl_r: 0
                        as long as dl_r < 8
                            if dl_n2 is 192 + dl_r * 9
                                dl_len: 2
                                dl_dst: dl_r
                                dl_rm: 1
                            dl_r: dl_r + 1
                if dl_len is 0
                    dl_n1: ocget(dl_pos + 1)
                    dl_n2: ocget(dl_pos + 2)
                    if dl_b is 72
                        if dl_n1 is 137
                            if dl_n2 >= 192
                                if dl_n2 < 200
                                    dl_len: 3
                                    dl_dst: dl_n2 - 192
                                    dl_src: 0
                                    dl_rm: 1
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r
                                    dl_rm: 1
                                dl_r: dl_r + 1
                        if dl_n1 is 184
                            dl_len: 10
                            dl_dst: 0
                            dl_rm: 1
                    if dl_b is 73
                        if dl_n1 is 137
                            if dl_n2 >= 192
                                if dl_n2 < 200
                                    dl_len: 3
                                    dl_dst: dl_n2 - 192 + 8
                                    dl_src: 0
                                    dl_rm: 1
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r + 8
                                    dl_rm: 1
                                dl_r: dl_r + 1
                        if dl_n1 >= 184
                            if dl_n1 < 192
                                dl_len: 10
                                dl_dst: dl_n1 - 184 + 8
                                dl_rm: 1
                    if dl_b is 77
                        if dl_n1 is 49
                            dl_r: 0
                            as long as dl_r < 8
                                if dl_n2 is 192 + dl_r * 9
                                    dl_len: 3
                                    dl_dst: dl_r + 8
                                    dl_rm: 1
                                dl_r: dl_r + 1
                    if dl_b is 65
                        if dl_n1 >= 80
                            if dl_n1 < 88
                                dl_len: 2
                                dl_src: dl_n1 - 80 + 8
                        if dl_n1 >= 88
                            if dl_n1 < 96
                                dl_len: 2
                                dl_dst: dl_n1 - 88 + 8
                                dl_rm: 1
                        if dl_n1 >= 184
                            if dl_n1 < 192
                                dl_len: 6
                                dl_dst: dl_n1 - 184 + 8
                                dl_rm: 1
                if dl_len is 0
                    if dl_b >= 80
                        if dl_b < 88
                            dl_len: 1
                            dl_src: dl_b - 80
                    if dl_b >= 88
                        if dl_b < 96
                            dl_len: 1
                            dl_dst: dl_b - 88
                            dl_rm: 1
                    if dl_b >= 184
                        if dl_b < 192
                            dl_len: 5
                            dl_dst: dl_b - 184
                            dl_rm: 1
                    if dl_b >= 176
                        if dl_b < 184
                            dl_len: 2
                    if dl_b is 106
                        dl_len: 2
                    if dl_b is 15
                        dl_n2: ocget(dl_pos + 1)
                        if dl_n2 is 5
                            dl_len: 2
                            dl_term: 1
                if dl_len is 0
                    dl_pos: dl_pos + 1
                    dl_runst: 0
                    dl_noprun: 0
                if not
                    if dl_runst is 0
                        dl_can: 0
                        if dl_pos is dl_s
                            dl_can: 1
                        if dl_term is 1
                            dl_can: 1
                        if dl_noprun >= 3
                            dl_can: 1
                        if dl_can is 1
                            dl_runst: 1
                            dl_ist: _sov_list_new()
                            dl_ilen: _sov_list_new()
                            dl_idst: _sov_list_new()
                            dl_isrc: _sov_list_new()
                            dl_irm: _sov_list_new()
                            dl_live: _sov_list_new()
                            dl_dead: _sov_list_new()
                    if dl_runst is 1
                        dl_ist: _sov_list_add(dl_ist, dl_pos)
                        dl_ilen: _sov_list_add(dl_ilen, dl_len)
                        dl_idst: _sov_list_add(dl_idst, dl_dst)
                        dl_isrc: _sov_list_add(dl_isrc, dl_src)
                        dl_irm: _sov_list_add(dl_irm, dl_rm)
                        dl_dead: _sov_list_add(dl_dead, 0)
                        if dl_term is 1
                            dl_live: _sov_list_add(dl_live, 0)
                            dl_live: _sov_list_add(dl_live, 7)
                            dl_live: _sov_list_add(dl_live, 6)
                            dl_live: _sov_list_add(dl_live, 2)
                            dl_live: _sov_list_add(dl_live, 10)
                            dl_live: _sov_list_add(dl_live, 8)
                            dl_live: _sov_list_add(dl_live, 9)
                            dl_k: _sov_list_len(dl_ist) - 1
                            as long as dl_k >= 0
                                dl_d: peek_i64(dl_idst, 16 + dl_k * 8)
                                if dl_d > 0 - 1
                                    dl_inlive: 0
                                    dl_m: 0
                                    as long as dl_m < _sov_list_len(dl_live)
                                        if peek_i64(dl_live, 16 + dl_m * 8) is dl_d
                                            dl_inlive: 1
                                        dl_m: dl_m + 1
                                    if dl_inlive is 1
                                        dl_nl: _sov_list_new()
                                        dl_m: 0
                                        dl_m_ln: _sov_list_len(dl_live)
                                        as long as dl_m < dl_m_ln
                                            if peek_i64(dl_live, 16 + dl_m * 8) is not dl_d
                                                dl_nl: _sov_list_add(dl_nl, peek_i64(dl_live, 16 + dl_m * 8))
                                            dl_m: dl_m + 1
                                        dl_live: dl_nl
                                        dl_sv: peek_i64(dl_isrc, 16 + dl_k * 8)
                                        if dl_sv > 0 - 1
                                            dl_in2: 0
                                            dl_m: 0
                                            as long as dl_m < _sov_list_len(dl_live)
                                                if peek_i64(dl_live, 16 + dl_m * 8) is dl_sv
                                                    dl_in2: 1
                                                dl_m: dl_m + 1
                                            if dl_in2 is 0
                                                dl_live: _sov_list_add(dl_live, dl_sv)
                                    if not
                                        if peek_i64(dl_irm, 16 + dl_k * 8) is 1
                                            dl_h0: peek_i64(dl_ist, 16 + dl_k * 8)
                                            dl_h1: dl_h0 + peek_i64(dl_ilen, 16 + dl_k * 8)
                                            dl_patched: 0
                                            dl_bk: peek_i64(dl_pbk, 16 + dl_fi * 8)
                                            dl_m: 0
                                            dl_mln: _sov_list_len(dl_bk)
                                            as long as dl_m < dl_mln
                                                dl_pp: peek_i64(dl_bk, 16 + dl_m * 8)
                                                if dl_pp >= dl_h0
                                                    if dl_pp < dl_h1
                                                        dl_patched: 1
                                                dl_m: dl_m + 1
                                            if dl_patched is 0
                                                dl_dead: _sov_list_set(dl_dead, dl_k, 1)
                                dl_k: dl_k - 1
                            dl_m: 0
                            dl_m_ln: _sov_list_len(dl_ist)
                            as long as dl_m < dl_m_ln
                                if peek_i64(dl_dead, 16 + dl_m * 8) is 1
                                    dl_rng_at: _sov_list_add(dl_rng_at, peek_i64(dl_ist, 16 + dl_m * 8))
                                    dl_rng_len: _sov_list_add(dl_rng_len, peek_i64(dl_ilen, 16 + dl_m * 8))
                                dl_m: dl_m + 1
                            dl_runst: 0
                            dl_noprun: 0
                    if dl_b is 144
                        dl_noprun: dl_noprun + 1
                    if not
                        dl_noprun: 0
                    dl_pos: dl_pos + dl_len
        dl_fi: dl_fi + 1
    if _sov_list_len(dl_rng_at) is 0
        return
    dl_i: 1
    as long as dl_i < _sov_list_len(dl_rng_at)
        dl_k: dl_i - 1
        dl_ca: peek_i64(dl_rng_at, 16 + dl_i * 8)
        dl_cl: peek_i64(dl_rng_len, 16 + dl_i * 8)
        dl_done: 0
        as long as dl_done is 0
            if dl_k < 0
                dl_done: 1
            if not
                if peek_i64(dl_rng_at, 16 + dl_k * 8) > dl_ca
                    dl_rng_at: _sov_list_set(dl_rng_at, dl_k + 1, peek_i64(dl_rng_at, 16 + dl_k * 8))
                    dl_rng_len: _sov_list_set(dl_rng_len, dl_k + 1, peek_i64(dl_rng_len, 16 + dl_k * 8))
                    dl_k: dl_k - 1
                if not
                    dl_done: 1
        dl_rng_at: _sov_list_set(dl_rng_at, dl_k + 1, dl_ca)
        dl_rng_len: _sov_list_set(dl_rng_len, dl_k + 1, dl_cl)
        dl_i: dl_i + 1
    dl_no: _sov_list_new()
    dl_pos: 0
    dl_ri: 0
    dl_pos_ln: oc_n
    as long as dl_pos < dl_pos_ln
        dl_cut: 0
        if dl_ri < _sov_list_len(dl_rng_at)
            if peek_i64(dl_rng_at, 16 + dl_ri * 8) is dl_pos
                dl_cut: 1
        if dl_cut is 1
            dl_pos: dl_pos + peek_i64(dl_rng_len, 16 + dl_ri * 8)
            dl_ri: dl_ri + 1
        if not
            dl_no: _sov_list_add(dl_no, ocget(dl_pos))
            dl_pos: dl_pos + 1
    oc_from_list(dl_no)
    
    dl_na: _sov_list_new()
    dl_nk: _sov_list_new()
    dl_nkd: _sov_list_new()
    dl_nv: _sov_list_new()
    dl_nl: _sov_list_new()
    dl_pi: 0
    dl_pi_ln: _sov_list_len(patch_at)
    as long as dl_pi < dl_pi_ln
        dl_at: peek_i64(patch_at, 16 + dl_pi * 8)
        dl_sh: 0
        dl_ri: 0
        as long as dl_ri < _sov_list_len(dl_rng_at)
            if peek_i64(dl_rng_at, 16 + dl_ri * 8) + peek_i64(dl_rng_len, 16 + dl_ri * 8) <= dl_at
                dl_sh: dl_sh + peek_i64(dl_rng_len, 16 + dl_ri * 8)
            dl_ri: dl_ri + 1
        dl_na: _sov_list_add(dl_na, dl_at - dl_sh)
        dl_nk: _sov_list_add(dl_nk, peek_i64(patch_kind, 16 + dl_pi * 8))
        dl_nkd: _sov_list_add(dl_nkd, peek_i64(patch_kid, 16 + dl_pi * 8))
        dl_nv: _sov_list_add(dl_nv, peek_i64(patch_val, 16 + dl_pi * 8))
        dl_nl: _sov_list_add(dl_nl, peek_i64(patch_line, 16 + dl_pi * 8))
        dl_pi: dl_pi + 1
    patch_at: dl_na
    patch_kind: dl_nk
    patch_kid: dl_nkd
    patch_val: dl_nv
    patch_line: dl_nl
    dl_fi: 0
    as long as dl_fi < _sov_list_len(fn_offs)
        dl_off: peek_i64(fn_offs, 16 + dl_fi * 8)
        dl_sh: 0
        dl_ri: 0
        as long as dl_ri < _sov_list_len(dl_rng_at)
            if peek_i64(dl_rng_at, 16 + dl_ri * 8) + peek_i64(dl_rng_len, 16 + dl_ri * 8) <= dl_off
                dl_sh: dl_sh + peek_i64(dl_rng_len, 16 + dl_ri * 8)
            dl_ri: dl_ri + 1
        fn_offs: _sov_list_set(fn_offs, dl_fi, dl_off - dl_sh)
        dl_fi: dl_fi + 1
dce_stores:
    if had_err is 1
        return
    ds_gi_ln: _sov_list_len(glob_names)
    ds_any: _sov_list_new()
    ds_all: _sov_list_new()
    ds_pl: _sov_list_new()
    ds_gi: 0
    as long as ds_gi < ds_gi_ln
        ds_any: _sov_list_add(ds_any, 0)
        ds_all: _sov_list_add(ds_all, 1)
        ds_pl: _sov_list_add(ds_pl, _sov_list_new())
        ds_gi: ds_gi + 1
    ds_pi: 0
    ds_pi_ln: _sov_list_len(patch_kind)
    as long as ds_pi < ds_pi_ln
        ds_pk: peek_i64(patch_kind, 16 + ds_pi * 8)
        ds_pv: peek_i64(patch_val, 16 + ds_pi * 8)
        dsp: peek_i64(patch_kid, 16 + ds_pi * 8)
        if dsp is kid_kgrel
            ds_gi: gn_lookup(ds_pv)
            if ds_gi > 0 - 1
                ds_any: _sov_list_set(ds_any, ds_gi, 1)
                ds_at: peek_i64(patch_at, 16 + ds_pi * 8)
                ds_sub: peek_i64(ds_pl, 16 + ds_gi * 8)
                ds_sub: _sov_list_add(ds_sub, ds_at)
                ds_pl: _sov_list_set(ds_pl, ds_gi, ds_sub)
                ds_st: 0
                if ds_at >= 3
                    ds_b3: ocget(ds_at - 3)
                    ds_b2: ocget(ds_at - 2)
                    ds_b1: ocget(ds_at - 1)
                    if ds_b3 is 72
                        if ds_b2 is 137
                            if ds_b1 is 5
                                ds_st: 1
                if ds_st is 0
                    ds_all: _sov_list_set(ds_all, ds_gi, 0)
        if dsp is kid_kglob
            ds_gi: gn_lookup(ds_pv)
            if ds_gi > 0 - 1
                ds_any: _sov_list_set(ds_any, ds_gi, 1)
                ds_all: _sov_list_set(ds_all, ds_gi, 0)
        ds_pi: ds_pi + 1
    ds_gi: 0
    as long as ds_gi < ds_gi_ln
        if peek_i64(ds_any, 16 + ds_gi * 8) is 1
            if peek_i64(ds_all, 16 + ds_gi * 8) is 1
                ds_sub: peek_i64(ds_pl, 16 + ds_gi * 8)
                ds_sj: 0
                as long as ds_sj < _sov_list_len(ds_sub)
                    ds_at: peek_i64(ds_sub, 16 + ds_sj * 8)
                    ds_k: ds_at - 3
                    as long as ds_k < ds_at + 4
                        dummy: ocset(ds_k, 144)
                        ds_k: ds_k + 1
                    ds_sj: ds_sj + 1
        ds_gi: ds_gi + 1
    ds_na: _sov_list_new()
    ds_nk: _sov_list_new()
    ds_nkd: _sov_list_new()
    ds_nv: _sov_list_new()
    ds_nl: _sov_list_new()
    ds_pi: 0
    ds_pi_ln: _sov_list_len(patch_at)
    as long as ds_pi < ds_pi_ln
        ds_drop: 0
        ds_at: peek_i64(patch_at, 16 + ds_pi * 8)
        ds_pk2: peek_i64(patch_kind, 16 + ds_pi * 8)
        if peek_i64(patch_kid, 16 + ds_pi * 8) is kid_kgrel
            if ds_at >= 3
                if ocget(ds_at - 3) is 144
                    if ocget(ds_at - 2) is 144
                        if ocget(ds_at - 1) is 144
                            ds_drop: 1
        if ds_drop is 0
            ds_na: _sov_list_add(ds_na, ds_at)
            ds_nk: _sov_list_add(ds_nk, peek_i64(patch_kind, 16 + ds_pi * 8))
            ds_nkd: _sov_list_add(ds_nkd, peek_i64(patch_kid, 16 + ds_pi * 8))
            ds_nv: _sov_list_add(ds_nv, peek_i64(patch_val, 16 + ds_pi * 8))
            ds_nl: _sov_list_add(ds_nl, peek_i64(patch_line, 16 + ds_pi * 8))
        ds_pi: ds_pi + 1
    patch_at: ds_na
    patch_kind: ds_nk
    patch_kid: ds_nkd
    patch_val: ds_nv
    patch_line: ds_nl
w_used: blank
w_hit: 0
w_hitn: 0
w_built: 0
build_used_fns:
    # The old shape collected every rel/fnaddr patch value into a list and let
    # warn_unused ask that list about each name.  The list is ~15k strings, so
    # the first hashed lookup indexed all of them (nhash, one per entry) and
    # that one index build cost more than the whole warning pass should.
    # Invert it: the candidate names are the (few hundred) top level names, so
    # index those once and let each patch value mark its name's flag byte.
    w_hitn: _sov_list_len(names)
    w_hit: _sov_heap_alloc(w_hitn + 1)
    dummy: _sov_bzero(w_hit, w_hitn + 1)
    w_pi: 0
    w_pn: _sov_list_len(patch_kind)
    as long as w_pi < w_pn
        wpk: peek_i64(patch_kid, 16 + w_pi * 8)
        if wpk is kid_krel
            wj: nm_lookup(peek_i64(patch_val, 16 + w_pi * 8))
            if wj > 0 - 1
                dummy: poke_byte(w_hit, wj, 1)
        if wpk is kid_kfnaddr
            wj: nm_lookup(peek_i64(patch_val, 16 + w_pi * 8))
            if wj > 0 - 1
                dummy: poke_byte(w_hit, wj, 1)
        w_pi: w_pi + 1
    w_built: 1
dead_iota lines:
    an: blank
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(peek_i64(lines, 16 + i * 8))
        if _sov_starts_with(s, "<-- ") is 1
            if look(s, "_sov_heap_alloc(") > 0 - 1
                rest: cut(s, 4, length(s))
                t: find_sep(rest)
                if t > 0 - 1
                    an: repl(strip(cut(rest, 0, t)), " ", "_")
        i: i + 1
    if length(an) is 0
        return blank
    hits: 0
    ok: 1
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(peek_i64(lines, 16 + i * 8))
        mark: join(an, ",")
        hit: 0
        if look(s, mark) > 0 - 1
            hit: 1
        if _sov_starts_with(s, join("<-- ", an)) is 1
            hit: 1
        if hit is 1
            hits: hits + 1
            good: 0
            if look(s, "_sov_heap_alloc(") > 0 - 1
                good: 1
            if look(s, "poke_i64(") > 0 - 1
                good: 1
            if look(s, "peek_i64(") > 0 - 1
                good: 1
            if good is 0
                ok: 0
        i: i + 1
    if ok is 0
        return blank
    if hits < 3
        return blank
    return an
dec_txt v:
    if v is 0
        return "0\n"
    neg: 0
    dv: v
    if dv < 0
        neg: 1
    r: ""
    as long as dv is not 0
        d: dv % 10
        if d < 0
            d: 0 - d
        r: join(cut("0123456789", d, d + 1), r)
        dv: dv / 10
    if neg is 1
        r: join("-", r)
    return join(r, "\n")
dec_var name:
    sl: lsh_find_s(name)
    if sl is 0
        emit3(72, 255, 203)
        return
    if sl is 1
        emit3(73, 255, 204)
        return
    if sl is 2
        emit3(73, 255, 205)
        return
    if sl is 3
        emit3(73, 255, 206)
        return
    if sl is 4
        emit3(73, 255, 207)
        return
    if sl < 0
        loadv(name)
        emit3(72, 255, 200)
        storev(name)
        return
    if sl is 5
        if leaf8 is 1
            emit3(73, 255, 200)
            return
    if sl is 6
        if leaf8 is 1
            emit3(73, 255, 201)
            return
    if sl is 7
        if leaf8 is 1
            emit3(73, 255, 202)
            return
    if sl is 8
        if leaf8 is 1
            emit3(73, 255, 203)
            return
    cflush(name)
    of: loc_off(sl)
    emit2(72, 255)
    if of > 0 - 129
        emit(77)
        emit(of)
        return
    emit(141)
    emit4(of)
    return
digit c:
    b: peek_byte(c, 0)
    if b >= 48
        if b <= 57
            return 1
drop_str name:
    di: sv_lookup(name)
    if di > 0 - 1
        str_vars: _sov_list_set(str_vars, di, "")
