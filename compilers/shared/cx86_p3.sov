                rhs: strip(cutn(s, col + 1, st_sl, st_sl))
                vn: length(var)
                rn: length(rhs)
                if ix_find(var, vn) < 0
                    var: intern_kid_n(var, vn)
            if sx_stree is 0 or sx_srole is not 1 or im_skip is not 0
                ix_w: ix_find(var, vn)
                if ix_w > 0
                    if ix_name_ok(cut(var, 0, ix_w)) is 1
                        sx_stree: 0
                        ix_bn: intern_kid(cut(var, 0, ix_w))
                        ix_bi: cut(var, ix_w + 1, vn - 1)
                        rhs: str_cat("_sov_list_set(", str_cat(ix_bn, str_cat(", ", str_cat(ix_bi, str_cat(", ", str_cat(rhs, ")"))))))
                        var: ix_bn
                        vn: length(var)
                        rn: length(rhs)
            if _sov_list_len(im_names) > 0
                if list_find(im_names, var) > 0 - 1
                    if im_skip is 0
                        print join("Error: ", join(var, " is immutable, it cannot be assigned again"))
                        _sov_print(s)
                        err_where()
                        had_err: 1
                        return
                    im_skip: 0
            if syntax_fast_assignment(sx_stree, sx_srole, var, rhs) is 1 -> return
            cpx_p: lit_expr_len(rhs)
            cpx_t: lex_txt
            if cpx_p > 0 - 1
                # literal-valued rhs: the pending entry is applied at the
                # generic tail after the store, so folds inside this very
                # rhs still read the OLD tracked value (t: str_cat(t, "!")
                # must not see its own result).  A same-var entry is
                # cleared now in case a fast path stores and returns first.
                if cp_nm is not 0
                    if _sov_str_eq(var, cp_nm) is 1
                        cp_nm: 0
            if not
                if cp_nm is not 0
                    if _sov_str_eq(var, cp_nm) is 1
                        cp_nm: 0
                    if not
                        if rhs_pure(rhs) is 0
                            if look(rhs, cp_nm) < 0
                                cp_nm: 0
                            if not
                                cp_pend_kill: 1
            if rn is vn + 4
                if sg_match(rhs, 0, var) is 1
                    if sg_match(rhs, vn, " + 1") is 1
                        inc_var(var)
                        return
                    if sg_match(rhs, vn, " - 1") is 1
                        dec_var(var)
                        return
            if try_slot_forms(var, rhs) is 1
                drop_str(var)
                return
            if try_def_peek(var, rhs) is 1
                drop_str(var)
                return
            if try_self_chain(var, rhs) is 1
                drop_str(var)
                return
            if try_self_infix(var, rhs) is 1
                drop_str(var)
                return
            if try_stmt_inline(var, rhs) is 1
                return
            if rn > vn + 3
                if sg_match(rhs, 0, var) is 1
                    if sg_match(rhs, vn, " + ") is 1
                        other: scut(rhs, vn + 3, rn)
                        if length(other) > 0
                            if look(other, "(") < 0
                                if look(other, " ") < 0
                                    if digitb(peek_byte(other, 0)) is 1
                                        add_imm(var, num_of(other))
                                        drop_str(var)
                                        return
                                    add_into(var, repl(other, " ", "_"))
                                    drop_str(var)
                                    return
                                rs: regslot2(var)
                                if rs > 0 - 1
                                    cflush(var)
                                    cp_ok: 1
                                    cp_kill: 0
                                    expr(other)
                                    cp_ok: 0
                                    add_rax_slot(rs)
                                    drop_str(var)
                                    return
                                if not
                                    sl6: lshf2(var)
                                    if sl6 > 4
                                        mm3: mem_scaled(other)
                                        if mm3 > 0 - 1
                                            cflush(var)
                                            ms3: mm3 / 65536
                                            mq3: mm3 % 65536
                                            emit_rax_scaled(ms3, mq3 / 4096, mq3 % 4096 - 128)
                                            add_rax_mem(sl6)
                                            drop_str(var)
                                            return
                                        mm4: memabs_scaled(other)
                                        if mm4 > 0 - 1
                                            cflush(var)
                                            emit_rax_abs(mm4 / 4294967296 - 1, mm4 % 4294967296)
                                            add_rax_mem(sl6)
                                            drop_str(var)
                                            return
            if rn > vn + 3
                if sg_match(rhs, 0, var) is 1
                    if sg_match(rhs, vn, " - ") is 1
                        other: scut(rhs, vn + 3, rn)
                        if length(other) > 0
                            if look(other, "(") < 0
                                if look(other, " ") < 0
                                    if digitb(peek_byte(other, 0)) is 1
                                        add_imm(var, 0 - num_of(other))
                                        drop_str(var)
                                        return
                                    sub_into(var, repl(other, " ", "_"))
                                    drop_str(var)
                                    return
                                rs: regslot2(var)
                                if rs > 0 - 1
                                    cflush(var)
                                    cp_ok: 1
                                    cp_kill: 0
                                    expr(other)
                                    cp_ok: 0
                                    sub_rax_slot(rs)
                                    drop_str(var)
                                    return
            if length(rhs) > 0
                if digitb(peek_byte(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        if br_depth is 0
                            nv: num_of(rhs)
                            if cfind1(rhs, 46) < 0
                                cset(var, nv)
                            if nv > 0
                                kn: var
                                kv: nv
                                dhkn: plog_kn(nv, var)
                            drop_str(var)
                            if has_vm is 0
                                if cfind1(rhs, 46) < 0
                                    return
            if try_alloc_imm(var, rhs) is 1
                mark_str(var)
                return
            if length(rhs) is 1
                if peek_byte(rhs, 0) is 48
                    zl: lshf2(var)
                    if zl > 0 - 1
                        if gn_lookup(var) < 0
                            if zl < 5
                                cset(var, 0)
                                if zl is 0
                                    emit3(72, 49, 219)
                                if not
                                    emit2(77, 49)
                                    emit(192 + 9 * (zl + 3))
                                zi: cn_lookup(var)
                                cemt: _sov_list_set(cemt, zi, 1)
                                dhf_z1: plog_str(4, var)
                                drop_str(var)
                                return
                            if leaf8 is 1
                                if zl < 9
                                    cset(var, 0)
                                    emit2(77, 49)
                                    emit(192 + 9 * (zl - 5))
                                    zi: cn_lookup(var)
                                    cemt: _sov_list_set(cemt, zi, 1)
                                    dhf_z2: plog_str(4, var)
                                    drop_str(var)
                                    return
            fa0: peek_byte(rhs, 0)
            fa_go: 0
            if digitb(fa0) is 1
                if cfind1(rhs, 32) < 0
                    if _sov_starts_with(rhs, "0x") is 1
                        rax_imm(num_of(rhs))
                        fa_go: 1
                    if fa_go is 0
                        if _sov_starts_with(rhs, "0b") is 1
                            rax_imm(num_of(rhs))
                            fa_go: 1
                    if fa_go is 0
                        if is_imm(rhs) is 1
                            rax_imm(num_of(rhs))
                            fa_go: 1
            if fa_go is 0
                if look(rhs, " ") < 0
                    if look(rhs, "(") < 0
                        if expr_atom(rhs) is 1
                            if expr_atom_word(rhs) is 1
                                loadv(rhs)
                                fa_go: 1
            if fa_go is 1
                typ: 0
                storev(var)
                drop_str(var)
                return
            cp_ok: 1
            cp_kill: 0
            typ: syntax_stmt_expr(sx_stree, sx_srole, 1, rhs)
            cp_ok: 0
            storev(var)
            if cpx_p > 0 - 1
                cp_nm: var
                cp_ln: cpx_p
                cp_txt: cpx_t
                cp_bid0: cp_bid
                cp_gen0: cp_gen
                cp_dep0: _sov_list_len(bk)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if _sov_starts_with(rhs, "_sov_strlen(") is 1
                if did_stos is 1
                    if kv > 0
                        kn: var
            return
    cp_nm: 0
    if wid is kid_private
        fw_on: 1
        return
    if wid is kid_wipe
            expr(scutr(s, 5))
            mov_rdi_rax()
            emit3(72, 133, 255)
            wsk: jz()
            emit(87)
            used_sl: 1
            calln("_sov_strlen")
            emit3(72, 137, 193)
            emit(95)
            xor_rax()
            emit3(252, 243, 170)
            patch(wsk)
            return
    if wid is kid_join
        if sx_stree is not 0 and sx_srole is 6
            syntax_stmt_lower(sx_stree)
        if not
            expr(scutr(s, 5))
        stmt_join_op()
        return
    if wid is kid_print
            arg: scutr(s, 6)
            if ends_times(arg) is 1
                head: scut(arg, 0, length(arg) - 6)
                sp: find_last_sp(head)
                if sp > 0 - 1
                    do_print_times(scut(head, 0, sp), scutr(head, sp + 1))
                    return
            if length(arg) >= 8
                if sg_match(arg, length(arg) - 8, " as text") is 1
                    expr(cut(arg, 0, length(arg) - 8))
                    mov_rdi_rax()
                    used_pr: 1
                    calln("_sov_print")
                    return
            if length(arg) >= 7
                if sg_match(arg, length(arg) - 7, " as ptr") is 1
                    expr(cut(arg, 0, length(arg) - 7))
                    mov_rdi_rax()
                    used_pr: 1
                    calln("_sov_print")
                    return
            if length(arg) > 1
                if peek_byte(arg, 0) is 34
                    lit: unesc(cut(arg, 1, length(arg) - 1))
                    emit_write_lit(join(lit, "\n"))
                    return
            if _sov_starts_with(arg, "peek_byte(") is 1
                if opt_imm > 0
                    emit_write_lit(i2s(opt_imm))
                    return
            if print_const(arg) is 1
                return
            typ: syntax_stmt_expr(sx_stree, sx_srole, 3, arg)
            mov_rdi_rax()
            if typ is 1
                used_pr: 1
                calln("_sov_print")
            if not
                used_pi: 1
                calln("_sov_print_int")
            return
    if wid is kid_return
        if peek_byte(s, 6) is 0
            if in_entry_now is 1
                if sxe_mode is 1
                    xor_rax()
                    leave()
                    ret()
                if not
                    emit2(49, 255)
                    emit_sys_num(60)
                    emit_sys_do()
                return
            if fw_on is 1
                if no_frame is 0
                    canary_check()
                    xor_rax()
                    restores()
                    frame_wipe()
                    stmt_leave_op()
                    ret()
                    return
            xor_rax()
            leave()
            ret()
            return
    if wid is kid_return
        if peek_byte(s, 6) is 32
            typ: syntax_stmt_expr(sx_stree, sx_srole, 4, s + 7)
            if typ is 1
                saw_str: 1
            if in_entry_now is 1
                if sxe_mode is 1
                    leave()
                    ret()
                if not
                    emit3(72, 137, 199)
                    emit_sys_num(60)
                    emit_sys_do()
                return
            if fw_on is 1
                if no_frame is 0
                    canary_check()
                    emit(80)
                    restores()
                    frame_wipe()
                    emit(88)
                    stmt_leave_op()
                    ret()
                    return
            leave()
            ret()
            return
    if wid is kid_stop
            emit2(49, 255)
            emit_sys_num(60)
            emit_sys_do()
            return
    if wid is kid_leave
            ld: _sov_list_len(bk) - 1
            lfound: 0
            lbad: 0
            as long as ld > 0 - 1
                lkind: peek_i64(bk, 16 + ld * 8)
                if lkind is kid_try
                    lbad: 1
                    ld: 0 - 1
                if not
                    if lkind is kid_except
                        lbad: 1
                        ld: 0 - 1
                    if not
                        if lkind is kid_while
                            lfound: ld + 1
                            ld: 0 - 1
                        if not
                            if lkind is kid_forever
                                lfound: ld + 1
                                ld: 0 - 1
                            if not
                                if lkind is kid_repeat
                                    lfound: ld + 1
                                    ld: 0 - 1
                                if not
                                    ld: ld - 1
            if lbad is 1
                print "Error: leave cannot cross try"
                _sov_print(s)
                err_where()
                had_err: 1
                return
            if lfound is 0
                print "Error: leave needs a loop around it"
                _sov_print(s)
                err_where()
                had_err: 1
                return
            ld: lfound - 1
            cflush_all()
            lx: peek_i64(bx, 16 + ld * 8)
            lx: _sov_list_add(lx, jmp())
            bx: _sov_list_set(bx, ld, lx)
            return
    if look(s, "(") < 0
        print "Error: bad line"
        _sov_print(s)
        err_where()
        had_err: 1
        return
    val_dead: 1
    syntax_stmt_expr(sx_stree, sx_srole, 5, s)
    val_dead: 0

# --- native statement lowering (bw attack phase C): _sov_stmt is the
# twin-planted entry (stmt_native.sov, generated from tools/native/
# native_stmt.c).  body()'s role fast path routes sxf lines here with the
# statement tree/role cursor and st_tbl, a function-pointer table with the
# Sovren ABI; the C port mirrors stmt()'s decision tree for exactly those
# lines and falls back to the interpreted stmt below for everything else
# (bt_ci restored first, so the fallback re-runs the identical path).
# Slot layout: tools/native/native_stmt.c enum, byte offset = 8 * slot.
st_tbl: 0
st_g_tree:
    return syntax_stmt_tree
st_g_role:
    return syntax_stmt_role
st_g_sline:
    return syntax_stmt_line
st_g_ci:
    return bt_ci
st_g_sh:
    return bt_sh
st_g_btok:
    return bt_ok
st_g_mode:
    return syntax_mode
st_g_ir:
    return syntax_body_ir
st_g_bds:
    return bd_s
st_g_bdsl:
    return bd_slen
st_g_dbg:
    return dbg_mode
st_g_oc:
    return oc
st_g_erln:
    return err_line
st_g_imnames:
    return im_names
st_g_cpnm:
    return cp_nm
st_g_cppk:
    return cp_pend_kill
st_g_brdepth:
    return br_depth
st_g_hasvm:
    return has_vm
st_g_leaf8:
    return leaf8
st_g_entry:
    return in_entry_now
st_g_sxe:
    return sxe_mode
st_g_fwon:
    return fw_on
st_g_noframe:
    return no_frame
st_g_inld:
    return inl_depth
st_g_dsok:
    return ds_ok
st_g_tkrun:
    return tk_run
st_g_optimm:
    return opt_imm
st_g_didstos:
    return did_stos
st_g_kn:
    return kn
st_g_kv:
    return kv
st_g_cemt:
    return cemt
st_g_lextxt:
    return lex_txt
st_g_dbgpcs:
    return dbg_pcs
st_g_dbglns:
    return dbg_lns
st_g_bk:
    return bk
st_g_bx:
    return bx
st_g_cpbid:
    return cp_bid
st_g_cpgen:
    return cp_gen
st_s_ci v:
    bt_ci: v
st_s_cpnm v:
    cp_nm: v
st_s_cppk v:
    cp_pend_kill: v
st_s_cchmod v:
    cch_mod: v
st_s_fwon v:
    fw_on: v
st_s_usedpr v:
    used_pr: v
st_s_usedpi v:
    used_pi: v
st_s_usedsl v:
    used_sl: v
st_s_sawstr v:
    saw_str: v
st_s_valdead v:
    val_dead: v
st_s_raxsmall v:
    rax_small: v
st_s_kn v:
    kn: v
st_s_kv v:
    kv: v
st_s_cpln v:
    cp_ln: v
st_s_cptxt v:
    cp_txt: v
st_s_cpbid0 v:
    cp_bid0: v
st_s_cpgen0 v:
    cp_gen0: v
st_s_cpdep0 v:
    cp_dep0: v
st_s_dbgpcs v:
    dbg_pcs: v
st_s_dbglns v:
    dbg_lns: v
st_s_cpok v:
    cp_ok: v
st_s_cpkill v:
    cp_kill: v
st_haderr:
    had_err: 1
    return 0
st_print txt:
    print txt
    return 0
st_g_pack dst:
    poke_i64(dst, 0, syntax_stmt_tree)
    poke_i64(dst, 8, syntax_stmt_role)
    poke_i64(dst, 16, syntax_stmt_line)
    poke_i64(dst, 24, bt_ci)
    poke_i64(dst, 32, bt_sh)
    poke_i64(dst, 40, bt_ok)
    poke_i64(dst, 48, syntax_mode)
    poke_i64(dst, 56, syntax_body_ir)
    poke_i64(dst, 64, bd_s)
    poke_i64(dst, 72, bd_slen)
    poke_i64(dst, 80, tk_run)
    poke_i64(dst, 88, ds_ok)
    poke_i64(dst, 96, inl_depth)
    poke_i64(dst, 104, im_names)
    poke_i64(dst, 112, cp_pend_kill)
    poke_i64(dst, 120, dbg_mode)
    return 0
st_tbl_init:
    kid_init()
    st_tbl: _sov_heap_alloc(1552)
    poke_i64(st_tbl, 0, 194)
    poke_i64(st_tbl, 8, addr_of st_g_tree)
    poke_i64(st_tbl, 16, addr_of st_g_role)
    poke_i64(st_tbl, 24, addr_of st_g_sline)
    poke_i64(st_tbl, 32, addr_of st_g_ci)
    poke_i64(st_tbl, 40, addr_of st_g_sh)
    poke_i64(st_tbl, 48, addr_of st_g_btok)
    poke_i64(st_tbl, 56, addr_of st_g_mode)
    poke_i64(st_tbl, 64, addr_of st_g_ir)
    poke_i64(st_tbl, 72, addr_of st_g_bds)
    poke_i64(st_tbl, 80, addr_of st_g_bdsl)
    poke_i64(st_tbl, 88, addr_of st_g_dbg)
    poke_i64(st_tbl, 96, addr_of st_g_oc)
    poke_i64(st_tbl, 104, addr_of st_g_erln)
    poke_i64(st_tbl, 112, addr_of st_g_imnames)
    poke_i64(st_tbl, 120, addr_of st_g_cpnm)
    poke_i64(st_tbl, 128, addr_of st_g_cppk)
    poke_i64(st_tbl, 136, addr_of st_g_brdepth)
    poke_i64(st_tbl, 144, addr_of st_g_hasvm)
    poke_i64(st_tbl, 152, addr_of st_g_leaf8)
    poke_i64(st_tbl, 160, addr_of st_g_entry)
    poke_i64(st_tbl, 168, addr_of st_g_sxe)
    poke_i64(st_tbl, 176, addr_of st_g_fwon)
    poke_i64(st_tbl, 184, addr_of st_g_noframe)
    poke_i64(st_tbl, 192, addr_of st_g_inld)
    poke_i64(st_tbl, 200, addr_of st_g_dsok)
    poke_i64(st_tbl, 208, addr_of st_g_tkrun)
    poke_i64(st_tbl, 216, addr_of st_g_optimm)
    poke_i64(st_tbl, 224, addr_of st_g_didstos)
    poke_i64(st_tbl, 232, addr_of st_g_kn)
    poke_i64(st_tbl, 240, addr_of st_g_kv)
    poke_i64(st_tbl, 248, addr_of st_g_cemt)
    poke_i64(st_tbl, 256, addr_of st_g_lextxt)
    poke_i64(st_tbl, 264, addr_of st_g_dbgpcs)
    poke_i64(st_tbl, 272, addr_of st_g_dbglns)
    poke_i64(st_tbl, 280, addr_of st_g_bk)
    poke_i64(st_tbl, 288, addr_of st_g_bx)
    poke_i64(st_tbl, 296, addr_of st_g_cpbid)
    poke_i64(st_tbl, 304, addr_of st_g_cpgen)
    poke_i64(st_tbl, 312, kid_use)
    poke_i64(st_tbl, 320, kid_immutable)
    poke_i64(st_tbl, 328, kid_private)
    poke_i64(st_tbl, 336, kid_wipe)
    poke_i64(st_tbl, 344, kid_join)
    poke_i64(st_tbl, 352, kid_print)
    poke_i64(st_tbl, 360, kid_return)
    poke_i64(st_tbl, 368, kid_stop)
    poke_i64(st_tbl, 376, kid_leave)
    poke_i64(st_tbl, 384, kid_try)
    poke_i64(st_tbl, 392, kid_except)
    poke_i64(st_tbl, 400, kid_while)
    poke_i64(st_tbl, 408, kid_forever)
    poke_i64(st_tbl, 416, kid_repeat)
    poke_i64(st_tbl, 424, "Error: line too long, split it up")
    poke_i64(st_tbl, 432, "Error: ")
    poke_i64(st_tbl, 440, " is immutable, it cannot be assigned again")
    poke_i64(st_tbl, 448, " + 1")
    poke_i64(st_tbl, 456, " - 1")
    poke_i64(st_tbl, 464, " + ")
    poke_i64(st_tbl, 472, " - ")
    poke_i64(st_tbl, 480, " as text")
    poke_i64(st_tbl, 488, " as ptr")
    poke_i64(st_tbl, 496, "\n")
    poke_i64(st_tbl, 504, "_sov_print")
    poke_i64(st_tbl, 512, "_sov_print_int")
    poke_i64(st_tbl, 520, "_sov_strlen")
    poke_i64(st_tbl, 528, "peek_byte(")
    poke_i64(st_tbl, 536, "Error: bad line")
    poke_i64(st_tbl, 544, "Error: leave cannot cross try")
    poke_i64(st_tbl, 552, "Error: leave needs a loop around it")
    poke_i64(st_tbl, 560, "_sov_list_set(")
    poke_i64(st_tbl, 568, ", ")
    poke_i64(st_tbl, 576, ")")
    poke_i64(st_tbl, 584, addr_of st_s_ci)
    poke_i64(st_tbl, 592, addr_of st_s_cpnm)
    poke_i64(st_tbl, 600, addr_of st_s_cppk)
    poke_i64(st_tbl, 608, addr_of st_s_cchmod)
    poke_i64(st_tbl, 616, addr_of st_s_fwon)
    poke_i64(st_tbl, 624, addr_of st_s_usedpr)
    poke_i64(st_tbl, 632, addr_of st_s_usedpi)
    poke_i64(st_tbl, 640, addr_of st_s_usedsl)
    poke_i64(st_tbl, 648, addr_of st_s_sawstr)
    poke_i64(st_tbl, 656, addr_of st_s_valdead)
    poke_i64(st_tbl, 664, addr_of st_s_raxsmall)
    poke_i64(st_tbl, 672, addr_of st_s_kn)
    poke_i64(st_tbl, 680, addr_of st_s_kv)
    poke_i64(st_tbl, 688, addr_of st_s_cpln)
    poke_i64(st_tbl, 696, addr_of st_s_cptxt)
    poke_i64(st_tbl, 704, addr_of st_s_cpbid0)
    poke_i64(st_tbl, 712, addr_of st_s_cpgen0)
