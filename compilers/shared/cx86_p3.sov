chk_div_overflow sl:
    if has_vm is 1
        return
    if opt_nochk is 1
        return
    used_tr: 1
    # RDX is scratch immediately before CQO/IDIV. Preserve dividend/divisor.
    emit2(72, 186)
    emit8(-9223372036854775808)
    emit3(72, 57, 208)
    safe: jnz()
    rx: 72
    reg: 1
    if sl >= 0
        reg: op_low3(sl)
        if sl > 0
            rx: 73
    emit3(rx, 131, 248 + reg)
    emit(255)
    emit2(15, 132)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")
    patch(safe)
    return 0
chk_zreg sl:
    if has_vm is 1
        return
    if opt_nochk is 1
