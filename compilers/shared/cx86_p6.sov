        if oid is kid_opadd
            if pkpeek_n(L, Ln) is 1
                lg: pk_g
                lx: pk_x
                if pkpeek_n(R, Rn) is 1
                    if _sov_str_eq(pk_g, lg) is 1
                        hr: peek_home(pk_x)
                        if hr < 0
                            scaled_rdx(pk_x)
                            hr: 2
                        loadv_rdi(lg)
                        hl: peek_home(lx)
                        if hl < 0
                            scaled_rsi(lx)
                            hl: 6
                        peek_rax_h(hl)
                        fold_rax_h(3, hr)
                        return 0
    if oid is kid_opeq
        if Rb0 is 34
            syntax_operand(sx_tree, sx_node, 0, L, Ln)
            push_rax()
            syntax_operand(sx_tree, sx_node, 1, R, Rn)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            return 0
        if Lb0 is 34
            syntax_operand(sx_tree, sx_node, 1, R, Rn)
            push_rax()
            syntax_operand(sx_tree, sx_node, 0, L, Ln)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            return 0
    if oid is kid_opne
        if Rb0 is 34
            syntax_operand(sx_tree, sx_node, 0, L, Ln)
            push_rax()
            syntax_operand(sx_tree, sx_node, 1, R, Rn)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            emit(72)
            emit(131)
            emit(240)
            emit(1)
            return 0
        if Lb0 is 34
            syntax_operand(sx_tree, sx_node, 1, R, Rn)
            push_rax()
            syntax_operand(sx_tree, sx_node, 0, L, Ln)
            mov_rsi_rax()
            pop_rax()
            mov_rdi_rax()
            calln("_sov_txt_eq")
            emit(72)
            emit(131)
            emit(240)
            emit(1)
            return 0
    if has_vm is 1
        if oid is kid_opadd
            if parse_sq_n(R, Rn) is 1
                rt: sq_name
                Lsq: span_str(L, Ln)
                if look(Lsq, " + ") > 0 - 1
                    q: fop2(Lsq, "+", "-")
                    if q > 0 - 1
                        if peek_byte(Lsq, q) is 43 is 1
                            la: scut(Lsq, 0, q)
                            ra: scutr(Lsq, q + 1)
                            if parse_sq(ra) is 1
                                ran: sq_name
                                if parse_sq(la) is 1
                                    la9: sq_name
                                    sq9: 0
                                    if regslot2(rt) > 0 - 1
                                        if regslot2(ran) > 0 - 1
                                            if regslot2(la9) > 0 - 1
                                                sq9: 1
                                    if sq9 is 1
                                        cflush(rt)
                                        cflush(ran)
                                        cflush(la9)
                                        sq_acc: 1
                                    sq_first: 1
                                    sq_name: rt
