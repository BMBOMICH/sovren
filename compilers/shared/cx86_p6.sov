        q: 0
        as long as j < m
            d: 0
            b: peek_byte(ln, j)
            if bt is 1
                if b is 96
                    bt: 0
                res: join(res, letter(ln, j))
                j: j + 1
                d: 1
            if d is 0
                if b is 96
                    bt: 1
                    res: join(res, letter(ln, j))
                    j: j + 1
                    d: 1
                if d is 0
                    if q is 1
                        if b is 34
                            q: 0
                        res: join(res, letter(ln, j))
                        j: j + 1
                        d: 1
                    if d is 0
