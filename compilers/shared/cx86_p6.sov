                                k: m
                        res: join(res, join(alias, join("__", w)))
                        j: e
                        d: 1
            if d is 0
                res: join(res, letter(ln, j))
                j: j + 1
        acc: _sov_list_add(acc, res)
        i: i + 1
    return lines_join(acc)
apply_aliases src:
    if length(alias_pairs) is 0
        return src
    i: 0
    n: length(alias_pairs)
    cur: blank
    as long as i < n
        if peek_byte(alias_pairs, i) is 124 is 1
            if length(cur) > 0
                src: qualify(src, cur)
                cur: blank
        if not
            cur: join(cur, letter(alias_pairs, i))
        i: i + 1
    if length(cur) > 0
        src: qualify(src, cur)
    return src
