try_inline_pkb nm ac al:
    # call-site inline for peek_byte in the standard model (self-builds
    # only: nat_gate). exactness: peek_byte is a raw byte read (s[i]);
    # OOB reads hit the zero-filled bump arena exactly as the native does.
    # register contract identical to the call it replaces: rax = result,
    # rax/rcx clobbered (both were call-clobbered anyway).
    if nat_gate is 0
        return 0
    if ac is not 2
        return 0
    if _sov_str_eq(nm, "peek_byte") is 0
        return 0
    a0: _sov_list_get(al, 0)
    a1: _sov_list_get(al, 1)
    if plain_name(a0) is 0
        return 0
    if is_imm(a1) is 1
        v: num_of(a1)
        if v > 0 - 1
            if v < 128
                cflush_globs()
                loadv(a0)
                emit3(15, 182, 64)
                emit(v)
                return 1
        if v > -2147483648
            if v < 2147483647
                cflush_globs()
                loadv(a0)
                emit3(15, 182, 128)
                emit4(v)
                return 1
        return 0
    ap: look(a1, " + ")
    if ap > 0 - 1
        h: scut(a1, 0, ap)
        k2: scutr(a1, ap + 3)
        if plain_name(h) is 1
            if is_imm(k2) is 1
                pk_kv: num_of(k2)
                if pk_kv > 0
                    if pk_kv < 128
                        cflush_globs()
                        loadv(a0)
                        emit3(72, 137, 193)
                        loadv(h)
                        emit3(72, 131, 192)
                        emit(pk_kv)
                        emit3(15, 182, 4)
                        emit(1)
                        return 1
    am: look(a1, " - ")
    if am > 0 - 1
        h: scut(a1, 0, am)
        k2: scutr(a1, am + 3)
        if plain_name(h) is 1
            if is_imm(k2) is 1
                pk_kv: num_of(k2)
                if pk_kv > 0
                    if pk_kv < 128
                        cflush_globs()
                        loadv(a0)
                        emit3(72, 137, 193)
                        loadv(h)
                        emit3(72, 131, 232)
                        emit(pk_kv)
                        emit3(15, 182, 4)
                        emit(1)
                        return 1
    if plain_name(a1) is 1
        cflush_globs()
        loadv(a0)
        emit3(72, 137, 193)
        loadv(a1)
        emit3(15, 182, 4)
        emit(1)
        return 1
    return 0
