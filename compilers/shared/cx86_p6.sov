strip_span t:
    # transient strip for line buffers: when only leading spaces need
    # trimming (the common shape), return t+indent into the same
    # NUL-terminated line instead of allocating a trimmed copy.
    # Result is read-only and lives exactly as long as the line.
    if t is 0
        return blank
    a: 0
    as long as peek_byte(t, a) is 32
        a: a + 1
    if peek_byte(t, a) is 9
        return strip(t)
    s: t + a
    n: length(s)
    if n is 0
        return s
    if peek_byte(s, n - 1) < 33
        return strip(t)
    return s
sub_into dest src:
    sd: regslot2(src)
    if sd > 0 - 1
        dd: regslot2(dest)
        if dd > 0 - 1
            cflush(dest)
            cflush(src)
            emit_addsub_slot(dd, sd, 1)
            return
    loadv(src)
    sl: lshf2(dest)
    if sl is 0
        emit(72)
        emit(41)
        emit(195)
        return
    if sl is 1
        emit(73)
        emit(41)
        emit(196)
        return
    if sl is 2
        emit(73)
        emit(41)
        emit(197)
        return
    if sl is 3
        emit(73)
        emit(41)
        emit(198)
        return
    if sl is 4
        emit(73)
        emit(41)
        emit(199)
        return
    mov_rcx_rax()
    loadv(dest)
    sub_rax_rcx()
    storev(dest)
sub_rax_rcx:
    emit(72)
    emit(41)
    emit(200)
sub_rax_reg sl:
    emit(op_rex_r(sl))
    emit(41)
    emit(192 + op_low3(sl) * 8)
sub_rax_slot sl:
    if sl is 0
        emit(72)
        emit(41)
        emit(195)
        return 0
    if sl is 1
        emit(73)
        emit(41)
        emit(196)
        return 0
    if sl is 2
        emit(73)
        emit(41)
        emit(197)
        return 0
    if sl is 3
        emit(73)
        emit(41)
        emit(198)
        return 0
    if sl is 4
        emit(73)
        emit(41)
        emit(199)
        return 0
    return 0 - 1
swap_op op:
    oid: intern_kid(op)
    if oid is kid_oplt
        return "gt"
    if oid is kid_opgt
        return "lt"
    if oid is kid_ople
        return "ge"
    if oid is kid_opge
        return "le"
    return op
take_use name alias:
    mark: join(" ", join(name, " "))
    if look(used_libs, mark) > 0 - 1
        return blank
    used_libs: join(used_libs, mark)
    chunk: use_one(name)
    if chunk is 0
        print "Error: cannot read library"
        _sov_print(name)
        err_where()
        had_err: 1
        return blank
    if length(alias) > 0
        alias_pairs: join(alias_pairs, join("|", alias))
        chunk: alias_chunk(chunk, alias)
    return chunk

first_wid s:
    # skip leading whitespace, then return word_id at that position
    wgo: 1
    as long as wgo is 1
        wb: peek_byte(s, 0)
        if wb < 33
            if wb is 0
                return 0
            s: s + 1
        if not
            wgo: 0
    return word_id(s)

word_id_at s o:
    wgo: 1
    as long as wgo is 1
        wb: peek_byte(s, o)
        if wb < 33
            if wb is 0
                return 0
            o: o + 1
        if not
            wgo: 0
    return word_id(s + o)
wordchar b:
    if b is 95
        return 1
    if b > 47
        if b < 58
            return 1
    if b > 64
        if b < 91
            return 1
    if b > 96
        if b < 123
            return 1
ren_word old nw text:
    out: blank
    i: 0
    n: length(text)
    q: 0
    ol: length(old)
    as long as i < n
        d: 0
        b: peek_byte(text, i)
        if q is 1
            out: join(out, letter(text, i))
            if b is 34
                q: 0
            d: 1
        if q is 2
            out: join(out, letter(text, i))
            if b is 96
                q: 0
            d: 1
        if d is 0
            if b is 34
                q: 1
                out: join(out, letter(text, i))
                i: i + 1
                d: 1
            if d is 0
                if b is 96
                    q: 2
                    out: join(out, letter(text, i))
                    i: i + 1
                    d: 1
        if d is 0
            pb: 32
            if i > 0
                pb: peek_byte(text, i - 1)
            if wordchar(pb) is 0
                m: 0
                if i + ol <= n
                    if sg_match(text, i, old) is 1
                        ab: 32
                        if i + ol < n
                            ab: peek_byte(text, i + ol)
                        if wordchar(ab) is 0
                            m: 1
                if m is 1
                    out: join(out, nw)
                    i: i + ol
                    d: 1
        if d is 0
            out: join(out, letter(text, i))
            i: i + 1
    return out
topdefs t:
    lst: _sov_list_new()
    lns: lines_of(t)
    i: 0
    n: _sov_list_len(lns)
    as long as i < n
        l: _sov_list_get(lns, i)
        if length(l) > 0
            b0: peek_byte(l, 0)
            if b0 is not 35
                if b0 is not 32
                    if b0 is not 9
                        j: 0
                        w: blank
                        td_ln: length(l)
                        as long as j < td_ln
                            if wordchar(peek_byte(l, j)) is 1
                                w: join(w, letter(l, j))
                                j: j + 1
                            if wordchar(peek_byte(l, j)) is 0
                                j: td_ln
                        cpos: look(l, ":")
                        if cpos > 0
                            if length(w) > 0
                                lst: _sov_list_add(lst, w)
        i: i + 1
    return lst
alias_chunk chunk alias:
    ac_names: topdefs(chunk)
    i: 0
    n: _sov_list_len(ac_names)
    as long as i < n
        nm: _sov_list_get(ac_names, i)
        chunk: ren_word(nm, join(alias, join("__", nm)), chunk)
        i: i + 1
    return chunk
lines_join lst:
    total: 0
    i: 0
    n: _sov_list_len(lst)
    as long as i < n
        total: total + length(_sov_list_get(lst, i)) + 1
        i: i + 1
    buf: _sov_heap_alloc(total + 1)
    pos: 0
    i: 0
    as long as i < n
        ln: _sov_list_get(lst, i)
        k: 0
        lnlen: length(ln)
        as long as k < lnlen
            dset: _sov_set_byte(buf, pos, peek_byte(ln, k))
            pos: pos + 1
            k: k + 1
        dset: _sov_set_byte(buf, pos, 10)
        pos: pos + 1
        i: i + 1
    dset: _sov_set_byte(buf, pos, 0)
    return buf
qualify text alias:
    lns: lines_of(text)
