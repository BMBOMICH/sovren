    if oid is kid_opbshr
        if Rimm is 1
            pop_rax()
            if arith_imm("bshr", num_of_n(R, Rn)) is 0
                return
            rcx_imm(num_of_n(R, Rn))
            emit_op("bshr")
            return
    if oid is kid_opbsar
        if Rimm is 1
            pop_rax()
            if arith_imm("bsar", num_of_n(R, Rn)) is 0
                return
            rcx_imm(num_of_n(R, Rn))
            emit_op("bsar")
            return
    if oid is kid_opwadd
        if Rimm is 1
            pop_rax()
            if arith_imm("add", num_of_n(R, Rn)) is 0
