tidy_path s:
    r: unquote(s)
    n: length(r)
    if n > 2
        if peek_byte(r, 1) is 58
            r: cut(r, 2, n)
            n: n - 2
    o: _sov_heap_alloc(n + 1)
    i: 0
    as long as i < n
        b: peek_byte(r, i)
        if b is 92
            b: 47
        dummy: poke_byte(o, i, b)
        i: i + 1
    dummy: poke_byte(o, n, 0)
    return as text o
tname line:
    s: strip(line)
    if is_task_hdr(s) is 1
        s: scut(s, 0, length(s) - 1)
        if _sov_starts_with(s, "task ") is 1
            s: scutr(s, 5)
        wp: look(s, " with ")
        if wp > 0 - 1
            return repl(scut(s, 0, wp), " ", "_")
        sp: look(s, " ")
        if sp > 0 - 1
            return scut(s, 0, sp)
        return s
    rest: scutr(line, 5)
    wp: look(rest, " with ")
    if wp > 0 - 1
        return repl(scut(rest, 0, wp), " ", "_")
    sp: look(rest, " ")
    if sp > 0 - 1
        return repl(scut(rest, 0, sp), " ", "_")
    return repl(rest, " ", "_")
try_count_while cond blines lines li:
