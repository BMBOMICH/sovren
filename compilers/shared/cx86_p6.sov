try_listsum_while cond blines lines li:
    # integer list reduction: iv from 0/1 while iv < lim with body
    #   S: S + list_get(L, iv)        (vec_get/_sov_list_get too)
    #   iv: iv + 1
    # requires lim: list_len(L) (or vec_len) in the pre-window so every
    # access is in bounds (list_get returns the index when out of bounds).
    # L in r8, accumulator r9, lim r10, iv r11; chk_ov per add.
    if has_vm is 0
        return 0
    if leaf8 is 1
        return 0
    if _sov_list_len(blines) is not 2
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(scut(c0, 0, p), " ", "_")
    lim: repl(scutr(c0, p + 3), " ", "_")
    if plain_name(iv) is 0
        return 0
    if lshf2(iv) < 0
        return 0
    if plain_name(lim) is 0
        return 0
    if is_imm(lim) is 1
        return 0
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    if _sov_str_eq(l2, join(iv, join(": ", join(iv, " + 1")))) is 0
        return 0
    tc: look(l1, ": ")
    if tc < 1
        return 0
    snm: repl(scut(l1, 0, tc), " ", "_")
    if plain_name(snm) is 0
        return 0
    rhs: scutr(l1, tc + 2)
    pfx: join(snm, " + ")
    if _sov_starts_with(rhs, pfx) is 0
        return 0
    ge: scutr(rhs, length(pfx))
    if _sov_starts_with(ge, "list_get(") is 0
        if _sov_starts_with(ge, "_sov_list_get(") is 0
            if _sov_starts_with(ge, "vec_get(") is 0
                return 0
    if peek_byte(ge, length(ge) - 1) is not 41
        return 0
    op: cfind1(ge, 40)
    al: split_args(cut(ge, op + 1, length(ge) - 1), _sov_list_new())
    if _sov_list_len(al) is not 2
        return 0
    lnm: repl(strip(peek_i64(al, 16)), " ", "_")
    ix: repl(strip(peek_i64(al, 24)), " ", "_")
    if plain_name(lnm) is 0
        return 0
    if _sov_str_eq(ix, iv) is 0
        return 0
    if _sov_str_eq(snm, iv) is 1
        return 0
    if _sov_str_eq(snm, lnm) is 1
        return 0
    if _sov_str_eq(snm, lim) is 1
        return 0
    if _sov_str_eq(lnm, iv) is 1
        return 0
    if _sov_str_eq(lnm, lim) is 1
        return 0
    if _sov_str_eq(iv, lim) is 1
        return 0
    ls_iv0: join(iv, ": 0")
    ls_iv1: join(iv, ": 1")
    ls_ln1: join(lim, join(": list_len(", join(lnm, ")")))
    ls_ln2: join(lim, join(": vec_len(", join(lnm, ")")))
    ls_ln3: join(lim, join(": _sov_list_len(", join(lnm, ")")))
    ls_piv: join(iv, ": ")
    ls_plm: join(lim, ": ")
    ls_pls: join(lnm, ": ")
    wind: sg_ind(_sov_list_get(lines, li))
    jj: li - 1
    got0: 0
    gotn: 0
    kval: 0
    seen: 0
    as long as jj >= 0
        if got0 + gotn < 2
            if gotn < 2
                rw: _sov_list_get(lines, jj)
                pl: strip(rw)
                if length(pl) > 0
                    if peek_byte(pl, 0) is not 35
                        if sg_ind(rw) is not wind
                            jj: 0 - 1
                        if not
                            seen: seen + 1
                            if seen > 6
                                jj: 0 - 1
                            if not
                                if _sov_starts_with(pl, ls_pls) is 1
                                    jj: 0 - 1
                                if not
                                    if _sov_str_eq(pl, ls_iv0) is 1
                                        got0: 1
                                    if not
                                        if _sov_str_eq(pl, ls_iv1) is 1
                                            got0: 1
                                            kval: 1
                                        if not
                                            if _sov_starts_with(pl, ls_piv) is 1
                                                jj: 0 - 1
                                    if _sov_str_eq(pl, ls_ln1) is 1
                                        gotn: 1
                                    if not
                                        if _sov_str_eq(pl, ls_ln2) is 1
                                            gotn: 1
                                        if not
                                            if _sov_str_eq(pl, ls_ln3) is 1
                                                gotn: 1
                                            if not
                                                if _sov_starts_with(pl, ls_plm) is 1
                                                    if gotn is 0
                                                        jj: 0 - 1
        if got0 is 1
            if gotn is 1
                jj: 0 - 1
        jj: jj - 1
    if got0 is 0
        return 0
    if gotn is 0
        return 0
    cflush_all()
    loadv(lnm)
    emit3(73, 137, 192)
    loadv(snm)
    emit3(73, 137, 193)
    loadv(lim)
    emit3(73, 137, 194)
    if kval is 0
        emit3(69, 49, 219)
    if not
        emit(73)
        emit(199)
        emit(195)
        emit(1)
        emit(0)
        emit(0)
        emit(0)
    emit3(77, 57, 211)
    ls_ge: jge()
    align32()
    ls_hd: here()
    emit3(79, 3, 140)
    emit(216)
    emit4(16)
    chk_ov()
    emit3(73, 255, 195)
    emit3(77, 57, 211)
    emit(15)
    emit(140)
    ls_bk: here()
    emit4(0)
    put(ls_bk, ls_hd - (ls_bk + 4))
    patch(ls_ge)
    emit3(76, 137, 200)
    storev(snm)
    emit3(76, 137, 216)
    storev(iv)
    return 1

try_append_while cond blines lines li:
    # append loop: iv from 0 while iv < lim with body
    #   L: list_add(L, EXPR)      (or _sov_list_add)
