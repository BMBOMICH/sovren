# pad line so main is not first
# unsafe-module
pop_rax:
    emit(88)
pop_rcx:
    emit(89)
popblk:
    cp_gen: cp_gen + 1
    last: _sov_list_len(bk) - 1
    k: peek_i64(bk, 16 + last * 8)
    kid: intern_kid(k)
    if kid is kid_while
        st: peek_i64(bs, 16 + last * 8)
        thread_tail(here())
        wcond: peek_i64(bw, 16 + last * 8)
        tt: here()
        zb: syntax_loop_fuse(last, wcond, 0)
        if zb is 0 - 1
            expr(wcond)
            test_rax()
            zb: jnz()
        put(zb, st - (zb + 4))
        zt: peek_i64(bj, 16 + last * 8)
        if zb < 0
            print "PN2062"
        put(zt, tt - (zt + 4))
        lx: peek_i64(bx, 16 + last * 8)
        lxi: 0
        as long as lxi < _sov_list_len(lx)
            patch(peek_i64(lx, 16 + lxi * 8))
            lxi: lxi + 1
        if zt < 0
            print "PN2063"
    if not
        if kid is kid_forever
            st: peek_i64(bs, 16 + last * 8)
            at: jmp()
            put(at, st - (at + 4))
            lx: peek_i64(bx, 16 + last * 8)
            lxi: 0
            as long as lxi < _sov_list_len(lx)
                patch(peek_i64(lx, 16 + lxi * 8))
                lxi: lxi + 1
            if at < 0
                print "PN2065"
        if not
            if kid is kid_repeat
                rs: peek_i64(br, 16 + last * 8)
                load_loc(rs)
                emit3(72, 255, 192)
                store_loc(rs)
                st: peek_i64(bs, 16 + last * 8)
                at: jmp()
                put(at, st - (at + 4))
                bz2: peek_i64(bj, 16 + last * 8)
                if bz2 > 0 - 1
                    patch(bz2)
                lx: peek_i64(bx, 16 + last * 8)
                lxi: 0
                lxi_ln: _sov_list_len(lx)
                as long as lxi < lxi_ln
                    patch(peek_i64(lx, 16 + lxi * 8))
                    lxi: lxi + 1
            if not
                if kid is kid_try
                    tb2: peek_i64(bs, 16 + last * 8)
                    if tb2 is 0
                        print "Error: try needs an except"
                        had_err: 1
                    if not
                        patch(tb2)
                if not
                    if kid is kid_except
                        skipme: 0
                    if not
                        z: peek_i64(bj, 16 + last * 8)
                        if z > 0 - 1
                            patch(z)
                    je: peek_i64(be, 16 + last * 8)
                    ji: 0
                ji_ln: _sov_list_len(je)
                as long as ji < ji_ln
                    if kid is not kid_try
                        if kid is not kid_except
                            sk_pos: _sov_list_add(sk_pos, peek_i64(je, 16 + ji * 8))
                            sk_to: _sov_list_add(sk_to, here())
                    patch(peek_i64(je, 16 + ji * 8))
                    ji: ji + 1
    poke_i64(bk, 8, last)
    poke_i64(bi, 8, last)
    poke_i64(bj, 8, last)
    poke_i64(bs, 8, last)
    poke_i64(be, 8, last)
    poke_i64(br, 8, last)
    poke_i64(bx, 8, last)
    poke_i64(bw, 8, last)
    br_depth: br_depth - 1
print_const arg:
    v: 0
    ok: 0
    if is_imm(arg) is 1
        v: num_of(arg)
        ok: 1
    if ok is 0
        if peek_byte(arg, 0) is 45
            if length(arg) > 1
                tail: cut(arg, 1, length(arg))
                    if is_imm(tail) is 1
                        v: 0 - num_of(tail)
                            ok: 1
    if ok is 0
        if length(fib_nm) > 0
            mark: join(fib_nm, "(")
            if _sov_starts_with(arg, mark) is 1
                if peek_byte(arg, length(arg) - 1) is 41 is 1
                    inn: scut(arg, length(mark), length(arg) - 1)
                    if is_imm(inn) is 1
                        fv: num_of(inn)
                        if fv < 2
                            v: fv
                            ok: 1
                        if fv < 93
                            v: fib_of(fv)
                            ok: 1
    if ok is 0
        if plain_name(arg) is 1
            ci: cn_lookup(arg)
            if ci > 0 - 1
                if peek_i64(cemt, 16 + ci * 8) is 0
                    v: peek_i64(cvls, 16 + ci * 8)
                    ok: 1
    if ok is 0
        if _sov_starts_with(arg, "const(") is 1
            if length(arg) > 7
                if peek_byte(arg, length(arg) - 1) is 41 is 1
                    if ceval(cut(arg, 6, length(arg) - 1)) is 1
                        v: cval
                        ok: 1
    if ok is 0
        return 0
    emit_write_lit(dec_txt(v))
    return 1
pu_find_use t st lim:
    # index of the 'u' of the next line at/after st whose first
    # non-whitespace bytes are `use` + (space | ':'), or -1.  Written
    # plainly here for other backends; on x86 try_native_body plants
    # emit_nt_pu_find (same semantics) over this body.
    i: st
    as long as i < lim
        j: i
        ws: 1
        as long as ws is 1
            if j >= lim
                ws: 0
            if ws is 1
                b: peek_byte(t, j)
                if b is 32
                    j: j + 1
                if not
                    if b is 9
                        j: j + 1
                    if not
                        if b is 13
                            j: j + 1
                        if not
                            ws: 0
        if j + 3 < lim
            if peek_byte(t, j) is 117
                if peek_byte(t, j + 1) is 115
                    if peek_byte(t, j + 2) is 101
                        b3: peek_byte(t, j + 3)
                        if b3 is 32
                            return j
                        if b3 is 58
                            return j
        e: cfind1n(t, i, lim, 10)
        if e < 0
            return 0 - 1
        i: e + 1
    return 0 - 1

pu_nl t a b:
    # newline count in t[a, b) -- SWAR exact mask + bit-clear popcount.
    # (borrow-free form; (x-0x0101)&~x would false-count byte 11 after 10.)
    c: 0
    i: a
    nbc: 72340172838076673 * 10
    as long as i + 8 <= b
        q: peek_i64(t, i)
        xq: bxor(q, nbc)
        m: band(bxor(bor(band(xq, 9187201950435737471) + 9187201950435737471, xq), 0 - 1), 0 - 9187201950435737472)
        as long as m is not 0
            c: c + 1
            m: band(m, m - 1)
        i: i + 8
    as long as i < b
        if peek_byte(t, i) is 10
            c: c + 1
        i: i + 1
    return c

pull_uses pu_src:
    pu_n: length(pu_src)
    pu_i: 0
    pu_ln: 0
    ch: _sov_list_new()
    tot: 0
    as long as pu_i < pu_n
        pu_up: pu_find_use(pu_src, pu_i, pu_n)
        pu_hit: 0
        pu_e: pu_n
        if pu_up < 0
            pu_i: pu_n
        if pu_up >= 0
            pu_ln: pu_ln + pu_nl(pu_src, pu_i, pu_up)
            pu_j: pu_up
            pu_e: cfind1n(pu_src, pu_j, pu_n, 10)
            if pu_e < 0
                pu_e: pu_n
            pu_hit: 1
            if peek_byte(pu_src, pu_j + 3) is 58
                pu_hit: 2
        if pu_hit is 2
            pu_bi: pu_e + 1
            pu_bind: 0
            pu_bk: pu_j
            pu_bkw: 1
            as long as pu_bkw is 1
                if pu_bk <= 0
                    pu_bkw: 0
                if pu_bkw is 1
                    bb: peek_byte(pu_src, pu_bk - 1)
                    if bb is 32
                        pu_bk: pu_bk - 1
                        pu_bind: pu_bind + 1
                    if not
                        if bb is 9
                            pu_bk: pu_bk - 1
                            pu_bind: pu_bind + 1
                        if not
                            if bb is 13
                                pu_bk: pu_bk - 1
                                pu_bind: pu_bind + 1
                            if not
                                pu_bkw: 0
            pu_bgo: 1
            as long as pu_bgo is 1
                if pu_bi >= pu_n
                    pu_bgo: 0
                if pu_bgo is 1
                    pu_bj: pu_bi
                    pu_bws: 1
                    as long as pu_bws is 1
                        if pu_bj >= pu_n
                            pu_bws: 0
                        if pu_bj < pu_n
                            if peek_byte(pu_src, pu_bj) is 32
                                pu_bj: pu_bj + 1
                            if not
                                if peek_byte(pu_src, pu_bj) is 9
                                    pu_bj: pu_bj + 1
                                if not
                                    pu_bws: 0
                    pu_be: cfind1n(pu_src, pu_bj, pu_n, 10)
                    if pu_be < 0
                        pu_be: pu_n
                    if pu_bj is pu_be
                        pu_bgo: 0
                    if pu_bgo is 1
                        if pu_bj - pu_bi <= pu_bind
                            pu_bgo: 0
                    if pu_bgo is 1
                        err_line: pu_ln + 1
                        pu_tail: scut(pu_src, pu_bj, pu_be)
                        pu_sp: look(pu_tail, " as ")
                        pu_chunk: blank
                        if pu_sp > 0 - 1
                            pu_chunk: take_use(scut(pu_tail, 0, pu_sp), scutr(pu_tail, pu_sp + 4))
                        if pu_sp < 0
                            pu_chunk: take_use(pu_tail, "")
                        ch: _sov_list_add(ch, pu_chunk)
                        tot: tot + length(pu_chunk)
                        pu_ln: pu_ln + 1
                    if pu_bgo is 1
                        pu_bi: pu_be + 1
            pu_i: pu_bi - 1
            pu_e: pu_i
        if pu_hit is 1
            err_line: pu_ln + 1
            pu_line: scut(pu_src, pu_j, pu_e)
            pu_tail: scutr(pu_line, 4)
            pu_sp: look(pu_tail, " as ")
            pu_chunk: blank
            if pu_sp > 0 - 1
                pu_chunk: take_use(scut(pu_tail, 0, pu_sp), scutr(pu_tail, pu_sp + 4))
            if pu_sp < 0
                pu_chunk: take_use(pu_tail, "")
            ch: _sov_list_add(ch, pu_chunk)
            tot: tot + length(pu_chunk)
        pu_i: pu_e + 1
        pu_ln: pu_ln + 1
    if tot is 0
        return blank
    buf: _sov_heap_alloc(tot + 1)
    w: 0
    ci: 0
    cn: _sov_list_len(ch)
    as long as ci < cn
        s: peek_i64(ch, 16 + ci * 8)
        kl: length(s)
        dummy: _sov_mem_copy(buf + w, s, kl)
        w: w + kl
        ci: ci + 1
    dummy: poke_byte(buf, w, 0)
    return buf
pure_mul_atom t:
    if plain_name(t) is 0
        return 0
    if is_imm(t) is 1
        return 0
    if homereg(t) < 0
        return 0
    return 1
pure_mul_term t:
    p1: look(t, " * ")
    if p1 < 0
        return 0
    l: scut(t, 0, p1)
    r: scutr(t, p1 + 3)
    if look(l, " ") > 0 - 1
        return 0
    if pure_mul_atom(l) is 0
        return 0
    p2: look(r, " * ")
    if p2 < 0
        if look(r, " ") > 0 - 1
            return 0
        return pure_mul_atom(r)
    l2: scut(r, 0, p2)
    r2: scutr(r, p2 + 3)
    if look(r2, " ") > 0 - 1
        return 0
    if pure_mul_atom(l2) is 0
        return 0
    return pure_mul_atom(r2)
push_rax:
    emit(80)
    push_live: 1
put at n:
    # Walk br_id backwards: the forward version kept overwriting lf/lt on every
    # match and so kept the *last* one; the first match seen from the end is that
    # same entry, and it is normally the one this put is resolving, added to the
    # list a few emissions ago.
    lf: 0
    lt: at
    li: _sov_list_len(br_id)
    as long as li > 0
        li: li - 1
        if peek_i64(br_id, 16 + li * 8) is at
            if peek_i64(br_st, 16 + li * 8) is not 4
                lf: peek_i64(br_st, 16 + li * 8)
                lt: peek_i64(br_at, 16 + li * 8)
                li: 0
    if lf is 1
        if at < 0
            return 0
        v: n + at - lt
        if v < 0
            v: v + 4294967296
        i: 0
        as long as i < 4
            dummy: ocset(lt + i, v % 256)
            v: v / 256
            i: i + 1
        return 0
    if lf is 2
        if at < 0
            return 0
        v: n + at - lt + 4
        if v < 0
            v: v + 256
        dummy: ocset(lt - 1, v % 256)
        return 0
    if lf is 3
        if at < 0
            return 0
        v: n + at - lt + 3
        if v < 0
            v: v + 256
        dummy: ocset(lt, v % 256)
        return 0
    if br_relax(lt, n + at - lt) is 1
        return 0
    if at < 0
        return 0
    v: n + at - lt
    if v < 0
        v: v + 4294967296
    i: 0
    as long as i < 4
        dummy: ocset(lt + i, v % 256)
        v: v / 256
        i: i + 1
raw_scaled e:
    if length(e) < 5
        return 0 - 1
    if sg_match(e, length(e) - 4, " * 8") is 0
        return 0 - 1
    head: scut(e, 0, length(e) - 4)
    if length(head) is 0
        return 0 - 1
    if peek_byte(head, 0) is 40 is 1
        if peek_byte(head, length(head) - 1) is 41 is 0
            return 0 - 1
        inn: scut(head, 1, length(head) - 1)
        pp: look(inn, " + ")
        sg: 1
        if pp < 0
            pp: look(inn, " - ")
            sg: 0 - 1
        if pp < 0
            return 0 - 1
        l2: scut(inn, 0, pp)
        r2: scutr(inn, pp + 3)
        if name_ok(l2) is 0
            return 0 - 1
        if is_imm(r2) is 0
            return 0 - 1
        sl: regslot2(l2)
        if sl < 0
            return 0 - 1
        kk: sg * num_of(r2) * 8
        if kk > 127
            return 0 - 1
        if kk < 0 - 128
            return 0 - 1
        cflush(l2)
        return sl * 4096 + kk + 128
    if look(head, " + ") > 0 - 1
        return 0 - 1
    if name_ok(head) is 0
        return 0 - 1
    sl: regslot2(head)
    if sl < 0
        return 0 - 1
    cflush(head)
    return sl * 4096 + 128
rax_imm n:
    if n is 0
        emit2(49, 192)
        return
    if n > 0 - 1
        if n < 4294967296
            emit(184)
            emit4(n)
            return
    emit2(72, 184)
    emit8(n)
rcx_imm n:
    if n is 0
        emit2(49, 201)
        return
    if n > 0 - 1
        if n < 4294967296
            emit(185)
            emit4(n)
            return
    emit2(72, 185)
    emit8(n)
rax_str s:
    emit3(72, 141, 5)
    at: here()
    emit4(0)
    addp(at, "strrel", par_intern(s))
rdi_imm n:
    if n > 0 - 1
        if n < 128
            emit(106)
            emit(n)
            emit(95)
            return
        if n < 4294967296
            emit(191)
            emit4(n)
            return
    emit2(72, 191)
    emit8(n)
regslot2 name:
    sl: lshf2(name)
    if sl > 0 - 1
        if sl < 5
            return sl
    return 0 - 1
repl text old new:
    if _sov_find_text(text, old) < 0
        return text
    return repl_do(text, old, new)
repl_do text old new:
    n: length(text)
    o: length(old)
    gn: length(new)
    if o > 0
        if cfind1(text, 34) < 0
            hits: 0
            p: 0
            as long as p + o <= n
                if sg_match(text, p, old) is 1
                    hits: hits + 1
                    p: p + o
                if not
                    p: p + 1
            r: _sov_heap_alloc(n + hits * gn + 8)
            p: 0
            j: 0
            as long as p < n
                m: 0
                if p + o <= n
                    if sg_match(text, p, old) is 1
                        m: 1
                if m is 1
                    k: 0
                    as long as k + 8 <= gn
                        dummy: poke_i64(r, j, peek_i64(new, k))
                        j: j + 8
                        k: k + 8
                    as long as k < gn
                        dummy: poke_byte(r, j, peek_byte(new, k))
                        j: j + 1
                        k: k + 1
                    p: p + o
                if not
                    dummy: poke_byte(r, j, peek_byte(text, p))
                    j: j + 1
                    p: p + 1
            dummy: poke_byte(r, j, 0)
            return r
    r: _sov_heap_alloc(n + gn + 8)
    p: 0
    j: 0
    ins: 0
    as long as p < n
        b: peek_byte(text, p)
        if ins is 1
            if b is 92
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if p < n
                    poke_byte(r, j, peek_byte(text, p))
                    j: j + 1
                    p: p + 1
            if not
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
            if not
                rp_m: 0
                if p + o <= n
                    rp_m: 1
                rp_k: 0
                as long as rp_k < o
                    if rp_m is 1
                        if peek_byte(text, p + rp_k) is peek_byte(old, rp_k)
                            dummy: 0
                        if not
                            rp_m: 0
                    rp_k: rp_k + 1
                if rp_m is 1
                    k: 0
                    as long as k < gn
                        poke_byte(r, j, peek_byte(new, k))
                        j: j + 1
                        k: k + 1
                    p: p + o
                if rp_m is 0
                    poke_byte(r, j, b)
                    j: j + 1
                    p: p + 1
    poke_byte(r, j, 0)
    return r
restores:
    
    if fn_save_n > 4
        emit3(76, 139, 125)
        emit(216)
    if fn_save_n > 3
        emit3(76, 139, 117)
        emit(224)
    if fn_save_n > 2
        emit3(76, 139, 109)
        emit(232)
    if fn_save_n > 1
        emit3(76, 139, 101)
        emit(240)
    if fn_save_n > 0
        emit2(72, 139)
        emit(93)
        emit(248)
ret:
    emit(195)
rexx h:
    if h > 7
        return 74
    return 72
same a b:
    return _sov_str_eq(a, b)
scaled_rdx e:
    if sg_match(e, length(e) - 4, " * 8") is 0
        return 0
    head: scut(e, 0, length(e) - 4)
    if length(head) is 0
        return 0
    if peek_byte(head, 0) is 40 is 1
        if peek_byte(head, length(head) - 1) is 41 is 1
            inn: scut(head, 1, length(head) - 1)
            pp: look(inn, " + ")
            sg: 1
            if pp < 0
                pp: look(inn, " - ")
                sg: 0 - 1
            if pp < 0
                return 0
            l2: scut(inn, 0, pp)
            r2: scutr(inn, pp + 3)
            if name_ok(l2) is 1
                if is_imm(r2) is 1
                    loadv_rdx(l2)
                    kk: sg * num_of(r2)
                    if kk is not 0
                        emit3(72, 131, 194)
                        emit(kk % 256)
                    return 1
            return 0
    if look(head, " + ") > 0 - 1
        return 0
    if name_ok(head) is 1
        loadv_rdx(head)
        return 1
scaled_rsi e:
    if sg_match(e, length(e) - 4, " * 8") is 0
        return 0
    head: scut(e, 0, length(e) - 4)
    if length(head) is 0
        return 0
    if peek_byte(head, 0) is 40 is 1
        if peek_byte(head, length(head) - 1) is 41 is 1
            inn: scut(head, 1, length(head) - 1)
            pp: look(inn, " + ")
            sg: 1
            if pp < 0
                pp: look(inn, " - ")
                sg: 0 - 1
            if pp < 0
                return 0
            l2: scut(inn, 0, pp)
            r2: scutr(inn, pp + 3)
            if name_ok(l2) is 1
                if is_imm(r2) is 1
                    loadv_rsi(l2)
                    kk: sg * num_of(r2)
                    if kk is not 0
                        emit3(72, 131, 198)
                        emit(kk % 256)
                    return 1
            return 0
    if look(head, " + ") > 0 - 1
        p: look(head, " + ")
        l: scut(head, 0, p)
        r: scutr(head, p + 3)
        if is_imm(l) is 1
            if name_ok(r) is 1
                return 0

        if is_imm(r) is 1
            if name_ok(l) is 1
                return 0
        return 0
    if name_ok(head) is 1
        loadv_rsi(head)
        return 1
sc_disp e:
    if sg_match(e, length(e) - 4, " * 8") is 0
        return 0 - 1
    head: scut(e, 0, length(e) - 4)
    if length(head) is 0
        return 0 - 1
    if peek_byte(head, 0) is 40 is 1
        return 0 - 1
    p: look(head, " + ")
    if p < 0
        return 0 - 1
    l: scut(head, 0, p)
    r: scutr(head, p + 3)
    if length(l) is 0
        return 0 - 1
    if length(r) is 0
        return 0 - 1
    dv: 0 - 1
    if is_imm(l) is 1
        if name_ok(r) is 1
            if is_imm(r) is 0
                sc_dx: r
                dv: num_of(l)
    if is_imm(r) is 1
        if name_ok(l) is 1
            if is_imm(l) is 0
                sc_dx: l
                dv: num_of(r)
    return dv
scaled_shape e:
    if sg_match(e, length(e) - 4, " * 8") is 0
        return 0
    head: scut(e, 0, length(e) - 4)
    if length(head) is 0
        return 0
    if peek_byte(head, 0) is 40 is 1
        if peek_byte(head, length(head) - 1) is 41 is 1
            return 1
        return 0
    if look(head, " + ") > 0 - 1
        return 0
    if plain_name(head) is 1
        if is_imm(head) is 0
            return 1
sel_emit kind nm ix:
    if kind is 0
        loadv(nm)
        return 0
    loadv_rdi(nm)
    if scaled_rsi(ix) is 1
        emit_peek_rax()
tw_x: blank
sel_val t:
    if plain_name(t) is 1
        if is_imm(t) is 0
            return 0
    if _sov_starts_with(t, "peek_raw64(") is 1
        t: join("peek_i64(", cut(t, 11, length(t)))
    if pkpeek(t) is 1
        if scaled_shape(pk_x) is 1
            return 1
    return 0 - 1
setcc op:
    return setcc_k(intern_kid(op))

setcc_k oid:
    if oid is kid_opeq
        emit(15)
        emit(148)
        emit(192)
    if oid is kid_opne
        emit(15)
        emit(149)
        emit(192)
    if oid is kid_oplt
        emit(15)
        emit(156)
        emit(192)
    if oid is kid_opgt
        emit(15)
        emit(159)
        emit(192)
    if oid is kid_ople
        emit(15)
        emit(158)
        emit(192)
    if oid is kid_opge
        emit(15)
        emit(157)
        emit(192)
    emit(72)
    emit(15)
    emit(182)
    emit(192)
sibx h:
    return 199 + (h % 8) * 8
skip_body lines start bind:
    if syntax_mode > 0
        sx_end: syntax_block_end(lines, start, bind)
        if sx_end >= 0 -> return sx_end
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if peek_byte(s, 0) is 35
                j: j + 1
            if not
                if nind(raw) > bind
                    j: j + 1
                if not
                    return j
    return j
slot name:
    i: lshf2(name)
    if i > 0 - 1
        return i
    d6: lsha2(name)
    return _sov_list_len(locals) - 1
sq_square:
    if sq_acc is 1
        if sq_first is 1
            loadv(sq_name)
            emit(72)
            emit(15)
            emit(175)
            emit(192)
            return 0
        hh: homereg(sq_name)
        if hh > 0 - 1
            emit_mov_rcx_h(hh)
            emit(72)
            emit(15)
            emit(175)
            emit(201)
            emit(72)
            emit(1)
            emit(200)
            return 0
        print "Error: sum-of-squares register folding failed"
        err_where()
        had_err: 1
        return 0
    loadv(sq_name)
    emit(72)
    emit(15)
    emit(175)
    emit(192)
    if sq_first is 1
        emit(72)
        emit(137)
        emit(193)
        return 0
    emit(72)
    emit(1)
    emit(193)
    return 0
imul_rax_reg_imm sl v:
    emit(op_rex_b(sl))
    if v > 0 - 129
        if v < 128
            emit(107)
            emit(192 + op_low3(sl))
            emit(band(v, 255))
            return
    emit(105)
    emit(192 + op_low3(sl))
    emit4(v)

fold_bin oid a b:
    fold_ok: 0
    if oid is kid_opadd
        r: wrap_add(a, b)
        if band(bxor(a, r), bxor(b, r)) >= 0
            fold_ok: 1
            return r
        return 0
    if oid is kid_opsub
        r: wrap_sub(a, b)
        if band(bxor(a, b), bxor(a, r)) >= 0
            fold_ok: 1
            return r
        return 0
    if oid is kid_opmul
        aa: a
        if aa < 0
            aa: 0 - aa
        bb: b
        if bb < 0
            bb: 0 - bb
        if aa < 3037000500
            if bb < 3037000500
                fold_ok: 1
                return wrap_mul(a, b)
        return 0
    if oid is kid_opdiv
        if b is 0
            return 0
        if b is 0 - 1
            if a is 0 - 9223372036854775807 - 1
                return 0
        fold_ok: 1
        return a / b
    if oid is kid_opmod
        if b is 0
            return 0
        if b is 0 - 1
            if a is 0 - 9223372036854775807 - 1
                return 0
        fold_ok: 1
        return a % b
    if oid is kid_opband
        fold_ok: 1
        return band(a, b)
    if oid is kid_opbor
        fold_ok: 1
        return bor(a, b)
    if oid is kid_opbxor
        fold_ok: 1
        return bxor(a, b)
    if oid is kid_opbshl
        fold_ok: 1
        return bshl(a, band(b, 63))
    if oid is kid_opbshr
        fold_ok: 1
        return bshr(a, band(b, 63))
    if oid is kid_opbsar
        fold_ok: 1
        return bsar(a, band(b, 63))
    if oid is kid_opwadd
        fold_ok: 1
        return wrap_add(a, b)
    if oid is kid_opwsub
        fold_ok: 1
        return wrap_sub(a, b)
    if oid is kid_opwmul
        fold_ok: 1
        return wrap_mul(a, b)
    return 0

bin L R op:
    return bin_n(L, length(L), R, length(R), op)

bin_n L Ln R Rn op:
    return bin_k(L, Ln, R, Rn, intern_kid(op), 0, 0)

bin_k L Ln R Rn oid sx_tree sx_node:
    as long as Ln > 0
        bn_bb: peek_byte(L, 0)
        if bn_bb is 32 or bn_bb is 9 or bn_bb is 10 or bn_bb is 13
            L: L + 1
            Ln: Ln - 1
        if not
            leave
    as long as Ln > 0
        bn_bb: peek_byte(L, Ln - 1)
        if bn_bb is 32 or bn_bb is 9 or bn_bb is 10 or bn_bb is 13
            Ln: Ln - 1
        if not
            leave
    as long as Rn > 0
        bn_bb: peek_byte(R, 0)
        if bn_bb is 32 or bn_bb is 9 or bn_bb is 10 or bn_bb is 13
            R: R + 1
            Rn: Rn - 1
        if not
            leave
    as long as Rn > 0
        bn_bb: peek_byte(R, Rn - 1)
        if bn_bb is 32 or bn_bb is 9 or bn_bb is 10 or bn_bb is 13
            Rn: Rn - 1
        if not
            leave
    Limm: is_imm_n(L, Ln)
    Rimm: is_imm_n(R, Rn)
    Lb0: 0
    if Ln > 0
        Lb0: peek_byte(L, 0)
    Rb0: 0
    if Rn > 0
        Rb0: peek_byte(R, 0)
    if Limm is 1
        if Rimm is 1
            fv: fold_bin(oid, num_of_n(L, Ln), num_of_n(R, Rn))
            if fold_ok is 1
                rax_imm(fv)
                return 0
    if oid is kid_opadd
        if opt_peep is 1
            if Rimm is 1
                if plain_name_n(L, Ln) is 1
                    sl2: regslot2(span_str(L, Ln))
                    if sl2 > 0 - 1
                        vv: num_of_n(R, Rn)
                        if vv < 128
                            if vv > 0
                                cflush(span_str(L, Ln))
                                emit_lea_rax(sl2, vv)
                                return 0
    if oid is kid_opsub
        if opt_peep is 1
            if Rimm is 1
                if plain_name_n(L, Ln) is 1
                    sl2: regslot2(span_str(L, Ln))
                    if sl2 > 0 - 1
                        vv: 0 - num_of_n(R, Rn)
                        if vv > 0 - 128
                            if vv < 0
                                cflush(span_str(L, Ln))
                                emit_lea_rax(sl2, vv)
                                return 0
    if oid is kid_opmul
        if opt_peep is 1
            if Rimm is 1
                if plain_name_n(L, Ln) is 1
                    sl2: regslot2(span_str(L, Ln))
                    if sl2 > 0 - 1
                        vv: num_of_n(R, Rn)
                        if vv < 2147483648
                            if vv > 0 - 2147483649
                                cflush(span_str(L, Ln))
                                imul_rax_reg_imm(sl2, vv)
                                chk_ov()
                                return 0
            if Limm is 1
                if plain_name_n(R, Rn) is 1
                    sl2: regslot2(span_str(R, Rn))
                    if sl2 > 0 - 1
                        vv: num_of_n(L, Ln)
                        if vv < 2147483648
                            if vv > 0 - 2147483649
                                cflush(span_str(R, Rn))
                                imul_rax_reg_imm(sl2, vv)
                                chk_ov()
                                return 0
    if oid is kid_opwmul
        if opt_peep is 1
            if Rimm is 1
                if plain_name_n(L, Ln) is 1
                    sl2: regslot2(span_str(L, Ln))
                    if sl2 > 0 - 1
                        vv: num_of_n(R, Rn)
                        if vv < 2147483648
                            if vv > 0 - 2147483649
                                cflush(span_str(L, Ln))
                                imul_rax_reg_imm(sl2, vv)
                                return 0
            if Limm is 1
