                        if sq9 is 1
                            cflush(rt)
                            cflush(lat)
                            sq_acc: 1
                        sq_first: 1
                        sq_name: rt
                        sq_square()
                        sq_first: 0
                        sq_name: lat
                        sq_square()
                        if sq9 is 0
                            mov_rax_rcx()
                        sq_acc: 0
                        return 0
    if Rimm is 0
        if Limm is 0
            if digitb(Rb0) is 0
                if digitb(Lb0) is 0
                    if plain_name_n(R, Rn) is 1
                        if plain_name_n(L, Ln) is 1
                            if oid is kid_opmul
                                if span_eq(L, Ln, R, Rn) is 1
                                    loadv(span_str(L, Ln))
                                    emit(72)
                                    emit(15)
                                    emit(175)
                                    emit(192)
                                    chk_ov()
                                    return 0
                            brs: bin_rslot(span_str(R, Rn))
                            if brs > 0 - 1
                                if bin_rslot(span_str(L, Ln)) > 0 - 1
                                    cflush(span_str(R, Rn))
                                    loadv(span_str(L, Ln))
                                    bin_regop_k(oid, brs)
                                    return 0
                            loadv_rcx(span_str(R, Rn))
                            loadv(span_str(L, Ln))
                            emit_op_k(oid)
                            return 0
    if Rimm is 0
        if digitb(Rb0) is 0
            if plain_name_n(R, Rn) is 1
                br2: bin_rslot(span_str(R, Rn))
                if br2 > 0 - 1
                    cflush(span_str(R, Rn))
                    syntax_operand(sx_tree, sx_node, 0, L, Ln)
                    bin_regop_k(oid, br2)
                    return 0
    if Rimm is 0
        if digitb(Rb0) is 0
            if plain_name_n(R, Rn) is 1
                if bin_mem_ok_k(oid, span_str(R, Rn)) is 1
                    cflush(span_str(R, Rn))
                    syntax_operand(sx_tree, sx_node, 0, L, Ln)
                    bin_memop_k(oid, span_str(R, Rn))
                    return 0
    bc: 0
    if oid is kid_opadd
        bc: 1
    if oid is kid_opmul
        bc: 1
    if oid is kid_opband
        bc: 1
    if oid is kid_opbor
        bc: 1
    if oid is kid_opbxor
        bc: 1
    if oid is kid_opwadd
        bc: 1
    if oid is kid_opwmul
        bc: 1
    if oid is kid_opeq
        bc: 1
    if oid is kid_opne
        bc: 1
    if bc is 1
        if Limm is 0
            if digitb(Lb0) is 0
                if plain_name_n(L, Ln) is 1
                    bl2: bin_rslot(span_str(L, Ln))
                    if bl2 > 0 - 1
                        cflush(span_str(L, Ln))
                        syntax_operand(sx_tree, sx_node, 1, R, Rn)
                        bin_regop_k(oid, bl2)
                        return 0
                    if bin_mem_ok_k(oid, span_str(L, Ln)) is 1
                        cflush(span_str(L, Ln))
                        syntax_operand(sx_tree, sx_node, 1, R, Rn)
                        bin_memop_k(oid, span_str(L, Ln))
                        return 0
    # a plain local that lives in the frame (bin_rslot already took the ones in
    # registers) is a one-instruction load.  Do the left side first and then
    # load %rcx directly: emitting `push %rax; ...; mov %rax,%rcx; pop %rax`
    # around it was pure overhead.  (Pass 8 tried the reverse order - %rcx
    # loaded before syntax_operand(sx_tree, sx_node, 0, L, Ln) - and syntax_operand(sx_tree, sx_node, 0, L, Ln) clobbered it.)
    syntax_operand(sx_tree, sx_node, 0, L, Ln)
    push_rax()
    if oid is kid_opadd
        if Rimm is 1
            pop_rax()
            if arith_imm("add", num_of_n(R, Rn)) is 0
                chk_ov()
                return
