                            q: 1
                            res: join(res, letter(ln, j))
                            j: j + 1
                            d: 1
            if d is 0
                pb: 32
                if j > 0
                    pb: peek_byte(ln, j - 1)
                if wordchar(pb) is 0
                    m2: 0
                    if j + al + 1 < m
                        if sg_match(ln, j, alias) is 1
                            if peek_byte(ln, j + al) is 46
                                if wordchar(peek_byte(ln, j + al + 1)) is 1
                                    m2: 1
                    if m2 is 1
