    emit(15)
    emit(182)
    emit(20)
    emit(35)
    emit2(132, 210)
    cxsd: jz()
    emit3(73, 255, 196)
    emit(233)
    emit4(cxsl - (here() + 4))
    patch(cxsd)
    emit3(76, 137, 225)
    emit3(72, 255, 201)
    cxel: here()
    emit3(72, 131, 249)
    emit(0)
    cxee: jl()
    emit(15)
    emit(182)
    emit(20)
    emit(11)
    emit3(128, 250, 33)
    cxeb: jae()
    emit3(72, 255, 201)
    emit(233)
    emit4(cxel - (here() + 4))
    patch(cxeb)
    emit3(128, 250, 58)
    cxen: jne()
    emit(69)
    emit(131)
    emit(205)
    emit(1)
    patch(cxen)
    patch(cxee)
    emit(69)
    emit(49)
    emit(246)
    cxll: here()
    emit3(77, 57, 230)
    cxld: jae()
    emit(66)
    emit(15)
    emit(182)
    emit(20)
    emit(51)
    emit3(128, 250, 33)
    cxld2: jae()
    emit3(73, 255, 198)
    emit(233)
    emit4(cxll - (here() + 4))
    patch(cxld)
    patch(cxld2)
    emit3(77, 57, 230)
    cxg6: jae()
    emit(66)
    emit(15)
    emit(182)
    emit(20)
