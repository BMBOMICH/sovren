try_cat_while cond blines lines li:
    # string-builder loop: iv from 0 while iv < lim with body
    #   S: str_cat(S, EXPR)
    #   iv: iv + 1
    # EXPR is a string literal or a plain name != S,iv.  A runtime
    # builder (_sov_sb_new/_sov_sb_add) accumulates with geometric
    # growth, so the loop is O(total bytes) instead of alloc+copy of
    # the whole prefix per iteration (O(n^2)).  r8=builder, r10=lim,
    # r11=iv; the finished string is builder+16.
    if has_vm is 0
        return 0
    if leaf8 is 1
        return 0
    if _sov_list_len(blines) is not 2
        return 0
    c0: strip(cops(cond))
    p: look(c0, " < ")
    if p < 0
        return 0
    iv: repl(scut(c0, 0, p), " ", "_")
    lim0: scutr(c0, p + 3)
    lim: repl(lim0, " ", "_")
    if plain_name(iv) is 0
        return 0
    if lshf2(iv) < 0
        return 0
    limn: 0
    if is_imm(lim) is 0
        if plain_name(lim) is 0
            return 0
        limn: 1
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    if _sov_str_eq(l2, join(iv, join(": ", join(iv, " + 1")))) is 0
        return 0
    tc: look(l1, ": ")
    if tc < 1
        return 0
    snm: repl(scut(l1, 0, tc), " ", "_")
    if plain_name(snm) is 0
        return 0
    if _sov_str_eq(snm, iv) is 1
        return 0
    if lshf2(snm) < 0
        return 0
    rhs: scutr(l1, tc + 2)
    if _sov_starts_with(rhs, "str_cat(") is 0
        return 0
    if peek_byte(rhs, length(rhs) - 1) is not 41
        return 0
    al: split_args(cut(rhs, 8, length(rhs) - 1), _sov_list_new())
    if _sov_list_len(al) is not 2
        return 0
    a0: repl(strip(peek_i64(al, 16)), " ", "_")
    if _sov_str_eq(a0, snm) is 0
        return 0
    ex: strip(peek_i64(al, 24))
    exk: 0 - 1
    exl: blank
    if _sov_starts_with(ex, "\"") is 1
        if length(ex) > 1
            if peek_byte(ex, length(ex) - 1) is 34
                exk: 0
                exl: cut(ex, 1, length(ex) - 1)
    if exk < 0
        exn: repl(ex, " ", "_")
        if plain_name(exn) is 1
            if _sov_str_eq(exn, iv) is 0
                if _sov_str_eq(exn, snm) is 1
                    exk: 2
                if not
                    exk: 1
                    exl: exn
    if exk < 0
        return 0
    if limn is 1
        if _sov_str_eq(lim, snm) is 1
            return 0
        if _sov_str_eq(lim, iv) is 1
            return 0
    wind: sg_ind(_sov_list_get(lines, li))
    jj: li - 1
    got0: 0
    seen: 0
    as long as jj >= 0
        if got0 is 0
            rw: _sov_list_get(lines, jj)
            pl: strip(rw)
            if length(pl) > 0
                if peek_byte(pl, 0) is not 35
                    if sg_ind(rw) is not wind
                        jj: 0 - 1
                    if not
                        seen: seen + 1
                        if seen > 4
                            jj: 0 - 1
                        if not
                            if _sov_str_eq(pl, join(iv, ": 0")) is 1
                                got0: 1
                            if not
                                if _sov_starts_with(pl, join(iv, ": ")) is 1
                                    jj: 0 - 1
        jj: jj - 1
    if got0 is 0
        return 0
    cflush_all()
    if limn is 1
        loadv(lim)
    if not
        rax_imm(num_of(lim))
    emit3(73, 137, 194)
    emit3(77, 133, 210)
    cskp: jle()
    loadv(snm)
    emit3(72, 137, 199)
    emit2(65, 82)
    calln("_sov_sb_new")
    emit2(65, 90)
    emit3(73, 137, 192)
    emit3(69, 49, 219)
    align32()
    chd: here()
    if exk is 0
        rax_str(exl)
        emit3(72, 137, 198)
    if exk is 1
        loadv(exl)
        emit3(72, 137, 198)
    if exk is 2
        emit3(73, 141, 112)
        emit(16)
    emit3(76, 137, 199)
    emit2(65, 83)
    emit2(65, 82)
    calln("_sov_sb_add")
    emit2(65, 90)
    emit2(65, 91)
    emit3(73, 137, 192)
    emit3(73, 255, 195)
    emit3(77, 57, 211)
    emit(15)
    emit(140)
    cbk: here()
    emit4(0)
    put(cbk, chd - (cbk + 4))
    emit3(76, 137, 192)
    emit(72)
    emit(131)
    emit(192)
    emit(16)
    storev(snm)
    cp_nm: 0
    cp_pend_kill: 1
    emit3(76, 137, 216)
    storev(iv)
    cej: jmp()
    patch(cskp)
    patch(cej)
    return 1

try_def_peek var rhs:
    if has_vm is 0
        return 0
    if sv_lookup(var) > 0 - 1
        return 0
    dv: homereg(var)
    if dv < 0
        return 0
    q: fop2(rhs, "+", "-")
    if q < 1
        return 0
    if q > length(rhs) - 2
        return 0
    opc: peek_byte(rhs, q)
    if opc is not 43
        if opc is not 45
            return 0
    dl: scut(rhs, 0, q)
    dr: scutr(rhs, q + 1)
    if pkpeek(dl) is 0
        return 0
    dg: pk_g
    dx1: pk_x
    if pkpeek(dr) is 0
        return 0
    if _sov_str_eq(pk_g, dg) is 0
        return 0
    hr: peek_home(pk_x)
    if hr is dv
        return 0
    if hr < 0
        scaled_rdx(pk_x)
        hr: 2
    loadv_rdi(dg)
    hl: peek_home(dx1)
    if hl < 0
        scaled_rsi(dx1)
        hl: 6
    peek_reg_h(dv, hl)
    if opc is 45
        fold_mem_h(43, dv, hr)
    if not
        fold_mem_h(3, dv, hr)
    return 1
try_fill_while cond blines lines li:
    if _sov_list_len(blines) is not 2
        return 0
    c: strip(cops(cond))
    p: look(c, " < ")
    if p < 0
