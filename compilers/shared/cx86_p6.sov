    syntax_operand(sx_tree, sx_node, 1, R, Rn)
    mov_rcx_rax()
    pop_rax()
    emit_op_k(oid)
starts t p:
    return _sov_starts_with(t, p)
store_loc slot:
    if slot is 0
        emit(72)
        emit(137)
        emit(195)
        return
    if slot is 1
        emit(73)
        emit(137)
        emit(196)
        return
    if slot is 2
        emit(73)
        emit(137)
        emit(197)
        return
    if slot is 3
        emit(73)
        emit(137)
        emit(198)
        return
    if slot is 4
        emit(73)
        emit(137)
        emit(199)
        return
    if slot is 5
        if leaf8 is 1
            emit(73)
            emit(137)
            emit(192)
            return
    if slot is 6
        if leaf8 is 1
            emit(73)
            emit(137)
            emit(193)
            return
    if slot is 7
        if leaf8 is 1
            emit(73)
            emit(137)
            emit(194)
            return
    if slot is 8
        if leaf8 is 1
            emit(73)
            emit(137)
            emit(195)
            return
    emit(72)
    emit(137)
    emit(133)
    emit4(loc_off(slot))
store_rdx_h h:
    emit(rexx(h))
    emit(137)
    emit(20)
    emit(sibx(h))
    return 0
sq_name: blank
sq_first: 0
sq_acc: 0
storev name:
    dhf_s: plog_str(4, name)
    ci: cn_lookup(name)
    if ci > 0 - 1
        cemt: _sov_list_set(cemt, ci, 1)
    i: lshf2(name)
    if i > 0 - 1
        store_loc(i)
        return
    g: gn_lookup(name)
    if g > 0 - 1
        store_glob(name)
        return
    store_loc(slot(name))
strip t:
    if t is 0
        return blank
    return _sov_trim(t)
emit_nt_cx_info:
    # rdi = line -> rax = marks, bit-for-bit the Sovren cx_info.
    # rbx=l r12=n r13=r r14=lead r15=i.  Out-of-line peeks at
    # i+1..i+4 read the same flat-buffer bytes as the body does.
    emit(83)
    emit2(65, 84)
    emit2(65, 85)
    emit2(65, 86)
    emit2(65, 87)
    emit3(72, 137, 251)
    emit(69)
    emit(49)
    emit(237)
    emit(77)
    emit(49)
