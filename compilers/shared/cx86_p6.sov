                            if vv > 0 - 2147483649
                                cflush(span_str(R, Rn))
                                imul_rax_reg_imm(sl2, vv)
                                return 0
    if has_vm is 1
        if oid is kid_opsub
            if pkpeek_n(L, Ln) is 1
                lg: pk_g
                lx: pk_x
                if pkpeek_n(R, Rn) is 1
                    if _sov_str_eq(pk_g, lg) is 1
                        hr: peek_home(pk_x)
                        if hr < 0
                            scaled_rdx(pk_x)
                            hr: 2
                        loadv_rdi(lg)
                        hl: peek_home(lx)
                        if hl < 0
                            scaled_rsi(lx)
                            hl: 6
                        peek_rax_h(hl)
                        fold_rax_h(43, hr)
