        if Rimm is 1
            pop_rax()
            if arith_imm("band", num_of_n(R, Rn)) is 0
                return
            rcx_imm(num_of_n(R, Rn))
            emit_op("band")
            return
    if oid is kid_opbor
        if Rimm is 1
            pop_rax()
            if arith_imm("bor", num_of_n(R, Rn)) is 0
                return
            rcx_imm(num_of_n(R, Rn))
            emit_op("bor")
            return
    if oid is kid_opbxor
        if Rimm is 1
            pop_rax()
            if arith_imm("bxor", num_of_n(R, Rn)) is 0
