                poke4(flat, HDR + at + 4, 4070572032 + ((fa / 65536) % 65536) * 32)
                poke4(flat, HDR + at + 8, 4072669184 + ((fa / 4294967296) % 65536) * 32)
                poke4(flat, HDR + at + 12, 4074766336 + ((fa / 281474976710656) % 65536) * 32)
            if not
                print "Error: no such task"
                _sov_print(val)
                had_err: 1
        if same(kind, "str64") is 1
            sa: str_addr + val
            poke4(flat, HDR + at, 3531603968 + (sa % 65536) * 32 + 1)
            poke4(flat, HDR + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32 + 1)
            poke4(flat, HDR + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32 + 1)
        if same(kind, "cbz_trap") is 1
            ti: idx(fn_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(fn_offs, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, HDR + at, 3019898880 + (rl % 524288) * 32 + val)
        if same(kind, "b19_trap") is 1
            ti: idx(fn_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(fn_offs, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, HDR + at, 1409286144 + (rl % 524288) * 32 + 2)
        if same(kind, "rel") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: tgt - (at + 4)
                poke4(flat, HDR + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "str") is 1
            poke8(flat, HDR + at, str_addr + val)
        if same(kind, "str32") is 1
            poke4(flat, HDR + at, str_addr + val)
        if same(kind, "glob") is 1
            gx: idx(glob_names, val)
            poke8(flat, HDR + at, glob_addr + gx * 8)
        i: i + 1
    if had_err is 1
        return
    smi: idx(fn_names, "main")
    smoff: 0
    if smi > 0 - 1
        smoff: _sov_list_get(fn_offs, smi)
    so_name("libsovren.so", flat, so_strtab + 1)
    so_name("sovren_main", flat, so_strtab + 14)
