main argc argv:
    # remember where this compiler lives, so its library and runtime
    # are found no matter which folder you run it from
    self_dir: dirname(tidy_path(peek_ptr(argv, 0)))
    if argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail()
    inf: blank
    outf: blank
    i: 1
    as long as i < argc
        arg: peek_ptr(argv, i)
        if same(arg, "--bare") is 1
            bare_mode: 1
        if not
            if same(arg, "-o") is 1
                i: i + 1
                if i < argc
                    outf: peek_ptr(argv, i)
            if not
                if same(arg, "build") is 0
                    inf: arg
        i: i + 1
    if length(inf) is 0
        print "Error: no input"
        fail()
    if length(outf) is 0
        d: look(inf, ".sov")
        if d > 0 - 1
            outf: cut(inf, 0, d)
        if not
            outf: join(inf, ".out")
    print "Compiling"
    _sov_print(inf)
    src: load_file(inf)
    if src is 0
        print "Error: cannot read input"
        fail()
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    src: join(join("# pad line so main is not first", nl), src)
    used_libs: blank
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    need: 0
    mmap_sz: 12582912
    if look(src, "_sov_list") > 0 - 1
        need: 1
    if look(src, "load_file") > 0 - 1
        need: 1
    if look(src, "_sov_buf") > 0 - 1
        need: 1
    if look(src, "_sov_alloc") > 0 - 1
        need: 1
    if look(src, "_sov_set_byte") > 0 - 1
        need: 1
    if look(src, "peek_byte") > 0 - 1
        need: 1
    if look(src, "poke_byte") > 0 - 1
        need: 1
    if look(src, "spawn ") > 0 - 1
        need: 1
    if look(src, "join ") > 0 - 1
        need: 1
    rt: blank
    if bare_mode is 1
        need: 0
    if need is 1
        mmap_sz: 1073741824
        rt: load_file("runtime.sov")
        if rt is 0
            rt: load_file("linux/runtime.sov")
        if rt is 0
            rt: load_file(join(self_dir, "/runtime.sov"))
        if rt is 0
            rt: load_file(join(self_dir, "/../runtime.sov"))
        if rt is 0
            print "Error: cannot read runtime"
            fail()
    src_base: 1
    if length(rt) > 0
        src_base: src_base + _sov_list_len(lines_of(rt))
    if length(extra) > 0
        src_base: src_base + _sov_list_len(lines_of(extra))
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    all: join(rt, nl)
    src_base: src_base + 1
    # the arm64 kernel numbers its syscalls differently. this
    # function is appended to the program being built (not to the
    # shared runtime, so other targets never carry it) and the
    # syscall builtin routes every number through it.
        all: join(all, "# mem_copy and mem_set, injected for the arm targets: the x86 back\n# end has them as one rep movsb / rep stosb each, and a shared library\n# may not use a builtin that only one machine has. written with\n# peek_byte and poke_byte, which are builtins on every target.\n_sov_mem_copy d s n:\n    i: 0\n    as long as i < n\n        poke_byte(d, i, peek_byte(s, i))\n        i: i + 1\n    return d\n\n_sov_mem_set d v n:\n    j: 0\n    as long as j < n\n        poke_byte(d, j, v)\n        j: j + 1\n    return d\n")
        src_base: src_base + 20
    all: join(all, "# a thread ends itself through this injected task, emitted\n# unconditionally because runtime.sov calls it whether or not the program\n# ever makes a syscall. on arm64 a thread is a detached clone, so ending it\n# is the exit syscall\n_sov_thread_exit:\n    syscall(60, 0, 0, 0, 0, 0, 0)\n    return 0 - 1\n")
    src_base: src_base + 6
    all: join(all, nl)
    all: join(all, "# x86 syscall number in, arm64 number out (the arm64 kernel\n# numbers its calls differently and has no plain open, pipe or\n# dup2; openat, pipe2 and dup3 stand in). Only the arm64 back end\n# calls this, so only arm64 builds carry it.\n_sov_sysnum n:\n    if n is 0\n        return 63\n    if n is 1\n        return 64\n    if n is 3\n        return 57\n    if n is 7\n        return 73\n    if n is 8\n        return 62\n    if n is 13\n        return 134\n    if n is 9\n        return 222\n    if n is 11\n        return 215\n    if n is 16\n        return 29\n")
    all: join(all, "    if n is 22\n        return 59\n    if n is 33\n        return 24\n    if n is 35\n        return 101\n    if n is 39\n        return 172\n    if n is 41\n        return 198\n    if n is 42\n        return 203\n    if n is 43\n        return 202\n    if n is 44\n        return 206\n    if n is 45\n        return 207\n    if n is 49\n        return 200\n    if n is 50\n        return 201\n    if n is 57\n        return 220\n    if n is 59\n        return 221\n    if n is 60\n        return 93\n    if n is 61\n        return 260\n    if n is 62\n        return 129\n")
    all: join(all, "    if n is 79\n        return 17\n    if n is 80\n        return 49\n    if n is 82\n        return 50\n    if n is 84\n        return 81\n    if n is 90\n        return 34\n    if n is 102\n        return 174\n    if n is 104\n        return 176\n    if n is 107\n        return 175\n    if n is 108\n        return 177\n    if n is 144\n        return 227\n    if n is 217\n        return 61\n    if n is 218\n        return 169\n    if n is 228\n        return 115\n    if n is 231\n        return 94\n    if n is 257\n        return 56\n    if n is 260\n        return 166\n    if n is 302\n        return 261\n    if n is 318\n        return 278\n    if n is 56\n        return 220\n    if n is 202\n        return 98\n    if n is 72\n        return 25\n    if n is 74\n        return 82\n    if n is 77\n        return 46\n    if n is 262\n        return 79\n    if n is 263\n        return 35\n    return n\n")
    all: join(all, nl)
    # these extra lines shift the error-line base, so the jobs
    # after them still count as library jobs, not user jobs
    src_base: src_base + 81

    all: join(all, src)
    so_compile(all)
    write_elf(outf)
    if had_err is 1
        fail()
    print "Wrote"
    _sov_print(outf)
push_reg n:
    emitw(4162785248 + n)

# ldr xN,[sp],#16
xor_rax_so:
    emitw(2854159328)

emit_write_lit s:
    n: length(s)
    set_reg(0, 1)
    off: intern_nz(s)
    at: here()
    movz_x(1, 0, 0)
    movk_x(1, 0, 1)
    movk_x(1, 0, 2)
    addp(at, "str64", off)
    set_reg(2, n)
    set_reg(8, sc_write)
    sysc()

# mmap(0, sz, RW, PRIVATE|ANON, -1, 0) -> x0
emit_nodump_so:
    return

# x86 string-instruction fast paths have no AArch64 form.
# Returning 0 makes the caller emit an ordinary loop instead.
emit_print:
    fn_names: _sov_list_add(fn_names, "_sov_print")
    fn_offs: _sov_list_add(fn_offs, here())
    # a value under 65536 is not a real address. reading from it
    # would crash, so hand it to the number printer instead.
    emitw(4047519775)
    hi: here()
    emitw(1409286146)
    used_pi: 1
    calln("_sov_print_int")
    ret()
    put_arm(hi, here() - hi)
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    mov_reg(19, 0)
    mov_reg(9, 19)
    set_reg(20, 0)
    top: here()
    emitw(2333344042)
    emitw(960495947)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432698004)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ex)
    set_reg(0, 1)
    mov_reg(1, 19)
    mov_reg(2, 20)
    set_reg(8, sc_write)
    sysc()
    set_reg(0, 1)
    nl_at: here()
    movz_x(1, 0, 0)
    movk_x(1, 0, 1)
    movk_x(1, 0, 2)
    addp(nl_at, "str64", intern_nz("\n"))
    set_reg(2, 1)
    set_reg(8, sc_write)
    sysc()
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)
    ret()

# x0 = number, writes it in decimal then a newline
put_sub_sp at n:
    v: n
    if v < 0
        v: 0
    oc_set_word(at, 3506439167 + (v % 4096) * 1024)
    return 0

spawn_emit name argc:
    if argc is 1
        pop_rax()
    if not
        if argc is 2
            pop_reg(1)
            pop_rax()
        if not
            if argc is 3
                pop_reg(2)
                pop_reg(1)
                pop_rax()
            if not
                if argc is 4
                    pop_reg(3)
                    pop_reg(2)
                    pop_reg(1)
                    pop_rax()
                if not
                    if argc is 5
                        pop_reg(4)
                        pop_reg(3)
                        pop_reg(2)
                        pop_reg(1)
                        pop_rax()
                    if not
                        if argc is 6
                            pop_reg(5)
                            pop_reg(4)
                            pop_reg(3)
                            pop_reg(2)
                            pop_reg(1)
                            pop_rax()
    mov_reg(6, 5)
    mov_reg(5, 4)
    mov_reg(4, 3)
    mov_reg(3, 2)
    mov_reg(2, 1)
    mov_reg(1, 0)
    aat: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    movk_x(0, 0, 3)
    addp(aat, "fnaddr64", name)
    calln("_sov_thread_spawn")
    return 0
