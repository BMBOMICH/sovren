                    if isfib is 1
                        emit_fib_iter_a64()
                    if same(nm, "main") is 1
                        skip_al: dead_iota(_sov_list_get(bodies, fi))
                        if need_priv is 1
                            emit_nodump_so()
                        so_body(tops)
                        cflush_all()
                    if isfib is 0
                        so_body(_sov_list_get(bodies, fi))
                    if saw_str is 1
