rax_str s:
    at: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    addp(at, "str64x0", intern(s))
call_args name argc:
    if argc is 1
        pop_rax()
        mov_reg(0, 0)
    if not
        if argc is 2
            pop_reg(1)
            pop_rax()
        if not
            if argc is 3
                pop_reg(2)
                pop_reg(1)
                pop_rax()
            if not
                if argc is 4
                    pop_reg(3)
                    pop_reg(2)
                    pop_reg(1)
                    pop_rax()
                if not
                    if argc is 5
                        pop_reg(4)
                        pop_reg(3)
                        pop_reg(2)
                        pop_reg(1)
                        pop_rax()
                    if not
                        if argc is 6
                            pop_reg(5)
                            pop_reg(4)
                            pop_reg(3)
                            pop_reg(2)
                            pop_reg(1)
                            pop_rax()
                        if not
                            if argc is 7
                                pop_reg(6)
                                pop_reg(5)
                                pop_reg(4)
                                pop_reg(3)
                                pop_reg(2)
                                pop_reg(1)
                                pop_rax()
    if same(name, "_sov_alloc") is 1
        used_al: 1
    if same(name, "_sov_strlen") is 1
        used_sl: 1
    if same(name, "_sov_str_eq") is 1
        used_eq: 1
    if same(name, "cfunc") is 1
        # x0 holds the address, x1..x6 the arguments. C wants the
        # arguments in x0..x5, so shift them down and call.
        mov_reg(9, 0)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        emitw(3594453280)
        return
    if same(name, "syscall") is 1
        # arm64 numbers its syscalls differently. the number in x0
        # goes through _sov_sysnum (a plain Sovren job in the
        # runtime) and the answer, in x0 again, becomes x8. The six
        # arguments sit in x1..x6, which the translation job
        # clobbers (they are caller-saved), so they are parked on
        # the stack first and come back after.
        push_reg(6)
        push_reg(5)
        push_reg(4)
        push_reg(3)
        push_reg(2)
        push_reg(1)
        calln("_sov_sysnum")
        mov_reg(8, 0)
        pop_reg(1)
        pop_reg(2)
        pop_reg(3)
        pop_reg(4)
        pop_reg(5)
        pop_reg(6)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        sysc()
        return
    if same(name, "hlt") is 1
        emitw(3573751935)
        return
    if same(name, "cli") is 1
        emitw(3573760735)
        return
    if same(name, "sti") is 1
        emitw(3573760767)
        return
    if same(name, "peek_raw8") is 1
        ldrb_x0_x0x1()
        return
    if same(name, "peek_raw64") is 1
        ldr_x0_x0x1()
        return
    if same(name, "poke_raw8") is 1
        strb_x2_x0x1()
        return
    if same(name, "poke_raw64") is 1
        str_x2_x0x1()
        return
    if same(name, "peek_byte") is 1
        chk_mem(1)
        ldrb_x0_x0x1()
        return
    if same(name, "peek_i64") is 1
        chk_mem(8)
        ldr_x0_x0x1()
        return
    if same(name, "peek_ptr") is 1
        chk_mem(8)
        ldr_x0_x0x1()
        return
    if same(name, "poke_byte") is 1
        chk_mem(1)
        strb_x2_x0x1()
        return
    if same(name, "poke_i64") is 1
        chk_mem(8)
        str_x2_x0x1()
        return
    if same(name, "sp") is 1
        # mov x0, sp: orr x0, xzr, sp (the shared runtime's thread
        # entry asks for the stack pointer; dead on machines without
        # threads, valid a64 either way)
        emitw(2854159328)
        return
    calln(name)
stmt_so line:
    s: strip(line)
    if length(s) is 0
        return
    if starts(s, "#") is 1
        return
    s: compound(s)
    q: 0
    qi: 0
    as long as qi < length(s)
        if _sov_byte_at(s, qi) is 92
            qi: qi + 1
        if not
            if _sov_byte_at(s, qi) is 34
                q: q + 1
        qi: qi + 1
    if q % 2 is not 0
        print "Error: unterminated text"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    if length(s) > 1000
        print "Error: line too long, split it up"
        print err_line
        had_err: 1
        return
    if starts(s, "use ") is 1
        return
    if same(s, "private") is 1
        return
    if starts(s, "wipe ") is 1
        expr(strip(cut(s, 5, length(s))))
        mov_rdi_rax()
        test_rax()
        wsk: jz()
        wtop: here()
        emitw(960495650)
        emitw(1895825503)
        wend: here()
        emitw(1409286144)
        emitw(956301375)
        emitw(2432697377)
        wb: here()
        emitw(335544320)
        put_arm(wb, wtop - wb)
        put_here(wend)
        patch(wsk)
        return
    if starts(s, "join ") is 1
        # this file carries its own statement dispatcher, so the join
        # arm needs it here too, not only in carm: evaluate the
        # handle, wait for nothing. spawn answers -1 on this machine
        expr(strip(cut(s, 5, length(s))))
        return
    if starts(s, "print ") is 1
        arg: strip(cut(s, 6, length(s)))
        if ends_times(arg) is 1
            head: strip(cut(arg, 0, length(arg) - 6))
            sp: find_last_sp(head)
            if sp > 0 - 1
                do_print_times(strip(cut(head, 0, sp)), strip(cut(head, sp + 1, length(head))))
                return
        if length(arg) > 1
            if _sov_byte_at(arg, 0) is 34
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
        if starts(arg, "peek_byte(") is 1
            if opt_imm > 0
                emit_write_lit(i2s(opt_imm))
                return
        typ: expr(arg)
        mov_rdi_rax()
        if typ is 1
            used_pr: 1
            calln("_sov_print")
        if not
            used_pi: 1
            calln("_sov_print_int")
        return
    had_col: 0
    col: find_col(s)
    if col > 0
        if col < length(s) - 1
            had_col: 1
            s: join("<-- ", join(strip(cut(s, 0, col)), join(" := ", strip(cut(s, col + 1, length(s))))))
    if starts(s, "<-- ") is 1
        if had_col is 0
            print "Error: bad line"
            _sov_print(s)
            print err_line
            had_err: 1
            return
        rest: cut(s, 4, length(s))
        t: find_sep(rest)
        if t > 0 - 1
            var: repl(strip(cut(rest, 0, t)), " ", "_")
            rhs: strip(cut(rest, t + 4, length(rest)))
            if same(rhs, join(var, " + 1")) is 1
                inc_var(var)
                return
            if same(rhs, join(var, " - 1")) is 1
                dec_var(var)
                return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            if length(rhs) > 0
                if digit(letter(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        if br_depth is 0
                            nv: _sov_atoi(rhs)
                            cset(var, nv)
                            if nv > 0
                                kn: var
                                kv: nv
                            drop_str(var)
                            if has_vm is 0
                                return
            if try_alloc_imm(var, rhs) is 1
                mark_str(var)
                return
            typ: expr(rhs)
            storev(var)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if starts(rhs, "_sov_strlen(") is 1
                if did_stos is 1
                    if kv > 0
                        kn: var
        return
    if same(s, "return") is 1
        xor_rax_so()
        leave()
        ret()
        return
    if starts(s, "return ") is 1
        typ: expr(cut(s, 7, length(s)))
        if typ is 1
            saw_str: 1
        leave()
        ret()
        return
    if same(s, "stop") is 1
        set_reg(0, 0)
        set_reg(8, sc_exit)
        sysc()
        return
    if look(s, "(") < 0
        print "Error: bad line"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    expr(s)
so_body lines:
    n: _sov_list_len(lines)
    i: 0
    bk: _sov_list_new()
    bi: _sov_list_new()
    bj: _sov_list_new()
    bs: _sov_list_new()
    be: _sov_list_new()
    br: _sov_list_new()
    as long as i < n
        raw: _sov_list_get(lines, i)
        s: strip(raw)
        err_line: i + 1
        if _sov_list_len(stmt_lns) > i
            err_line: _sov_list_get(stmt_lns, i)
        ind: nind(raw)
        if length(s) is 0
            i: i + 1
        if not
            if starts(s, "#") is 1
                i: i + 1
            if not
                isel: 0
                if same(s, "if not") is 1
                    isel: 1
                if starts(s, "except") is 1
                    isel: 1
                popgo: 1
                as long as popgo is 1
                    if _sov_list_len(bk) is 0
                        popgo: 0
                    if not
                        last: _sov_list_len(bk) - 1
                        if ind > _sov_list_get(bi, last)
                            popgo: 0
                        if not
                            stay: 0
                            if isel is 1
                                if ind is _sov_list_get(bi, last)
                                    if same(_sov_list_get(bk, last), "if") is 1
                                        stay: 1
                                    if same(_sov_list_get(bk, last), "try") is 1
                                        stay: 1
                            if stay is 1
                                popgo: 0
                            if not
                                popblk()
                loop_ok: 0
                if starts(s, "as long as ") is 1
                    s: join("while ", strip(cut(s, 11, length(s))))
                    loop_ok: 1
                if starts(s, "if ") is 1
                    if same(s, "if not") is 0
                        if starts(s, "if not ") is 0
                            expr(cut(s, 3, length(s)))
                            test_rax()
                            z: jz()
                            bk: _sov_list_add(bk, "if")
                            bi: _sov_list_add(bi, ind)
                            bj: _sov_list_add(bj, z)
                            bs: _sov_list_add(bs, 0)
                            be: _sov_list_add(be, _sov_list_new())
                            br: _sov_list_add(br, 0)
                            br_depth: br_depth + 1
                        if not
                            stmt_so(s)
                    if not
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                if not
                    if same(s, "\x00__removed_and_if_not") is 1
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                    if not
                        if starts(s, "do while ") is 1
                            bln: collect_body(lines, i + 1, ind)
                            if try_opt_while(cut(s, 9, length(s)), bln) is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                            if not
                                cflush_all()
                                st: here()
                                # emit_cmp_jge removed (always -1): general path
                                expr(cut(s, 9, length(s)))
                                test_rax()
                                z: jz()
                                bk: _sov_list_add(bk, "while")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, st)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                                br_depth: br_depth + 1
                        if not
                            if loop_ok is 1
                                bln: collect_body(lines, i + 1, ind)
                                if try_opt_while(cut(s, 6, length(s)), bln) is 1
                                    i: skip_body(lines, i + 1, ind)
                                    i: i - 1
                                if not
                                    cflush_all()
                                    st: here()
                                    # emit_cmp_jge removed (always -1): general path
                                    expr(cut(s, 6, length(s)))
                                    test_rax()
                                    z: jz()
                                    bk: _sov_list_add(bk, "while")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, z)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                          br_depth: br_depth + 1
                              br: _sov_list_add(br, 0)
                            if not
                                if same(s, "do forever") is 1
                                    st: here()
                                    bk: _sov_list_add(bk, "forever")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, 0 - 1)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                    br_depth: br_depth + 1
                                if not
                                    if starts(s, "\x00__removed_repeat ") is 1
                                        cflush_all()
                                        tmp: cut(s, 7, length(s))
                                        tp: look(tmp, " times")
                                        if tp > 0 - 1
                                            tmp: cut(tmp, 0, tp)
                                        expr(tmp)
                                        cn: "__rep_c"
                                        inn: "__rep_i"
                                        storev(cn)
                                        xor_rax_so()
                                        storev(inn)
                                        rs: idx(locals, inn)
                                        cs: idx(locals, cn)
                                        st: here()
                                        load_loc(rs)
                                        push_rax()
                                        load_loc(cs)
                                        mov_rcx_rax()
                                        pop_rax()
                                        cmp_rax_rcx()
                                        setcc("lt")
                                        test_rax()
                                        z: jz()
                                        bk: _sov_list_add(bk, "repeat")
                                        bi: _sov_list_add(bi, ind)
                                        bj: _sov_list_add(bj, z)
                                        bs: _sov_list_add(bs, st)
                                        be: _sov_list_add(be, _sov_list_new())
                                        br: _sov_list_add(br, rs)
                                        br_depth: br_depth + 1
                                    if not
                                        if same(s, "try") is 1
                                            cflush_all()
                                            if idx(glob_names, "err_top") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_top")
                                            if idx(glob_names, "err_val") is 0 - 1
                                                glob_names: _sov_list_add(glob_names, "err_val")
                                            # the frame: the error top, the frame
                                            # pointer, the stack, and where the handler
                                            # starts
                                            emitw(2432697321)
                                            emitw(4162785257)
                                            load_glob("err_top")
                                            emitw(4162785248)
                                            ta: here()
                                            emitw(268435466)
                                            emitw(4162785258)
                                            emitw(2432697321)
                                            mov_reg(0, 9)
                                            store_glob("err_top")
                                            bk: _sov_list_add(bk, "try")
                                            bi: _sov_list_add(bi, ind)
                                            bj: _sov_list_add(bj, 0)
                                            bs: _sov_list_add(bs, 0)
                                            be: _sov_list_add(be, _sov_list_new())
                                            br: _sov_list_add(br, ta)
                                            br_depth: br_depth + 1
                                        if not
                                            if starts(s, "except") is 1
                                                last: _sov_list_len(bk) - 1
                                                if last > 0 - 1
                                                    if same(_sov_list_get(bk, last), "try") is 1
                                                        ev: strip(cut(s, 6, length(s)))
                                                        # pass 68: a local may not share a global's name -
                                                        # the load/store ladders divert global-named names to
                                                        # the global until the moment a local appears, so the
                                                        # one hole is an except name materialising a local
                                                        # mid-function. refuse loudly.
                                                        if idx(glob_names, ev) > 0 - 1
                                                            if idx(locals, ev) < 0
                                                                print "Error: the except name shadows a global"
                                                                _sov_print(ev)
                                                                print err_line
                                                                had_err: 1
                                                        load_glob("err_top")
                                                        mov_reg(9, 0)
                                                        emitw(4181723424)
                                                        store_glob("err_top")
                                                        emitw(2432746495)
                                                        tb: here()
                                                        emitw(335544320)
                                                        bs: _sov_list_set(bs, last, tb)
                                                        put_here(_sov_list_get(br, last))
                                                        load_glob("err_val")
                                                        store_loc(slot(ev))
                                                        bk: _sov_list_add(bk, "except")
                                                        bi: _sov_list_add(bi, ind)
                                                        bj: _sov_list_add(bj, 0)
                                                        bs: _sov_list_add(bs, 0)
                                                        be: _sov_list_add(be, _sov_list_new())
                                                        br: _sov_list_add(br, 0)
                                                        br_depth: br_depth + 1
                                                    if not
                                                        print "Error: except without try"
                                                        _sov_print(s)
                                                        print err_line
                                                        had_err: 1
                                                if not
                                                    print "Error: except without try"
                                                    _sov_print(s)
                                                    print err_line
                                                    had_err: 1
                                            if not
                                                if starts(s, "raise ") is 1
                                                    expr(cut(s, 6, length(s)))
                                                    if idx(glob_names, "err_val") is 0 - 1
                                                        glob_names: _sov_list_add(glob_names, "err_val")
                                                    if idx(glob_names, "err_top") is 0 - 1
                                                        glob_names: _sov_list_add(glob_names, "err_top")
                                                    store_glob("err_val")
                                                    load_glob("err_top")
                                                    # x10 keeps the frame: store_glob
                                                    # spends x9 reaching its cell, so
                                                    # the frame read must not go through
                                                    # x9 after that. walking +32/+48 of a three-slot
                                                    # frame lands x29 and the
                                                    # nowhere stack on top of each
                                                    # other. reads: old top at +16,
                                                    # caller sp at +32, handler at +0,
                                                    # branch by x10, which ldr keeps.
                                                    mov_reg(10, 0)
                                                    emitw(4043309407)
                                                    zz: here()
                                                    emitw(1409286144)
                                                    emitw(4181723456)
                                                    store_glob("err_top")
                                                    emitw(4181725515)
                                                    emitw(2432696703)
                                                    emitw(4181721418)
                                                    emitw(3592356160)
                                                    put_here(zz)
                                                    load_glob("err_val")
                                                    used_pi: 1
                                                    calln("_sov_print_int")
                                                    set_reg(0, 1)
                                                    set_reg(8, sc_exit)
                                                    sysc()
                                                if not
                                                    stmt_so(s)
                i: i + 1
    as long as _sov_list_len(bk) > 0
        popblk()
prep_main_so names params bodies:
    thin_main: 0
    skip_al: blank
    fi: 0
    as long as fi < _sov_list_len(names)
        if same(_sov_list_get(names, fi), "main") is 1
            if _sov_list_len(_sov_list_get(params, fi)) is 0
                thin_main: 1
            skip_al: dead_iota(_sov_list_get(bodies, fi))
        fi: fi + 1
so_compile source:
    oc: _sov_list_new()
    iota_ptr: blank
    iota_lim: blank
    kn: blank
    kv: 0
    skip_al: blank
    used_al: 0
    used_sl: 0
    used_eq: 0
    used_pr: 0
    used_pi: 0
    used_tr: 0
    did_stos: 0
    thin_main: 0
    has_vm: 0
    need_priv: 0
    saw_str: 0
    str_vars: _sov_list_new()
    str_fns: _sov_list_new()
    ar_names: _sov_list_new()
    ar_cnt: _sov_list_new()
    str_fns: _sov_list_add(str_fns, "cat")
    str_fns: _sov_list_add(str_fns, "strcat")
    str_fns: _sov_list_add(str_fns, "_sov_strcat")
    str_fns: _sov_list_add(str_fns, "sub")
    str_fns: _sov_list_add(str_fns, "trim")
    str_fns: _sov_list_add(str_fns, "ch")
    str_fns: _sov_list_add(str_fns, "_sov_substring")
    str_fns: _sov_list_add(str_fns, "str_cat")
    str_fns: _sov_list_add(str_fns, "str_cut")
    str_fns: _sov_list_add(str_fns, "str_trim")
    str_fns: _sov_list_add(str_fns, "str_join3")
    str_fns: _sov_list_add(str_fns, "join")
    str_fns: _sov_list_add(str_fns, "strip")
    str_fns: _sov_list_add(str_fns, "cut")
    str_fns: _sov_list_add(str_fns, "repl")
    str_fns: _sov_list_add(str_fns, "letter")
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) is 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") is 0
                    if starts(pre_t, "use ") is 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c is length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") is 1
                                            pre_in: 0
                                        if not
                                            if pre_in is 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
