use carm
stmt_join_op:
    calln("_sov_thread_join")
    return 0

# the .so image is fixed-base (no slide walk): the walk call
# sites are pie_walk-gated and never fire, but the task
# reference must exist - a no-op, the same way ios defines its own
emit_walk:
    return
fib_nm: 0
can_used: 0
fib_drop: 0
fw_pos: 0
fw_on: 0
oc: 0
strb: 0
