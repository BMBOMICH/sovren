                        emit_nodump_so()
                    so_body(tops)
                    cflush_all()
                    so_body(_sov_list_get(bodies, fi))
                    if saw_str is 1
                        mark_fn_str(nm)
                    set_reg(0, 0)
                    set_reg(8, sc_exit)
                    sysc()
                if not
                    isfib: fiblike(nm, ps, _sov_list_get(bodies, fi))
