        if same(kind, "glob64") is 1
            gx: idx(glob_names, val)
            ga: glob_addr + gx * 8
            poke4(flat, HDR + at, 3531603968 + (ga % 65536) * 32 + 9)
            poke4(flat, HDR + at + 4, 4070572032 + ((ga / 65536) % 65536) * 32 + 9)
