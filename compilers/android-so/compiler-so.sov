        nm: _sov_list_get(names, fi)
        if idx(fn_names, nm) < 0
                fn_names: _sov_list_add(fn_names, nm)
                fn_offs: _sov_list_add(fn_offs, here())
                locals: _sov_list_new()
                str_vars: _sov_list_new()
                saw_str: 0
                br_depth: 0
