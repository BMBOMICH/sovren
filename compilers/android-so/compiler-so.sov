rax_str s:
    at: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    later_fill(at, "str64x0", intern(s))
set_up_call name how_many already_set:
    if how_many = 1
        take_from_stack
        mov_reg(0, 0)
    if not
        if how_many = 2
            pop_reg(1)
            take_from_stack
        if not
            if how_many = 3
                pop_reg(2)
                pop_reg(1)
                take_from_stack
            if not
                if how_many = 4
                    pop_reg(3)
                    pop_reg(2)
                    pop_reg(1)
                    take_from_stack
                if not
                    if how_many = 5
                        pop_reg(4)
                        pop_reg(3)
                        pop_reg(2)
                        pop_reg(1)
                        take_from_stack
                    if not
                        if how_many = 6
                            pop_reg(5)
                            pop_reg(4)
                            pop_reg(3)
                            pop_reg(2)
                            pop_reg(1)
                            take_from_stack
                        if not
                            if how_many = 7
                                pop_reg(6)
                                pop_reg(5)
                                pop_reg(4)
                                pop_reg(3)
                                pop_reg(2)
                                pop_reg(1)
                                take_from_stack
    if same(name, "_sov_alloc") = 1
        used_alloc: 1
    if same(name, "_sov_strlen") = 1
        used_text_length: 1
    if same(name, "_sov_str_eq") = 1
        used_texts_equal: 1
    if same(name, "cfunc") = 1
        # x0 holds the address, x1..x6 the arguments. C wants the
        # arguments in x0..x5, so shift them down and call.
        mov_reg(9, 0)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        emitw(3594453280)
        return
    if same(name, "syscall") = 1
        # arm64 numbers its syscalls differently. the number in x0
        # goes through _sov_sysnum (a plain Sovren job in the
        # runtime) and the answer, in x0 again, becomes x8. The six
        # arguments sit in x1..x6, which the translation job
        # clobbers (they are caller-saved), so they are parked on
        # the stack first and come back after.
        push_reg(6)
        push_reg(5)
        push_reg(4)
        push_reg(3)
        push_reg(2)
        push_reg(1)
        call("_sov_sysnum")
        mov_reg(8, 0)
        pop_reg(1)
        pop_reg(2)
        pop_reg(3)
        pop_reg(4)
        pop_reg(5)
        pop_reg(6)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        ask_kernel
        return
    if same(name, "hlt") = 1
        emitw(3573751935)
        return
    if same(name, "cli") = 1
        emitw(3573760735)
        return
    if same(name, "sti") = 1
        emitw(3573760767)
        return
    if same(name, "peek_raw8") = 1
        ldrb_x0_x0x1
        return
    if same(name, "peek_raw64") = 1
        ldr_x0_x0x1
        return
    if same(name, "poke_raw8") = 1
        strb_x2_x0x1
        return
    if same(name, "poke_raw64") = 1
        str_x2_x0x1
        return
    if same(name, "peek_byte") = 1
        chk_mem(1)
        ldrb_x0_x0x1
        return
    if same(name, "peek_i64") = 1
        chk_mem(8)
        ldr_x0_x0x1
        return
    if same(name, "peek_ptr") = 1
        chk_mem(8)
        ldr_x0_x0x1
        return
    if same(name, "poke_byte") = 1
        chk_mem(1)
        strb_x2_x0x1
        return
    if same(name, "poke_i64") = 1
        chk_mem(8)
        str_x2_x0x1
        return
    if same(name, "stack_pointer") = 1
        # mov x0, sp: orr x0, xzr, sp (the shared runtime's thread
        # entry asks for the stack pointer; dead on machines without
        # threads, valid a64 either way)
        emitw(2854159328)
        return
    call(name)
stmt_so line:
    s: strip(line)
    if length(s) = 0
        return
    if starts(s, "#") = 1
        return
    s: compound(s)
    q: 0
    qi: 0
    as long as qi < length(s)
        if _sov_byte_at(s, qi) = 92
            qi: qi + 1
        if not
            if _sov_byte_at(s, qi) = 34
                q: q + 1
        qi: qi + 1
    if q % 2 is not 0
        print "Error: unterminated text" : s
        print "line" : error_line
        saw_error: 1
        return
    if length(s) > 1000
        print "Error: line too long, split it up"
        print "line" : error_line
        saw_error: 1
        return
    if starts(s, "use ") = 1
        return
    if same(s, "private") = 1
        return
    if starts(s, "wipe ") = 1
        expr(strip(cut(s, 5, length(s))))
        mov_rdi_rax
        test_rax
        wsk: jz()
        wtop: here()
        emitw(960495650)
        emitw(1895825503)
        wend: here()
        emitw(1409286144)
        emitw(956301375)
        emitw(2432697377)
        wb: here()
        emitw(335544320)
        put_arm(wb, wtop - wb)
        put_here(wend)
        patch(wsk)
        return
    if starts(s, "join ") = 1
        # this file carries its own statement dispatcher, so the join
        # arm needs it here too, not only in carm: evaluate the
        # handle, wait for nothing. spawn answers -1 on this machine
        expr(strip(cut(s, 5, length(s))))
        return
    if starts(s, "print ") = 1
        arg: strip(cut(s, 6, length(s)))
        if ends_times(arg) = 1
            head: strip(cut(arg, 0, length(arg) - 6))
            sp: find_last_sp(head)
            if sp > 0 - 1
                do_print_times(strip(cut(head, 0, sp)), strip(cut(head, sp + 1, length(head))))
                return
        if length(arg) > 1
            if _sov_byte_at(arg, 0) = 34
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
        if starts(arg, "peek_byte(") = 1
            if folded_number > 0
                emit_write_lit(i2s(folded_number))
                return
        typ: expr(arg)
        mov_rdi_rax
        if typ = 1
            used_print: 1
            print_text
        if not
            used_print_number: 1
            print_number
        return
    had_col: 0
    col: find_col(s)
    if col > 0
        if col < length(s) - 1
            had_col: 1
            s: join("<-- ", join(strip(cut(s, 0, col)), join(" := ", strip(cut(s, col + 1, length(s))))))
    if starts(s, "<-- ") = 1
        if had_col = 0
            print "Error: bad line" : s
            print "line" : error_line
            saw_error: 1
            return
        rest: cut(s, 4, length(s))
        t: find_sep(rest)
        if t > 0 - 1
            var: repl(strip(cut(rest, 0, t)), " ", "_")
            rhs: strip(cut(rest, t + 4, length(rest)))
            if same(rhs, join(var, " + 1")) = 1
                inc_var(var)
                return
            if same(rhs, join(var, " - 1")) = 1
                dec_var(var)
                return
            pref: join(var, " + ")
            if starts(rhs, pref) = 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) = 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            pref: join(var, " + ")
            if starts(rhs, pref) = 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) = 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            if length(rhs) > 0
                if digit(letter(rhs, 0)) = 1
                    if look(rhs, " ") < 0
                        if inside_if = 0
                            nv: _sov_atoi(rhs)
                            cset(var, nv)
                            if nv > 0
                                known_name: var
                                known_value: nv
                            drop_str(var)
                            if needs_heap = 0
                                return
            if try_alloc_imm(var, rhs) = 1
                mark_str(var)
                return
            typ: expr(rhs)
            storev(var)
            if typ = 1
                mark_str(var)
            if not
                drop_str(var)
            if starts(rhs, "_sov_strlen(") = 1
                if used_fill = 1
                    if known_value > 0
                        known_name: var
        return
    if same(s, "return") = 1
        xor_rax_so
        restore_frame
        ret
        return
    if starts(s, "return ") = 1
        typ: expr(cut(s, 7, length(s)))
        if typ = 1
            saw_letters: 1
        restore_frame
        ret
        return
    if same(s, "stop") = 1
        set_reg(0, 0)
        set_reg(8, sc_exit)
        ask_kernel
        return
    if look(s, "(") < 0
        print "Error: bad line" : s
        print "line" : error_line
        saw_error: 1
        return
    expr(s)
so_body lines:
    n: _sov_list_len(lines)
    i: 0
    bk: _sov_list_new()
    bi: _sov_list_new()
    bj: _sov_list_new()
    bs: _sov_list_new()
    be: _sov_list_new()
    br: _sov_list_new()
    as long as i < n
        raw: _sov_list_get(lines, i)
        s: strip(raw)
        error_line: i + 1
        if _sov_list_len(line_of_stmt) > i
            error_line: _sov_list_get(line_of_stmt, i)
        ind: nind(raw)
        if length(s) = 0
            i: i + 1
        if not
            if starts(s, "#") = 1
                i: i + 1
            if not
                isel: 0
                if same(s, "if not") = 1
                    isel: 1
                if starts(s, "except") = 1
                    isel: 1
                popgo: 1
                as long as popgo = 1
                    if _sov_list_len(bk) = 0
                        popgo: 0
                    if not
                        last: _sov_list_len(bk) - 1
                        if ind > _sov_list_get(bi, last)
                            popgo: 0
                        if not
                            stay: 0
                            if isel = 1
                                if ind = _sov_list_get(bi, last)
                                    if same(_sov_list_get(bk, last), "if") = 1
                                        stay: 1
                                    if same(_sov_list_get(bk, last), "try") = 1
                                        stay: 1
                            if stay = 1
                                popgo: 0
                            if not
                                popblk
                loop_ok: 0
                if starts(s, "as long as ") = 1
                    s: join("while ", strip(cut(s, 11, length(s))))
                    loop_ok: 1
                if starts(s, "if ") = 1
                    if same(s, "if not") = 0
                        if starts(s, "if not ") = 0
                            expr(cut(s, 3, length(s)))
                            test_rax
                            z: jz()
                            bk: _sov_list_add(bk, "if")
                            bi: _sov_list_add(bi, ind)
                            bj: _sov_list_add(bj, z)
                            bs: _sov_list_add(bs, 0)
                            be: _sov_list_add(be, _sov_list_new())
                            br: _sov_list_add(br, 0)
                            inside_if: inside_if + 1
                        if not
                            stmt_so(s)
                    if not
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                if not
                    if same(s, "\x00__removed_and_if_not") = 1
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                    if not
                        if starts(s, "do while ") = 1
                            bln: collect_body(lines, i + 1, ind)
                            if try_opt_while(cut(s, 9, length(s)), bln) = 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                            if not
                                cflush_all
                                st: here()
                                # emit_cmp_jge removed (always -1): general path
                                expr(cut(s, 9, length(s)))
                                test_rax
                                z: jz()
                                bk: _sov_list_add(bk, "while")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, st)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                                inside_if: inside_if + 1
                        if not
                            if loop_ok = 1
                                bln: collect_body(lines, i + 1, ind)
                                if try_opt_while(cut(s, 6, length(s)), bln) = 1
                                    i: skip_body(lines, i + 1, ind)
                                    i: i - 1
                                if not
                                    cflush_all
                                    st: here()
                                    # emit_cmp_jge removed (always -1): general path
                                    expr(cut(s, 6, length(s)))
                                    test_rax
                                    z: jz()
                                    bk: _sov_list_add(bk, "while")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, z)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                          inside_if: inside_if + 1
                              br: _sov_list_add(br, 0)
                            if not
                                if same(s, "do forever") = 1
                                    st: here()
                                    bk: _sov_list_add(bk, "forever")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, 0 - 1)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                    inside_if: inside_if + 1
                                if not
                                    if starts(s, "\x00__removed_repeat ") = 1
                                        cflush_all
                                        tmp: cut(s, 7, length(s))
                                        tp: look(tmp, " times")
                                        if tp > 0 - 1
                                            tmp: cut(tmp, 0, tp)
                                        expr(tmp)
                                        cn: "__rep_c"
                                        inn: "__rep_i"
                                        storev(cn)
                                        xor_rax_so
                                        storev(inn)
                                        rs: idx(local_names, inn)
                                        cs: idx(local_names, cn)
                                        st: here()
                                        load_loc(rs)
                                        push_rax
                                        load_loc(cs)
                                        mov_rcx_rax
                                        take_from_stack
                                        cmp_rax_rcx
                                        setcc("lt")
                                        test_rax
                                        z: jz()
                                        bk: _sov_list_add(bk, "repeat")
                                        bi: _sov_list_add(bi, ind)
                                        bj: _sov_list_add(bj, z)
                                        bs: _sov_list_add(bs, st)
                                        be: _sov_list_add(be, _sov_list_new())
                                        br: _sov_list_add(br, rs)
                                        inside_if: inside_if + 1
                                    if not
                                        if same(s, "try") = 1
                                            cflush_all
                                            if idx(global_names, "err_top") = 0 - 1
                                                global_names: _sov_list_add(global_names, "err_top")
                                            if idx(global_names, "err_val") = 0 - 1
                                                global_names: _sov_list_add(global_names, "err_val")
                                            # the frame: the error top, the frame
                                            # pointer, the stack, and where the handler
                                            # starts
                                            emitw(2432697321)
                                            emitw(4162785257)
                                            load_glob("err_top")
                                            emitw(4162785248)
                                            ta: here()
                                            emitw(268435466)
                                            emitw(4162785258)
                                            emitw(2432697321)
                                            mov_reg(0, 9)
                                            store_glob("err_top")
                                            bk: _sov_list_add(bk, "try")
                                            bi: _sov_list_add(bi, ind)
                                            bj: _sov_list_add(bj, 0)
                                            bs: _sov_list_add(bs, 0)
                                            be: _sov_list_add(be, _sov_list_new())
                                            br: _sov_list_add(br, ta)
                                            inside_if: inside_if + 1
                                        if not
                                            if starts(s, "except") = 1
                                                last: _sov_list_len(bk) - 1
                                                if last > 0 - 1
                                                    if same(_sov_list_get(bk, last), "try") = 1
                                                        ev: strip(cut(s, 6, length(s)))
                                                        # pass 68: a local may not share a global's name -
                                                        # the load/store ladders divert global-named names to
                                                        # the global until the moment a local appears, so the
                                                        # one hole = an except name materialising a local
                                                        # mid-function. refuse loudly.
                                                        if idx(global_names, ev) > 0 - 1
                                                            if idx(local_names, ev) < 0
                                                                print "Error: the except name shadows a global" : ev
                                                                print "line" : error_line
                                                                saw_error: 1
                                                        load_glob("err_top")
                                                        mov_reg(9, 0)
                                                        emitw(4181723424)
                                                        store_glob("err_top")
                                                        emitw(2432746495)
                                                        tb: here()
                                                        emitw(335544320)
                                                        bs: _sov_list_set(bs, last, tb)
                                                        put_here(_sov_list_get(br, last))
                                                        load_glob("err_val")
                                                        store_loc(slot(ev))
                                                        bk: _sov_list_add(bk, "except")
                                                        bi: _sov_list_add(bi, ind)
                                                        bj: _sov_list_add(bj, 0)
                                                        bs: _sov_list_add(bs, 0)
                                                        be: _sov_list_add(be, _sov_list_new())
                                                        br: _sov_list_add(br, 0)
                                                        inside_if: inside_if + 1
                                                    if not
                                                        print "Error: except without try" : s
                                                        print "line" : error_line
                                                        saw_error: 1
                                                if not
                                                    print "Error: except without try" : s
                                                    print "line" : error_line
                                                    saw_error: 1
                                            if not
                                                if starts(s, "raise ") = 1
                                                    expr(cut(s, 6, length(s)))
                                                    if idx(global_names, "err_val") = 0 - 1
                                                        global_names: _sov_list_add(global_names, "err_val")
                                                    if idx(global_names, "err_top") = 0 - 1
                                                        global_names: _sov_list_add(global_names, "err_top")
                                                    store_glob("err_val")
                                                    load_glob("err_top")
                                                    # x10 keeps the frame: store_glob
                                                    # spends x9 reaching its cell, so
                                                    # the frame read must not go through
                                                    # x9 after that. walking +32/+48 of a three-slot
                                                    # frame lands x29 and the
                                                    # nowhere stack on top of each
                                                    # other. reads: old top at +16,
                                                    # caller sp at +32, handler at +0,
                                                    # branch by x10, which ldr keeps.
                                                    mov_reg(10, 0)
                                                    emitw(4043309407)
                                                    zz: here()
                                                    emitw(1409286144)
                                                    emitw(4181723456)
                                                    store_glob("err_top")
                                                    emitw(4181725515)
                                                    emitw(2432696703)
                                                    emitw(4181721418)
                                                    emitw(3592356160)
                                                    put_here(zz)
                                                    load_glob("err_val")
                                                    used_print_number: 1
                                                    print_number
                                                    set_reg(0, 1)
                                                    set_reg(8, sc_exit)
                                                    ask_kernel
                                                if not
                                                    stmt_so(s)
                i: i + 1
    as long as _sov_list_len(bk) > 0
        popblk
prep_main_so names params bodies:
    tiny_program: 0
    dead_alloc_name: blank
    fi: 0
    as long as fi < _sov_list_len(names)
        if same(_sov_list_get(names, fi), "main") = 1
            if _sov_list_len(_sov_list_get(params, fi)) = 0
                tiny_program: 1
            dead_alloc_name: drop_unused(_sov_list_get(bodies, fi))
        fi: fi + 1
so_compile source:
    code: _sov_list_new()
    bump_ptr: blank
    bump_end: blank
    known_name: blank
    known_value: 0
    dead_alloc_name: blank
    used_alloc: 0
    used_text_length: 0
    used_texts_equal: 0
    used_print: 0
    used_print_number: 0
    used_crash: 0
    used_fill: 0
    tiny_program: 0
    needs_heap: 0
    needs_private: 0
    saw_letters: 0
    letter_boxes: _sov_list_new()
    letter_tasks: _sov_list_new()
    array_names: _sov_list_new()
    array_count: _sov_list_new()
    letter_tasks: _sov_list_add(letter_tasks, "cat")
    letter_tasks: _sov_list_add(letter_tasks, "strcat")
    letter_tasks: _sov_list_add(letter_tasks, "_sov_strcat")
    letter_tasks: _sov_list_add(letter_tasks, "sub")
    letter_tasks: _sov_list_add(letter_tasks, "trim")
    letter_tasks: _sov_list_add(letter_tasks, "ch")
    letter_tasks: _sov_list_add(letter_tasks, "_sov_substring")
    letter_tasks: _sov_list_add(letter_tasks, "str_cat")
    letter_tasks: _sov_list_add(letter_tasks, "str_cut")
    letter_tasks: _sov_list_add(letter_tasks, "str_trim")
    letter_tasks: _sov_list_add(letter_tasks, "str_join3")
    letter_tasks: _sov_list_add(letter_tasks, "join")
    letter_tasks: _sov_list_add(letter_tasks, "strip")
