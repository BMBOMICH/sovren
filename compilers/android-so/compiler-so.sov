use carm
do_wait_for_thread:
    wait_for_thread
    return 0

# the .so image = fixed-base (no slide walk): the walk call
# sites are pie_walk-gated and never fire, but the task
# reference must exist - a no-op, the same way ios defines its own
emit_walk:
    return
fold_fib_name: 0
used_guard: 0
skip_fib: 0
frame_holes: 0
frame_open: 0
code: 0
letters: 0
letter_keys: 0
letters_at: 0
