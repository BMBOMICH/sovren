use carm
oc: 0
strb: 0
str_keys: 0
str_pos: 0
fn_names: 0
fn_offs: 0
glob_names: 0
patch_at: 0
patch_kind: 0
can_used: 0
patch_val: 0
patch_line: 0
locals: 0
src_base: 0
had_err: 0
ex_depth: 0
br_depth: 0
bare_mode: 0
fib_nm: blank
fib_drop: 0
fn_locs: 0
stmt_lns: 0
body_lns: 0
task_lns: 0
task_user: 0
names: 0
BASE: 4194304
# HDR was the old flat base; the macho uses hdr (216). kept dead
# so the git blame of this fix stays obvious
opt_imm: 0
opt_src: 0
iota_ptr: 0
iota_lim: 0
mmap_sz: 1073741824
used_libs: blank
err_line: 0
kn: blank
kv: 0
pro_at: 0
fw_on: 0
fw_done: 0
fw_pos: 0
skip_al: blank
used_al: 0
self_dir: 0
used_sl: 0
used_eq: 0
used_pr: 0
used_pi: 0
did_stos: 0
thin_main: 0
has_vm: 0
need_priv: 0
used_tr: 0
cnms: 0
cvls: 0
cemt: 0
str_vars: 0
str_fns: 0
ar_names: 0
ar_cnt: 0
saw_str: 0
rax_str s:
    at: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    addp(at, "str64x0", intern(s))
call_args name argc:
    if argc is 1
        pop_rax()
        mov_reg(0, 0)
    if not
        if argc is 2
            pop_reg(1)
            pop_rax()
        if not
            if argc is 3
                pop_reg(2)
                pop_reg(1)
                pop_rax()
            if not
                if argc is 4
                    pop_reg(3)
                    pop_reg(2)
                    pop_reg(1)
                    pop_rax()
                if not
                    if argc is 5
                        pop_reg(4)
                        pop_reg(3)
                        pop_reg(2)
                        pop_reg(1)
                        pop_rax()
                    if not
                        if argc is 6
                            pop_reg(5)
                            pop_reg(4)
                            pop_reg(3)
                            pop_reg(2)
                            pop_reg(1)
                            pop_rax()
                        if not
                            if argc is 7
                                pop_reg(6)
                                pop_reg(5)
                                pop_reg(4)
                                pop_reg(3)
                                pop_reg(2)
                                pop_reg(1)
                                pop_rax()
    if same(name, "_sov_alloc") is 1
        used_al: 1
    if same(name, "_sov_strlen") is 1
        used_sl: 1
    if same(name, "_sov_str_eq") is 1
        used_eq: 1
    if same(name, "cfunc") is 1
        # x0 holds the address, x1..x6 the arguments. C wants the
        # arguments in x0..x5, so shift them down and call.
        mov_reg(9, 0)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        emitw(3594453280)
        return
    if same(name, "syscall") is 1
        mov_reg(8, 0)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        sysc()
        return
    if same(name, "hlt") is 1
        emitw(3573751935)
        return
    if same(name, "cli") is 1
        emitw(3573760735)
        return
    if same(name, "sti") is 1
        emitw(3573760767)
        return
    if same(name, "peek_raw8") is 1
        ldrb_x0_x0x1()
        return
    if same(name, "peek_raw64") is 1
        ldr_x0_x0x1()
        return
    if same(name, "poke_raw8") is 1
        strb_x2_x0x1()
        return
    if same(name, "poke_raw64") is 1
        str_x2_x0x1()
        return
    if same(name, "peek_byte") is 1
        chk_mem(1)
        ldrb_x0_x0x1()
        return
    if same(name, "peek_i64") is 1
        chk_mem(8)
        ldr_x0_x0x1()
        return
    if same(name, "peek_ptr") is 1
        chk_mem(8)
        ldr_x0_x0x1()
        return
    if same(name, "poke_byte") is 1
        chk_mem(1)
        strb_x2_x0x1()
        return
    if same(name, "poke_i64") is 1
        chk_mem(8)
        str_x2_x0x1()
        return
    calln(name)
write_elf path:
    if had_err is 1
        return
    clen: _sov_list_len(oc)
    sl: _sov_buf_len(strb)
    str_off: clen
    if _sov_list_len(glob_names) > 0
        as long as str_off % 8 is not 0
            oc: _sov_list_add(oc, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(glob_names) * 8
    hdr: 216
    # pass S3: __TEXT holds headers + code, READ+EXECUTE only.
    # __DATA starts on the page after the code, READ+WRITE, never
    # executable: literals first (they are data - a user wipe
    # writes them at any moment), then globals. the reserved-dword
    # rider is gone with them.
    dfoff: hdr + clen
    as long as dfoff % 4096 is not 0
        dfoff: dfoff + 1
    sl8: sl
    as long as sl8 % 8 is not 0
        sl8: sl8 + 1
    str_off: dfoff - hdr
    glob_off: dfoff + sl8 - hdr
    pad: _sov_list_len(glob_names) * 8
    # pass S7: count the movz/movk runs that carry absolutes; the
    # loader adds the slide to their immediates - the windows model
    rel_n: 0
    rel_at: _sov_list_new()
    rel_nw: _sov_list_new()
    rc_i: 0
    as long as rc_i < _sov_list_len(patch_at)
        rk: _sov_list_get(patch_kind, rc_i)
        if same(rk, "gw64s_a") is 1
            rel_n: rel_n + 1
        if same(rk, "gw64a") is 1
            rel_n: rel_n + 1
        if same(rk, "glob64") is 1
            rel_n: rel_n + 1
        if same(rk, "fnaddr64") is 1
            rel_n: rel_n + 1
        if same(rk, "str64") is 1
            rel_n: rel_n + 1
        if same(rk, "str64x0") is 1
            rel_n: rel_n + 1
        if same(rk, "str") is 1
            rel_n: rel_n + 1
        if same(rk, "str32") is 1
            rel_n: rel_n + 1
        if same(rk, "glob") is 1
            rel_n: rel_n + 1
        rc_i: rc_i + 1
    relsz: 8 + rel_n * 8
    dlen: sl8 + pad + relsz
    codelim: dfoff + dlen
    as long as codelim % 16 is not 0
        codelim: codelim + 1
    npages: codelim / 4096
    if codelim % 4096 is not 0
        npages: npages + 1
    cd_len: 56 + npages * 32
    sig_len: 12 + 8 + cd_len
    filesz: codelim + sig_len
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    poke4(flat, 0, 4277009103)
    poke4(flat, 4, 16777228)
    poke4(flat, 8, 0)
    poke4(flat, 12, 2)
    # no __PAGEZERO (NULL-page hardening only; unmapped memory faults
    # the same way), so a single __TEXT + LC_MAIN + codesig is enough
    poke4(flat, 16, 4)
    # pass S7: the mach header's reserved word counts the table
    poke4(flat, 28, rel_n)
    poke4(flat, 20, 184)
    poke4(flat, 24, 2097153)
    poke4(flat, 32, 25)
    poke4(flat, 36, 72)
    dummy: _sov_set_byte(flat, 40, 95)
    dummy: _sov_set_byte(flat, 41, 95)
    dummy: _sov_set_byte(flat, 42, 84)
    dummy: _sov_set_byte(flat, 43, 69)
    dummy: _sov_set_byte(flat, 44, 88)
    dummy: _sov_set_byte(flat, 45, 84)
    # __TEXT: headers + code, READ+EXECUTE, never writable
    poke8(flat, 56, 4294967296)
    poke8(flat, 64, dfoff)
    poke8(flat, 80, hdr + clen)
    poke4(flat, 88, 5)
    poke4(flat, 92, 5)
    # __DATA: literals + globals + the arena's blank tail,
    # READ+WRITE, never executable
    poke4(flat, 104, 25)
    poke4(flat, 108, 72)
    dummy: _sov_set_byte(flat, 112, 95)
    dummy: _sov_set_byte(flat, 113, 95)
    dummy: _sov_set_byte(flat, 114, 68)
    dummy: _sov_set_byte(flat, 115, 65)
    dummy: _sov_set_byte(flat, 116, 84)
    dummy: _sov_set_byte(flat, 117, 65)
    poke8(flat, 128, 4294967296 + dfoff)
    poke8(flat, 136, dlen + 65536)
    poke8(flat, 144, dfoff)
    poke8(flat, 152, dlen)
    poke4(flat, 160, 3)
    poke4(flat, 164, 3)
    poke4(flat, 176, 2147483688)
    poke4(flat, 180, 24)
    poke8(flat, 184, hdr)
    poke4(flat, 192, 29)
    poke4(flat, 196, 16)
    poke4(flat, 200, codelim)
    poke4(flat, 204, sig_len)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, hdr + i, _sov_list_get(oc, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, hdr + str_off + si, _sov_buf_at(strb, si))
        si: si + 1
    str_addr: 4294967296 + hdr + str_off
    glob_addr: 4294967296 + hdr + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_val, i)
        if same(kind, "rel26") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: (tgt - at) / 4
                if rel < 0
                    rel: rel + 67108864
                poke4(flat, hdr + at, 2483027968 + (rel % 67108864))
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "b26") is 1
            poke4(flat, hdr + at, 335544320 + (val % 67108864))
        if same(kind, "gw64s_a") is 1
            gsa2: str_addr
            poke4(flat, hdr + at, 3531603968 + (gsa2 % 65536) * 32)
            poke4(flat, hdr + at + 4, 4070572032 + ((gsa2 / 65536) % 65536) * 32)
            poke4(flat, hdr + at + 8, 4072669184 + ((gsa2 / 4294967296) % 65536) * 32)
            poke4(flat, hdr + at + 12, 4074766336 + ((gsa2 / 281474976710656) % 65536) * 32)
        if same(kind, "gw64s_n") is 1
            gsc: (sl + 7) / 8
            poke4(flat, hdr + at, 3531603969 + gsc * 32)
        if same(kind, "gw64a") is 1
            gwa2: glob_addr
            poke4(flat, hdr + at, 3531603968 + (gwa2 % 65536) * 32)
            poke4(flat, hdr + at + 4, 4070572032 + ((gwa2 / 65536) % 65536) * 32)
            poke4(flat, hdr + at + 8, 4072669184 + ((gwa2 / 4294967296) % 65536) * 32)
            poke4(flat, hdr + at + 12, 4074766336 + ((gwa2 / 281474976710656) % 65536) * 32)
        if same(kind, "gw64n") is 1
            poke4(flat, hdr + at, 3531603969 + _sov_list_len(glob_names) * 32)
        if same(kind, "glob64") is 1
            gx: idx(glob_names, val)
            ga: glob_addr + gx * 8
            poke4(flat, hdr + at, 3531603968 + (ga % 65536) * 32 + 9)
            poke4(flat, hdr + at + 4, 4070572032 + ((ga / 65536) % 65536) * 32 + 9)
            poke4(flat, hdr + at + 8, 4072669184 + ((ga / 4294967296) % 65536) * 32 + 9)
        if same(kind, "fnaddr64") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                fa: 4294967296 + hdr + _sov_list_get(fn_offs, fi)
                poke4(flat, hdr + at, 3531603968 + (fa % 65536) * 32)
                poke4(flat, hdr + at + 4, 4070572032 + ((fa / 65536) % 65536) * 32)
                poke4(flat, hdr + at + 8, 4072669184 + ((fa / 4294967296) % 65536) * 32)
                poke4(flat, hdr + at + 12, 4074766336 + ((fa / 281474976710656) % 65536) * 32)
            if not
                print "Error: no such task"
                _sov_print(val)
                had_err: 1
        if same(kind, "str64x0") is 1
            sa: str_addr + val
            poke4(flat, hdr + at, 3531603968 + (sa % 65536) * 32)
            poke4(flat, hdr + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32)
            poke4(flat, hdr + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32)
        if same(kind, "str64") is 1
            sa: str_addr + val
            poke4(flat, hdr + at, 3531603968 + (sa % 65536) * 32 + 1)
            poke4(flat, hdr + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32 + 1)
            poke4(flat, hdr + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32 + 1)
        if same(kind, "adr") is 1
            sa: str_addr + val
            rel: sa - (4294967296 + hdr + at)
            if rel < 0
                rel: rel + 2097152
            poke4(flat, hdr + at, 268435456 + (rel % 4) * 536870912 + ((rel / 4) % 524288) * 32 + 1)
        if same(kind, "cbz_trap") is 1
            ti: idx(fn_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(fn_offs, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, hdr + at, 3019898880 + (rl % 524288) * 32 + val)
        if same(kind, "b19_trap") is 1
            ti: idx(fn_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(fn_offs, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, hdr + at, 1409286144 + (rl % 524288) * 32 + 2)
        if same(kind, "rel") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: tgt - (at + 4)
                poke4(flat, hdr + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "str") is 1
            poke8(flat, hdr + at, str_addr + val)
        if same(kind, "str32") is 1
            poke4(flat, hdr + at, str_addr + val)
        if same(kind, "ripstr") is 1
            poke4(flat, hdr + at, str_off + val - at - 4)
        if same(kind, "glob") is 1
            gx: idx(glob_names, val)
            poke8(flat, hdr + at, glob_addr + gx * 8)
        if same(kind, "gw64s_a") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "gw64a") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "glob64") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 3)
        if same(kind, "fnaddr64") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "str64") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 2)
        if same(kind, "str64x0") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 2)
        if same(kind, "str") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 80)
        if same(kind, "str32") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 40)
        if same(kind, "glob") is 1
            rel_at: _sov_list_add(rel_at, at)
            rel_nw: _sov_list_add(rel_nw, 80)
        i: i + 1
    if had_err is 1
        return
    # pass S7: the relocation table rides the __DATA tail, inside
    # the signed span: a count, then (offset, kind) pairs, same
    # shape as the android one
    poke8(flat, dfoff + sl8 + pad, rel_n)
    ri: 0
    as long as ri < rel_n
        poke4(flat, dfoff + sl8 + pad + 8 + ri * 8, hdr + _sov_list_get(rel_at, ri))
        poke4(flat, dfoff + sl8 + pad + 12 + ri * 8, _sov_list_get(rel_nw, ri))
        ri: ri + 1
    sig: codelim
    poke4be(flat, sig, 4208856256)
    poke4be(flat, sig + 4, sig_len)
    poke4be(flat, sig + 8, 1)
    poke4be(flat, sig + 12, 0)
    poke4be(flat, sig + 16, 20)
    cd: sig + 20
    poke4be(flat, cd, 4208856066)
    poke4be(flat, cd + 4, cd_len)
    poke4be(flat, cd + 8, 132096)
    poke4be(flat, cd + 12, 2)
    poke4be(flat, cd + 16, 56)
    poke4be(flat, cd + 20, 44)
    poke4be(flat, cd + 24, 0)
    poke4be(flat, cd + 28, npages)
    poke4be(flat, cd + 32, codelim)
    dummy: _sov_set_byte(flat, cd + 36, 32)
    dummy: _sov_set_byte(flat, cd + 37, 2)
    dummy: _sov_set_byte(flat, cd + 38, 0)
    dummy: _sov_set_byte(flat, cd + 39, 12)
    poke4be(flat, cd + 40, 0)
    so_name("sovren", flat, cd + 44)
    pg: 0
    as long as pg < npages
        plen: 4096
        if (pg * 4096) + 4096 > codelim
            plen: codelim - (pg * 4096)
        ph: _sov_alloc(64)
        sha256_bytes(flat + pg * 4096, plen, ph)
        hj: 0
        as long as hj < 8
            hv: peek_i64(ph, hj * 8)
            poke4be(flat, cd + 56 + pg * 32 + hj * 4, hv)
            hj: hj + 1
        pg: pg + 1
    w: _sov_write_n(path, flat, filesz)
    if w is 0
        print "Error: cannot write output (is it running?)"
        fail()
    if need_priv is 1
        # pass 140: a private program's binary carries its secrets -
        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
poke4be p at v:
    x: v
    if x < 0
        x: x + 4294967296
    dummy: _sov_set_byte(p, at, (x / 16777216) % 256)
    dummy: _sov_set_byte(p, at + 1, (x / 65536) % 256)
    dummy: _sov_set_byte(p, at + 2, (x / 256) % 256)
    dummy: _sov_set_byte(p, at + 3, x % 256)
    return 0

so_name s flat at:
    i: 0
    as long as i < length(s)
        dummy: _sov_set_byte(flat, at + i, _sov_byte_at(s, i))
        i: i + 1
    dummy: _sov_set_byte(flat, at + i, 0)
    return 0
main argc argv:
    # remember where this compiler lives, so its library and runtime
    # are found no matter which folder you run it from
    self_dir: dirname(tidy_path(peek_ptr(argv, 0)))
    if argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail()
    inf: blank
    outf: blank
    i: 1
    as long as i < argc
        arg: peek_ptr(argv, i)
        if same(arg, "--bare") is 1
            bare_mode: 1
        if not
            if same(arg, "-o") is 1
                i: i + 1
                if i < argc
                    outf: peek_ptr(argv, i)
            if not
                if same(arg, "build") is 0
                    inf: arg
        i: i + 1
    if length(inf) is 0
        print "Error: no input"
        fail()
    if length(outf) is 0
        d: look(inf, ".sov")
        if d > 0 - 1
            outf: cut(inf, 0, d)
        if not
            outf: join(inf, ".out")
    print "Compiling"
    _sov_print(inf)
    src: load_file(inf)
    if src is 0
        print "Error: cannot read input"
        fail()
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    src: join(join("# pad line so main is not first", nl), src)
    used_libs: blank
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    need: 0
    mmap_sz: 12582912
    if look(src, "_sov_list") > 0 - 1
        need: 1
    if look(src, "load_file") > 0 - 1
        need: 1
    if look(src, "_sov_buf") > 0 - 1
        need: 1
    if look(src, "_sov_alloc") > 0 - 1
        need: 1
    if look(src, "_sov_set_byte") > 0 - 1
        need: 1
    if look(src, "peek_byte") > 0 - 1
        need: 1
    if look(src, "poke_byte") > 0 - 1
        need: 1
    rt: blank
    if bare_mode is 1
        need: 0
    if need is 1
        mmap_sz: 1073741824
        rt: load_file("runtime.sov")
        if rt is 0
            rt: load_file("linux/runtime.sov")
        if rt is 0
            rt: load_file(join(self_dir, "/runtime.sov"))
        if rt is 0
            rt: load_file(join(self_dir, "/../runtime.sov"))
        if rt is 0
            print "Error: cannot read runtime"
            fail()
    src_base: 1
    if length(rt) > 0
        src_base: src_base + _sov_list_len(lines_of(rt))
    if length(extra) > 0
        src_base: src_base + _sov_list_len(lines_of(extra))
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    all: join(rt, nl)
    src_base: src_base + 1
    all: join(all, src)
    compile(all)
    write_elf(outf)
    if had_err is 1
        fail()
    print "Wrote"
    _sov_print(outf)
emit_write_lit s:
    n: length(s)
    set_reg(0, 1)
    off: intern_nz(s)
    at: here()
    emitw(268435457)
    addp(at, "adr", off)
    set_reg(2, n)
    set_reg(8, 64)
    sysc()

# mmap(0, sz, RW, PRIVATE|ANON, -1, 0) -> x0
emit_print:
    fn_names: _sov_list_add(fn_names, "_sov_print")
    fn_offs: _sov_list_add(fn_offs, here())
    # a value under 65536 is not a real address. reading from it
    # would crash, so hand it to the number printer instead.
    emitw(4047519775)
    hi: here()
    emitw(1409286146)
    used_pi: 1
    calln("_sov_print_int")
    ret()
    put_arm(hi, here() - hi)
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    mov_reg(19, 0)
    mov_reg(9, 19)
    set_reg(20, 0)
    top: here()
    emitw(2333344042)
    emitw(960495947)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432698004)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ex)
    set_reg(0, 1)
    mov_reg(1, 19)
    mov_reg(2, 20)
    set_reg(8, 64)
    sysc()
    set_reg(0, 1)
    nl_at: here()
    emitw(268435457)
    addp(nl_at, "adr", intern_nz("\n"))
    set_reg(2, 1)
    set_reg(8, 64)
    sysc()
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)
    ret()

# x0 = number, writes it in decimal then a newline
put_sub_sp at n:
    v: n
    if v < 0
        v: 0
    oc_set_word(at, 3506439167 + (v % 4096) * 1024)
    return 0

# bit32.sov — 32-bit word helpers (pure Sovren)

M32: 4294967296

# sha256.sov — real SHA-256 in pure Sovren

sha_ch x y z:
    return wxor(wand(x, y), wand(wnot(x), z))

sha_maj x y z:
    return wxor(wxor(wand(x, y), wand(x, z)), wand(y, z))

sha_bs0 x:
    return wxor(wxor(rotr(x, 2), rotr(x, 13)), rotr(x, 22))

sha_bs1 x:
    return wxor(wxor(rotr(x, 6), rotr(x, 11)), rotr(x, 25))

sha_ss0 x:
    return wxor(wxor(rotr(x, 7), rotr(x, 18)), shr(x, 3))

sha_ss1 x:
    return wxor(wxor(rotr(x, 17), rotr(x, 19)), shr(x, 10))

sha_k i:
    if i is 0
