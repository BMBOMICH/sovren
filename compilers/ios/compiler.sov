sha256_bytes data n out:
    tot: n + 9
    as long as tot % 64 is not 0
        tot: tot + 1
    buf: _sov_alloc(tot + 8)
    i: 0
    as long as i < n
        poke_byte(buf, i, peek_byte(data, i))
        i: i + 1
    poke_byte(buf, n, 128)
    i: n + 1
    as long as i < tot
        poke_byte(buf, i, 0)
        i: i + 1
    bits: n * 8
    poke_byte(buf, tot - 1, bits % 256)
    poke_byte(buf, tot - 2, (bits / 256) % 256)
    poke_byte(buf, tot - 3, (bits / 65536) % 256)
    poke_byte(buf, tot - 4, (bits / 16777216) % 256)
    h0: 1779033703
    h1: 3144134277
    h2: 1013904242
    h3: 2773480762
    h4: 1359893119
    h5: 2600822924
    h6: 528734635
    h7: 1541459225
    w: _sov_alloc(64 * 8)
    blk: 0
    as long as blk < tot
        t: 0
        as long as t < 16
            b0: peek_byte(buf, blk + t * 4)
            b1: peek_byte(buf, blk + t * 4 + 1)
            b2: peek_byte(buf, blk + t * 4 + 2)
            b3: peek_byte(buf, blk + t * 4 + 3)
            poke_i64(w, t * 8, b0 * 16777216 + b1 * 65536 + b2 * 256 + b3)
            t: t + 1
        t: 16
        as long as t < 64
            v1: sha_ss1(peek_i64(w, (t - 2) * 8))
            v2: peek_i64(w, (t - 7) * 8)
            v3: sha_ss0(peek_i64(w, (t - 15) * 8))
            v4: peek_i64(w, (t - 16) * 8)
            poke_i64(w, t * 8, wadd(wadd(v1, v2), wadd(v3, v4)))
            t: t + 1
        a: h0
        b: h1
        c: h2
        d: h3
        e: h4
        f: h5
        g: h6
        hh: h7
        t: 0
        as long as t < 64
            t1: wadd(wadd(wadd(hh, sha_bs1(e)), wadd(sha_ch(e, f, g), sha_k(t))), peek_i64(w, t * 8))
            t2: wadd(sha_bs0(a), sha_maj(a, b, c))
            hh: g
            g: f
            f: e
            e: wadd(d, t1)
            d: c
            c: b
            b: a
            a: wadd(t1, t2)
            t: t + 1
        h0: wadd(h0, a)
        h1: wadd(h1, b)
        h2: wadd(h2, c)
        h3: wadd(h3, d)
        h4: wadd(h4, e)
        h5: wadd(h5, f)
        h6: wadd(h6, g)
        h7: wadd(h7, hh)
        blk: blk + 64
    poke_i64(out, 0, h0)
    poke_i64(out, 8, h1)
    poke_i64(out, 16, h2)
    poke_i64(out, 24, h3)
    poke_i64(out, 32, h4)
    poke_i64(out, 40, h5)
    poke_i64(out, 48, h6)
    poke_i64(out, 56, h7)
    return 0
