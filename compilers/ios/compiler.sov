use carm
do_wait_for_thread:
    wait_for_thread
    return 0

# the XNU arm64 table (Apple), from XNU bsd syscalls for arm64:
# exit 1, write 4, mmap 197 with MAP_ANON 0x1000 | MAP_PRIVATE 2 =
# 4098, mincore 78, getentropy 500. Apple has no prctl and no
# rt_sigaction - both are switched off (the canary still works,
# it exits directly; crashes just die the default way).
sc_write: 4
sc_exit: 1
sc_mmap: 197
mmap_flags: 4098
sc_mincore: 78
sc_rand: 500
sc_nodump: 0
sc_sigact: 0
code: 0
letters: 0
letter_keys: 0
letters_at: 0
task_names: 0
at_top: 0
task_at: 0
global_names: 0
patch_at: 0
patch_kind: 0
used_guard: 0
patch_value: 0
patch_line: 0
local_names: 0
first_user_line: 0
saw_error: 0
try_depth: 0
inside_if: 0
no_runtime: 0
fold_fib_name: blank
skip_fib: 0
fn_locs: 0
line_of_stmt: 0
line_of_body: 0
line_of_task: 0
user_tasks: 0
names: 0
load_at: 4194304

# the shared a64 core calls emit_walk() inside its compile flow; each
# os file defines its own. ios = fixed-base, so this = the no-op:
# the pie_walk gate (0 here) keeps it from ever running.

emit_walk:
    return 0
# header_size was the old flat base; the macho uses hdr (216). kept dead
# so the git blame of this fix stays obvious
folded_number: 0
folded_from: 0
bump_ptr: 0
bump_end: 0
heap_size: 1073741824
libraries: blank
error_line: 0
file_name: blank
known_name: blank
known_value: 0
frame_at: 0
frame_open: 0
frame_done: 0
frame_holes: 0
dead_alloc_name: blank
used_alloc: 0
compiler_folder: 0
used_text_length: 0
used_texts_equal: 0
used_print: 0
used_print_number: 0
used_fill: 0
tiny_program: 0
# this target does not carry the self-relocating walk
pie_walk: 0
needs_heap: 0
needs_private: 0
used_crash: 0
const_names: 0
const_values: 0
const_dirty: 0
letter_boxes: 0
letter_tasks: 0
array_names: 0
array_count: 0
saw_letters: 0
rax_str s:
    at: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    later_fill(at, "str64x0", intern(s))
set_up_call name how_many already_set:
    if how_many = 1
        take_from_stack
        mov_reg(0, 0)
    if not
        if how_many = 2
            pop_reg(1)
            take_from_stack
        if not
            if how_many = 3
                pop_reg(2)
                pop_reg(1)
                take_from_stack
            if not
                if how_many = 4
                    pop_reg(3)
                    pop_reg(2)
                    pop_reg(1)
                    take_from_stack
                if not
                    if how_many = 5
                        pop_reg(4)
                        pop_reg(3)
                        pop_reg(2)
                        pop_reg(1)
                        take_from_stack
                    if not
                        if how_many = 6
                            pop_reg(5)
                            pop_reg(4)
                            pop_reg(3)
                            pop_reg(2)
                            pop_reg(1)
                            take_from_stack
                        if not
                            if how_many = 7
                                pop_reg(6)
                                pop_reg(5)
                                pop_reg(4)
                                pop_reg(3)
                                pop_reg(2)
                                pop_reg(1)
                                take_from_stack
    if same(name, "_sov_alloc") = 1
        used_alloc: 1
    if same(name, "_sov_strlen") = 1
        used_text_length: 1
    if same(name, "_sov_str_eq") = 1
        used_texts_equal: 1
    if same(name, "cfunc") = 1
        # x0 holds the address, x1..x6 the arguments. C wants the
        # arguments in x0..x5, so shift them down and call.
        mov_reg(9, 0)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        emitw(3594453280)
        return
    if same(name, "syscall") = 1
        # the number in x0 goes through _sov_sysnum and comes back
        # in x0 as the XNU number, which becomes x8. The six
        # arguments sit in x1..x6, which the translation clobbers,
        # so they are parked on the stack first and come back after.
        push_reg(6)
        push_reg(5)
        push_reg(4)
        push_reg(3)
        push_reg(2)
        push_reg(1)
        call("_sov_sysnum")
        mov_reg(8, 0)
        pop_reg(1)
        pop_reg(2)
        pop_reg(3)
        pop_reg(4)
        pop_reg(5)
        pop_reg(6)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        ask_kernel
        return
    if same(name, "hlt") = 1
        emitw(3573751935)
        return
    if same(name, "cli") = 1
        emitw(3573760735)
        return
    if same(name, "sti") = 1
        emitw(3573760767)
        return
    if same(name, "peek_raw8") = 1
        ldrb_x0_x0x1
        return
    if same(name, "peek_raw64") = 1
        ldr_x0_x0x1
        return
    if same(name, "poke_raw8") = 1
        strb_x2_x0x1
        return
    if same(name, "poke_raw64") = 1
        str_x2_x0x1
        return
    if same(name, "peek_byte") = 1
        chk_mem(1)
        ldrb_x0_x0x1
        return
    if same(name, "peek_i64") = 1
        chk_mem(8)
        ldr_x0_x0x1
        return
    if same(name, "peek_ptr") = 1
        chk_mem(8)
        ldr_x0_x0x1
        return
    if same(name, "poke_byte") = 1
        chk_mem(1)
        strb_x2_x0x1
        return
    if same(name, "poke_i64") = 1
        chk_mem(8)
        str_x2_x0x1
        return
    if same(name, "stack_pointer") = 1
        # mov x0, sp: orr x0, xzr, sp (the shared runtime's thread
        # entry asks for the stack pointer; dead on machines without
        # threads, valid a64 either way)
        emitw(2854159328)
        return
    call(name)
write_program path:
    if saw_error = 1
        return
    clen: _sov_list_len(code)
    sl: _sov_buf_len(letters)
    str_off: clen
    if _sov_list_len(global_names) > 0
        as long as str_off % 8 is not 0
            code: _sov_list_add(code, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(global_names) * 8
    hdr: 216
    # pass S3: __TEXT holds headers + code, READ+EXECUTE only.
    # __DATA starts on the page after the code, READ+WRITE, never
    # executable: literals first (they are data - a user wipe
    # writes them at any moment), then globals. the reserved-dword
    # rider = gone with them.
    dfoff: hdr + clen
    as long as dfoff % 4096 is not 0
        dfoff: dfoff + 1
    sl8: sl
    as long as sl8 % 8 is not 0
        sl8: sl8 + 1
    str_off: dfoff - hdr
    glob_off: dfoff + sl8 - hdr
    pad: _sov_list_len(global_names) * 8
    # pass S7: count the movz/movk runs that carry absolutes; the
    # loader adds the slide to their immediates - the windows model
    rel_n: 0
    reloc_at: _sov_list_new()
    rel_nw: _sov_list_new()
    rc_i: 0
    as long as rc_i < _sov_list_len(patch_at)
        rk: _sov_list_get(patch_kind, rc_i)
        if same(rk, "gw64s_a") = 1
            rel_n: rel_n + 1
        if same(rk, "gw64a") = 1
            rel_n: rel_n + 1
        if same(rk, "glob64") = 1
            rel_n: rel_n + 1
        if same(rk, "task_address64") = 1
            rel_n: rel_n + 1
        if same(rk, "str64") = 1
            rel_n: rel_n + 1
        if same(rk, "str64x0") = 1
            rel_n: rel_n + 1
        if same(rk, "str") = 1
            rel_n: rel_n + 1
        if same(rk, "str32") = 1
            rel_n: rel_n + 1
        if same(rk, "glob") = 1
            rel_n: rel_n + 1
        rc_i: rc_i + 1
    # S7 reopened (CI run #2): dyld kills unsigned MH_PIE builds.
    # fixed-address image until PIE = re-landed
    rel_n: 0
    relsz: rel_n * 8
    dlen: sl8 + pad + relsz
    codelim: dfoff + dlen
    as long as codelim % 16 is not 0
        codelim: codelim + 1
    npages: codelim / 4096
    if codelim % 4096 is not 0
        npages: npages + 1
    cd_len: 56 + npages * 32
    sig_len: 12 + 8 + cd_len
    filesz: codelim + sig_len
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    poke4(flat, 0, 4277009103)
    poke4(flat, 4, 16777228)
    poke4(flat, 8, 0)
    poke4(flat, 12, 2)
    # no __PAGEZERO (NULL-page hardening only; unmapped memory faults
    # the same way), so a single __TEXT + LC_MAIN + codesig = enough
    poke4(flat, 16, 4)
    poke4(flat, 20, 184)
    # S7 reopened: fixed-address build, no MH_PIE
    poke4(flat, 24, 1)
    poke4(flat, 32, 25)
    poke4(flat, 36, 72)
    dummy: _sov_set_byte(flat, 40, 95)
    dummy: _sov_set_byte(flat, 41, 95)
    dummy: _sov_set_byte(flat, 42, 84)
    dummy: _sov_set_byte(flat, 43, 69)
    dummy: _sov_set_byte(flat, 44, 88)
    dummy: _sov_set_byte(flat, 45, 84)
    # __TEXT: headers + code, READ+EXECUTE, never writable
    poke8(flat, 56, 4294967296)
    poke8(flat, 64, dfoff)
    poke8(flat, 80, hdr + clen)
    poke4(flat, 88, 5)
    poke4(flat, 92, 5)
    # __DATA: literals + globals + the arena's blank tail,
    # READ+WRITE, never executable
    poke4(flat, 104, 25)
    poke4(flat, 108, 72)
    dummy: _sov_set_byte(flat, 112, 95)
    dummy: _sov_set_byte(flat, 113, 95)
    dummy: _sov_set_byte(flat, 114, 68)
    dummy: _sov_set_byte(flat, 115, 65)
    dummy: _sov_set_byte(flat, 116, 84)
    dummy: _sov_set_byte(flat, 117, 65)
    poke8(flat, 128, 4294967296 + dfoff)
    poke8(flat, 136, dlen + 65536)
    poke8(flat, 144, dfoff)
    poke8(flat, 152, dlen)
    poke4(flat, 160, 3)
    poke4(flat, 164, 3)
    poke4(flat, 176, 2147483688)
    poke4(flat, 180, 24)
    poke8(flat, 184, hdr)
    poke4(flat, 192, 29)
    poke4(flat, 196, 16)
    poke4(flat, 200, codelim)
    poke4(flat, 204, sig_len)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, hdr + i, _sov_list_get(code, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, hdr + str_off + si, _sov_buf_at(letters, si))
        si: si + 1
    str_addr: 4294967296 + hdr + str_off
    glob_addr: 4294967296 + hdr + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_value, i)
        if same(kind, "rel26") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(task_at, fi)
                rel: (tgt - at) / 4
                if rel < 0
                    rel: rel + 67108864
                poke4(flat, hdr + at, 2483027968 + (rel % 67108864))
            if not
                print "Error: no such task" : val
                print _sov_list_get(patch_line, i)
                saw_error: 1
        if same(kind, "b26") = 1
            poke4(flat, hdr + at, 335544320 + (val % 67108864))
        if same(kind, "gw64s_a") = 1
            gsa2: str_addr
            poke4(flat, hdr + at, 3531603968 + (gsa2 % 65536) * 32)
            poke4(flat, hdr + at + 4, 4070572032 + ((gsa2 / 65536) % 65536) * 32)
            poke4(flat, hdr + at + 8, 4072669184 + ((gsa2 / 4294967296) % 65536) * 32)
            poke4(flat, hdr + at + 12, 4074766336 + ((gsa2 / 281474976710656) % 65536) * 32)
        if same(kind, "gw64s_n") = 1
            gsc: (sl + 7) / 8
            poke4(flat, hdr + at, 3531603969 + gsc * 32)
        if same(kind, "gw64a") = 1
            gwa2: glob_addr
            poke4(flat, hdr + at, 3531603968 + (gwa2 % 65536) * 32)
            poke4(flat, hdr + at + 4, 4070572032 + ((gwa2 / 65536) % 65536) * 32)
            poke4(flat, hdr + at + 8, 4072669184 + ((gwa2 / 4294967296) % 65536) * 32)
            poke4(flat, hdr + at + 12, 4074766336 + ((gwa2 / 281474976710656) % 65536) * 32)
        if same(kind, "gw64n") = 1
            poke4(flat, hdr + at, 3531603969 + _sov_list_len(global_names) * 32)
        if same(kind, "glob64") = 1
            gx: idx(global_names, val)
            ga: glob_addr + gx * 8
            poke4(flat, hdr + at, 3531603968 + (ga % 65536) * 32 + 9)
            poke4(flat, hdr + at + 4, 4070572032 + ((ga / 65536) % 65536) * 32 + 9)
            poke4(flat, hdr + at + 8, 4072669184 + ((ga / 4294967296) % 65536) * 32 + 9)
        if same(kind, "task_address64") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                fa: 4294967296 + hdr + _sov_list_get(task_at, fi)
                poke4(flat, hdr + at, 3531603968 + (fa % 65536) * 32)
                poke4(flat, hdr + at + 4, 4070572032 + ((fa / 65536) % 65536) * 32)
                poke4(flat, hdr + at + 8, 4072669184 + ((fa / 4294967296) % 65536) * 32)
                poke4(flat, hdr + at + 12, 4074766336 + ((fa / 281474976710656) % 65536) * 32)
            if not
                print "Error: no such task" : val
                saw_error: 1
        if same(kind, "str64x0") = 1
            sa: str_addr + val
            poke4(flat, hdr + at, 3531603968 + (sa % 65536) * 32)
            poke4(flat, hdr + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32)
            poke4(flat, hdr + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32)
        if same(kind, "str64") = 1
            sa: str_addr + val
            poke4(flat, hdr + at, 3531603968 + (sa % 65536) * 32 + 1)
            poke4(flat, hdr + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32 + 1)
            poke4(flat, hdr + at + 8, 4072669184 + ((sa / 4294967296) % 65536) * 32 + 1)
        if same(kind, "adr") = 1
            sa: str_addr + val
            rel: sa - (4294967296 + hdr + at)
            if rel < 0
                rel: rel + 2097152
            poke4(flat, hdr + at, 268435456 + (rel % 4) * 536870912 + ((rel / 4) % 524288) * 32 + 1)
        if same(kind, "cbz_trap") = 1
            ti: idx(task_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(task_at, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, hdr + at, 3019898880 + (rl % 524288) * 32 + val)
        if same(kind, "b19_trap") = 1
            ti: idx(task_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(task_at, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, hdr + at, 1409286144 + (rl % 524288) * 32 + 2)
        if same(kind, "rel") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(task_at, fi)
                rel: tgt - (at + 4)
                poke4(flat, hdr + at, rel)
            if not
                print "Error: no such task" : val
                print _sov_list_get(patch_line, i)
                saw_error: 1
        if same(kind, "str") = 1
            poke8(flat, hdr + at, str_addr + val)
        if same(kind, "str32") = 1
            poke4(flat, hdr + at, str_addr + val)
        if same(kind, "ripstr") = 1
            poke4(flat, hdr + at, str_off + val - at - 4)
        if same(kind, "glob") = 1
            gx: idx(global_names, val)
            poke8(flat, hdr + at, glob_addr + gx * 8)
        if same(kind, "gw64s_a") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "gw64a") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "glob64") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 3)
        if same(kind, "task_address64") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "str64") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 2)
        if same(kind, "str64x0") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 2)
        if same(kind, "str") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 80)
        if same(kind, "str32") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 40)
        if same(kind, "glob") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 80)
        i: i + 1
    if saw_error = 1
        return
    # pass S7: the relocation table rides the __DATA tail, inside
    # the signed span: a count, then (offset, kind) pairs, same
    # shape as the android one
    poke8(flat, dfoff + sl8 + pad, rel_n)
    ri: 0
    as long as ri < rel_n
        poke4(flat, dfoff + sl8 + pad + 8 + ri * 8, hdr + _sov_list_get(reloc_at, ri))
        poke4(flat, dfoff + sl8 + pad + 12 + ri * 8, _sov_list_get(rel_nw, ri))
        ri: ri + 1
    sig: codelim
    poke4be(flat, sig, 4208856256)
    poke4be(flat, sig + 4, sig_len)
    poke4be(flat, sig + 8, 1)
    poke4be(flat, sig + 12, 0)
    poke4be(flat, sig + 16, 20)
    cd: sig + 20
    poke4be(flat, cd, 4208856066)
    poke4be(flat, cd + 4, cd_len)
    poke4be(flat, cd + 8, 132096)
    poke4be(flat, cd + 12, 2)
    poke4be(flat, cd + 16, 56)
    poke4be(flat, cd + 20, 44)
    poke4be(flat, cd + 24, 0)
    poke4be(flat, cd + 28, npages)
    poke4be(flat, cd + 32, codelim)
    dummy: _sov_set_byte(flat, cd + 36, 32)
    dummy: _sov_set_byte(flat, cd + 37, 2)
    dummy: _sov_set_byte(flat, cd + 38, 0)
    dummy: _sov_set_byte(flat, cd + 39, 12)
    poke4be(flat, cd + 40, 0)
    so_name("sovren", flat, cd + 44)
    pg: 0
    as long as pg < npages
        plen: 4096
        if (pg * 4096) + 4096 > codelim
            plen: codelim - (pg * 4096)
        ph: _sov_alloc(64)
        sha256_bytes(flat + pg * 4096, plen, ph)
        hj: 0
        as long as hj < 8
            hv: peek_i64(ph, hj * 8)
            poke4be(flat, cd + 56 + pg * 32 + hj * 4, hv)
            hj: hj + 1
        pg: pg + 1
    w: _sov_write_n(path, flat, filesz)
    if w = 0
        print "Error: cannot write output (is it running?)"
        fail
    if needs_private = 1
        # pass 140: a private program's binary carries its secrets -
        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
poke4be p at v:
    x: v
    if x < 0
        x: x + 4294967296
    dummy: _sov_set_byte(p, at, (x / 16777216) % 256)
    dummy: _sov_set_byte(p, at + 1, (x / 65536) % 256)
    dummy: _sov_set_byte(p, at + 2, (x / 256) % 256)
    dummy: _sov_set_byte(p, at + 3, x % 256)
    return 0

so_name s flat at:
    i: 0
    as long as i < length(s)
        dummy: _sov_set_byte(flat, at + i, _sov_byte_at(s, i))
        i: i + 1
    dummy: _sov_set_byte(flat, at + i, 0)
    return 0
# remember where this compiler lives, so its library and runtime
# are found no matter which folder you run it from
start:
    compiler_folder: dirname(tidy_path(peek_ptr(g_argv, 0)))
    if g_argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail
    in_file: blank
    out_file: blank
    i: 1
    as long as i < g_argc
        arg: peek_ptr(g_argv, i)
        if same(arg, "--bare") = 1
            no_runtime: 1
        if not
            if same(arg, "-o") = 1
                i: i + 1
                if i < g_argc
                    out_file: peek_ptr(g_argv, i)
            if not
                if same(arg, "build") = 0
                    in_file: arg
        i: i + 1
    if length(in_file) = 0
        print "Error: no input"
        fail
    if length(out_file) = 0
        if holds(in_file, ".sov") = 1
            out_file: cut(in_file, 0, look(in_file, ".sov"))
        if not
            out_file: join(in_file, ".out")
    file_name: in_file
    print "Compiling" : in_file
    src: load_file(in_file)
    if src = 0
        print "Error: cannot read input"
        fail
    newline: "\n"
    src: join("# skip this line\n", src)
    libraries: blank
    src: expand_use_lines(src)
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    heap_size: 12582912
    needs_runtime: uses_runtime(src)
    runtime: blank
    if no_runtime = 1
        needs_runtime: 0
    if needs_runtime = 1
        heap_size: 1073741824
        runtime: load_file("runtime.sov")
        if runtime = 0
            runtime: load_file("linux/runtime.sov")
        if runtime = 0
            runtime: load_file(join(compiler_folder, "/runtime.sov"))
        if runtime = 0
            runtime: load_file(join(compiler_folder, "/../runtime.sov"))
        if runtime = 0
            runtime: load_file(join(dirname(dirname(compiler_folder)), "/runtime.sov"))
        if runtime = 0
            print "Error: cannot read runtime"
            fail
    first_user_line: 1
    if length(runtime) > 0
        first_user_line: first_user_line + _sov_list_len(lines_of(runtime))
    if length(extra) > 0
        first_user_line: first_user_line + _sov_list_len(lines_of(extra))
    newline: "\n"
    all: join(runtime, newline)
    first_user_line: first_user_line + 1
    # the runtime's thread paths end themselves through this
    # injected task; it = emitted unconditionally because runtime.sov
    # calls it whether or not the program ever makes a syscall
    # (ios threads are detached arm64 clones, so ending one = exit)
    all: join(all, newline)
        all: join(all, "# mem_copy and mem_set, injected for the arm targets: the x86 back\n# end has them as one rep movsb / rep stosb each, and a shared library\n# may not use a builtin that only one machine has. written with\n# peek_byte and poke_byte, which are builtins on every target.\n_sov_mem_copy d s n:\n    i: 0\n    as long as i < n\n        poke_byte(d, i, peek_byte(s, i))\n        i: i + 1\n    return d\n\n_sov_mem_set d v n:\n    j: 0\n    as long as j < n\n        poke_byte(d, j, v)\n        j: j + 1\n    return d\n")
        first_user_line: first_user_line + 20
    # ios = XNU, not arm64 Linux: Apple numbers its BSD calls its
    # own way, so a raw syscall from library code has to be
    # translated or it lands on the wrong call entirely. In
    # pieces because one line this long will not compile.
    all: join(all, "# x86-64 number in, XNU number out. Apple numbers its BSD\n# calls its own way and has no pause, nanosleep, futex, prctl\n# or plain getcwd, so only calls whose argument lists match\n# both ways are translated; the rest fall through. Every pair\n# here was read out of XNU bsd/kern/syscalls.master.\n_sov_sysnum n:\n    if n = 0\n        return 3\n    if n = 1\n        return 4\n    if n = 3\n        return 6\n    if n = 7\n        return 230\n    if n = 8\n        return 199\n    if n = 9\n        return 197\n    if n = 16\n        return 54\n    if n = 22\n        return 42\n    if n = 27\n        return 93\n    if n = 28\n        return 75\n    if n = 39\n        return 20\n    if n = 41\n        return 97\n")
    all: join(all, "    if n = 42\n        return 98\n    if n = 43\n        return 30\n    if n = 44\n        return 133\n    if n = 45\n        return 29\n    if n = 49\n        return 104\n    if n = 50\n        return 106\n    if n = 56\n        return 360\n    if n = 57\n        return 2\n    if n = 59\n        return 59\n    if n = 60\n        return 1\n    if n = 61\n        return 7\n    if n = 74\n        return 95\n    if n = 77\n        return 201\n    if n = 80\n        return 12\n    if n = 82\n        return 128\n    if n = 83\n        return 136\n    if n = 84\n        return 137\n    if n = 87\n        return 10\n    if n = 90\n        return 15\n    if n = 102\n        return 24\n")
    all: join(all, "    if n = 104\n        return 47\n    if n = 107\n        return 25\n    if n = 257\n        return 463\n    if n = 262\n        return 469\n    if n = 263\n        return 472\n    if n = 318\n        return 500\n    return n\n")
    all: join(all, newline)
    first_user_line: first_user_line + 80
    all: join(all, join("_sov_thread_exit:", newline))
    all: join(all, join("    syscall(60, 0, 0, 0, 0, 0, 0)", newline))
    all: join(all, join("    return 0 - 1", newline))
    first_user_line: first_user_line + 4
    all: join(all, src)
    compile(all)
    write_program(out_file)
    if saw_error = 1
        fail
    print "Wrote" : out_file
start
push_reg n:
    emitw(4162785248 + n)

emit_write_lit s:
    n: length(s)
    set_reg(0, 1)
    off: intern_nz(s)
    at: here()
    emitw(268435457)
    later_fill(at, "adr", off)
    set_reg(2, n)
    set_reg(8, sc_write)
    ask_kernel

# mmap(0, sz, RW, PRIVATE|ANON, -1, 0) -> x0
emit_print:
    task_names: _sov_list_add(task_names, "_sov_print")
    task_at: _sov_list_add(task_at, here())
    # a value under 65536 is not a real address. reading from it
    # would crash, so hand it to the number printer instead.
    emitw(4047519775)
    hi: here()
    emitw(1409286146)
    used_print_number: 1
    print_number
    ret
    put_arm(hi, here() - hi)
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    mov_reg(19, 0)
    mov_reg(9, 19)
    set_reg(20, 0)
    top: here()
    emitw(2333344042)
    emitw(960495947)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432698004)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ex)
    set_reg(0, 1)
    mov_reg(1, 19)
    mov_reg(2, 20)
    set_reg(8, sc_write)
    ask_kernel
    set_reg(0, 1)
    nl_at: here()
    emitw(268435457)
    later_fill(nl_at, "adr", intern_nz("\n"))
    set_reg(2, 1)
    set_reg(8, sc_write)
    ask_kernel
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)
    ret

# x0 = number, writes it in decimal then a newline
put_sub_sp at n:
    v: n
    if v < 0
        v: 0
    oc_set_word(at, 3506439167 + (v % 4096) * 1024)
    return 0

# bit32.sov — 32-bit word helpers (pure Sovren)

M32: 4294967296

# sha256.sov — real SHA-256 in pure Sovren

sha_ch x y z:
    return wxor(wand(x, y), wand(wnot(x), z))

sha_maj x y z:
    return wxor(wxor(wand(x, y), wand(x, z)), wand(y, z))

sha_bs0 x:
    return wxor(wxor(rotr(x, 2), rotr(x, 13)), rotr(x, 22))

sha_bs1 x:
    return wxor(wxor(rotr(x, 6), rotr(x, 11)), rotr(x, 25))

sha_ss0 x:
    return wxor(wxor(rotr(x, 7), rotr(x, 18)), shr(x, 3))

sha_ss1 x:
    return wxor(wxor(rotr(x, 17), rotr(x, 19)), shr(x, 10))

