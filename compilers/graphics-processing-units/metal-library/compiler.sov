# Sovren to Metal Shading Language compute shader source emitter.
# Lowers command-style integer functions, locals, if/else blocks, loops, calls, and return.
# The compute entry stores the lowered main result in storage buffer slot 0.

use:
    arg
    file
    string
    sys

src: 0
out: ''
locals: 0
block_inds: 0
block_kinds: 0
block_n: 0
last_block_kind: ''
have_main: 0

emit s:
    out: str_cat(out, s)
    return 0

emitln s:
    out: str_cat(out, s)
    out: str_cat(out, "\n")
    return 0

is_sp c:
    if c = 32 -> return 1
    if c = 9 -> return 1
    if c = 13 -> return 1
    return 0

is_alfa c:
    if c >= 97 -> if c <= 122 -> return 1
    if c >= 65 -> if c <= 90 -> return 1
    if c = 95 -> return 1
    return 0

is_aln c:
    if is_alfa(c) = 1 -> return 1
    if c >= 48 -> if c <= 57 -> return 1
    return 0

ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n -> if is_sp(peek_byte(s, i)) = 1
            i: i + 1
        if not -> leave
    return str_cut(s, i, n)

rtrim s:
    n: str_len(s)
    as long as n > 0 -> if is_sp(peek_byte(s, n - 1)) = 1
            n: n - 1
        if not -> leave
    return str_cut(s, 0, n)

trim s:
    return rtrim(ltrim(s))

word_end s a:
    n: str_len(s)
    i: a
    as long as i < n -> if is_aln(peek_byte(s, i)) = 1
            i: i + 1
        if not -> leave
    return i

find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n -> if peek_byte(s, i) = c -> return i
        i: i + 1
    return 0 - 1

find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n -> if peek_byte(s, i) = 45
            if peek_byte(s, i + 1) = 62 -> return i
        i: i + 1
    return 0 - 1

starts s p:
    pn: str_len(p)
    if str_len(s) < pn -> return 0
    if str_eq(str_cut(s, 0, pn), p) = 1 -> return 1
    return 0

indent_of s:
    n: str_len(s)
    i: 0
    w: 0
    as long as i < n -> c: peek_byte(s, i)
        if c = 32 -> w: w + 1
        if not -> if c = 9 -> w: w + 4
            if not -> return w
        i: i + 1
    return w

cond_expr s:
    n: str_len(s)
    r: ''
    i: 0
    as long as i < n -> c: peek_byte(s, i)
        repl: 0
        if c = 61 -> prev: 0
            next: 0
            if i > 0 -> prev: peek_byte(s, i - 1)
            if i + 1 < n -> next: peek_byte(s, i + 1)
            repl: 1
            if prev = 60 -> repl: 0
            if prev = 62 -> repl: 0
            if prev = 33 -> repl: 0
            if prev = 61 -> repl: 0
            if next = 61 -> repl: 0
        if repl = 1 -> r: str_cat(r, '==')
        if not -> r: str_cat(r, str_cut(s, i, i + 1))
        i: i + 1
    return r

push_block kind ind:
    if block_n < _sov_list_len(block_inds) -> block_inds: _sov_list_set(block_inds, block_n, ind)
        block_kinds: _sov_list_set(block_kinds, block_n, kind)
    if not -> block_inds: _sov_list_add(block_inds, ind)
        block_kinds: _sov_list_add(block_kinds, kind)
    block_n: block_n + 1
    return 0

close_one:
    if block_n > 0 -> emitln('    }')
        block_n: block_n - 1
    return 0

close_blocks ind:
    as long as block_n > 0 -> top: _sov_list_get(block_inds, block_n - 1)
        if ind <= top -> close_one()
        if not -> leave
    return 0

close_all:
    as long as block_n > 0 -> close_one()
    return 0

emit_else_line s ind:
    if block_n > 0 -> top: _sov_list_get(block_inds, block_n - 1)
        kind: as text _sov_list_get(block_kinds, block_n - 1)
        if ind <= top -> if str_eq(kind, 'if') = 1
                emitln('    } else {')
                block_n: block_n - 1
                push_block('else', ind)
                ar: find_arrow(s)
                if ar >= 0 -> body: trim(str_cut(s, ar + 2, str_len(s)))
                    if str_len(body) > 0 -> emit_stmt_parts(body)
                return 1
    close_blocks(ind)
    emitln('    else {')
    push_block('else', ind)
    ar2: find_arrow(s)
    if ar2 >= 0 -> body2: trim(str_cut(s, ar2 + 2, str_len(s)))
        if str_len(body2) > 0 -> emit_stmt_parts(body2)
    return 1

local_seen nm:
    i: 0
    as long as i < _sov_list_len(locals) -> if str_eq(as text _sov_list_get(locals, i), nm) = 1 -> return 1
        i: i + 1
    return 0

local_add nm:
    if local_seen(nm) = 0 -> locals: _sov_list_add(locals, nm)
    return 0

shader_name nm:
    if str_eq(nm, 'main') = 1 -> return 'sovren_user_main'
    return nm

shader_expr s:
    # For this command subset, integer arithmetic/comparison/call syntax is
    # already valid in the target shader languages once the main helper is
    # renamed out of the compute-entry namespace.
    return trim(s)

emit_stmt st:
    s: trim(st)
    if str_len(s) = 0 -> return 0
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if starts(s, 'as long as ') = 1 -> arw: find_arrow(s)
        if arw < 0 -> return 0
        condw: trim(str_cut(s, 11, arw))
        bodyw: trim(str_cut(s, arw + 2, str_len(s)))
        emit('    while (')
        emit(cond_expr(condw))
        emitln(') {')
        if str_len(bodyw) > 0 -> emit_stmt_parts(bodyw)
        last_block_kind: 'while'
        return 1
    if str_eq(kw, 'print') = 1 -> pw: trim(str_cut(s, w, str_len(s)))
        emit('    sovren_out[sovren_n] = uint(')
        emit(shader_expr(pw))
        emitln(');')
        emitln('    sovren_n = sovren_n + 1;')
        return 0
    if str_eq(kw, 'return') = 1 -> emit('    return ')
        emit(shader_expr(str_cut(s, w, str_len(s))))
        emitln(';')
        return 0
    if str_eq(kw, 'if') = 1 -> ar: find_arrow(s)
        if ar < 0 -> return 0
        cond: trim(str_cut(s, w, ar))
        body: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond, 'not') = 1 -> emitln('    else {')
            if str_len(body) > 0 -> emit_stmt_parts(body)
            last_block_kind: 'else'
            return 1
        emit('    if (')
        emit(cond_expr(cond))
        emitln(') {')
        if str_len(body) > 0 -> emit_stmt_parts(body)
        last_block_kind: 'if'
        return 1
    col: find_ch(s, 58)
    if col > 0 -> nm: trim(str_cut(s, 0, col))
        ex: shader_expr(str_cut(s, col + 1, str_len(s)))
        if local_seen(nm) = 1 -> emit('    ')
            emit(nm)
            emit(' = ')
            emit(ex)
            emitln(';')
        if not -> local_add(nm)
            emit('    int ')
            emit(nm)
            emit(' = ')
            emit(ex)
            emitln(';')
        return 0
    return 0

emit_stmt_parts s:
    t0: trim(s)
    if starts(t0, 'as long as ') = 1 -> return emit_stmt(t0)
    if starts(t0, 'if ') = 1 -> return emit_stmt(t0)
    start: 0
    n: str_len(s)
    opened: 0
    as long as start < n -> i: start
        found: 0
        as long as i + 1 < n -> if peek_byte(s, i) = 59
                if peek_byte(s, i + 1) = 59 -> found: 1
                    leave
            i: i + 1
        if found = 0 -> i: n
        one: emit_stmt(str_cut(s, start, i))
        if one = 1 -> opened: 1
        if found = 1 -> start: i + 2
        if not -> start: n
    return opened

emit_header line:
    h: trim(line)
    if str_len(h) = 0 -> return 0
    if peek_byte(h, str_len(h) - 1) != 58 -> return 0
    h: str_cut(h, 0, str_len(h) - 1)
    w: word_end(h, 0)
    nm: str_cut(h, 0, w)
    locals: _sov_list_new()
    enm: shader_name(nm)
    if str_eq(nm, 'main') = 1 -> have_main: 1
    emit("int ")
    emit(enm)
    emit("(")
    p: trim(str_cut(h, w, str_len(h)))
    first: 1
    as long as str_len(p) > 0 -> p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0 -> leave
        pn: str_cut(p, 0, e)
        if first = 0 -> emit(', ')
        emit("int ")
        emit(pn)
        emit("")
        local_add(pn)
        first: 0
        p: trim(str_cut(p, e, str_len(p)))
    emit(")")
    emit("")
    emitln(' {')
    return 1

emit_kernel:
    if have_main = 0 -> emit("int ")
        emit('sovren_user_main')
        emit("()")
        emit("")
        emitln(' {')
        emitln('    return 0;')
        emitln('}')
        emitln('')
    emitln("kernel void sovren_main(device uint* sovren_out [[buffer(0)]],")
    emitln("                        uint3 gid [[thread_position_in_grid]]) {")
    emitln("    if (gid.x == 0) {")
    emitln("        sovren_out[0] = uint(sovren_user_main());")
    emitln("    }")
    emitln("}")
    return 0

compile_file path:
    src: file_read_all(path)
    if src = 0 -> print 'msl: cannot read input'
        sys_exit(1)
    out: "#include <metal_stdlib>\nusing namespace metal;\nstatic int sovren_n = 1;\n\n"
    n: str_len(src)
    i: 0
    in_fn: 0
    block_inds: _sov_list_new()
    block_kinds: _sov_list_new()
    block_n: 0
    have_main: 0
    as long as i < n -> e: i
        as long as e < n -> if peek_byte(src, e) = 10 -> leave
            e: e + 1
        raw: str_cut(src, i, e)
        t: trim(raw)
        if str_len(t) > 0 -> if peek_byte(t, 0) != 35
                ind: indent_of(raw)
                if is_sp(peek_byte(raw, 0)) = 0 -> if in_fn = 1 -> close_all()
                    if in_fn = 1 -> emitln('}')
                    if in_fn = 1 -> emitln('')
                    in_fn: emit_header(t)
                    block_n: 0
                if is_sp(peek_byte(raw, 0)) = 1 -> if starts(t, 'if not') = 1
                        emit_else_line(t, ind)
                    if not -> close_blocks(ind)
                        opened: emit_stmt_parts(t)
                        if opened = 1 -> push_block(last_block_kind, ind)
        i: e + 1
    if in_fn = 1 -> close_all()
    if in_fn = 1 -> emitln('}')
    if in_fn = 1 -> emitln('')
    emit_kernel()
    return 0

buf: 0

at8 o v:
    poke_byte(buf, o, v & 255)
    return 0

at32 o v:
    poke_byte(buf, o, v & 255)
    poke_byte(buf, o + 1, (v / 256) & 255)
    poke_byte(buf, o + 2, (v / 65536) & 255)
    poke_byte(buf, o + 3, (v / 16777216) & 255)
    return 0

put_text o s:
    i: 0
    as long as i < str_len(s) -> at8(o + i, peek_byte(s, i))
        i: i + 1
    return 0

emit_pkg msl:
    n: str_len(msl)
    total: 64 + n
    buf: _sov_alloc(total)
    i: 0
    as long as i < total -> at8(i, 0)
        i: i + 1
    put_text(0, 'MTLB')
    at32(4, 2)
    at32(8, 0)
    at32(12, n)
    put_text(16, 'SOVREN-METALLIB')
    put_text(64, msl)
    return total

main:
    ac: arg_count()
    if ac < 2 -> print 'Usage: compiler src.sov -o out.pkg'
        sys_exit(1)
    srcp: as text arg_at(1)
    outp: 'sovren.metallib'
    if ac = 3
        if str_eq(as text arg_at(1), '-o') = 0 -> if str_eq(as text arg_at(2), '-o') = 0 -> outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac -> if str_eq(as text arg_at(i), '-o') = 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not -> i: i + 1
    compile_file(srcp)
    n: emit_pkg(out)
    file_write_bytes(outp, buf, n)
    sov_stamp_append(outp, 'SOVREN-METALLIB')
    print 'metallib: wrote '
    print outp
    return 0
