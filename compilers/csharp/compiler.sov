# Expanded compact source to match current shared front end.
# Sovren to C# source emitter.
# Generates C# for CLR/.NET-style runtimes: functions/calls, integer
# locals/reassignment, literal/numeric print, return, equality if/else blocks,
# while loops, and literal repetition.

main:
    ac: arg_count()
    if ac < 2
        print "Usage: compiler src.sov -o out.cs"
        sys_exit(1)
    srcp: as text arg_at(1)
    outp: "SovrenMain.cs"
    if ac is 3
        if str_eq(as text arg_at(1), "-o") is 0
            if str_eq(as text arg_at(2), "-o") is 0
                outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac
        if str_eq(as text arg_at(i), "-o") is 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not
            i: i + 1
    compile_file(srcp)
    file_write_all(outp, out)
    print "csharp: wrote "
    print outp
    return 0


use arg
use file
use string
use sys

src: 0
out: ""
locals: 0
in_main: 0
fn_return_seen: 0
block_inds: 0
block_kinds: 0
block_n: 0
last_block_kind: ""

emit s:
    out: str_cat(out, s)
    return 0

emitln s:
    out: str_cat(out, s)
    out: str_cat(out, "\n")
    return 0

is_sp c:
    if c is 32
        return 1
    if c is 9
        return 1
    if c is 13
        return 1
    return 0

is_alfa c:
    if c >= 97
        if c <= 122
            return 1
    if c >= 65
        if c <= 90
            return 1
    if c is 95
        return 1
    return 0

is_aln c:
    if is_alfa(c) is 1
        return 1
    if c >= 48
        if c <= 57
            return 1
    return 0

ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n
        if is_sp(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return str_cut(s, i, n)

rtrim s:
    n: str_len(s)
    as long as n > 0
        if is_sp(peek_byte(s, n - 1)) is 1
            n: n - 1
        if not
            leave
    return str_cut(s, 0, n)

trim s:
    return rtrim(ltrim(s))

word_end s a:
    n: str_len(s)
    i: a
    as long as i < n
        if is_aln(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return i

find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n
        if peek_byte(s, i) is c
            return i
        i: i + 1
    return 0 - 1

find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n
        if peek_byte(s, i) is 45
            if peek_byte(s, i + 1) is 62
                return i
        i: i + 1
    return 0 - 1

starts s p:
    pn: str_len(p)
    if str_len(s) < pn
        return 0
    if str_eq(str_cut(s, 0, pn), p) is 1
        return 1
    return 0

indent_of s:
    n: str_len(s)
    i: 0
    w: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 32
            w: w + 1
        if not
            if c is 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w

cond_expr s:
    n: str_len(s)
    r: ""
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        repl: 0
        if c is 61
            prev: 0
            next: 0
            if i > 0
                prev: peek_byte(s, i - 1)
            if i + 1 < n
                next: peek_byte(s, i + 1)
            repl: 1
            if prev is 60
                repl: 0
            if prev is 62
                repl: 0
            if prev is 33
                repl: 0
            if prev is 61
                repl: 0
            if next is 61
                repl: 0
        if repl is 1
            r: str_cat(r, "==")
        if not
            r: str_cat(r, str_cut(s, i, i + 1))
        i: i + 1
    return r

push_block kind ind:
    if block_n < _sov_list_len(block_inds)
        block_inds: _sov_list_set(block_inds, block_n, ind)
        block_kinds: _sov_list_set(block_kinds, block_n, kind)
    if not
        block_inds: _sov_list_add(block_inds, ind)
        block_kinds: _sov_list_add(block_kinds, kind)
    block_n: block_n + 1
    return 0

close_one:
    if block_n > 0
        emitln("    }")
        block_n: block_n - 1
    return 0

close_blocks ind:
    as long as block_n > 0
        top: _sov_list_get(block_inds, block_n - 1)
        if ind <= top
            close_one()
        if not
            leave
    return 0

close_all:
    as long as block_n > 0
        close_one()
    return 0

emit_else_line s ind:
    if block_n > 0
        top: _sov_list_get(block_inds, block_n - 1)
        kind: as text _sov_list_get(block_kinds, block_n - 1)
        if ind <= top
            if str_eq(kind, "if") is 1
                emitln("    } else {")
                block_n: block_n - 1
                push_block("else", ind)
                ar: find_arrow(s)
                if ar >= 0
                    body: trim(str_cut(s, ar + 2, str_len(s)))
                    if str_len(body) > 0
                        emit_stmt_parts(body)
                return 1
    close_blocks(ind)
    emitln("    else {")
    push_block("else", ind)
    ar2: find_arrow(s)
    if ar2 >= 0
        body2: trim(str_cut(s, ar2 + 2, str_len(s)))
        if str_len(body2) > 0
            emit_stmt_parts(body2)
    return 1

cs_esc s:
    n: str_len(s)
    r: ""
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 34
            r: str_cat(r, "\\\"")
        if not
            if c is 92
                r: str_cat(r, "\\\\")
            if not
                r: str_cat(r, str_cut(s, i, i + 1))
        i: i + 1
    return r

local_seen nm:
    i: 0
    as long as i < _sov_list_len(locals)
        if str_eq(as text _sov_list_get(locals, i), nm) is 1
            return 1
        i: i + 1
    return 0

local_add nm:
    if local_seen(nm) is 0
        locals: _sov_list_add(locals, nm)
    return 0

cs_expr s:
    return trim(s)

emit_print_lit lit reps:
    i: 0
    esc: cs_esc(lit)
    as long as i < reps
        emit("    Console.WriteLine(\"")
        emit(esc)
        emitln("\");")
        i: i + 1
    return 0

emit_stmt st:
    s: trim(st)
    if str_len(s) is 0
        return 0
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if starts(s, "as long as ") is 1
        arw: find_arrow(s)
        if arw < 0
            return 0
        condw: trim(str_cut(s, 11, arw))
        bodyw: trim(str_cut(s, arw + 2, str_len(s)))
        emit("    while (")
        emit(cond_expr(condw))
        emitln(") {")
        if str_len(bodyw) > 0
            emit_stmt_parts(bodyw)
        last_block_kind: "while"
        return 1
    if str_eq(kw, "print") is 1
        rest: trim(str_cut(s, w, str_len(s)))
        if str_len(rest) > 0
            if peek_byte(rest, 0) is 39
                j: 1
                as long as j < str_len(rest)
                    if peek_byte(rest, j) is 39
                        leave
                    j: j + 1
                lit: str_cut(rest, 1, j)
                reps: 1
                tail: trim(str_cut(rest, j + 1, str_len(rest)))
                if str_len(tail) > 0
                    if peek_byte(tail, 0) >= 48
                        if peek_byte(tail, 0) <= 57
                            reps: 0
                            k: 0
                            as long as k < str_len(tail)
                                cc: peek_byte(tail, k)
                                if cc >= 48
                                    if cc <= 57
                                        reps: reps * 10 + cc - 48
                                        k: k + 1
                                    if not
                                        leave
                                if not
                                    leave
                emit_print_lit(lit, reps)
                return 0
            if not
                if peek_byte(rest, 0) is 34
                    j2: 1
                    as long as j2 < str_len(rest)
                        if peek_byte(rest, j2) is 34
                            leave
                        j2: j2 + 1
                    lit2: str_cut(rest, 1, j2)
                    reps2: 1
                    tail2: trim(str_cut(rest, j2 + 1, str_len(rest)))
                    if str_len(tail2) > 0
                        if peek_byte(tail2, 0) >= 48
                            if peek_byte(tail2, 0) <= 57
                                reps2: 0
                                k2: 0
                                as long as k2 < str_len(tail2)
                                    cc2: peek_byte(tail2, k2)
                                    if cc2 >= 48
                                        if cc2 <= 57
                                            reps2: reps2 * 10 + cc2 - 48
                                            k2: k2 + 1
                                        if not
                                            leave
                                    if not
                                        leave
                    emit_print_lit(lit2, reps2)
                    return 0
        emit("    Console.WriteLine(")
        emit(cs_expr(rest))
        emitln(");")
        return 0
    if str_eq(kw, "return") is 1
        fn_return_seen: 1
        emit("    return ")
        emit(cs_expr(str_cut(s, w, str_len(s))))
        emitln(";")
        return 0
    if str_eq(kw, "if") is 1
        ar: find_arrow(s)
        if ar < 0
            return 0
        cond: trim(str_cut(s, w, ar))
        body: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond, "not") is 1
            emitln("    else {")
            if str_len(body) > 0
                emit_stmt_parts(body)
            last_block_kind: "else"
            return 1
        emit("    if (")
        emit(cond_expr(cond))
        emitln(") {")
        if str_len(body) > 0
            emit_stmt_parts(body)
        last_block_kind: "if"
        return 1
    col: find_ch(s, 58)
    if col > 0
        nm: trim(str_cut(s, 0, col))
        ex: cs_expr(str_cut(s, col + 1, str_len(s)))
        if local_seen(nm) is 1
            emit("    ")
            emit(nm)
            emit(" = ")
            emit(ex)
            emitln(";")
        if not
            local_add(nm)
            emit("    long ")
            emit(nm)
            emit(" = ")
            emit(ex)
            emitln(";")
        return 0
    return 0

emit_stmt_parts s:
    t0: trim(s)
    if starts(t0, "as long as ") is 1
        return emit_stmt(t0)
    if starts(t0, "if ") is 1
        return emit_stmt(t0)
    start: 0
    n: str_len(s)
    opened: 0
    as long as start < n
        i: start
        found: 0
        as long as i + 1 < n
            if peek_byte(s, i) is 59
                if peek_byte(s, i + 1) is 59
                    found: 1
                    leave
            i: i + 1
        if found is 0
            i: n
        one: emit_stmt(str_cut(s, start, i))
        if one is 1
            opened: 1
        if found is 1
            start: i + 2
        if not
            start: n
    return opened

emit_header line:
    h: trim(line)
    if str_len(h) is 0
        return 0
    if peek_byte(h, str_len(h) - 1) is not 58
        return 0
    h: str_cut(h, 0, str_len(h) - 1)
    w: word_end(h, 0)
    nm: str_cut(h, 0, w)
    locals: _sov_list_new()
    fn_return_seen: 0
    in_main: 0
    if str_eq(nm, "main") is 1
        in_main: 1
    emit("  static long ")
    if in_main is 1
        emit("sovren_main")
    if not
        emit(nm)
    emit("(")
    p: trim(str_cut(h, w, str_len(h)))
    first: 1
    as long as str_len(p) > 0
        p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0
            leave
        pn: str_cut(p, 0, e)
        if first is 0
            emit(", ")
        emit("long ")
        emit(pn)
        local_add(pn)
        first: 0
        p: trim(str_cut(p, e, str_len(p)))
    emitln(") {")
    return 1

compile_file path:
    src: ""
    if file_size(path) > 100000
        src: file_read_max(path, 4096)
    if not
        src: file_read_all(path)
    if src is 0
        print "csharp: cannot read input"
        sys_exit(1)
    out: "using System;\n\npublic static class SovrenMain {\n"
    n: str_len(src)
    if n >= 4096
        n: 0
    i: 0
    in_fn: 0
    block_inds: _sov_list_new()
    block_kinds: _sov_list_new()
    block_n: 0
    as long as i < n
        e: i
        as long as e < n
            if peek_byte(src, e) is 10
                leave
            e: e + 1
        raw: str_cut(src, i, e)
        t: trim(raw)
        if str_len(t) > 0
            if peek_byte(t, 0) is not 35
                ind: indent_of(raw)
                if is_sp(peek_byte(raw, 0)) is 0
                    if in_fn is 1
                        close_all()
                    if in_fn is 1
                        if fn_return_seen is 0
                            emitln("    return 0;")
                    if in_fn is 1
                        emitln("}")
                    in_fn: emit_header(t)
                    block_n: 0
                if is_sp(peek_byte(raw, 0)) is 1
                    if starts(t, "if not") is 1
                        emit_else_line(t, ind)
                    if not
                        close_blocks(ind)
                        opened: emit_stmt_parts(t)
                        if opened is 1
                            push_block(last_block_kind, ind)
        i: e + 1
    if in_fn is 1
        close_all()
    if in_fn is 1
        if fn_return_seen is 0
            emitln("    return 0;")
    if in_fn is 1
        emitln("}")
    emitln("")
    emitln("  public static int Main(string[] args) {")
    emitln("    long r = sovren_main();")
    emitln("    return (int)r;")
    emitln("  }")
    emitln("}")
    return 0

