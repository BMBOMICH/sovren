                        # (the arg) and nothing else callee-saved -
                        # a/rdx/rcx are caller-saved - so the frame
                        # = one register, not three
                        saved_locals: 1
                        skip_frame: 1
                    can_here: 0
                    cbi: 0
                    as long as cbi < _sov_list_len(_sov_list_get(bodies, fi))
