                    if debug_on = 1
                        if _sov_list_get(user_tasks, fi) = 1
                            error_line: _sov_list_get(line_of_task, fi)
                            if code is not 0
                                debug_at: _sov_list_add(debug_at, here())
                                debug_lines: _sov_list_add(debug_lines, error_line)
                    prolog
                    if can_here = 1
                        if skip_frame = 0
                            if isfib = 0
                                canary_store
                    copyargs(_sov_list_len(ps))
                    if isfib = 1
                        emit_fib_iter
                    if not
                        if same(nm, "main") = 1
                            dead_alloc_name: drop_unused(_sov_list_get(bodies, fi))
                            if needs_private = 1
                                emit_nodump
                                emit_canary_seed
                                emit_crash_install
                            leaf8: leaf8_scan(tops)
                            line_of_stmt: tops_lns
                            program_start: here()
                            last_was_small: 0
                            at_top: 1
                            body(tops)
                            at_top: 0
                            line_of_stmt: _sov_list_get(line_of_body, fi)
                            cflush_all
                        leaf8: 0
                        if _sov_list_len(ps) = 0
                            leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                        if same(nm, "main") = 1
                            at_top: 1
                        body(_sov_list_get(bodies, fi))
                        if same(nm, "main") = 1
                            at_top: 0
                    if _sov_list_len(local_names) < 6
                        if saved_locals < _sov_list_len(local_names)
                            print "Warning: local_names" : nm
                            print "local_names" : _sov_list_len(local_names)
                            print "saved" : saved_locals
                    if saw_letters = 1
                        mark_fn_str(nm)
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes below
                    # the frame pointer, so the room has to be a full
                    # slot deeper than the count, or the callee's own
                    # frame lands on top of our spilled values
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes
                    # below the frame pointer, so the room has to be
                    # a full slot deeper than the count, or the
                    # callee's own frame lands on top of our spilled
                    # values
                    if skip_frame = 0
                        ns: (_sov_list_len(local_names) + 1) * 8
                        if ns < 32
                            ns: 32
                        # pass S5: room for the canary below the
                        # deepest local, still inside the frame
                        if _sov_list_len(guard_holes) > 0
                            ns: ns + 16
                        put(frame_at, ns)
                        if frame_open = 1
                            if isfib = 0
                                canary_check
                                xor_rax
                                restores
                                frame_wipe
                                put_in_program(201)
                                ret
                                frame_done: 1
                            fwi: 0
                            as long as fwi < _sov_list_len(frame_holes)
                                put(_sov_list_get(frame_holes, fwi), ns + saved_locals * 8)
                                fwi: fwi + 1
                        # pass S5: patch the canary displacement holes
                        # now - after the end-of-body epilogue has
                        # emitted its own check into the list
                        chi: 0
                        as long as chi < _sov_list_len(guard_holes)
