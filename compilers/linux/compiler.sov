leave:
    if no_frame is 1
        if fn_save_n > 4
            emit(65)
            emit(95)
        if fn_save_n > 3
            emit(65)
            emit(94)
        if fn_save_n > 2
            emit(65)
            emit(93)
        if fn_save_n > 1
            emit(65)
            emit(92)
        if fn_save_n > 0
            emit(91)
        return 0
    restores()
    emit(201)
sysc:
    emit(15)
    emit(5)
load_glob name:
    # rip-relative: no scratch register, four bytes shorter
    emit(72)
    emit(139)
    emit(5)
    at: here()
    emit4(0)
    addp(at, "grel", name)
store_glob name:
    emit(72)
    emit(137)
    emit(5)
    at: here()
    emit4(0)
    addp(at, "grel", name)
do_print_one arg:
    if length(arg) > 1
        if _sov_byte_at(arg, 0) is 34
            if same(letter(arg, length(arg) - 1), "\"") is 1
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
    typ: expr(arg)
    mov_rdi_rax()
    if typ is 1
        used_pr: 1
        calln("_sov_print")
    if not
        used_pi: 1
        calln("_sov_print_int")
    if br_depth is 0
        rax_small: 1
do_print_times what nstr:
    if idx(glob_names, "__pt_c") is 0 - 1
        glob_names: _sov_list_add(glob_names, "__pt_c")
        glob_names: _sov_list_add(glob_names, "__pt_i")
    expr(nstr)
    storev("__pt_c")
    xor_rax()
    storev("__pt_i")
    align32()
    st: here()
    loadv("__pt_i")
    push_rax()
    loadv("__pt_c")
    mov_rcx_rax()
    pop_rax()
    cmp_rax_rcx()
    setcc("lt")
    test_rax()
    z: jz()
    do_print_one(what)
    inc_var("__pt_i")
    jb: jmp()
    put(jb, st - (jb + 4))
    patch(z)
call_args name argc direct:
    # cfunc(addr, a1..a6) calls a C function at a computed address.
    # C wants its arguments in rdi rsi rdx rcx r8 r9 and the stack
    # aligned to 16 bytes, and rax cleared for a variadic callee.
    if same(name, "cfunc") is 1
        # args pop to their C registers; the call target swaps into
        # r10 from the stack, parking the caller's r10 under it.
        # r11 is never touched.
        emit(65)
        emit(89)
        emit(65)
        emit(88)
        emit(89)
        emit(90)
        emit(94)
        emit(95)
        emit(76)
        emit(135)
        emit(20)
        emit(36)
        emit(85)
        emit(72)
        emit(137)
        emit(229)
        emit(72)
        emit(131)
        emit(228)
        emit(240)
        emit(49)
        emit(192)
        emit(65)
        emit(255)
        emit(210)
        emit(72)
        emit(137)
        emit(236)
        emit(93)
        emit(65)
        emit(90)
        return
    if same(name, "syscall") is 1
        # pop exactly the values that were pushed, highest position
        # first: a7->r9, a6->r8, a5->rcx, a4->rdx, a3->rsi,
        # a2->rdi, a1(num)->rax. the kernel wants arg4 in r10, so
        # a5 parks in rcx and moves at the last moment with the
        # caller's r10 saved around the whole sequence. r11 is
        # never touched. (the old code always popped seven; the
        # four-value print syscalls survived only because their
        # rbp frames absorbed three slots of drift.)
        sy: argc
        if sy > 7
            sy: 7
        if sy > 6
            emit(65)
            emit(89)
        if sy > 5
            emit(65)
            emit(88)
        if sy > 4
            emit(89)
        if sy > 3
            emit(90)
        if sy > 2
            emit(94)
        if sy > 1
            emit(95)
        pop_rax()
        if argc > 4
            emit(65)
            emit(82)
            emit(73)
            emit(137)
            emit(202)
            sysc()
            emit(65)
            emit(90)
        if not
            sysc()
        return
    if direct is 0
        if argc is 1
            pop_rax()
            mov_rdi_rax()
        if not
            if argc is 2
                emit(94)
                pop_rax()
                mov_rdi_rax()
            if not
                if argc is 3
                    emit(90)
                    emit(94)
                    pop_rax()
                    mov_rdi_rax()
                if not
                    if argc is 4
                        emit(89)
                        emit(90)
                        emit(94)
                        pop_rax()
                        mov_rdi_rax()
                    if not
                        if argc is 5
                            emit(65)
                            emit(88)
                            emit(89)
                            emit(90)
                            emit(94)
                            pop_rax()
                            mov_rdi_rax()
                        if not
                            if argc is 6
                                emit(65)
                                emit(89)
                                emit(65)
                                emit(88)
                                emit(89)
                                emit(90)
                                emit(94)
                                pop_rax()
                                mov_rdi_rax()
                            if not
                                if argc is 7
                                    emit(65)
                                    emit(90)
                                    emit(65)
                                    emit(89)
                                    emit(65)
                                    emit(88)
                                    emit(89)
                                    emit(90)
                                    emit(94)
                                    pop_rax()
                                    mov_rdi_rax()

    if same(name, "_sov_alloc") is 1
        used_al: 1
    if same(name, "_sov_strlen") is 1
        used_sl: 1
    if same(name, "_sov_str_eq") is 1
        used_eq: 1
    if same(name, "syscall") is 1
        # pop exactly the values that were pushed, highest position
        # first: a7->r9, a6->r8, a5->rcx, a4->rdx, a3->rsi,
        # a2->rdi, a1(num)->rax. the kernel wants arg4 in r10, so
        # a5 parks in rcx and moves at the last moment with the
        # caller's r10 saved around the whole sequence. r11 is
        # never touched. (the old code always popped seven; the
        # four-value print syscalls survived only because their
        # rbp frames absorbed three slots of drift.)
        sy: argc
        if sy > 7
            sy: 7
        if sy > 6
            emit(65)
            emit(89)
        if sy > 5
            emit(65)
            emit(88)
        if sy > 4
            emit(89)
        if sy > 3
            emit(90)
        if sy > 2
            emit(94)
        if sy > 1
            emit(95)
        pop_rax()
        if argc > 4
            emit(65)
            emit(82)
            emit(73)
            emit(137)
            emit(202)
            sysc()
            emit(65)
            emit(90)
        if not
            sysc()
        return
    if same(name, "port_out8") is 1
        emit(72)
        emit(137)
        emit(248)
        emit(137)
        emit(214)
        emit(137)
        emit(240)
        emit(72)
        emit(137)
        emit(250)
        emit(137)
        emit(208)
        emit(238)
        return
    if same(name, "port_in8") is 1
        emit(72)
        emit(137)
        emit(250)
        emit(49)
        emit(192)
        emit(236)
        return
    if same(name, "hlt") is 1
        emit(244)
        return
    if same(name, "cli") is 1
        emit(250)
        return
    if same(name, "sti") is 1
        emit(251)
        return
    if same(name, "peek_raw8") is 1
        emit(72)
        emit(15)
        emit(182)
        emit(4)
        emit(55)
        return
    if same(name, "peek_raw64") is 1
        emit(72)
        emit(139)
        emit(4)
        emit(55)
        return
    if same(name, "poke_raw8") is 1
        emit(136)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "poke_raw64") is 1
        emit(72)
        emit(137)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "peek_byte") is 1
        chk_mem(1)
        emit(72)
        emit(15)
        emit(182)
        emit(4)
        emit(55)
        return
    if same(name, "peek_i64") is 1
        chk_mem(8)
        emit(72)
        emit(139)
        emit(4)
        emit(55)
        return
    if same(name, "peek_ptr") is 1
        chk_mem(8)
        emit(72)
        emit(139)
        emit(4)
        emit(247)
        return
    if same(name, "poke_byte") is 1
        chk_mem(1)
        emit(136)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "poke_i64") is 1
        chk_mem(8)
        emit(72)
        emit(137)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    calln(name)
stmt line:
    s: strip(line)
    if length(s) is 0
        return
    if starts(s, "#") is 1
        return
    rax_small: 0
    q: 0
    qi: 0
    as long as qi < length(s)
        if _sov_byte_at(s, qi) is 92
            qi: qi + 1
        if not
            if _sov_byte_at(s, qi) is 34
                q: q + 1
        qi: qi + 1
    if q % 2 is not 0
        print "Error: unterminated text"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    if length(s) > 1000
        print "Error: line too long, split it up"
        print err_line
        had_err: 1
        return
    if starts(s, "use ") is 1
        return
    if same(s, "private") is 1
        # pass 117: a function that declares private zeroes its frame
        # (the locals region below the saved-register block) at every
        # return, so spilled secrets do not outlive the call in stack
        # residue. the marker also flips need_priv like wipe does.
        fw_on: 1
        return
    if starts(s, "wipe ") is 1
        expr(strip(cut(s, 5, length(s))))
        mov_rdi_rax()
        emit(72)
        emit(133)
        emit(255)
        wsk: jz()
        emit(87)
        used_sl: 1
        calln("_sov_strlen")
        emit(72)
        emit(137)
        emit(193)
        emit(95)
        xor_rax()
        emit(252)
        emit(243)
        emit(170)
        patch(wsk)
        return
    if starts(s, "print ") is 1
        arg: strip(cut(s, 6, length(s)))
        if ends_times(arg) is 1
            head: strip(cut(arg, 0, length(arg) - 6))
            sp: find_last_sp(head)
            if sp > 0 - 1
                do_print_times(strip(cut(head, 0, sp)), strip(cut(head, sp + 1, length(head))))
                return
        if length(arg) > 1
            if _sov_byte_at(arg, 0) is 34
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
        if starts(arg, "peek_byte(") is 1
            if opt_imm > 0
                emit_write_lit(i2s(opt_imm))
                return
        if print_const(arg) is 1
            return
        typ: expr(arg)
        mov_rdi_rax()
        if typ is 1
            used_pr: 1
            calln("_sov_print")
        if not
            used_pi: 1
            calln("_sov_print_int")
        # every print ends with a small rax (0 or the byte count),
        # so a following exit may use the two-byte mov al,60
        if br_depth is 0
            rax_small: 1
        return
    had_col: 0
    col: find_col(s)
    if col > 0
        if col < length(s) - 1
            had_col: 1
            s: join("<-- ", join(strip(cut(s, 0, col)), join(" := ", strip(cut(s, col + 1, length(s))))))
    if starts(s, "<-- ") is 1
        if had_col is 0
            print "Error: bad line"
            _sov_print(s)
            print err_line
            had_err: 1
            return
        rest: cut(s, 4, length(s))
        t: find_sep(rest)
        if t > 0 - 1
            var: repl(strip(cut(rest, 0, t)), " ", "_")
            rhs: strip(cut(rest, t + 4, length(rest)))
            if same(rhs, join(var, " + 1")) is 1
                inc_var(var)
                return
            if same(rhs, join(var, " - 1")) is 1
                dec_var(var)
                return
            if try_slot_forms(var, rhs) is 1
                drop_str(var)
                return
            if try_def_peek(var, rhs) is 1
                drop_str(var)
                return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
                    rs: reg_slot(var)
                    if rs > 0 - 1
                        cflush(var)
                        expr(other)
                        add_rax_slot(rs)
                        drop_str(var)
                        return
                    if not
                        sl6: idx(locals, var)
                        if sl6 > 4
                            mm3: mem_scaled(other)
                            if mm3 > 0 - 1
                                cflush(var)
                                ms3: mm3 / 65536
                                mq3: mm3 % 65536
                                emit_rax_scaled(ms3, mq3 / 4096, mq3 % 4096 - 128)
                                add_rax_mem(sl6)
                                drop_str(var)
                                return
                            mm4: memabs_scaled(other)
                            if mm4 > 0 - 1
                                cflush(var)
                                emit_rax_abs(mm4 / 4294967296 - 1, mm4 % 4294967296)
                                add_rax_mem(sl6)
                                drop_str(var)
                                return
            pref: join(var, " - ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, 0 - _sov_atoi(other))
                                drop_str(var)
                                return
                            sub_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
                    rs: reg_slot(var)
                    if rs > 0 - 1
                        cflush(var)
                        expr(other)
                        sub_rax_slot(rs)
                        drop_str(var)
                        return
            if length(rhs) > 0
                if digit(letter(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        if br_depth is 0
                            nv: _sov_atoi(rhs)
                            cset(var, nv)
                            if nv > 0
                                kn: var
                                kv: nv
                            drop_str(var)
                            if has_vm is 0
                                return
            if try_alloc_imm(var, rhs) is 1
                mark_str(var)
                return
            # pass 111: nought into a register local rides xor
            # slot,slot straight from the flusher - the pending
            # entry is registered and cashed at once, so a later
            # read never materializes a second copy
            if same(rhs, "0") is 1
                # reassigns only: a fresh def keeps registering its
                # slot at first use, so the slot order (and every
                # fusion decision built on it) is untouched
                zl: idx(locals, var)
                if zl > 0 - 1
                    if idx(glob_names, var) < 0
                        if zl < 5
                            cset(var, 0)
                            if zl is 0
                                emit(72)
                                emit(49)
                                emit(219)
                            if not
                                emit(77)
                                emit(49)
                                emit(192 + 9 * (zl + 3))
                            zi: idx(cnms, var)
                            cemt: _sov_list_set(cemt, zi, 1)
                            drop_str(var)
                            return
                        if leaf8 is 1
                            if zl < 9
                                cset(var, 0)
                                emit(77)
                                emit(49)
                                emit(192 + 9 * (zl - 5))
                                zi: idx(cnms, var)
                                cemt: _sov_list_set(cemt, zi, 1)
                                drop_str(var)
                                return
            typ: expr(rhs)
            storev(var)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if starts(rhs, "_sov_strlen(") is 1
                if did_stos is 1
                    if kv > 0
                        kn: var
        return
    if same(s, "return") is 1
        if in_main_now is 1
            emit(49)
            emit(255)
            emit(106)
            emit(60)
            emit(88)
            sysc()
            return
        if fw_on is 1
            if no_frame is 0
                canary_check()
                xor_rax()
                restores()
                frame_wipe()
                emit(201)
                ret()
                return
        xor_rax()
        leave()
        ret()
        return
    if starts(s, "return ") is 1
        typ: expr(cut(s, 7, length(s)))
        if typ is 1
            saw_str: 1
        if in_main_now is 1
            emit(72)
            emit(137)
            emit(199)
            emit(106)
            emit(60)
            emit(88)
            sysc()
            return
        if fw_on is 1
            if no_frame is 0
                canary_check()
                emit(80)
                restores()
                frame_wipe()
                emit(88)
                emit(201)
                ret()
                return
        leave()
        ret()
        return
    if same(s, "stop") is 1
        emit(49)
        emit(255)
        emit(106)
        emit(60)
        emit(88)
        sysc()
        return
    if same(s, "leave") is 1
        # exit the nearest enclosing loop: one jump straight to its
        # join, recorded on the block's bx list and patched when the
        # loop pops. Replaces the flag-the-limit exit trick, which
        # paid a store, a jump back and a full limit re-check.
        # Walking past a try or except is refused: the jump would
        # strand the error frame on the stack. cflush_all first: a
        # pending constant must sit in memory before the exit path
        # reaches the join, the while arms already flush at the head
        # and forever never had a forward exit before leave.
        ld: _sov_list_len(bk) - 1
        lfound: 0
        lbad: 0
        as long as ld > 0 - 1
            lkind: _sov_list_get(bk, ld)
            if same(lkind, "try") is 1
                lbad: 1
                ld: 0 - 1
            if not
                if same(lkind, "except") is 1
                    lbad: 1
                    ld: 0 - 1
                if not
                    if same(lkind, "while") is 1
                        lfound: ld + 1
                        ld: 0 - 1
                    if not
                        if same(lkind, "forever") is 1
                            lfound: ld + 1
                            ld: 0 - 1
                        if not
                            if same(lkind, "repeat") is 1
                                lfound: ld + 1
                                ld: 0 - 1
                            if not
                                ld: ld - 1
        if lbad is 1
            print "Error: leave cannot cross try"
            _sov_print(s)
            print err_line
            had_err: 1
            return
        if lfound is 0
            print "Error: leave needs a loop around it"
            _sov_print(s)
            print err_line
            had_err: 1
            return
        ld: lfound - 1
        cflush_all()
        lx: _sov_list_get(bx, ld)
        lx: _sov_list_add(lx, jmp())
        bx: _sov_list_set(bx, ld, lx)
        return
    if look(s, "(") < 0
        print "Error: bad line"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    # a bare call's value dies with the statement: try_scaled_mem
    # takes the flag and clears it before any argument evaluates
    val_dead: 1
    expr(s)
    val_dead: 0
emit_sumsq_closed acc iv lim:
    # sum of iv*iv for iv in 0..lim-1 = n(n-1)(2n-1)/6, taken mod
    # 2^64 exactly like the loop's wrapping accumulate. fires only
    # for a constant lim below 2^31: then i*i never overflows a
    # signed 64-bit (no trap difference), the exact value fits in
    # 93 bits, and the two-limb mul below lands the low 64 bits.
    limn: 0
    if same(lim, kn) is 1
        if kv > 0
            limn: kv
    if limn is 0
        if length(lim) > 0
            if digit(letter(lim, 0)) is 1
                if look(lim, " ") < 0
                    limn: _sov_atoi(lim)
    if limn < 1
        return
    if limn > 2147483647
        return
    nn: limn
    cc: nn * 2 - 1
    e: nn * nn - nn
    e: e / 2
    # exactly one of nn, nn - 1, cc is a multiple of three; pull
    # the /3 out of whichever it is, keeping every step exact
    g: e
    h: cc
    if cc % 3 is 0
        h: cc / 3
    if not
        if nn % 3 is 0
            g: e / 3
        if not
            g: e / 3
            h: cc
    # (3 and 2 are coprime, so e carries the 3 whenever 3 divides
    # n or n-1; every step above stays exact)
    gl: g % 4294967296
    gh: g / 4294967296
    total: gl * h
    hi: gh * h
    hi: hi % 4294967296
    hi: hi * 4294967296
    total: total + hi
    # pass 106: register the folded value instead of emitting it - a
    # print of the accumulator folds to a literal write, and an
    # accumulator nobody reads costs nothing at all
    cset(acc, total)
    rax_imm(limn)
    storev(iv)
    kn: acc
    kv: total
    return
emit_sum_closed acc iv lim:
    limn: 0
    if same(lim, kn) is 1
        if kv > 0
            limn: kv
    if limn is 0
        if length(lim) > 0
            if digit(letter(lim, 0)) is 1
                if look(lim, " ") < 0
                    limn: _sov_atoi(lim)
    if limn > 0
        if limn < 2147483648
            total: limn * limn - limn
            total: total / 2
            rax_imm(total)
        storev(acc)
        rax_imm(limn)
        storev(iv)
        kn: acc
        kv: total
        return
    emit_name_or_imm(lim)
    push_rax()
    loadv(iv)
    mov_rcx_rax()
    pop_rax()
    sub_rax_rcx()
    test_rax()
    sk: jle()
    push_rax()
    loadv(iv)
    push_rax()
    emit_name_or_imm(lim)
    mov_rcx_rax()
    pop_rax()
    add_rax_rcx()
    emit(72)
    emit(255)
    emit(200)
    pop_rcx()
    imul_rax_rcx()
    emit(72)
    emit(209)
    emit(232)
    mov_rcx_rax()
    loadv(acc)
    add_rax_rcx()
    storev(acc)
    emit_name_or_imm(lim)
    storev(iv)
    patch(sk)
try_alloc_imm var rhs:
    if starts(rhs, "_sov_alloc(") is 0
        return 0
    if same(var, skip_al) is 1
        return 1
    # pass 107: a literal-size alloc straight under main becomes a
    # static block past the file image (bss). _sov_alloc is then never
    # called, dce drops it with the whole heap, and the block costs no
    # file bytes - the same trick the hand asm twins use with .lcomm.
    # loops raise br_depth, so a block can never be handed out twice.
    if in_main_now is 1
        if br_depth is 0
            if same(letter(rhs, length(rhs) - 1), ")") is 1
                inn: strip(cut(rhs, 11, length(rhs) - 1))
                asz: 0
                if same(inn, kn) is 1
                    if kv > 0
                        asz: kv
                if asz is 0
                    if length(inn) > 0
                        if digit(letter(inn, 0)) is 1
                            if look(inn, " ") < 0
                                asz: _sov_atoi(inn)
                if asz > 0
                    emit(72)
                    emit(184)
                    sa: here()
                    emit8(0)
                    addp(sa, "sbss", i2s(_sov_list_len(sbss_sizes)))
                    sbss_sizes: _sov_list_add(sbss_sizes, asz)
                    storev(var)
                    return 1
    if has_vm is 0
        if same(letter(rhs, length(rhs) - 1), ")") is 1
            inn: strip(cut(rhs, 11, length(rhs) - 1))
            asz: 0
            if same(inn, kn) is 1
                if kv > 0
                    asz: kv
            if asz is 0
                if length(inn) > 0
                    if digit(letter(inn, 0)) is 1
                        if look(inn, " ") < 0
                            asz: _sov_atoi(inn)
            if asz > 511
                emit_mmap_k(asz)
                storev(var)
                return 1
    return 0
body lines:
    n: _sov_list_len(lines)
    i: 0
    bk: _sov_list_new()
    bi: _sov_list_new()
    bj: _sov_list_new()
    bs: _sov_list_new()
    be: _sov_list_new()
    br: _sov_list_new()
    bx: _sov_list_new()
    bw: _sov_list_new()
    sk_pos: _sov_list_new()
    sk_to: _sov_list_new()
    as long as i < n
        raw: _sov_list_get(lines, i)
        s: strip(raw)
        err_line: i + 1
        if _sov_list_len(stmt_lns) > i
            err_line: _sov_list_get(stmt_lns, i)
        ind: nind(raw)
        if length(s) is 0
            i: i + 1
        if not
            if starts(s, "#") is 1
                i: i + 1
            if not
                isel: 0
                if same(s, "if not") is 1
                    isel: 1
                if starts(s, "except") is 1
                    isel: 1
                popgo: 1
                as long as popgo is 1
                    if _sov_list_len(bk) is 0
                        popgo: 0
                    if not
                        last: _sov_list_len(bk) - 1
                        if ind > _sov_list_get(bi, last)
                            popgo: 0
                        if not
                            stay: 0
                            if isel is 1
                                if ind is _sov_list_get(bi, last)
                                    if same(_sov_list_get(bk, last), "if") is 1
                                        stay: 1
                                    if same(_sov_list_get(bk, last), "try") is 1
                                        stay: 1
                            if stay is 1
                                popgo: 0
                            if not
                                popblk()
                loop_ok: 0
                if starts(s, "as long as ") is 1
                    s: join("while ", strip(cut(s, 11, length(s))))
                    loop_ok: 1
                if starts(s, "if ") is 1
                    if same(s, "if not") is 0
                        if starts(s, "if not ") is 0
                            selhit: 0
                            if try_sel_if(cut(s, 3, length(s)), lines, i, ind) is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                                selhit: 1
                            if selhit is 0
                                cflush_all()
                                z: fuse_cmp(cut(s, 3, length(s)), 1)
                                if z is 0 - 1
                                    expr(cut(s, 3, length(s)))
                                    test_rax()
                                    z: jz()
                                bk: _sov_list_add(bk, "if")
                                bw: _sov_list_add(bw, "")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, 0)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                                bx: _sov_list_add(bx, _sov_list_new())
                                br_depth: br_depth + 1
                        if not
                            stmt(s)
                    if not
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                if not
                    if same(s, "\x00__removed_and_if_not") is 1
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                    if not
                        if starts(s, "do while ") is 1
                            bln: collect_body(lines, i + 1, ind)
                            filw: 0
                            if try_opt_while(cut(s, 9, length(s)), bln) is 1
                                filw: 1
                            if not
                                if try_fill_while(cut(s, 9, length(s)), bln, lines, i) is 1
                                    filw: 1
                            if filw is 0
                                if try_count_while(cut(s, 9, length(s)), bln, lines, i) is 1
                                    filw: 1
                            if filw is 0
                                if try_patfill_while(cut(s, 9, length(s)), bln, lines, i) is 1
                                    filw: 1
                            if filw is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                            if not
                                cflush_all()
                                w9: cut(s, 9, length(s))
                                # pass 112: one bare jmp over the body to
                                # the bottom re-test; the head compare is
                                # gone and the first lap guards at the
                                # test like every other lap
                                z: jmp()
                                align32()
                                st: here()
                                bk: _sov_list_add(bk, "while")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, st)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                                bx: _sov_list_add(bx, _sov_list_new())
                                bw: _sov_list_add(bw, w9)
                                br_depth: br_depth + 1
                        if not
                            if loop_ok is 1
                                bln: collect_body(lines, i + 1, ind)
                                filw: 0
                                if try_opt_while(cut(s, 6, length(s)), bln) is 1
                                    filw: 1
                                if not
                                    if try_fill_while(cut(s, 6, length(s)), bln, lines, i) is 1
                                        filw: 1
                                if filw is 0
                                    if try_count_while(cut(s, 6, length(s)), bln, lines, i) is 1
                                        filw: 1
                                if filw is 0
                                    if try_patfill_while(cut(s, 6, length(s)), bln, lines, i) is 1
                                        filw: 1
                                if filw is 1
                                    i: skip_body(lines, i + 1, ind)
                                    i: i - 1
                                if not
                                    cflush_all()
                                    w6: cut(s, 6, length(s))
                                    z: jmp()
                                    align32()
                                    st: here()
                                    bk: _sov_list_add(bk, "while")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, z)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                    bx: _sov_list_add(bx, _sov_list_new())
                                    bw: _sov_list_add(bw, w6)
                                    br_depth: br_depth + 1
                            if not
                                if same(s, "do forever") is 1
                                    # flush deferred constants ahead of the
                                    # head, like the while arms already do:
                                    # a first-use flush inside the body lands
                                    # past st and re-materialises the old
                                    # value every lap (the loop counter never
                                    # advanced - the loop ran forever)
                                    cflush_all()
                                    align32()
                                    st: here()
                                    bk: _sov_list_add(bk, "forever")
                                    bw: _sov_list_add(bw, "")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, 0 - 1)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                    bx: _sov_list_add(bx, _sov_list_new())
                                    br_depth: br_depth + 1
                                if not
                                    if starts(s, "\x00__removed_repeat ") is 1
