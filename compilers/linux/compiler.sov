            cur_ln: _sov_list_new()
            in_t: 1
        if not
            if nind(raw) = 0
                gok: 0
                gc: find_col(s)
                if gc > 0
                    if gc < length(s) - 1
                        gok: 1
                if gok = 1
                    gn: blank
                    if starts(s, "<-- ") = 1
                        rest: cut(s, 4, length(s))
                        t: find_sep(rest)
                        if t > 0 - 1
                            gn: repl(strip(cut(rest, 0, t)), " ", "_")
                    if not
                        gn: repl(strip(cut(s, 0, gc)), " ", "_")
                    if length(gn) > 0
                        if idx(names, gn) < 0
                            if idx(global_names, gn) = 0 - 1
                                global_names: _sov_list_add(global_names, gn)
                        if not
                            grhs0: strip(cut(s, gc + 1, length(s)))
                            keepg: 0
                            if is_imm(grhs0) = 1
                                keepg: 1
                            if look(grhs0, "(") > 0 - 1
