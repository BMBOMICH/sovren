                            chi: chi + 1
                        guard_holes: 0
                    if same(nm, "main") = 1
                        if needs_private = 1
                            emit_stack_wipe
                        bytes:
                            49
                            255
                        if last_was_small = 1
                            bytes:
                                176
                                60
                        if not
                            emit_sys_num(60)
                        emit_sys_do
                    if not
                        # the fib fast path ends in its own leave/ret;
                        # a second epilogue here would be dead bytes
                        if isfib = 0
                            if frame_done = 0
                                xor_rax
                                restore_frame
                                ret
        fi: fi + 1
    if needs_heap = 0
        emit_used
    # pass S5: the canary stub rides even when the program ships
    # its own runtime (needs_heap), because private frames can appear
    # in either shape
    if used_guard = 1
        emit_canary_fail
    if needs_private = 1
        emit_crash_handler
    warn_unused
    dce
    stub_diet
    dce_stores
    dce_litter
    dce_globals
stub_diet:
    if saw_error = 1
        return
    if needs_args = 0
        return
    # a private program's exit walk anchors on g_argv - the capture
    # block = live even when nothing else reads it (pass 137: the
    # splice also dragged main into the program-header overlay)
    if needs_private = 1
        return
    sd_live: 0
    sd_i: 0
    as long as sd_i < _sov_list_len(patch_kind)
        sd_at2: _sov_list_get(patch_at, sd_i)
        if sd_at2 >= 41
            sd_k: _sov_list_get(patch_kind, sd_i)
            if same(sd_k, "glob") = 1
                sd_v: _sov_list_get(patch_value, sd_i)
                if same(sd_v, "g_argc") = 1
                    sd_live: 1
                if same(sd_v, "g_argv") = 1
                    sd_live: 1
            if same(sd_k, "grel") = 1
                sd_v: _sov_list_get(patch_value, sd_i)
                if same(sd_v, "g_argc") = 1
                    sd_live: 1
                if same(sd_v, "g_argv") = 1
                    sd_live: 1
        sd_i: sd_i + 1
    if sd_live = 1
        return
    sd_cut_at: 0
    sd_cut: 41
    if top_params > 0
        sd_cut_at: 15
        sd_cut: 26
    sd_na: _sov_list_new()
    sd_nk: _sov_list_new()
    sd_nv: _sov_list_new()
    sd_nl: _sov_list_new()
    sd_i: 0
    as long as sd_i < _sov_list_len(patch_at)
        sd_at: _sov_list_get(patch_at, sd_i)
        if sd_at < sd_cut_at
            sd_na: _sov_list_add(sd_na, sd_at)
            sd_nk: _sov_list_add(sd_nk, _sov_list_get(patch_kind, sd_i))
            sd_nv: _sov_list_add(sd_nv, _sov_list_get(patch_value, sd_i))
            sd_nl: _sov_list_add(sd_nl, _sov_list_get(patch_line, sd_i))
        if not
            if sd_at >= 41
                sd_na: _sov_list_add(sd_na, sd_at - sd_cut)
                sd_nk: _sov_list_add(sd_nk, _sov_list_get(patch_kind, sd_i))
                sd_nv: _sov_list_add(sd_nv, _sov_list_get(patch_value, sd_i))
                sd_nl: _sov_list_add(sd_nl, _sov_list_get(patch_line, sd_i))
        sd_i: sd_i + 1
    patch_at: sd_na
    patch_kind: sd_nk
    patch_value: sd_nv
    patch_line: sd_nl
    sd_no: _sov_list_new()
    sd_pos: 0
    as long as sd_pos < _sov_list_len(code)
        if sd_pos = sd_cut_at
            sd_pos: sd_pos + sd_cut
        if not
            sd_no: _sov_list_add(sd_no, _sov_list_get(code, sd_pos))
            sd_pos: sd_pos + 1
    code: sd_no
    sd_i: 0
    as long as sd_i < _sov_list_len(task_at)
        task_at: _sov_list_set(task_at, sd_i, _sov_list_get(task_at, sd_i) - sd_cut)
        sd_i: sd_i + 1
    needs_args: 0
# Pass 105: a global whose every surviving reference = a plain
# store_glob (mov [rip],rax - 48 89 05 <rel32>) = write-only: no load,
# compare or add-to-memory ever observes the value. Paint the store
# bytes with one-byte nops IN PLACE - raw branch displacements (rel8
# and post-relaxation rel32) are baked into the byte stream and must
# not move - and drop the store's grel patch so dce_globals collects
# the 8-byte name. Every other reference shape (loads 48 8b .., movabs
# "glob" forms, lea forms, anything else) counts as a read and
# protects the name.
poke2 p off v:
    dummy: _sov_set_byte(p, off, v % 256)
    dummy: _sov_set_byte(p, off + 1, (v / 256) % 256)
write_program path:
    if saw_error = 1
        return
    clen: _sov_list_len(code)
    sl: _sov_buf_len(letters)
    # pass S2: the READ+EXECUTE LOAD holds headers and code, nothing
    # else. the READ+WRITE LOAD starts on the next page and holds
    # the literals (they are data: user code may wipe a literal at
    # any moment) and then the globals. the e_ident rider = gone -
    # every literal lives in writable, never-executable memory.
    gfoff: header_size + clen
    as long as gfoff % 4096 is not 0
        gfoff: gfoff + 1
    sl8: sl
    as long as sl8 % 8 is not 0
        sl8: sl8 + 1
    str_off: gfoff - header_size
    str_foff: gfoff
    str_addr: load_at + gfoff
    # pass S7: every absolute qword the code carries = listed in
    # the table; _start adds the slide to each before main runs.
    # the count = known by walking the patch list once before any
    # address = chosen, because the table's own size moves the
    # globals - a second pass collects as it patches
    rel_off: gfoff + sl8
    rel_n: 0
    rc_i: 0
    as long as rc_i < _sov_list_len(patch_at)
        rk: _sov_list_get(patch_kind, rc_i)
        if same(rk, "task_address") = 1
            rel_n: rel_n + 1
        if same(rk, "str") = 1
            rel_n: rel_n + 1
        if same(rk, "glob") = 1
            rel_n: rel_n + 1
        if same(rk, "gwstr_a") = 1
            rel_n: rel_n + 1
        if same(rk, "gwipe_a") = 1
            rel_n: rel_n + 1
        if same(rk, "sbss") = 1
            rel_n: rel_n + 1
        rc_i: rc_i + 1
    relsz: 8 + rel_n * 8
    glob_off: rel_off + relsz - header_size
    pad: _sov_list_len(global_names) * 8
    filesz: rel_off + relsz + pad
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    dummy: _sov_set_byte(flat, 0, 127)
    dummy: _sov_set_byte(flat, 1, 69)
    dummy: _sov_set_byte(flat, 2, 76)
    dummy: _sov_set_byte(flat, 3, 70)
    dummy: _sov_set_byte(flat, 4, 2)
    dummy: _sov_set_byte(flat, 5, 1)
    dummy: _sov_set_byte(flat, 6, 1)
    # pass S7: type DYN - the kernel chooses the load address; the
    # entry stays image-absolute because the bias excludes p_vaddr
    poke2(flat, 16, 3)
    poke2(flat, 18, 62)
    poke4(flat, 20, 1)
    moff: 0
    if tiny_program = 1
        mi: idx(task_names, "main")
        if mi > 0 - 1
            moff: _sov_list_get(task_at, mi)
    # pass S7: the entry = the start of the _start block itself.
    # the entry must never point straight at a thin main's body:
    # that would skip the relocation walk that runs first
    poke8(flat, 24, load_at + header_size)
    poke8(flat, 32, 64)
    poke2(flat, 52, 64)
    poke2(flat, 54, 56)
    poke2(flat, 56, 3)
    poke4(flat, 64, 1)
    poke8(flat, 80, load_at)
    poke8(flat, 88, load_at)
    poke8(flat, 96, gfoff)
    sbtot: 0
    sw: 0
    as long as sw < _sov_list_len(static_sizes)
        swv: _sov_list_get(static_sizes, sw)
        sbtot: sbtot + 15
        sbtot: sbtot - sbtot % 16
        sbtot: sbtot + swv
        sw: sw + 1
    # pass S1 kept the old single-segment shape; S2 splits it:
    # seg1 above = READ+EXECUTE only
    poke4(flat, 68, 5)
    poke8(flat, 104, gfoff)
    poke8(flat, 112, 4096)
    # seg2: the globals page(s), READ+WRITE, never EXECUTE
    poke4(flat, 120, 1)
    poke4(flat, 124, 6)
    poke8(flat, 128, gfoff)
    poke8(flat, 136, load_at + gfoff)
    poke8(flat, 144, load_at + gfoff)
    poke8(flat, 152, sl8 + relsz + pad)
    poke8(flat, 160, sl8 + relsz + pad + sbtot + 65536)
    poke8(flat, 168, 4096)
    # PT_GNU_STACK = 0x6474E551, READ|WRITE, never EXECUTE
    poke4(flat, 176, 1685382481)
    poke4(flat, 180, 6)
    poke8(flat, 224, 16)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, header_size + i,  _sov_list_get(code, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, str_foff + si, _sov_buf_at(letters, si))
        si: si + 1
    glob_addr: load_at + header_size + glob_off
    reloc_at: 0
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_value, i)
        if same(kind, "rel") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(task_at, fi)
                rel: tgt - (at + 4)
                poke4(flat, header_size + at, rel)
            if not
                print "Error: no such task" : val
                error_line: _sov_list_get(patch_line, i)
                err_where
                suggest_name(val)
                saw_error: 1
        if same(kind, "task_address") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                poke8(flat, header_size + at, load_at + header_size + _sov_list_get(task_at, fi))
                reloc_at: _sov_list_add(reloc_at, at)
            if not
                print "Error: no such task" : val
                saw_error: 1
        if same(kind, "str") = 1
            poke8(flat, header_size + at, str_addr + val)
            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "str32") = 1
            poke4(flat, header_size + at, str_addr + val)
        if same(kind, "grel") = 1
            gx: idx(global_names, val)
            poke4(flat, header_size + at, glob_addr + gx * 8 - (load_at + header_size + at + 4))
        if same(kind, "glob") = 1
            gx: idx(global_names, val)
            poke8(flat, header_size + at, glob_addr + gx * 8)
            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "gwstr_a") = 1
            poke8(flat, header_size + at, str_addr)
            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "gwstr_n") = 1
            poke4(flat, header_size + at, (sl + 7) / 8)
        if same(kind, "gwipe_a") = 1
            poke8(flat, header_size + at, glob_addr)
            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "gwipe_n") = 1
            gbytes: _sov_list_len(global_names) * 8 + sbtot
            poke4(flat, header_size + at, (gbytes + 7) / 8)
        if same(kind, "sbss") = 1
            # static blocks live past the file image, each 16-aligned
            bi: _sov_atoi(val)
            baddr: glob_addr + _sov_list_len(global_names) * 8
            bj: 0
            as long as bj < bi
                bs: _sov_list_get(static_sizes, bj)
                baddr: baddr + 15
                baddr: baddr - baddr % 16
                baddr: baddr + bs
                bj: bj + 1
            baddr: baddr + 15
            baddr: baddr - baddr % 16
            poke8(flat, header_size + at, baddr)
            reloc_at: _sov_list_add(reloc_at, at)
        i: i + 1
    if saw_error = 1
        return
    # pass S7: the table itself, then the two holes in _start and
    # the self pointer g_slide carries at link time
    if rel_n > 0
        poke8(flat, rel_off, rel_n)
        ri: 0
        as long as ri < rel_n
            poke8(flat, rel_off + 8 + ri * 8, header_size + _sov_list_get(reloc_at, ri))
            ri: ri + 1
    if 1 = 1
        sxi: 0
        as long as sxi < _sov_list_len(patch_at)
            if same(_sov_list_get(patch_kind, sxi), "rel_a") = 1
                poke8(flat, header_size + _sov_list_get(patch_at, sxi), load_at + rel_off)
            if same(_sov_list_get(patch_kind, sxi), "rel_n") = 1
                poke4(flat, header_size + _sov_list_get(patch_at, sxi), rel_n)
            if same(_sov_list_get(patch_kind, sxi), "rel_l") = 1
                poke8(flat, header_size + _sov_list_get(patch_at, sxi), gfoff)
            sxi: sxi + 1
    gsx: idx(global_names, "g_slide")
    if gsx > 0 - 1
        poke8(flat, rel_off + relsz + gsx * 8, glob_addr + gsx * 8)

    w: _sov_write_n(path, flat, filesz)
    if w = 0
        print "Error: cannot write output (is it running?)"
        fail
    if needs_private = 1
        # pass 140: a private program's binary carries its secrets -
        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
    # the line map for --debug, written inline (see the note at the
    # hook in stmt: this code must not live in a separate task).
    if debug_on = 1
        if debug_at is not 0
            dig: "0123456789"
            m: "# first_user_line "
            sv: first_user_line
            st: blank
            sg: 1
            as long as sg = 1
                st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                sv: sv / 10
                if sv = 0
                    sg: 0
            m: join(m, st)
            mi: 0
            as long as mi < _sov_list_len(debug_at)
                pc: _sov_list_get(debug_at, mi)
                ln: _sov_list_get(debug_lines, mi)
                sv: pc + header_size
                st: blank
                sg: 1
                as long as sg = 1
                    st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                    sv: sv / 10
                    if sv = 0
                        sg: 0
                m: join(m, "\n")
                m: join(m, st)
                sv: ln
                st: blank
                sg: 1
                as long as sg = 1
                    st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                    sv: sv / 10
                    if sv = 0
                        sg: 0
                m: join(m, " ")
                m: join(m, st)
                mi: mi + 1
            m: join(m, "\n")
            file_write_all(join(path, ".map"), m)

# ---- the three dev flags: --fmt, --run, --debug -------------------
# --debug's recording and map writing live inline in stmt and
# write_program (not in separate tasks): at some source layouts the
# compiler's frame handling breaks for such tasks called from those
# two hot functions; the inline form sidesteps it. see HANDOFF.

# indent_of counts leading blanks as the column width they occupy;
# a tab = four. strip_trail chomps trailing blanks.

indent_of t:
    n: length(t)
    i: 0
    w: 0
    as long as i < n
        b: peek_byte(t, i)
        if b = 32
            w: w + 1
        if not
            if b = 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w

strip_trail t:
    n: length(t)
    as long as n > 0
        b: peek_byte(t, n - 1)
        if b = 32
            n: n - 1
        if not
            if b = 9
                n: n - 1
            if not
                return cut(t, 0, n)
    return blank

space_make n:
    s: blank
    i: 0
    as long as i < n
        s: join(s, " ")
        i: i + 1
    return s

# --fmt rewrites a source file in place, touching nothing but
# whitespace: trailing blanks come off, and indentation snaps to the
# file's own unit (the more common of 2 and 4). it = provably safe -
# the battery checks that fmt = idempotent and that a formatted file
# builds byte-identical to the original.

fmt_file path:
    s: load_file(path)
    if s = 0
        print "Error: cannot read input"
        fail
    ls: lines_of(s)
    n2: 0
    n4: 0
    i: 0
    as long as i < _sov_list_len(ls)
        ind: indent_of(_sov_list_get(ls, i))
        if ind > 1
            if ind % 4 = 0
                n4: n4 + 1
            if not
                n2: n2 + 1
        i: i + 1
    unit: 4
    if n2 > n4
        unit: 2
    i: 0
    out: blank
    as long as i < _sov_list_len(ls)
        t: _sov_list_get(ls, i)
        t: strip_trail(t)
        ind: indent_of(t)
        if ind > 0
            rest: cut(t, ind, length(t))
            q: ind / unit
            if (ind % unit) * 2 >= unit
                q: q + 1
            if q < 1
                q: 1
            t: join(space_make(q * unit), rest)
        if i = 0
            out: t
        if not
            out: join(join(out, "\n"), t)
        i: i + 1
    if file_write_all(path, out) = 0
        print "Error: cannot write" : path
        fail
    print "Formatted" : path
    return 1

# --run: after a clean build, fork; the child becomes the program,
# the parent waits and relays its exit code. the program gets the
# command line minus the compiler's own flags.

run_program path argv how_many:
    pid: sys_fork()
    if pid = 0
        argv2: _sov_alloc(512)
        poke_i64(argv2, 0, path)
        k: 1
        i: 1
        as long as i < how_many
            a: peek_ptr(argv, i)
            keep: 1
            if same(a, "-o") = 1
                keep: 0
                i: i + 1
            if not
                if same(a, "--run") = 1
                    keep: 0
                if not
                    if same(a, "--fmt") = 1
                        keep: 0
                    if not
                        if same(a, "--debug") = 1
                            keep: 0
                        if not
                            if same(a, "--bare") = 1
                                keep: 0
                            if not
                                if same(a, path) = 1
                                    keep: 0
            if keep = 1
                poke_i64(argv2, k * 8, a)
                k: k + 1
            i: i + 1
        poke_i64(argv2, k * 8, 0)
        sys_exec(path, argv2, 0)
        sys_exit(127)
    w: sys_wait(pid)
    sys_exit(w / 256)

find_runtime:
    r: load_file("runtime.sov")
    if r = 0
        r: load_file("linux/runtime.sov")
    if r = 0
        r: load_file(join(compiler_folder, "/runtime.sov"))
    if r = 0
        r: load_file(join(compiler_folder, "/../runtime.sov"))
    if r = 0
        r: load_file(join(dirname(dirname(compiler_folder)), "/runtime.sov"))
    return r

# where this compiler lives, so library and runtime are found
# no matter which folder you run it from
start:
    compiler_folder: dirname(tidy_path(peek_ptr(g_argv, 0)))
    debug_at: _sov_list_new()
    debug_lines: _sov_list_new()
    if g_argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail
    in_file: blank
    out_file: blank
    i: 1
    as long as i < g_argc
        arg: peek_ptr(g_argv, i)
        if same(arg, "--bare") = 1
            no_runtime: 1
        if not
            if same(arg, "--run") = 1
                run_after: 1
            if not
                if same(arg, "--fmt") = 1
                    format_only: 1
                if not
                    if same(arg, "--debug") = 1
                        debug_on: 1
                    if not
                        if same(arg, "-o") = 1
                            i: i + 1
                            if i < g_argc
                                out_file: peek_ptr(g_argv, i)
                        if not
                            if same(arg, "build") = 0
                                in_file: arg
        i: i + 1
    if length(in_file) = 0
        print "Error: no input"
        fail
    if format_only = 1
        fmt_file(in_file)
        sys_exit(0)
    if length(out_file) = 0
        if holds(in_file, ".sov") = 1
            out_file: cut(in_file, 0, look(in_file, ".sov"))
        if not
            out_file: join(in_file, ".out")
    file_name: in_file
    print "Compiling" : in_file
    src: load_file(in_file)
    if src = 0
        print "Error: cannot read input"
        fail
    newline: "\n"
    src: join("# skip this line\n", src)
    libraries: blank
    src: expand_use_lines(src)
    pulled: pull_uses(src)
    more: pull_uses(pulled)
    as long as length(more) > 0
        pulled: join(pulled, more)
        more: pull_uses(more)
    if length(pulled) > 0
        src: join(pulled, src)
    runtime: blank
    heap_size: 12582912
    if no_runtime = 0
        if uses_runtime(src) = 1
            heap_size: 1073741824
            runtime: find_runtime()
            if runtime = 0
                print "Error: cannot read runtime"
                fail
            runtime: join(runtime, "\n_sov_thread_exit:\n    syscall(60, 0, 0, 0, 0, 0, 0)\n    return 0 - 1\n")
    first_user_line: 2 + list_len(lines_of(runtime)) + list_len(lines_of(pulled))
    whole: join(runtime, join(newline, src))
    compile(whole)
    write_program(out_file)
    if saw_error = 1
        fail
    print "Wrote" : out_file
    if run_after = 1
        run_program(out_file, g_argv, g_argc)
start
