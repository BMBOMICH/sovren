sysc:
    emit(15)
    emit(5)

call_args name argc direct:
    # the stack pointer, for code that needs to find itself: the
    # thread entry derives its control block from it
    if same(name, "sp") is 1
        emit(72)
        emit(137)
        emit(224)
        return
    # cfunc(addr, a1..a6) calls a C function at a computed address.
    # C wants its arguments in rdi rsi rdx rcx r8 r9 and the stack
    # aligned to 16 bytes, and rax cleared for a variadic callee.
    if same(name, "cfunc") is 1
        # args pop to their C registers; the call target swaps into
        # r10 from the stack, parking the caller's r10 under it.
        # r11 is never touched.
        emit(65)
        emit(89)
        emit(65)
        emit(88)
        emit(89)
        emit(90)
        emit(94)
        emit(95)
        emit(76)
        emit(135)
        emit(20)
        emit(36)
        emit(85)
        emit(72)
        emit(137)
        emit(229)
        emit(72)
        emit(131)
        emit(228)
        emit(240)
        emit(49)
        emit(192)
        emit(65)
        emit(255)
        emit(210)
        emit(72)
        emit(137)
        emit(236)
        emit(93)
        emit(65)
        emit(90)
        return
    if same(name, "syscall") is 1
        # pop exactly the values that were pushed, highest position
        # first: a7->r9, a6->r8, a5->rcx, a4->rdx, a3->rsi,
        # a2->rdi, a1(num)->rax. the kernel wants arg4 in r10, so
        # a5 parks in rcx and moves at the last moment with the
        # caller's r10 saved around the whole sequence. r11 is
        # never touched. (the old code always popped seven; the
        # four-value print syscalls survived only because their
        # rbp frames absorbed three slots of drift.)
        sy: argc
        if sy > 7
            sy: 7
        if sy > 6
            emit(65)
            emit(89)
        if sy > 5
            emit(65)
            emit(88)
        if sy > 4
            emit(89)
        if sy > 3
            emit(90)
        if sy > 2
            emit(94)
        if sy > 1
            emit(95)
        pop_rax()
        if argc > 4
            emit(65)
            emit(82)
            emit(73)
            emit(137)
            emit(202)
            sysc()
            emit(65)
            emit(90)
        if not
            sysc()
        return
    if direct is 0
        if argc is 1
            pop_rax()
            mov_rdi_rax()
        if not
            if argc is 2
                emit(94)
                pop_rax()
                mov_rdi_rax()
            if not
                if argc is 3
                    emit(90)
                    emit(94)
                    pop_rax()
                    mov_rdi_rax()
                if not
                    if argc is 4
                        emit(89)
                        emit(90)
                        emit(94)
                        pop_rax()
                        mov_rdi_rax()
                    if not
                        if argc is 5
                            emit(65)
                            emit(88)
                            emit(89)
                            emit(90)
                            emit(94)
                            pop_rax()
                            mov_rdi_rax()
                        if not
                            if argc is 6
                                emit(65)
                                emit(89)
                                emit(65)
                                emit(88)
                                emit(89)
                                emit(90)
                                emit(94)
                                pop_rax()
                                mov_rdi_rax()
                            if not
                                if argc is 7
                                    emit(65)
                                    emit(90)
                                    emit(65)
                                    emit(89)
                                    emit(65)
                                    emit(88)
                                    emit(89)
                                    emit(90)
                                    emit(94)
                                    pop_rax()
                                    mov_rdi_rax()

    if same(name, "_sov_alloc") is 1
        used_al: 1
    if same(name, "_sov_strlen") is 1
        used_sl: 1
    if same(name, "_sov_str_eq") is 1
        used_eq: 1
    if same(name, "syscall") is 1
        # pop exactly the values that were pushed, highest position
        # first: a7->r9, a6->r8, a5->rcx, a4->rdx, a3->rsi,
        # a2->rdi, a1(num)->rax. the kernel wants arg4 in r10, so
        # a5 parks in rcx and moves at the last moment with the
        # caller's r10 saved around the whole sequence. r11 is
        # never touched. (the old code always popped seven; the
        # four-value print syscalls survived only because their
        # rbp frames absorbed three slots of drift.)
        sy: argc
        if sy > 7
            sy: 7
        if sy > 6
            emit(65)
            emit(89)
        if sy > 5
            emit(65)
            emit(88)
        if sy > 4
            emit(89)
        if sy > 3
            emit(90)
        if sy > 2
            emit(94)
        if sy > 1
            emit(95)
        pop_rax()
        if argc > 4
            emit(65)
            emit(82)
            emit(73)
            emit(137)
            emit(202)
            sysc()
            emit(65)
            emit(90)
        if not
            sysc()
        return
    if same(name, "port_out8") is 1
        emit(72)
        emit(137)
        emit(248)
        emit(137)
        emit(214)
        emit(137)
        emit(240)
        emit(72)
        emit(137)
        emit(250)
        emit(137)
        emit(208)
        emit(238)
        return
    if same(name, "port_in8") is 1
        emit(72)
        emit(137)
        emit(250)
        emit(49)
        emit(192)
        emit(236)
        return
    if same(name, "hlt") is 1
        emit(244)
        return
    if same(name, "cli") is 1
        emit(250)
        return
    if same(name, "sti") is 1
        emit(251)
        return
    if same(name, "peek_raw8") is 1
        emit(72)
        emit(15)
        emit(182)
        emit(4)
        emit(55)
        return
    if same(name, "peek_raw64") is 1
        emit(72)
        emit(139)
        emit(4)
        emit(55)
        return
    if same(name, "poke_raw8") is 1
        emit(136)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "poke_raw64") is 1
        emit(72)
        emit(137)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "peek_byte") is 1
        chk_mem(1)
        emit(72)
        emit(15)
        emit(182)
        emit(4)
        emit(55)
        return
    if same(name, "peek_i64") is 1
        chk_mem(8)
        emit(72)
        emit(139)
        emit(4)
        emit(55)
        return
    if same(name, "peek_ptr") is 1
        chk_mem(8)
        emit(72)
        emit(139)
        emit(4)
        emit(247)
        return
    if same(name, "poke_byte") is 1
        chk_mem(1)
        emit(136)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "poke_i64") is 1
        chk_mem(8)
        emit(72)
        emit(137)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "band") is 1
        mov_rax_rsi()
        emit(72)
        emit(33)
        emit(248)
        return
    if same(name, "bor") is 1
        mov_rax_rsi()
        emit(72)
        emit(9)
        emit(248)
        return
    if same(name, "bxor") is 1
        mov_rax_rsi()
        emit(72)
        emit(49)
        emit(248)
        return
    if same(name, "bshl") is 1
        mov_rcx_rsi()
        mov_rax_rdi()
        emit(72)
        emit(211)
        emit(224)
        return
    if same(name, "bshr") is 1
        mov_rcx_rsi()
        mov_rax_rdi()
        emit(72)
        emit(211)
        emit(232)
        return
    if same(name, "bsar") is 1
        mov_rcx_rsi()
        mov_rax_rdi()
        emit(72)
        emit(211)
        emit(248)
        return
    if same(name, "_sov_mem_copy") is 1
        mov_rax_rdi()
        mov_rcx_rdx()
        emit(243)
        emit(164)
        return
    if same(name, "_sov_mem_set") is 1
        # rep stosb takes its byte from al, so rax is busy for the
        # whole fill and rdi walks off the end of the block. The
        # destination is what a caller wants back - everyone writes
        # mem_zero(mem_new(n), n) - so park it on the stack and hand
        # it back, the way memset does. Returning the fill value
        # instead handed callers a null pointer.
        emit(87)
        mov_rax_rsi()
        mov_rcx_rdx()
        emit(243)
        emit(170)
        emit(88)
        return
    if same(name, "bswap64") is 1
        mov_rax_rdi()
        emit(72)
        emit(15)
        emit(200)
        return
    if same(name, "iabs") is 1
        mov_rax_rdi()
        emit(72)
        emit(247)
        emit(216)
        emit(72)
        emit(15)
        emit(72)
        emit(199)
        return
    # atomics: rdi is the slot, rsi the value, rdx the cas desired.
    # lock xadd/xchg/cmpxchg, verified with as+objdump. rax comes
    # back as the old value, which is what a mutex_swap wants.
    if same(name, "atomic_add") is 1
        mov_rax_rsi()
        emit(240)
        emit(72)
        emit(15)
        emit(193)
        emit(7)
        return
    if same(name, "atomic_swap") is 1
        mov_rax_rsi()
        emit(240)
        emit(72)
        emit(135)
        emit(7)
        return
    if same(name, "atomic_load") is 1
        emit(72)
        emit(139)
        emit(7)
        return
    if same(name, "atomic_store") is 1
        emit(72)
        emit(137)
        emit(55)
        mov_rax_rsi()
        return
    if same(name, "atomic_cas") is 1
        mov_rax_rsi()
        emit(72)
        emit(137)
        emit(214)
        emit(240)
        emit(72)
        emit(15)
        emit(177)
        emit(55)
        return
    calln(name)
# immutable: names declared `immutable name: value` may not be
# assigned again anywhere in the file
im_names: 0
im_skip: 0
