tparams line:
    lst: _sov_list_new()
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            s: strip(cut(s, wp + 6, length(s)))
        if not
            sp: look(s, " ")
            if sp < 0
                return lst
            s: strip(cut(s, sp + 1, length(s)))
        p: repl(s, ",", " ")
        p: repl(p, " and ", " ")
        start: 0
        i: 0
        n: length(p)
        as long as i < n
            if same(letter(p, i), " ") is 1
                one: strip(cut(p, start, i))
                if length(one) > 0
                    lst: _sov_list_add(lst, one)
                start: i + 1
            i: i + 1
        one: strip(cut(p, start, n))
        if length(one) > 0
            lst: _sov_list_add(lst, one)
        return lst
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp < 0
        return lst
    p: repl(cut(rest, wp + 6, length(rest)), ",", " and ")
    start: 0
    i: 0
    n: length(p)
    as long as i < n
        if starts(cut(p, i, n), " and ") is 1
            one: repl(strip(cut(p, start, i)), " ", "_")
            if length(one) > 0
                lst: _sov_list_add(lst, one)
            start: i + 5
            i: i + 5
        if not
            i: i + 1
    one: repl(strip(cut(p, start, n)), " ", "_")
    if length(one) > 0
        lst: _sov_list_add(lst, one)
    return lst
# how many of the five register slots (rbx r12 r13 r14 r15) this
# function uses. Set from the pre-scan before the prolog is
# emitted, so a small function only saves the registers it touches.
fn_save_n: 0
no_frame: 0

prolog:
    if no_frame is 1
        # every local lives in a callee-saved register, so the rbp
        # frame is pure overhead. no pad: callee entry rsp is 8 mod
        # 16, so an ODD number of pushes leaves rsp 16-aligned for
        # the calls inside, and an even number is fine too because
        # nothing in a Sovren program needs 16-byte alignment (the
        # cfunc path aligns itself with and rsp, -16).
        if fn_save_n > 0
            emit(83)
        if fn_save_n > 1
            emit(65)
            emit(84)
        if fn_save_n > 2
            emit(65)
            emit(85)
        if fn_save_n > 3
            emit(65)
            emit(86)
        if fn_save_n > 4
            emit(65)
            emit(87)
        return 0
    emit(85)
    emit(72)
    emit(137)
    emit(229)
    # pushes go lowest slot first: rbx lands at rbp-8, r12 at
    # rbp-16 and so on, which is where leave reads them back
    if fn_save_n > 0
        emit(83)
    if fn_save_n > 1
        emit(65)
        emit(84)
    if fn_save_n > 2
        emit(65)
        emit(85)
    if fn_save_n > 3
        emit(65)
        emit(86)
    if fn_save_n > 4
        emit(65)
        emit(87)
    emit(72)
    emit(129)
    emit(236)
    pro_at: here()
    br_at: _sov_list_add(br_at, pro_at)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, pro_at)
    br_st: _sov_list_add(br_st, 0)
    emit4(512)
    return 0
copyargs n:
    if n > 0
        emit(72)
        emit(137)
        emit(251)
    if n > 1
        emit(73)
        emit(137)
        emit(244)
    if n > 2
        emit(73)
        emit(137)
        emit(213)
    if n > 3
        emit(73)
        emit(137)
        emit(206)
    if n > 4
        emit(77)
        emit(137)
        emit(199)
    if n > 5
        emit(76)
        emit(137)
        emit(200)
        store_loc(5)
    if n > 6
        emit(76)
        emit(137)
        emit(208)
        store_loc(6)
emit_mmap:
    rax_imm(9)
    rdi_imm(0)
    emit(72)
    emit(190)
    emit8(mmap_sz)
    emit(72)
    emit(186)
    emit8(3)
    emit(73)
    emit(186)
    emit8(34)
    emit(73)
    emit(184)
    emit8(0 - 1)
    emit(73)
    emit(185)
    emit8(0)
    sysc()
emit_mmap_k n:
    rax_imm(9)
    emit(49)
    emit(255)
    emit(190)
    emit4(n + 2097152)
    emit(186)
    emit(3)
    emit(0)
    emit(0)
    emit(0)
    emit(65)
    emit(186)
    emit(34)
    emit(0)
    emit(0)
    emit(0)
    emit(73)
    emit(199)
    emit(192)
    emit(255)
    emit(255)
    emit(255)
    emit(255)
    emit(77)
    emit(49)
    emit(201)
    sysc()
    emit(72)
    emit(5)
    emit4(2097151)
    emit(72)
    emit(37)
    emit(0)
    emit(0)
    emit(224)
    emit(255)
    emit(80)
    emit(72)
    emit(137)
    emit(199)
    emit(190)
    emit4(n)
    emit(186)
    emit(14)
    emit(0)
    emit(0)
    emit(0)
    rax_imm(28)
    sysc()
    emit(88)
emit_alloc:
    fn_names: _sov_list_add(fn_names, "_sov_alloc")
    fn_offs: _sov_list_add(fn_offs, here())
    if has_vm is 0
        emit(83)
        emit(72)
        emit(137)
        emit(251)
        emit(72)
        emit(141)
        emit(179)
        emit4(2097160)
        rdi_imm(0)
        emit(72)
        emit(186)
        emit8(3)
        emit(73)
        emit(186)
        emit8(34)
        emit(73)
        emit(184)
        emit8(0 - 1)
        emit(73)
        emit(185)
        emit8(0)
        rax_imm(9)
        sysc()
        if used_tr is 1
            emit(72)
            emit(131)
            emit(192)
