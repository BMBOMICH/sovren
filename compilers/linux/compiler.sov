                            line_of_body: _sov_list_add(line_of_body, cur_ln)
                            in_t: 0
        if th = 1
            if in_t = 1
                cur: expand_bytes(cur)
                bodies: _sov_list_add(bodies, cur)
                line_of_body: _sov_list_add(line_of_body, cur_ln)
            tn: tname(s)
            if same(tn, "main") = 1
                print "Error: main is gone, put the code at the top of the file"
                error_line: file_ln(li)
                err_where
                saw_error: 1
                tn: "_gone_main"
            if idx(names, tn) > 0 - 1
