use cx86

is_mac:
    return 0
is_rel:
    return 1
win_rare:
    return 0

stmt_dbg:
    if dbg_mode is 1
        if oc is not 0
            dbg_pcs: _sov_list_add(dbg_pcs, here())
            dbg_lns: _sov_list_add(dbg_lns, err_line)
    return 0
stmt_reset_small:
    rax_small: 0
    return 0
stmt_mark_print:
    if br_depth is 0
        rax_small: 1
    return 0
stmt_join_op:
    mov_rdi_rax()
    calln("_sov_thread_join")
    return 0
stmt_leave_op:
    emit(201)
    return 0

try_sbss var rhs:
    if in_main_now is 1
        if br_depth is 0
            if same(letter(rhs, length(rhs) - 1), ")") is 1
                inn: strip(cut(rhs, 11, length(rhs) - 1))
                asz: 0
                if same(inn, kn) is 1
                    if kv > 0
                        asz: kv
                if asz is 0
                    if length(inn) > 0
                        if digit(letter(inn, 0)) is 1
                            if look(inn, " ") < 0
                                asz: _sov_atoi(inn)
                if asz > 0
                    emit(72)
                    emit(184)
                    sa: here()
                    emit8(0)
                    addp(sa, "sbss", i2s(_sov_list_len(sbss_sizes)))
                    sbss_sizes: _sov_list_add(sbss_sizes, asz)
                    storev(var)
                    return 1
    return 0
plat_used:
    return 0
plat_canary:
    if can_used is 1
        emit_canary_fail()
    return 0

leave_reload:
    return 0
canary_die:
    emit(191)
    emit4(101)
    emit(176)
    emit(60)
    sysc()
    return 0
spawn_arg ai:
    if ai is 0
        mov_rdi_rax()
    if ai is 1
        mov_rsi_rax()
    if ai is 2
        emit(72)
        emit(137)
        emit(194)
    if ai is 3
        mov_rcx_rax()
    if ai is 4
        emit(73)
        emit(137)
        emit(192)
    if ai is 5
        emit(73)
        emit(137)
        emit(193)
    return 0
spawn_finish name:
    emit(76)
    emit(137)
    emit(200)
    emit(73)
    emit(137)
    emit(194)
    emit(77)
    emit(137)
    emit(193)
    emit(73)
    emit(137)
    emit(200)
    emit(72)
    emit(137)
    emit(209)
    emit(72)
    emit(137)
    emit(242)
    emit(72)
    emit(137)
    emit(254)
    emit(72)
    emit(191)
    fn_at: here()
    emit8(0)
    addp(fn_at, "fnaddr", name)
    calln("_sov_thread_spawn")
    return 0

