emit_stack_wipe:
    # then the stack: pass 131 - after main's body, before the exit
    # syscall, walk downward one page at a time and zero every mapped page -
    # spilled secrets in dead frames do not outlive the process.
    # register-only (no stack slot = ever touched), each page is
    # probed with mincore first - zero means mapped, any error means
    # stop - and the vec byte lands on the page above, which the
    # previous pass already zeroed (or which holds dead argv strings
    # on the first pass). anchor: the running frame's own page.
    # rax ends zeroed so the two-byte mov al,60
    # exit that follows stays correct. branches go through the
    # registered jnz/jmp helpers so the relaxer keeps the targets.
    #   pass 138b: the anchor = rsp itself, page-aligned down -
    #   the same anchor the other four machines use. the old g_argv
    #   slot read tied the wipe to the argv capture stub, and a
    #   thin-main private program skips that stub: the slot read
    #   zero, both walks stopped on their first probe, and nothing
    #   was wiped at all (thin private guests, since pass 131).
    #   from the running frame the up-walk sweeps everything above
    #   it - dead frames, argv, env, auxv - and the down-walk takes
    #   everything below; no slot, no stub dependency, no layout
    #   assumptions.
    bytes:
        72
        137
        231
    #   rdi = rdi & -4096   (the frame's page, aligned down)
    bytes:
        72
        129
        231
    put_4_bytes(4294963200)
    bytes:
        72
        129
        231
    put_4_bytes(4294963200)
    #   rdx = rdi, and it stays: the vec byte for every mincore is
    #   on the anchor page itself - always mapped, always writable
    #   (pass one zeroes it, it stays writable). a vec above or
    #   below the probe walks off the stack top or bottom on the
    #   first or last page and the probe dies with EFAULT.
    bytes:
        72
        137
        250
    # pass 138: r8 keeps the anchor. the up-walk at the end of the
    # wipe will zero everything ABOVE this page - the initial block:
    # argv strings, env strings, auxv, the arrays - probing with
    # mprotect rather than mincore, because a read-only page sitting
    # against the stack top with no gap (vdso) answers mincore
    # "mapped" and then faults the stosq, while mprotect(page,4096,
    # RW) fails on unmapped, refuses read-only, and a granted page
    # = writable by definition. the process exits before the
    # permission change could matter to anyone.
    bytes:
        73
        137
        208
    # pass 141: a hard bound on the down-walk too - 64MB of pages,
    # generous past any stack rlimit, so a mapping flush below the
    # stack cannot be over-wiped on gapless kernel layouts
    bytes:
        65
        185
    put_4_bytes(16384)
    # sw_loop:
    sw_loop: here()
    #   mincore(rdi, 4096, rdx)
    put_in_program(190)
    put_4_bytes(4096)
    put_in_program(184)
    put_4_bytes(27)
    ask_kernel
    #   mapped only when the answer = exactly zero
    bytes:
        72
        133
        192
    sw_exit: jnz()
    #   rax = 0; rcx = 512; cld; rep stosq  - zero the page
    bytes:
        49
        192
        185
    put_4_bytes(512)
    bytes:
        252
        243
        72
        171
    #   back to the page start, then one page lower
    bytes:
        72
        129
        239
    put_4_bytes(8192)
    bytes:
        65
        255
        201
    sw_cap: jz()
    #   jmp sw_loop
    sw_back: jmp()
    put(sw_back, sw_loop - (sw_back + 4))
    patch(sw_exit)
    patch(sw_cap)
    # pass 139: the heap. heap_ptr = the program's own bump
    # frontier (its store survives every diet - the allocator reads
    # it); every byte below it down to the mmap base = something
    # the program allocated, and until now a private program that
    # never called secret_die left all of it - copies, key
    # material, parsed secrets - sitting in mapped memory at exit.
    # the base address is not recoverable (heap_end's store dies to
    # the dead-store diets), so the walk FINDS it: mprotect probing
    # downward, the same trick as the stack up-walk - the bottom of
    # the heap mapping refuses, everything inside grants and takes
    # the stosq. guard: heap_ptr zero means no heap ever started.
    # emitted only when the global exists at all.
    if idx(global_names, "heap_ptr") > 0 - 1
        bytes:
            72
            184
        hp_at: here()
        put_8_bytes(0)
        later_fill(hp_at, "glob", "heap_ptr")
        bytes:
            72
            139
            0
            72
            133
            192
        hp_sk: jz()
        bytes:
            72
            137
            199
            72
            129
            231
        put_4_bytes(4294963200)
        # pass 141: the heap mapping = exactly 64MB - 16384 pages.
        # the probe can never legitimately walk more, and a mapping
        # sitting flush below the heap with no gap must not be
        # wiped: the counter = a hard bound.
        bytes:
            65
            185
        put_4_bytes(16384)
        hw_loop: here()
        put_in_program(190)
        put_4_bytes(4096)
        put_in_program(186)
        put_4_bytes(3)
        put_in_program(184)
        put_4_bytes(10)
        ask_kernel
        bytes:
            72
            133
            192
        hw_out: jnz()
        bytes:
            49
            192
            185
        put_4_bytes(512)
        bytes:
            252
            243
            72
            171
            72
            129
            239
        put_4_bytes(8192)
        bytes:
            65
            255
            201
        hw_cap: jz()
        hw_back: jmp()
        put(hw_back, hw_loop - (hw_back + 4))
        patch(hw_out)
        patch(hw_cap)
        patch(hp_sk)
    # pass S2: literals live in the READ+WRITE data LOAD now, so
    # the zeroing below - and a user's own wipe of a literal at
    # any time - writes plain writable data. no page of the
    # program = ever both writable and executable.
    # pass 137: the string literals next. a secret written as a
    # constant in the source lives in this span until now; zero it
    # the same way. this must run AFTER the walk above: the argv
    # runtime slot = glob_addr-8, the last eight bytes of this
    # span, and the walk anchored on it.
    bytes:
        72
        191
    gsa: here()
    put_8_bytes(0)
    later_fill(gsa, "gwstr_a", 0)
    put_in_program(185)
    gsn: here()
    put_4_bytes(0)
    later_fill(gsn, "gwstr_n", 0)
    bytes:
        49
        192
        252
        243
        72
        171
    # pass 135: the globals and the static blocks last. keys,
    # derived material and tags live there (gm_tag and friends);
    # the compiler knows the exact span at write time, so the two
    # placeholders below are patched with the region start and its
    # qword count - no probing needed, one rep stosq covers it.
    # movabs RDI (48 BF): 48 B8 = rax, and the stosq would then
    # fire with whatever rdi the last print left behind (fd 1)
    bytes:
        72
        191
    gwa: here()
    put_8_bytes(0)
    later_fill(gwa, "gwipe_a", 0)
    put_in_program(185)
    gwn: here()
    put_4_bytes(0)
    later_fill(gwn, "gwipe_n", 0)
    bytes:
        49
        192
        252
        243
        72
        171
    # pass 138: the up-walk, last. rdi = anchor + 4096, then probe
    # and zero upward until mprotect refuses. the stosq leaves rdi
    # on the next page, so the loop needs no stepping of its own.
    bytes:
        76
        137
        199
        72
        129
        199
    put_4_bytes(4096)
    # pass 141: 16MB above the frame = generous past any initial
    # block (argv, env, auxv); the bound stops a gapless neighbor
    # above the stack from taking the stosq
    bytes:
        65
        185
    put_4_bytes(4096)
    up_loop: here()
    put_in_program(190)
    put_4_bytes(4096)
    put_in_program(186)
    put_4_bytes(3)
    put_in_program(184)
    put_4_bytes(10)
    ask_kernel
    bytes:
        72
        133
        192
    up_exit: jnz()
    bytes:
        49
        192
        185
    put_4_bytes(512)
    bytes:
        252
        243
        72
        171
        65
        255
        201
    up_cap: jz()
    up_back: jmp()
    put(up_back, up_loop - (up_back + 4))
    patch(up_exit)
    patch(up_cap)
    # pass 142: the register file itself - every
    # general-purpose register left holding residue is
    # zeroed, so even the exit trap hands the kernel a
    # clean register dump. rax/rdi are set fresh by the
    # exit that follows.
    bytes:
        49
        219
        49
        237
        49
        246
        49
        210
        49
        201
        69
        49
        192
        69
        49
        201
        69
        49
        210
        69
        49
        219
        69
        49
        228
        69
        49
        237
        69
        49
        246
        69
        49
        255
    # rax = 0 for the mov al,60 exit
    bytes:
        49
        192
    return
emit_nodump:
    rax_imm(157)
    rdi_imm(4)
    bytes:
        49
        246
    ask_kernel
# pass S5: the stack canary. a private frame stores the canary
# below its deepest local at entry and proves it on every return;
# a smashed frame traps into this stub instead of returning into
# the smash. the canary itself = one qword seeded from getrandom
# before main runs, so every run checks a different value.

emit_canary_seed:
    if idx(global_names, "g_canary") = 0 - 1
        global_names: _sov_list_add(global_names, "g_canary")
    # getrandom(&g_canary, 8, 0)
    rax_imm(318)
    bytes:
        72
        191
    sga: here()
    put_8_bytes(0)
    later_fill(sga, "glob", "g_canary")
    bytes:
        72
        190
    put_8_bytes(8)
    bytes:
        72
        49
        210
    ask_kernel

# pass S6: the crash path wipes. a private build installs handlers
# for the fatal signals before main runs; the handler says crash,
# runs the same register-only wipe the exit walk runs (heap pages
# aside - the walk covers stack, globals, static blocks), and exits
# 100 + signal, so a SIGSEGV death leaves exit 111, not a dump
emit_crash_handler:
    # the restorer the kernel demands before it will deliver a
    # signal on x86-64: rt_sigreturn. the crash handler exits
    # instead of returning, so this only exists to satisfy delivery
    task_names: _sov_list_add(task_names, "_sov_sigret")
    task_at: _sov_list_add(task_at, here())
    bytes:
        176
        15
    ask_kernel
    # one stub per signal: the wipe zeroes the whole register file
    # (pass 142), so the exit code cannot ride a register through
    # it - each stub owns its own constant instead
    cwns: _sov_list_new()
    cwns: _sov_list_add(cwns, "_sov_cw_4")
    cwns: _sov_list_add(cwns, "_sov_cw_6")
    cwns: _sov_list_add(cwns, "_sov_cw_7")
    cwns: _sov_list_add(cwns, "_sov_cw_8")
    cwns: _sov_list_add(cwns, "_sov_cw_11")
    cwvs: _sov_list_new()
    cwvs: _sov_list_add(cwvs, 4)
    cwvs: _sov_list_add(cwvs, 6)
    cwvs: _sov_list_add(cwvs, 7)
    cwvs: _sov_list_add(cwvs, 8)
    cwvs: _sov_list_add(cwvs, 11)
    chi: 0
    as long as chi < 5
        sg2: _sov_list_get(cwns, chi)
        sgv: _sov_list_get(cwvs, chi)
        task_names: _sov_list_add(task_names, sg2)
        task_at: _sov_list_add(task_at, here())
        emit_write_lit("crash\n")
        emit_stack_wipe
        # exit(100 + signal), set fresh after the register wipe
        put_in_program(191)
        put_4_bytes(100 + sgv)
        bytes:
            176
            60
        ask_kernel
        chi: chi + 1

emit_crash_install:
    # the act lives on the stack, pushed in reverse: mask, restorer,
    # flags, handler. stack pushes are their own reader as far as
    # the dead-store passes are concerned, and the struct = spent
    # inside the syscall that follows
    # restorer and flags are the same for every signal, so they go
    # up once; the handler qword = rebuilt per signal below
    xor_rax
    bytes:
        80
        72
        184
    csrh: here()
    put_8_bytes(0)
    later_fill(csrh, "task_address", "_sov_sigret")
    bytes:
        80
        72
        184
    put_8_bytes(67108864)
    bytes:
        80
        72
        184
    cah: here()
    put_8_bytes(0)
    later_fill(cah, "task_address", "_sov_cw_4")
    put_in_program(80)
    # rt_sigaction(sig, &act, 0, 8) for ill, abrt, bus, fpe, segv
    csi: 0
    csigs: _sov_list_new()
    csigs: _sov_list_add(csigs, 4)
    csigs: _sov_list_add(csigs, 6)
    csigs: _sov_list_add(csigs, 7)
    csigs: _sov_list_add(csigs, 8)
    csigs: _sov_list_add(csigs, 11)
    as long as csi < 5
        sg: _sov_list_get(csigs, csi)
        # the handler slot at [rsp] = rewritten for this signal
        bytes:
            72
            184
        cph: here()
        put_8_bytes(0)
        cwn: ""
        if sg = 4
            cwn: "_sov_cw_4"
        if sg = 6
            cwn: "_sov_cw_6"
        if sg = 7
            cwn: "_sov_cw_7"
        if sg = 8
            cwn: "_sov_cw_8"
        if sg = 11
            cwn: "_sov_cw_11"
        later_fill(cph, "task_address", cwn)
        bytes:
            72
            137
            4
            36
        rdi_imm(sg)
        bytes:
            72
            137
            230
            72
            49
            210
            65
            186
        put_4_bytes(8)
        emit_sys_num(13)
        emit_sys_do
        csi: csi + 1
    bytes:
        72
        131
        196
        32

compile source:
    code: _sov_list_new()
    bump_ptr: blank
    bump_end: blank
    known_name: blank
    known_value: 0
    dead_alloc_name: blank
    used_alloc: 0
    used_text_length: 0
    used_texts_equal: 0
    used_print: 0
    used_print_number: 0
    used_crash: 0
    used_fill: 0
    tiny_program: 0
    needs_heap: 0
    needs_private: 0
    saw_letters: 0
    letter_boxes: _sov_list_new()
    letter_tasks: _sov_list_new()
    array_names: _sov_list_new()
    array_count: _sov_list_new()
    fn_locs: _sov_list_new()
    letter_tasks: _sov_list_add(letter_tasks, "cat")
    letter_tasks: _sov_list_add(letter_tasks, "strcat")
    letter_tasks: _sov_list_add(letter_tasks, "_sov_strcat")
    letter_tasks: _sov_list_add(letter_tasks, "sub")
    letter_tasks: _sov_list_add(letter_tasks, "trim")
    letter_tasks: _sov_list_add(letter_tasks, "ch")
    letter_tasks: _sov_list_add(letter_tasks, "_sov_substring")
    seed_str_fns
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) = 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") = 0
                    if starts(pre_t, "use ") = 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c = length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") = 1
                                            pre_in: 0
                                        if not
                                            if pre_in = 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
                                    # seven values = the most a job can
                                    # take. more used to compile and then
                                    # go wrong while running.
                                    if pre_na > 7
                                        print "Error: a job takes at most seven values" : pre_cur
                                        print "name" : pre_na
                                        saw_error: 1
                                    array_names: _sov_list_add(array_names, pre_cur)
                                    array_count: _sov_list_add(array_count, pre_na)
                                if not
                                    pre_cur: pre_h
                                    array_names: _sov_list_add(array_names, pre_cur)
                                    array_count: _sov_list_add(array_count, 0)
            if not
                pre_t2: strip(pre_l)
                if starts(pre_t2, "return ") = 1
                    pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                    if starts(pre_r, "as text ") = 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if starts(pre_r, "as ptr ") = 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    # the documented form = the postfix cast: return "x" as text
                    if length(pre_r) >= 8
                        if same(cut(pre_r, length(pre_r) - 8, length(pre_r)), " as text") = 1
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                    if length(pre_r) >= 7
                        if same(cut(pre_r, length(pre_r) - 7, length(pre_r)), " as ptr") = 1
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                    if length(pre_r) > 0
                        if _sov_byte_at(pre_r, 0) = 34
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                        if not
                            if same(pre_r, "blank") = 1
                                if length(pre_cur) > 0
                                    mark_fn_str(pre_cur)
        pre_i: pre_i + 1
    # a job that hands back another job's answer = a text job too,
    # whatever order the jobs were written in. Keep going round until
    # nobody new = marked, so forward references work as well as
    # backward ones.
    changed: 1
    as long as changed = 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) = 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") = 0
                        if starts(pre_t, "use ") = 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c = length(pre_t) - 1
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    if starts(pre_t2, "return ") = 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(letter_tasks, pre_cur) < 0
                            if starts(pre_r, "as text ") = 0
                                if starts(pre_r, "as ptr ") = 0
                                    if length(pre_r) > 0
                                        if _sov_byte_at(pre_r, 0) is not 34
                                            if same(pre_r, "blank") = 0
                                                pre_lp: look(pre_r, "(")
                                                if pre_lp > 0
                                                    pre_f: strip(cut(pre_r, 0, pre_lp))
                                                    if idx(letter_tasks, pre_f) > 0 - 1
                                                        mark_fn_str(pre_cur)
                                                        changed: 1
                                                if not
                                                    # return of a local that already holds text
                                                    if idx(letter_tasks, pre_r) > 0 - 1
                                                        mark_fn_str(pre_cur)
                                                        changed: 1
            pre_i: pre_i + 1
    # return x where x was assigned from text in the same job
    changed: 1
    as long as changed = 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        tloc: _sov_list_new()
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) = 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") = 0
                        if starts(pre_t, "use ") = 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c = length(pre_t) - 1
                                    tloc: _sov_list_new()
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    gc: find_col(pre_t2)
                    if gc > 0
                        if gc < length(pre_t2) - 1
                            vn: repl(strip(cut(pre_t2, 0, gc)), " ", "_")
                            rhs: strip(cut(pre_t2, gc + 1, length(pre_t2)))
                            is_t: 0
                            if length(rhs) > 0
                                if _sov_byte_at(rhs, 0) = 34
                                    is_t: 1
                            if same(rhs, "blank") = 1
                                is_t: 1
                            if starts(rhs, "as text ") = 1
                                is_t: 1
                            if look(rhs, "(") > 0
                                rf: strip(cut(rhs, 0, look(rhs, "(")))
                                if idx(letter_tasks, rf) > 0 - 1
                                    is_t: 1
                            if idx(tloc, rhs) > 0 - 1
                                is_t: 1
                            if is_t = 1
                                if idx(tloc, vn) < 0
                                    tloc: _sov_list_add(tloc, vn)
                    if starts(pre_t2, "return ") = 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(letter_tasks, pre_cur) < 0
                            if idx(tloc, pre_r) > 0 - 1
                                mark_fn_str(pre_cur)
                                changed: 1
            pre_i: pre_i + 1
    # a program that wipes or marks private data must not core-dump it.
    # match the statements, not the substring: the old look() matched
    # "# would wipe what the stub stored" in a runtime comment and
    # spent 14 bytes of prctl in every runtime-linked binary.
    nls: lines_of(source)
    ni: 0
    as long as ni < _sov_list_len(nls)
        ns: strip(_sov_list_get(nls, ni))
        if same(ns, "private") = 1
            needs_private: 1
        if starts(ns, "wipe ") = 1
            needs_private: 1
        ni: ni + 1
    const_names: _sov_list_new()
    const_values: _sov_list_new()
    const_dirty: _sov_list_new()
    static_sizes: _sov_list_new()
    letters: _sov_buf_new()
    letter_keys: _sov_list_new()
    letters_at: _sov_list_new()
    task_names: _sov_list_new()
    task_at: _sov_list_new()
    global_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_value: _sov_list_new()
    patch_line: _sov_list_new()
    line_of_stmt: _sov_list_new()
    line_of_body: _sov_list_new()
    line_of_task: _sov_list_new()
    user_tasks: _sov_list_new()
    lns: lines_of(source)
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    tops_lns: _sov_list_new()
    loose: _sov_list_new()
    loose_lns: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    li: 0
    as long as li < _sov_list_len(lns)
        raw: _sov_list_get(lns, li)
        s: strip(raw)
        th: 0
        if nind(raw) = 0
            if is_task_hdr(s) = 1
