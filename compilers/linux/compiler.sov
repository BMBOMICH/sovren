no_frame: 0

copyargs n:
    if n > 0
        emit(72)
        emit(137)
        emit(251)
    if n > 1
        emit(73)
        emit(137)
        emit(244)
    if n > 2
        emit(73)
        emit(137)
        emit(213)
    if n > 3
        emit(73)
        emit(137)
        emit(206)
    if n > 4
        emit(77)
        emit(137)
        emit(199)
    if n > 5
        emit(76)
        emit(137)
        emit(200)
        store_loc(5)
    if n > 6
        # the 7th argument rides in r10: every seven-value call
        # pops it there before the call, so the callee reads it back
        emit(76)
        emit(137)
        emit(208)
        store_loc(6)
emit_print_int:
    fn_names: _sov_list_add(fn_names, "_sov_print_int")
    fn_offs: _sov_list_add(fn_offs, here())
    # the digit cursor rides rsi (the write buffer), so the frame
    # saves nothing and the final pointer move disappears
    emit(72)
    emit(137)
    emit(248)
    emit(72)
    emit(131)
    emit(236)
    emit(32)
    emit(72)
    emit(141)
    emit(116)
    emit(36)
    emit(32)
    emit(72)
    emit(255)
    emit(206)
    emit(198)
    emit(6)
    emit(10)
    emit(106)
    emit(10)
    emit(89)
    emit(69)
    emit(49)
    emit(201)
    test_rax()
    emit(15)
    emit(141)
    ag: here()
    br_at: _sov_list_add(br_at, ag)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, ag)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    emit(65)
    emit(177)
    emit(1)
    emit(72)
    emit(247)
    emit(216)
    put(ag, here() - (ag + 4))
    dl: here()
    emit(49)
    emit(210)
    emit(72)
    emit(247)
    emit(241)
    emit(131)
    emit(194)
    emit(48)
    emit(72)
    emit(255)
    emit(206)
    emit(136)
    emit(22)
    emit(72)
    emit(133)
    emit(192)
    emit(15)
    emit(133)
    aj: here()
    br_at: _sov_list_add(br_at, aj)
    br_pv: _sov_list_add(br_pv, pad_ver)
    br_id: _sov_list_add(br_id, aj)
    br_st: _sov_list_add(br_st, 0)
    emit4(0)
    put(aj, dl - (aj + 4))
    emit(69)
    emit(132)
    emit(201)
    zn: jz()
    emit(72)
    emit(255)
    emit(206)
    emit(198)
    emit(6)
    emit(45)
    patch(zn)
    emit(72)
    emit(141)
    emit(84)
    emit(36)
    emit(32)
    emit(72)
    emit(41)
    emit(242)
    rdi_imm(1)
    # the digit loop exits with rax = 0, so the write number is a
    # two-byte mov al,1 instead of push 1; pop rax
    emit(176)
    emit(1)
    sysc()
    emit(72)
    emit(131)
    emit(196)
    emit(32)
    ret()
# pass S7: the relocation walk, shared by both start shapes.
# entries are file offsets of absolute qwords; the walk derives each
# runtime code address from the slide and patches the qword itself
# --- thread runtime ---------------------------------------------------
# spawn/join. the runtime tasks live in runtime.sov and compile as
# ordinary jobs; spawn only re-packs the arguments for
# _sov_thread_spawn(fn, a0..a5). the slow call path pushed a0..a5,
# so pop them back into the argument registers, shift them one to
# the right to make room for fn in rdi, and give a5 the seventh
# argument slot on the stack.
#   cb[0]  status: 0 running, 1 done
#   cb[8]  fn pointer
#   cb[16]..cb[72]  a0..a5

emit_pie_walk:
    if idx(glob_names, "g_slide") is 0 - 1
        glob_names: _sov_list_add(glob_names, "g_slide")
    emit(87)
    emit(86)
    load_glob("g_slide")
    emit(72)
    emit(141)
    emit(21)
    pw1: here()
    emit4(0)
    addp(pw1, "grel", "g_slide")
    emit(72)
    emit(41)
    emit(194)
    # zero slide means the kernel chose the link address: nothing
    # to do. 116 is jz; 117 would be jnz and run the wrong way
    emit(116)
    emit(99)
    # the slide rides rbx: rdx belongs to mprotect's prot argument
    # and both syscalls would eat it
    emit(72)
    emit(137)
    emit(211)
    # r8 = image base at runtime = link base + slide (75: the REX
    # with B set, because r8 is the destination here)
    emit(75)
    emit(137)
    emit(216)
    emit(73)
    emit(129)
    emit(192)
    emit4(4194304)
    # the text page is READ+EXECUTE (pass S2), and the walk writes
    # into it: open it briefly, then close it back
    emit(76)
    emit(137)
    emit(199)
    emit(72)
    emit(190)
    pwl: here()
    emit8(0)
    addp(pwl, "rel_l", 0)
    # r9 keeps the length: rsi is the walk's working register and
    # the restore call needs it back afterwards (241 is the modrm
    # for rsi in the reg field; 225 would hand it rsp)
    emit(75)
    emit(137)
    emit(241)
    emit(186)
    emit4(7)
    emit(184)
    emit4(10)
    sysc()
    # the count loads AFTER the syscall: syscall eats rcx
    emit(185)
    pw2: here()
    emit4(0)
    addp(pw2, "rel_n", 0)
    # r10 = the table (49 BA: the wide form, or the upper half of
    # r10 stays whatever the kernel left there)
    emit(73)
    emit(186)
    pw3: here()
    emit8(0)
    addp(pw3, "rel_a", 0)
    # the table pointer itself is link-time; the slide makes it
    # live, so the walk owns no unrelocated absolute of its own
    emit(75)
    emit(1)
    emit(218)
    # past the count qword, onto the first entry
    emit(73)
    emit(131)
    emit(194)
    emit(8)
    # a program with no absolute qwords must not enter the loop at
    # all: the do-while shape would run its body once on zero
    emit(227)
    emit(17)
    # rsi = [r10] + r8; add slide to [rsi]
    emit(73)
    emit(139)
    emit(50)
    emit(76)
    emit(1)
    emit(198)
    emit(72)
    emit(1)
    emit(30)
    emit(73)
    emit(131)
    emit(194)
    emit(8)
    emit(255)
    emit(201)
    emit(117)
    emit(239)
    # text back to READ+EXECUTE
    emit(76)
    emit(137)
    emit(206)
    emit(186)
    emit4(5)
    emit(184)
    emit4(10)
    sysc()
    emit(94)
    emit(95)
    return 0

emit_start:
    # pass S7: the kernel may land this image anywhere; the walk
    # fixes every absolute before the first dereference
    emit_pie_walk()
    # pass 104: the argc/argv block (register setup + the two stores)
    # rides first and contiguous when want_args is set, so stub_diet
    # can splice it out whole when dce has left no reader of
    # g_argc/g_argv (a use-sys program that never touches arguments).
    # the and rsp,-16 + jmp tail always survives.
    sd_need_setup: 0
    if want_args is 1
        sd_need_setup: 1
    if main_params_n > 0
        sd_need_setup: 1
    if sd_need_setup is 1
        emit(72)
        emit(139)
        emit(28)
        emit(36)
        emit(76)
        emit(141)
        emit(100)
        emit(36)
        emit(8)
        emit(72)
        emit(137)
        emit(223)
        emit(76)
        emit(137)
        emit(230)
    # keep argc and argv where the runtime can find them, so
    # arg_count and arg_at work on every system
    if want_args is 1
        emit(72)
        emit(184)
        ga: here()
        emit8(0)
        addp(ga, "glob", "g_argc")
        emit(72)
        emit(137)
        emit(56)
        emit(72)
        emit(184)
        gv: here()
        emit8(0)
        addp(gv, "glob", "g_argv")
        emit(72)
        emit(137)
        emit(48)
    emit(72)
    emit(131)
    emit(228)
    emit(240)
    emit(233)
    at: here()
    emit4(0)
    addp(at, "rel", "main")
emit_write_lit s:
    n: length(s)
    # the entry task starts with every general register zeroed
    # (kernel reality, relied on by the size floors): a write that is
    # the very first code of main can use the two-byte short forms.
    vg: 0
    if here() is main_start
        # virgin registers hold only when main is the raw entry
        # point: emit_start/copyargs load rdi (params) and
        # emit_nodump loads rdi=4 (private), all before main_start
        if thin_main is 1
            if need_priv is 0
                vg: 1
    if vg is 1
        emit(255)
        emit(199)
    if not
        emit(106)
        emit(1)
        emit(95)
    off: intern_nz(s)
    # pass S7: a 32-bit absolute dies under a real load bias, so the
    # literal address goes out wide and lands in the reloc table
    emit(72)
    emit(190)
    at: here()
    emit8(off)
    addp(at, "str", off)
    if n < 128
        if vg is 1
            emit(178)
            emit(n)
        if not
            emit(106)
            emit(n)
            emit(90)
    if not
        emit(186)
        emit4(n)
    if vg is 1
        emit(176)
        emit(1)
    if not
        emit(106)
        emit(1)
        emit(88)
    sysc()
    # write returns the byte count in rax (small): a following exit
    # can rely on rax's high bytes being zero
    if br_depth is 0
        rax_small: 1
# windows hands back argv[0] wrapped in quotes, as a drive path with
# backslashes. turn it into the plain form the file calls understand.
emit_stack_wipe:
    # then the stack: pass 131 - after main's body, before the exit
    # syscall, walk downward one page at a time and zero every mapped page -
    # spilled secrets in dead frames do not outlive the process.
    # register-only (no stack slot is ever touched), each page is
    # probed with mincore first - zero means mapped, any error means
    # stop - and the vec byte lands on the page above, which the
    # previous pass already zeroed (or which holds dead argv strings
    # on the first pass). anchor: the running frame's own page.
    # rax ends zeroed so the two-byte mov al,60
    # exit that follows stays correct. branches go through the
    # registered jnz/jmp helpers so the relaxer keeps the targets.
    #   pass 138b: the anchor is rsp itself, page-aligned down -
    #   the same anchor the other four machines use. the old g_argv
    #   slot read tied the wipe to the argv capture stub, and a
    #   thin-main private program skips that stub: the slot read
    #   zero, both walks stopped on their first probe, and nothing
    #   was wiped at all (thin private guests, since pass 131).
    #   from the running frame the up-walk sweeps everything above
    #   it - dead frames, argv, env, auxv - and the down-walk takes
    #   everything below; no slot, no stub dependency, no layout
    #   assumptions.
    emit(72)
    emit(137)
    emit(231)
    #   rdi = rdi & -4096   (the frame's page, aligned down)
    emit(72)
    emit(129)
    emit(231)
    emit4(4294963200)
    emit(72)
    emit(129)
    emit(231)
    emit4(4294963200)
    #   rdx = rdi, and it stays: the vec byte for every mincore is
    #   on the anchor page itself - always mapped, always writable
    #   (pass one zeroes it, it stays writable). a vec above or
    #   below the probe walks off the stack top or bottom on the
    #   first or last page and the probe dies with EFAULT.
    emit(72)
    emit(137)
    emit(250)
    # pass 138: r8 keeps the anchor. the up-walk at the end of the
    # wipe will zero everything ABOVE this page - the initial block:
    # argv strings, env strings, auxv, the arrays - probing with
    # mprotect rather than mincore, because a read-only page sitting
    # against the stack top with no gap (vdso) answers mincore
    # "mapped" and then faults the stosq, while mprotect(page,4096,
    # RW) fails on unmapped, refuses read-only, and a granted page
    # is writable by definition. the process exits before the
    # permission change could matter to anyone.
    emit(73)
    emit(137)
    emit(208)
    # pass 141: a hard bound on the down-walk too - 64MB of pages,
    # generous past any stack rlimit, so a mapping flush below the
    # stack cannot be over-wiped on gapless kernel layouts
    emit(65)
    emit(185)
    emit4(16384)
    # sw_loop:
    sw_loop: here()
    #   mincore(rdi, 4096, rdx)
    emit(190)
    emit4(4096)
    emit(184)
    emit4(27)
    sysc()
    #   mapped only when the answer is exactly zero
    emit(72)
    emit(133)
    emit(192)
    sw_exit: jnz()
    #   rax = 0; rcx = 512; cld; rep stosq  - zero the page
    emit(49)
    emit(192)
    emit(185)
    emit4(512)
    emit(252)
    emit(243)
    emit(72)
    emit(171)
    #   back to the page start, then one page lower
    emit(72)
    emit(129)
    emit(239)
    emit4(8192)
    emit(65)
    emit(255)
    emit(201)
    sw_cap: jz()
    #   jmp sw_loop
    sw_back: jmp()
    put(sw_back, sw_loop - (sw_back + 4))
    patch(sw_exit)
    patch(sw_cap)
    # pass 139: the heap. heap_ptr is the program's own bump
    # frontier (its store survives every diet - the allocator reads
    # it); every byte below it down to the mmap base is something
    # the program allocated, and until now a private program that
    # never called secret_die left all of it - copies, key
    # material, parsed secrets - sitting in mapped memory at exit.
    # the base address is not recoverable (heap_end's store dies to
    # the dead-store diets), so the walk FINDS it: mprotect probing
    # downward, the same trick as the stack up-walk - the bottom of
    # the heap mapping refuses, everything inside grants and takes
    # the stosq. guard: heap_ptr zero means no heap ever started.
    # emitted only when the global exists at all.
    if idx(glob_names, "heap_ptr") > 0 - 1
        emit(72)
        emit(184)
        hp_at: here()
        emit8(0)
        addp(hp_at, "glob", "heap_ptr")
        emit(72)
        emit(139)
        emit(0)
        emit(72)
        emit(133)
        emit(192)
        hp_sk: jz()
        emit(72)
        emit(137)
        emit(199)
        emit(72)
        emit(129)
        emit(231)
        emit4(4294963200)
        # pass 141: the heap mapping is exactly 64MB - 16384 pages.
        # the probe can never legitimately walk more, and a mapping
        # sitting flush below the heap with no gap must not be
        # wiped: the counter is a hard bound.
        emit(65)
        emit(185)
        emit4(16384)
        hw_loop: here()
        emit(190)
        emit4(4096)
        emit(186)
        emit4(3)
        emit(184)
        emit4(10)
        sysc()
        emit(72)
        emit(133)
        emit(192)
        hw_out: jnz()
        emit(49)
        emit(192)
        emit(185)
        emit4(512)
        emit(252)
        emit(243)
        emit(72)
        emit(171)
        emit(72)
        emit(129)
        emit(239)
        emit4(8192)
        emit(65)
        emit(255)
        emit(201)
        hw_cap: jz()
        hw_back: jmp()
        put(hw_back, hw_loop - (hw_back + 4))
        patch(hw_out)
        patch(hw_cap)
        patch(hp_sk)
    # pass S2: literals live in the READ+WRITE data LOAD now, so
    # the zeroing below - and a user's own wipe of a literal at
    # any time - writes plain writable data. no page of the
    # program is ever both writable and executable.
    # pass 137: the string literals next. a secret written as a
    # constant in the source lives in this span until now; zero it
    # the same way. this must run AFTER the walk above: the argv
    # runtime slot is glob_addr-8, the last eight bytes of this
    # span, and the walk anchored on it.
    emit(72)
    emit(191)
    gsa: here()
    emit8(0)
    addp(gsa, "gwstr_a", 0)
    emit(185)
    gsn: here()
    emit4(0)
    addp(gsn, "gwstr_n", 0)
    emit(49)
    emit(192)
    emit(252)
    emit(243)
    emit(72)
    emit(171)
    # pass 135: the globals and the static blocks last. keys,
    # derived material and tags live there (gm_tag and friends);
    # the compiler knows the exact span at write time, so the two
    # placeholders below are patched with the region start and its
    # qword count - no probing needed, one rep stosq covers it.
    # movabs RDI (48 BF): 48 B8 is rax, and the stosq would then
    # fire with whatever rdi the last print left behind (fd 1)
    emit(72)
    emit(191)
    gwa: here()
    emit8(0)
    addp(gwa, "gwipe_a", 0)
    emit(185)
    gwn: here()
    emit4(0)
    addp(gwn, "gwipe_n", 0)
    emit(49)
    emit(192)
    emit(252)
    emit(243)
    emit(72)
    emit(171)
    # pass 138: the up-walk, last. rdi = anchor + 4096, then probe
    # and zero upward until mprotect refuses. the stosq leaves rdi
    # on the next page, so the loop needs no stepping of its own.
    emit(76)
    emit(137)
    emit(199)
    emit(72)
    emit(129)
    emit(199)
    emit4(4096)
    # pass 141: 16MB above the frame is generous past any initial
    # block (argv, env, auxv); the bound stops a gapless neighbor
    # above the stack from taking the stosq
    emit(65)
    emit(185)
    emit4(4096)
    up_loop: here()
    emit(190)
    emit4(4096)
    emit(186)
    emit4(3)
    emit(184)
    emit4(10)
    sysc()
    emit(72)
    emit(133)
    emit(192)
    up_exit: jnz()
    emit(49)
    emit(192)
    emit(185)
    emit4(512)
    emit(252)
    emit(243)
    emit(72)
    emit(171)
    emit(65)
    emit(255)
    emit(201)
    up_cap: jz()
    up_back: jmp()
    put(up_back, up_loop - (up_back + 4))
    patch(up_exit)
    patch(up_cap)
    # pass 142: the register file itself - every
    # general-purpose register left holding residue is
    # zeroed, so even the exit trap hands the kernel a
    # clean register dump. rax/rdi are set fresh by the
    # exit that follows.
    emit(49)
    emit(219)
    emit(49)
    emit(237)
    emit(49)
    emit(246)
    emit(49)
    emit(210)
    emit(49)
    emit(201)
    emit(69)
    emit(49)
    emit(192)
    emit(69)
    emit(49)
    emit(201)
    emit(69)
    emit(49)
    emit(210)
    emit(69)
    emit(49)
    emit(219)
    emit(69)
    emit(49)
    emit(228)
    emit(69)
    emit(49)
    emit(237)
    emit(69)
    emit(49)
    emit(246)
    emit(69)
    emit(49)
    emit(255)
    # rax = 0 for the mov al,60 exit
    emit(49)
    emit(192)
    return
emit_nodump:
    rax_imm(157)
    rdi_imm(4)
    emit(49)
    emit(246)
    sysc()
# pass S5: the stack canary. a private frame stores the canary
# below its deepest local at entry and proves it on every return;
# a smashed frame traps into this stub instead of returning into
# the smash. the canary itself is one qword seeded from getrandom
# before main runs, so every run checks a different value.

emit_canary_seed:
    if idx(glob_names, "g_canary") is 0 - 1
        glob_names: _sov_list_add(glob_names, "g_canary")
    # getrandom(&g_canary, 8, 0)
    rax_imm(318)
    emit(72)
    emit(191)
    sga: here()
    emit8(0)
    addp(sga, "glob", "g_canary")
    emit(72)
    emit(190)
    emit8(8)
    emit(72)
    emit(49)
    emit(210)
    sysc()

# pass S6: the crash path wipes. a private build installs handlers
# for the fatal signals before main runs; the handler says crash,
# runs the same register-only wipe the exit walk runs (heap pages
# aside - the walk covers stack, globals, static blocks), and exits
# 100 + signal, so a SIGSEGV death leaves exit 111, not a dump
emit_crash_handler:
    # the restorer the kernel demands before it will deliver a
    # signal on x86-64: rt_sigreturn. the crash handler exits
    # instead of returning, so this only exists to satisfy delivery
    fn_names: _sov_list_add(fn_names, "_sov_sigret")
    fn_offs: _sov_list_add(fn_offs, here())
    emit(176)
    emit(15)
    sysc()
    # one stub per signal: the wipe zeroes the whole register file
    # (pass 142), so the exit code cannot ride a register through
    # it - each stub owns its own constant instead
    cwns: _sov_list_new()
    cwns: _sov_list_add(cwns, "_sov_cw_4")
    cwns: _sov_list_add(cwns, "_sov_cw_6")
    cwns: _sov_list_add(cwns, "_sov_cw_7")
    cwns: _sov_list_add(cwns, "_sov_cw_8")
    cwns: _sov_list_add(cwns, "_sov_cw_11")
    cwvs: _sov_list_new()
    cwvs: _sov_list_add(cwvs, 4)
    cwvs: _sov_list_add(cwvs, 6)
    cwvs: _sov_list_add(cwvs, 7)
    cwvs: _sov_list_add(cwvs, 8)
    cwvs: _sov_list_add(cwvs, 11)
    chi: 0
    as long as chi < 5
        sg2: _sov_list_get(cwns, chi)
        sgv: _sov_list_get(cwvs, chi)
        fn_names: _sov_list_add(fn_names, sg2)
        fn_offs: _sov_list_add(fn_offs, here())
        emit_write_lit("crash\n")
        emit_stack_wipe()
        # exit(100 + signal), set fresh after the register wipe
        emit(191)
        emit4(100 + sgv)
        emit(176)
        emit(60)
        sysc()
        chi: chi + 1

emit_crash_install:
    # the act lives on the stack, pushed in reverse: mask, restorer,
    # flags, handler. stack pushes are their own reader as far as
    # the dead-store passes are concerned, and the struct is spent
    # inside the syscall that follows
    # restorer and flags are the same for every signal, so they go
    # up once; the handler qword is rebuilt per signal below
    xor_rax()
    emit(80)
    emit(72)
    emit(184)
    csrh: here()
    emit8(0)
    addp(csrh, "fnaddr", "_sov_sigret")
    emit(80)
    emit(72)
    emit(184)
    emit8(67108864)
    emit(80)
    emit(72)
    emit(184)
    cah: here()
    emit8(0)
    addp(cah, "fnaddr", "_sov_cw_4")
    emit(80)
    # rt_sigaction(sig, &act, 0, 8) for ill, abrt, bus, fpe, segv
    csi: 0
    csigs: _sov_list_new()
    csigs: _sov_list_add(csigs, 4)
    csigs: _sov_list_add(csigs, 6)
    csigs: _sov_list_add(csigs, 7)
    csigs: _sov_list_add(csigs, 8)
    csigs: _sov_list_add(csigs, 11)
    as long as csi < 5
        sg: _sov_list_get(csigs, csi)
        # the handler slot at [rsp] is rewritten for this signal
        emit(72)
        emit(184)
        cph: here()
        emit8(0)
        cwn: ""
        if sg is 4
            cwn: "_sov_cw_4"
        if sg is 6
            cwn: "_sov_cw_6"
        if sg is 7
            cwn: "_sov_cw_7"
        if sg is 8
            cwn: "_sov_cw_8"
        if sg is 11
            cwn: "_sov_cw_11"
        addp(cph, "fnaddr", cwn)
        emit(72)
        emit(137)
        emit(4)
        emit(36)
        rdi_imm(sg)
        emit(72)
        emit(137)
        emit(230)
        emit(72)
        emit(49)
        emit(210)
        emit(65)
        emit(186)
        emit4(8)
        emit_sys_num(13)
        emit_sys_do()
        csi: csi + 1
    emit(72)
    emit(131)
    emit(196)
    emit(32)

compile source:
    oc: _sov_list_new()
    iota_ptr: blank
    iota_lim: blank
    kn: blank
    kv: 0
    skip_al: blank
    used_al: 0
    used_sl: 0
    used_eq: 0
    used_pr: 0
    used_pi: 0
    used_tr: 0
    did_stos: 0
    thin_main: 0
    has_vm: 0
    need_priv: 0
    saw_str: 0
    str_vars: _sov_list_new()
    str_fns: _sov_list_new()
    ar_names: _sov_list_new()
    ar_cnt: _sov_list_new()
    fn_locs: _sov_list_new()
    str_fns: _sov_list_add(str_fns, "cat")
    str_fns: _sov_list_add(str_fns, "strcat")
    str_fns: _sov_list_add(str_fns, "_sov_strcat")
    str_fns: _sov_list_add(str_fns, "sub")
    str_fns: _sov_list_add(str_fns, "trim")
    str_fns: _sov_list_add(str_fns, "ch")
    str_fns: _sov_list_add(str_fns, "_sov_substring")
    seed_str_fns()
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) is 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") is 0
                    if starts(pre_t, "use ") is 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c is length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") is 1
                                            pre_in: 0
                                        if not
                                            if pre_in is 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
                                    # seven values is the most a job can
                                    # take. more used to compile and then
                                    # go wrong while running.
                                    if pre_na > 7
                                        print "Error: a job takes at most seven values"
                                        _sov_print(pre_cur)
                                        print pre_na
                                        had_err: 1
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, pre_na)
                                if not
                                    pre_cur: pre_h
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, 0)
            if not
                pre_t2: strip(pre_l)
                if starts(pre_t2, "return ") is 1
                    pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                    if starts(pre_r, "as text ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if starts(pre_r, "as ptr ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    # the documented form is the postfix cast: return "x" as text
                    if length(pre_r) >= 8
                        if same(cut(pre_r, length(pre_r) - 8, length(pre_r)), " as text") is 1
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                    if length(pre_r) >= 7
                        if same(cut(pre_r, length(pre_r) - 7, length(pre_r)), " as ptr") is 1
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                    if length(pre_r) > 0
                        if _sov_byte_at(pre_r, 0) is 34
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                        if not
                            if same(pre_r, "blank") is 1
                                if length(pre_cur) > 0
                                    mark_fn_str(pre_cur)
        pre_i: pre_i + 1
    # a job that hands back another job's answer is a text job too,
    # whatever order the jobs were written in. Keep going round until
    # nobody new is marked, so forward references work as well as
    # backward ones.
    changed: 1
    as long as changed is 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) is 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") is 0
                        if starts(pre_t, "use ") is 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c is length(pre_t) - 1
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    if starts(pre_t2, "return ") is 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(str_fns, pre_cur) < 0
                            if starts(pre_r, "as text ") is 0
                                if starts(pre_r, "as ptr ") is 0
                                    if length(pre_r) > 0
                                        if _sov_byte_at(pre_r, 0) is not 34
                                            if same(pre_r, "blank") is 0
                                                pre_lp: look(pre_r, "(")
                                                if pre_lp > 0
                                                    pre_f: strip(cut(pre_r, 0, pre_lp))
                                                    if idx(str_fns, pre_f) > 0 - 1
                                                        mark_fn_str(pre_cur)
                                                        changed: 1
                                                if not
                                                    # return of a local that already holds text
                                                    if idx(str_fns, pre_r) > 0 - 1
                                                        mark_fn_str(pre_cur)
                                                        changed: 1
            pre_i: pre_i + 1
    # return x where x was assigned from text in the same job
    changed: 1
    as long as changed is 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        tloc: _sov_list_new()
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) is 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") is 0
                        if starts(pre_t, "use ") is 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c is length(pre_t) - 1
                                    tloc: _sov_list_new()
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    gc: find_col(pre_t2)
                    if gc > 0
                        if gc < length(pre_t2) - 1
                            vn: repl(strip(cut(pre_t2, 0, gc)), " ", "_")
                            rhs: strip(cut(pre_t2, gc + 1, length(pre_t2)))
                            is_t: 0
                            if length(rhs) > 0
                                if _sov_byte_at(rhs, 0) is 34
                                    is_t: 1
                            if same(rhs, "blank") is 1
                                is_t: 1
                            if starts(rhs, "as text ") is 1
                                is_t: 1
                            if look(rhs, "(") > 0
                                rf: strip(cut(rhs, 0, look(rhs, "(")))
                                if idx(str_fns, rf) > 0 - 1
                                    is_t: 1
                            if idx(tloc, rhs) > 0 - 1
                                is_t: 1
                            if is_t is 1
                                if idx(tloc, vn) < 0
                                    tloc: _sov_list_add(tloc, vn)
                    if starts(pre_t2, "return ") is 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(str_fns, pre_cur) < 0
                            if idx(tloc, pre_r) > 0 - 1
                                mark_fn_str(pre_cur)
                                changed: 1
            pre_i: pre_i + 1
    # a program that wipes or marks private data must not core-dump it.
    # match the statements, not the substring: the old look() matched
    # "# would wipe what the stub stored" in a runtime comment and
    # spent 14 bytes of prctl in every runtime-linked binary.
    nls: lines_of(source)
    ni: 0
    as long as ni < _sov_list_len(nls)
        ns: strip(_sov_list_get(nls, ni))
        if same(ns, "private") is 1
            need_priv: 1
        if starts(ns, "wipe ") is 1
            need_priv: 1
        ni: ni + 1
    cnms: _sov_list_new()
    cvls: _sov_list_new()
    cemt: _sov_list_new()
    sbss_sizes: _sov_list_new()
    strb: _sov_buf_new()
    str_keys: _sov_list_new()
    str_pos: _sov_list_new()
    fn_names: _sov_list_new()
    fn_offs: _sov_list_new()
    glob_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_val: _sov_list_new()
    patch_line: _sov_list_new()
    stmt_lns: _sov_list_new()
    body_lns: _sov_list_new()
    task_lns: _sov_list_new()
    task_user: _sov_list_new()
    lns: lines_of(source)
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    tops_lns: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    li: 0
    as long as li < _sov_list_len(lns)
        raw: _sov_list_get(lns, li)
        s: strip(raw)
        th: 0
        if is_task_hdr(s) is 1
            th: 1
        if th is 1
            if in_t is 1
                bodies: _sov_list_add(bodies, cur)
                body_lns: _sov_list_add(body_lns, cur_ln)
            tn: tname(s)
            if idx(names, tn) > 0 - 1
                print "Error: two with the same name"
                _sov_print(tn)
                err_line: file_ln(li)
                err_where()
                had_err: 1
            names: _sov_list_add(names, tn)
            params: _sov_list_add(params, tparams(s))
            tu: 0
            if li + 1 > src_base
                tu: 1
            task_user: _sov_list_add(task_user, tu)
            task_lns: _sov_list_add(task_lns, file_ln(li))
            cur: _sov_list_new()
            cur_ln: _sov_list_new()
            in_t: 1
        if not
            if nind(raw) is 0
                gok: 0
                gc: find_col(s)
                if gc > 0
                    if gc < length(s) - 1
                        gok: 1
                if gok is 1
                    gn: blank
                    if starts(s, "<-- ") is 1
                        rest: cut(s, 4, length(s))
                        t: find_sep(rest)
                        if t > 0 - 1
                            gn: repl(strip(cut(rest, 0, t)), " ", "_")
                    if not
                        gn: repl(strip(cut(s, 0, gc)), " ", "_")
                    if length(gn) > 0
                        if idx(glob_names, gn) is 0 - 1
                            glob_names: _sov_list_add(glob_names, gn)
                        # a top-level "x: x" only registers the global;
                        # the store is a no-op (the start stub has already
                        # filled g_argc/g_argv before main runs). skip it.
                        sa: 0
                        if gc + 1 < length(s)
                            grhs: strip(cut(s, gc + 1, length(s)))
                            if same(repl(grhs, " ", "_"), gn) is 1
                                sa: 1
                        if sa is 0
                            tops: _sov_list_add(tops, raw)
                            tops_lns: _sov_list_add(tops_lns, file_ln(li))
            if not
                if in_t is 1
                    cur: _sov_list_add(cur, raw)
                    cur_ln: _sov_list_add(cur_ln, file_ln(li))
        li: li + 1
    if in_t is 1
        bodies: _sov_list_add(bodies, cur)
        body_lns: _sov_list_add(body_lns, cur_ln)
    want_args: 0
    if look(source, "g_argc") > 0 - 1
        want_args: 1
    # privacy programs anchor the stack wipe on g_argv, so they
    # capture the kernel's argv always
    if need_priv is 1
        want_args: 1
    has_vm: 0
    if look(source, "task _sov_alloc") > 0 - 1
        has_vm: 1
    if look(source, "_sov_alloc size:") > 0 - 1
        has_vm: 1
    prep_main(names, params, bodies)
    # count each function's distinct local declarations now that the
    # global names are known, so the prolog can save exactly the
    # register slots the function uses. A local is any indented
    # name: line that is neither a global nor a job.
    fli: 0
    as long as fli < _sov_list_len(bodies)
        fb: _sov_list_get(bodies, fli)
        fset: _sov_list_new()
        flj: 0
        as long as flj < _sov_list_len(fb)
            fls: strip(_sov_list_get(fb, flj))
            if length(fls) > 0
                if _sov_byte_at(fls, 0) is not 35
                    if _sov_byte_at(fls, 0) is not 34
                        fgc: find_col(fls)
                        if fgc > 0
                            if fgc < length(fls) - 1
                                fgn: repl(strip(cut(fls, 0, fgc)), " ", "_")
                                if length(fgn) > 0
                                    if idx(glob_names, fgn) is 0 - 1
                                        if idx(fset, fgn) is 0 - 1
                                            fset: _sov_list_add(fset, fgn)
            flj: flj + 1
        fn_locs: _sov_list_add(fn_locs, _sov_list_len(fset))
        fli: fli + 1
    if has_vm is 1
        glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_start()
        emit_alloc()
        emit_strlen()
        emit_streq()
        emit_print()
        emit_print_int()
        thin_main: 0
    if not
        if thin_main is 0
            emit_start()
        if thin_main is 1
            # pass S7: even a thin main needs the walk before its
            # first absolute address, so it gets a start block of
            # its own: the walk, then the jump
            emit_pie_walk()
            emit(233)
            tjmp: here()
            emit4(0)
            addp(tjmp, "rel", "main")
    fi: 0
    as long as fi < _sov_list_len(names)
        nm: _sov_list_get(names, fi)
        if idx(fn_names, nm) < 0
                fn_names: _sov_list_add(fn_names, nm)
                fn_offs: _sov_list_add(fn_offs, here())
                locals: _sov_list_new()
                str_vars: _sov_list_new()
                saw_str: 0
                br_depth: 0
                stmt_lns: _sov_list_get(body_lns, fi)
                if _sov_list_len(_sov_list_get(bodies, fi)) is 0
                    if _sov_list_get(task_user, fi) is 1
                        print "Warning: empty"
                        _sov_print(nm)
                        print _sov_list_get(task_lns, fi)
                ps: _sov_list_get(params, fi)
                pi: 0
                as long as pi < _sov_list_len(ps)
                    locals: _sov_list_add(locals, _sov_list_get(ps, pi))
                    pi: pi + 1
                thin: 0
                if same(nm, "main") is 1
                    if _sov_list_len(ps) is 0
                        thin: 0
                if thin is 1
                    skip_al: dead_iota(_sov_list_get(bodies, fi))
                    if need_priv is 1
                        emit_nodump()
                        emit_canary_seed()
                        emit_crash_install()
                    leaf8: leaf8_scan(tops)
                    stmt_lns: tops_lns
                    body(tops)
                    stmt_lns: _sov_list_get(body_lns, fi)
                    cflush_all()
                    leaf8: 0
                    if _sov_list_len(ps) is 0
                        leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                    body(_sov_list_get(bodies, fi))
                    if saw_str is 1
                        mark_fn_str(nm)
                    emit(49)
                    emit(255)
                    emit(106)
                    emit(60)
                    emit(88)
                    sysc()
                if not
                    fn_save_n: 0
                    fw_on: 0
                    fw_done: 0
                    fw_pos: _sov_list_new()
                    fargs: _sov_list_len(ps)
                    floc: 0
                    if fi < _sov_list_len(fn_locs)
                        floc: _sov_list_get(fn_locs, fi)
                    ftot: fargs + floc
                    if ftot > 5
                        ftot: 5
                    fn_save_n: ftot
                    no_frame: 0
                    if fargs + floc < 6
                        if starts(nm, "_sov_") is 0
                            no_frame: 1
                    isfib: fiblike(nm, ps, _sov_list_get(bodies, fi))
                    if isfib is 1
                        # frame-free: the iterative body touches rbx
                        # (the arg) and nothing else callee-saved -
                        # a/rdx/rcx are caller-saved - so the frame
                        # is one register, not three
                        fn_save_n: 1
                        no_frame: 1
                    can_here: 0
                    cbi: 0
                    as long as cbi < _sov_list_len(_sov_list_get(bodies, fi))
                        if same(strip(_sov_list_get(_sov_list_get(bodies, fi), cbi)), "private") is 1
                            can_here: 1
                        cbi: cbi + 1
                    # in debug builds the function entry itself is
                    # recorded, so a caller's prologue (frame setup
                    # before its first statement) is not mistaken
                    # for the previous function's tail. user
                    # functions only: runtime entries would carry
                    # runtime-source line numbers. add-only, as in
                    # the stmt hook - newing lists here breaks some
                    # layouts.
                    if dbg_mode is 1
                        if _sov_list_get(task_user, fi) is 1
                            err_line: _sov_list_get(task_lns, fi)
                            if oc is not 0
                                dbg_pcs: _sov_list_add(dbg_pcs, here())
                                dbg_lns: _sov_list_add(dbg_lns, err_line)
                    prolog()
                    if can_here is 1
                        if no_frame is 0
                            if isfib is 0
                                canary_store()
                    copyargs(_sov_list_len(ps))
                    if isfib is 1
                        emit_fib_iter()
                    if not
                        if same(nm, "main") is 1
                            skip_al: dead_iota(_sov_list_get(bodies, fi))
                            if need_priv is 1
                                emit_nodump()
                                emit_canary_seed()
                                emit_crash_install()
                            leaf8: leaf8_scan(tops)
                            stmt_lns: tops_lns
                            main_start: here()
                            rax_small: 0
                            in_main_now: 1
                            body(tops)
                            in_main_now: 0
                            stmt_lns: _sov_list_get(body_lns, fi)
                            cflush_all()
                        leaf8: 0
                        if _sov_list_len(ps) is 0
                            leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                        if same(nm, "main") is 1
                            in_main_now: 1
                        body(_sov_list_get(bodies, fi))
                        if same(nm, "main") is 1
                            in_main_now: 0
                    if _sov_list_len(locals) < 6
                        if fn_save_n < _sov_list_len(locals)
                            print "Warning: locals"
                            _sov_print(nm)
                            print _sov_list_len(locals)
                            print fn_save_n
                    if saw_str is 1
                        mark_fn_str(nm)
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes below
                    # the frame pointer, so the room has to be a full
                    # slot deeper than the count, or the callee's own
                    # frame lands on top of our spilled values
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes
                    # below the frame pointer, so the room has to be
                    # a full slot deeper than the count, or the
                    # callee's own frame lands on top of our spilled
                    # values
                    if no_frame is 0
                        ns: (_sov_list_len(locals) + 1) * 8
                        if ns < 32
                            ns: 32
                        # pass S5: room for the canary below the
                        # deepest local, still inside the frame
                        if _sov_list_len(cd_at) > 0
                            ns: ns + 16
                        put(pro_at, ns)
                        if fw_on is 1
                            if isfib is 0
                                canary_check()
                                xor_rax()
                                restores()
                                frame_wipe()
                                emit(201)
                                ret()
                                fw_done: 1
                            fwi: 0
                            as long as fwi < _sov_list_len(fw_pos)
                                put(_sov_list_get(fw_pos, fwi), ns + fn_save_n * 8)
                                fwi: fwi + 1
                        # pass S5: patch the canary displacement holes
                        # now - after the end-of-body epilogue has
                        # emitted its own check into the list
                        chi: 0
                        as long as chi < _sov_list_len(cd_at)
                            put(_sov_list_get(cd_at, chi), 8 - ns - fn_save_n * 8)
                            chi: chi + 1
                        cd_at: 0
                    if same(nm, "main") is 1
                        if need_priv is 1
                            emit_stack_wipe()
                        emit(49)
                        emit(255)
                        if rax_small is 1
                            emit(176)
                            emit(60)
                        if not
                            emit_sys_num(60)
                        emit_sys_do()
                    if not
                        # the fib fast path ends in its own leave/ret;
                        # a second epilogue here would be dead bytes
                        if isfib is 0
                            if fw_done is 0
                                xor_rax()
                                leave()
                                ret()
        fi: fi + 1
    if has_vm is 0
        emit_used()
    # pass S5: the canary stub rides even when the program ships
    # its own runtime (has_vm), because private frames can appear
    # in either shape
    if can_used is 1
        emit_canary_fail()
    if need_priv is 1
        emit_crash_handler()
    warn_unused()
    dce()
    stub_diet()
    dce_stores()
    dce_litter()
    dce_globals()
stub_diet:
    if had_err is 1
        return
    if want_args is 0
        return
    # a private program's exit walk anchors on g_argv - the capture
    # block is live even when nothing else reads it (pass 137: the
    # splice also dragged main into the program-header overlay)
    if need_priv is 1
        return
    sd_live: 0
    sd_i: 0
    as long as sd_i < _sov_list_len(patch_kind)
        sd_at2: _sov_list_get(patch_at, sd_i)
        if sd_at2 >= 41
            sd_k: _sov_list_get(patch_kind, sd_i)
            if same(sd_k, "glob") is 1
                sd_v: _sov_list_get(patch_val, sd_i)
                if same(sd_v, "g_argc") is 1
                    sd_live: 1
                if same(sd_v, "g_argv") is 1
                    sd_live: 1
            if same(sd_k, "grel") is 1
                sd_v: _sov_list_get(patch_val, sd_i)
                if same(sd_v, "g_argc") is 1
                    sd_live: 1
                if same(sd_v, "g_argv") is 1
                    sd_live: 1
        sd_i: sd_i + 1
    if sd_live is 1
        return
    sd_cut_at: 0
    sd_cut: 41
    if main_params_n > 0
        sd_cut_at: 15
        sd_cut: 26
    sd_na: _sov_list_new()
    sd_nk: _sov_list_new()
    sd_nv: _sov_list_new()
    sd_nl: _sov_list_new()
    sd_i: 0
    as long as sd_i < _sov_list_len(patch_at)
        sd_at: _sov_list_get(patch_at, sd_i)
        if sd_at < sd_cut_at
            sd_na: _sov_list_add(sd_na, sd_at)
            sd_nk: _sov_list_add(sd_nk, _sov_list_get(patch_kind, sd_i))
            sd_nv: _sov_list_add(sd_nv, _sov_list_get(patch_val, sd_i))
            sd_nl: _sov_list_add(sd_nl, _sov_list_get(patch_line, sd_i))
        if not
            if sd_at >= 41
                sd_na: _sov_list_add(sd_na, sd_at - sd_cut)
                sd_nk: _sov_list_add(sd_nk, _sov_list_get(patch_kind, sd_i))
                sd_nv: _sov_list_add(sd_nv, _sov_list_get(patch_val, sd_i))
                sd_nl: _sov_list_add(sd_nl, _sov_list_get(patch_line, sd_i))
        sd_i: sd_i + 1
    patch_at: sd_na
    patch_kind: sd_nk
    patch_val: sd_nv
    patch_line: sd_nl
    sd_no: _sov_list_new()
    sd_pos: 0
    as long as sd_pos < _sov_list_len(oc)
        if sd_pos is sd_cut_at
            sd_pos: sd_pos + sd_cut
        if not
            sd_no: _sov_list_add(sd_no, _sov_list_get(oc, sd_pos))
            sd_pos: sd_pos + 1
    oc: sd_no
    sd_i: 0
    as long as sd_i < _sov_list_len(fn_offs)
        fn_offs: _sov_list_set(fn_offs, sd_i, _sov_list_get(fn_offs, sd_i) - sd_cut)
        sd_i: sd_i + 1
    want_args: 0
# Pass 105: a global whose every surviving reference is a plain
# store_glob (mov [rip],rax - 48 89 05 <rel32>) is write-only: no load,
# compare or add-to-memory ever observes the value. Paint the store
# bytes with one-byte nops IN PLACE - raw branch displacements (rel8
# and post-relaxation rel32) are baked into the byte stream and must
# not move - and drop the store's grel patch so dce_globals collects
# the 8-byte name. Every other reference shape (loads 48 8b .., movabs
# "glob" forms, lea forms, anything else) counts as a read and
# protects the name.
poke2 p off v:
    dummy: _sov_set_byte(p, off, v % 256)
    dummy: _sov_set_byte(p, off + 1, (v / 256) % 256)
write_elf path:
    if had_err is 1
        return
    clen: _sov_list_len(oc)
    sl: _sov_buf_len(strb)
    # pass S2: the READ+EXECUTE LOAD holds headers and code, nothing
    # else. the READ+WRITE LOAD starts on the next page and holds
    # the literals (they are data: user code may wipe a literal at
    # any moment) and then the globals. the e_ident rider is gone -
    # every literal lives in writable, never-executable memory.
    gfoff: HDR + clen
    as long as gfoff % 4096 is not 0
        gfoff: gfoff + 1
    sl8: sl
    as long as sl8 % 8 is not 0
        sl8: sl8 + 1
    str_off: gfoff - HDR
    str_foff: gfoff
    str_addr: BASE + gfoff
    # pass S7: every absolute qword the code carries is listed in
    # the table; _start adds the slide to each before main runs.
    # the count is known by walking the patch list once before any
    # address is chosen, because the table's own size moves the
    # globals - a second pass collects as it patches
    rel_off: gfoff + sl8
    rel_n: 0
    rc_i: 0
    as long as rc_i < _sov_list_len(patch_at)
        rk: _sov_list_get(patch_kind, rc_i)
        if same(rk, "fnaddr") is 1
            rel_n: rel_n + 1
        if same(rk, "str") is 1
            rel_n: rel_n + 1
        if same(rk, "glob") is 1
            rel_n: rel_n + 1
        if same(rk, "gwstr_a") is 1
            rel_n: rel_n + 1
        if same(rk, "gwipe_a") is 1
            rel_n: rel_n + 1
        if same(rk, "sbss") is 1
            rel_n: rel_n + 1
        rc_i: rc_i + 1
    relsz: 8 + rel_n * 8
    glob_off: rel_off + relsz - HDR
    pad: _sov_list_len(glob_names) * 8
    filesz: rel_off + relsz + pad
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    dummy: _sov_set_byte(flat, 0, 127)
    dummy: _sov_set_byte(flat, 1, 69)
    dummy: _sov_set_byte(flat, 2, 76)
    dummy: _sov_set_byte(flat, 3, 70)
    dummy: _sov_set_byte(flat, 4, 2)
    dummy: _sov_set_byte(flat, 5, 1)
    dummy: _sov_set_byte(flat, 6, 1)
    # pass S7: type DYN - the kernel chooses the load address; the
    # entry stays image-absolute because the bias excludes p_vaddr
    poke2(flat, 16, 3)
    poke2(flat, 18, 62)
    poke4(flat, 20, 1)
    moff: 0
    if thin_main is 1
        mi: idx(fn_names, "main")
        if mi > 0 - 1
            moff: _sov_list_get(fn_offs, mi)
    # pass S7: the entry is the start of the _start block itself.
    # the entry must never point straight at a thin main's body:
    # that would skip the relocation walk that runs first
    poke8(flat, 24, BASE + HDR)
    poke8(flat, 32, 64)
    poke2(flat, 52, 64)
    poke2(flat, 54, 56)
    poke2(flat, 56, 3)
    poke4(flat, 64, 1)
    poke8(flat, 80, BASE)
    poke8(flat, 88, BASE)
    poke8(flat, 96, gfoff)
    sbtot: 0
    sw: 0
    as long as sw < _sov_list_len(sbss_sizes)
        swv: _sov_list_get(sbss_sizes, sw)
        sbtot: sbtot + 15
        sbtot: sbtot - sbtot % 16
        sbtot: sbtot + swv
        sw: sw + 1
    # pass S1 kept the old single-segment shape; S2 splits it:
    # seg1 above is READ+EXECUTE only
    poke4(flat, 68, 5)
    poke8(flat, 104, gfoff)
    poke8(flat, 112, 4096)
    # seg2: the globals page(s), READ+WRITE, never EXECUTE
    poke4(flat, 120, 1)
    poke4(flat, 124, 6)
    poke8(flat, 128, gfoff)
    poke8(flat, 136, BASE + gfoff)
    poke8(flat, 144, BASE + gfoff)
    poke8(flat, 152, sl8 + relsz + pad)
    poke8(flat, 160, sl8 + relsz + pad + sbtot + 65536)
    poke8(flat, 168, 4096)
    # PT_GNU_STACK = 0x6474E551, READ|WRITE, never EXECUTE
    poke4(flat, 176, 1685382481)
    poke4(flat, 180, 6)
    poke8(flat, 224, 16)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, HDR + i,  _sov_list_get(oc, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, str_foff + si, _sov_buf_at(strb, si))
        si: si + 1
    glob_addr: BASE + HDR + glob_off
    rel_at: 0
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_val, i)
        if same(kind, "rel") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: tgt - (at + 4)
                poke4(flat, HDR + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                err_line: _sov_list_get(patch_line, i)
                err_where()
                suggest_name(val)
                had_err: 1
        if same(kind, "fnaddr") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                poke8(flat, HDR + at, BASE + HDR + _sov_list_get(fn_offs, fi))
                rel_at: _sov_list_add(rel_at, at)
            if not
                print "Error: no such task"
                _sov_print(val)
                had_err: 1
        if same(kind, "str") is 1
            poke8(flat, HDR + at, str_addr + val)
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "str32") is 1
            poke4(flat, HDR + at, str_addr + val)
        if same(kind, "grel") is 1
            gx: idx(glob_names, val)
            poke4(flat, HDR + at, glob_addr + gx * 8 - (BASE + HDR + at + 4))
        if same(kind, "glob") is 1
            gx: idx(glob_names, val)
            poke8(flat, HDR + at, glob_addr + gx * 8)
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "gwstr_a") is 1
            poke8(flat, HDR + at, str_addr)
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "gwstr_n") is 1
            poke4(flat, HDR + at, (sl + 7) / 8)
        if same(kind, "gwipe_a") is 1
            poke8(flat, HDR + at, glob_addr)
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "gwipe_n") is 1
            gbytes: _sov_list_len(glob_names) * 8 + sbtot
            poke4(flat, HDR + at, (gbytes + 7) / 8)
        if same(kind, "sbss") is 1
            # static blocks live past the file image, each 16-aligned
            bi: _sov_atoi(val)
            baddr: glob_addr + _sov_list_len(glob_names) * 8
            bj: 0
            as long as bj < bi
                bs: _sov_list_get(sbss_sizes, bj)
                baddr: baddr + 15
                baddr: baddr - baddr % 16
                baddr: baddr + bs
                bj: bj + 1
            baddr: baddr + 15
            baddr: baddr - baddr % 16
            poke8(flat, HDR + at, baddr)
            rel_at: _sov_list_add(rel_at, at)
        i: i + 1
    if had_err is 1
        return
    # pass S7: the table itself, then the two holes in _start and
    # the self pointer g_slide carries at link time
    if rel_n > 0
        poke8(flat, rel_off, rel_n)
        ri: 0
        as long as ri < rel_n
            poke8(flat, rel_off + 8 + ri * 8, HDR + _sov_list_get(rel_at, ri))
            ri: ri + 1
    if 1 is 1
        sxi: 0
        as long as sxi < _sov_list_len(patch_at)
            if same(_sov_list_get(patch_kind, sxi), "rel_a") is 1
                poke8(flat, HDR + _sov_list_get(patch_at, sxi), BASE + rel_off)
            if same(_sov_list_get(patch_kind, sxi), "rel_n") is 1
                poke4(flat, HDR + _sov_list_get(patch_at, sxi), rel_n)
            if same(_sov_list_get(patch_kind, sxi), "rel_l") is 1
                poke8(flat, HDR + _sov_list_get(patch_at, sxi), gfoff)
            sxi: sxi + 1
    gsx: idx(glob_names, "g_slide")
    if gsx > 0 - 1
        poke8(flat, rel_off + relsz + gsx * 8, glob_addr + gsx * 8)

    w: _sov_write_n(path, flat, filesz)
    if w is 0
        print "Error: cannot write output (is it running?)"
        fail()
    if need_priv is 1
        # pass 140: a private program's binary carries its secrets -
        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
    # the line map for --debug, written inline (see the note at the
    # hook in stmt: this code must not live in a separate task).
    if dbg_mode is 1
        if dbg_pcs is not 0
            dig: "0123456789"
            m: "# src_base "
            sv: src_base
            st: blank
            sg: 1
            as long as sg is 1
                st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                sv: sv / 10
                if sv is 0
                    sg: 0
            m: join(m, st)
            mi: 0
            as long as mi < _sov_list_len(dbg_pcs)
                pc: _sov_list_get(dbg_pcs, mi)
                ln: _sov_list_get(dbg_lns, mi)
                sv: pc + HDR
                st: blank
                sg: 1
                as long as sg is 1
                    st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                    sv: sv / 10
                    if sv is 0
                        sg: 0
                m: join(m, "\n")
                m: join(m, st)
                sv: ln
                st: blank
                sg: 1
                as long as sg is 1
                    st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                    sv: sv / 10
                    if sv is 0
                        sg: 0
                m: join(m, " ")
                m: join(m, st)
                mi: mi + 1
            m: join(m, "\n")
            file_write_all(join(path, ".map"), m)

# ---- the three dev flags: --fmt, --run, --debug -------------------
# --debug's recording and map writing live inline in stmt and
# write_elf (not in separate tasks): at some source layouts the
# compiler's frame handling breaks for such tasks called from those
# two hot functions; the inline form sidesteps it. see HANDOFF.

# indent_of counts leading blanks as the column width they occupy;
# a tab is four. strip_trail chomps trailing blanks.

indent_of t:
    n: length(t)
    i: 0
    w: 0
    as long as i < n
        b: peek_byte(t, i)
        if b is 32
            w: w + 1
        if not
            if b is 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w

strip_trail t:
    n: length(t)
    as long as n > 0
        b: peek_byte(t, n - 1)
        if b is 32
            n: n - 1
        if not
            if b is 9
                n: n - 1
            if not
                return cut(t, 0, n)
    return blank

space_make n:
    s: blank
    i: 0
    as long as i < n
        s: join(s, " ")
        i: i + 1
    return s

# --fmt rewrites a source file in place, touching nothing but
# whitespace: trailing blanks come off, and indentation snaps to the
# file's own unit (the more common of 2 and 4). it is provably safe -
# the battery checks that fmt is idempotent and that a formatted file
# builds byte-identical to the original.

fmt_file path:
    s: load_file(path)
    if s is 0
        print "Error: cannot read input"
        fail()
    ls: lines_of(s)
    n2: 0
    n4: 0
    i: 0
    as long as i < _sov_list_len(ls)
        ind: indent_of(_sov_list_get(ls, i))
        if ind > 1
            if ind % 4 is 0
                n4: n4 + 1
            if not
                n2: n2 + 1
        i: i + 1
    unit: 4
    if n2 > n4
        unit: 2
    i: 0
    out: blank
    as long as i < _sov_list_len(ls)
        t: _sov_list_get(ls, i)
        t: strip_trail(t)
        ind: indent_of(t)
        if ind > 0
            rest: cut(t, ind, length(t))
            q: ind / unit
            if (ind % unit) * 2 >= unit
                q: q + 1
            if q < 1
                q: 1
            t: join(space_make(q * unit), rest)
        if i is 0
            out: t
        if not
            out: join(join(out, "\n"), t)
        i: i + 1
    if file_write_all(path, out) is 0
        print "Error: cannot write"
        _sov_print(path)
        fail()
    print "Formatted"
    _sov_print(path)
    return 1

# --run: after a clean build, fork; the child becomes the program,
# the parent waits and relays its exit code. the program gets the
# command line minus the compiler's own flags.

run_prog path argv argc:
    pid: sys_fork()
    if pid is 0
        argv2: _sov_alloc(512)
        poke_i64(argv2, 0, path)
        k: 1
        i: 1
        as long as i < argc
            a: peek_ptr(argv, i)
            keep: 1
            if same(a, "-o") is 1
                keep: 0
                i: i + 1
            if not
                if same(a, "--run") is 1
                    keep: 0
                if not
                    if same(a, "--fmt") is 1
                        keep: 0
                    if not
                        if same(a, "--debug") is 1
                            keep: 0
                        if not
                            if same(a, "--bare") is 1
                                keep: 0
                            if not
                                if same(a, path) is 1
                                    keep: 0
            if keep is 1
                poke_i64(argv2, k * 8, a)
                k: k + 1
            i: i + 1
        poke_i64(argv2, k * 8, 0)
        sys_exec(path, argv2, 0)
        sys_exit(127)
    w: sys_wait(pid)
    sys_exit(w / 256)

main argc argv:
    # remember where this compiler lives, so its library and runtime
    # are found no matter which folder you run it from
    self_dir: dirname(tidy_path(peek_ptr(argv, 0)))
    dbg_pcs: _sov_list_new()
    dbg_lns: _sov_list_new()
    if argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail()
    inf: blank
    outf: blank
    i: 1
    as long as i < argc
        arg: peek_ptr(argv, i)
        if same(arg, "--bare") is 1
            bare_mode: 1
        if not
            if same(arg, "--run") is 1
                run_mode: 1
            if not
                if same(arg, "--fmt") is 1
                    fmt_mode: 1
                if not
                    if same(arg, "--debug") is 1
                        dbg_mode: 1
                    if not
                        if same(arg, "-o") is 1
                            i: i + 1
                            if i < argc
                                outf: peek_ptr(argv, i)
                        if not
                            if same(arg, "build") is 0
                                inf: arg
        i: i + 1
    if length(inf) is 0
        print "Error: no input"
        fail()
    if fmt_mode is 1
        fmt_file(inf)
        sys_exit(0)
    if length(outf) is 0
        d: look(inf, ".sov")
        if d > 0 - 1
            outf: cut(inf, 0, d)
        if not
            outf: join(inf, ".out")
    src_name: inf
    print "Compiling"
    _sov_print(inf)
    src: load_file(inf)
    if src is 0
        print "Error: cannot read input"
        fail()
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    src: join(join("# pad line so main is not first", nl), src)
    used_libs: blank
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    need: 0
    mmap_sz: 12582912
    if look(src, "_sov_list") > 0 - 1
        need: 1
    if look(src, "load_file") > 0 - 1
        need: 1
    if look(src, "_sov_buf") > 0 - 1
        need: 1
    if look(src, "_sov_alloc") > 0 - 1
        need: 1
    if look(src, "_sov_set_byte") > 0 - 1
        need: 1
    if look(src, "peek_byte") > 0 - 1
        need: 1
    if look(src, "poke_byte") > 0 - 1
        need: 1
    if look(src, "spawn ") > 0 - 1
        need: 1
    if look(src, "join ") > 0 - 1
        need: 1
    rt: blank
    if bare_mode is 1
        need: 0
    if need is 1
        mmap_sz: 1073741824
        rt: load_file("runtime.sov")
        if rt is 0
            rt: load_file("linux/runtime.sov")
        if rt is 0
            rt: load_file(join(self_dir, "/runtime.sov"))
        if rt is 0
            rt: load_file(join(self_dir, "/../runtime.sov"))
        if rt is 0
            print "Error: cannot read runtime"
            fail()
    src_base: 1
    if length(rt) > 0
        src_base: src_base + _sov_list_len(lines_of(rt))
    if length(extra) > 0
        src_base: src_base + _sov_list_len(lines_of(extra))
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    all: join(rt, nl)
    src_base: src_base + 1
    if need is 1
        # the runtime's thread paths end themselves through this
        # injected task; on linux a thread is a forked process or a
        # detached clone, so ending it is the exit syscall
        all: join(all, nl)
        all: join(all, join("_sov_thread_exit:", nl))
        all: join(all, join("    syscall(60, 0, 0, 0, 0, 0, 0)", nl))
        all: join(all, join("    return 0 - 1", nl))
        src_base: src_base + 4
    all: join(all, src)
    compile(all)
    write_elf(outf)
    if had_err is 1
        fail()
    print "Wrote"
    _sov_print(outf)
    if run_mode is 1
        run_prog(outf, argv, argc)
