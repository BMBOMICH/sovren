BASE: 4194304
# pass S1+S2: three program headers - the code LOAD is now
# READ+EXECUTE (never writable: nothing may patch live code),
# the globals LOAD is READ+WRITE at a page boundary (globals,
# static blocks, arena slack), and PT_GNU_STACK READ|WRITE keeps
# the stack non-executable. HDR = ehdr + 3 phdrs.
HDR: 232
opt_imm: 0
opt_src: 0
iota_ptr: 0
iota_lim: 0
mmap_sz: 1073741824
used_libs: blank
err_line: 0
kn: blank
kv: 0
pro_at: 0
fw_on: 0
fw_pos: 0
skip_al: blank
used_al: 0
self_dir: 0
want_args: 0
used_sl: 0
used_eq: 0
used_pr: 0
used_pi: 0
did_stos: 0
use cx86
thin_main: 0

main: 0
has_vm: 0
leaf8: 0
