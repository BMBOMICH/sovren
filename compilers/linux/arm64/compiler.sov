        t: strip_trail(t) ;; ind: indent_of(t)
        if ind > 0 -> rest: cut(t, ind, length(t))
            q: ind / unit ;; if (ind % unit) * 2 >= unit -> q: q + 1
            if q < 1 -> q: 1 ;; t: join(space_make(q * unit), rest)
        if i = 0 -> out: t
        if not -> out: join(join(out, "\n"), t)
        i: i + 1
    if file_write_all(path, out) = 0 -> print 'Error: cannot write'
        _sov_print(path) ;; fail()
    print 'Formatted'
    _sov_print(path) ;; return 1
run_prog path argv argc:
    pid: sys_fork() ;; if pid = 0 -> argv2: _sov_heap_alloc(512)
        poke_i64(argv2, 0, path)
        include inc/px00.sov 212 4 (1 k i i argc a peek_ptr argv i)
            keep: 1
            if _sov_str_eq(a, '-o') = 1 -> keep: 0
                i: i + 1
            include inc/px00.sov 910 4 (a run keep 0 a fmt keep 0)
                    include inc/px00.sov 910 4 (a debug keep 0 a flat keep 0)
                            if _sov_str_eq(a, '--bare') = 1 -> keep: 0
                            if not -> if _sov_str_eq(a, path) = 1
                                    keep: 0
            if keep = 1 -> poke_i64(argv2, k * 8, a)
                k: k + 1
            i: i + 1
        poke_i64(argv2, k * 8, 0) ;; sys_exec(path, argv2, 0)
        sys_exit(127)
    w: sys_wait(pid) ;; sys_exit(w / 256)
main argc argv:
    if argc < 2 -> print 'Usage: sovren <file.sov> [-o out]'
        print 'sovren — native x86-64, self-contained'
        fail()
    blank:
        inf
        outf
    include inc/inc04.sov 364 3
        include inc/px00.sov 910 4 (arg run run_mode 1 arg fmt fmt_mode 1)
                include inc/px00.sov 910 4 (arg debug dbg_mode 1 arg bytes bytes_mode 1)
                        if not -> if _sov_str_eq(arg, '--plain') = 1
                                opt_peep: 0
                            if not -> if _sov_str_eq(arg, '-o') = 1
                                    i: i + 1 ;; if i < argc -> outf: peek_ptr(argv, i)
                                if not -> if starts(arg, '--') = 0
                                        if _sov_str_eq(arg, 'build') = 0 -> outf: pic_io(inf, outf, arg) ;; if _sov_str_eq(arg, 'build') = 0 -> inf: pic_in(inf, arg)
        i: i + 1
    i2: 1
    as long as i2 < argc -> if _sov_str_eq(peek_ptr(argv, i2), '--kernel') = 1
            kern_mode: 1
        if _sov_str_eq(peek_ptr(argv, i2), '--release') = 1 -> opt_dce: 1
        if _sov_str_eq(peek_ptr(argv, i2), '--unsafe') = 1 -> unsafe_mode: 1
        if _sov_str_eq(peek_ptr(argv, i2), '--sxe') = 1 -> sxe_mode: 1
        if _sov_str_eq(peek_ptr(argv, i2), '--flat') = 1 -> flat_mode: 1
        if _sov_str_eq(peek_ptr(argv, i2), '--prof') = 1 -> prof_mode: 1
        if _sov_str_eq(peek_ptr(argv, i2), '--sxe-compact') = 1 -> 1:
                sxe_mode
                sxe_compact
        i2: i2 + 1
    if length(inf) = 0 -> print 'Error: no input'
        fail()
    if fmt_mode = 1 -> fmt_file(inf)
        sys_exit(0)
    mark('0-flags+input')
    pb_enum_ok: 1
    include inc/inc06.sov 86 3
        if sxe_mode = 1 -> rt: repl(rt, 'syscall(186, 0, 0, 0, 0, 0, 0)', '0 - 38')
        if kern_mode = 1 -> rt: repl(rt, 'syscall(186, 0, 0, 0, 0, 0, 0)', '0 - 38')
    _sov_list_new():
        dbg_pcs
        dbg_lns
    if length(rt) > 0 -> if look(rt, join(" ->", "> ")) > 0 - 1 -> rt: std_forms(rt)
        if look(rt, join(" -", "> ")) > 0 - 1 -> rt: std_forms(rt)
    mark('1-rt-loaded')
    u_parts_done: 1
    include inc/inc05.sov 743 3
        if sxe_mode = 1 -> all: join(all, join('    sovcall(60, 0, 0, 0, 0, 0)', nl))
        if not -> all: join(all, join('    syscall(60, 0, 0, 0, 0, 0, 0)', nl))
        all: join(all, join('    return 0 - 1', nl))
        src_base: src_base + 4
    mark('2-all-spliced')
    include inc/inc00.sov 413 10
    mark('3-scanned')
    include inc/inc00.sov 491 9
    mark('4-compiled')
    if bytes_mode = 1 -> nb: oc_n
        bb: _sov_heap_alloc(nb) ;; bi2: 0
        as long as bi2 < nb -> poke_byte(bb, bi2, peek_byte(oc, bi2))
            bi2: bi2 + 1
        file_write_bytes(str_cat(outf, '.bin'), bb, nb)
        mt: ''
        mi2: 0 ;; mi2_ln: _sov_list_len(fn_names) ;; as long as mi2 < mi2_ln -> mt: str_cat(mt, peek_i64(fn_names, 16 + mi2 * 8))
            mt: str_cat(mt, ' ')
            mv: _sov_list_get(fn_offs, mi2)
            mlt: ''
            if mv = 0 -> mlt: '0'
            as long as mv > 0 -> mlt: str_cat(str_chr(48 + mv % 10), mlt)
                mv: mv / 10
            mt: str_cat:
                mlt ;; str_chr(10)
            mv: mv / 10 ;; mi2: mi2 + 1
        file_write_all(str_cat(outf, '.map'), mt)
    include inc/inc02.sov 645 3
    if run_mode = 1 -> run_prog(outf, argv, argc) ;; sys_exit(0)

# ---- WP1 in-process phase clock: --prof prints label then microseconds since
#      the previous mark.  syscall 228 is clock_gettime(CLOCK_MONOTONIC).
prof_mode: 0
prof_buf: 0
prof_t0: 0
now_ns:
    if prof_buf = 0 -> prof_buf: _sov_alloc(64)
    dummy: syscall(228, 1, prof_buf, 0, 0, 0, 0)
    s: peek_i64(prof_buf, 0)
    n: peek_i64(prof_buf, 8)
    return s * 1000000000 + n
mark label:
    if prof_mode = 0 -> return 0
    t: now_ns()
    if prof_t0 = 0 -> prof_t0: t
    d: (t - prof_t0) / 1000
    _sov_print(label)
    print d
    prof_t0: t
    return t
    mark('5-written')

#      rebuilds in a child instead of writing bytes nobody asked for.

# sds_sum_path — the checksum file is keyed by the running binary: two
# different builds compiling the same source keep separate sums, so neither
# binary via sd_keyv; the shared sum slot was the one unkeyed artifact)

