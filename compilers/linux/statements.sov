# unsafe-module
# Per-body structured statement IR, freshly constructed before emission.
# No source keys, result reuse, cross-compilation state, or artifact caching.
syntax_body_lines: 0
syntax_body_ir: 0
syntax_statement_trees: 0
syntax_statement_native_trees: 0
syntax_statement_nodes: 0
syntax_statement_build sx_lines sx_out sx_arena sx_parser:
    if sx_out is 0
        sx_budget: 0
        sx_i: 0
        as long as sx_i < _sov_list_len(sx_lines)
            sx_ptr: peek_i64(sx_lines, 16 + sx_i * 8)
            sx_budget: sx_budget + 128 + (length(sx_ptr) + 1) * 64
            sx_i: sx_i + 1
        return sx_budget
    # Source reference for the native metadata builder.
    bt_prep(sx_lines)
    sx_n: _sov_list_len(sx_lines)
    poke_i64(sx_out, 0, sx_lines)
    poke_i64(sx_out, 8, sx_n)
    sx_depth: 0
    sx_i: 0
    as long as sx_i < sx_n
        sx_ptr: peek_i64(sx_lines, 16 + sx_i * 8)
        sx_len: length(sx_ptr)
        sx_ind: peek_i64(bt_ind, 16 + sx_i * 8)
        poke_i64(sx_out, 16 + sx_i * 8, peek_i64(bt_m, 16 + sx_i * 8))
        poke_i64(sx_out, 16 + (sx_n + sx_i) * 8, sx_ind)
        poke_i64(sx_out, 16 + (sx_n * 2 + sx_i) * 8, peek_i64(bt_col, 16 + sx_i * 8))
        poke_i64(sx_out, 16 + (sx_n * 3 + sx_i) * 8, peek_i64(bt_eq, 16 + sx_i * 8))
        poke_i64(sx_out, 16 + (sx_n * 4 + sx_i) * 8, peek_i64(bt_tab, 16 + sx_i * 8))
        poke_i64(sx_out, 16 + (sx_n * 5 + sx_i) * 8, peek_i64(bt_tr, 16 + sx_i * 8))
        poke_i64(sx_out, 16 + (sx_n * 6 + sx_i) * 8, sx_len)
        poke_i64(sx_out, 16 + (sx_n * 7 + sx_i) * 8, 0 - 1)
        poke_i64(sx_out, 16 + (sx_n * 8 + sx_i) * 8, sx_n)
        sx_first: sx_ind
        as long as sx_first < sx_len
            if peek_byte(sx_ptr, sx_first) > 32 -> leave
            sx_first: sx_first + 1
        sx_head: sx_first
        as long as sx_head < sx_len
            sx_c: peek_byte(sx_ptr, sx_head)
            if sx_c <= 32 -> leave
            if sx_c is 58 or sx_c is 40 -> leave
            sx_head: sx_head + 1
        poke_i64(sx_out, 16 + (sx_n * 10 + sx_i) * 8, sx_head)
        sx_live: 0
        if sx_first < sx_len
            if peek_byte(sx_ptr, sx_first) is not 35 -> sx_live: 1
        poke_i64(sx_out, 16 + (sx_n * 9 + sx_i) * 8, sx_live)
        if sx_live is 1
            as long as sx_depth > 0
                sx_parent: peek_i64(sx_out, 16 + (sx_n * 11 + sx_depth - 1) * 8)
                if peek_i64(sx_out, 16 + (sx_n + sx_parent) * 8) < sx_ind -> leave
                poke_i64(sx_out, 16 + (sx_n * 8 + sx_parent) * 8, sx_i)
                sx_depth: sx_depth - 1
            if sx_depth > 0
                sx_parent: peek_i64(sx_out, 16 + (sx_n * 11 + sx_depth - 1) * 8)
                poke_i64(sx_out, 16 + (sx_n * 7 + sx_i) * 8, sx_parent)
            poke_i64(sx_out, 16 + (sx_n * 11 + sx_depth) * 8, sx_i)
            sx_depth: sx_depth + 1
        poke_i64(sx_out, 16 + (sx_n * 12 + sx_i) * 8, 0)
        poke_i64(sx_out, 16 + (sx_n * 13 + sx_i) * 8, 0)
        sx_i: sx_i + 1
    sx_bad: 0
    sx_i: 0
    as long as sx_i < sx_n
        if peek_i64(sx_out, 16 + (sx_n * 4 + sx_i) * 8) is not 0 -> sx_bad: sx_bad + 1
        poke_i64(sx_out, 16 + (sx_n * 11 + sx_i) * 8, sx_bad)
        sx_i: sx_i + 1
    return sx_n
syntax_prepare_statements sx_lines:
    sx_n: _sov_list_len(sx_lines)
    syntax_loop_trees: list_reuse(syntax_loop_trees)
    syntax_body_lines: sx_lines
    if syntax_body_ir is 0 or sx_n > syntax_body_ir_cap
        syntax_body_ir_cap: 16
        as long as syntax_body_ir_cap < sx_n
            syntax_body_ir_cap: syntax_body_ir_cap * 2
        syntax_body_ir: _sov_heap_alloc(16 + syntax_body_ir_cap * 112)
    if syntax_body_arena is 0
        syntax_body_arena_cap: 4194304
        syntax_body_arena: _sov_heap_alloc(syntax_body_arena_cap)
    poke_i64(syntax_body_ir, 0, 773411)
    poke_i64(syntax_body_ir, 8, syntax_body_arena_cap)
    if syntax_statement_build(sx_lines, syntax_body_ir, syntax_body_arena, addr_of syntax_build) is 0 - 1
        sx_bytes: syntax_statement_build(sx_lines, 0, 0, 0)
        as long as syntax_body_arena_cap < sx_bytes + 164096
            syntax_body_arena_cap: syntax_body_arena_cap * 2
        syntax_body_arena: _sov_heap_alloc(syntax_body_arena_cap)
        poke_i64(syntax_body_ir, 0, 773411)
        poke_i64(syntax_body_ir, 8, syntax_body_arena_cap)
        syntax_statement_build(sx_lines, syntax_body_ir, syntax_body_arena, addr_of syntax_build)
    if prof_mode is 1
        sx_pi: 0
        as long as sx_pi < sx_n
            sx_pt: peek_i64(syntax_body_ir, 16 + (sx_n * 12 + sx_pi) * 8)
            if sx_pt is not 0
                syntax_statement_trees: syntax_statement_trees + 1
                syntax_statement_nodes: syntax_statement_nodes + peek_i64(sx_pt, 16)
                if peek_i64(sx_pt, 56) is 86042493933125
                    syntax_statement_native_trees: syntax_statement_native_trees + 1
            sx_pi: sx_pi + 1
    bt_n: sx_n
    bt_m: syntax_body_ir
    bt_ind: syntax_body_ir + sx_n * 8
    bt_col: syntax_body_ir + sx_n * 16
    bt_eq: syntax_body_ir + sx_n * 24
    bt_tab: syntax_body_ir + sx_n * 32
    bt_tr: syntax_body_ir + sx_n * 40
    bt_cap: 0
    return 0
syntax_block_end sx_lines sx_start sx_indent:
    if sx_lines is not syntax_body_lines -> return 0 - 1
    if syntax_body_ir is 0 -> return 0 - 1
    sx_n: peek_i64(syntax_body_ir, 8)
    if sx_start < 1 -> return 0 - 1
    if sx_start > sx_n -> return 0 - 1
    sx_header: sx_start - 1
    if peek_i64(syntax_body_ir, 16 + (sx_n * 9 + sx_header) * 8) is 0 -> return 0 - 1
    if peek_i64(syntax_body_ir, 16 + (sx_n + sx_header) * 8) is not sx_indent -> return 0 - 1
    sx_end: peek_i64(syntax_body_ir, 16 + (sx_n * 8 + sx_header) * 8)
    if sx_end > sx_start
        sx_before: peek_i64(syntax_body_ir, 16 + (sx_n * 11 + sx_header) * 8)
        sx_after: peek_i64(syntax_body_ir, 16 + (sx_n * 11 + sx_end - 1) * 8)
        if sx_after > sx_before -> return 0 - 1
    return sx_end
include statements_native.sov

syntax_body_ir_cap: 0
syntax_body_arena: 0
syntax_body_arena_cap: 0
syntax_stmt_tree: 0
syntax_stmt_role: 0
syntax_stmt_line: 0
syntax_stmt_roots: 0
syntax_select_statement sx_lines sx_index sx_raw sx_text:
    syntax_stmt_tree: 0
    syntax_stmt_role: 0
    syntax_stmt_line: 0
    if syntax_mode is not 1 -> return 0
    if sx_lines is not syntax_body_lines -> return 0
    sx_n: peek_i64(syntax_body_ir, 8)
    if sx_index >= sx_n -> return 0
    if peek_i64(sx_lines, 16 + sx_index * 8) is not sx_raw -> return 0
    syntax_stmt_tree: peek_i64(syntax_body_ir, 16 + (sx_n * 12 + sx_index) * 8)
    syntax_stmt_role: peek_i64(syntax_body_ir, 16 + (sx_n * 13 + sx_index) * 8)
    syntax_stmt_line: sx_text
    return 0
syntax_stmt_expr sx_tree sx_role sx_expected sx_text:
    if sx_tree is 0 -> return expr(sx_text)
    if sx_role is not sx_expected -> return expr(sx_text)
    return syntax_stmt_lower(sx_tree)
syntax_stmt_lower sx_tree:
    if prof_mode is 1 -> syntax_stmt_roots: syntax_stmt_roots + 1
    ex_depth: ex_depth + 1
    if ex_depth > 150
        if had_err is 0
            print "Error: expression too long, split it up"
            err_where()
            had_err: 1
        ex_depth: ex_depth - 1
        xor_rax()
        return 0
    if sx_tbl is 0 -> sx_tbl_init()
    sx_result: _sov_emit_tw(sx_tree, peek_i64(sx_tree, 48), sx_tbl)
    ex_depth: ex_depth - 1
    return sx_result

syntax_loop_trees: 0
syntax_stmt_fuse sx_tree sx_role sx_text sx_inverse:
    if sx_tree is 0 -> return fuse_cmp(sx_text, sx_inverse)
    if sx_role is not 2 -> return fuse_cmp(sx_text, sx_inverse)
    if prof_mode is 1 -> syntax_stmt_roots: syntax_stmt_roots + 1
    return syntax_fuse_tree(sx_tree, sx_inverse)
syntax_set_loop_tree sx_index sx_tree sx_role:
    if syntax_mode is not 1 -> return 0
    as long as _sov_list_len(syntax_loop_trees) <= sx_index
        syntax_loop_trees: _sov_list_add(syntax_loop_trees, 0)
    if sx_role is not 2 -> sx_tree: 0
    poke_i64(syntax_loop_trees, 16 + sx_index * 8, sx_tree)
    return 0
syntax_loop_fuse sx_index sx_text sx_inverse:
    if syntax_mode is 1
        if sx_index < _sov_list_len(syntax_loop_trees)
            sx_tree: peek_i64(syntax_loop_trees, 16 + sx_index * 8)
            poke_i64(syntax_loop_trees, 16 + sx_index * 8, 0)
            if sx_tree is not 0
                if prof_mode is 1 -> syntax_stmt_roots: syntax_stmt_roots + 1
                return syntax_fuse_tree(sx_tree, sx_inverse)
    return fuse_cmp(sx_text, sx_inverse)

syntax_fast_assignment sx_tree sx_role sx_var sx_rhs:
    if sx_tree is 0 -> return 0
    if sx_role is not 1 -> return 0
    sx_rec: sx_tree + 128 + peek_i64(sx_tree, 48) * 40
    sx_kind: peek_i64(sx_rec, 0)
    if sx_kind is 264
        if cp_nm is not 0
            if _sov_str_eq(cp_nm, sx_var) is 1 -> cp_nm: 0
        sx_value: peek_i64(sx_rec, 24)
        if digitb(peek_byte(sx_rhs, 0)) is 1
            if br_depth is 0 and has_vm is 0
                if prof_mode is 1 -> syntax_stmt_roots: syntax_stmt_roots + 1
                cset(sx_var, sx_value)
                if sx_value > 0
                    kn: sx_var
                    kv: sx_value
                    plog_kn(sx_value, sx_var)
                drop_str(sx_var)
                return 1
            if peek_byte(sx_rhs, 0) is 48 and peek_byte(sx_rhs, 1) is 0
                sx_zl: lshf2(sx_var)
                if sx_zl > 0 - 1
                    if gn_lookup(sx_var) < 0
                        if sx_zl < 5
                            if prof_mode is 1 -> syntax_stmt_roots: syntax_stmt_roots + 1
                            cset(sx_var, 0)
                            if sx_zl is 0
                                emit3(72, 49, 219)
                            if not
                                emit2(77, 49)
                                emit(192 + 9 * (sx_zl + 3))
                            sx_zi: cn_lookup(sx_var)
                            cemt: _sov_list_set(cemt, sx_zi, 1)
                            plog_str(4, sx_var)
                            drop_str(sx_var)
                            return 1
                        if leaf8 is 1 and sx_zl < 9
                            if prof_mode is 1 -> syntax_stmt_roots: syntax_stmt_roots + 1
                            cset(sx_var, 0)
                            emit2(77, 49)
                            emit(192 + 9 * (sx_zl - 5))
                            sx_zi: cn_lookup(sx_var)
                            cemt: _sov_list_set(cemt, sx_zi, 1)
                            plog_str(4, sx_var)
                            drop_str(sx_var)
                            return 1
        if prof_mode is 1 -> syntax_stmt_roots: syntax_stmt_roots + 1
        rax_imm(sx_value)
        storev(sx_var)
        drop_str(sx_var)
        return 1
    if sx_kind is 265
        if expr_atom_word(sx_rhs) is 1
            if prof_mode is 1 -> syntax_stmt_roots: syntax_stmt_roots + 1
            if cp_nm is not 0
                if _sov_str_eq(cp_nm, sx_var) is 1 -> cp_nm: 0
            if sv_lookup(sx_var) < 0 and sv_lookup(sx_rhs) < 0
                sx_dst: regslot2(sx_var)
                sx_src: regslot2(sx_rhs)
                if sx_dst >= 0 and sx_src >= 0
                    cflush(sx_rhs)
                    emit_mov_slot(sx_src, sx_dst)
                    drop_str(sx_var)
                    return 1
            loadv(sx_rhs)
            storev(sx_var)
            drop_str(sx_var)
            return 1
    return 0


# --- bw attack phase B: native lowering dispatch over the native statement IR.
# _sov_emit_tw is the twin-planted entry (emit_native.sov); the _sov_ prefix
# makes walk_range consult nt_will_twin for it with NO sx_force_native line
# (compiler.sov stays byte-identical to the certified tree). The interpreted
# body below is the fallback for programs without the compiler-internals gate.
# sx_tbl carries function pointers (Sovren ABI), interned word ids, and the
# message strings; see tools/native/native_emit.c for the slot layout.
sx_tbl: 0
sx_tw_ap: 0
sx_tw_m0: 0
sx_tw_m1: 0
sx_tw_m2: 0
sx_tbl_init:
    kid_init()
    if sx_dec_str is 0 -> sx_dec_init()
    sx_tbl: _sov_heap_alloc(480)
    poke_i64(sx_tbl, 0, 60)
    poke_i64(sx_tbl, 8, addr_of syntax_emit)
    poke_i64(sx_tbl, 16, addr_of syntax_call)
    poke_i64(sx_tbl, 24, addr_of syntax_prefix)
    poke_i64(sx_tbl, 32, addr_of rax_imm)
    poke_i64(sx_tbl, 40, addr_of rax_str)
    poke_i64(sx_tbl, 48, addr_of xor_rax)
    poke_i64(sx_tbl, 56, addr_of loadv)
    poke_i64(sx_tbl, 64, addr_of atom_str_type)
    poke_i64(sx_tbl, 72, addr_of intern_kid_n)
    poke_i64(sx_tbl, 80, addr_of sx_span_alloc)
    poke_i64(sx_tbl, 88, addr_of expr_span)
    poke_i64(sx_tbl, 96, addr_of expr_call)
    poke_i64(sx_tbl, 104, addr_of expr_index)
    poke_i64(sx_tbl, 112, addr_of bin_k)
    poke_i64(sx_tbl, 120, addr_of test_rax)
    poke_i64(sx_tbl, 128, addr_of jz)
    poke_i64(sx_tbl, 136, addr_of jnz)
    poke_i64(sx_tbl, 144, addr_of jmp)
    poke_i64(sx_tbl, 152, addr_of patch)
    poke_i64(sx_tbl, 160, addr_of mov_rdi_rax)
    poke_i64(sx_tbl, 168, addr_of calln)
    poke_i64(sx_tbl, 176, addr_of ceval)
    poke_i64(sx_tbl, 184, addr_of err_where)
    poke_i64(sx_tbl, 192, addr_of cp_len_of)
    poke_i64(sx_tbl, 200, addr_of _sov_print)
    poke_i64(sx_tbl, 208, addr_of here)
    poke_i64(sx_tbl, 216, addr_of emit2)
    poke_i64(sx_tbl, 224, addr_of emit8)
    poke_i64(sx_tbl, 232, addr_of addp)
    poke_i64(sx_tbl, 240, addr_of sx_tw_alloc)
    poke_i64(sx_tbl, 248, addr_of sx_tw_release0)
    poke_i64(sx_tbl, 256, addr_of sx_tw_cval)
    poke_i64(sx_tbl, 264, addr_of sx_tw_haderr)
    poke_i64(sx_tbl, 272, addr_of sx_tw_usedsl)
    poke_i64(sx_tbl, 280, kid_blank)
    poke_i64(sx_tbl, 288, kid_const)
    poke_i64(sx_tbl, 296, kid_opadd)
    poke_i64(sx_tbl, 304, kid_opbor)
    poke_i64(sx_tbl, 312, kid_opbxor)
    poke_i64(sx_tbl, 320, kid_opband)
    poke_i64(sx_tbl, 328, kid_opeq)
    poke_i64(sx_tbl, 336, kid_opne)
    poke_i64(sx_tbl, 344, kid_ople)
    poke_i64(sx_tbl, 352, kid_opge)
    poke_i64(sx_tbl, 360, kid_oplt)
    poke_i64(sx_tbl, 368, kid_opgt)
    poke_i64(sx_tbl, 376, kid_opbshr)
    poke_i64(sx_tbl, 384, kid_opbsar)
    poke_i64(sx_tbl, 392, kid_opbshl)
    poke_i64(sx_tbl, 400, kid_opsub)
    poke_i64(sx_tbl, 408, kid_opmul)
    poke_i64(sx_tbl, 416, kid_opdiv)
    poke_i64(sx_tbl, 424, kid_opmod)
    poke_i64(sx_tbl, 432, sx_dec_str)
    poke_i64(sx_tbl, 440, "Error: const: not a compile-time number")
    poke_i64(sx_tbl, 448, "Error: expression too long, split it up")
    poke_i64(sx_tbl, 456, "fnaddr")
    poke_i64(sx_tbl, 464, "_sov_strlen")
    poke_i64(sx_tbl, 472, "")
    return 0
sx_tw_alloc sx_argc:
    sx_tw_m0: syntax_arg_pool
    sx_tw_m1: syntax_arg_cap
    sx_tw_m2: syntax_arg_used
    sx_tn: 16 + sx_argc * 8
    if syntax_arg_pool is 0
        syntax_arg_pool: _sov_heap_alloc(65536)
        syntax_arg_cap: 65536
        syntax_arg_used: 0
    if syntax_arg_used + sx_tn > syntax_arg_cap
        sx_tn2: 65536
        if sx_tn > sx_tn2 -> sx_tn2: sx_tn + 4096
        syntax_arg_pool: _sov_heap_alloc(sx_tn2)
        syntax_arg_cap: sx_tn2
        syntax_arg_used: 0
    sx_tw_ap: syntax_arg_pool + syntax_arg_used
    syntax_arg_used: syntax_arg_used + sx_tn
    return sx_tw_ap
sx_tw_release0:
    if sx_tw_m0 is not 0
        syntax_arg_pool: sx_tw_m0
        syntax_arg_cap: sx_tw_m1
    syntax_arg_used: sx_tw_m2
    return 0
sx_tw_cval:
    return cval
sx_tw_haderr:
    had_err: 1
    return 0
sx_tw_usedsl:
    used_sl: 1
    return 0
_sov_emit_tw sx_tree sx_node sx_tbl:
    return syntax_emit(sx_tree, sx_node)
include emit_native.sov
