# Linux i386 (x86 32-bit) ELF emitter.
# ELF32 EM_386 executable, int 0x80 syscall ABI, deterministic main -> exit(N).

use:
    arg
    file
    sys
    num

buf: 0
src: 0
srclen: 0
pg_src: 0
pg_len: 0
code_pos: 0
data_pos: 0
dpatch: 0
BASE: 65536
CODE_OFF: 4096
DATA_OFF: 8192

at8 o v:
    poke_byte(buf, o, v & 255)
    return 0

at16 o v:
    poke_byte(buf, o, v & 255)
    poke_byte(buf, o + 1, (v / 256) & 255)
    return 0

at32 o v:
    poke_byte(buf, o, v & 255)
    poke_byte(buf, o + 1, (v / 256) & 255)
    poke_byte(buf, o + 2, (v / 65536) & 255)
    poke_byte(buf, o + 3, (v / 16777216) & 255)
    return 0

putw v:
    at32(code_pos, v)
    code_pos: code_pos + 4
    return 0

rd_file p:
    srclen: file_size(p)
    src: file_read_all(p)
    if src = 0 -> print 'linux-armv7: cannot read source'
        sys_exit(1)
    return 0

emit8 v:
    poke_byte(buf, code_pos, v & 255)
    code_pos: code_pos + 1
    return 0

emit32 v:
    emit8(v & 255)
    emit8((v / 256) & 255)
    emit8((v / 65536) & 255)
    emit8((v / 16777216) & 255)
    return 0

emit_write addr len:
    emit8(184)
    emit32(4)
    emit8(187)
    emit32(1)
    emit8(185)
    dpatch: _sov_list_add(dpatch, code_pos)
    emit32(addr)
    emit8(186)
    emit32(len)
    emit8(205)
    emit8(128)
    return 0

emit_exit code:
    emit8(184)
    emit32(1)
    emit8(187)
    emit32(code)
    emit8(205)
    emit8(128)
    return 0

is_dig c:
    if c >= 48 -> if c <= 57 -> return 1
    return 0

is_sp c:
    if c = 32 -> return 1
    if c = 9 -> return 1
    if c = 10 -> return 1
    if c = 13 -> return 1
    return 0

find_return:
    p: str_find(src, "return ")
    if p >= 0
        return p + 6
    return 0 - 1

xp: 0
xe: 0

xskip:
    as long as xp < xe -> if is_sp(peek_byte(src, xp)) = 1
            xp: xp + 1
        if not -> leave
    return 0

xfac:
    xskip()
    if xp >= xe -> return 0
    c: peek_byte(src, xp)
    if c = 40 -> xp: xp + 1
        v: xexpr()
        xskip()
        if xp < xe -> if peek_byte(src, xp) = 41 -> xp: xp + 1
        return v
    if c = 45 -> xp: xp + 1
        return 0 - xfac()
    if is_dig(c) = 1 -> v2: 0
        as long as xp < xe -> d: peek_byte(src, xp)
            if is_dig(d) = 1 -> v2: v2 * 10 + d - 48
                xp: xp + 1
            if not -> leave
        return v2
    if is_alfa(c) = 1 -> st: xp
        as long as xp < xe -> if is_aln(peek_byte(src, xp)) = 1
                xp: xp + 1
            if not -> leave
        nm: str_cut(src, st, xp)
        xskip()
        if xp < xe -> if peek_byte(src, xp) = 40
                xp: xp + 1
                args: _sov_list_new()
                as long as xp < xe -> xskip()
                    if xp < xe -> if peek_byte(src, xp) = 41
                            xp: xp + 1
                            leave
                    av: xexpr()
                    args: _sov_list_add(args, av)
                    xskip()
                    if xp < xe -> if peek_byte(src, xp) = 44
                            xp: xp + 1
                ss: src ;; sl: srclen ;; sxp: xp ;; sxe: xe
                cv: eval_fn_args(nm, args)
                src: ss ;; srclen: sl ;; xp: sxp ;; xe: sxe
                return cv
        return env_get(nm)
    xp: xp + 1
    return 0

xterm:
    v: xfac()
    as long as 1 = 1 -> xskip()
        if xp >= xe -> return v
        c: peek_byte(src, xp)
        if c != 42 -> if c != 47 -> return v
        xp: xp + 1
        b: xfac()
        if c = 42 -> v: v * b
        if c = 47 -> if b != 0 -> v: v / b
    return v

xexpr:
    v: xterm()
    as long as 1 = 1 -> xskip()
        if xp >= xe -> return v
        c: peek_byte(src, xp)
        if c != 43 -> if c != 45 -> return v
        xp: xp + 1
        b: xterm()
        if c = 43 -> v: v + b
        if c = 45 -> v: v - b
    return v

fn_names: 0
fn_params: 0
fn_bodies: 0
env_names: 0
env_vals: 0
ret_flag: 0
ret_val: 0
last_if_taken: 0

is_alfa c:
    if c >= 97 -> if c <= 122 -> return 1
    if c >= 65 -> if c <= 90 -> return 1
    if c = 95 -> return 1
    return 0

is_aln c:
    if is_alfa(c) = 1 -> return 1
    if is_dig(c) = 1 -> return 1
    return 0

ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n -> if is_sp(peek_byte(s, i)) = 1
            i: i + 1
        if not -> leave
    return str_cut(s, i, n)

rtrim s:
    n: str_len(s)
    as long as n > 0 -> if is_sp(peek_byte(s, n - 1)) = 1
            n: n - 1
        if not -> leave
    return str_cut(s, 0, n)

trim s:
    return rtrim(ltrim(s))

starts s p:
    pn: str_len(p)
    if str_len(s) < pn -> return 0
    if str_eq(str_cut(s, 0, pn), p) = 1 -> return 1
    return 0

word_end s a:
    n: str_len(s)
    i: a
    as long as i < n -> if is_aln(peek_byte(s, i)) = 1
            i: i + 1
        if not -> leave
    return i

find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n -> if peek_byte(s, i) = c -> return i
        i: i + 1
    return 0 - 1

find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n -> if peek_byte(s, i) = 45
            if peek_byte(s, i + 1) = 62 -> return i
        i: i + 1
    return 0 - 1

indent_of s:
    n: str_len(s)
    i: 0
    w: 0
    as long as i < n -> c: peek_byte(s, i)
        if c = 32 -> w: w + 1
        if not -> if c = 9 -> w: w + 4
            if not -> return w
        i: i + 1
    return w

env_idx nm:
    i: 0
    as long as i < _sov_list_len(env_names) -> if str_eq(as text _sov_list_get(env_names, i), nm) = 1 -> return i
        i: i + 1
    return 0 - 1

env_get nm:
    i: env_idx(nm)
    if i >= 0 -> return _sov_list_get(env_vals, i)
    return 0

env_set nm v:
    i: env_idx(nm)
    if i >= 0 -> env_vals: _sov_list_set(env_vals, i, v)
    if not -> env_names: _sov_list_add(env_names, nm)
        env_vals: _sov_list_add(env_vals, v)
    return 0

fn_idx nm:
    i: 0
    as long as i < _sov_list_len(fn_names) -> if str_eq(as text _sov_list_get(fn_names, i), nm) = 1 -> return i
        i: i + 1
    return 0 - 1

expr_eval s:
    os: src ;; ol: srclen ;; oxp: xp ;; oxe: xe
    src: s
    srclen: str_len(s)
    xp: 0
    xe: srclen
    v: xexpr()
    src: os ;; srclen: ol ;; xp: oxp ;; xe: oxe
    return v

cond_eval cond:
    s: trim(cond)
    oi: 0 - 1
    op: ''
    step: 1
    i: 0
    as long as i < str_len(s) -> c: peek_byte(s, i)
        n: 0
        if i + 1 < str_len(s) -> n: peek_byte(s, i + 1)
        if c = 33 -> if n = 61 -> op: 'ne'
            oi: i
            step: 2
            leave
        if c = 60 -> op: 'lt'
            oi: i
            step: 1
            if n = 61 -> op: 'le'
                step: 2
            leave
        if c = 62 -> op: 'gt'
            oi: i
            step: 1
            if n = 61 -> op: 'ge'
                step: 2
            leave
        if c = 61 -> op: 'eq'
            oi: i
            step: 1
            leave
        i: i + 1
    if oi >= 0 -> a: expr_eval(str_cut(s, 0, oi))
        b: expr_eval(str_cut(s, oi + step, str_len(s)))
        if str_eq(op, 'eq') = 1 -> if a = b -> return 1
        if str_eq(op, 'ne') = 1 -> if a != b -> return 1
        if str_eq(op, 'lt') = 1 -> if a < b -> return 1
        if str_eq(op, 'gt') = 1 -> if a > b -> return 1
        if str_eq(op, 'le') = 1 -> if a <= b -> return 1
        if str_eq(op, 'ge') = 1 -> if a >= b -> return 1
        return 0
    if expr_eval(s) != 0 -> return 1
    return 0

eval_stmt_parts s:
    ts: trim(s)
    if starts(ts, 'as long as ') = 1 -> eval_stmt(ts)
        return 0
    if starts(ts, 'if ') = 1 -> eval_stmt(ts)
        return 0
    start: 0
    n: str_len(s)
    as long as start < n -> i: start
        found: 0
        as long as i + 1 < n -> if peek_byte(s, i) = 59
                if peek_byte(s, i + 1) = 59 -> found: 1
                    leave
            i: i + 1
        if found = 0 -> i: n
        eval_stmt(str_cut(s, start, i))
        if ret_flag = 1 -> return 0
        if found = 1 -> start: i + 2
        if not -> start: n
    return 0

eval_stmt st:
    s: trim(st)
    if str_len(s) = 0 -> return 0
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if starts(s, 'as long as ') = 1 -> arw: find_arrow(s)
        if arw < 0 -> return 0
        cond: trim(str_cut(s, 11, arw))
        body: trim(str_cut(s, arw + 2, str_len(s)))
        guard: 0
        as long as cond_eval(cond) = 1 -> eval_stmt_parts(body)
            if ret_flag = 1 -> return 0
            guard: guard + 1
            if guard > 100000 -> return 0
        return 0
    if str_eq(kw, 'return') = 1 -> ret_val: expr_eval(str_cut(s, w, str_len(s)))
        ret_flag: 1
        return 0
    if str_eq(kw, 'if') = 1 -> ar: find_arrow(s)
        if ar < 0 -> return 0
        cond2: trim(str_cut(s, w, ar))
        body2: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond2, 'not') = 1 -> if last_if_taken = 0 -> eval_stmt_parts(body2)
            last_if_taken: 0
            return 0
        last_if_taken: cond_eval(cond2)
        if last_if_taken = 1 -> eval_stmt_parts(body2)
        return 0
    col: find_ch(s, 58)
    if col > 0 -> nm: trim(str_cut(s, 0, col))
        env_set(nm, expr_eval(str_cut(s, col + 1, str_len(s))))
        return 0
    return 0

eval_block body minind:
    n: str_len(body)
    i: 0
    as long as i < n -> e: i
        as long as e < n -> if peek_byte(body, e) = 10 -> leave
            e: e + 1
        raw: str_cut(body, i, e)
        t: trim(raw)
        ind: indent_of(raw)
        j: e + 1
        blk: ''
        if str_len(t) > 0 -> if peek_byte(t, 0) != 35
                as long as j < n -> ne: j
                    as long as ne < n -> if peek_byte(body, ne) = 10 -> leave
                        ne: ne + 1
                    nr: str_cut(body, j, ne)
                    nt: trim(nr)
                    ni: indent_of(nr)
                    if str_len(nt) > 0 -> if peek_byte(nt, 0) != 35
                            if ni <= ind -> leave
                    blk: str_cat(blk, nr)
                    blk: str_cat(blk, "\n")
                    j: ne + 1
                if starts(t, 'as long as ') = 1 -> arw: find_arrow(t)
                    if arw >= 0 -> cond: trim(str_cut(t, 11, arw))
                        inl: trim(str_cut(t, arw + 2, str_len(t)))
                        guard: 0
                        as long as cond_eval(cond) = 1 -> if str_len(inl) > 0 -> eval_stmt_parts(inl)
                            if ret_flag = 1 -> return 0
                            if str_len(blk) > 0 -> eval_block(blk, ind + 1)
                            if ret_flag = 1 -> return 0
                            guard: guard + 1
                            if guard > 100000 -> return 0
                        i: j
                    if arw < 0 -> eval_stmt_parts(t)
                        i: e + 1
                if not -> if starts(t, 'if ') = 1 -> ar: find_arrow(t)
                        if ar >= 0 -> cond2: trim(str_cut(t, 2, ar))
                            inl2: trim(str_cut(t, ar + 2, str_len(t)))
                            if str_eq(cond2, 'not') = 1 -> if last_if_taken = 0
                                    if str_len(inl2) > 0 -> eval_stmt_parts(inl2)
                                    if ret_flag = 1 -> return 0
                                    if str_len(blk) > 0 -> eval_block(blk, ind + 1)
                                last_if_taken: 0
                            if not -> last_if_taken: cond_eval(cond2)
                                if last_if_taken = 1 -> if str_len(inl2) > 0 -> eval_stmt_parts(inl2)
                                    if ret_flag = 1 -> return 0
                                    if str_len(blk) > 0 -> eval_block(blk, ind + 1)
                            i: j
                        if ar < 0 -> eval_stmt_parts(t)
                            i: e + 1
                    if not -> eval_stmt_parts(t)
                        i: e + 1
        if str_len(t) > 0 -> if peek_byte(t, 0) = 35 -> i: e + 1
        if str_len(t) = 0 -> i: e + 1
        if ret_flag = 1 -> return 0
    return 0

eval_body body:
    last_if_taken: 0
    eval_block(body, 0)
    return 0

bind_params ps args:
    p: trim(ps)
    ai: 0
    as long as str_len(p) > 0 -> p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0 -> leave
        nm: str_cut(p, 0, e)
        v: 0
        if ai < _sov_list_len(args) -> v: _sov_list_get(args, ai)
        env_set(nm, v)
        ai: ai + 1
        p: trim(str_cut(p, e, str_len(p)))
    return 0

find_fn_hdr nm:
    nlen: str_len(nm)
    if pg_len > nlen -> if str_starts(pg_src, nm) = 1
            cAfter: peek_byte(pg_src, nlen)
            if cAfter = 58 -> return 0
            if cAfter = 32 -> return 0
    pat1: str_cat("\n", str_cat(nm, ":"))
    if pg_len > 4096 -> tail_off: pg_len - 4096
        tp: str_find(pg_src + tail_off, pat1)
        if tp >= 0 -> return tail_off + tp + 1
    p: str_find(pg_src, pat1)
    if p >= 0 -> return p + 1
    pat2: str_cat("\n", str_cat(nm, " "))
    if pg_len > 4096 -> tail_off2: pg_len - 4096
        tp2: str_find(pg_src + tail_off2, pat2)
        if tp2 >= 0 -> return tail_off2 + tp2 + 1
    p: str_find(pg_src, pat2)
    if p >= 0 -> return p + 1
    return 0 - 1

load_fn nm:
    fi: fn_idx(nm)
    if fi >= 0 -> return fi
    hp: find_fn_hdr(nm)
    if hp < 0 -> fn_names: _sov_list_add(fn_names, nm)
        fn_params: _sov_list_add(fn_params, '')
        fn_bodies: _sov_list_add(fn_bodies, '')
        return 0 - 1
    e: hp
    as long as e < pg_len -> if peek_byte(pg_src, e) = 10 -> leave
        e: e + 1
    raw: str_cut(pg_src, hp, e)
    t: trim(raw)
    if str_len(t) = 0 -> return 0 - 1
    if peek_byte(t, str_len(t) - 1) != 58 -> return 0 - 1
    h: str_cut(t, 0, str_len(t) - 1)
    w: word_end(h, 0)
    ps: trim(str_cut(h, w, str_len(h)))
    b0: e + 1
    i: b0
    b1: b0
    as long as i < pg_len -> le: i
        as long as le < pg_len -> if peek_byte(pg_src, le) = 10 -> leave
            le: le + 1
        if le > i -> c0: peek_byte(pg_src, i)
            if is_sp(c0) = 1 -> b1: le + 1
            if is_sp(c0) = 0 -> if c0 != 35 -> leave
        i: le + 1
    fn_names: _sov_list_add(fn_names, nm)
    fn_params: _sov_list_add(fn_params, ps)
    fn_bodies: _sov_list_add(fn_bodies, str_cut(pg_src, b0, b1))
    return _sov_list_len(fn_names) - 1

eval_fn_args nm args:
    fi: load_fn(nm)
    if fi < 0 -> return 0
    fbody: as text _sov_list_get(fn_bodies, fi)
    if str_len(fbody) = 0 -> return 0
    if str_find(fbody, 'return') < 0 -> return 0
    oldn: env_names ;; oldv: env_vals ;; oldrf: ret_flag ;; oldrv: ret_val ;; oldif: last_if_taken
    env_names: _sov_list_new()
    env_vals: _sov_list_new()
    ret_flag: 0
    ret_val: 0
    last_if_taken: 0
    bind_params(as text _sov_list_get(fn_params, fi), args)
    eval_body(as text _sov_list_get(fn_bodies, fi))
    rv: ret_val
    env_names: oldn ;; env_vals: oldv ;; ret_flag: oldrf ;; ret_val: oldrv ;; last_if_taken: oldif
    return rv

parse_program:
    pg_src: src
    pg_len: srclen
    fn_names: _sov_list_new()
    fn_params: _sov_list_new()
    fn_bodies: _sov_list_new()
    return 0

parse_return:
    parse_program()
    if load_fn('main') >= 0 -> args: _sov_list_new()
        return eval_fn_args('main', args)
    p: find_return()
    if p < 0 -> return 0
    as long as p < srclen -> if is_sp(peek_byte(src, p)) = 1
            p: p + 1
        if not -> leave
    e: p
    as long as e < srclen -> c: peek_byte(src, e)
        if c = 10 -> leave
        if c = 13 -> leave
        if c = 59 -> leave
        e: e + 1
    xp: p
    xe: e
    return xexpr()

is_print_at p:
    if p + 5 >= srclen -> return 0
    if peek_byte(src, p) != 112 -> return 0
    if peek_byte(src, p + 1) != 114 -> return 0
    if peek_byte(src, p + 2) != 105 -> return 0
    if peek_byte(src, p + 3) != 110 -> return 0
    if peek_byte(src, p + 4) != 116 -> return 0
    return 1

parse_reps p:
    as long as p < srclen -> if is_sp(peek_byte(src, p)) = 1
            p: p + 1
        if not -> leave
    reps: 0
    any: 0
    as long as p < srclen -> c: peek_byte(src, p)
        if is_dig(c) = 1 -> reps: reps * 10 + c - 48
            any: 1
            p: p + 1
        if not -> leave
    if any = 0 -> return 1
    if reps < 1 -> return 1
    return reps

emit_lit a b:
    start: data_pos
    i: a
    as long as i < b -> poke_byte(buf, data_pos, peek_byte(src, i))
        data_pos: data_pos + 1
        i: i + 1
    poke_byte(buf, data_pos, 10)
    data_pos: data_pos + 1
    emit_write(BASE + start, b - a + 1)
    return 0

rv_vars: 0
rv_vals: 0
rv_ret: 0
rv_last_if: 0
rv_es: ''
rv_ep: 0
rv_eb: 0

rv_emit_text t:
    start: data_pos
    i: 0
    n: str_len(t)
    as long as i < n -> poke_byte(buf, data_pos, peek_byte(t, i))
        data_pos: data_pos + 1
        i: i + 1
    poke_byte(buf, data_pos, 10)
    data_pos: data_pos + 1
    emit_write(BASE + start, n + 1)
    return 0

rv_ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n -> if is_sp(peek_byte(s, i)) = 1
            i: i + 1
        if not -> leave
    return str_cut(s, i, n)

rv_rtrim s:
    n: str_len(s)
    as long as n > 0 -> if is_sp(peek_byte(s, n - 1)) = 1
            n: n - 1
        if not -> leave
    return str_cut(s, 0, n)

rv_trim s:
    return rv_rtrim(rv_ltrim(s))

rv_is_alpha c:
    if c >= 97 -> if c <= 122 -> return 1
    if c >= 65 -> if c <= 90 -> return 1
    if c = 95 -> return 1
    return 0

rv_is_aln c:
    if rv_is_alpha(c) = 1 -> return 1
    if is_dig(c) = 1 -> return 1
    return 0

rv_word_end s a:
    n: str_len(s)
    i: a
    as long as i < n -> if rv_is_aln(peek_byte(s, i)) = 1
            i: i + 1
        if not -> leave
    return i

rv_starts s p:
    pn: str_len(p)
    if str_len(s) < pn -> return 0
    if str_eq(str_cut(s, 0, pn), p) = 1 -> return 1
    return 0

rv_find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n -> if peek_byte(s, i) = c -> return i
        i: i + 1
    return 0 - 1

rv_find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n -> if peek_byte(s, i) = 45
            if peek_byte(s, i + 1) = 62 -> return i
        i: i + 1
    return 0 - 1

rv_var_index nm:
    i: 0
    as long as i < _sov_list_len(rv_vars) -> if str_eq(as text _sov_list_get(rv_vars, i), nm) = 1 -> return i
        i: i + 1
    return 0 - 1

rv_set nm v:
    k: rv_var_index(nm)
    if k < 0 -> rv_vars: _sov_list_add(rv_vars, nm)
        rv_vals: _sov_list_add(rv_vals, v)
        return 0
    rv_vals: _sov_list_set(rv_vals, k, v)
    return 0

rv_get nm:
    k: rv_var_index(nm)
    if k < 0 -> return 0
    return _sov_list_get(rv_vals, k)

rv_esk:
    as long as rv_ep < rv_eb -> if is_sp(peek_byte(rv_es, rv_ep)) = 1
            rv_ep: rv_ep + 1
        if not -> leave
    return 0

rv_sv_es: 0
rv_sv_ep: 0
rv_sv_eb: 0
rv_sv_vars: 0
rv_sv_vals: 0
rv_args: 0
rv_fi: 0
rv_ps: 0
rv_bd: 0
rv_pi: 0
rv_pn: 0
rv_st: 0
rv_ri: 0
rv_re: 0
rv_v: 0

rv_call nm:
    # Evaluate "(a, b, ...)" at the current position as a call to the user
    # function nm.  Without this, an identifier followed by a paren parsed as a
    # plain variable, rv_get returned 0 for it and the argument list was left
    # unconsumed, so every program that called a function folded to 0 and the
    # driver emitted a literal 0 where the real value belonged.
    rv_esk()
    if rv_ep >= rv_eb -> return 0
    if peek_byte(rv_es, rv_ep) != 40 -> return 0
    rv_ep: rv_ep + 1
    rv_args: _sov_list_new()
    rv_esk()
    as long as rv_ep < rv_eb -> if peek_byte(rv_es, rv_ep) = 41 -> leave
        rv_args: _sov_list_add(rv_args, rv_expr())
        rv_esk()
        if rv_ep < rv_eb -> if peek_byte(rv_es, rv_ep) = 44 -> rv_ep: rv_ep + 1
        rv_esk()
    if rv_ep < rv_eb -> if peek_byte(rv_es, rv_ep) = 41 -> rv_ep: rv_ep + 1
    rv_fi: load_fn(nm)
    if rv_fi < 0 -> return 0
    rv_ps: as text _sov_list_get(fn_params, rv_fi)
    rv_bd: as text _sov_list_get(fn_bodies, rv_fi)
    rv_sv_es: rv_es
    rv_sv_ep: rv_ep
    rv_sv_eb: rv_eb
    rv_sv_vars: rv_vars
    rv_sv_vals: rv_vals
    rv_vars: _sov_list_new()
    rv_vals: _sov_list_new()
    rv_pi: 0
    rv_pn: 0
    as long as rv_pi < str_len(rv_ps) -> if peek_byte(rv_ps, rv_pi) = 32 -> rv_pi: rv_pi + 1
        if not -> rv_st: rv_pi
            as long as rv_pi < str_len(rv_ps) -> if peek_byte(rv_ps, rv_pi) = 32 -> leave
                rv_pi: rv_pi + 1
            if rv_pn < _sov_list_len(rv_args) -> rv_set(str_cut(rv_ps, rv_st, rv_pi), _sov_list_get(rv_args, rv_pn))
            rv_pn: rv_pn + 1
    rv_ri: str_find(rv_bd, 'return ')
    rv_v: 0
    if rv_ri > 0 - 1 -> rv_re: rv_ri + 7
        as long as rv_re < str_len(rv_bd) -> if peek_byte(rv_bd, rv_re) = 10 -> leave
            rv_re: rv_re + 1
        rv_es: rv_trim(str_cut(rv_bd, rv_ri + 7, rv_re))
        rv_ep: 0
        rv_eb: str_len(rv_es)
        rv_v: rv_expr()
    rv_vars: rv_sv_vars
    rv_vals: rv_sv_vals
    rv_es: rv_sv_es
    rv_ep: rv_sv_ep
    rv_eb: rv_sv_eb
    return rv_v

rv_fac:
    rv_esk()
    if rv_ep >= rv_eb -> return 0
    c: peek_byte(rv_es, rv_ep)
    if c = 40 -> rv_ep: rv_ep + 1
        v: rv_expr()
        rv_esk()
        if rv_ep < rv_eb -> if peek_byte(rv_es, rv_ep) = 41 -> rv_ep: rv_ep + 1
        return v
    if c = 45 -> rv_ep: rv_ep + 1
        return 0 - rv_fac()
    if is_dig(c) = 1 -> v2: 0
        as long as rv_ep < rv_eb -> c2: peek_byte(rv_es, rv_ep)
            if is_dig(c2) = 1 -> v2: v2 * 10 + c2 - 48
                rv_ep: rv_ep + 1
            if not -> leave
        return v2
    if rv_is_alpha(c) = 1 -> st: rv_ep
        as long as rv_ep < rv_eb -> if rv_is_aln(peek_byte(rv_es, rv_ep)) = 1
                rv_ep: rv_ep + 1
            if not -> leave
        nm: str_cut(rv_es, st, rv_ep)
        rv_esk()
        if rv_ep < rv_eb -> if peek_byte(rv_es, rv_ep) = 40 -> return rv_call(nm)
        return rv_get(nm)
    return 0

rv_term:
    v: rv_fac()
    as long as 1 = 1 -> rv_esk()
        if rv_ep >= rv_eb -> return v
        c: peek_byte(rv_es, rv_ep)
        if c != 42 -> if c != 47 -> return v
        rv_ep: rv_ep + 1
        b: rv_fac()
        if c = 42 -> v: v * b
        if c = 47 -> if b != 0 -> v: v / b
    return v

rv_expr:
    v: rv_term()
    as long as 1 = 1 -> rv_esk()
        if rv_ep >= rv_eb -> return v
        c: peek_byte(rv_es, rv_ep)
        if c != 43 -> if c != 45 -> return v
        rv_ep: rv_ep + 1
        b: rv_term()
        if c = 43 -> v: v + b
        if c = 45 -> v: v - b
    return v

rv_eval s:
    rv_es: rv_trim(s)
    rv_ep: 0
    rv_eb: str_len(rv_es)
    return rv_expr()

rv_cond s:
    t: rv_trim(s)
    n: str_len(t)
    i: 0
    as long as i < n -> c: peek_byte(t, i)
        if c = 62 -> a: rv_eval(str_cut(t, 0, i))
            b: rv_eval(str_cut(t, i + 1, n))
            if a > b -> return 1
            return 0
        if c = 60 -> a2: rv_eval(str_cut(t, 0, i))
            b2: rv_eval(str_cut(t, i + 1, n))
            if a2 < b2 -> return 1
            return 0
        if c = 61 -> a3: rv_eval(str_cut(t, 0, i))
            b3: rv_eval(str_cut(t, i + 1, n))
            if a3 = b3 -> return 1
            return 0
        i: i + 1
    if rv_eval(t) != 0 -> return 1
    return 0

rv_parse_reps t:
    q: rv_trim(t)
    if str_len(q) = 0 -> return 1
    if is_dig(peek_byte(q, 0)) = 0 -> return 1
    i: 0
    v: 0
    as long as i < str_len(q) -> c: peek_byte(q, i)
        if is_dig(c) = 1 -> v: v * 10 + c - 48
            i: i + 1
        if not -> return v
    if v < 1 -> return 1
    return v

rv_stmt s:
    t: rv_trim(s)
    if str_len(t) = 0 -> return 0
    if rv_starts(t, 'as long as ') = 1 -> arw: rv_find_arrow(t)
        if arw >= 0 -> cond: rv_trim(str_cut(t, 11, arw))
            body: rv_trim(str_cut(t, arw + 2, str_len(t)))
            guard: 0
            as long as rv_cond(cond) = 1 -> rv_bodies(body)
                guard: guard + 1
                if guard > 100000 -> leave
        return 0
    w: rv_word_end(t, 0)
    kw: str_cut(t, 0, w)
    if str_eq(kw, 'print') = 1 -> rest: rv_trim(str_cut(t, w, str_len(t)))
        if str_len(rest) > 0 -> q: peek_byte(rest, 0)
            if q = 39 -> j: 1
                as long as j < str_len(rest) -> if peek_byte(rest, j) = q -> leave
                    j: j + 1
                lit: str_cut(rest, 1, j)
                reps: rv_parse_reps(str_cut(rest, j + 1, str_len(rest)))
                r: 0
                as long as r < reps -> rv_emit_text(lit)
                    r: r + 1
                return 0
            if q = 34 -> j2: 1
                as long as j2 < str_len(rest) -> if peek_byte(rest, j2) = q -> leave
                    j2: j2 + 1
                lit2: str_cut(rest, 1, j2)
                reps2: rv_parse_reps(str_cut(rest, j2 + 1, str_len(rest)))
                r2: 0
                as long as r2 < reps2 -> rv_emit_text(lit2)
                    r2: r2 + 1
                return 0
        rv_emit_text(num_text(rv_eval(rest)))
        return 0
    if str_eq(kw, 'return') = 1 -> rv_ret: rv_eval(str_cut(t, w, str_len(t)))
        return 0
    if str_eq(kw, 'if') = 1 -> ar: rv_find_arrow(t)
        if ar < 0 -> return 0
        cond2: rv_trim(str_cut(t, w, ar))
        body2: rv_trim(str_cut(t, ar + 2, str_len(t)))
        if str_eq(cond2, 'not') = 1 -> if rv_last_if = 0 -> rv_parts(body2)
            return 0
        rv_last_if: rv_cond(cond2)
        if rv_last_if = 1 -> rv_parts(body2)
        return 0
    col: rv_find_ch(t, 58)
    if col > 0 -> nm2: rv_trim(str_cut(t, 0, col))
        ex2: str_cut(t, col + 1, str_len(t))
        rv_set(nm2, rv_eval(ex2))
        return 0
    return 0

rv_parts s:
    start: 0
    n: str_len(s)
    as long as start < n -> i: start
        found: 0
        as long as i + 1 < n -> if peek_byte(s, i) = 59
                if peek_byte(s, i + 1) = 59 -> found: 1
                    leave
            i: i + 1
        if found = 0 -> i: n
        rv_stmt(str_cut(s, start, i))
        if found = 1 -> start: i + 2
        if not -> start: n
    return 0

rv_header_name t:
    h: rv_trim(t)
    if str_len(h) = 0 -> return as text ''
    if peek_byte(h, str_len(h) - 1) != 58 -> return as text ''
    return str_cut(h, 0, rv_word_end(h, 0))

mbody: 0
mlen: 0

rv_span p:
    # End offset of the statement that starts at p.  Normally that is the end of
    # its line.  A loop written the usual way puts the rest of its body on the
    # following deeper-indented lines, and handing those to the interpreter as
    # separate statements loses the increment, so the loop variable never
    # advances and the guard runs its full 100000 iterations on every program
    # that contains a loop.  Only as-long-as statements are extended; leaving
    # every other construct exactly as it was keeps this change local.
    e: p
    as long as e < mlen -> if peek_byte(mbody, e) = 10 -> leave
        e: e + 1
    raw: str_cut(mbody, p, e)
    t: rv_trim(raw)
    if str_len(t) < 1 -> return e
    if rv_starts(t, 'as long as ') = 0 -> return e
    if rv_find_arrow(t) < 0 -> return e
    ind0: indent_of(raw)
    go: 1
    as long as go = 1
        go: 0
        if e < mlen -> q: e + 1
            e2: q
            as long as e2 < mlen -> if peek_byte(mbody, e2) = 10 -> leave
                e2: e2 + 1
            raw2: str_cut(mbody, q, e2)
            if str_len(rv_trim(raw2)) > 0 -> if indent_of(raw2) > ind0 -> e: e2
                    go: 1
    return e

rv_bodies s:
    # Run a loop body one line at a time, splitting each line as rv_parts does.
    start: 0
    n: str_len(s)
    as long as start < n -> i: start
        as long as i < n -> if peek_byte(s, i) = 10 -> leave
            i: i + 1
        rv_parts(str_cut(s, start, i))
        start: i + 1
    return 0

scan_prints:
    if 1 = 0 -> emit_lit(0, 0)
    dummy_unused: is_print_at(0)
    dummy_unused: parse_reps(0)
    if 1 = 0 -> rv_header_name('')
    mfi: load_fn('main')
    if mfi < 0 -> return 0
    mbody: as text _sov_list_get(fn_bodies, mfi)
    if str_find(mbody, 'print') < 0 -> return 0
    rv_vars: _sov_list_new()
    rv_vals: _sov_list_new()
    rv_ret: 0
    rv_last_if: 0
    mlen: str_len(mbody)
    p: 0
    as long as p < mlen -> e: rv_span(p)
        if e > p -> raw: str_cut(mbody, p, e)
            t: rv_trim(raw)
            if str_len(t) > 0 -> if peek_byte(t, 0) != 35 -> rv_parts(t)
        p: e + 1
    return 0

emit_elf retval:
    total_cap: 16384
    buf: _sov_alloc(total_cap)
    i: 0
    dpatch: _sov_list_new()
    code_pos: CODE_OFF
    data_pos: DATA_OFF
    scan_prints()
    rv_ret: retval
    emit_exit(rv_ret)
    # Pack: code and data were staged at page offsets (4096/8192),
    # which padded every file to >= 8192 bytes.  The single PT_LOAD
    # covers the whole file, so shift code to right after the headers
    # (84), data right after code, and adjust the absolute string
    # addresses emit_write baked in (sites recorded in dpatch).
    code_len: code_pos - CODE_OFF
    data_len: data_pos - DATA_OFF
    hdr: 84
    i: 0
    as long as i < code_len -> poke_byte(buf, hdr + i, peek_byte(buf, CODE_OFF + i))
        i: i + 1
    i: 0
    as long as i < data_len -> poke_byte(buf, hdr + code_len + i, peek_byte(buf, DATA_OFF + i))
        i: i + 1
    dshift: DATA_OFF - (hdr + code_len)
    i: 0
    as long as i < _sov_list_len(dpatch) -> so: hdr + (_sov_list_get(dpatch, i) - CODE_OFF)
        ov: peek_byte(buf, so) + peek_byte(buf, so + 1) * 256 + peek_byte(buf, so + 2) * 65536 + peek_byte(buf, so + 3) * 16777216
        at32(so, ov - dshift)
        i: i + 1
    total: hdr + code_len + data_len
    at8(0, 127) ;; at8(1, 69) ;; at8(2, 76) ;; at8(3, 70)
    at8(4, 1) ;; at8(5, 1) ;; at8(6, 1) ;; at8(7, 0)
    at16(16, 2)
    at16(18, 3)
    at32(20, 1)
    at32(24, BASE + hdr)
    at32(28, 52)
    at32(32, 0)
    at32(36, 0)
    at16(40, 52)
    at16(42, 32)
    at16(44, 1)
    at16(46, 0)
    at16(48, 0)
    at16(50, 0)
    ph: 52
    at32(ph + 0, 1)
    at32(ph + 4, 0)
    at32(ph + 8, BASE)
    at32(ph + 12, BASE)
    at32(ph + 16, total)
    at32(ph + 20, total)
    at32(ph + 24, 5)
    at32(ph + 28, 4096)
    return total

main:
    ac: arg_count()
    if ac < 2 -> print 'Usage: compiler src.sov -o out'
        sys_exit(1)
    inp: as text arg_at(1)
    outp: 'a.out'
    if ac = 3
        if str_eq(as text arg_at(1), '-o') = 0 -> if str_eq(as text arg_at(2), '-o') = 0 -> outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac -> if str_eq(as text arg_at(i), '-o') = 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not -> i: i + 1
    rd_file(inp)
    rv: parse_return()
    n: emit_elf(rv)
    file_write_bytes(outp, buf, n)
    print 'linux-i386: wrote '
    print outp
    return 0
