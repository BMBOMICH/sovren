# Expanded compact source to match current shared front end.
# Sovren -> LLVM IR subset emitter.
# Universal IR route for command-style integer programs: functions/calls,
# parameters, literals, locals/reassignment, arithmetic, inline if/else, inline
# while loops, literal repetition, and main return.

main:
    ac: arg_count()
    if ac < 2
        print "Usage: compiler src.sov -o out.ll"
        sys_exit(1)
    srcp: as text arg_at(1)
    outp: "a.ll"
    if ac is 3
        if str_eq(as text arg_at(1), "-o") is 0
            if str_eq(as text arg_at(2), "-o") is 0
                outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac
        if str_eq(as text arg_at(i), "-o") is 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not
            i: i + 1
    compile_file(srcp)
    file_write_all(outp, ll_out)
    print "llgen: wrote "
    print outp
    return 0


use arg
use file
use string
use sys
use num

src: 0
ll_out: ""
ll_globals: ""
locals: 0
regn: 0
labeln: 0
last_if: 0
last_then: 0
last_end: 0
pending_if: 0
pending_end: ""
main_seen: 0
fn_return_seen: 0
block_inds: 0
block_kinds: 0
block_a: 0
block_b: 0
block_n: 0
last_block_kind: ""
last_block_a: ""
last_block_b: ""

emit s:
    ll_out: str_cat(ll_out, s)
    return 0

emitln s:
    ll_out: str_cat(ll_out, s)
    ll_out: str_cat(ll_out, "\n")
    return 0

is_sp c:
    if c is 32
        return 1
    if c is 9
        return 1
    if c is 13
        return 1
    return 0

is_dig c:
    if c >= 48
        if c <= 57
            return 1
    return 0

is_alfa c:
    if c >= 97
        if c <= 122
            return 1
    if c >= 65
        if c <= 90
            return 1
    if c is 95
        return 1
    return 0

is_aln c:
    if is_alfa(c) is 1
        return 1
    if is_dig(c) is 1
        return 1
    return 0

ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n
        if is_sp(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return str_cut(s, i, n)

rtrim s:
    n: str_len(s)
    as long as n > 0
        if is_sp(peek_byte(s, n - 1)) is 1
            n: n - 1
        if not
            leave
    return str_cut(s, 0, n)

trim s:
    return rtrim(ltrim(s))

word_end s a:
    n: str_len(s)
    i: a
    as long as i < n
        if is_aln(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return i

find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n
        if peek_byte(s, i) is c
            return i
        i: i + 1
    return 0 - 1

find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n
        if peek_byte(s, i) is 45
            if peek_byte(s, i + 1) is 62
                return i
        i: i + 1
    return 0 - 1

starts s p:
    pn: str_len(p)
    if str_len(s) < pn
        return 0
    if str_eq(str_cut(s, 0, pn), p) is 1
        return 1
    return 0

indent_of s:
    n: str_len(s)
    i: 0
    w: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 32
            w: w + 1
        if not
            if c is 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w

fresh:
    regn: regn + 1
    return str_cat("%r", num_text(regn))

fresh_label p:
    labeln: labeln + 1
    return str_cat(p, num_text(labeln))

local_seen nm:
    i: 0
    as long as i < _sov_list_len(locals)
        if str_eq(as text _sov_list_get(locals, i), nm) is 1
            return 1
        i: i + 2
    return 0

local_ptr nm:
    i: 0
    as long as i < _sov_list_len(locals)
        if str_eq(as text _sov_list_get(locals, i), nm) is 1
            return as text _sov_list_get(locals, i + 1)
        i: i + 2
    return ""

local_add nm:
    p: str_cat("%", nm)
    if local_seen(nm) is 0
        locals: _sov_list_add(locals, nm)
        locals: _sov_list_add(locals, p)
        emit("  ")
        emit(p)
        emitln(" = alloca i64")
    return p

# expression parser for i64 integer expressions: numbers, locals, + - * /, parens.
ep: 0
eb: 0
es: ""

esk:
    as long as ep < eb
        if is_sp(peek_byte(es, ep)) is 1
            ep: ep + 1
        if not
            leave
    return 0

fac:
    esk()
    if ep >= eb
        return as text "0"
    c: peek_byte(es, ep)
    if c is 40
        ep: ep + 1
        v: expr()
        esk()
        if ep < eb
            if peek_byte(es, ep) is 41
                ep: ep + 1
        return v
    if c is 45
        ep: ep + 1
        v: fac()
        r: fresh()
        emit("  ")
        emit(r)
        emit(" = sub i64 0, ")
        emitln(v)
        return r
    if is_dig(c) is 1
        st: ep
        as long as ep < eb
            if is_dig(peek_byte(es, ep)) is 1
                ep: ep + 1
            if not
                leave
        return as text str_cut(es, st, ep)
    if is_alfa(c) is 1
        st: ep
        as long as ep < eb
            if is_aln(peek_byte(es, ep)) is 1
                ep: ep + 1
            if not
                leave
        nm: str_cut(es, st, ep)
        esk()
        if ep < eb
            if peek_byte(es, ep) is 40
                ep: ep + 1
                args: ""
                first: 1
                as long as ep < eb
                    esk()
                    if ep < eb
                        if peek_byte(es, ep) is 41
                            ep: ep + 1
                            leave
                    av: expr()
                    if first is 0
                        args: str_cat(args, ", ")
                    args: str_cat(args, "i64 ")
                    args: str_cat(args, av)
                    first: 0
                    esk()
                    if ep < eb
                        if peek_byte(es, ep) is 44
                            ep: ep + 1
                rcall: fresh()
                emit("  ")
                emit(rcall)
                emit(" = call i64 @")
                emit(nm)
                emit("(")
                emit(args)
                emitln(")")
                return rcall
        p: local_ptr(nm)
        if str_len(p) is 0
            return as text "0"
        r: fresh()
        emit("  ")
        emit(r)
        emit(" = load i64, ptr ")
        emitln(p)
        return r
    return as text "0"

term:
    v: fac()
    as long as 1 is 1
        esk()
        if ep >= eb
            return v
        c: peek_byte(es, ep)
        if c is not 42
            if c is not 47
                return v
        ep: ep + 1
        b: fac()
        r: fresh()
        emit("  ")
        emit(r)
        if c is 42
            emit(" = mul i64 ")
        if c is 47
            emit(" = sdiv i64 ")
        emit(v)
        emit(", ")
        emitln(b)
        v: r
    return v

expr:
    v: term()
    as long as 1 is 1
        esk()
        if ep >= eb
            return v
        c: peek_byte(es, ep)
        if c is not 43
            if c is not 45
                return v
        ep: ep + 1
        b: term()
        r: fresh()
        emit("  ")
        emit(r)
        if c is 43
            emit(" = add i64 ")
        if c is 45
            emit(" = sub i64 ")
        emit(v)
        emit(", ")
        emitln(b)
        v: r
    return v

emit_expr s:
    es: trim(s)
    ep: 0
    eb: str_len(es)
    return expr()

ll_bytes lit:
    r: ""
    i: 0
    as long as i < str_len(lit)
        if i > 0
            r: str_cat(r, ", ")
        r: str_cat(r, "i8 ")
        r: str_cat(r, num_text(peek_byte(lit, i)))
        i: i + 1
    if str_len(r) > 0
        r: str_cat(r, ", ")
    r: str_cat(r, "i8 10, i8 0")
    return r

emit_print_lit lit reps:
    nm: str_cat("@.s", num_text(labeln))
    labeln: labeln + 1
    ln: str_len(lit) + 2
    ll_globals: str_cat(ll_globals, nm)
    ll_globals: str_cat(ll_globals, " = private constant [")
    ll_globals: str_cat(ll_globals, num_text(ln))
    ll_globals: str_cat(ll_globals, " x i8] [")
    ll_globals: str_cat(ll_globals, ll_bytes(lit))
    ll_globals: str_cat(ll_globals, "]\n")
    i: 0
    as long as i < reps
        emit("  call i32 @puts(ptr ")
        emit(nm)
        emitln(")")
        i: i + 1
    return 0

emit_print_expr rest:
    v: emit_expr(rest)
    emit("  call i32 (ptr, ...) @printf(ptr @fmt_i64, i64 ")
    emit(v)
    emitln(")")
    return 0

push_block kind ind a b:
    if block_n < _sov_list_len(block_inds)
        block_inds: _sov_list_set(block_inds, block_n, ind)
        block_kinds: _sov_list_set(block_kinds, block_n, kind)
        block_a: _sov_list_set(block_a, block_n, a)
        block_b: _sov_list_set(block_b, block_n, b)
    if not
        block_inds: _sov_list_add(block_inds, ind)
        block_kinds: _sov_list_add(block_kinds, kind)
        block_a: _sov_list_add(block_a, a)
        block_b: _sov_list_add(block_b, b)
    block_n: block_n + 1
    return 0

close_one:
    if block_n > 0
        kind: as text _sov_list_get(block_kinds, block_n - 1)
        a: as text _sov_list_get(block_a, block_n - 1)
        b: as text _sov_list_get(block_b, block_n - 1)
        if str_eq(kind, "while") is 1
            emit("  br label %")
            emitln(a)
            emit(b)
            emitln(":")
            block_n: block_n - 1
            return 0
        if str_eq(kind, "if") is 1
            emit("  br label %")
            emitln(b)
            emit(a)
            emitln(":")
            emit("  br label %")
            emitln(b)
            emit(b)
            emitln(":")
            block_n: block_n - 1
            return 0
        if str_eq(kind, "else") is 1
            emit("  br label %")
            emitln(b)
            emit(b)
            emitln(":")
            block_n: block_n - 1
            return 0
        block_n: block_n - 1
    return 0

close_blocks ind:
    as long as block_n > 0
        top: _sov_list_get(block_inds, block_n - 1)
        if ind <= top
            close_one()
        if not
            leave
    return 0

close_all:
    as long as block_n > 0
        close_one()
    return 0

emit_else_line s ind:
    if block_n > 0
        top: _sov_list_get(block_inds, block_n - 1)
        kind: as text _sov_list_get(block_kinds, block_n - 1)
        if ind <= top
            if str_eq(kind, "if") is 1
                el: as text _sov_list_get(block_a, block_n - 1)
                en: as text _sov_list_get(block_b, block_n - 1)
                emit("  br label %")
                emitln(en)
                emit(el)
                emitln(":")
                block_n: block_n - 1
                ar: find_arrow(s)
                if ar >= 0
                    body: trim(str_cut(s, ar + 2, str_len(s)))
                    if str_len(body) > 0
                        emit_stmt_parts(body)
                push_block("else", ind, "", en)
                return 1
    close_blocks(ind)
    return 0

emit_cond cond then_label else_label:
    # supports a < b, a > b, a = b, otherwise nonzero test
    s: trim(cond)
    op: ""
    oi: 0 - 1
    i: 0
    as long as i < str_len(s)
        c: peek_byte(s, i)
        if c is 62
            op: "sgt"
            oi: i
            leave
        if c is 60
            op: "slt"
            oi: i
            leave
        if c is 61
            op: "eq"
            oi: i
            leave
        i: i + 1
    if oi >= 0
        a: emit_expr(str_cut(s, 0, oi))
        b: emit_expr(str_cut(s, oi + 1, str_len(s)))
        r: fresh()
        emit("  ")
        emit(r)
        emit(" = icmp ")
        emit(op)
        emit(" i64 ")
        emit(a)
        emit(", ")
        emitln(b)
        emit("  br i1 ")
        emit(r)
        emit(", label %")
        emit(then_label)
        emit(", label %")
        emitln(else_label)
        return 0
    v: emit_expr(s)
    r: fresh()
    emit("  ")
    emit(r)
    emit(" = icmp ne i64 ")
    emit(v)
    emitln(", 0")
    emit("  br i1 ")
    emit(r)
    emit(", label %")
    emit(then_label)
    emit(", label %")
    emitln(else_label)
    return 0

emit_stmt st:
    s: trim(st)
    if str_len(s) is 0
        return 0
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if starts(s, "as long as ") is 1
        arw: find_arrow(s)
        condw: ""
        bodyw: ""
        if arw < 0
            condw: trim(str_cut(s, 11, str_len(s)))
        if not
            condw: trim(str_cut(s, 11, arw))
            bodyw: trim(str_cut(s, arw + 2, str_len(s)))
        top: fresh_label("while")
        wb: fresh_label("whilebody")
        we: fresh_label("endwhile")
        emit("  br label %")
        emitln(top)
        emit(top)
        emitln(":")
        emit_cond(condw, wb, we)
        emit(wb)
        emitln(":")
        if str_len(bodyw) > 0
            emit_stmt_parts(bodyw)
        last_block_kind: "while"
        last_block_a: top
        last_block_b: we
        return 1
    if str_eq(kw, "print") is 1
        rest: trim(str_cut(s, w, str_len(s)))
        if str_len(rest) > 0
            if peek_byte(rest, 0) is 39
                j: 1
                as long as j < str_len(rest)
                    if peek_byte(rest, j) is 39
                        leave
                    j: j + 1
                lit: str_cut(rest, 1, j)
                reps: 1
                tail: trim(str_cut(rest, j + 1, str_len(rest)))
                if str_len(tail) > 0
                    if is_dig(peek_byte(tail, 0)) is 1
                        reps: 0
                        k: 0
                        as long as k < str_len(tail)
                            cc: peek_byte(tail, k)
                            if is_dig(cc) is 1
                                reps: reps * 10 + cc - 48
                                k: k + 1
                            if not
                                leave
                emit_print_lit(lit, reps)
                return 0
        emit_print_expr(rest)
        return 0
    if str_eq(kw, "return") is 1
        v: emit_expr(str_cut(s, w, str_len(s)))
        fn_return_seen: 1
        if main_seen is 1
            rr: fresh()
            emit("  ")
            emit(rr)
            emit(" = trunc i64 ")
            emit(v)
            emitln(" to i32")
            emit("  ret i32 ")
            emitln(rr)
        if not
            emit("  ret i64 ")
            emitln(v)
        return 0
    if str_eq(kw, "if") is 1
        ar: find_arrow(s)
        cond: ""
        body: ""
        if ar < 0
            cond: trim(str_cut(s, w, str_len(s)))
        if not
            cond: trim(str_cut(s, w, ar))
            body: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond, "not") is 1
            return 0
        th: fresh_label("then")
        el: fresh_label("else")
        en: fresh_label("endif")
        emit_cond(cond, th, el)
        emit(th)
        emitln(":")
        if str_len(body) > 0
            emit_stmt_parts(body)
        last_block_kind: "if"
        last_block_a: el
        last_block_b: en
        return 1
    col: find_ch(s, 58)
    if col > 0
        nm: trim(str_cut(s, 0, col))
        p: local_add(nm)
        v: emit_expr(str_cut(s, col + 1, str_len(s)))
        emit("  store i64 ")
        emit(v)
        emit(", ptr ")
        emitln(p)
        return 0
    return 0

emit_stmt_parts s:
    t0: trim(s)
    if starts(t0, "as long as ") is 1
        return emit_stmt(t0)
    if starts(t0, "if ") is 1
        return emit_stmt(t0)
    start: 0
    n: str_len(s)
    opened: 0
    as long as start < n
        i: start
        found: 0
        as long as i + 1 < n
            if peek_byte(s, i) is 59
                if peek_byte(s, i + 1) is 59
                    found: 1
                    leave
            i: i + 1
        if found is 0
            i: n
        one: emit_stmt(str_cut(s, start, i))
        if one is 1
            opened: 1
        if found is 1
            start: i + 2
        if not
            start: n
    return opened

emit_header line:
    h: trim(line)
    if str_len(h) is 0
        return 0
    if peek_byte(h, str_len(h) - 1) is not 58
        return 0
    h: str_cut(h, 0, str_len(h) - 1)
    w: word_end(h, 0)
    nm: str_cut(h, 0, w)
    locals: _sov_list_new()
    regn: 0
    fn_return_seen: 0
    pending_if: 0
    block_inds: _sov_list_new()
    block_kinds: _sov_list_new()
    block_a: _sov_list_new()
    block_b: _sov_list_new()
    block_n: 0
    if str_eq(nm, "main") is 1
        main_seen: 1
        emitln("define i32 @main() {")
        return 1
    main_seen: 0
    emit("define i64 @")
    emit(nm)
    emit("(")
    ps: _sov_list_new()
    p: trim(str_cut(h, w, str_len(h)))
    first: 1
    as long as str_len(p) > 0
        p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0
            leave
        pn: str_cut(p, 0, e)
        if first is 0
            emit(", ")
        emit("i64 %")
        emit(pn)
        emit(".arg")
        ps: _sov_list_add(ps, pn)
        first: 0
        p: trim(str_cut(p, e, str_len(p)))
    emitln(") {")
    pi: 0
    as long as pi < _sov_list_len(ps)
        pn2: as text _sov_list_get(ps, pi)
        pp: local_add(pn2)
        emit("  store i64 %")
        emit(pn2)
        emit(".arg, ptr ")
        emitln(pp)
        pi: pi + 1
    return 1

compile_file path:
    src: file_read_all(path)
    if src is 0
        print "llgen: cannot read input"
        sys_exit(1)
    ll_out: ""
    emitln("; Sovren LLVM IR subset")
    emitln("@fmt_i64 = private constant [6 x i8] [i8 37, i8 108, i8 108, i8 100, i8 10, i8 0]")
    emitln("@empty = private constant [1 x i8] zeroinitializer")
    emitln("declare i32 @printf(ptr, ...)")
    emitln("declare i32 @puts(ptr)")
    emitln("")
    n: str_len(src)
    if n >= 4096
        n: 0
    i: 0
    in_fn: 0
    as long as i < n
        end: i
        as long as end < n
            if peek_byte(src, end) is 10
                leave
            end: end + 1
        raw: str_cut(src, i, end)
        t: trim(raw)
        if str_len(t) > 0
            if peek_byte(t, 0) is not 35
                ind: indent_of(raw)
                if is_sp(peek_byte(raw, 0)) is 0
                    if in_fn is 1
                        close_all()
                    if in_fn is 1
                        if fn_return_seen is 0
                            if main_seen is 1 -> emitln("  ret i32 0")
                        if fn_return_seen is 0
                            if main_seen is 0
                                emitln("  ret i64 0")
                        emitln("}")
                    main_seen: 0
                    in_fn: emit_header(t)
                if is_sp(peek_byte(raw, 0)) is 1
                    if starts(t, "if not") is 1
                        emit_else_line(t, ind)
                    if not
                        close_blocks(ind)
                        opened: emit_stmt_parts(t)
                        if opened is 1
                            push_block(last_block_kind, ind, last_block_a, last_block_b)
        i: end + 1
    if in_fn is 1
        close_all()
    if in_fn is 1
        if fn_return_seen is 0
            if main_seen is 1 -> emitln("  ret i32 0")
        if fn_return_seen is 0
            if main_seen is 0
                emitln("  ret i64 0")
        emitln("}")
    ll_out: str_cat(ll_out, ll_globals)
    return 0

