main:
    ac: arg_count()
    if ac < 2
        print "Usage: compiler src.sov -o out.dll"
        sys_exit(1)
    inp: as text arg_at(1)
    outp: "sovren.dll"
    if ac is 3
        if str_eq(as text arg_at(1), "-o") is 0
            if str_eq(as text arg_at(2), "-o") is 0
                outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac
        if str_eq(as text arg_at(i), "-o") is 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not
            i: i + 1
    srclen: file_size(inp)
    src: file_read_all(inp)
    if src is 0
        print "windows-dll: cannot read input"
        sys_exit(1)
    n: emit_dll(parse_return())
    file_write_bytes(outp, buf, n)
    print "windows-dll: wrote "
    print outp
    return 0
