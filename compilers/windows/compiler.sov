    # wait (rdi = the block base, rsi the pre-observed status,
    # dead_alloc_name: the handle signals when the thread ends): look the
    # handle up by base/262272 and WaitForSingleObject on it
    task_names: _sov_list_add(task_names, "_sov_win_wait")
    task_at: _sov_list_add(task_at, here())
    bytes:
        72
