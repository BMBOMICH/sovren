leave_handback:
    # the prologue pushed the saved registers BELOW rbp (rbp-8 ..
    # rbp-8n) and the old rbp AT rbp. a bare x86 leave (mov rsp,
    # rbp; pop rbp) skips those slots and leaks eight bytes per
    # register per call; popping from rbp instead clobbers the
    # return address. walk rsp down over the register slots, pop
    # them, then pop the saved rbp.
    # fn_save_n 0: no register slots, but the prologue still did
    # sub rsp, N. a bare pop rbp then ret pops the empty frame
    # (zeros) and jumps to 0 - ACCESS_VIOLATION on Windows, which
    # is how sovren.exe died on no-args (Usage calls _sov_argc).
    if fn_save_n is 0
        emit(201)
        return 0
    if fn_save_n > 0
        # lea rsp, [rbp - 8n]: land exactly on the register slots,
        # whatever the frame size was. a sub rsp, 8n leaves the
        # frame in place and the pop rbp lands inside the frame
        emit(72)
        emit(141)
        emit(101)
        emit(256 - fn_save_n * 8)
    if fn_save_n > 4
        emit(65)
        emit(95)
    if fn_save_n > 3
        emit(65)
        emit(94)
    if fn_save_n > 2
        emit(65)
        emit(93)
    if fn_save_n > 1
        emit(65)
        emit(92)
    if fn_save_n > 0
        emit(91)
    emit(93)
    return 0

sysc:
    used_wc: 1
    calln("_sov_wincall")

call_args name argc direct:
    # cfunc(addr, a1..a6) calls a C function at a computed address.
    # C wants its arguments in rdi rsi rdx rcx r8 r9 and the stack
    # aligned to 16 bytes, and rax cleared for a variadic callee.
    if same(name, "cfunc") is 1
        # Windows hands arguments over differently from Linux: the
        # first four go in rcx, rdx, r8 and r9, the rest on the
        # stack, and the caller must leave thirty-two bytes of room
        # above them that the called code is allowed to scribble in.
        # Calling a Windows library the Linux way puts every
        # argument in the wrong place.
        emit(65)
        emit(89)
        emit(65)
        emit(88)
        emit(89)
        emit(90)
        emit(94)
        emit(95)
        emit(65)
        emit(91)
        emit(85)
        emit(72)
        emit(137)
        emit(229)
        emit(72)
        emit(131)
        emit(228)
        emit(240)
        emit(72)
        emit(131)
        emit(236)
        emit(64)
        emit(76)
        emit(137)
        emit(68)
        emit(36)
        emit(32)
        emit(76)
        emit(137)
        emit(76)
        emit(36)
        emit(40)
        emit(73)
        emit(137)
        emit(201)
        emit(73)
        emit(137)
        emit(208)
        emit(72)
        emit(137)
        emit(242)
        emit(72)
        emit(137)
        emit(249)
        emit(72)
        emit(49)
        emit(192)
        emit(65)
        emit(255)
        emit(211)
        emit(72)
        emit(137)
        emit(236)
        emit(93)
        return
    # the thread bridge builtins. the compiler rewrites the shared
    # runtime's clone/fork/futex syscalls into these (see the repl
    # block below), so thread code is one shared source; this target
    # answers them with CreateThread, WaitForSingleObject and
    # ExitThread. wake is a no-op: a thread's own end signals its
    # handle, which is all the wait side needs.
    if same(name, "thread_create") is 1
        used_thr: 1
        emit(94)
        pop_rax()
        mov_rdi_rax()
        calln("_sov_win_create")
        return
    if same(name, "thread_wait") is 1
        used_thr: 1
        emit(94)
        pop_rax()
        mov_rdi_rax()
        calln("_sov_win_wait")
        return
    if same(name, "thread_wake") is 1
        # the base arrives in rdi; windows needs no wake at all -
        # the waiter blocks in WaitForSingleObject and wakes when
        # the host thread dies
        used_thr: 1
        emit(49)
        emit(192)
        return
    if same(name, "thread_exit") is 1
        used_thr: 1
        emit(72)
        emit(184)
        at: here()
        emit8(0)
        addp(at, "iatslot", 16)
        emit(255)
        emit(16)
        return
    # the shared runtime's clone entry asks for the stack pointer
    # (dead on windows, but the call must still compile)
    if same(name, "sp") is 1
        emit(72)
        emit(137)
        emit(224)
        return
    if same(name, "syscall") is 1
        wc_dyn: 1
        # pop exactly the values that were pushed, highest position
        # first: a7->r9, a6->r8, a5->rcx, a4->rdx, a3->rsi,
        # a2->rdi, a1(num)->rax. the kernel wants arg4 in r10, so
        # a5 parks in rcx and moves at the last moment with the
        # caller's r10 saved around the whole sequence. r11 is
        # never touched. (the old code always popped seven; the
        # four-value print syscalls survived only because their
        # rbp frames absorbed three slots of drift.)
        sy: argc
        if sy > 7
            sy: 7
        if sy > 6
            emit(65)
            emit(89)
        if sy > 5
            emit(65)
            emit(88)
        if sy > 4
            emit(89)
        if sy > 3
            emit(90)
        if sy > 2
            emit(94)
        if sy > 1
            emit(95)
        pop_rax()
        if argc > 4
            emit(65)
            emit(82)
            emit(73)
            emit(137)
            emit(202)
            sysc()
            emit(65)
            emit(90)
        if not
            sysc()
        return
    if direct is 0
        if argc is 1
            pop_rax()
            mov_rdi_rax()
        if not
            if argc is 2
                emit(94)
                pop_rax()
                mov_rdi_rax()
            if not
                if argc is 3
                    emit(90)
                    emit(94)
                    pop_rax()
                    mov_rdi_rax()
                if not
                    if argc is 4
                        emit(89)
                        emit(90)
                        emit(94)
                        pop_rax()
                        mov_rdi_rax()
                    if not
                        if argc is 5
                            emit(65)
                            emit(88)
                            emit(89)
                            emit(90)
                            emit(94)
                            pop_rax()
                            mov_rdi_rax()
                        if not
                            if argc is 6
                                emit(65)
                                emit(89)
                                emit(65)
                                emit(88)
                                emit(89)
                                emit(90)
                                emit(94)
                                pop_rax()
                                mov_rdi_rax()
                            if not
                                if argc is 7
                                    emit(65)
                                    emit(90)
                                    emit(65)
                                    emit(89)
                                    emit(65)
                                    emit(88)
                                    emit(89)
                                    emit(90)
                                    emit(94)
                                    pop_rax()
                                    mov_rdi_rax()

    if same(name, "_sov_alloc") is 1
        used_al: 1
    if same(name, "_sov_strlen") is 1
        used_sl: 1
    if same(name, "_sov_str_eq") is 1
        used_eq: 1
    if same(name, "syscall") is 1
        wc_dyn: 1
        emit(65)
        emit(89)
        emit(65)
        emit(88)
        emit(65)
        emit(90)
        emit(65)
        emit(91)
        emit(90)
        emit(94)
        pop_rax()
        emit(72)
        emit(137)
        emit(247)
        emit(72)
        emit(137)
        emit(214)
        emit(76)
        emit(137)
        emit(218)
        sysc()
        return
    if same(name, "port_out8") is 1
        emit(72)
        emit(137)
        emit(248)
        emit(137)
        emit(214)
        emit(137)
        emit(240)
        emit(72)
        emit(137)
        emit(250)
        emit(137)
        emit(208)
        emit(238)
        return
    if same(name, "port_in8") is 1
        emit(72)
        emit(137)
        emit(250)
        emit(49)
        emit(192)
        emit(236)
        return
    if same(name, "hlt") is 1
        emit(244)
        return
    if same(name, "cli") is 1
        emit(250)
        return
    if same(name, "sti") is 1
        emit(251)
        return
    if same(name, "peek_raw8") is 1
        emit(72)
        emit(15)
        emit(182)
        emit(4)
        emit(55)
        return
    if same(name, "peek_raw64") is 1
        emit(72)
        emit(139)
        emit(4)
        emit(55)
        return
    if same(name, "poke_raw8") is 1
        emit(136)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "poke_raw64") is 1
        emit(72)
        emit(137)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "peek_byte") is 1
        chk_mem(1)
        emit(72)
        emit(15)
        emit(182)
        emit(4)
        emit(55)
        return
    if same(name, "peek_i64") is 1
        chk_mem(8)
        emit(72)
        emit(139)
        emit(4)
        emit(55)
        return
    if same(name, "peek_ptr") is 1
        chk_mem(8)
        emit(72)
        emit(139)
        emit(4)
        emit(247)
        return
    if same(name, "poke_byte") is 1
        chk_mem(1)
        emit(136)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    if same(name, "poke_i64") is 1
        chk_mem(8)
        emit(72)
        emit(137)
        emit(20)
        emit(55)
        mov_rax_rdi()
        return
    # bitwise, native: one opcode each. a is rdi, b is rsi, answer rax.
    # the language had no bit operators, so every and/or/xor in every
    # library was a 32-step loop over % and /
    if same(name, "band") is 1
        mov_rax_rsi()
        emit(72)
        emit(33)
        emit(248)
        return
    if same(name, "bor") is 1
        mov_rax_rsi()
        emit(72)
        emit(9)
        emit(248)
        return
    if same(name, "bxor") is 1
        mov_rax_rsi()
        emit(72)
        emit(49)
        emit(248)
        return
    if same(name, "bshl") is 1
        mov_rcx_rsi()
        mov_rax_rdi()
        emit(72)
        emit(211)
        emit(224)
        return
    if same(name, "bshr") is 1
        mov_rcx_rsi()
        mov_rax_rdi()
        emit(72)
        emit(211)
        emit(232)
        return
    # arithmetic shift right: the exact replacement for "a / 2", which
    # truncates toward zero and so keeps a negative's sign
    if same(name, "bsar") is 1
        mov_rcx_rsi()
        mov_rax_rdi()
        emit(72)
        emit(211)
        emit(248)
        return
    # ---- things every other language has as one instruction ----
    # a is rdi, b is rsi, c is rdx, answer rax
    if same(name, "_sov_mem_copy") is 1
        mov_rax_rdi()
        mov_rcx_rdx()
        emit(243)
        emit(164)
        return
    if same(name, "_sov_mem_set") is 1
        # rep stosb takes its byte from al, so rax is busy for the
        # whole fill and rdi walks off the end of the block. The
        # destination is what a caller wants back - everyone writes
        # mem_zero(mem_new(n), n) - so park it on the stack and hand
        # it back, the way memset does. Returning the fill value
        # instead handed callers a null pointer.
        emit(87)
        mov_rax_rsi()
        mov_rcx_rdx()
        emit(243)
        emit(170)
        emit(88)
        return
    if same(name, "bswap64") is 1
        mov_rax_rdi()
        emit(72)
        emit(15)
        emit(200)
        return
    if same(name, "iabs") is 1
        mov_rax_rdi()
        emit(72)
        emit(247)
        emit(216)
        emit(72)
        emit(15)
        emit(72)
        emit(199)
        return
    # atomics: rdi is the slot, rsi the value, rdx the cas desired.
    # lock xadd/xchg/cmpxchg, verified with as+objdump. rax comes
    # back as the old value, which is what a mutex_swap wants.
    if same(name, "atomic_add") is 1
        mov_rax_rsi()
        emit(240)
        emit(72)
        emit(15)
        emit(193)
        emit(7)
        return
    if same(name, "atomic_swap") is 1
        mov_rax_rsi()
        emit(240)
        emit(72)
        emit(135)
        emit(7)
        return
    if same(name, "atomic_load") is 1
        emit(72)
        emit(139)
        emit(7)
        return
    if same(name, "atomic_store") is 1
        emit(72)
        emit(137)
        emit(55)
        mov_rax_rsi()
        return
    if same(name, "atomic_cas") is 1
        mov_rax_rsi()
        emit(72)
        emit(137)
        emit(214)
        emit(240)
        emit(72)
        emit(15)
        emit(177)
        emit(55)
        return
    calln(name)
