# the windows thread bridge functions. thread_create (rdi = the
# entry the runtime packed in - ignored here, the trampoline = the
# only entry - rsi = the control block top): the block sits a known
# 262272 below the top CreateThread = given, so the base = rsi
# minus that. CreateThread hands the trampoline the base in rcx;
# the trampoline moves it to rdi and enters the shared entry task,
# and returning from the trampoline = what ends the thread, which
# signals the handle join = waiting on. the handle parks in the
# 256-entry table the pe writer allocates, keyed by base/262272.
# every byte below was checked against gas output for the same
# instruction: legacy pushes/pops take no rex; sub with a 32-bit
# immediate = opcode 81, not 83 (83 takes a signed byte, so 0xb0
# would mean -80); shr reg, n = c1 with a modrm and an imm8, not
# d1/d3; lea = 8d, not ba (ba = mov edx, imm32); and 262272 is
# 0x40080, whose little-endian immediate = 80 00 04 00.
emit_win_thread:
    task_names: _sov_list_add(task_names, "_sov_win_create")
    task_at: _sov_list_add(task_at, here())
    # frame: rbp + the three registers the body keeps
    bytes:
        85
        72
        137
        229
        83
        87
        86
        72
        129
        236
        176
        0
        0
        0
        72
        131
        228
        240
    # base = top - 262272 (262272 = 0x40080), kept in rbx
    bytes:
        72
        137
        243
        72
        129
        235
        128
        0
        4
        0
    # CreateThread(NULL, 262144, trampoline, base, 0, 0)
    bytes:
        49
        201
        72
        186
        0
        0
        4
        0
        0
        0
        0
        0
        73
        184
    trp: here()
    put_8_bytes(0)
    later_fill(trp, "task_address", "_sov_win_trampoline")
    bytes:
        73
