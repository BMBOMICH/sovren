        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
main argc argv:
    # remember where this compiler lives, so its library and runtime
    # are found no matter which folder you run it from
    self_dir: dirname(tidy_path(peek_ptr(argv, 0)))
    if argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail()
    inf: blank
    outf: blank
    i: 1
    as long as i < argc
        arg: peek_ptr(argv, i)
        if same(arg, "--bare") is 1
            bare_mode: 1
        if not
            if same(arg, "-o") is 1
                i: i + 1
                if i < argc
                    outf: peek_ptr(argv, i)
            if not
                if same(arg, "build") is 0
                    inf: arg
        i: i + 1
    if length(inf) is 0
        print "Error: no input"
        fail()
    if length(outf) is 0
        d: look(inf, ".sov")
        if d > 0 - 1
            outf: cut(inf, 0, d)
        if not
            outf: join(inf, ".out")
    src_name: inf
    print "Compiling"
    _sov_print(inf)
    src: load_file(inf)
    if src is 0
        print "Error: cannot read input"
        fail()
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    src: join(join("# pad line so main is not first", nl), src)
    used_libs: blank
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    need: 0
    mmap_sz: 12582912
    if look(src, "_sov_list") > 0 - 1
        need: 1
    if look(src, "load_file") > 0 - 1
        need: 1
    if look(src, "_sov_buf") > 0 - 1
        need: 1
    if look(src, "_sov_alloc") > 0 - 1
        need: 1
    if look(src, "_sov_set_byte") > 0 - 1
        need: 1
    if look(src, "peek_byte") > 0 - 1
        need: 1
    if look(src, "poke_byte") > 0 - 1
        need: 1
    if look(src, "spawn ") > 0 - 1
        need: 1
    if look(src, "join ") > 0 - 1
        need: 1
    rt: blank
    if bare_mode is 1
        need: 0
    if need is 1
        mmap_sz: 1073741824
        rt: load_file("runtime.sov")
        if rt is 0
            rt: load_file("linux/runtime.sov")
        if rt is 0
            rt: load_file(join(self_dir, "/runtime.sov"))
        if rt is 0
            rt: load_file(join(self_dir, "/../runtime.sov"))
        if rt is 0
            print "Error: cannot read runtime"
            fail()
        # the windows thread bridge: the runtime's clone/fork and
        # futex lines become the bridge builtins, which the codegen
        # answers with CreateThread, WaitForSingleObject and a no-op
        # wake (the thread's own end signals its handle)
        rt: repl(rt, "syscall(56, e, top, 12032, 0, 0, 0)", "thread_create(e, top)")
        rt: repl(rt, "syscall(57, 0, 0, 0, 0, 0, 0)", "thread_create(0, 0)")
        rt: repl(rt, "syscall(202, cb, 1, 1, 0, 0, 0)", "thread_wake(cb)")
        rt: repl(rt, "syscall(202, base, 1, 1, 0, 0, 0)", "thread_wake(base)")
        rt: repl(rt, "syscall(202, h, 0, s, 0, 0, 0)", "thread_wait(h, s)")
    src_base: 1
    if length(rt) > 0
        src_base: src_base + _sov_list_len(lines_of(rt))
    if length(extra) > 0
        src_base: src_base + _sov_list_len(lines_of(extra))
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    all: join(rt, nl)
    src_base: src_base + 1
    if need is 1
        # the runtime's thread paths end themselves through this
        # injected task; on windows a thread is a CreateThread
        # function, so ending it is ExitThread
        all: join(all, nl)
        all: join(all, join("_sov_thread_exit:", nl))
        all: join(all, join("    thread_exit()", nl))
        all: join(all, join("    return 0 - 1", nl))
        src_base: src_base + 4
    all: join(all, src)
    compile(all)
    write_elf(outf)
    if had_err is 1
        fail()
    print "Wrote"
    _sov_print(outf)

# the spawn packing is os-neutral: it lands the job pointer and its
# values in the Sovren call registers and calls the shared runtime's
# _sov_thread_spawn, whose clone/fork/futex syscalls the repl block
# above turns into the windows bridge builtins.
