    # the thread entry: Windows hands the parameter in rcx, the
    # shared entry task takes it in rdi; returning ends the thread
    task_names: _sov_list_add(task_names, "_sov_win_trampoline")
    task_at: _sov_list_add(task_at, here())
    bytes:
