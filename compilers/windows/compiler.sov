# windows hands back argv[0] wrapped in quotes, as a drive path with
# backslashes. turn it into the plain form the file calls understand.
emit_stack_wipe:
    # pass 139: the heap, first. heap_ptr is the program's own bump
    # frontier; every byte below it down to the mapping base was
    # allocated by the program, and a private program that never
    # called secret_die left it all in committed memory at exit.
    # the walk finds the base itself: VirtualQuery probing downward
    # - uncommitted or reserved pages refuse, every MEM_COMMIT page
    # takes the stosq. guard: heap_ptr zero means no heap started.
    if idx(glob_names, "heap_ptr") > 0 - 1
        emit(72)
        emit(184)
        hp_at: here()
        emit8(0)
        addp(hp_at, "glob", "heap_ptr")
        emit(72)
        emit(139)
        emit(0)
        emit(72)
        emit(133)
        emit(192)
        hp_sk: jz()
        emit(72)
        emit(137)
        emit(199)
        emit(72)
        emit(129)
        emit(231)
        emit4(4294963200)
        # pass 141: the heap mapping is 64MB - 16384 pages, a hard
        # bound no gapless neighbor below can stretch
        emit(65)
        emit(185)
        emit4(16384)
        hw_loop: here()
        emit(72)
        emit(141)
        emit(116)
        emit(36)
        emit(192)
        emit(65)
        emit(184)
        emit4(28)
        emit(72)
        emit(137)
        emit(249)
        emit(72)
        emit(137)
        emit(242)
        emit(72)
        emit(184)
        hw_at: here()
        emit8(0)
        addp(hw_at, "iatslot", 13)
        emit(255)
        emit(16)
        emit(72)
        emit(133)
        emit(192)
        hw_q: jnz()
        emit(129)
        emit(124)
        emit(36)
        emit(192)
        emit4(4096)
        hw_s: jnz()
        emit(49)
        emit(192)
        emit(185)
        emit4(512)
        emit(252)
        emit(243)
        emit(72)
        emit(171)
        emit(72)
        emit(129)
        emit(239)
        emit4(8192)
        emit(65)
        emit(255)
        emit(201)
        hw_cap: jz()
        hw_back: jmp()
        put(hw_back, hw_loop - (hw_back + 4))
        patch(hw_q)
        patch(hw_s)
        patch(hw_cap)
        patch(hp_sk)
    # pass 136: the globals region first - one stosq, bounds patched
    # at write time. 48 BF is movabs rdi (48 B8 is rax; the stosq
    # would fire with a stale rdi, which is how the linux version
    # taught us the difference).
    emit(72)
    emit(191)
    gwa: here()
    emit8(0)
    addp(gwa, "gwipe_a", 0)
    emit(185)
    gwn: here()
    emit4(0)
    addp(gwn, "gwipe_n", 0)
    emit(49)
    emit(192)
    emit(252)
    emit(243)
    emit(72)
    emit(171)
    # pass 137: the string literals. a secret written as a constant
    # in the source lives in this span until now.
    emit(72)
    emit(191)
    gsa: here()
    emit8(0)
    addp(gsa, "gwstr_a", 0)
    emit(185)
    gsn: here()
    emit4(0)
    addp(gsn, "gwstr_n", 0)
    emit(49)
    emit(192)
    emit(252)
    emit(243)
    emit(72)
    emit(171)
    # pass 133: the windows twin. no mincore - the probe is
    # VirtualQuery (import slot 13; the import table is written
    # from imp_name at output time, so a slot is one line). walk
    # down from the page holding rsp: query it, stop when the
    # query fails or the page is not MEM_COMMIT (uncommitted stack
    # reserve reads as reserved, so the walk stops at the guard
    # boundary instead of faulting), else zero it and step down.
    # the 28-byte MEMORY_BASIC_INFORMATION lives at rsp-64: dead
    # space below the running frame, rewritten by every query and
    # overwritten by the first stosq pass. State sits at offset 32.
    emit(72)
    emit(137)
    emit(231)
    emit(72)
    emit(129)
    emit(231)
    emit4(4294963200)
    # pass 141: 64MB of pages is a hard bound - no gapless
    # neighbor below the stack takes the stosq
    emit(65)
    emit(185)
    emit4(16384)
    sw_head: here()
    emit(72)
    emit(141)
    emit(116)
    emit(36)
    emit(192)
    emit(65)
    emit(184)
    emit4(28)
    emit(72)
    emit(137)
    emit(249)
    emit(72)
    emit(137)
    emit(242)
    emit(72)
    emit(184)
    sw_at: here()
    emit8(0)
    addp(sw_at, "iatslot", 13)
    emit(255)
    emit(16)
    emit(72)
    emit(133)
    emit(192)
    sw_q: jnz()
    emit(129)
    emit(124)
    emit(36)
    emit(224)
    emit4(4096)
    sw_s: jnz()
    emit(49)
    emit(192)
    emit(185)
    emit4(512)
    emit(252)
    emit(243)
    emit(72)
    emit(171)
    emit(72)
    emit(129)
    emit(239)
    emit4(8192)
    emit(65)
    emit(255)
    emit(201)
    sw_cap: jz()
    sw_back: jmp()
    put(sw_back, sw_head - (sw_back + 4))
    patch(sw_q)
    patch(sw_s)
    patch(sw_cap)
    # pass 138: the up-walk. pages ABOVE the rsp page hold the dead
    # frames and the initial block - argv strings, env strings, the
    # arrays. the same VirtualQuery probe gates it: uncommitted or
    # reserved stops the walk, MEM_COMMIT takes the stosq, and the
    # stosq itself steps rdi to the next page up.
    emit(72)
    emit(137)
    emit(231)
    emit(72)
    emit(129)
    emit(231)
    emit4(4294963200)
    emit(72)
    emit(129)
    emit(199)
    emit4(4096)
    # pass 141: 16MB above the frame bounds the up-walk
    emit(65)
    emit(185)
    emit4(4096)
    up_head: here()
    emit(72)
    emit(141)
    emit(116)
    emit(36)
    emit(192)
    emit(65)
    emit(184)
    emit4(28)
    emit(72)
    emit(137)
    emit(249)
    emit(72)
    emit(137)
    emit(242)
    emit(72)
    emit(184)
    up_at: here()
    emit8(0)
    addp(up_at, "iatslot", 13)
    emit(255)
    emit(16)
    emit(72)
    emit(133)
    emit(192)
    up_q: jnz()
    emit(129)
    emit(124)
    emit(36)
    emit(192)
    emit4(4096)
    up_s: jnz()
    emit(49)
    emit(192)
    emit(185)
    emit4(512)
    emit(252)
    emit(243)
    emit(72)
    emit(171)
    emit(65)
    emit(255)
    emit(201)
    up_cap: jz()
    up_back: jmp()
    put(up_back, up_head - (up_back + 4))
    patch(up_q)
    patch(up_s)
    patch(up_cap)
    # pass 142: the register file itself - every
    # general-purpose register left holding residue is
    # zeroed, so even the exit trap hands the kernel a
    # clean register dump. rax/rdi are set fresh by the
    # exit that follows.
    emit(49)
    emit(219)
    emit(49)
    emit(237)
    emit(49)
    emit(246)
    emit(49)
    emit(210)
    emit(49)
    emit(201)
    emit(69)
    emit(49)
    emit(192)
    emit(69)
    emit(49)
    emit(201)
    emit(69)
    emit(49)
    emit(210)
    emit(69)
    emit(49)
    emit(219)
    emit(69)
    emit(49)
    emit(228)
    emit(69)
    emit(49)
    emit(237)
    emit(69)
    emit(49)
    emit(246)
    emit(69)
    emit(49)
    emit(255)
    emit(49)
    emit(192)
    return
emit_nodump:
    rax_imm(157)
    rdi_imm(4)
    emit(49)
    emit(246)
    sysc()

emit_canary_seed:
    dummy: imp_mark(11)
    dummy: imp_mark(12)
    dummy: imp_mark(7)
    if idx(glob_names, "g_canary") is 0 - 1
        glob_names: _sov_list_add(glob_names, "g_canary")
    # pass S5 on windows: the canary seed. RtlGenRandom lives in
    # advapi32 under its export name SystemFunction036, asked for
    # at run time so the import table never changes. the two
    # qword string loads are gwstr_a sites - DIR64-relocated, so
    # the names travel with the image under ASLR
    emit(72)
    emit(184)
    csa: here()
    emit8(0)
    addp(csa, "iatslot", 11)
    emit(72)
    emit(185)
    csb: here()
    emit8(0)
    addp(csb, "gwstr_a", intern_nz("ADVAPI32.DLL"))
    emit(255)
    emit(16)
    emit(72)
    emit(137)
    emit(193)
    emit(72)
    emit(184)
    csc: here()
    emit8(0)
    addp(csc, "iatslot", 12)
    emit(72)
    emit(186)
    csd: here()
    emit8(0)
    addp(csd, "gwstr_a", intern_nz("SystemFunction036"))
    emit(255)
    emit(16)
    emit(72)
    emit(133)
    emit(192)
    csz: jz()
    # rcx = &g_canary, rdx = 8, call SystemFunction036
    emit(72)
    emit(141)
    emit(13)
    cse: here()
    emit4(0)
    addp(cse, "grel", "g_canary")
    emit(186)
    emit4(8)
    emit(255)
    emit(208)
    # SystemFunction036 wrote the entropy into [rcx] itself;
    # its return value is only a yes/no, so this path skips the
    # store - the canary is already in place
    csj: jmp()
    patch(csz)
    # no advapi32, or the export is gone: mix three live ASLR
    # values - the command line, the stack pointer, the canary's
    # own address. never a constant
    emit(72)
    emit(184)
    csf: here()
    emit8(0)
    addp(csf, "iatslot", 7)
    emit(255)
    emit(16)
    emit(72)
    emit(49)
    emit(224)
    emit(72)
    emit(141)
    emit(13)
    csg: here()
    emit4(0)
    addp(csg, "grel", "g_canary")
    emit(72)
    emit(49)
    emit(200)
    emit(72)
    emit(137)
    emit(5)
    csh: here()
    emit4(0)
    addp(csh, "grel", "g_canary")
    patch(csj)

emit_crash_handler:
    # pass S6 on windows: one vectored handler instead of five
    # signal stubs. it never returns - wipe, then exit 111
    fn_names: _sov_list_add(fn_names, "_sov_cw_all")
    fn_offs: _sov_list_add(fn_offs, here())
    emit_write_lit("crash\n")
    emit_stack_wipe()
    rdi_imm(111)
    emit(106)
    emit(60)
    emit(88)
    sysc()

