    call("_sov_thread_entry_param")
    put_in_program(195)
compile source:
    want_window: 0
    if look(source, "_sov_win_gui") > 0 - 1
        want_window: 1
    code: _sov_list_new()
    bump_ptr: blank
    bump_end: blank
    known_name: blank
    known_value: 0
    dead_alloc_name: blank
    used_alloc: 0
    used_text_length: 0
    used_texts_equal: 0
    used_print: 0
    used_print_number: 0
    used_windows_call: 0
    used_crash: 0
    windows_late: 0
    rare_windows: 0
    used_fill: 0
    tiny_program: 0
    needs_heap: 0
    needs_private: 0
    saw_letters: 0
    letter_boxes: _sov_list_new()
    letter_tasks: _sov_list_new()
    array_names: _sov_list_new()
    array_count: _sov_list_new()
    fn_locs: _sov_list_new()
    letter_tasks: _sov_list_add(letter_tasks, "cat")
    letter_tasks: _sov_list_add(letter_tasks, "strcat")
    letter_tasks: _sov_list_add(letter_tasks, "_sov_strcat")
    letter_tasks: _sov_list_add(letter_tasks, "sub")
    letter_tasks: _sov_list_add(letter_tasks, "trim")
    letter_tasks: _sov_list_add(letter_tasks, "ch")
    letter_tasks: _sov_list_add(letter_tasks, "_sov_substring")
    seed_str_fns
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) = 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") = 0
                    if starts(pre_t, "use ") = 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c = length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") = 1
                                            pre_in: 0
                                        if not
                                            if pre_in = 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
                                    # seven values = the most a job can
                                    # take. more used to compile and then
                                    # go wrong while running.
                                    if pre_na > 7
                                        print "Error: a job takes at most seven values" : pre_cur
                                        print "name" : pre_na
                                        saw_error: 1
                                    array_names: _sov_list_add(array_names, pre_cur)
                                    array_count: _sov_list_add(array_count, pre_na)
                                if not
                                    pre_cur: pre_h
                                    array_names: _sov_list_add(array_names, pre_cur)
                                    array_count: _sov_list_add(array_count, 0)
            if not
                pre_t2: strip(pre_l)
                if starts(pre_t2, "return ") = 1
                    pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                    if starts(pre_r, "as text ") = 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if starts(pre_r, "as ptr ") = 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if length(pre_r) > 0
                        if _sov_byte_at(pre_r, 0) = 34
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                        if not
                            if same(pre_r, "blank") = 1
                                if length(pre_cur) > 0
                                    mark_fn_str(pre_cur)
        pre_i: pre_i + 1
    # a job that hands back another job's answer = a text job too,
    # whatever order the jobs were written in. Keep going round until
    # nobody new = marked, so forward references work as well as
    # backward ones.
    changed: 1
    as long as changed = 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) = 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") = 0
                        if starts(pre_t, "use ") = 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c = length(pre_t) - 1
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    if starts(pre_t2, "return ") = 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(letter_tasks, pre_cur) < 0
                            if starts(pre_r, "as text ") = 0
                                if starts(pre_r, "as ptr ") = 0
                                    if length(pre_r) > 0
                                        if _sov_byte_at(pre_r, 0) is not 34
                                            if same(pre_r, "blank") = 0
                                                pre_lp: look(pre_r, "(")
                                                if pre_lp > 0
                                                    pre_f: strip(cut(pre_r, 0, pre_lp))
                                                    if idx(letter_tasks, pre_f) > 0 - 1
                                                        mark_fn_str(pre_cur)
                                                        changed: 1
            pre_i: pre_i + 1
    # a program that wipes or marks private data must not core-dump it.
    # match the statements, not the substring: the old look() matched
    # "# would wipe what the stub stored" in a runtime comment and
    # spent 14 bytes of prctl in every runtime-linked binary.
    nls: lines_of(source)
    ni: 0
    as long as ni < _sov_list_len(nls)
        ns: strip(_sov_list_get(nls, ni))
        if same(ns, "private") = 1
            needs_private: 1
        if starts(ns, "wipe ") = 1
            needs_private: 1
        ni: ni + 1
    const_names: _sov_list_new()
    const_values: _sov_list_new()
    const_dirty: _sov_list_new()
    letters: _sov_buf_new()
    letter_keys: _sov_list_new()
    letters_at: _sov_list_new()
    task_names: _sov_list_new()
    task_at: _sov_list_new()
    global_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_value: _sov_list_new()
    patch_line: _sov_list_new()
    line_of_stmt: _sov_list_new()
    line_of_body: _sov_list_new()
    line_of_task: _sov_list_new()
    user_tasks: _sov_list_new()
    lns: lines_of(source)
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    loose: _sov_list_new()
    loose_lns: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    li: 0
    as long as li < _sov_list_len(lns)
        raw: _sov_list_get(lns, li)
        s: strip(raw)
        th: 0
        if nind(raw) = 0
            if is_task_hdr(s) = 1
                th: 1
        if nind(raw) = 0
            if th = 0
                if length(s) > 0
                    if peek_byte(s, 0) is not 35
                        if in_t = 1
                            cur: expand_bytes(cur)
                            bodies: _sov_list_add(bodies, cur)
                            line_of_body: _sov_list_add(line_of_body, cur_ln)
                            in_t: 0
        if th = 1
            if in_t = 1
                cur: expand_bytes(cur)
                bodies: _sov_list_add(bodies, cur)
                line_of_body: _sov_list_add(line_of_body, cur_ln)
            tn: tname(s)
            if same(tn, "main") = 1
                print "Error: main is gone, put the code at the top of the file"
                error_line: file_ln(li)
                err_where
                saw_error: 1
                tn: "_gone_main"
            if idx(names, tn) > 0 - 1
                print "Error: two with the same name" : tn
                error_line: file_ln(li)
                print "line" : error_line
                saw_error: 1
            names: _sov_list_add(names, tn)
            params: _sov_list_add(params, tparams(s))
            tu: 0
            if li + 1 > first_user_line
                tu: 1
            user_tasks: _sov_list_add(user_tasks, tu)
            line_of_task: _sov_list_add(line_of_task, file_ln(li))
            cur: _sov_list_new()
            cur_ln: _sov_list_new()
            in_t: 1
        if not
            if nind(raw) = 0
                gok: 0
                gc: find_col(s)
                if gc > 0
                    if gc < length(s) - 1
                        gok: 1
                if gok = 1
                    gn: blank
                    if starts(s, "<-- ") = 1
                        rest: cut(s, 4, length(s))
                        t: find_sep(rest)
                        if t > 0 - 1
                            gn: repl(strip(cut(rest, 0, t)), " ", "_")
                    if not
                        gn: repl(strip(cut(s, 0, gc)), " ", "_")
                    if length(gn) > 0
                        if idx(names, gn) < 0
                            if idx(global_names, gn) = 0 - 1
                                global_names: _sov_list_add(global_names, gn)
                        if not
                            grhs0: strip(cut(s, gc + 1, length(s)))
                            keepg: 0
                            if is_imm(grhs0) = 1
                                keepg: 1
                            if look(grhs0, "(") > 0 - 1
                                keepg: 1
                            if keepg = 1
                                if idx(global_names, gn) = 0 - 1
                                    global_names: _sov_list_add(global_names, gn)
                        # a top-level "x: x" only registers the global;
                        # the store = a no-op (the start stub has already
                        # filled g_argc/g_argv before main runs). skip it.
                        sa: 0
                        if gc + 1 < length(s)
                            grhs: strip(cut(s, gc + 1, length(s)))
                            if same(repl(grhs, " ", "_"), gn) = 1
                                sa: 1
                        if sa = 0
                            loose: _sov_list_add(loose, raw)
                            loose_lns: _sov_list_add(loose_lns, file_ln(li))
                if gok = 0
                    if length(s) > 0
                        if peek_byte(s, 0) is not 35
                            if starts(s, "use ") = 0
                                loose: _sov_list_add(loose, raw)
                                loose_lns: _sov_list_add(loose_lns, file_ln(li))
            if not
                if in_t = 1
                    cur: _sov_list_add(cur, raw)
                    cur_ln: _sov_list_add(cur_ln, file_ln(li))
                if not
                    loose: _sov_list_add(loose, raw)
                    loose_lns: _sov_list_add(loose_lns, file_ln(li))
        li: li + 1
    if in_t = 1
        cur: expand_bytes(cur)
        bodies: _sov_list_add(bodies, cur)
        line_of_body: _sov_list_add(line_of_body, cur_ln)
    if _sov_list_len(loose) > 0
        if idx(names, "main") > 0 - 1
            print "Error: code outside main"
            error_line: _sov_list_get(loose_lns, 0)
            err_where
            saw_error: 1
        if not
            names: _sov_list_add(names, "main")
            params: _sov_list_add(params, _sov_list_new())
            loose: expand_bytes(loose)
            bodies: _sov_list_add(bodies, loose)
            line_of_body: _sov_list_add(line_of_body, loose_lns)
            user_tasks: _sov_list_add(user_tasks, 1)
            line_of_task: _sov_list_add(line_of_task, _sov_list_get(loose_lns, 0))
    if idx(names, "main") < 0
        if _sov_list_len(tops) > 0
            names: _sov_list_add(names, "main")
            params: _sov_list_add(params, _sov_list_new())
            bodies: _sov_list_add(bodies, _sov_list_new())
            line_of_body: _sov_list_add(line_of_body, _sov_list_new())
            user_tasks: _sov_list_add(user_tasks, 1)
            line_of_task: _sov_list_add(line_of_task, 1)
    needs_args: 0
    if look(source, "g_argc") > 0 - 1
        needs_args: 1
    needs_heap: 0
    if look(source, "task _sov_alloc") > 0 - 1
        needs_heap: 1
    if look(source, "_sov_alloc size:") > 0 - 1
        needs_heap: 1
    prep_main(names, params, bodies)
    fli: 0
    as long as fli < _sov_list_len(bodies)
        fb: _sov_list_get(bodies, fli)
        fset: _sov_list_new()
        flj: 0
        as long as flj < _sov_list_len(fb)
            fls: strip(_sov_list_get(fb, flj))
            if length(fls) > 0
                if _sov_byte_at(fls, 0) is not 35
                    if _sov_byte_at(fls, 0) is not 34
                        fgc: find_col(fls)
                        if fgc > 0
                            if fgc < length(fls) - 1
                                fgn: repl(strip(cut(fls, 0, fgc)), " ", "_")
                                if length(fgn) > 0
                                    if idx(global_names, fgn) = 0 - 1
                                        if idx(fset, fgn) = 0 - 1
                                            fset: _sov_list_add(fset, fgn)
            flj: flj + 1
        fn_locs: _sov_list_add(fn_locs, _sov_list_len(fset))
        fli: fli + 1
    if needs_heap = 1
        global_names: _sov_list_add(global_names, "heap_ptr")
        emit_start
        emit_wincall
        used_windows_call: 0
        emit_alloc
        emit_strlen
        emit_streq
        emit_print
        emit_print_int
        # the thread bridge, when the re-placed runtime asks for it
        if look(source, "thread_create") > 0 - 1
            emit_win_thread
        tiny_program: 0
    if not
        if tiny_program = 0
            emit_start
    fi: 0
    as long as fi < _sov_list_len(names)
        nm: _sov_list_get(names, fi)
        if same(nm, "_sov_win_exec") = 1
            if idx(task_names, nm) < 0
                emit_win_exec
        if same(nm, "_sov_image_base") = 1
            if idx(task_names, nm) < 0
                emit_image_base
        if same(nm, "_sov_ccall") = 1
            if idx(task_names, nm) < 0
                emit_win_ccall
        if idx(task_names, nm) < 0
                task_names: _sov_list_add(task_names, nm)
                task_at: _sov_list_add(task_at, here())
                local_names: _sov_list_new()
                letter_boxes: _sov_list_new()
                saw_letters: 0
                inside_if: 0
                line_of_stmt: _sov_list_get(line_of_body, fi)
                if _sov_list_len(_sov_list_get(bodies, fi)) = 0
                    if _sov_list_get(user_tasks, fi) = 1
                        print "Warning: empty" : nm
                        print "line" : _sov_list_get(line_of_task, fi)
                ps: _sov_list_get(params, fi)
                pi: 0
                as long as pi < _sov_list_len(ps)
                    local_names: _sov_list_add(local_names, _sov_list_get(ps, pi))
                    pi: pi + 1
                thin: 0
                if same(nm, "main") = 1
                    if _sov_list_len(ps) = 0
                        thin: 0
                if thin = 1
                    dead_alloc_name: drop_unused(_sov_list_get(bodies, fi))
                    if needs_private = 1
                        emit_nodump
                    leaf8: leaf8_scan(tops)
                    body(tops)
                    cflush_all
                    leaf8: 0
                    if _sov_list_len(ps) = 0
                        leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                    body(_sov_list_get(bodies, fi))
                    if saw_letters = 1
                        mark_fn_str(nm)
                    if needs_private = 1
                        emit_stack_wipe
                    bytes:
                        49
                        255
                        106
                        60
                        88
                    ask_kernel
                if not
                    saved_locals: 0
                    frame_open: 0
                    frame_done: 0
                    frame_holes: _sov_list_new()
                    fargs: _sov_list_len(ps)
                    floc: 0
                    if fi < _sov_list_len(fn_locs)
                        floc: _sov_list_get(fn_locs, fi)
                    ftot: fargs + floc
                    if ftot > 5
                        ftot: 5
                    saved_locals: ftot
                    skip_frame: 0
                    if fargs + floc < 6
                        if starts(nm, "_sov_") = 0
                            if same(nm, "main") = 0
                                skip_frame: 1
                    isfib: fiblike(nm, ps, _sov_list_get(bodies, fi))
                    if isfib = 1
                        # frame-free: the iterative body touches rbx
                        # (the arg) and nothing else callee-saved -
                        # a/rdx/rcx are caller-saved - so the frame
                        # = one register, not three
                        saved_locals: 1
                        skip_frame: 1
                    can_here: 0
                    cbi: 0
                    as long as cbi < _sov_list_len(_sov_list_get(bodies, fi))
                        if same(strip(_sov_list_get(_sov_list_get(bodies, fi), cbi)), "private") = 1
                            can_here: 1
                        cbi: cbi + 1
                    prolog
                    # a thin build enters at main itself: the seed
                    # and the handler still have to run first
                    if same(nm, "main") = 1
                        if tiny_program = 1
                            if needs_private = 1
                                emit_canary_seed
                                emit_crash_install
                    if can_here = 1
                        if skip_frame = 0
                            if isfib = 0
                                canary_store
                    copyargs(_sov_list_len(ps))
                    if isfib = 1
                        emit_fib_iter
                    if not
                        if same(nm, "main") = 1
                            dead_alloc_name: drop_unused(_sov_list_get(bodies, fi))
                            if needs_private = 1
                                emit_nodump
                            leaf8: leaf8_scan(tops)
                            at_top: 1
                            body(tops)
                            at_top: 0
                            cflush_all
                        leaf8: 0
                        if _sov_list_len(ps) = 0
                            leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                        if same(nm, "main") = 1
                            at_top: 1
                        body(_sov_list_get(bodies, fi))
                        if same(nm, "main") = 1
                            at_top: 0
                    if _sov_list_len(local_names) < 6
                        if saved_locals < _sov_list_len(local_names)
                            print "Warning: local_names" : nm
                            print "local_names" : _sov_list_len(local_names)
                            print "saved" : saved_locals
                    if saw_letters = 1
                        mark_fn_str(nm)
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes below
                    # the frame pointer, so the room has to be a full
                    # slot deeper than the count, or the callee's own
                    # frame lands on top of our spilled values
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes
                    # below the frame pointer, so the room has to be
                    # a full slot deeper than the count, or the
                    # callee's own frame lands on top of our spilled
                    # values
                    if skip_frame = 0
                        ns: (_sov_list_len(local_names) + 1) * 8
                        if ns < 32
                            ns: 32
                        if _sov_list_len(guard_holes) > 0
                            ns: ns + 16
                        put(frame_at, ns)
                        if frame_open = 1
                            if isfib = 0
                                canary_check
                                xor_rax
                                restores
                                frame_wipe
                                put_in_program(201)
                                ret
                                frame_done: 1
                            fwi: 0
                            as long as fwi < _sov_list_len(frame_holes)
                                put(_sov_list_get(frame_holes, fwi), ns + saved_locals * 8)
                                fwi: fwi + 1
                        # the canary sits just above the saved
                        # registers, below every local; point the
                        # compare and the store at it, then spend
                        # the list
                        chi2: 0
                        as long as chi2 < _sov_list_len(guard_holes)
                            put(_sov_list_get(guard_holes, chi2), 8 - ns - saved_locals * 8)
                            chi2: chi2 + 1
                        guard_holes: 0
                    if same(nm, "main") = 1
                        if needs_private = 1
                            emit_stack_wipe
                        bytes:
                            49
                            255
                        emit_sys_num(60)
                        emit_sys_do
                    if not
                        # the fib fast path ends in its own leave/ret;
                        # a second epilogue here would be dead bytes
                        if isfib = 0
                            if frame_done = 0
                                xor_rax
                                restore_frame
                                ret
        fi: fi + 1
    if needs_heap = 0
        emit_used
    if used_guard = 1
        emit_canary_fail
    if needs_private = 1
        emit_crash_handler
    warn_unused
    dce
    dce_stores
    dce_litter
    dce_globals
poke2 p off v:
    dummy: _sov_set_byte(p, off, v % 256)
    dummy: _sov_set_byte(p, off + 1, v / 256)
    return 0

# The import table. The compiler emits only the entries the code
# actually referenced, plus LoadLibraryA and GetProcAddress (always
# last) so `use winapi` can reach any other library at run time.
# imp_name maps a slot to its kernel32 name; imp_used holds the
# slots in the order they sit in the table.
imp_used: 0
imp_name s:
    if s = 0
        return "GetStdHandle"
    if s = 1
        return "WriteFile"
    if s = 2
        return "ReadFile"
    if s = 3
        return "CreateFileA"
    if s = 4
        return "CloseHandle"
    if s = 5
        return "VirtualAlloc"
    if s = 6
        return "ExitProcess"
    if s = 7
        return "GetCommandLineA"
    if s = 8
        return "SetFilePointerEx"
    if s = 9
        return "GetConsoleMode"
    if s = 10
        return "SetConsoleMode"
    if s = 11
        return "LoadLibraryA"
    if s = 13
        return "VirtualQuery"
    if s = 14
        return "CreateThread"
    if s = 15
        return "WaitForSingleObject"
    if s = 16
        return "ExitThread"
    if s = 17
        return "CreateProcessA"
    if s = 18
        return "GetExitCodeProcess"
    return "GetProcAddress"
imp_pos s:
    i: 0
    as long as i < _sov_list_len(imp_used)
        if _sov_list_get(imp_used, i) = s
            return i
        i: i + 1
    return 0 - 1
imp_mark s:
    i: 0
    as long as i < _sov_list_len(imp_used)
        if _sov_list_get(imp_used, i) = s
            return 0
        i: i + 1
    imp_used: _sov_list_add(imp_used, s)
    return 0
# The first 1024 bytes of every exe this compiler writes: the DOS and
# PE headers and the import table, with the parts the compiler fills
# in left as zeros. The bytes live in this source, in four pieces
# because a line may not be too long; win_head_byte picks a byte
# out of the four.
win_head_a: ""
win_head_b: ""
win_head_c: ""
win_head_d: ""

win_head_byte i:
    if i < 512
        return peek_byte(win_head_a, i)
    if i < 1024
        return peek_byte(win_head_b, i - 512)
    if i < 1536
        return peek_byte(win_head_c, i - 1024)
    return peek_byte(win_head_d, i - 1536)

# one hex digit to its value (the blob = lowercase)
win_nib c:
    if c > 96
        return c - 87
    return c - 48

write_program path:
    if saw_error = 1
        return
    clen: _sov_list_len(code)
    sl: _sov_buf_len(letters)
    str_off: clen
    if _sov_list_len(global_names) > 0
        as long as str_off % 8 is not 0
            code: _sov_list_add(code, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(global_names) * 8
    tneed: clen + sl + pad
    # pass S3 (resolved below): .text holds code only; literals,
    # globals and the import blob move to a READ+WRITE .data at
    # RVA 8192. the IAT = loader-written: it must be writable.
    # the import table lists only the slots the code referenced, then
    # LoadLibraryA and GetProcAddress so `use winapi` can reach the
    # rest of Windows. it rides inside .text so the whole exe = one
    # section and one page of code + imports (pass 95).
    imp_used: _sov_list_new()
    pi: 0
    as long as pi < _sov_list_len(patch_kind)
        if same(_sov_list_get(patch_kind, pi), "iatslot") = 1
            imp_mark(_sov_list_get(patch_value, pi))
        pi: pi + 1
    imp_mark(11)
    imp_mark(12)
    nimp: _sov_list_len(imp_used)
    iat_off: 0
    ilt_off: (nimp + 1) * 8
    desc_off: (nimp + 1) * 16
    dll_off: desc_off + 40
    name_off: dll_off + 13
    imp_sz: name_off
    ni: 0
    as long as ni < nimp
        imp_sz: imp_sz + 2 + length(imp_name(_sov_list_get(imp_used, ni))) + 1
        ni: ni + 1
    traw: clen
    as long as traw % 512 is not 0
        traw: traw + 1
    # the data section starts on the first page boundary past the
    # code - a fixed rva would let big programs collide with it
    drva: 4096 + clen
    as long as drva % 4096 is not 0
        drva: drva + 1
    sl8: sl
    as long as sl8 % 8 is not 0
        sl8: sl8 + 1
    str_off: 0
    glob_off: sl8
    import_off: sl8 + pad
    as long as import_off % 8 is not 0
        import_off: import_off + 1
    # the thread handle table sits after the import blob; it exists
    # only when the thread bridge referenced it. the key is
    # base/262272 with base a full guest address, so the index can
    # reach (lo + 512MB)/262272; 2048 slots covers base up to 2GB
    tt_off: import_off + imp_sz
    as long as tt_off % 8 is not 0
        tt_off: tt_off + 1
    tt_used: 0
    pt: 0
    as long as pt < _sov_list_len(patch_kind)
        if same(_sov_list_get(patch_kind, pt), "threadtable") = 1
            tt_used: 1
        pt: pt + 1
    draw: tt_off
    if tt_used = 1
        draw: draw + 16384
    as long as draw % 512 is not 0
        draw: draw + 1
    dfoff: 512 + traw
    filesz: dfoff + draw
    # pass S7: collect the absolute patch sites for the loader's
    # relocation table. DIR64 for whole qwords (fnaddr, glob,
    # gwstr_a, gwipe_a, iatslot, str). rip-relative
    # sites and branches need nothing - they are already position
    # independent
    rva_l: _sov_list_new()
    ty_l: _sov_list_new()
    ri: 0
    as long as ri < _sov_list_len(patch_kind)
        rk: _sov_list_get(patch_kind, ri)
        rty: 0
        if same(rk, "task_address") = 1
            rty: 10
        if same(rk, "glob") = 1
            rty: 10
        if same(rk, "gwstr_a") = 1
            rty: 10
        if same(rk, "gwipe_a") = 1
            rty: 10
        if same(rk, "iatslot") = 1
            rty: 10
        # string literal addresses ride movabs qwords (rax_str) -
        # the kind the first landing missed, which = why a slid
        # load faulted on its first print
        if same(rk, "str") = 1
            rty: 10
        if rty > 0
            rva_l: _sov_list_add(rva_l, 4096 + _sov_list_get(patch_at, ri))
            ty_l: _sov_list_add(ty_l, rty)
        ri: ri + 1
    # one block per touched page, sorted by page
    reloc_sz: 0
    pg: 0
    as long as pg <= (4096 + clen) / 4096
        cnt: 0
        ri: 0
        as long as ri < _sov_list_len(rva_l)
            if _sov_list_get(rva_l, ri) / 4096 = pg
                cnt: cnt + 1
            ri: ri + 1
        if cnt > 0
            pcnt: cnt
            as long as pcnt % 2 is not 0
                pcnt: pcnt + 1
            reloc_sz: reloc_sz + 8 + pcnt * 2
        pg: pg + 1
    reloc_off: filesz
    as long as reloc_off % 512 is not 0
        reloc_off: reloc_off + 1
    tot_sz: reloc_off + reloc_sz
    flat: _sov_alloc(tot_sz + 64)
    i: 0
    as long as i < tot_sz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    # the header lives in this source (win_head_a..d), not in an
    # external file, so there = nothing to find and no way to lose
    # it. Same 512 bytes, decoded here.
    hi: 0
    as long as hi < 512
        c0: win_nib(win_head_byte(hi * 2))
        c1: win_nib(win_head_byte(hi * 2 + 1))
        dummy: _sov_set_byte(flat, hi, c0 * 16 + c1)
        hi: hi + 1
    if want_window = 1
        dummy: _sov_set_byte(flat, 220, 2)
        dummy: _sov_set_byte(flat, 221, 0)
    # two sections: .text READ+EXECUTE (never writable),
    # .data READ+WRITE (never executable), NX_COMPAT on
    poke4(flat, 156, clen)
    poke4(flat, 160, draw)
    dummy: _sov_set_byte(flat, 134, 2)
    dummy: _sov_set_byte(flat, 135, 0)
    dummy: _sov_set_byte(flat, 222, 0)
    dummy: _sov_set_byte(flat, 223, 1)
    poke4(flat, 400, clen)
    poke4(flat, 408, traw)
    poke4(flat, 428, 1610612768)
    dummy: _sov_set_byte(flat, 432, 46)
    dummy: _sov_set_byte(flat, 433, 100)
    dummy: _sov_set_byte(flat, 434, 97)
    dummy: _sov_set_byte(flat, 435, 116)
    dummy: _sov_set_byte(flat, 436, 97)
    dummy: _sov_set_byte(flat, 437, 0)
    poke4(flat, 440, draw)
    poke4(flat, 444, drva)
    poke4(flat, 448, draw)
    poke4(flat, 452, dfoff)
    poke4(flat, 468, 3221225536)
    # the .data extent includes the thread table when present, so
    # SizeOfImage must span it too
    dvs: draw
    as long as dvs % 4096 is not 0
        dvs: dvs + 1
    relva: drva + dvs
    # S7 re-landed (2026-08-27): the image may load anywhere and the
    # loader applies the relocation table. SizeOfImage now covers
    # the whole .reloc section, page aligned - the lie that made
    # real windows refuse the first attempt (CI run #2)
    isz: reloc_sz
    as long as isz % 4096 is not 0
        isz: isz + 1
    poke4(flat, 208, relva + isz)
    if reloc_sz > 0
        dummy: _sov_set_byte(flat, 134, 3)
    if not
        dummy: _sov_set_byte(flat, 134, 2)
    if reloc_sz > 0
        dummy: _sov_set_byte(flat, 222, 64)
    if not
        dummy: _sov_set_byte(flat, 222, 0)
    # DataDirectory[5] - BaseRelocationTable. The first S7 landing
    # wrote these two words one directory slot too far right (slot
    # 6, flat 312/316), so windows saw DYNAMIC_BASE with an empty
    # reloc directory and refused the whole image
    poke4(flat, 304, relva)
    poke4(flat, 308, reloc_sz)
    rn: ".reloc"
    i: 0
    as long as i < 6
        dummy: _sov_set_byte(flat, 472 + i, _sov_byte_at(rn, i))
        i: i + 1
    dummy: _sov_set_byte(flat, 478, 0)
    dummy: _sov_set_byte(flat, 479, 0)
    poke4(flat, 480, reloc_sz)
    poke4(flat, 484, relva)
    poke4(flat, 488, reloc_sz)
    poke4(flat, 492, reloc_off)
    # section characteristics sit at row + 36, not + 24
    poke4(flat, 508, 1073741888)
    poke4(flat, 272, drva + import_off + desc_off)
    poke4(flat, 276, 40)
    poke4(flat, 360, drva + import_off)
    poke4(flat, 364, (nimp + 1) * 8)
    # when there = no start stub, main itself = the entry point
    moff: 0
    if tiny_program = 1
        mi: idx(task_names, "main")
        if mi > 0 - 1
            moff: _sov_list_get(task_at, mi)
    poke4(flat, 168, 4096 + moff)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, 512 + i, _sov_list_get(code, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, dfoff + str_off + si, _sov_buf_at(letters, si))
        si: si + 1
    # build the import table in .data (the loader writes the IAT)
    ib: dfoff + import_off
    noff: name_off
    ni: 0
    as long as ni < nimp
        s: _sov_list_get(imp_used, ni)
        poke8(flat, ib + iat_off + ni * 8, drva + import_off + noff)
        poke8(flat, ib + ilt_off + ni * 8, drva + import_off + noff)
        noff: noff + 2 + length(imp_name(s)) + 1
        ni: ni + 1
    poke8(flat, ib + iat_off + nimp * 8, 0)
    poke8(flat, ib + ilt_off + nimp * 8, 0)
    poke4(flat, ib + desc_off, drva + import_off + ilt_off)
    poke4(flat, ib + desc_off + 12, drva + import_off + dll_off)
    poke4(flat, ib + desc_off + 16, drva + import_off + iat_off)
    dlln: "KERNEL32.dll"
    i: 0
    as long as i < length(dlln)
        dummy: _sov_set_byte(flat, ib + dll_off + i, _sov_byte_at(dlln, i))
        i: i + 1
    dummy: _sov_set_byte(flat, ib + dll_off + length(dlln), 0)
    noff: name_off
    ni: 0
    as long as ni < nimp
        s: _sov_list_get(imp_used, ni)
        nm: imp_name(s)
        dummy: _sov_set_byte(flat, ib + noff, 0)
        dummy: _sov_set_byte(flat, ib + noff + 1, 0)
        j: 0
        as long as j < length(nm)
            dummy: _sov_set_byte(flat, ib + noff + 2 + j, _sov_byte_at(nm, j))
            j: j + 1
        dummy: _sov_set_byte(flat, ib + noff + 2 + length(nm), 0)
        noff: noff + 2 + length(nm) + 1
        ni: ni + 1
    str_addr: load_at + drva + str_off
    glob_addr: load_at + drva + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_value, i)
        if same(kind, "rel") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(task_at, fi)
                rel: tgt - (at + 4)
                poke4(flat, 512 + at, rel)
            if not
                print "Error: no such task" : val
                print _sov_list_get(patch_line, i)
                saw_error: 1
        if same(kind, "iatslot") = 1
            poke8(flat, 512 + at, load_at + drva + import_off + imp_pos(val) * 8)
        if same(kind, "task_address") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                poke8(flat, 512 + at, load_at + 4096 + _sov_list_get(task_at, fi))
            if not
                print "Error: no such task" : val
                saw_error: 1
        if same(kind, "str") = 1
            poke8(flat, 512 + at, str_addr + val)
        if same(kind, "str32") = 1
            poke4(flat, 512 + at, str_addr + val)
        if same(kind, "ripstr") = 1
            poke4(flat, 512 + at, drva - 4096 + str_off + val - at - 4)
        if same(kind, "grel") = 1
            gx: idx(global_names, val)
            poke4(flat, 512 + at, drva - 4096 + glob_off + gx * 8 - at - 4)
        if same(kind, "threadtable") = 1
            # rip-relative like grel: the lea's displacement to the
            # table slot in .data
            poke4(flat, 512 + at, drva - 4096 + tt_off - at - 4)
        if same(kind, "gwstr_a") = 1
            poke8(flat, 512 + at, str_addr + val)
        if same(kind, "gwstr_n") = 1
            poke4(flat, 512 + at, (sl + 7) / 8)
        if same(kind, "gwipe_a") = 1
            poke8(flat, 512 + at, glob_addr)
        if same(kind, "gwipe_n") = 1
            poke4(flat, 512 + at, _sov_list_len(global_names))
        if same(kind, "glob") = 1
            gx: idx(global_names, val)
            poke8(flat, 512 + at, glob_addr + gx * 8)
        i: i + 1
    if saw_error = 1
        return
    # the relocation blocks themselves, one page at a time.
    # one scan of the relocation list per page, not one per entry:
    # the old shape rescanned the whole list for every single entry it
    # wrote, so a library-sized program paid pages x entries x list -
    # seconds of it. Entries go down first and the block's size field
    # = patched afterwards, which writes exactly the same bytes as
    # counting first and writing second
    ro2: reloc_off
    pg: 0
    as long as pg <= (4096 + clen) / 4096
        ei: 0
        eo: ro2 + 8
        ri: 0
        as long as ri < _sov_list_len(rva_l)
            if _sov_list_get(rva_l, ri) / 4096 = pg
                ent: _sov_list_get(ty_l, ri) * 4096 + _sov_list_get(rva_l, ri) % 4096
                poke2(flat, eo, ent)
                eo: eo + 2
                ei: ei + 1
            ri: ri + 1
        if ei > 0
            pcnt2: ei
            as long as pcnt2 % 2 is not 0
                pcnt2: pcnt2 + 1
            poke4(flat, ro2, pg * 4096)
            poke4(flat, ro2 + 4, 8 + pcnt2 * 2)
            # entries round up to even: an ABSOLUTE (type 0) pads
            as long as ei < pcnt2
                poke2(flat, eo, 0)
                eo: eo + 2
                ei: ei + 1
            ro2: ro2 + 8 + pcnt2 * 2
        pg: pg + 1
    w: _sov_write_n(path, flat, tot_sz)
    if w = 0
        print "Error: cannot write output (is it running?)"
        fail
    if needs_private = 1
        # pass 140: a private program's binary carries its secrets -
        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
# remember where this compiler lives, so its library and runtime
# are found no matter which folder you run it from
windows_thread_words runtime:
    # linux clone/fork/futex lines become CreateThread / wait / wake
    runtime: repl(runtime, "syscall(56, e, top, 12032, 0, 0, 0)", "thread_create(e, top)")
    runtime: repl(runtime, "syscall(57, 0, 0, 0, 0, 0, 0)", "thread_create(0, 0)")
    runtime: repl(runtime, "syscall(202, cb, 1, 1, 0, 0, 0)", "thread_wake(cb)")
    runtime: repl(runtime, "syscall(202, base, 1, 1, 0, 0, 0)", "thread_wake(base)")
    runtime: repl(runtime, "syscall(202, h, 0, s, 0, 0, 0)", "thread_wait(h, s)")
    return runtime

start:
    compiler_folder: dirname(tidy_path(peek_ptr(g_argv, 0)))
    if g_argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail
    in_file: blank
    out_file: blank
    i: 1
    as long as i < g_argc
        arg: peek_ptr(g_argv, i)
        if same(arg, "--bare") = 1
            no_runtime: 1
        if not
            if same(arg, "-o") = 1
                i: i + 1
                if i < g_argc
                    out_file: peek_ptr(g_argv, i)
            if not
                if same(arg, "build") = 0
                    in_file: arg
        i: i + 1
    if length(in_file) = 0
        print "Error: no input"
        fail
    if length(out_file) = 0
        if holds(in_file, ".sov") = 1
            out_file: cut(in_file, 0, look(in_file, ".sov"))
        if not
            out_file: join(in_file, ".out")
    file_name: in_file
    print "Compiling" : in_file
    src: load_file(in_file)
    if src = 0
        print "Error: cannot read input"
        fail
    newline: "\n"
    src: join("# skip this line\n", src)
    libraries: blank
    src: expand_use_lines(src)
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    heap_size: 12582912
    needs_runtime: uses_runtime(src)
    runtime: blank
    if no_runtime = 1
        needs_runtime: 0
    if needs_runtime = 1
        heap_size: 1073741824
        runtime: load_file("runtime.sov")
        if runtime = 0
            runtime: load_file("linux/runtime.sov")
        if runtime = 0
            runtime: load_file(join(compiler_folder, "/runtime.sov"))
        if runtime = 0
            runtime: load_file(join(compiler_folder, "/../runtime.sov"))
        if runtime = 0
            runtime: load_file(join(dirname(dirname(compiler_folder)), "/runtime.sov"))
        if runtime = 0
            print "Error: cannot read runtime"
            fail
        # the windows thread bridge: the runtime's clone/fork and
        # futex lines become the bridge builtins, which the codegen
        # answers with CreateThread, WaitForSingleObject and a no-op
        # wake (the thread's own end signals its handle)
        runtime: windows_thread_words(runtime)
    first_user_line: 1
    if length(runtime) > 0
        first_user_line: first_user_line + _sov_list_len(lines_of(runtime))
    if length(extra) > 0
        first_user_line: first_user_line + _sov_list_len(lines_of(extra))
    newline: "\n"
    all: join(runtime, newline)
    first_user_line: first_user_line + 1
    if needs_runtime = 1
        # the runtime's thread paths end themselves through this
        # injected task; on windows a thread = a CreateThread
        # function, so ending it = ExitThread
        all: join(all, "_sov_thread_exit:\n    thread_exit()\n    return 0 - 1\n")
        first_user_line: first_user_line + 4
    all: join(all, src)
    compile(all)
    write_program(out_file)
    if saw_error = 1
        fail
    print "Wrote" : out_file

    # the spawn packing = os-neutral: it lands the job pointer and its
    # values in the Sovren call registers and calls the shared runtime's
    # _sov_thread_spawn, whose clone/fork/futex syscalls the repl block
    # above turns into the windows bridge builtins.
start
