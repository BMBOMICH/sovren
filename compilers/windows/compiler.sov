    poke8(flat, ib + ilt_off + nimp * 8, 0)
    poke4(flat, ib + desc_off, drva + import_off + ilt_off)
    poke4(flat, ib + desc_off + 12, drva + import_off + dll_off)
    poke4(flat, ib + desc_off + 16, drva + import_off + iat_off)
