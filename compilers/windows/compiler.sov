                    # value stored at slot i sits (i + 1) * 8 bytes below
                    # the frame pointer, so the room has to be a full
                    # slot deeper than the count, or the callee's own
                    # frame lands on top of our spilled values
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes
                    # below the frame pointer, so the room has to be
                    # a full slot deeper than the count, or the
                    # callee's own frame lands on top of our spilled
                    # values
                    if no_frame is 0
                        ns: (_sov_list_len(locals) + 1) * 8
                        if ns < 32
                            ns: 32
                        if _sov_list_len(cd_at) > 0
                            ns: ns + 16
                        put(pro_at, ns)
                        if fw_on is 1
                            if isfib is 0
                                canary_check()
                                xor_rax()
                                restores()
                                frame_wipe()
                                emit(201)
                                ret()
                                fw_done: 1
                            fwi: 0
                            as long as fwi < _sov_list_len(fw_pos)
                                put(_sov_list_get(fw_pos, fwi), ns + fn_save_n * 8)
                                fwi: fwi + 1
                        # the canary sits just above the saved
                        # registers, below every local; point the
                        # compare and the store at it, then spend
                        # the list
                        chi2: 0
                        as long as chi2 < _sov_list_len(cd_at)
                            put(_sov_list_get(cd_at, chi2), 8 - ns - fn_save_n * 8)
                            chi2: chi2 + 1
                        cd_at: 0
                    if same(nm, "main") is 1
                        if need_priv is 1
                            emit_stack_wipe()
                        emit(49)
                        emit(255)
                        emit_sys_num(60)
                        emit_sys_do()
                    if not
                        # the fib fast path ends in its own leave/ret;
                        # a second epilogue here would be dead bytes
                        if isfib is 0
                            if fw_done is 0
                                xor_rax()
                                leave()
                                ret()
        fi: fi + 1
    if has_vm is 0
        emit_used()
    if can_used is 1
        emit_canary_fail()
    if need_priv is 1
        emit_crash_handler()
    warn_unused()
    dce()
    dce_stores()
    dce_litter()
    dce_globals()
poke2 p off v:
    dummy: _sov_set_byte(p, off, v % 256)
    dummy: _sov_set_byte(p, off + 1, v / 256)
    return 0

# The import table. The compiler emits only the entries the code
# actually referenced, plus LoadLibraryA and GetProcAddress (always
# last) so `use winapi` can reach any other library at run time.
# imp_name maps a slot to its kernel32 name; imp_used holds the
# slots in the order they sit in the table.
imp_used: 0
imp_name s:
    if s is 0
        return "GetStdHandle"
    if s is 1
        return "WriteFile"
    if s is 2
        return "ReadFile"
    if s is 3
        return "CreateFileA"
    if s is 4
        return "CloseHandle"
    if s is 5
        return "VirtualAlloc"
    if s is 6
        return "ExitProcess"
    if s is 7
        return "GetCommandLineA"
    if s is 8
        return "SetFilePointerEx"
    if s is 9
        return "GetConsoleMode"
    if s is 10
        return "SetConsoleMode"
    if s is 11
        return "LoadLibraryA"
    if s is 13
        return "VirtualQuery"
    if s is 14
        return "CreateThread"
    if s is 15
        return "WaitForSingleObject"
    if s is 16
        return "ExitThread"
    return "GetProcAddress"
imp_pos s:
    i: 0
    as long as i < _sov_list_len(imp_used)
        if _sov_list_get(imp_used, i) is s
            return i
        i: i + 1
    return 0 - 1
imp_mark s:
    i: 0
    as long as i < _sov_list_len(imp_used)
        if _sov_list_get(imp_used, i) is s
            return 0
        i: i + 1
    imp_used: _sov_list_add(imp_used, s)
    return 0
# The first 1024 bytes of every exe this compiler writes: the DOS and
# PE headers and the import table, with the parts the compiler fills
# in left as zeros. The bytes live in this source, in four pieces
# because a line may not be too long; win_head_byte picks a byte
# out of the four.
win_head_a: ""
win_head_b: ""
win_head_c: ""
win_head_d: ""

win_head_byte i:
    if i < 512
        return peek_byte(win_head_a, i)
    if i < 1024
        return peek_byte(win_head_b, i - 512)
    if i < 1536
        return peek_byte(win_head_c, i - 1024)
    return peek_byte(win_head_d, i - 1536)

# one hex digit to its value (the blob is lowercase)
win_nib c:
    if c > 96
        return c - 87
    return c - 48

write_elf path:
    if had_err is 1
        return
    clen: _sov_list_len(oc)
    sl: _sov_buf_len(strb)
    str_off: clen
    if _sov_list_len(glob_names) > 0
        as long as str_off % 8 is not 0
            oc: _sov_list_add(oc, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(glob_names) * 8
    tneed: clen + sl + pad
    # pass S3 (resolved below): .text holds code only; literals,
    # globals and the import blob move to a READ+WRITE .data at
    # RVA 8192. the IAT is loader-written: it must be writable.
    # the import table lists only the slots the code referenced, then
    # LoadLibraryA and GetProcAddress so `use winapi` can reach the
    # rest of Windows. it rides inside .text so the whole exe is one
    # section and one page of code + imports (pass 95).
    imp_used: _sov_list_new()
    pi: 0
    as long as pi < _sov_list_len(patch_kind)
        if same(_sov_list_get(patch_kind, pi), "iatslot") is 1
            imp_mark(_sov_list_get(patch_val, pi))
        pi: pi + 1
    imp_mark(11)
    imp_mark(12)
    nimp: _sov_list_len(imp_used)
    iat_off: 0
    ilt_off: (nimp + 1) * 8
    desc_off: (nimp + 1) * 16
    dll_off: desc_off + 40
    name_off: dll_off + 13
    imp_sz: name_off
    ni: 0
    as long as ni < nimp
        imp_sz: imp_sz + 2 + length(imp_name(_sov_list_get(imp_used, ni))) + 1
        ni: ni + 1
    traw: clen
    as long as traw % 512 is not 0
