    # independent
    rva_l: _sov_list_new()
    ty_l: _sov_list_new()
    ri: 0
    as long as ri < _sov_list_len(patch_kind)
        rk: _sov_list_get(patch_kind, ri)
        rty: 0
        if same(rk, "fnaddr") is 1
            rty: 10
        if same(rk, "glob") is 1
            rty: 10
        if same(rk, "gwstr_a") is 1
            rty: 10
        if same(rk, "gwipe_a") is 1
            rty: 10
        if same(rk, "iatslot") is 1
