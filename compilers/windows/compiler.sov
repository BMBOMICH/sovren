emit_used:
    if used_wc is 1
        emit_wincall()
    if used_al is 1
        if idx(glob_names, "heap_ptr") is 0 - 1
            glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_alloc()
    if used_pr is 1
        used_sl: 1
    if used_sl is 1
        emit_strlen()
    if used_eq is 1
        emit_streq()
    if used_pr is 1
        emit_print()
    if used_pi is 1
        emit_print_int()
    if used_tr is 1
        emit_trap_stub()
prep_main names params bodies:
    thin_main: 0
    skip_al: blank
    fib_nm: blank
    fib_drop: 0
    fi: 0
    as long as fi < _sov_list_len(names)
        if same(_sov_list_get(names, fi), "main") is 1
            if _sov_list_len(_sov_list_get(params, fi)) is 0
                thin_main: 1
            skip_al: dead_iota(_sov_list_get(bodies, fi))
        if fiblike(_sov_list_get(names, fi), _sov_list_get(params, fi), _sov_list_get(bodies, fi)) is 1
            fib_nm: _sov_list_get(names, fi)
        fi: fi + 1
    # fold + drop the recognized fib when every call outside its own
    # body passes a literal constant (or it is never called at all).
    # a non-constant call, or an addr_of take, keeps the body.
    if length(fib_nm) > 0
        fib_drop: 1
        fi: 0
        as long as fi < _sov_list_len(names)
            if same(_sov_list_get(names, fi), fib_nm) is 0
                bln: _sov_list_get(bodies, fi)
                bi: 0
                as long as bi < _sov_list_len(bln)
                    if fib_call_var(_sov_list_get(bln, bi), fib_nm) is 1
                        fib_drop: 0
                    if look(_sov_list_get(bln, bi), join("addr_of ", fib_nm)) > 0 - 1
                        fib_drop: 0
                    bi: bi + 1
            fi: fi + 1
    if fib_drop is 1
        fn_names: _sov_list_add(fn_names, fib_nm)
        fn_offs: _sov_list_add(fn_offs, 0)
compile source:
    oc: _sov_list_new()
    iota_ptr: blank
    iota_lim: blank
    kn: blank
    kv: 0
    skip_al: blank
    used_al: 0
    used_sl: 0
    used_eq: 0
    used_pr: 0
    used_pi: 0
    used_wc: 0
    used_tr: 0
    wc_dyn: 0
    wc_rare: 0
    did_stos: 0
    thin_main: 0
    has_vm: 0
    need_priv: 0
    saw_str: 0
    str_vars: _sov_list_new()
    str_fns: _sov_list_new()
    ar_names: _sov_list_new()
    ar_cnt: _sov_list_new()
    fn_locs: _sov_list_new()
    str_fns: _sov_list_add(str_fns, "cat")
    str_fns: _sov_list_add(str_fns, "strcat")
    str_fns: _sov_list_add(str_fns, "_sov_strcat")
    str_fns: _sov_list_add(str_fns, "sub")
    str_fns: _sov_list_add(str_fns, "trim")
    str_fns: _sov_list_add(str_fns, "ch")
    str_fns: _sov_list_add(str_fns, "_sov_substring")
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) is 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") is 0
                    if starts(pre_t, "use ") is 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c is length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") is 1
                                            pre_in: 0
                                        if not
                                            if pre_in is 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
                                    # seven values is the most a job can
                                    # take. more used to compile and then
                                    # go wrong while running.
                                    if pre_na > 7
                                        print "Error: a job takes at most seven values"
                                        _sov_print(pre_cur)
                                        print pre_na
                                        had_err: 1
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, pre_na)
                                if not
                                    pre_cur: pre_h
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, 0)
            if not
                pre_t2: strip(pre_l)
                if starts(pre_t2, "return ") is 1
                    pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                    if starts(pre_r, "as text ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if length(pre_r) > 0
                        if _sov_byte_at(pre_r, 0) is 34
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                        if not
                            if same(pre_r, "blank") is 1
                                if length(pre_cur) > 0
                                    mark_fn_str(pre_cur)
        pre_i: pre_i + 1
    # a job that hands back another job's answer is a text job too,
    # whatever order the jobs were written in. Keep going round until
    # nobody new is marked, so forward references work as well as
    # backward ones.
    changed: 1
    as long as changed is 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) is 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") is 0
                        if starts(pre_t, "use ") is 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c is length(pre_t) - 1
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    if starts(pre_t2, "return ") is 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(str_fns, pre_cur) < 0
                            if starts(pre_r, "as text ") is 0
                                if length(pre_r) > 0
                                    if _sov_byte_at(pre_r, 0) is not 34
                                        if same(pre_r, "blank") is 0
                                            pre_lp: look(pre_r, "(")
                                            if pre_lp > 0
                                                pre_f: strip(cut(pre_r, 0, pre_lp))
                                                if idx(str_fns, pre_f) > 0 - 1
                                                    mark_fn_str(pre_cur)
                                                    changed: 1
            pre_i: pre_i + 1
    # a program that wipes or marks private data must not core-dump it.
    # match the statements, not the substring: the old look() matched
    # "# would wipe what the stub stored" in a runtime comment and
    # spent 14 bytes of prctl in every runtime-linked binary.
    nls: lines_of(source)
    ni: 0
    as long as ni < _sov_list_len(nls)
        ns: strip(_sov_list_get(nls, ni))
        if same(ns, "private") is 1
            need_priv: 1
        if starts(ns, "wipe ") is 1
            need_priv: 1
        ni: ni + 1
    cnms: _sov_list_new()
    cvls: _sov_list_new()
    cemt: _sov_list_new()
    strb: _sov_buf_new()
    str_keys: _sov_list_new()
    str_pos: _sov_list_new()
    fn_names: _sov_list_new()
    fn_offs: _sov_list_new()
    glob_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_val: _sov_list_new()
    patch_line: _sov_list_new()
    stmt_lns: _sov_list_new()
    body_lns: _sov_list_new()
    task_lns: _sov_list_new()
    task_user: _sov_list_new()
    lns: lines_of(source)
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    li: 0
    as long as li < _sov_list_len(lns)
        raw: _sov_list_get(lns, li)
        s: strip(raw)
        th: 0
        if is_task_hdr(s) is 1
            th: 1
        if th is 1
            if in_t is 1
                bodies: _sov_list_add(bodies, cur)
                body_lns: _sov_list_add(body_lns, cur_ln)
            tn: tname(s)
            if idx(names, tn) > 0 - 1
                print "Error: two with the same name"
                _sov_print(tn)
                err_line: file_ln(li)
                print err_line
                had_err: 1
            names: _sov_list_add(names, tn)
            params: _sov_list_add(params, tparams(s))
            tu: 0
            if li + 1 > src_base
                tu: 1
            task_user: _sov_list_add(task_user, tu)
            task_lns: _sov_list_add(task_lns, file_ln(li))
