# the windows thread bridge functions. thread_create (rdi is the
# entry the runtime packed in - ignored here, the trampoline is the
# only entry - rsi is the control block top): the block sits a known
# 262272 below the top CreateThread is given, so the base is rsi
# minus that. CreateThread hands the trampoline the base in rcx;
# the trampoline moves it to rdi and enters the shared entry task,
# and returning from the trampoline is what ends the thread, which
# signals the handle join is waiting on. the handle parks in the
# 256-entry table the pe writer allocates, keyed by base/262272.
# every byte below was checked against gas output for the same
# instruction: legacy pushes/pops take no rex; sub with a 32-bit
# immediate is opcode 81, not 83 (83 takes a signed byte, so 0xb0
# would mean -80); shr reg, n is c1 with a modrm and an imm8, not
# d1/d3; lea is 8d, not ba (ba is mov edx, imm32); and 262272 is
# 0x40080, whose little-endian immediate is 80 00 04 00.
emit_win_thread:
    fn_names: _sov_list_add(fn_names, "_sov_win_create")
    fn_offs: _sov_list_add(fn_offs, here())
    # frame: rbp + the three registers the body keeps
    emit(85)
    emit(72)
    emit(137)
    emit(229)
    emit(83)
    emit(87)
    emit(86)
    emit(72)
    emit(129)
    emit(236)
    emit(176)
    emit(0)
    emit(0)
    emit(0)
    emit(72)
    emit(131)
    emit(228)
    emit(240)
    # base = top - 262272 (262272 = 0x40080), kept in rbx
    emit(72)
    emit(137)
    emit(243)
    emit(72)
    emit(129)
    emit(235)
    emit(128)
    emit(0)
    emit(4)
    emit(0)
    # CreateThread(NULL, 262144, trampoline, base, 0, 0)
    emit(49)
    emit(201)
    emit(72)
    emit(186)
    emit(0)
    emit(0)
    emit(4)
    emit(0)
    emit(0)
    emit(0)
    emit(0)
    emit(0)
    emit(73)
    emit(184)
    trp: here()
    emit8(0)
    addp(trp, "fnaddr", "_sov_win_trampoline")
    emit(73)
    emit(137)
    emit(217)
    emit(72)
    emit(199)
    emit(68)
    emit(36)
    emit(32)
    emit(0)
    emit(0)
    emit(0)
    emit(0)
    emit(72)
    emit(199)
    emit(68)
    emit(36)
    emit(40)
    emit(0)
    emit(0)
    emit(0)
    emit(0)
    emit(72)
    emit(184)
    trc: here()
    emit8(0)
    addp(trc, "iatslot", 14)
    emit(255)
    emit(16)
    # on failure (null handle) hand back -1 so the runtime's
    # fork-fallback path reports the error instead of a dead join
    emit(72)
    emit(133)
    emit(192)
    trf: jz()
    # park the handle in the table, keyed by base/262272
    emit(72)
    emit(137)
    emit(198)
    emit(72)
    emit(137)
    emit(216)
    emit(72)
    emit(193)
    emit(232)
    emit(18)
    emit(72)
    emit(141)
    emit(21)
    trt: here()
    emit4(0)
    addp(trt, "threadtable", 0)
    emit(72)
    emit(137)
    emit(52)
    emit(194)
    emit(72)
    emit(137)
    emit(240)
    trd: jmp()
    patch(trf)
    emit(187)
    emit(255)
    emit(255)
    emit(255)
    emit(255)
    emit(137)
    emit(216)
    patch(trd)
    emit(94)
    emit(95)
    emit(91)
    emit(72)
    emit(137)
    emit(236)
    emit(93)
    emit(195)
    # wait (rdi is the block base, rsi the pre-observed status,
    # unused: the handle signals when the thread ends): look the
    # handle up by base/262272 and WaitForSingleObject on it
    fn_names: _sov_list_add(fn_names, "_sov_win_wait")
    fn_offs: _sov_list_add(fn_offs, here())
    emit(72)
    emit(139)
    emit(199)
    emit(72)
    emit(193)
    emit(232)
    emit(18)
    emit(72)
    emit(141)
    emit(13)
    twt: here()
    emit4(0)
    addp(twt, "threadtable", 0)
    emit(72)
    emit(139)
    emit(4)
    emit(193)
    emit(72)
    emit(137)
    emit(193)
    emit(186)
    emit(255)
    emit(255)
    emit(255)
    emit(255)
    emit(72)
    emit(184)
    twc: here()
    emit8(0)
    addp(twc, "iatslot", 15)
    emit(255)
    emit(16)
    emit(49)
    emit(192)
    emit(195)
    # the thread entry: Windows hands the parameter in rcx, the
    # shared entry task takes it in rdi; returning ends the thread
    fn_names: _sov_list_add(fn_names, "_sov_win_trampoline")
    fn_offs: _sov_list_add(fn_offs, here())
    emit(72)
    emit(137)
    emit(207)
    calln("_sov_thread_entry_param")
    emit(195)
compile source:
    oc: _sov_list_new()
    iota_ptr: blank
    iota_lim: blank
    kn: blank
    kv: 0
    skip_al: blank
    used_al: 0
    used_sl: 0
    used_eq: 0
    used_pr: 0
    used_pi: 0
    used_wc: 0
    used_tr: 0
    wc_dyn: 0
    wc_rare: 0
    did_stos: 0
    thin_main: 0
    has_vm: 0
    need_priv: 0
    saw_str: 0
    str_vars: _sov_list_new()
    str_fns: _sov_list_new()
    ar_names: _sov_list_new()
    ar_cnt: _sov_list_new()
    fn_locs: _sov_list_new()
    str_fns: _sov_list_add(str_fns, "cat")
    str_fns: _sov_list_add(str_fns, "strcat")
    str_fns: _sov_list_add(str_fns, "_sov_strcat")
    str_fns: _sov_list_add(str_fns, "sub")
    str_fns: _sov_list_add(str_fns, "trim")
    str_fns: _sov_list_add(str_fns, "ch")
    str_fns: _sov_list_add(str_fns, "_sov_substring")
    seed_str_fns()
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) is 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") is 0
                    if starts(pre_t, "use ") is 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c is length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") is 1
                                            pre_in: 0
                                        if not
                                            if pre_in is 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
                                    # seven values is the most a job can
                                    # take. more used to compile and then
                                    # go wrong while running.
                                    if pre_na > 7
                                        print "Error: a job takes at most seven values"
                                        _sov_print(pre_cur)
                                        print pre_na
                                        had_err: 1
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, pre_na)
                                if not
                                    pre_cur: pre_h
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, 0)
            if not
                pre_t2: strip(pre_l)
                if starts(pre_t2, "return ") is 1
                    pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                    if starts(pre_r, "as text ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if starts(pre_r, "as ptr ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if length(pre_r) > 0
                        if _sov_byte_at(pre_r, 0) is 34
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                        if not
                            if same(pre_r, "blank") is 1
                                if length(pre_cur) > 0
                                    mark_fn_str(pre_cur)
        pre_i: pre_i + 1
    # a job that hands back another job's answer is a text job too,
    # whatever order the jobs were written in. Keep going round until
    # nobody new is marked, so forward references work as well as
    # backward ones.
    changed: 1
    as long as changed is 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) is 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") is 0
                        if starts(pre_t, "use ") is 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c is length(pre_t) - 1
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    if starts(pre_t2, "return ") is 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(str_fns, pre_cur) < 0
                            if starts(pre_r, "as text ") is 0
                                if starts(pre_r, "as ptr ") is 0
                                    if length(pre_r) > 0
                                        if _sov_byte_at(pre_r, 0) is not 34
                                            if same(pre_r, "blank") is 0
                                                pre_lp: look(pre_r, "(")
                                                if pre_lp > 0
                                                    pre_f: strip(cut(pre_r, 0, pre_lp))
                                                    if idx(str_fns, pre_f) > 0 - 1
                                                        mark_fn_str(pre_cur)
                                                        changed: 1
            pre_i: pre_i + 1
    # a program that wipes or marks private data must not core-dump it.
    # match the statements, not the substring: the old look() matched
    # "# would wipe what the stub stored" in a runtime comment and
    # spent 14 bytes of prctl in every runtime-linked binary.
    nls: lines_of(source)
    ni: 0
    as long as ni < _sov_list_len(nls)
        ns: strip(_sov_list_get(nls, ni))
        if same(ns, "private") is 1
            need_priv: 1
        if starts(ns, "wipe ") is 1
            need_priv: 1
        ni: ni + 1
    cnms: _sov_list_new()
    cvls: _sov_list_new()
    cemt: _sov_list_new()
    strb: _sov_buf_new()
    str_keys: _sov_list_new()
    str_pos: _sov_list_new()
    fn_names: _sov_list_new()
    fn_offs: _sov_list_new()
    glob_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_val: _sov_list_new()
    patch_line: _sov_list_new()
    stmt_lns: _sov_list_new()
    body_lns: _sov_list_new()
    task_lns: _sov_list_new()
    task_user: _sov_list_new()
    lns: lines_of(source)
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    li: 0
    as long as li < _sov_list_len(lns)
        raw: _sov_list_get(lns, li)
        s: strip(raw)
        th: 0
        if is_task_hdr(s) is 1
            th: 1
        if th is 1
            if in_t is 1
                bodies: _sov_list_add(bodies, cur)
                body_lns: _sov_list_add(body_lns, cur_ln)
            tn: tname(s)
            if idx(names, tn) > 0 - 1
                print "Error: two with the same name"
                _sov_print(tn)
                err_line: file_ln(li)
                print err_line
                had_err: 1
            names: _sov_list_add(names, tn)
            params: _sov_list_add(params, tparams(s))
            tu: 0
            if li + 1 > src_base
                tu: 1
            task_user: _sov_list_add(task_user, tu)
            task_lns: _sov_list_add(task_lns, file_ln(li))
            cur: _sov_list_new()
            cur_ln: _sov_list_new()
            in_t: 1
        if not
            if nind(raw) is 0
                gok: 0
                gc: find_col(s)
                if gc > 0
                    if gc < length(s) - 1
                        gok: 1
                if gok is 1
                    gn: blank
                    if starts(s, "<-- ") is 1
                        rest: cut(s, 4, length(s))
                        t: find_sep(rest)
                        if t > 0 - 1
                            gn: repl(strip(cut(rest, 0, t)), " ", "_")
                    if not
                        gn: repl(strip(cut(s, 0, gc)), " ", "_")
                    if length(gn) > 0
                        if idx(glob_names, gn) is 0 - 1
                            glob_names: _sov_list_add(glob_names, gn)
                        # a top-level "x: x" only registers the global;
                        # the store is a no-op (the start stub has already
                        # filled g_argc/g_argv before main runs). skip it.
                        sa: 0
                        if gc + 1 < length(s)
                            grhs: strip(cut(s, gc + 1, length(s)))
                            if same(repl(grhs, " ", "_"), gn) is 1
                                sa: 1
                        if sa is 0
                            tops: _sov_list_add(tops, raw)
            if not
                if in_t is 1
                    cur: _sov_list_add(cur, raw)
                    cur_ln: _sov_list_add(cur_ln, file_ln(li))
        li: li + 1
    if in_t is 1
        bodies: _sov_list_add(bodies, cur)
        body_lns: _sov_list_add(body_lns, cur_ln)
    want_args: 0
    if look(source, "g_argc") > 0 - 1
        want_args: 1
    has_vm: 0
    if look(source, "task _sov_alloc") > 0 - 1
        has_vm: 1
    if look(source, "_sov_alloc size:") > 0 - 1
        has_vm: 1
    prep_main(names, params, bodies)
    fli: 0
    as long as fli < _sov_list_len(bodies)
        fb: _sov_list_get(bodies, fli)
        fset: _sov_list_new()
        flj: 0
        as long as flj < _sov_list_len(fb)
            fls: strip(_sov_list_get(fb, flj))
            if length(fls) > 0
                if _sov_byte_at(fls, 0) is not 35
                    if _sov_byte_at(fls, 0) is not 34
                        fgc: find_col(fls)
                        if fgc > 0
                            if fgc < length(fls) - 1
                                fgn: repl(strip(cut(fls, 0, fgc)), " ", "_")
                                if length(fgn) > 0
                                    if idx(glob_names, fgn) is 0 - 1
                                        if idx(fset, fgn) is 0 - 1
                                            fset: _sov_list_add(fset, fgn)
            flj: flj + 1
        fn_locs: _sov_list_add(fn_locs, _sov_list_len(fset))
        fli: fli + 1
    if has_vm is 1
        glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_start()
        emit_wincall()
        used_wc: 0
        emit_alloc()
        emit_strlen()
        emit_streq()
        emit_print()
        emit_print_int()
        # the thread bridge, when the re-placed runtime asks for it
        if look(source, "thread_create") > 0 - 1
            emit_win_thread()
        thin_main: 0
    if not
        if thin_main is 0
            emit_start()
    fi: 0
    as long as fi < _sov_list_len(names)
        nm: _sov_list_get(names, fi)
        if idx(fn_names, nm) < 0
                fn_names: _sov_list_add(fn_names, nm)
                fn_offs: _sov_list_add(fn_offs, here())
                locals: _sov_list_new()
                str_vars: _sov_list_new()
                saw_str: 0
                br_depth: 0
                stmt_lns: _sov_list_get(body_lns, fi)
                if _sov_list_len(_sov_list_get(bodies, fi)) is 0
                    if _sov_list_get(task_user, fi) is 1
                        print "Warning: empty"
                        _sov_print(nm)
                        print _sov_list_get(task_lns, fi)
                ps: _sov_list_get(params, fi)
                pi: 0
                as long as pi < _sov_list_len(ps)
                    locals: _sov_list_add(locals, _sov_list_get(ps, pi))
                    pi: pi + 1
                thin: 0
                if same(nm, "main") is 1
                    if _sov_list_len(ps) is 0
                        thin: 0
                if thin is 1
                    skip_al: dead_iota(_sov_list_get(bodies, fi))
                    if need_priv is 1
                        emit_nodump()
                    leaf8: leaf8_scan(tops)
                    body(tops)
                    cflush_all()
                    leaf8: 0
                    if _sov_list_len(ps) is 0
                        leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                    body(_sov_list_get(bodies, fi))
                    if saw_str is 1
                        mark_fn_str(nm)
                    if need_priv is 1
                        emit_stack_wipe()
                    emit(49)
                    emit(255)
                    emit(106)
                    emit(60)
                    emit(88)
                    sysc()
                if not
                    fn_save_n: 0
                    fw_on: 0
                    fw_done: 0
                    fw_pos: _sov_list_new()
                    fargs: _sov_list_len(ps)
                    floc: 0
                    if fi < _sov_list_len(fn_locs)
                        floc: _sov_list_get(fn_locs, fi)
                    ftot: fargs + floc
                    if ftot > 5
                        ftot: 5
                    fn_save_n: ftot
                    no_frame: 0
                    if fargs + floc < 6
                        if starts(nm, "_sov_") is 0
                            no_frame: 1
                    isfib: fiblike(nm, ps, _sov_list_get(bodies, fi))
                    if isfib is 1
