    if n = 225 -> return 5
    if n = 226 -> return 5
    if n = 227 -> return 5
    if n = 228 -> return 5
    if n = 229 -> return 5
    if n = 230 -> return 5
    if n = 231 -> return 5
    if n = 232 -> return 5
    if n = 233 -> return 5
    if n = 234 -> return 5
    if n = 235 -> return 5
    if n = 236 -> return 5
    if n = 237 -> return 5
    if n = 238 -> return 5
    if n = 239 -> return 5
    if n = 240 -> return 5
    if n = 241 -> return 5
    if n = 242 -> return 5
    if n = 243 -> return 5
    if n = 244 -> return 5
    if n = 245 -> return 5
    if n = 246 -> return 5
    if n = 247 -> return 5
    if n = 248 -> return 5
    if n = 249 -> return 5
    if n = 250 -> return 5
    if n = 251 -> return 5
    if n = 252 -> return 5
    if n = 253 -> return 5
    if n = 254 -> return 5
    if n = 255 -> return 5
    if n = 256 -> return 5
    if n = 258 -> return 5
    if n = 259 -> return 5
    if n = 260 -> return 5
    if n = 261 -> return 5
    if n = 262 -> return 5
    if n = 264 -> return 5
    if n = 265 -> return 5
    if n = 266 -> return 5
    if n = 267 -> return 5
    if n = 268 -> return 5
    if n = 269 -> return 5
    if n = 270 -> return 5
    if n = 271 -> return 5
    if n = 272 -> return 5
    if n = 273 -> return 5
    if n = 274 -> return 5
    if n = 275 -> return 5
    if n = 276 -> return 5
    if n = 277 -> return 5
    if n = 278 -> return 5
    if n = 279 -> return 5
    if n = 280 -> return 5
    if n = 281 -> return 5
    if n = 282 -> return 5
    if n = 283 -> return 5
    if n = 284 -> return 5
    if n = 285 -> return 5
    if n = 286 -> return 5
    if n = 287 -> return 5
    if n = 288 -> return 5
    return 0 - 1

bsd_fix t:
    # 52 numbers, 27 of them the ENOSYS probe 5
    t: bsd_map(t)
    t: bsd_shim(t)
    # argument words that carry flags: open modes, mmap flags, madvise advice
    # syscall(9,  (1 site)
    if look(t, bsd_fx('syscall(9, 0, 2097152, 3, ', 34, ', 0 - 1, 0)\n')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(9, 0, 2097152, 3, ', 34, ', 0 - 1, 0)\n'), bsd_fx('syscall(9, 0, 2097152, 3, ', 10, ', 0 - 1, 0)\n'))
    # syscall(9,  (1 site)
    if look(t, bsd_fx('syscall(9, 0, 262272, 3, ', 33, ', 0 - 1, 0)\n')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(9, 0, 262272, 3, ', 33, ', 0 - 1, 0)\n'), bsd_fx('syscall(9, 0, 262272, 3, ', 9, ', 0 - 1, 0)\n'))
    # syscall(9,  (1 site)
    if look(t, bsd_fx('syscall(9, 0, 65536, 3, ', 33, ', 0 - 1, 0)\n')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(9, 0, 65536, 3, ', 33, ', 0 - 1, 0)\n'), bsd_fx('syscall(9, 0, 65536, 3, ', 9, ', 0 - 1, 0)\n'))
    # syscall(9,  (1 site)
    if look(t, bsd_fx('syscall(9, 0, X_MEM / 4096, 3, ', 33, ', 0 - 1, 0)\n')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(9, 0, X_MEM / 4096, 3, ', 33, ', 0 - 1, 0)\n'), bsd_fx('syscall(9, 0, X_MEM / 4096, 3, ', 9, ', 0 - 1, 0)\n'))
    # syscall(9,  (1 site)
    if look(t, bsd_fx('syscall(9, 0, X_MEM, 3, ', 33, ', 0 - 1, 0) ')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(9, 0, X_MEM, 3, ', 33, ', 0 - 1, 0) '), bsd_fx('syscall(9, 0, X_MEM, 3, ', 9, ', 0 - 1, 0) '))
    # syscall(9,  (1 site)
    if look(t, bsd_fx('syscall(9, 0, sz, 3, ', 34, ', 0 - 1, 0)\n')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(9, 0, sz, 3, ', 34, ', 0 - 1, 0)\n'), bsd_fx('syscall(9, 0, sz, 3, ', 10, ', 0 - 1, 0)\n'))
    # syscall(9,  (1 site)
    if look(t, bsd_fx('syscall(9, 0, top + 65536, 7, ', 34, ', 0 - 1, 0)\n')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(9, 0, top + 65536, 7, ', 34, ', 0 - 1, 0)\n'), bsd_fx('syscall(9, 0, top + 65536, 7, ', 10, ', 0 - 1, 0)\n'))
    # syscall(28,  (1 site)
    if look(t, bsd_fx('syscall(28, base, used, ', 4, ', 0, 0, 0) ;')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(28, base, used, ', 4, ', 0, 0, 0) ;'), bsd_fx('syscall(28, base, used, ', 5, ', 0, 0, 0) ;'))
    # syscall(257,  (1 site)
    if look(t, bsd_fx('syscall(257, 0 - 100, path, ', 4673, ', 384, 0, 0)')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(257, 0 - 100, path, ', 4673, ', 384, 0, 0)'), bsd_fx('syscall(257, 0 - 100, path, ', 263681, ', 384, 0, 0)'))
    # syscall(257,  (1 site)
    if look(t, bsd_fx('syscall(257, 0 - 100, path, ', 5185, ', 384, 0, 0)')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(257, 0 - 100, path, ', 5185, ', 384, 0, 0)'), bsd_fx('syscall(257, 0 - 100, path, ', 264705, ', 384, 0, 0)'))
    # syscall(257,  (1 site)
    if look(t, bsd_fx('syscall(257, 0 - 100, path, ', 65536, ', 0, 0, 0)\n ')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(257, 0 - 100, path, ', 65536, ', 0, 0, 0)\n '), bsd_fx('syscall(257, 0 - 100, path, ', 2097152, ', 0, 0, 0)\n '))
    # syscall(257,  (2 sites)
    if look(t, bsd_fx('syscall(257, 0 - 100, path, ', 577, ', 420, 0, 0)')) > 0 - 1 -> t: bsd_rp(t, bsd_fx('syscall(257, 0 - 100, path, ', 577, ', 420, 0, 0)'), bsd_fx('syscall(257, 0 - 100, path, ', 1537, ', 420, 0, 0)'))
    return t

bsd_put pos v w:
    m: bsd_num(v)
    if m < 0 -> return 0
    if w = 1 -> if m > 255 -> return 0 - 1
    if w = 1 -> dummy: ocset(pos, m)
    if w = 4 -> dummy: ocset(pos, m % 256)
        dummy: ocset(pos + 1, (m / 256) % 256)
        dummy: ocset(pos + 2, (m / 65536) % 256)
        dummy: ocset(pos + 3, (m / 16777216) % 256)
    return 1
bsd_at p w:
    v: ocget(p)
    if w >= 2 -> v: v + ocget(p + 1) * 256
        if w >= 3 -> v: v + ocget(p + 2) * 65536
            if w >= 4 -> v: v + ocget(p + 3) * 16777216
    return v
bsd_c7 i:
    # 48 c7 c0 imm32: mov rax, imm32
    if ocget(i - 8) != 72 -> return 0
    if ocget(i - 7) != 199 -> return 0
    if ocget(i - 6) != 192 -> return 0
    return bsd_put(i - 5, bsd_at(i - 5, 4), 4)
bsd_loop i:
    # the debug-board loop head is b8 imm32 twelve bytes back, and only
    # when the gate (205 96) follows the head
    if ocget(i) != 205 -> return 0
    if ocget(i + 1) != 96 -> return 0
    return bsd_put(i - 11, bsd_at(i - 11, 4), 4)
bsd_site i:
    # 6a imm8 / 58 pop rax                                   (push, pop)
    if i >= 3 -> if ocget(i - 3) = 106 -> if ocget(i - 1) = 88
            dummy: bsd_put(i - 2, ocget(i - 2), 1)
    # 68 imm32 / 58 pop rax                                  (push, pop)
    if i >= 6 -> if ocget(i - 6) = 104 -> if ocget(i - 1) = 88
            dummy: bsd_put(i - 5, bsd_at(i - 5, 4), 4)
    # b0 imm8 mov al                                         (direct)
    if i >= 2 -> if ocget(i - 2) = 176 -> dummy: bsd_put(i - 1, ocget(i - 1), 1)
    # b8 imm32 mov eax                                       (direct)
    if i >= 5 -> if ocget(i - 5) = 184 -> dummy: bsd_put(i - 4, bsd_at(i - 4, 4), 4)
    # 48 b8 imm64 movabs rax                                 (direct)
    if i >= 10 -> if ocget(i - 10) = 72 -> if ocget(i - 9) = 184
            dummy: bsd_put(i - 8, bsd_at(i - 8, 4), 4)
    # 48 c7 c0 imm32 mov rax, imm                            (direct)
    if i >= 8 -> if ocget(i - 8) = 72 -> dummy: bsd_c7(i)
    # b8 imm32 / the head of the debug-board byte loop          (loop)
    if i >= 12 -> dummy: bsd_loop(i)
    return 0
bsd_code:
    # clen is a local of the ELF writer, so measure the code here
    cn: oc_n
    i: 0
    b: 0
    as long as i + 1 < cn -> b: ocget(i)
        if b = 15 -> if ocget(i + 1) = 5 -> dummy: bsd_site(i)
        i: i + 1
    return 0

main argc argv:
    if argc < 2 -> print 'Usage: sovren <file.sov> [-o out]'
        print 'sovren — native x86-64, self-contained'
        fail()
    blank:
        inf
        outf
    i: 1
    as long as i < argc -> arg: peek_ptr(argv, i)
        if same(arg, '--bare') = 1 -> bare_mode: 1
        if not -> if same(arg, '--run') = 1
                run_mode: 1
            if not -> if same(arg, '--fmt') = 1
                    fmt_mode: 1
                if not -> if same(arg, '--debug') = 1
                        dbg_mode: 1
                    if not -> if same(arg, '--bytes') = 1
                            bytes_mode: 1
                        if not -> if same(arg, '--plain') = 1
                                opt_peep: 0
                            if not -> if same(arg, '-o') = 1
                                    i: i + 1 ;; if i < argc -> outf: peek_ptr(argv, i)
                                if not -> if starts(arg, '--') = 0
                                        if same(arg, 'build') = 0 -> outf: pic_io(inf, outf, arg) ;; if same(arg, 'build') = 0 -> inf: pic_in(inf, arg)
        i: i + 1
    i2: 1
    as long as i2 < argc -> if same(peek_ptr(argv, i2), '--kernel') = 1
            kern_mode: 1
        if same(peek_ptr(argv, i2), '--release') = 1 -> opt_dce: 1
        if same(peek_ptr(argv, i2), '--unsafe') = 1 -> unsafe_mode: 1
        if same(peek_ptr(argv, i2), '--sxe') = 1 -> sxe_mode: 1
        if same(peek_ptr(argv, i2), '--flat') = 1 -> flat_mode: 1
        if same(peek_ptr(argv, i2), '--sxe-compact') = 1 -> 1:
                sxe_mode
                sxe_compact
        i2: i2 + 1
    if length(inf) = 0 -> print 'Error: no input'
        fail()
    if fmt_mode = 1 -> fmt_file(inf)
        sys_exit(0)
    include inc/inc05.sov 141 5 #735468168102944948
        if rt = 0 -> print 'Error: cannot read runtime'
            fail()
        if sxe_mode = 1 -> rt: repl(rt, 'syscall(186, 0, 0, 0, 0, 0, 0)', '0 - 38')
        if kern_mode = 1 -> rt: repl(rt, 'syscall(186, 0, 0, 0, 0, 0, 0)', '0 - 38')
    _sov_list_new():
        dbg_pcs
        dbg_lns
    if length(rt) > 0 -> if look(rt, join(" ->", "> ")) > 0 - 1 -> rt: std_forms(rt)
        if look(rt, join(" -", "> ")) > 0 - 1 -> rt: std_forms(rt)
    u_parts_done: 1
    include inc/inc00.sov 267 9 469763054093839203
    if need = 1 -> all: join(all, nl)
        all: join(all, join('_sov_thread_exit:', nl))
        if sxe_mode = 1 -> all: join(all, join('    sovcall(60, 0, 0, 0, 0, 0)', nl))
        if not -> all: join(all, join('    syscall(60, 0, 0, 0, 0, 0, 0)', nl))
        all: join(all, join('    return 0 - 1', nl))
        src_base: src_base + 4
    if unsafe_mode = 1 -> u_listing: 1
    u_bare_total: 0
    u_note: u_scan(src)
    if u_bare_total > 0 -> if unsafe_mode = 0
            print "Error: raw memory/io access denied by default; use checked primitives (library/sbuf.sov) or mark reviewed low-level code: # unsafe-module file stamp, unsafe: block, per-line # unsafe, or --unsafe"
            fail()
    if u_note > 0 -> print 'note: compiler sees raw memory/io sites without unsafe markers; library/sbuf.sov covers checked buffers (count follows)'
        print u_note
    src: u_prep(src)
    all: join(all, src)
    all: bsd_fix(all)
    all: std_forms(all)
    if flat_mode = 1 -> # --flat: write the program the compiler would parse, includes put back
        file_write_all(outf, all)
        print 'Wrote'
        _sov_print(outf)
        sys_exit(0)
    compile(prune_dead(all, snap_m, inf))
    bsd_code()
    write_elf(outf)
    if bytes_mode = 1 -> nb: oc_n
        bb: _sov_alloc(nb) ;; bi2: 0
        as long as bi2 < nb -> poke_byte(bb, bi2, ocget(bi2))
            bi2: bi2 + 1
        file_write_bytes(str_cat(outf, '.bin'), bb, nb)
        mt: ''
        mi2: 0 ;; as long as mi2 < _sov_list_len(fn_names) -> mt: str_cat(mt, _sov_list_get(fn_names, mi2))
            mt: str_cat(mt, ' ')
            mv: _sov_list_get(fn_offs, mi2)
            mlt: ''
            if mv = 0 -> mlt: '0'
            as long as mv > 0 -> mlt: str_cat(str_chr(48 + mv % 10), mlt)
                mv: mv / 10
            mt: str_cat:
                mlt ;; str_chr(10)
            mv: mv / 10 ;; mi2: mi2 + 1
        file_write_all(str_cat(outf, '.map'), mt)
    if had_err = 1 -> fail()
    print 'Wrote'
    _sov_print(outf)
    if run_mode = 1 -> run_prog(outf, argv, argc) ;; sys_exit(0)

include driver_compat.sov
