            if fi > 0 - 1 -> poke8(flat, HDR + at, BASE + HDR + _sov_list_get(fn_offs, fi))
                rel_at: _sov_list_add(rel_at, at)
            if not -> print 'Error: no such task'
                _sov_print(val)
                had_err: 1
        if same(kind, 'str') = 1 -> poke8(flat, HDR + at, str_addr + val)
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, 'strrel') = 1 -> poke4(flat, HDR + at, str_addr + val - (BASE + HDR + at + 4))
        if same(kind, 'str32') = 1 -> poke4(flat, HDR + at, str_addr + val)
        if same(kind, 'grel') = 1 -> gx: idx(glob_names, val)
            poke4(flat, HDR + at, glob_addr + gx * 8 - (BASE + HDR + at + 4))
        if same(kind, 'glob') = 1 -> gx: idx(glob_names, val)
            poke8(flat, HDR + at, glob_addr + gx * 8) ;; rel_at: _sov_list_add(rel_at, at)
        if same(kind, 'gwstr_a') = 1 -> poke8(flat, HDR + at, str_addr)
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, 'gwstr_n') = 1 -> poke4(flat, HDR + at, (sl + 7) / 8)
        if same(kind, 'gwipe_a') = 1 -> poke8(flat, HDR + at, glob_addr)
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, 'gwipe_n') = 1 -> gbytes: _sov_list_len(glob_names) * 8 + sbtot
            poke4(flat, HDR + at, (gbytes + 7) / 8)
        if same(kind, 'sbss') = 1 -> bi: _sov_atoi(val)
            baddr: glob_addr + _sov_list_len(glob_names) * 8 ;; bj: 0
            as long as bj < bi -> bs: _sov_list_get(sbss_sizes, bj)
                baddr: baddr + 15 ;; baddr: baddr - baddr % 16
                baddr: baddr + bs ;; bj: bj + 1
            baddr: baddr + 15 ;; baddr: baddr - baddr % 16
            poke8(flat, HDR + at, baddr) ;; rel_at: _sov_list_add(rel_at, at)
        i: i + 1
    if had_err = 1 -> return ;; if rel_n > 0 -> poke8(flat, rel_off, rel_n)
        ri: 0 ;; as long as ri < rel_n -> poke8(flat, rel_off + 8 + ri * 8, HDR + _sov_list_get(rel_at, ri))
            ri: ri + 1
    if 1 = 1 -> sxi: 0
        as long as sxi < _sov_list_len(patch_at) -> if same(_sov_list_get(patch_kind, sxi), 'rel_a') = 1
                poke8(flat, HDR + _sov_list_get(patch_at, sxi), BASE + rel_off)
            if same(_sov_list_get(patch_kind, sxi), 'rel_n') = 1 -> poke4(flat, HDR + _sov_list_get(patch_at, sxi), rel_n)
            if same(_sov_list_get(patch_kind, sxi), 'rel_l') = 1 -> poke8(flat, HDR + _sov_list_get(patch_at, sxi), gfoff)
            sxi: sxi + 1
    gsx: idx(glob_names, 'g_slide')
    if gsx > 0 - 1 -> poke8(flat, rel_off + relsz + gsx * 8, glob_addr + gsx * 8) ;; if sxe_mode = 1 -> sx_data_extra: sbtot + 65536
        if sxe_compact = 1 -> sx_data_extra: sbtot ;; sx_data_end: 4096 + filesz + sx_data_extra
        sx_rel_off: sx_data_end ;; as long as sx_rel_off % 4096 != 0 -> sx_rel_off: sx_rel_off + 1
        sx_rel_len: rel_n * 24 ;; sx_count: 2
        sx_total: sx_data_end ;; if rel_n > 0 -> sx_count: 3
            sx_total: sx_rel_off + sx_rel_len
        sx: _sov_alloc(sx_total) ;; sxz: 0
        as long as sxz < sx_total -> dummy: _sov_set_byte(sx, sxz, 0)
            sxz: sxz + 1
        poke8(sx, 0, 4544595) ;; poke8(sx, 8, 1)
        poke8(sx, 16, 4096 + HDR) ;; poke8(sx, 24, sx_count)
        poke8(sx, 32, 1) ;; poke8(sx, 40, 4096)
        poke8(sx, 48, gfoff) ;; poke8(sx, 56, 3)
        poke8(sx, 64, 4096 + gfoff) ;; poke8(sx, 72, filesz - gfoff + sx_data_extra)
        if rel_n > 0 -> sx: poke8 80 + 8 * i: 4 sx_rel_off sx_rel_len ;; sxi2: 0
        as long as sxi2 < filesz -> dummy: _sov_set_byte(sx, 4096 + sxi2, _sov_byte_at(flat, sxi2))
            sxi2: sxi2 + 1
        sri: 0 ;; as long as sri < rel_n -> sat: _sov_list_get(rel_at, sri)
            sval: peek_raw64(flat + HDR + sat, 0) ;; poke8(sx, sx_rel_off + sri * 24, 4096 + HDR + sat)
            poke8(sx, sx_rel_off + sri * 24 + 8, 4096 + sval - BASE) ;; poke8(sx, sx_rel_off + sri * 24 + 16, 1)
            sri: sri + 1
        w: _sov_write_n(path, sx, sx_total)
        if w = 0 -> print 'Error: cannot write SXE image'
            fail()
        _sov_chmod(path, 493) ;; return
    if kern_mode = 1 -> w: _sov_write_n(path, flat, filesz)
        include inc/inc03.sov 202 4 -6986864826888838330
    w: _sov_write_n(path, flat, filesz)
    include inc/inc01.sov 125 4 #9007471224322922887
    if dbg_mode = 1 -> if dbg_pcs != 0
            dig: '0123456789'
            m: "# src_base "
            sv: src_base ;; st: blank
            sg: 1
            as long as sg = 1 -> st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                sv: sv / 10
                if sv = 0 -> sg: 0
            m: join(m, st) ;; mi: 0
            as long as mi < _sov_list_len(dbg_pcs) -> pc: _sov_list_get(dbg_pcs, mi)
                ln: _sov_list_get(dbg_lns, mi) ;; sv: pc + HDR
                st: blank
                sg: 1
                as long as sg = 1 -> st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                    sv: sv / 10
                    if sv = 0 -> sg: 0
                m: join:
                    "\n"
                    st
                sv: ln
                st: blank
                sg: 1
                as long as sg = 1 -> st: join(cut(dig, sv % 10, sv % 10 + 1), st)
                    sv: sv / 10
                    if sv = 0 -> sg: 0
                m: join:
                    ' '
                    st
                mi: mi + 1
            m: join(m, "\n")
            file_write_all(join(path, '.map'), m)
indent_of t:
    n: length(t)
    0:
        i
        w
    as long as i < n -> b: peek_byte(t, i)
        if b = 32 -> w: w + 1 ;; if not -> if b = 9
                w: w + 4
            if not -> return w
        i: i + 1
    return w
strip_trail t:
    n: length(t) ;; as long as n > 0 -> b: peek_byte(t, n - 1)
        if b = 32 -> n: n - 1 ;; if not -> if b = 9
                n: n - 1
            if not -> return cut(t, 0, n)
    return blank
space_make n:
    s: blank
    i: 0
    as long as i < n -> s: join(s, ' ')
        i: i + 1
    return s
fmt_file path:
    s: load_file(path)
    if s = 0 -> print 'Error: cannot read input'
        fail()
    ls: lines_of(s)
    0:
        n2
        n4
        i
    as long as i < _sov_list_len(ls) -> ind: indent_of(_sov_list_get(ls, i))
        if ind > 1 -> if ind % 4 = 0
                n4: n4 + 1
            if not -> n2: n2 + 1
        i: i + 1
    unit: 4 ;; if n2 > n4 -> unit: 2
    i: 0 ;; out: blank
    as long as i < _sov_list_len(ls) -> t: _sov_list_get(ls, i)
        t: strip_trail(t) ;; ind: indent_of(t)
        if ind > 0 -> rest: cut(t, ind, length(t))
            q: ind / unit ;; if (ind % unit) * 2 >= unit -> q: q + 1
            if q < 1 -> q: 1 ;; t: join(space_make(q * unit), rest)
        if i = 0 -> out: t
        if not -> out: join(join(out, "\n"), t)
        i: i + 1
    if file_write_all(path, out) = 0 -> print 'Error: cannot write'
        _sov_print(path) ;; fail()
    print 'Formatted'
    _sov_print(path) ;; return 1
run_prog path argv argc:
    pid: sys_fork() ;; if pid = 0 -> argv2: _sov_alloc(512)
        poke_i64(argv2, 0, path)
        1:
            k
            i
        as long as i < argc -> a: peek_ptr(argv, i)
            keep: 1
            if same(a, '-o') = 1 -> keep: 0
                i: i + 1
            if not -> if same(a, '--run') = 1
                    keep: 0
                if not -> if same(a, '--fmt') = 1
                        keep: 0
                    if not -> if same(a, '--debug') = 1
                            keep: 0
                        if not -> if same(a, '--flat') = 1
                                keep: 0
                            if same(a, '--bare') = 1 -> keep: 0
                            if not -> if same(a, path) = 1
                                    keep: 0
            if keep = 1 -> poke_i64(argv2, k * 8, a)
                k: k + 1
            i: i + 1
        poke_i64(argv2, k * 8, 0) ;; sys_exec(path, argv2, 0)
        sys_exit(127)
    w: sys_wait(pid) ;; sys_exit(w / 256)
# --- haiku ABI layer ---------------------------------------------------
bsd_fx a n b:
    return join(a, join(strip(i2s(n)), b))

bsd_rp t old new:
    # replace-all in one pass: repl() sizes its room for one hit, so a
    # pattern that occurs hundreds of times overruns it. this allocates
    # the worst case up front and copies byte by byte.
    n: str_len(t)
    o: str_len(old)
    gn: str_len(new)
    cap: n + 8
    if gn > o -> cap: n + (n / o + 1) * (gn - o) + 8
    r: _sov_alloc(cap)
    0:
        i
        j
        k
        m
    as long as i < n -> m: 0
        if i + o <= n -> m: 1
            k: 0
            as long as k < o -> if m = 1
                    if _sov_byte_at(t, i + k) != _sov_byte_at(old, k) -> m: 0
                k: k + 1
        if m = 1 -> k: 0
            as long as k < gn -> dummy: _sov_set_byte(r, j, _sov_byte_at(new, k))
                j: j + 1
                k: k + 1
            i: i + o
        if m = 0 -> dummy: _sov_set_byte(r, j, _sov_byte_at(t, i))
            j: j + 1
            i: i + 1
    dummy: _sov_set_byte(r, j, 0)
    return r as text

bsd_pref t i:
    # 8 for "syscall(" and for "sovcall(", 0 for neither
    if _sov_byte_at(t, i) != 115 -> return 0
    if _sov_byte_at(t, i + 1) = 121 -> if bsd_word(t, i, "syscall(") = 1 -> return 8
    if _sov_byte_at(t, i + 1) = 111 -> if bsd_word(t, i, "sovcall(") = 1 -> return 8
    return 0
bsd_word t i w:
    n: str_len(w)
    k: 0
    as long as k < n -> if _sov_byte_at(t, i + k) != _sov_byte_at(w, k) -> return 0
        k: k + 1
    return 1
bsd_dig t p n:
    # the value of the decimal run at p, or -1 when there is none
    v: 0
    k: 0
    go: 1
    as long as go = 1 -> c: 0
        if p + k >= n -> go: 0
        if go = 1 -> c: _sov_byte_at(t, p + k)
            if c < 48 -> go: 0
            if c > 57 -> go: 0
            # nested inline ifs that compound form corrupts the frame
            if go = 1 -> v: v * 10 + c - 48
                k: k + 1
    if k > 0 -> return v
    return 0 - 1
bsd_skip t p n:
    # the index after the decimal run at p
    k: 0
    go: 1
    as long as go = 1 -> c: 0
        if p + k >= n -> go: 0
        if go = 1 -> c: _sov_byte_at(t, p + k)
            if c < 48 -> go: 0
            if c > 57 -> go: 0
            if go = 1 -> k: k + 1
    return p + k
bsd_wdig r j v:
    # the decimal digits of v, and the index after them (no strings:
    # this runs inside the compiler, where i2s is not a program task).
    # ten digits: redox writes nine-digit numbers, and an eight-digit
    # start dropped the leading one (570425347 became 70425347)
    d: 1000000000
    st: 0
    as long as d > 0 -> if v >= d -> st: 1
        if st = 1 -> dummy: _sov_set_byte(r, j, 48 + (v / d) % 10)
            j: j + 1
            v: v - (v / d) * d
        d: d / 10
    if st = 0 -> dummy: _sov_set_byte(r, j, 48)
        j: j + 1
    return j
bsd_map t:
    # one pass: read the number after every syscall(/sovcall( and write
    # the target number in its place
    n: str_len(t)
    r: _sov_alloc(n + n / 8 + 64)
    0:
        i
        j
        p
        q
        v
        m
        k
    as long as i < n -> p: 0
        if i + 8 <= n -> p: bsd_pref(t, i)
        if p = 0 -> dummy: _sov_set_byte(r, j, _sov_byte_at(t, i))
            j: j + 1
            i: i + 1
        if p > 0 -> q: i + p
            v: bsd_dig(t, q, n)
            m: 0 - 1
            if v > 0 - 1 -> m: bsd_num(v)
            if m < 0 -> m: v
            k: 0
            as long as k < p -> dummy: _sov_set_byte(r, j, _sov_byte_at(t, i + k))
                j: j + 1
                k: k + 1
            if m < 0 -> m: 0
            if v > 0 - 1 -> j: bsd_wdig(r, j, m)
            if v > 0 - 1 -> i: bsd_skip(t, q, n)
            if v < 0 -> i: q
    dummy: _sov_set_byte(r, j, 0)
    return r as text

bsd_eq t i s:
    # does t carry the string s at i?
    k: 0
    m: str_len(s)
    as long as k < m -> if _sov_byte_at(t, i + k) != _sov_byte_at(s, k) -> return 0
        k: k + 1
    return 1
bsd_sp t i n:
    # how long the call head at i is, or 0 when there is none here.
    # n is str_len(t) handed in: the caller already knows it, and
    # recomputing it per position turned the shim scan quadratic.
    if i + 13 <= n -> if bsd_eq(t, i, 'syscall(149, ') = 1 -> return 13
    if i + 13 <= n -> if bsd_eq(t, i, 'syscall(151, ') = 1 -> return 13
    return 0

bsd_shim t:
    # slip the argument the tree does not pass into the calls that want one:
    #   syscall(149, ...  ->  0 - 1,
    #   syscall(151, ...  ->  0 - 1,
    n: str_len(t)
    r: _sov_alloc(n + n / 8 + 64)
    0:
        i
        j
        p
        k
        c
        ins
        h0
        q2
        k2
    as long as i < n -> p: bsd_sp(t, i, n)
        if p = 0 -> dummy: _sov_set_byte(r, j, _sov_byte_at(t, i))
            j: j + 1
            i: i + 1
        if p > 0 -> h0: i
            k: 0
            as long as k < p -> dummy: _sov_set_byte(r, j, _sov_byte_at(t, i + k))
                j: j + 1
                k: k + 1
            i: i + p
            ins: 0
            k2: 0
            # the first argument, copied as it stands: the insertion goes after it
            as long as k2 < 512
                if i >= n -> leave
                c: _sov_byte_at(t, i)
                if c = 10 -> leave
                dummy: _sov_set_byte(r, j, c)
                j: j + 1
                i: i + 1
                if c = 44 -> ins: 1
                    leave
                k2: k2 + 1
            q2: 0
            q2: q2 + ins * bsd_eq(t, h0, 'syscall(149, ')
            q2: q2 + ins * bsd_eq(t, h0, 'syscall(151, ')
            if q2 > 0 -> k: 0
                as long as k < 7 -> dummy: _sov_set_byte(r, j, _sov_byte_at(' 0 - 1,', k))
                    j: j + 1
                    k: k + 1
    dummy: _sov_set_byte(r, j, 0)
    return r as text

bsd_num n:
    # the table, both directions in one place: a Linux number in, the
    # number this kernel answers to out, -1 when there is none.
