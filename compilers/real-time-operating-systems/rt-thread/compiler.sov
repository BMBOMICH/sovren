# Expanded compact source to match current shared front end.
# Sovren to RT-Thread shim source emitter.
# Emits RTOS-specific C glue with a deterministically evaluated Sovren command-style main result.

use arg
use file
use sys
use num

src: 0
srclen: 0
pg_src: 0
pg_len: 0
locals: 0
block_inds: 0
block_kinds: 0
block_n: 0
last_block_kind: ""
out: ""

is_dig c:
    if c >= 48
        if c <= 57
            return 1
    return 0

is_sp c:
    if c is 32
        return 1
    if c is 9
        return 1
    if c is 10
        return 1
    if c is 13
        return 1
    return 0

find_return:
    off: 0
    if srclen > 4096
        off: srclen - 4096
    p: str_find(src + off, "return ")
    if p >= 0
        return off + p + 6
    return 0 - 1

xp: 0
xe: 0

xskip:
    as long as xp < xe
        if is_sp(peek_byte(src, xp)) is 1
            xp: xp + 1
        if not
            leave
    return 0

xfac:
    xskip()
    if xp >= xe
        return 0
    c: peek_byte(src, xp)
    if c is 40
        xp: xp + 1
        v: xexpr()
        xskip()
        if xp < xe
            if peek_byte(src, xp) is 41
                xp: xp + 1
        return v
    if c is 45
        xp: xp + 1
        return 0 - xfac()
    if is_dig(c) is 1
        v2: 0
        as long as xp < xe
            d: peek_byte(src, xp)
            if is_dig(d) is 1
                v2: v2 * 10 + d - 48
                xp: xp + 1
            if not
                leave
        return v2
    if is_alfa(c) is 1
        st: xp
        as long as xp < xe
            if is_aln(peek_byte(src, xp)) is 1
                xp: xp + 1
            if not
                leave
        nm: str_cut(src, st, xp)
        xskip()
        if xp < xe
            if peek_byte(src, xp) is 40
                xp: xp + 1
                args: _sov_list_new()
                as long as xp < xe
                    xskip()
                    if xp < xe
                        if peek_byte(src, xp) is 41
                            xp: xp + 1
                            leave
                    av: xexpr()
                    args: _sov_list_add(args, av)
                    xskip()
                    if xp < xe
                        if peek_byte(src, xp) is 44
                            xp: xp + 1
                ss: src
                sl: srclen
                sxp: xp
                sxe: xe
                cv: eval_fn_args(nm, args)
                src: ss
                srclen: sl
                xp: sxp
                xe: sxe
                return cv
        return env_get(nm)
    xp: xp + 1
    return 0

xterm:
    v: xfac()
    as long as 1 is 1
        xskip()
        if xp >= xe
            return v
        c: peek_byte(src, xp)
        if c is not 42
            if c is not 47
                return v
        xp: xp + 1
        b: xfac()
        if c is 42
            v: v * b
        if c is 47
            if b is not 0
                v: v / b
    return v

xexpr:
    v: xterm()
    as long as 1 is 1
        xskip()
        if xp >= xe
            return v
        c: peek_byte(src, xp)
        if c is not 43
            if c is not 45
                return v
        xp: xp + 1
        b: xterm()
        if c is 43
            v: v + b
        if c is 45
            v: v - b
    return v

fn_names: 0
fn_params: 0
fn_bodies: 0
env_names: 0
env_vals: 0
ret_flag: 0
ret_val: 0
last_if_taken: 0

is_alfa c:
    if c >= 97
        if c <= 122
            return 1
    if c >= 65
        if c <= 90
            return 1
    if c is 95
        return 1
    return 0

is_aln c:
    if is_alfa(c) is 1
        return 1
    if is_dig(c) is 1
        return 1
    return 0

ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n
        if is_sp(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return str_cut(s, i, n)

rtrim s:
    n: str_len(s)
    as long as n > 0
        if is_sp(peek_byte(s, n - 1)) is 1
            n: n - 1
        if not
            leave
    return str_cut(s, 0, n)

trim s:
    return rtrim(ltrim(s))

starts s p:
    pn: str_len(p)
    if str_len(s) < pn
        return 0
    if str_eq(str_cut(s, 0, pn), p) is 1
        return 1
    return 0

word_end s a:
    n: str_len(s)
    i: a
    as long as i < n
        if is_aln(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return i

find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n
        if peek_byte(s, i) is c
            return i
        i: i + 1
    return 0 - 1

find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n
        if peek_byte(s, i) is 45
            if peek_byte(s, i + 1) is 62
                return i
        i: i + 1
    return 0 - 1

indent_of s:
    n: str_len(s)
    i: 0
    w: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 32
            w: w + 1
        if not
            if c is 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w

env_idx nm:
    i: 0
    as long as i < _sov_list_len(env_names)
        if str_eq(as text _sov_list_get(env_names, i), nm) is 1
            return i
        i: i + 1
    return 0 - 1

env_get nm:
    i: env_idx(nm)
    if i >= 0
        return _sov_list_get(env_vals, i)
    return 0

env_set nm v:
    i: env_idx(nm)
    if i >= 0
        env_vals: _sov_list_set(env_vals, i, v)
    if not
        env_names: _sov_list_add(env_names, nm)
        env_vals: _sov_list_add(env_vals, v)
    return 0

fn_idx nm:
    i: 0
    as long as i < _sov_list_len(fn_names)
        if str_eq(as text _sov_list_get(fn_names, i), nm) is 1
            return i
        i: i + 1
    return 0 - 1

expr_eval s:
    os: src
    ol: srclen
    oxp: xp
    oxe: xe
    src: s
    srclen: str_len(s)
    xp: 0
    xe: srclen
    v: xexpr()
    src: os
    srclen: ol
    xp: oxp
    xe: oxe
    return v

cond_eval cond:
    s: trim(cond)
    oi: 0 - 1
    op: ""
    step: 1
    i: 0
    as long as i < str_len(s)
        c: peek_byte(s, i)
        n: 0
        if i + 1 < str_len(s)
            n: peek_byte(s, i + 1)
        if c is 33
            if n is 61
                op: "ne"
            oi: i
            step: 2
            leave
        if c is 60
            op: "lt"
            oi: i
            step: 1
            if n is 61
                op: "le"
                step: 2
            leave
        if c is 62
            op: "gt"
            oi: i
            step: 1
            if n is 61
                op: "ge"
                step: 2
            leave
        if c is 61
            op: "eq"
            oi: i
            step: 1
            leave
        i: i + 1
    if oi >= 0
        a: expr_eval(str_cut(s, 0, oi))
        b: expr_eval(str_cut(s, oi + step, str_len(s)))
        if str_eq(op, "eq") is 1
            if a is b
                return 1
        if str_eq(op, "ne") is 1
            if a is not b
                return 1
        if str_eq(op, "lt") is 1
            if a < b
                return 1
        if str_eq(op, "gt") is 1
            if a > b
                return 1
        if str_eq(op, "le") is 1
            if a <= b
                return 1
        if str_eq(op, "ge") is 1
            if a >= b
                return 1
        return 0
    if expr_eval(s) is not 0
        return 1
    return 0

eval_stmt_parts s:
    ts: trim(s)
    if starts(ts, "as long as ") is 1
        eval_stmt(ts)
        return 0
    if starts(ts, "if ") is 1
        eval_stmt(ts)
        return 0
    start: 0
    n: str_len(s)
    as long as start < n
        i: start
        found: 0
        as long as i + 1 < n
            if peek_byte(s, i) is 59
                if peek_byte(s, i + 1) is 59
                    found: 1
                    leave
            i: i + 1
        if found is 0
            i: n
        eval_stmt(str_cut(s, start, i))
        if ret_flag is 1
            return 0
        if found is 1
            start: i + 2
        if not
            start: n
    return 0

eval_stmt st:
    s: trim(st)
    if str_len(s) is 0
        return 0
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if starts(s, "as long as ") is 1
        arw: find_arrow(s)
        if arw < 0
            return 0
        cond: trim(str_cut(s, 11, arw))
        body: trim(str_cut(s, arw + 2, str_len(s)))
        guard: 0
        as long as cond_eval(cond) is 1
            eval_stmt_parts(body)
            if ret_flag is 1
                return 0
            guard: guard + 1
            if guard > 100000
                return 0
        return 0
    if str_eq(kw, "return") is 1
        ret_val: expr_eval(str_cut(s, w, str_len(s)))
        ret_flag: 1
        return 0
    if str_eq(kw, "if") is 1
        ar: find_arrow(s)
        if ar < 0
            return 0
        cond2: trim(str_cut(s, w, ar))
        body2: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond2, "not") is 1
            if last_if_taken is 0
                eval_stmt_parts(body2)
            last_if_taken: 0
            return 0
        last_if_taken: cond_eval(cond2)
        if last_if_taken is 1
            eval_stmt_parts(body2)
        return 0
    col: find_ch(s, 58)
    if col > 0
        nm: trim(str_cut(s, 0, col))
        env_set(nm, expr_eval(str_cut(s, col + 1, str_len(s))))
        return 0
    return 0

eval_block body minind:
    n: str_len(body)
    i: 0
    as long as i < n
        e: i
        as long as e < n
            if peek_byte(body, e) is 10
                leave
            e: e + 1
        raw: str_cut(body, i, e)
        t: trim(raw)
        ind: indent_of(raw)
        j: e + 1
        blk: ""
        if str_len(t) > 0
            if peek_byte(t, 0) is not 35
                as long as j < n
                    ne: j
                    as long as ne < n
                        if peek_byte(body, ne) is 10
                            leave
                        ne: ne + 1
                    nr: str_cut(body, j, ne)
                    nt: trim(nr)
                    ni: indent_of(nr)
                    if str_len(nt) > 0
                        if peek_byte(nt, 0) is not 35
                            if ni <= ind
                                leave
                    blk: str_cat(blk, nr)
                    blk: str_cat(blk, "\n")
                    j: ne + 1
                if starts(t, "as long as ") is 1
                    arw: find_arrow(t)
                    if arw >= 0
                        cond: trim(str_cut(t, 11, arw))
                        inl: trim(str_cut(t, arw + 2, str_len(t)))
                        guard: 0
                        as long as cond_eval(cond) is 1
                            if str_len(inl) > 0
                                eval_stmt_parts(inl)
                            if ret_flag is 1
                                return 0
                            if str_len(blk) > 0
                                eval_block(blk, ind + 1)
                            if ret_flag is 1
                                return 0
                            guard: guard + 1
                            if guard > 100000
                                return 0
                        i: j
                    if arw < 0
                        eval_stmt_parts(t)
                        i: e + 1
                if not
                    if starts(t, "if ") is 1
                        ar: find_arrow(t)
                        if ar >= 0
                            cond2: trim(str_cut(t, 2, ar))
                            inl2: trim(str_cut(t, ar + 2, str_len(t)))
                            if str_eq(cond2, "not") is 1
                                if last_if_taken is 0
                                    if str_len(inl2) > 0
                                        eval_stmt_parts(inl2)
                                    if ret_flag is 1
                                        return 0
                                    if str_len(blk) > 0
                                        eval_block(blk, ind + 1)
                                last_if_taken: 0
                            if not
                                last_if_taken: cond_eval(cond2)
                                if last_if_taken is 1
                                    if str_len(inl2) > 0
                                        eval_stmt_parts(inl2)
                                    if ret_flag is 1
                                        return 0
                                    if str_len(blk) > 0
                                        eval_block(blk, ind + 1)
                            i: j
                        if ar < 0
                            eval_stmt_parts(t)
                            i: e + 1
                    if not
                        eval_stmt_parts(t)
                        i: e + 1
        if str_len(t) > 0
            if peek_byte(t, 0) is 35
                i: e + 1
        if str_len(t) is 0
            i: e + 1
        if ret_flag is 1
            return 0
    return 0

eval_body body:
    last_if_taken: 0
    eval_block(body, 0)
    return 0

bind_params ps args:
    p: trim(ps)
    ai: 0
    as long as str_len(p) > 0
        p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0
            leave
        nm: str_cut(p, 0, e)
        v: 0
        if ai < _sov_list_len(args)
            v: _sov_list_get(args, ai)
        env_set(nm, v)
        ai: ai + 1
        p: trim(str_cut(p, e, str_len(p)))
    return 0

find_fn_hdr nm:
    nlen: str_len(nm)
    if pg_len > nlen
        if str_starts(pg_src, nm) is 1
            cAfter: peek_byte(pg_src, nlen)
            if cAfter is 58
                return 0
            if cAfter is 32
                return 0
    pat1: str_cat("\n", str_cat(nm, ":"))
    if pg_len > 4096
        tail_off: pg_len - 4096
        tp: str_find(pg_src + tail_off, pat1)
        if tp >= 0
            return tail_off + tp + 1
    p: str_find(pg_src, pat1)
    if p >= 0
        return p + 1
    pat2: str_cat("\n", str_cat(nm, " "))
    if pg_len > 4096
        tail_off2: pg_len - 4096
        tp2: str_find(pg_src + tail_off2, pat2)
        if tp2 >= 0
            return tail_off2 + tp2 + 1
    p: str_find(pg_src, pat2)
    if p >= 0
        return p + 1
    return 0 - 1

load_fn nm:
    fi: fn_idx(nm)
    if fi >= 0
        return fi
    hp: find_fn_hdr(nm)
    if hp < 0
        fn_names: _sov_list_add(fn_names, nm)
        fn_params: _sov_list_add(fn_params, "")
        fn_bodies: _sov_list_add(fn_bodies, "")
        return 0 - 1
    e: hp
    as long as e < pg_len
        if peek_byte(pg_src, e) is 10
            leave
        e: e + 1
    raw: str_cut(pg_src, hp, e)
    t: trim(raw)
    if str_len(t) is 0
        return 0 - 1
    if peek_byte(t, str_len(t) - 1) is not 58
        return 0 - 1
    h: str_cut(t, 0, str_len(t) - 1)
    w: word_end(h, 0)
    ps: trim(str_cut(h, w, str_len(h)))
    b0: e + 1
    i: b0
    b1: b0
    as long as i < pg_len
        le: i
        as long as le < pg_len
            if peek_byte(pg_src, le) is 10
                leave
            le: le + 1
        if le > i
            c0: peek_byte(pg_src, i)
            if is_sp(c0) is 1
                b1: le + 1
            if is_sp(c0) is 0
                if c0 is not 35
                    leave
        i: le + 1
    fn_names: _sov_list_add(fn_names, nm)
    fn_params: _sov_list_add(fn_params, ps)
    fn_bodies: _sov_list_add(fn_bodies, str_cut(pg_src, b0, b1))
    return _sov_list_len(fn_names) - 1

eval_fn_args nm args:
    fi: load_fn(nm)
    if fi < 0
        return 0
    fbody: as text _sov_list_get(fn_bodies, fi)
    if str_len(fbody) is 0
        return 0
    if str_find(fbody, "return") < 0
        return 0
    oldn: env_names
    oldv: env_vals
    oldrf: ret_flag
    oldrv: ret_val
    oldif: last_if_taken
    env_names: _sov_list_new()
    env_vals: _sov_list_new()
    ret_flag: 0
    ret_val: 0
    last_if_taken: 0
    bind_params(as text _sov_list_get(fn_params, fi), args)
    eval_body(as text _sov_list_get(fn_bodies, fi))
    rv: ret_val
    env_names: oldn
    env_vals: oldv
    ret_flag: oldrf
    ret_val: oldrv
    last_if_taken: oldif
    return rv

parse_program:
    pg_src: src
    pg_len: srclen
    fn_names: _sov_list_new()
    fn_params: _sov_list_new()
    fn_bodies: _sov_list_new()
    return 0

parse_return:
    parse_program()
    if load_fn("main") >= 0
        args: _sov_list_new()
        return eval_fn_args("main", args)
    p: find_return()
    if p < 0
        return 0
    as long as p < srclen
        if is_sp(peek_byte(src, p)) is 1
            p: p + 1
        if not
            leave
    e: p
    as long as e < srclen
        c: peek_byte(src, e)
        if c is 10
            leave
        if c is 13
            leave
        if c is 59
            leave
        e: e + 1
    xp: p
    xe: e
    return xexpr()

emit s:
    out: str_cat(out, s)
    return 0


emitln s:
    out: str_cat(out, s)
    out: str_cat(out, "\n")
    return 0


cond_expr s:
    n: str_len(s)
    r: ""
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        repl: 0
        if c is 61
            prev: 0
            next: 0
            if i > 0
                prev: peek_byte(s, i - 1)
            if i + 1 < n
                next: peek_byte(s, i + 1)
            repl: 1
            if prev is 60
                repl: 0
            if prev is 62
                repl: 0
            if prev is 33
                repl: 0
            if prev is 61
                repl: 0
            if next is 61
                repl: 0
        if repl is 1
            r: str_cat(r, "==")
        if not
            r: str_cat(r, str_cut(s, i, i + 1))
        i: i + 1
    return r


push_block kind ind:
    if block_n < _sov_list_len(block_inds)
        block_inds: _sov_list_set(block_inds, block_n, ind)
        block_kinds: _sov_list_set(block_kinds, block_n, kind)
    if not
        block_inds: _sov_list_add(block_inds, ind)
        block_kinds: _sov_list_add(block_kinds, kind)
    block_n: block_n + 1
    return 0


close_one:
    if block_n > 0
        emitln("    }")
        block_n: block_n - 1
    return 0


close_blocks ind:
    as long as block_n > 0
        top: _sov_list_get(block_inds, block_n - 1)
        if ind <= top
            close_one()
        if not
            leave
    return 0


close_all:
    as long as block_n > 0
        close_one()
    return 0


emit_else_line s ind:
    if block_n > 0
        top: _sov_list_get(block_inds, block_n - 1)
        kind: as text _sov_list_get(block_kinds, block_n - 1)
        if ind <= top
            if str_eq(kind, "if") is 1
                emitln("    } else {")
                block_n: block_n - 1
                push_block("else", ind)
                ar: find_arrow(s)
                if ar >= 0
                    body: trim(str_cut(s, ar + 2, str_len(s)))
                    if str_len(body) > 0
                        emit_stmt_parts(body)
                return 1
    close_blocks(ind)
    emitln("    else {")
    push_block("else", ind)
    ar2: find_arrow(s)
    if ar2 >= 0
        body2: trim(str_cut(s, ar2 + 2, str_len(s)))
        if str_len(body2) > 0
            emit_stmt_parts(body2)
    return 1


c_esc s:
    n: str_len(s)
    r: ""
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 34
            r: str_cat(r, "\\\"")
        if not
            if c is 92
                r: str_cat(r, "\\\\")
            if not
                r: str_cat(r, str_cut(s, i, i + 1))
        i: i + 1
    return r


local_seen nm:
    i: 0
    as long as i < _sov_list_len(locals)
        if str_eq(as text _sov_list_get(locals, i), nm) is 1
            return 1
        i: i + 1
    return 0


local_add nm:
    if local_seen(nm) is 0
        locals: _sov_list_add(locals, nm)
    return 0


c_expr s:
    # Keep the first route simple: Sovren's integer expression tokens are C-like
    # for + - * / comparisons and calls.  The frontend will own the complete
    # lowering later.
    return trim(s)


emit_print_lit lit reps:
    i: 0
    esc: c_esc(lit)
    as long as i < reps
        emit("    fputs(\"")
        emit(esc)
        emit("\\\\n\", stdout);")
        emitln("")
        i: i + 1
    return 0


emit_stmt st:
    s: trim(st)
    if str_len(s) is 0
        return 0
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if starts(s, "as long as ") is 1
        arw: find_arrow(s)
        if arw < 0
            return 0
        condw: trim(str_cut(s, 11, arw))
        bodyw: trim(str_cut(s, arw + 2, str_len(s)))
        emit("    while (")
        emit(cond_expr(condw))
        emitln(") {")
        if str_len(bodyw) > 0
            emit_stmt_parts(bodyw)
        last_block_kind: "while"
        return 1
    if str_eq(kw, "print") is 1
        rest: trim(str_cut(s, w, str_len(s)))
        if str_len(rest) > 0
            if peek_byte(rest, 0) is 39
                j: 1
                as long as j < str_len(rest)
                    if peek_byte(rest, j) is 39
                        leave
                    j: j + 1
                lit: str_cut(rest, 1, j)
                reps: 1
                tail: trim(str_cut(rest, j + 1, str_len(rest)))
                if str_len(tail) > 0
                    if peek_byte(tail, 0) >= 48
                        if peek_byte(tail, 0) <= 57
                            reps: 0
                            k: 0
                            as long as k < str_len(tail)
                                cc: peek_byte(tail, k)
                                if cc >= 48
                                    if cc <= 57
                                        reps: reps * 10 + cc - 48
                                        k: k + 1
                                    if not
                                        leave
                                if not
                                    leave
                emit_print_lit(lit, reps)
                return 0
        emit("    printf(\"%lld\\\\n\", (long long)(")
        emit(c_expr(rest))
        emitln("));")
        return 0
    if str_eq(kw, "return") is 1
        emit("    return ")
        emit(c_expr(str_cut(s, w, str_len(s))))
        emitln(";")
        return 0
    if str_eq(kw, "if") is 1
        ar: find_arrow(s)
        if ar < 0
            return 0
        cond: trim(str_cut(s, w, ar))
        body: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond, "not") is 1
            emitln("    else {")
            if str_len(body) > 0
                emit_stmt_parts(body)
            last_block_kind: "else"
            return 1
        emit("    if (")
        emit(cond_expr(cond))
        emitln(") {")
        if str_len(body) > 0
            emit_stmt_parts(body)
        last_block_kind: "if"
        return 1
    col: find_ch(s, 58)
    if col > 0
        nm: trim(str_cut(s, 0, col))
        ex: c_expr(str_cut(s, col + 1, str_len(s)))
        if local_seen(nm) is 1
            emit("    ")
            emit(nm)
            emit(" = ")
            emit(ex)
            emitln(";")
        if not
            local_add(nm)
            emit("    int64_t ")
            emit(nm)
            emit(" = ")
            emit(ex)
            emitln(";")
        return 0
    return 0


emit_stmt_parts s:
    t0: trim(s)
    if starts(t0, "as long as ") is 1
        return emit_stmt(t0)
    if starts(t0, "if ") is 1
        return emit_stmt(t0)
    start: 0
    n: str_len(s)
    opened: 0
    as long as start < n
        i: start
        found: 0
        as long as i + 1 < n
            if peek_byte(s, i) is 59
                if peek_byte(s, i + 1) is 59
                    found: 1
                    leave
            i: i + 1
        if found is 0
            i: n
        one: emit_stmt(str_cut(s, start, i))
        if one is 1
            opened: 1
        if found is 1
            start: i + 2
        if not
            start: n
    return opened


emit_header line:
    h: trim(line)
    if str_len(h) is 0
        return 0
    if peek_byte(h, str_len(h) - 1) is not 58
        return 0
    h: str_cut(h, 0, str_len(h) - 1)
    w: word_end(h, 0)
    nm: str_cut(h, 0, w)
    locals: _sov_list_new()
    if str_eq(nm, "main") is 1
        emitln("int main(void) {")
        return 1
    emit("int64_t ")
    emit(nm)
    emit("(")
    p: trim(str_cut(h, w, str_len(h)))
    first: 1
    as long as str_len(p) > 0
        p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0
            leave
        pn: str_cut(p, 0, e)
        if first is 0
            emit(", ")
        emit("int64_t ")
        emit(pn)
        local_add(pn)
        first: 0
        p: trim(str_cut(p, e, str_len(p)))
    emitln(") {")
    return 1


gen_program:
    out: ""
    n: srclen
    i: 0
    in_fn: 0
    block_inds: _sov_list_new()
    block_kinds: _sov_list_new()
    block_n: 0
    as long as i < n
        e: i
        as long as e < n
            if peek_byte(src, e) is 10
                leave
            e: e + 1
        raw: str_cut(src, i, e)
        t: trim(raw)
        if str_len(t) > 0
            if peek_byte(t, 0) is not 35
                ind: indent_of(raw)
                if is_sp(peek_byte(raw, 0)) is 0
                    if in_fn is 1
                        close_all()
                    if in_fn is 1
                        emitln("}")
                    in_fn: emit_header(t)
                    block_n: 0
                if is_sp(peek_byte(raw, 0)) is 1
                    if starts(t, "if not") is 1
                        emit_else_line(t, ind)
                    if not
                        close_blocks(ind)
                        opened: emit_stmt_parts(t)
                        if opened is 1
                            push_block(last_block_kind, ind)
        i: e + 1
    if in_fn is 1
        close_all()
    if in_fn is 1
        emitln("}")
    return out


emit_shim rv:
    o: "/* Sovren RT-Thread shim source. */\n#include <stdint.h>\n#include <stdio.h>\n\n"
    o: str_cat(o, gen_program())
    o: str_cat(o, "\nint64_t sovren_main(void) { return (int64_t)main(); }\nvolatile int64_t sovren_result;\n")
    o: str_cat(o, "void sovren_rtthread_entry(void *arg) {\n    (void)arg;\n    sovren_result = sovren_main();\n}\nint sovren_rtthread_start(void) {\n#ifdef SOVREN_USE_RTTHREAD\n    rt_thread_t tid = rt_thread_create(\"sovren\", sovren_rtthread_entry, 0, SOVREN_RTTHREAD_STACK_BYTES, SOVREN_RTTHREAD_PRIORITY, SOVREN_RTTHREAD_TICK);\n    if (tid) { rt_thread_startup(tid); }\n#endif\n    return sovren_main();\n}\n")
    return o

main:
    ac: arg_count()
    if ac < 2
        print "Usage: compiler src.sov -o out.c"
        sys_exit(1)
    inp: as text arg_at(1)
    outp: "sovren-rt-thread.c"
    if ac is 3
        if str_eq(as text arg_at(1), "-o") is 0
            if str_eq(as text arg_at(2), "-o") is 0
                outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac
        if str_eq(as text arg_at(i), "-o") is 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not
            i: i + 1
    srclen: file_size(inp)
    if srclen > 100000
        src: file_read_max(inp, 4096)
        srclen: 4096
    if not
        src: file_read_all(inp)
    if src is 0
        print "rt-thread: cannot read input"
        sys_exit(1)
    file_write_all(outp, emit_shim(parse_return()))
    print "rt-thread: wrote "
    print outp
    return 0
