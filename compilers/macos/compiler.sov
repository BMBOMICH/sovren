ask_kernel:
    used_mac_number: 1
    # the translation call clobbers the syscall argument registers
    # (rdi..r9 are caller-saved), so they are parked on the stack
    # first and come back after. The emulator keeps them across
    # calls, which = why this only broke on real macOS.
    bytes:
        87
        86
        82
        65
        82
        65
        80
        65
        81
    call("_sov_macnum")
    bytes:
        65
        89
        65
