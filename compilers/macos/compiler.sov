emit_used:
    if used_mn is 1
        emit_macnum()
    if used_al is 1
        if idx(glob_names, "heap_ptr") is 0 - 1
            glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_alloc()
    if used_pr is 1
        used_sl: 1
    if used_sl is 1
        emit_strlen()
    if used_eq is 1
        emit_streq()
    if used_pr is 1
        emit_print()
    if used_pi is 1
        emit_print_int()
    if used_tr is 1
        emit_trap_stub()
    if can_used is 1
        emit_canary_fail()
prep_main names params bodies:
    thin_main: 0
    skip_al: blank
    fib_nm: blank
    fib_drop: 0
    fi: 0
    as long as fi < _sov_list_len(names)
        if same(_sov_list_get(names, fi), "main") is 1
            if _sov_list_len(_sov_list_get(params, fi)) is 0
                thin_main: 1
            main_params_n: _sov_list_len(_sov_list_get(params, fi))
            skip_al: dead_iota(_sov_list_get(bodies, fi))
        if fiblike(_sov_list_get(names, fi), _sov_list_get(params, fi), _sov_list_get(bodies, fi)) is 1
            fib_nm: _sov_list_get(names, fi)
        fi: fi + 1
    # fold + drop the recognized fib when every call outside its own
    # body passes a literal constant (or it is never called at all).
    # a non-constant call, or an addr_of take, keeps the body.
    if length(fib_nm) > 0
        fib_drop: 1
        fi: 0
        as long as fi < _sov_list_len(names)
            if same(_sov_list_get(names, fi), fib_nm) is 0
                bln: _sov_list_get(bodies, fi)
                bi: 0
                as long as bi < _sov_list_len(bln)
                    if fib_call_var(_sov_list_get(bln, bi), fib_nm) is 1
                        fib_drop: 0
                    if look(_sov_list_get(bln, bi), join("addr_of ", fib_nm)) > 0 - 1
                        fib_drop: 0
                    bi: bi + 1
            fi: fi + 1
    if fib_drop is 1
        fn_names: _sov_list_add(fn_names, fib_nm)
        fn_offs: _sov_list_add(fn_offs, 0)
compile source:
    oc: _sov_list_new()
    iota_ptr: blank
    iota_lim: blank
    kn: blank
    kv: 0
    skip_al: blank
    used_al: 0
    used_sl: 0
    used_eq: 0
    used_pr: 0
    used_pi: 0
    used_mn: 0
    used_tr: 0
    did_stos: 0
    thin_main: 0
    has_vm: 0
    need_priv: 0
    saw_str: 0
    str_vars: _sov_list_new()
    str_fns: _sov_list_new()
    ar_names: _sov_list_new()
    ar_cnt: _sov_list_new()
    fn_locs: _sov_list_new()
    str_fns: _sov_list_add(str_fns, "cat")
    str_fns: _sov_list_add(str_fns, "strcat")
    str_fns: _sov_list_add(str_fns, "_sov_strcat")
    str_fns: _sov_list_add(str_fns, "sub")
    str_fns: _sov_list_add(str_fns, "trim")
    str_fns: _sov_list_add(str_fns, "ch")
    str_fns: _sov_list_add(str_fns, "_sov_substring")
    pre_lns: lines_of(source)
    pre_i: 0
    pre_cur: blank
    pre_n: _sov_list_len(pre_lns)
    as long as pre_i < pre_n
        pre_l: _sov_list_get(pre_lns, pre_i)
        if length(strip(pre_l)) > 0
            if nind(pre_l) is 0
                pre_t: strip(pre_l)
                if starts(pre_t, "#") is 0
                    if starts(pre_t, "use ") is 0
                        pre_c: find_col(pre_t)
                        if pre_c > 0
                            if pre_c is length(pre_t) - 1
                                pre_h: strip(cut(pre_t, 0, pre_c))
                                pre_sp: look(pre_h, " ")
                                if pre_sp > 0 - 1
                                    pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    pre_ps: strip(cut(pre_h, pre_sp, length(pre_h)))
                                    pre_na: 0
                                    pre_k: 0
                                    pre_in: 0
                                    as long as pre_k < length(pre_ps)
                                        if same(letter(pre_ps, pre_k), " ") is 1
                                            pre_in: 0
                                        if not
                                            if pre_in is 0
                                                pre_na: pre_na + 1
                                                pre_in: 1
                                        pre_k: pre_k + 1
                                    # seven values is the most a job can
                                    # take. more used to compile and then
                                    # go wrong while running.
                                    if pre_na > 7
                                        print "Error: a job takes at most seven values"
                                        _sov_print(pre_cur)
                                        print pre_na
                                        had_err: 1
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, pre_na)
                                if not
                                    pre_cur: pre_h
                                    ar_names: _sov_list_add(ar_names, pre_cur)
                                    ar_cnt: _sov_list_add(ar_cnt, 0)
            if not
                pre_t2: strip(pre_l)
                if starts(pre_t2, "return ") is 1
                    pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                    if starts(pre_r, "as text ") is 1
                        if length(pre_cur) > 0
                            mark_fn_str(pre_cur)
                    if length(pre_r) > 0
                        if _sov_byte_at(pre_r, 0) is 34
                            if length(pre_cur) > 0
                                mark_fn_str(pre_cur)
                        if not
                            if same(pre_r, "blank") is 1
                                if length(pre_cur) > 0
                                    mark_fn_str(pre_cur)
        pre_i: pre_i + 1
    # a job that hands back another job's answer is a text job too,
    # whatever order the jobs were written in. Keep going round until
    # nobody new is marked, so forward references work as well as
    # backward ones.
    changed: 1
    as long as changed is 1
        changed: 0
        pre_i: 0
        pre_cur: blank
        as long as pre_i < pre_n
            pre_l: _sov_list_get(pre_lns, pre_i)
            if length(strip(pre_l)) > 0
                if nind(pre_l) is 0
                    pre_t: strip(pre_l)
                    if starts(pre_t, "#") is 0
                        if starts(pre_t, "use ") is 0
                            pre_c: find_col(pre_t)
                            if pre_c > 0
                                if pre_c is length(pre_t) - 1
                                    pre_h: strip(cut(pre_t, 0, pre_c))
                                    pre_sp: look(pre_h, " ")
                                    if pre_sp > 0 - 1
                                        pre_cur: repl(strip(cut(pre_h, 0, pre_sp)), " ", "_")
                                    if not
                                        pre_cur: pre_h
                if not
                    pre_t2: strip(pre_l)
                    if starts(pre_t2, "return ") is 1
                        pre_r: strip(cut(pre_t2, 7, length(pre_t2)))
                        if idx(str_fns, pre_cur) < 0
                            if starts(pre_r, "as text ") is 0
                                if length(pre_r) > 0
                                    if _sov_byte_at(pre_r, 0) is not 34
                                        if same(pre_r, "blank") is 0
                                            pre_lp: look(pre_r, "(")
                                            if pre_lp > 0
                                                pre_f: strip(cut(pre_r, 0, pre_lp))
                                                if idx(str_fns, pre_f) > 0 - 1
                                                    mark_fn_str(pre_cur)
                                                    changed: 1
            pre_i: pre_i + 1
    # a program that wipes or marks private data must not core-dump it.
    # match the statements, not the substring: the old look() matched
    # "# would wipe what the stub stored" in a runtime comment and
    # spent 14 bytes of prctl in every runtime-linked binary.
    nls: lines_of(source)
    ni: 0
    as long as ni < _sov_list_len(nls)
        ns: strip(_sov_list_get(nls, ni))
        if same(ns, "private") is 1
            need_priv: 1
        if starts(ns, "wipe ") is 1
            need_priv: 1
        ni: ni + 1
    cnms: _sov_list_new()
    cvls: _sov_list_new()
    cemt: _sov_list_new()
    strb: _sov_buf_new()
    str_keys: _sov_list_new()
    str_pos: _sov_list_new()
    fn_names: _sov_list_new()
    fn_offs: _sov_list_new()
    glob_names: _sov_list_new()
    patch_at: _sov_list_new()
    patch_kind: _sov_list_new()
    patch_val: _sov_list_new()
    patch_line: _sov_list_new()
    stmt_lns: _sov_list_new()
    body_lns: _sov_list_new()
    task_lns: _sov_list_new()
    task_user: _sov_list_new()
    lns: lines_of(source)
    bodies: _sov_list_new()
    params: _sov_list_new()
    names: _sov_list_new()
    tops: _sov_list_new()
    in_t: 0
    cur: _sov_list_new()
    cur_ln: _sov_list_new()
    li: 0
    as long as li < _sov_list_len(lns)
        raw: _sov_list_get(lns, li)
        s: strip(raw)
        th: 0
        if is_task_hdr(s) is 1
            th: 1
        if th is 1
            if in_t is 1
                bodies: _sov_list_add(bodies, cur)
                body_lns: _sov_list_add(body_lns, cur_ln)
            tn: tname(s)
            if idx(names, tn) > 0 - 1
                print "Error: two with the same name"
                _sov_print(tn)
                err_line: file_ln(li)
                print err_line
                had_err: 1
            names: _sov_list_add(names, tn)
            params: _sov_list_add(params, tparams(s))
            tu: 0
            if li + 1 > src_base
                tu: 1
            task_user: _sov_list_add(task_user, tu)
            task_lns: _sov_list_add(task_lns, file_ln(li))
            cur: _sov_list_new()
            cur_ln: _sov_list_new()
            in_t: 1
        if not
            if nind(raw) is 0
                gok: 0
                gc: find_col(s)
                if gc > 0
                    if gc < length(s) - 1
                        gok: 1
                if gok is 1
                    gn: blank
                    if starts(s, "<-- ") is 1
                        rest: cut(s, 4, length(s))
                        t: find_sep(rest)
                        if t > 0 - 1
                            gn: repl(strip(cut(rest, 0, t)), " ", "_")
                    if not
                        gn: repl(strip(cut(s, 0, gc)), " ", "_")
                    if length(gn) > 0
                        if idx(glob_names, gn) is 0 - 1
                            glob_names: _sov_list_add(glob_names, gn)
                        # a top-level "x: x" only registers the global;
                        # the store is a no-op (the start stub has already
                        # filled g_argc/g_argv before main runs). skip it.
                        sa: 0
                        if gc + 1 < length(s)
                            grhs: strip(cut(s, gc + 1, length(s)))
                            if same(repl(grhs, " ", "_"), gn) is 1
                                sa: 1
                        if sa is 0
                            tops: _sov_list_add(tops, raw)
            if not
                if in_t is 1
                    cur: _sov_list_add(cur, raw)
                    cur_ln: _sov_list_add(cur_ln, file_ln(li))
        li: li + 1
    if in_t is 1
        bodies: _sov_list_add(bodies, cur)
        body_lns: _sov_list_add(body_lns, cur_ln)
    want_args: 0
    if look(source, "g_argc") > 0 - 1
        want_args: 1
    has_vm: 0
    if look(source, "task _sov_alloc") > 0 - 1
        has_vm: 1
    if look(source, "_sov_alloc size:") > 0 - 1
        has_vm: 1
    prep_main(names, params, bodies)
    fli: 0
    as long as fli < _sov_list_len(bodies)
        fb: _sov_list_get(bodies, fli)
        fset: _sov_list_new()
        flj: 0
        as long as flj < _sov_list_len(fb)
            fls: strip(_sov_list_get(fb, flj))
            if length(fls) > 0
                if _sov_byte_at(fls, 0) is not 35
                    if _sov_byte_at(fls, 0) is not 34
                        fgc: find_col(fls)
                        if fgc > 0
                            if fgc < length(fls) - 1
                                fgn: repl(strip(cut(fls, 0, fgc)), " ", "_")
                                if length(fgn) > 0
                                    if idx(glob_names, fgn) is 0 - 1
                                        if idx(fset, fgn) is 0 - 1
                                            fset: _sov_list_add(fset, fgn)
            flj: flj + 1
        fn_locs: _sov_list_add(fn_locs, _sov_list_len(fset))
        fli: fli + 1
    if has_vm is 1
        glob_names: _sov_list_add(glob_names, "heap_ptr")
        emit_start()
        emit_macnum()
        used_mn: 0
        emit_alloc()
        emit_strlen()
        emit_streq()
        emit_print()
        emit_print_int()
        thin_main: 0
    if not
        if thin_main is 0
            emit_start()
        if thin_main is 1
            # pass S7: even a thin main needs the walk before its
            # first absolute: a start block of walk, then jump
            emit_pie_walk()
            emit(233)
            tjmp: here()
            emit4(0)
            addp(tjmp, "rel", "main")
    fi: 0
    as long as fi < _sov_list_len(names)
        nm: _sov_list_get(names, fi)
        if idx(fn_names, nm) < 0
                fn_names: _sov_list_add(fn_names, nm)
                fn_offs: _sov_list_add(fn_offs, here())
                locals: _sov_list_new()
                str_vars: _sov_list_new()
                saw_str: 0
                br_depth: 0
                stmt_lns: _sov_list_get(body_lns, fi)
                if _sov_list_len(_sov_list_get(bodies, fi)) is 0
                    if _sov_list_get(task_user, fi) is 1
                        print "Warning: empty"
                        _sov_print(nm)
                        print _sov_list_get(task_lns, fi)
                ps: _sov_list_get(params, fi)
                pi: 0
                as long as pi < _sov_list_len(ps)
                    locals: _sov_list_add(locals, _sov_list_get(ps, pi))
                    pi: pi + 1
                thin: 0
                if same(nm, "main") is 1
                    if _sov_list_len(ps) is 0
                        thin: 0
                if thin is 1
                    skip_al: dead_iota(_sov_list_get(bodies, fi))
                    if need_priv is 1
                        emit_nodump()
                        emit_canary_seed()
                        emit_crash_install()
                    leaf8: leaf8_scan(tops)
                    body(tops)
                    cflush_all()
                    leaf8: 0
                    if _sov_list_len(ps) is 0
                        leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                    body(_sov_list_get(bodies, fi))
                    if saw_str is 1
                        mark_fn_str(nm)
                    if need_priv is 1
                        emit_stack_wipe()
                    emit(49)
                    emit(255)
                    rax_mac(60)
                    sysc_raw()
                if not
                    fn_save_n: 0
                    fw_on: 0
                    fw_done: 0
                    fw_pos: _sov_list_new()
                    fargs: _sov_list_len(ps)
                    floc: 0
                    if fi < _sov_list_len(fn_locs)
                        floc: _sov_list_get(fn_locs, fi)
                    ftot: fargs + floc
                    if ftot > 5
                        ftot: 5
                    fn_save_n: ftot
                    no_frame: 0
                    if fargs + floc < 6
                        if starts(nm, "_sov_") is 0
                            no_frame: 1
                    isfib: fiblike(nm, ps, _sov_list_get(bodies, fi))
                    if isfib is 1
                        # frame-free: the iterative body touches rbx
                        # (the arg) and nothing else callee-saved -
                        # a/rdx/rcx are caller-saved - so the frame
                        # is one register, not three
                        fn_save_n: 1
                        no_frame: 1
                    can_here: 0
                    cbi: 0
                    as long as cbi < _sov_list_len(_sov_list_get(bodies, fi))
                        if same(strip(_sov_list_get(_sov_list_get(bodies, fi), cbi)), "private") is 1
                            can_here: 1
                        cbi: cbi + 1
                    prolog()
                    if can_here is 1
                        if no_frame is 0
                            if isfib is 0
                                canary_store()
                    copyargs(_sov_list_len(ps))
                    if isfib is 1
                        emit_fib_iter()
                    if not
                        if same(nm, "main") is 1
                            skip_al: dead_iota(_sov_list_get(bodies, fi))
                            if need_priv is 1
                                emit_nodump()
                                emit_canary_seed()
                                emit_crash_install()
                            leaf8: leaf8_scan(tops)
                            in_main_now: 1
                            body(tops)
                            in_main_now: 0
                            cflush_all()
                        leaf8: 0
                        if _sov_list_len(ps) is 0
                            leaf8: leaf8_scan(_sov_list_get(bodies, fi))
                        if same(nm, "main") is 1
                            in_main_now: 1
                        body(_sov_list_get(bodies, fi))
                        if same(nm, "main") is 1
                            in_main_now: 0
                    if _sov_list_len(locals) < 6
                        if fn_save_n < _sov_list_len(locals)
                            print "Warning: locals"
                            _sov_print(nm)
                            print _sov_list_len(locals)
                            print fn_save_n
                    if saw_str is 1
                        mark_fn_str(nm)
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes below
                    # the frame pointer, so the room has to be a full
                    # slot deeper than the count, or the callee's own
                    # frame lands on top of our spilled values
                    # the frame must reach past the deepest local: a
                    # value stored at slot i sits (i + 1) * 8 bytes
                    # below the frame pointer, so the room has to be
                    # a full slot deeper than the count, or the
                    # callee's own frame lands on top of our spilled
                    # values
                    if no_frame is 0
                        ns: (_sov_list_len(locals) + 1) * 8
                        if ns < 32
                            ns: 32
                        # pass S5: room for the canary below the
                        # deepest local, still inside the frame
                        if _sov_list_len(cd_at) > 0
                            ns: ns + 16
                        put(pro_at, ns)
                        if fw_on is 1
                            if isfib is 0
                                canary_check()
                                xor_rax()
                                restores()
                                frame_wipe()
                                emit(201)
                                ret()
                                fw_done: 1
                            fwi: 0
                            as long as fwi < _sov_list_len(fw_pos)
                                put(_sov_list_get(fw_pos, fwi), ns + fn_save_n * 8)
                                fwi: fwi + 1
                        # pass S5: patch the canary displacement holes
                        # now - after the end-of-body epilogue has
                        # emitted its own check into the list
                        chi: 0
                        as long as chi < _sov_list_len(cd_at)
                            put(_sov_list_get(cd_at, chi), 8 - ns - fn_save_n * 8)
                            chi: chi + 1
                        cd_at: 0
                    if same(nm, "main") is 1
                        if need_priv is 1
                            emit_stack_wipe()
                        emit(49)
                        emit(255)
                        rax_mac(60)
                        sysc_raw()
                    if not
                        # the fib fast path ends in its own leave/ret;
                        # a second epilogue here would be dead bytes
                        if isfib is 0
                            if fw_done is 0
                                xor_rax()
                                leave()
                                ret()
        fi: fi + 1
    if has_vm is 0
        emit_used()
    # pass S5: the canary stub rides even when the program ships
    # its own runtime (has_vm), because private frames can appear
    # in either shape
    if can_used is 1
        emit_canary_fail()
    if need_priv is 1
        emit_crash_handler()
    warn_unused()
    dce()
    stub_diet()
    dce_stores()
    dce_litter()
    dce_globals()
stub_diet:
    if had_err is 1
        return
    if want_args is 0
        return
    # a private program's exit walk anchors on g_argv, and its crash
    # handlers are referenced only by the sigaction install - the
    # diet must not touch either
    if need_priv is 1
        return
    sd_live: 0
    sd_i: 0
    as long as sd_i < _sov_list_len(patch_kind)
        sd_at2: _sov_list_get(patch_at, sd_i)
        if sd_at2 >= 45
            sd_k: _sov_list_get(patch_kind, sd_i)
            if same(sd_k, "glob") is 1
                sd_v: _sov_list_get(patch_val, sd_i)
                if same(sd_v, "g_argc") is 1
                    sd_live: 1
                if same(sd_v, "g_argv") is 1
                    sd_live: 1
            if same(sd_k, "grel") is 1
                sd_v: _sov_list_get(patch_val, sd_i)
                if same(sd_v, "g_argc") is 1
                    sd_live: 1
                if same(sd_v, "g_argv") is 1
                    sd_live: 1
        sd_i: sd_i + 1
    if sd_live is 1
        return
    sd_cut_at: 0
    sd_cut: 45
    if main_params_n > 0
        sd_cut_at: 19
        sd_cut: 26
    sd_na: _sov_list_new()
    sd_nk: _sov_list_new()
    sd_nv: _sov_list_new()
    sd_nl: _sov_list_new()
    sd_i: 0
    as long as sd_i < _sov_list_len(patch_at)
        sd_at: _sov_list_get(patch_at, sd_i)
        if sd_at < sd_cut_at
            sd_na: _sov_list_add(sd_na, sd_at)
            sd_nk: _sov_list_add(sd_nk, _sov_list_get(patch_kind, sd_i))
            sd_nv: _sov_list_add(sd_nv, _sov_list_get(patch_val, sd_i))
            sd_nl: _sov_list_add(sd_nl, _sov_list_get(patch_line, sd_i))
        if not
            if sd_at >= 45
                sd_na: _sov_list_add(sd_na, sd_at - sd_cut)
                sd_nk: _sov_list_add(sd_nk, _sov_list_get(patch_kind, sd_i))
                sd_nv: _sov_list_add(sd_nv, _sov_list_get(patch_val, sd_i))
                sd_nl: _sov_list_add(sd_nl, _sov_list_get(patch_line, sd_i))
        sd_i: sd_i + 1
    patch_at: sd_na
    patch_kind: sd_nk
    patch_val: sd_nv
    patch_line: sd_nl
    sd_no: _sov_list_new()
    sd_pos: 0
    as long as sd_pos < _sov_list_len(oc)
        if sd_pos is sd_cut_at
            sd_pos: sd_pos + sd_cut
        if not
            sd_no: _sov_list_add(sd_no, _sov_list_get(oc, sd_pos))
            sd_pos: sd_pos + 1
    oc: sd_no
    sd_i: 0
    as long as sd_i < _sov_list_len(fn_offs)
        fn_offs: _sov_list_set(fn_offs, sd_i, _sov_list_get(fn_offs, sd_i) - sd_cut)
        sd_i: sd_i + 1
    want_args: 0
# Pass 105: a global whose every surviving reference is a plain
# store_glob (mov [rip],rax - 48 89 05 <rel32>) is write-only: no load,
# compare or add-to-memory ever observes the value. Paint the store
# bytes with one-byte nops IN PLACE - raw branch displacements (rel8
# and post-relaxation rel32) are baked into the byte stream and must
# not move - and drop the store's grel patch so dce_globals collects
# the 8-byte name. Every other reference shape (loads 48 8b .., movabs
# "glob" forms, lea forms, anything else) counts as a read and
# protects the name.
poke8 p off v:
    x: v
    i: 0
    as long as i < 8
        b: x % 256
        if b < 0
            b: b + 256
        dummy: _sov_set_byte(p, off + i, b)
        x: x / 256
        i: i + 1
write_elf path:
    if had_err is 1
        return
    clen: _sov_list_len(oc)
    sl: _sov_buf_len(strb)
    str_off: clen
    if _sov_list_len(glob_names) > 0
        as long as str_off % 8 is not 0
            oc: _sov_list_add(oc, 0)
            str_off: str_off + 1
            clen: clen + 1
    glob_off: clen + sl
    pad: _sov_list_len(glob_names) * 8
    hdr: 200
    # pass S3: __TEXT is headers + code, READ+EXECUTE only. __DATA
    # starts on the page after the code, READ+WRITE, never
    # executable, and holds the literals first (they are data: a
    # user wipe writes them at any moment) then the globals. the
    # reserved-dword rider is gone with them.
    dfoff: hdr + clen
    as long as dfoff % 4096 is not 0
        dfoff: dfoff + 1
    sl8: sl
    as long as sl8 % 8 is not 0
        sl8: sl8 + 1
    str_off: dfoff - hdr
    glob_off: dfoff + sl8 - hdr
    pad: _sov_list_len(glob_names) * 8
    # pass S7: count the absolute qwords for the slide table. It
    # sits after the globals, so no address above it moves.
    rel_n: 0
    rel_at: _sov_list_new()
    rc_i: 0
    as long as rc_i < _sov_list_len(patch_at)
        rk: _sov_list_get(patch_kind, rc_i)
        if same(rk, "fnaddr") is 1
            rel_n: rel_n + 1
        if same(rk, "str") is 1
            rel_n: rel_n + 1
        if same(rk, "glob") is 1
            rel_n: rel_n + 1
        if same(rk, "gwstr_a") is 1
            rel_n: rel_n + 1
        if same(rk, "gwipe_a") is 1
            rel_n: rel_n + 1
        if same(rk, "sbss") is 1
            rel_n: rel_n + 1
        rc_i: rc_i + 1
    relsz: 8 + rel_n * 8
    filesz: dfoff + sl8 + pad + relsz
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    poke4(flat, 0, 4277009103)
    poke4(flat, 4, 16777223)
    poke4(flat, 8, 3)
    poke4(flat, 12, 2)
    # no __PAGEZERO: it only reserves the low 4GB for NULL-page
    # hardening (filesz 0); unmapped memory faults the same way, so a
    # single-file minimal Mach-O does not need it.
    poke4(flat, 16, 3)
    poke4(flat, 20, 168)
    poke4(flat, 24, 2097153)
    poke4(flat, 32, 25)
    poke4(flat, 36, 72)
    dummy: _sov_set_byte(flat, 40, 95)
    dummy: _sov_set_byte(flat, 41, 95)
    dummy: _sov_set_byte(flat, 42, 84)
    dummy: _sov_set_byte(flat, 43, 69)
    dummy: _sov_set_byte(flat, 44, 88)
    dummy: _sov_set_byte(flat, 45, 84)
    # __TEXT: headers + code, READ+EXECUTE, never writable
    poke8(flat, 56, 4294967296)
    poke8(flat, 64, dfoff)
    poke8(flat, 80, hdr + clen)
    poke4(flat, 88, 5)
    poke4(flat, 92, 5)
    # __DATA: literals + globals + the arena's blank tail,
    # READ+WRITE, never executable
    poke4(flat, 104, 25)
    poke4(flat, 108, 72)
    dummy: _sov_set_byte(flat, 112, 95)
    dummy: _sov_set_byte(flat, 113, 95)
    dummy: _sov_set_byte(flat, 114, 68)
    dummy: _sov_set_byte(flat, 115, 65)
    dummy: _sov_set_byte(flat, 116, 84)
    dummy: _sov_set_byte(flat, 117, 65)
    poke8(flat, 128, 4294967296 + dfoff)
    poke8(flat, 136, sl8 + pad + relsz + 65536)
    poke8(flat, 144, dfoff)
    poke8(flat, 152, sl8 + pad + relsz)
    poke4(flat, 160, 3)
    poke4(flat, 164, 3)
    # with no start stub, main itself is the entry point
    # pass S7: thin or not, offset 0 now holds a start block - the
    # walk, then the jump - so the entry is always the top of code
    moff: 0
    poke4(flat, 176, 2147483688)
    poke4(flat, 180, 24)
    poke8(flat, 184, hdr + moff)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, hdr + i, _sov_list_get(oc, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, hdr + str_off + si, _sov_buf_at(strb, si))
        si: si + 1
    str_addr: 4294967296 + hdr + str_off
    glob_addr: 4294967296 + hdr + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_val, i)
        if same(kind, "rel") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(fn_offs, fi)
                rel: tgt - (at + 4)
                poke4(flat, hdr + at, rel)
            if not
                print "Error: no such task"
                _sov_print(val)
                print _sov_list_get(patch_line, i)
                had_err: 1
        if same(kind, "fnaddr") is 1
            fi: idx(fn_names, val)
            if fi > 0 - 1
                poke8(flat, hdr + at, 4294967296 + hdr + _sov_list_get(fn_offs, fi))
            if not
                print "Error: no such task"
                _sov_print(val)
                had_err: 1
        if same(kind, "str") is 1
            poke8(flat, hdr + at, str_addr + val)
        if same(kind, "str32") is 1
            poke4(flat, hdr + at, str_addr + val)
        if same(kind, "ripstr") is 1
            poke4(flat, hdr + at, str_off + val - at - 4)
        if same(kind, "grel") is 1
            gx: idx(glob_names, val)
            poke4(flat, hdr + at, glob_off + gx * 8 - at - 4)
        if same(kind, "gwstr_a") is 1
            poke8(flat, hdr + at, str_addr)
        if same(kind, "gwstr_n") is 1
            poke4(flat, hdr + at, (sl + 7) / 8)
        if same(kind, "gwipe_a") is 1
            poke8(flat, hdr + at, glob_addr)
        if same(kind, "gwipe_n") is 1
            poke4(flat, hdr + at, _sov_list_len(glob_names))
        if same(kind, "glob") is 1
            gx: idx(glob_names, val)
            poke8(flat, hdr + at, glob_addr + gx * 8)
        if same(kind, "rel_a") is 1
            poke8(flat, hdr + at, 4294967296 + hdr + glob_off + pad)
        if same(kind, "rel_n") is 1
            poke4(flat, hdr + at, rel_n)
        if same(kind, "rel_l") is 1
            poke8(flat, hdr + at, dfoff)
        if same(kind, "fnaddr") is 1
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "str") is 1
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "glob") is 1
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "gwstr_a") is 1
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "gwipe_a") is 1
            rel_at: _sov_list_add(rel_at, at)
        if same(kind, "sbss") is 1
            rel_at: _sov_list_add(rel_at, at)
        i: i + 1
    if had_err is 1
        return
    # pass S7: the table itself - a count qword, then one link-time
    # absolute per entry; _start adds the slide to each before main
    poke8(flat, hdr + glob_off + pad, rel_n)
    ri: 0
    as long as ri < rel_n
        poke8(flat, hdr + glob_off + pad + 8 + ri * 8, hdr + _sov_list_get(rel_at, ri))
        ri: ri + 1
    # g_slide carries its own link address until the walk reads it
    gsx: idx(glob_names, "g_slide")
    if gsx > 0 - 1
        poke8(flat, hdr + glob_off + gsx * 8, 4294967296 + hdr + glob_off + gsx * 8)
    w: _sov_write_n(path, flat, filesz)
    if w is 0
        print "Error: cannot write output (is it running?)"
        fail()
    if need_priv is 1
        # pass 140: a private program's binary carries its secrets -
        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
main argc argv:
    # remember where this compiler lives, so its library and runtime
    # are found no matter which folder you run it from
    self_dir: dirname(tidy_path(peek_ptr(argv, 0)))
    if argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail()
    inf: blank
    outf: blank
    i: 1
    as long as i < argc
        arg: peek_ptr(argv, i)
        if same(arg, "--bare") is 1
            bare_mode: 1
        if not
            if same(arg, "-o") is 1
                i: i + 1
                if i < argc
                    outf: peek_ptr(argv, i)
            if not
                if same(arg, "build") is 0
                    inf: arg
        i: i + 1
    if length(inf) is 0
        print "Error: no input"
        fail()
    if length(outf) is 0
        d: look(inf, ".sov")
        if d > 0 - 1
            outf: cut(inf, 0, d)
        if not
            outf: join(inf, ".out")
    print "Compiling"
    _sov_print(inf)
    src: load_file(inf)
    if src is 0
        print "Error: cannot read input"
        fail()
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    src: join(join("# pad line so main is not first", nl), src)
    used_libs: blank
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    need: 0
    mmap_sz: 12582912
    if look(src, "_sov_list") > 0 - 1
        need: 1
    if look(src, "load_file") > 0 - 1
        need: 1
    if look(src, "_sov_buf") > 0 - 1
        need: 1
    if look(src, "_sov_alloc") > 0 - 1
        need: 1
    if look(src, "_sov_set_byte") > 0 - 1
        need: 1
    if look(src, "peek_byte") > 0 - 1
        need: 1
    if look(src, "poke_byte") > 0 - 1
        need: 1
    rt: blank
    if bare_mode is 1
        need: 0
    if need is 1
        mmap_sz: 1073741824
        rt: load_file("runtime.sov")
        if rt is 0
            rt: load_file("linux/runtime.sov")
        if rt is 0
            rt: load_file(join(self_dir, "/runtime.sov"))
        if rt is 0
            rt: load_file(join(self_dir, "/../runtime.sov"))
        if rt is 0
            print "Error: cannot read runtime"
            fail()
        # macOS has no openat: the runtime's open becomes plain
        # open, which _sov_macnum maps to the Mac's open (5).
        rt: repl(rt, "syscall(257, 0 - 100, path, flags, 420, 0, 0)", "syscall(2, path, flags, 420, 0, 0)")
    src_base: 1
    if length(rt) > 0
        src_base: src_base + _sov_list_len(lines_of(rt))
    if length(extra) > 0
        src_base: src_base + _sov_list_len(lines_of(extra))
    nl: _sov_alloc(2)
    dummy: _sov_set_byte(nl, 0, 10)
    dummy: _sov_set_byte(nl, 1, 0)
    all: join(rt, nl)
    src_base: src_base + 1
    all: join(all, src)
    compile(all)
    write_elf(outf)
    if had_err is 1
        fail()
    print "Wrote"
    _sov_print(outf)
