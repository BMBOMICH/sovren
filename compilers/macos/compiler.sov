# pass S6: the crash path wipes. a private build installs handlers
# for the fatal signals before main runs; each handler says crash,
# runs the same register-only wipe the exit walk runs, and exits
# 100 + signal - a SIGSEGV death leaves exit 111, not a dump.
# BSD sigaction has no SA_RESTORER: the kernel owns the return
# trampoline, and this handler exits anyway, so there = no
# sigreturn stub to emit
emit_crash_handler:
    cwns: _sov_list_new()
    cwns: _sov_list_add(cwns, "_sov_cw_4")
    cwns: _sov_list_add(cwns, "_sov_cw_6")
    cwns: _sov_list_add(cwns, "_sov_cw_7")
    cwns: _sov_list_add(cwns, "_sov_cw_8")
    cwns: _sov_list_add(cwns, "_sov_cw_11")
    cwvs: _sov_list_new()
    cwvs: _sov_list_add(cwvs, 4)
    cwvs: _sov_list_add(cwvs, 6)
    cwvs: _sov_list_add(cwvs, 7)
    cwvs: _sov_list_add(cwvs, 8)
    cwvs: _sov_list_add(cwvs, 11)
    chi: 0
    as long as chi < 5
        sg2: _sov_list_get(cwns, chi)
        sgv: _sov_list_get(cwvs, chi)
        task_names: _sov_list_add(task_names, sg2)
        task_at: _sov_list_add(task_at, here())
        emit_write_lit("crash\n")
        emit_stack_wipe
        # exit(100 + signal), set fresh after the register wipe
        put_in_program(191)
        put_4_bytes(100 + sgv)
        rax_mac(60)
        ask_kernel
        chi: chi + 1

emit_crash_install:
    # the bsd act = 32 bytes on the stack: handler, sa_mask
    # (sixteen zero bytes), sa_flags zero. pushed in reverse so
    # the handler slot sits at [rsp]; the struct = spent inside
    # the syscall that follows, and the pushes are their own
    # reader as far as the dead-store passes care
    bytes:
        106
        0
        106
        0
        106
        0
        72
        184
    cah: here()
    put_8_bytes(0)
    later_fill(cah, "task_address", "_sov_cw_4")
    put_in_program(80)
    # sigaction(sig, &act, 0) for ill, abrt, bus, fpe, segv
    csi: 0
    csigs: _sov_list_new()
    csigs: _sov_list_add(csigs, 4)
    csigs: _sov_list_add(csigs, 6)
    csigs: _sov_list_add(csigs, 7)
    csigs: _sov_list_add(csigs, 8)
    csigs: _sov_list_add(csigs, 11)
    as long as csi < 5
        sg: _sov_list_get(csigs, csi)
        # the handler slot at [rsp] = rewritten for this signal
        bytes:
            72
