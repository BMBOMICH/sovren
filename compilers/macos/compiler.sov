emit_alloc:
    fn_names: _sov_list_add(fn_names, "_sov_alloc")
    fn_offs: _sov_list_add(fn_offs, here())
    if has_vm is 0
        emit(83)
        emit(72)
        emit(137)
        emit(251)
        emit(72)
        emit(141)
        emit(179)
        emit4(2097160)
        rdi_imm(0)
