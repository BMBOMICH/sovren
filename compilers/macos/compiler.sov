# pass S7: the relocation walk. The kernel may land this image
# anywhere, so before the first absolute address runs, every absolute
# qword in the code gets the slide added. g_slide holds its own link
# address at link time; the lea below finds where it really sits and
# the difference is the slide.
emit_pie_walk:
    if idx(glob_names, "g_slide") is 0 - 1
        glob_names: _sov_list_add(glob_names, "g_slide")
    emit(87)
    emit(86)
    # rax = the stored link-time self pointer
    emit(72)
    emit(139)
    emit(5)
    pw0: here()
    emit4(0)
    addp(pw0, "grel", "g_slide")
    # rdx = where the slot really is now
    emit(72)
    emit(141)
    emit(21)
    pw1: here()
    emit4(0)
    addp(pw1, "grel", "g_slide")
    # rdx = actual - link = the slide
    emit(72)
    emit(41)
    emit(194)
    # zero slide means the kernel chose the link address: skip all
    # of it, both mprotects included (116 is jz, not jnz)
    emit(116)
    emit(102)
    # the slide rides rbx
    emit(72)
    emit(137)
    emit(211)
    # r8 = runtime base = 0x100000000 + slide. The base does not fit
    # an imm32 the way linux's 4MB does, so it rides a wide mov
    emit(73)
    emit(184)
    emit8(4294967296)
    emit(73)
    emit(1)
    emit(216)
    emit(76)
    emit(137)
    emit(199)
    # the mprotect span: just the __TEXT piece, headers + code, so
    # __DATA keeps its READ+WRITE after the restore
    emit(72)
    emit(190)
    pwl: here()
    emit8(0)
    addp(pwl, "rel_l", 0)
    emit(75)
    emit(137)
    emit(241)
    emit(186)
    emit4(7)
    # mprotect is BSD 74 with the class bit riding: 0x200004A
    emit(184)
    emit4(33554506)
    sysc_raw()
    # the count loads after: the syscall eats rcx
    emit(185)
    pw2: here()
    emit4(0)
    addp(pw2, "rel_n", 0)
    emit(73)
    emit(186)
    pw3: here()
    emit8(0)
    addp(pw3, "rel_a", 0)
    # the table pointer is link-time; the slide makes it live, so
    # the walk owns no unrelocated absolute of its own
    emit(73)
    emit(1)
    emit(218)
    emit(73)
    emit(131)
    emit(194)
    emit(8)
    # zero entries must not enter the loop: the do-while shape would
    # run its body once
    emit(227)
    emit(17)
    # rsi = [r10] + r8; add slide to [rsi]
    emit(73)
    emit(139)
    emit(50)
    emit(76)
    emit(1)
    emit(198)
    emit(72)
    emit(1)
    emit(30)
    emit(73)
    emit(131)
    emit(194)
    emit(8)
    emit(255)
    emit(201)
    emit(117)
    emit(239)
    # __TEXT back to READ+EXECUTE
    emit(76)
    emit(137)
    emit(206)
    emit(186)
    emit4(5)
    emit(184)
    emit4(33554506)
    sysc_raw()
    emit(94)
    emit(95)
    return 0

