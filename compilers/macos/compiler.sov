emit_stack_wipe:
    # pass 139: the heap, first. heap_ptr = the program's own bump
    # frontier (its store survives every diet); every byte below it
    # down to the mmap base was allocated by the program, and a
    # private program that never called secret_die left it all in
    # mapped memory at exit. the walk finds the base itself:
    # mprotect probing downward - the bottom of the heap mapping
    # refuses, everything inside grants and takes the stosq. guard:
    # heap_ptr zero means no heap ever started.
    if idx(global_names, "heap_ptr") > 0 - 1
        bytes:
