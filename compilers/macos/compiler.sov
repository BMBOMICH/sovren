    emit(255)
    emit(255)
    emit(255)
    emit(255)
    emit(77)
    emit(49)
    emit(201)
    sysc_raw()
    emit(72)
    emit(5)
    emit4(2097151)
    emit(72)
    emit(37)
    emit(0)
    emit(0)
    emit(224)
    emit(255)
    emit(80)
    emit(72)
    emit(137)
    emit(199)
    emit(190)
    emit4(n)
