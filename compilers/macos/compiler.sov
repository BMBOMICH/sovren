# pass S7: the relocation walk. The kernel may land this image
# anywhere, so before the first absolute address runs, every absolute
# qword in the code gets the slide added. g_slide holds its own link
# address at link time; the lea below finds where it really sits and
# the difference = the slide.
emit_pie_walk:
    if idx(global_names, "g_slide") = 0 - 1
        global_names: _sov_list_add(global_names, "g_slide")
    bytes:
        87
        86
    # rax = the stored link-time self pointer
    bytes:
        72
        139
        5
    pw0: here()
    put_4_bytes(0)
    later_fill(pw0, "grel", "g_slide")
    # rdx = where the slot really = now
    bytes:
        72
        141
        21
    pw1: here()
    put_4_bytes(0)
    later_fill(pw1, "grel", "g_slide")
    # rdx = actual - link = the slide
    bytes:
        72
        41
        194
    # zero slide means the kernel chose the link address: skip all
    # of it, both mprotects included (116 = jz, not jnz)
    bytes:
        116
        102
    # the slide rides rbx
    bytes:
        72
        137
        211
    # r8 = runtime base = 0x100000000 + slide. The base does not fit
    # an imm32 the way linux's 4MB does, so it rides a wide mov
    bytes:
        73
        184
    put_8_bytes(4294967296)
    bytes:
        73
        1
        216
        76
        137
        199
    # the mprotect span: just the __TEXT piece, headers + code, so
    # __DATA keeps its READ+WRITE after the restore
    bytes:
        72
        190
    pwl: here()
    put_8_bytes(0)
    later_fill(pwl, "rel_l", 0)
    bytes:
        75
        137
        241
        186
    put_4_bytes(7)
    # mprotect = BSD 74 with the class bit riding: 0x200004A
    put_in_program(184)
    put_4_bytes(33554506)
    sysc_raw
    # the count loads after: the syscall eats rcx
    put_in_program(185)
    pw2: here()
    put_4_bytes(0)
    later_fill(pw2, "rel_n", 0)
    bytes:
        73
        186
    pw3: here()
    put_8_bytes(0)
    later_fill(pw3, "rel_a", 0)
    # the table pointer = link-time; the slide makes it live, so
    # the walk owns no unrelocated absolute of its own
    bytes:
        73
        1
        218
        73
        131
        194
        8
    # zero entries must not enter the loop: the do-while shape would
    # run its body once
    bytes:
        227
        17
    # rsi = [r10] + r8; add slide to [rsi]
    bytes:
        73
        139
        50
        76
        1
        198
        72
        1
        30
        73
        131
        194
        8
        255
        201
        117
        239
    # __TEXT back to READ+EXECUTE
    bytes:
        76
        137
        206
        186
    put_4_bytes(5)
    put_in_program(184)
    put_4_bytes(33554506)
    sysc_raw
    bytes:
        94
        95
    return 0

