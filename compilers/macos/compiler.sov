            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "str") = 1
            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "glob") = 1
            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "gwstr_a") = 1
            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "gwipe_a") = 1
            reloc_at: _sov_list_add(reloc_at, at)
        if same(kind, "sbss") = 1
            reloc_at: _sov_list_add(reloc_at, at)
        i: i + 1
    if saw_error = 1
        return
    # pass S7: the table itself - a count qword, then one link-time
    # absolute per entry; _start adds the slide to each before main
    poke8(flat, hdr + glob_off + pad, rel_n)
    ri: 0
    as long as ri < rel_n
        poke8(flat, hdr + glob_off + pad + 8 + ri * 8, hdr + _sov_list_get(reloc_at, ri))
        ri: ri + 1
    # g_slide carries its own link address until the walk reads it
    gsx: idx(global_names, "g_slide")
    if gsx > 0 - 1
        poke8(flat, hdr + glob_off + gsx * 8, 4294967296 + hdr + glob_off + gsx * 8)
    w: _sov_write_n(path, flat, filesz)
    if w = 0
        print "Error: cannot write output (is it running?)"
        fail
    if needs_private = 1
        # pass 140: a private program's binary carries its secrets -
        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
# remember where this compiler lives, so its library and runtime
# are found no matter which folder you run it from
start:
    compiler_folder: dirname(tidy_path(peek_ptr(g_argv, 0)))
    if g_argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail
    in_file: blank
    out_file: blank
    i: 1
    as long as i < g_argc
        arg: peek_ptr(g_argv, i)
        if same(arg, "--bare") = 1
            no_runtime: 1
        if not
            if same(arg, "-o") = 1
                i: i + 1
                if i < g_argc
                    out_file: peek_ptr(g_argv, i)
            if not
                if same(arg, "build") = 0
                    in_file: arg
        i: i + 1
    if length(in_file) = 0
        print "Error: no input"
        fail
    if length(out_file) = 0
        if holds(in_file, ".sov") = 1
            out_file: cut(in_file, 0, look(in_file, ".sov"))
        if not
            out_file: join(in_file, ".out")
    file_name: in_file
    print "Compiling" : in_file
    src: load_file(in_file)
    if src = 0
        print "Error: cannot read input"
        fail
    newline: "\n"
    src: join("# skip this line\n", src)
    libraries: blank
    src: expand_use_lines(src)
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    heap_size: 12582912
    needs_runtime: uses_runtime(src)
    runtime: blank
    if no_runtime = 1
        needs_runtime: 0
    if needs_runtime = 1
        heap_size: 1073741824
        runtime: load_file("runtime.sov")
        if runtime = 0
            runtime: load_file("linux/runtime.sov")
        if runtime = 0
            runtime: load_file(join(compiler_folder, "/runtime.sov"))
        if runtime = 0
            runtime: load_file(join(compiler_folder, "/../runtime.sov"))
        if runtime = 0
            runtime: load_file(join(dirname(dirname(compiler_folder)), "/runtime.sov"))
        if runtime = 0
            print "Error: cannot read runtime"
            fail
        # macOS has no openat: the runtime's open becomes plain
        # open, which _sov_macnum maps to the Mac's open (5).
        runtime: repl(runtime, "syscall(257, 0 - 100, path, flags, 420, 0, 0)", "syscall(2, path, flags, 420, 0, 0)")
        # the macos thread bridge: clone becomes bsdthread_create,
        # futex becomes a spin on the status word. fork stays, so a
        # refused create still has a real process fallback.
        runtime: repl(runtime, "syscall(56, e, top, 12032, 0, 0, 0)", "thread_create(e, top)")
        runtime: repl(runtime, "syscall(202, cb, 1, 1, 0, 0, 0)", "thread_wake(cb)")
        runtime: repl(runtime, "syscall(202, base, 1, 1, 0, 0, 0)", "thread_wake(base)")
        runtime: repl(runtime, "syscall(202, h, 0, s, 0, 0, 0)", "thread_wait(h, s)")
    first_user_line: 1
    if length(runtime) > 0
        first_user_line: first_user_line + _sov_list_len(lines_of(runtime))
    if length(extra) > 0
        first_user_line: first_user_line + _sov_list_len(lines_of(extra))
    newline: "\n"
    all: join(runtime, newline)
    first_user_line: first_user_line + 1
    if needs_runtime = 1
        # the runtime's thread paths end themselves through this
        # injected task; on macos a thread ends with the exit
        # syscall (60 = exit on the Mac's x86_64 table)
        all: join(all, newline)
        all: join(all, join("_sov_thread_exit:", newline))
        all: join(all, join("    syscall(60, 0, 0, 0, 0, 0, 0)", newline))
        all: join(all, join("    return 0 - 1", newline))
        first_user_line: first_user_line + 4
    all: join(all, src)
    compile(all)
    write_program(out_file)
    if saw_error = 1
        fail
    print "Wrote" : out_file
start
