    emit(72)
    emit(129)
    emit(255)
    emit4(2097152)
    sm: jb()
    emit(83)
    emit(72)
    emit(137)
    emit(251)
    emit(72)
    emit(141)
    emit(179)
    emit4(2097152)
    rdi_imm(0)
    emit(72)
