emit_macnum:
    # macOS numbers its syscalls differently from Linux and marks
    # them with the class bit 0x2000000. This turns the Linux number
    # in eax into the Mac one. Every syscall goes through here.
    task_names: _sov_list_add(task_names, "_sov_macnum")
    task_at: _sov_list_add(task_at, here())
