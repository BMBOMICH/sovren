# Expanded compact source to match current shared front end.
# Sovren to CIL PE/CLI assembly emitter.
# Emits a real PE32 Mono/.NET assembly with a CLR header, metadata streams,
# MethodDef entry token, and a tiny IL Main body returning the result of a
# deterministic static command-subset evaluator: arithmetic, functions/calls,
# locals/reassignment, inline if/if-not, and inline while loops.

use arg
use file
use sys
use num

buf: 0
src: 0
srclen: 0
pv_list: 0
pg_src: 0
pg_len: 0

at8 o v:
    poke_byte(buf, o, v & 255)
    return 0

at16 o v:
    poke_byte(buf, o, v & 255)
    poke_byte(buf, o + 1, (v / 256) & 255)
    return 0

at32 o v:
    poke_byte(buf, o, v & 255)
    poke_byte(buf, o + 1, (v / 256) & 255)
    poke_byte(buf, o + 2, (v / 65536) & 255)
    poke_byte(buf, o + 3, (v / 16777216) & 255)
    return 0

name8 o s:
    i: 0
    as long as i < 8
        if i < str_len(s)
            at8(o + i, peek_byte(s, i))
        if not
            at8(o + i, 0)
        i: i + 1
    return 0

put_text o s:
    i: 0
    as long as i < str_len(s)
        at8(o + i, peek_byte(s, i))
        i: i + 1
    at8(o + str_len(s), 0)
    return 0

is_dig c:
    if c >= 48
        if c <= 57
            return 1
    return 0

is_sp c:
    if c is 32
        return 1
    if c is 9
        return 1
    if c is 10
        return 1
    if c is 13
        return 1
    return 0

find_return:
    p: str_find(src, "return ")
    if p >= 0
        return p + 6
    return 0 - 1

xp: 0
xe: 0

xskip:
    as long as xp < xe
        if is_sp(peek_byte(src, xp)) is 1
            xp: xp + 1
        if not
            leave
    return 0

xfac:
    xskip()
    if xp >= xe
        return 0
    c: peek_byte(src, xp)
    if c is 40
        xp: xp + 1
        v: xexpr()
        xskip()
        if xp < xe
            if peek_byte(src, xp) is 41
                xp: xp + 1
        return v
    if c is 45
        xp: xp + 1
        return 0 - xfac()
    if is_dig(c) is 1
        v2: 0
        as long as xp < xe
            d: peek_byte(src, xp)
            if is_dig(d) is 1
                v2: v2 * 10 + d - 48
                xp: xp + 1
            if not
                leave
        return v2
    if is_alfa(c) is 1
        st: xp
        as long as xp < xe
            if is_aln(peek_byte(src, xp)) is 1
                xp: xp + 1
            if not
                leave
        nm: str_cut(src, st, xp)
        xskip()
        if xp < xe
            if peek_byte(src, xp) is 40
                xp: xp + 1
                args: _sov_list_new()
                as long as xp < xe
                    xskip()
                    if xp < xe
                        if peek_byte(src, xp) is 41
                            xp: xp + 1
                            leave
                    av: xexpr()
                    args: _sov_list_add(args, av)
                    xskip()
                    if xp < xe
                        if peek_byte(src, xp) is 44
                            xp: xp + 1
                ss: src
                sl: srclen
                sxp: xp
                sxe: xe
                cv: eval_fn_args(nm, args)
                src: ss
                srclen: sl
                xp: sxp
                xe: sxe
                return cv
        return env_get(nm)
    xp: xp + 1
    return 0

xterm:
    v: xfac()
    as long as 1 is 1
        xskip()
        if xp >= xe
            return v
        c: peek_byte(src, xp)
        if c is not 42
            if c is not 47
                return v
        xp: xp + 1
        b: xfac()
        if c is 42
            v: v * b
        if c is 47
            if b is not 0
                v: v / b
    return v

xexpr:
    v: xterm()
    as long as 1 is 1
        xskip()
        if xp >= xe
            return v
        c: peek_byte(src, xp)
        if c is not 43
            if c is not 45
                return v
        xp: xp + 1
        b: xterm()
        if c is 43
            v: v + b
        if c is 45
            v: v - b
    return v

fn_names: 0
fn_params: 0
fn_bodies: 0
env_names: 0
env_vals: 0
ret_flag: 0
ret_val: 0
last_if_taken: 0

is_alfa c:
    if c >= 97
        if c <= 122
            return 1
    if c >= 65
        if c <= 90
            return 1
    if c is 95
        return 1
    return 0

is_aln c:
    if is_alfa(c) is 1
        return 1
    if is_dig(c) is 1
        return 1
    return 0

ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n
        if is_sp(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return str_cut(s, i, n)

rtrim s:
    n: str_len(s)
    as long as n > 0
        if is_sp(peek_byte(s, n - 1)) is 1
            n: n - 1
        if not
            leave
    return str_cut(s, 0, n)

trim s:
    return rtrim(ltrim(s))

starts s p:
    pn: str_len(p)
    if str_len(s) < pn
        return 0
    if str_eq(str_cut(s, 0, pn), p) is 1
        return 1
    return 0

word_end s a:
    n: str_len(s)
    i: a
    as long as i < n
        if is_aln(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return i

find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n
        if peek_byte(s, i) is c
            return i
        i: i + 1
    return 0 - 1

find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n
        if peek_byte(s, i) is 45
            if peek_byte(s, i + 1) is 62
                return i
        i: i + 1
    return 0 - 1

indent_of s:
    n: str_len(s)
    i: 0
    w: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 32
            w: w + 1
        if not
            if c is 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w

env_idx nm:
    i: 0
    as long as i < _sov_list_len(env_names)
        if str_eq(as text _sov_list_get(env_names, i), nm) is 1
            return i
        i: i + 1
    return 0 - 1

env_get nm:
    i: env_idx(nm)
    if i >= 0
        return _sov_list_get(env_vals, i)
    return 0

env_set nm v:
    i: env_idx(nm)
    if i >= 0
        env_vals: _sov_list_set(env_vals, i, v)
    if not
        env_names: _sov_list_add(env_names, nm)
        env_vals: _sov_list_add(env_vals, v)
    return 0

fn_idx nm:
    i: 0
    as long as i < _sov_list_len(fn_names)
        if str_eq(as text _sov_list_get(fn_names, i), nm) is 1
            return i
        i: i + 1
    return 0 - 1

expr_eval s:
    os: src
    ol: srclen
    oxp: xp
    oxe: xe
    src: s
    srclen: str_len(s)
    xp: 0
    xe: srclen
    v: xexpr()
    src: os
    srclen: ol
    xp: oxp
    xe: oxe
    return v

cond_eval cond:
    s: trim(cond)
    oi: 0 - 1
    op: ""
    step: 1
    i: 0
    as long as i < str_len(s)
        c: peek_byte(s, i)
        n: 0
        if i + 1 < str_len(s)
            n: peek_byte(s, i + 1)
        if c is 33
            if n is 61
                op: "ne"
            oi: i
            step: 2
            leave
        if c is 60
            op: "lt"
            oi: i
            step: 1
            if n is 61
                op: "le"
                step: 2
            leave
        if c is 62
            op: "gt"
            oi: i
            step: 1
            if n is 61
                op: "ge"
                step: 2
            leave
        if c is 61
            op: "eq"
            oi: i
            step: 1
            leave
        i: i + 1
    if oi >= 0
        a: expr_eval(str_cut(s, 0, oi))
        b: expr_eval(str_cut(s, oi + step, str_len(s)))
        if str_eq(op, "eq") is 1
            if a is b
                return 1
        if str_eq(op, "ne") is 1
            if a is not b
                return 1
        if str_eq(op, "lt") is 1
            if a < b
                return 1
        if str_eq(op, "gt") is 1
            if a > b
                return 1
        if str_eq(op, "le") is 1
            if a <= b
                return 1
        if str_eq(op, "ge") is 1
            if a >= b
                return 1
        return 0
    if expr_eval(s) is not 0
        return 1
    return 0

eval_stmt_parts s:
    ts: trim(s)
    if starts(ts, "as long as ") is 1
        eval_stmt(ts)
        return 0
    if starts(ts, "if ") is 1
        eval_stmt(ts)
        return 0
    start: 0
    n: str_len(s)
    as long as start < n
        i: start
        found: 0
        as long as i + 1 < n
            if peek_byte(s, i) is 59
                if peek_byte(s, i + 1) is 59
                    found: 1
                    leave
            i: i + 1
        if found is 0
            i: n
        eval_stmt(str_cut(s, start, i))
        if ret_flag is 1
            return 0
        if found is 1
            start: i + 2
        if not
            start: n
    return 0

eval_stmt st:
    s: trim(st)
    if str_len(s) is 0
        return 0
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if starts(s, "as long as ") is 1
        arw: find_arrow(s)
        if arw < 0
            return 0
        cond: trim(str_cut(s, 11, arw))
        body: trim(str_cut(s, arw + 2, str_len(s)))
        guard: 0
        as long as cond_eval(cond) is 1
            eval_stmt_parts(body)
            if ret_flag is 1
                return 0
            guard: guard + 1
            if guard > 100000
                return 0
        return 0
    if str_eq(kw, "return") is 1
        ret_val: expr_eval(str_cut(s, w, str_len(s)))
        ret_flag: 1
        return 0
    if str_eq(kw, "if") is 1
        ar: find_arrow(s)
        if ar < 0
            return 0
        cond2: trim(str_cut(s, w, ar))
        body2: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond2, "not") is 1
            if last_if_taken is 0
                eval_stmt_parts(body2)
            last_if_taken: 0
            return 0
        last_if_taken: cond_eval(cond2)
        if last_if_taken is 1
            eval_stmt_parts(body2)
        return 0
    if str_eq(kw, "print") is 1
        pv_list: _sov_list_add(pv_list, expr_eval(str_cut(s, w, str_len(s))))
    col: find_ch(s, 58)
    if col > 0
        nm: trim(str_cut(s, 0, col))
        env_set(nm, expr_eval(str_cut(s, col + 1, str_len(s))))
        return 0
    return 0

eval_block body minind:
    n: str_len(body)
    i: 0
    as long as i < n
        e: i
        as long as e < n
            if peek_byte(body, e) is 10
                leave
            e: e + 1
        raw: str_cut(body, i, e)
        t: trim(raw)
        ind: indent_of(raw)
        j: e + 1
        blk: ""
        if str_len(t) > 0
            if peek_byte(t, 0) is not 35
                as long as j < n
                    ne: j
                    as long as ne < n
                        if peek_byte(body, ne) is 10
                            leave
                        ne: ne + 1
                    nr: str_cut(body, j, ne)
                    nt: trim(nr)
                    ni: indent_of(nr)
                    if str_len(nt) > 0
                        if peek_byte(nt, 0) is not 35
                            if ni <= ind
                                leave
                    blk: str_cat(blk, nr)
                    blk: str_cat(blk, "\n")
                    j: ne + 1
                if starts(t, "as long as ") is 1
                    arw: find_arrow(t)
                    if arw >= 0
                        cond: trim(str_cut(t, 11, arw))
                        inl: trim(str_cut(t, arw + 2, str_len(t)))
                        guard: 0
                        as long as cond_eval(cond) is 1
                            if str_len(inl) > 0
                                eval_stmt_parts(inl)
                            if ret_flag is 1
                                return 0
                            if str_len(blk) > 0
                                eval_block(blk, ind + 1)
                            if ret_flag is 1
                                return 0
                            guard: guard + 1
                            if guard > 100000
                                return 0
                        i: j
                    if arw < 0
                        eval_stmt_parts(t)
                        i: e + 1
                if not
                    if starts(t, "if ") is 1
                        ar: find_arrow(t)
                        if ar >= 0
                            cond2: trim(str_cut(t, 2, ar))
                            inl2: trim(str_cut(t, ar + 2, str_len(t)))
                            if str_eq(cond2, "not") is 1
                                if last_if_taken is 0
                                    if str_len(inl2) > 0
                                        eval_stmt_parts(inl2)
                                    if ret_flag is 1
                                        return 0
                                    if str_len(blk) > 0
                                        eval_block(blk, ind + 1)
                                last_if_taken: 0
                            if not
                                last_if_taken: cond_eval(cond2)
                                if last_if_taken is 1
                                    if str_len(inl2) > 0
                                        eval_stmt_parts(inl2)
                                    if ret_flag is 1
                                        return 0
                                    if str_len(blk) > 0
                                        eval_block(blk, ind + 1)
                            i: j
                        if ar < 0
                            eval_stmt_parts(t)
                            i: e + 1
                    if not
                        eval_stmt_parts(t)
                        i: e + 1
        if str_len(t) > 0
            if peek_byte(t, 0) is 35
                i: e + 1
        if str_len(t) is 0
            i: e + 1
        if ret_flag is 1
            return 0
    return 0

eval_body body:
    last_if_taken: 0
    eval_block(body, 0)
    return 0

bind_params ps args:
    p: trim(ps)
    ai: 0
    as long as str_len(p) > 0
        p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0
            leave
        nm: str_cut(p, 0, e)
        v: 0
        if ai < _sov_list_len(args)
            v: _sov_list_get(args, ai)
        env_set(nm, v)
        ai: ai + 1
        p: trim(str_cut(p, e, str_len(p)))
    return 0

find_fn_hdr nm:
    nlen: str_len(nm)
    if pg_len > nlen
        if str_starts(pg_src, nm) is 1
            cAfter: peek_byte(pg_src, nlen)
            if cAfter is 58
                return 0
            if cAfter is 32
                return 0
    pat1: str_cat("\n", str_cat(nm, ":"))
    if pg_len > 4096
        tail_off: pg_len - 4096
        tp: str_find(pg_src + tail_off, pat1)
        if tp >= 0
            return tail_off + tp + 1
    p: str_find(pg_src, pat1)
    if p >= 0
        return p + 1
    pat2: str_cat("\n", str_cat(nm, " "))
    if pg_len > 4096
        tail_off2: pg_len - 4096
        tp2: str_find(pg_src + tail_off2, pat2)
        if tp2 >= 0
            return tail_off2 + tp2 + 1
    p: str_find(pg_src, pat2)
    if p >= 0
        return p + 1
    return 0 - 1

load_fn nm:
    fi: fn_idx(nm)
    if fi >= 0
        return fi
    hp: find_fn_hdr(nm)
    if hp < 0
        fn_names: _sov_list_add(fn_names, nm)
        fn_params: _sov_list_add(fn_params, "")
        fn_bodies: _sov_list_add(fn_bodies, "")
        return 0 - 1
    e: hp
    as long as e < pg_len
        if peek_byte(pg_src, e) is 10
            leave
        e: e + 1
    raw: str_cut(pg_src, hp, e)
    t: trim(raw)
    if str_len(t) is 0
        return 0 - 1
    if peek_byte(t, str_len(t) - 1) is not 58
        return 0 - 1
    h: str_cut(t, 0, str_len(t) - 1)
    w: word_end(h, 0)
    ps: trim(str_cut(h, w, str_len(h)))
    b0: e + 1
    i: b0
    b1: b0
    as long as i < pg_len
        le: i
        as long as le < pg_len
            if peek_byte(pg_src, le) is 10
                leave
            le: le + 1
        if le > i
            c0: peek_byte(pg_src, i)
            if is_sp(c0) is 1
                b1: le + 1
            if is_sp(c0) is 0
                if c0 is not 35
                    leave
        i: le + 1
    fn_names: _sov_list_add(fn_names, nm)
    fn_params: _sov_list_add(fn_params, ps)
    fn_bodies: _sov_list_add(fn_bodies, str_cut(pg_src, b0, b1))
    return _sov_list_len(fn_names) - 1

eval_fn_args nm args:
    fi: load_fn(nm)
    if fi < 0
        return 0
    fbody: as text _sov_list_get(fn_bodies, fi)
    if str_len(fbody) is 0
        return 0
    if str_find(fbody, "return") < 0
        return 0
    oldn: env_names
    oldv: env_vals
    oldrf: ret_flag
    oldrv: ret_val
    oldif: last_if_taken
    env_names: _sov_list_new()
    env_vals: _sov_list_new()
    ret_flag: 0
    ret_val: 0
    last_if_taken: 0
    bind_params(as text _sov_list_get(fn_params, fi), args)
    eval_body(as text _sov_list_get(fn_bodies, fi))
    rv: ret_val
    env_names: oldn
    env_vals: oldv
    ret_flag: oldrf
    ret_val: oldrv
    last_if_taken: oldif
    return rv

parse_program:
    pg_src: src
    pg_len: srclen
    fn_names: _sov_list_new()
    fn_params: _sov_list_new()
    fn_bodies: _sov_list_new()
    return 0

parse_return:
    parse_program()
    if load_fn("main") >= 0
        args: _sov_list_new()
        return eval_fn_args("main", args)
    p: find_return()
    if p < 0
        return 0
    as long as p < srclen
        if is_sp(peek_byte(src, p)) is 1
            p: p + 1
        if not
            leave
    e: p
    as long as e < srclen
        c: peek_byte(src, e)
        if c is 10
            leave
        if c is 13
            leave
        if c is 59
            leave
        e: e + 1
    xp: p
    xe: e
    return xexpr()

emit_metadata:
    m: 592
    at32(m + 0, 1112167234)
    at16(m + 4, 1)
    at16(m + 6, 1)
    at32(m + 8, 0)
    at32(m + 12, 12)
    put_text(m + 16, "v4.0.30319")
    at16(m + 28, 0)
    at16(m + 30, 5)
    at32(m + 32, 108)
    at32(m + 36, 148)
    put_text(m + 40, "#~")
    at32(m + 48, 256)
    at32(m + 52, 72)
    put_text(m + 56, "#Strings")
    at32(m + 68, 356)
    at32(m + 72, us_len() * 2 + 3)
    put_text(m + 76, "#US")
    at32(m + 84, 332)
    at32(m + 88, 16)
    put_text(m + 92, "#GUID")
    at32(m + 104, 348)
    at32(m + 108, 5)
    put_text(m + 112, "#Blob")
    # #~ tables stream at file offset 700.
    t: 700
    at32(t + 0, 0)
    at8(t + 4, 2)
    at8(t + 5, 0)
    at8(t + 6, 0)
    at8(t + 7, 1)
    at32(t + 8, 71)
    at32(t + 12, 9)
    at32(t + 16, 0)
    at32(t + 20, 0)
    at32(t + 24, 1)
    at32(t + 28, 1)
    at32(t + 32, 2)
    at32(t + 36, 1)
    at32(t + 40, 1)
    at32(t + 44, 1)
    # Module row.
    at16(t + 48, 0)
    at16(t + 50, 1)
    at16(t + 52, 1)
    at16(t + 54, 0)
    at16(t + 56, 0)
    # TypeRef: [mscorlib]System.Object.
    at16(t + 58, 6)
    at16(t + 60, 16)
    at16(t + 62, 23)
    # TypeDef <Module>.
    at32(t + 64, 0)
    at16(t + 68, 30)
    at16(t + 70, 0)
    at16(t + 72, 0)
    at16(t + 74, 1)
    at16(t + 76, 1)
    # TypeDef Program extends TypeRef row 1.
    at32(t + 78, 1048577)
    at16(t + 82, 39)
    at16(t + 84, 0)
    at16(t + 86, 5)
    at16(t + 88, 1)
    at16(t + 90, 1)
    # MethodDef Main, RVA 0x2048, signature blob #1.
    at32(t + 92, 8264)
    at16(t + 96, 0)
    at16(t + 98, 22)
    at16(t + 100, 47)
    at16(t + 102, 1)
    at16(t + 104, 1)
    # Assembly SovrenMain.
    at32(t + 106, 32772)
    at16(t + 110, 1)
    at16(t + 112, 0)
    at16(t + 114, 0)
    at16(t + 116, 0)
    at32(t + 118, 0)
    at16(t + 122, 0)
    at16(t + 124, 52)
    at16(t + 126, 0)
    # AssemblyRef mscorlib v4.0.0.0.
    at16(t + 128, 4)
    at16(t + 130, 0)
    at16(t + 132, 0)
    at16(t + 134, 0)
    at32(t + 136, 0)
    at16(t + 140, 0)
    at16(t + 142, 63)
    at16(t + 144, 0)
    at16(t + 146, 0)
    # #Strings heap.
    s: 848
    at8(s, 0)
    put_text(s + 1, "SovrenMain.exe")
    put_text(s + 16, "Object")
    put_text(s + 23, "System")
    put_text(s + 30, "<Module>")
    put_text(s + 39, "Program")
    put_text(s + 47, "Main")
    put_text(s + 52, "SovrenMain")
    put_text(s + 63, "mscorlib")
    # #GUID heap.
    g: 924
    at8(g + 0, 0)
    at8(g + 1, 17)
    at8(g + 2, 34)
    at8(g + 3, 51)
    at8(g + 4, 68)
    at8(g + 5, 85)
    at8(g + 6, 102)
    at8(g + 7, 119)
    at8(g + 8, 136)
    at8(g + 9, 153)
    at8(g + 10, 170)
    at8(g + 11, 187)
    at8(g + 12, 204)
    at8(g + 13, 221)
    at8(g + 14, 238)
    at8(g + 15, 255)
    # #Blob heap: method sig default static, zero params, int32 return.
    b: 940
    at8(b + 0, 0)
    at8(b + 1, 3)
    at8(b + 2, 0)
    at8(b + 3, 0)
    at8(b + 4, 8)
    us_put(m, us_len())
    return 0

us_len:
    n: 0
    left: 292
    qi: 0
    as long as qi < _sov_list_len(pv_list)
        sl: str_len(num_text(_sov_list_get(pv_list, qi))) + 1
        if sl <= left
            n: n + sl
            left: left - sl
        qi: qi + 1
    return n

us_str q st:
    ci: 0
    as long as ci < str_len(st)
        at8(q, peek_byte(st, ci))
        at8(q + 1, 0)
        q: q + 2
        ci: ci + 1
    at8(q, 10)
    at8(q + 1, 0)
    return q + 2

us_put m budget:
    p: m + 356
    at8(p, 0)
    at8(p + 1, budget * 2 + 1)
    q: p + 2
    left: budget
    qi: 0
    as long as qi < _sov_list_len(pv_list)
        st: num_text(_sov_list_get(pv_list, qi))
        sl: str_len(st) + 1
        if sl <= left
            q: us_str(q, st)
            left: left - sl
        qi: qi + 1
    at8(q, 0)
    return 0

emit_pe rv:
    buf: _sov_alloc(1024)
    i: 0
    as long as i < 1024
        at8(i, 0)
        i: i + 1
    # DOS + PE/COFF headers.
    at8(0, 77)
    at8(1, 90)
    at32(60, 128)
    at8(128, 80)
    at8(129, 69)
    at8(130, 0)
    at8(131, 0)
    at16(132, 332)
    at16(134, 1)
    at32(136, 0)
    at32(140, 0)
    at32(144, 0)
    at16(148, 224)
    at16(150, 258)
    opt: 152
    at16(opt + 0, 267)
    at8(opt + 2, 8)
    at8(opt + 3, 0)
    at32(opt + 4, 512)
    at32(opt + 8, 0)
    at32(opt + 12, 0)
    at32(opt + 16, 0)
    at32(opt + 20, 8192)
    at32(opt + 24, 16384)
    at32(opt + 28, 4194304)
    at32(opt + 32, 8192)
    at32(opt + 36, 512)
    at16(opt + 40, 4)
    at16(opt + 42, 0)
    at16(opt + 44, 0)
    at16(opt + 46, 0)
    at16(opt + 48, 4)
    at16(opt + 50, 0)
    at32(opt + 52, 0)
    at32(opt + 56, 16384)
    at32(opt + 60, 512)
    at32(opt + 64, 0)
    at16(opt + 68, 3)
    at16(opt + 70, 0)
    at32(opt + 72, 1048576)
    at32(opt + 76, 4096)
    at32(opt + 80, 1048576)
    at32(opt + 84, 4096)
    at32(opt + 88, 0)
    at32(opt + 92, 16)
    # Data directory 14: CLR runtime header at RVA 0x2000.
    at32(opt + 96 + 14 * 8, 8192)
    at32(opt + 100 + 14 * 8, 72)
    sec: 376
    name8(sec, ".text")
    at32(sec + 8, 439 + us_len() * 2)
    at32(sec + 12, 8192)
    at32(sec + 16, 1024)
    at32(sec + 20, 512)
    at32(sec + 24, 0)
    at32(sec + 28, 0)
    at16(sec + 32, 0)
    at16(sec + 34, 0)
    at32(sec + 36, 1610612768)
    # IMAGE_COR20_HEADER at raw 0x200 / RVA 0x2000.
    c: 512
    at32(c + 0, 72)
    at16(c + 4, 2)
    at16(c + 6, 5)
    at32(c + 8, 8272)
    at32(c + 12, 359 + us_len() * 2)
    at32(c + 16, 1)
    at32(c + 20, 100663297)
    # Tiny IL method body at RVA 0x2048: ldc.i4 rv; ret.
    at8(584, 26)
    at8(585, 32)
    at32(586, rv)
    at8(590, 42)
    emit_metadata()
    return 1536

main:
    ac: arg_count()
    if ac < 2
        print "Usage: compiler src.sov -o out.exe"
        sys_exit(1)
    inp: as text arg_at(1)
    outp: "SovrenMain.exe"
    if ac is 3
        if str_eq(as text arg_at(1), "-o") is 0
            if str_eq(as text arg_at(2), "-o") is 0
                outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac
        if str_eq(as text arg_at(i), "-o") is 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not
            i: i + 1
    srclen: file_size(inp)
    src: file_read_all(inp)
    if src is 0
        print "cil-pe: cannot read input"
        sys_exit(1)
    pv_list: _sov_list_new()
    n: emit_pe(parse_return())
    file_write_bytes(outp, buf, n)
    print "cil-pe: wrote "
    print outp
    return 0
