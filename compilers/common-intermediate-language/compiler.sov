# Expanded compact source to match current shared front end.
# Sovren to CIL/IL source emitter.
# Emits ILAsm-style source for CLR/.NET-style runtimes: functions/calls,
# integer locals/reassignment, literal/numeric print, return, inline if/if-not,
# inline while loops, and literal repetition.

main:
    ac: arg_count()
    if ac < 2
        print "Usage: compiler src.sov -o out.il"
        sys_exit(1)
    srcp: as text arg_at(1)
    outp: "SovrenMain.il"
    if ac is 3
        if str_eq(as text arg_at(1), "-o") is 0
            if str_eq(as text arg_at(2), "-o") is 0
                outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac
        if str_eq(as text arg_at(i), "-o") is 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not
            i: i + 1
    compile_file(srcp)
    file_write_all(outp, il_out)
    print "cil: wrote "
    print outp
    return 0


use arg
use file
use string
use sys
use num

src: 0
il_out: ""
locals: 0
params: ""
labeln: 0
pending_if: 0
pending_end: ""
block_inds: 0
block_kinds: 0
block_a: 0
block_b: 0
block_n: 0
last_block_kind: ""
last_block_a: ""
last_block_b: ""

emit s:
    il_out: str_cat(il_out, s)
    return 0

emitln s:
    il_out: str_cat(il_out, s)
    il_out: str_cat(il_out, "\n")
    return 0

is_sp c:
    if c is 32
        return 1
    if c is 9
        return 1
    if c is 13
        return 1
    return 0

is_dig c:
    if c >= 48
        if c <= 57
            return 1
    return 0

is_alfa c:
    if c >= 97
        if c <= 122
            return 1
    if c >= 65
        if c <= 90
            return 1
    if c is 95
        return 1
    return 0

is_aln c:
    if is_alfa(c) is 1
        return 1
    if is_dig(c) is 1
        return 1
    return 0

ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n
        if is_sp(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return str_cut(s, i, n)

rtrim s:
    n: str_len(s)
    as long as n > 0
        if is_sp(peek_byte(s, n - 1)) is 1
            n: n - 1
        if not
            leave
    return str_cut(s, 0, n)

trim s:
    return rtrim(ltrim(s))

word_end s a:
    n: str_len(s)
    i: a
    as long as i < n
        if is_aln(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return i

find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n
        if peek_byte(s, i) is c
            return i
        i: i + 1
    return 0 - 1

find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n
        if peek_byte(s, i) is 45
            if peek_byte(s, i + 1) is 62
                return i
        i: i + 1
    return 0 - 1

starts s p:
    pn: str_len(p)
    if str_len(s) < pn
        return 0
    if str_eq(str_cut(s, 0, pn), p) is 1
        return 1
    return 0

indent_of s:
    n: str_len(s)
    i: 0
    w: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 32
            w: w + 1
        if not
            if c is 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w

fresh p:
    labeln: labeln + 1
    return str_cat(p, num_text(labeln))

il_esc s:
    n: str_len(s)
    r: ""
    i: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 34
            r: str_cat(r, "\\\"")
        if not
            if c is 92
                r: str_cat(r, "\\\\")
            if not
                r: str_cat(r, str_cut(s, i, i + 1))
        i: i + 1
    return r

local_seen nm:
    i: 0
    as long as i < _sov_list_len(locals)
        if str_eq(as text _sov_list_get(locals, i), nm) is 1
            return 1
        i: i + 1
    return 0

local_add nm:
    if local_seen(nm) is 0
        locals: _sov_list_add(locals, nm)
    return 0

local_idx nm:
    i: 0
    as long as i < _sov_list_len(locals)
        if str_eq(as text _sov_list_get(locals, i), nm) is 1
            return i
        i: i + 1
    return 0 - 1

param_count ps:
    p: trim(ps)
    if str_len(p) is 0
        return 0
    c: 0
    as long as str_len(p) > 0
        p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0
            leave
        c: c + 1
        p: trim(str_cut(p, e, str_len(p)))
    return c

param_idx nm:
    p: trim(params)
    k: 0
    as long as str_len(p) > 0
        p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0
            leave
        if str_eq(str_cut(p, 0, e), nm) is 1
            return k
        k: k + 1
        p: trim(str_cut(p, e, str_len(p)))
    return 0 - 1

sig_for_call nm argc:
    r: str_cat("int64 SovrenMain::", nm)
    r: str_cat(r, "(")
    i: 0
    as long as i < argc
        if i > 0
            r: str_cat(r, ", ")
        r: str_cat(r, "int64")
        i: i + 1
    r: str_cat(r, ")")
    return r

# expression compiler: emits stack code for i64 numbers, names, calls, + - * /.
ep: 0
eb: 0
es: ""

esk:
    as long as ep < eb
        if is_sp(peek_byte(es, ep)) is 1
            ep: ep + 1
        if not
            leave
    return 0

fac:
    esk()
    if ep >= eb
        emitln("    ldc.i8 0")
        return 0
    c: peek_byte(es, ep)
    if c is 40
        ep: ep + 1
        expr()
        esk()
        if ep < eb
            if peek_byte(es, ep) is 41
                ep: ep + 1
        return 0
    if c is 45
        ep: ep + 1
        emitln("    ldc.i8 0")
        fac()
        emitln("    sub")
        return 0
    if is_dig(c) is 1
        st: ep
        as long as ep < eb
            if is_dig(peek_byte(es, ep)) is 1
                ep: ep + 1
            if not
                leave
        emit("    ldc.i8 ")
        emitln(str_cut(es, st, ep))
        return 0
    if is_alfa(c) is 1
        st2: ep
        as long as ep < eb
            if is_aln(peek_byte(es, ep)) is 1
                ep: ep + 1
            if not
                leave
        nm: str_cut(es, st2, ep)
        esk()
        if ep < eb
            if peek_byte(es, ep) is 40
                ep: ep + 1
                argc: 0
                as long as ep < eb
                    esk()
                    if ep < eb
                        if peek_byte(es, ep) is 41
                            ep: ep + 1
                            leave
                    expr()
                    argc: argc + 1
                    esk()
                    if ep < eb
                        if peek_byte(es, ep) is 44
                            ep: ep + 1
                emit("    call ")
                emitln(sig_for_call(nm, argc))
                return 0
        li: local_idx(nm)
        if li >= 0
            emit("    ldloc ")
            emitln(num_text(li))
            return 0
        pi: param_idx(nm)
        if pi >= 0
            emit("    ldarg ")
            emitln(num_text(pi))
            return 0
        emitln("    ldc.i8 0")
        return 0
    emitln("    ldc.i8 0")
    return 0

term:
    fac()
    as long as 1 is 1
        esk()
        if ep >= eb
            return 0
        c: peek_byte(es, ep)
        if c is not 42
            if c is not 47
                return 0
        ep: ep + 1
        fac()
        if c is 42
            emitln("    mul")
        if c is 47
            emitln("    div")
    return 0

expr:
    term()
    as long as 1 is 1
        esk()
        if ep >= eb
            return 0
        c: peek_byte(es, ep)
        if c is not 43
            if c is not 45
                return 0
        ep: ep + 1
        term()
        if c is 43
            emitln("    add")
        if c is 45
            emitln("    sub")
    return 0

emit_expr s:
    es: trim(s)
    ep: 0
    eb: str_len(es)
    expr()
    return 0

emit_cond s:
    t: trim(s)
    n: str_len(t)
    i: 0
    as long as i < n
        c: peek_byte(t, i)
        if c is 62
            emit_expr(str_cut(t, 0, i))
            emit_expr(str_cut(t, i + 1, n))
            emitln("    cgt")
            return 0
        if c is 60
            emit_expr(str_cut(t, 0, i))
            emit_expr(str_cut(t, i + 1, n))
            emitln("    clt")
            return 0
        if c is 61
            emit_expr(str_cut(t, 0, i))
            emit_expr(str_cut(t, i + 1, n))
            emitln("    ceq")
            return 0
        i: i + 1
    emit_expr(t)
    emitln("    ldc.i8 0")
    emitln("    ceq")
    emitln("    ldc.i4.0")
    emitln("    ceq")
    return 0

push_block kind ind a b:
    if block_n < _sov_list_len(block_inds)
        block_inds: _sov_list_set(block_inds, block_n, ind)
        block_kinds: _sov_list_set(block_kinds, block_n, kind)
        block_a: _sov_list_set(block_a, block_n, a)
        block_b: _sov_list_set(block_b, block_n, b)
    if not
        block_inds: _sov_list_add(block_inds, ind)
        block_kinds: _sov_list_add(block_kinds, kind)
        block_a: _sov_list_add(block_a, a)
        block_b: _sov_list_add(block_b, b)
    block_n: block_n + 1
    return 0

close_one:
    if block_n > 0
        kind: as text _sov_list_get(block_kinds, block_n - 1)
        a: as text _sov_list_get(block_a, block_n - 1)
        b: as text _sov_list_get(block_b, block_n - 1)
        if str_eq(kind, "while") is 1
            emit("    br ")
            emitln(a)
            emit(b)
            emitln(":")
            block_n: block_n - 1
            return 0
        if str_eq(kind, "if") is 1
            emit("    br ")
            emitln(b)
            emit(a)
            emitln(":")
            emit("    br ")
            emitln(b)
            emit(b)
            emitln(":")
            block_n: block_n - 1
            return 0
        if str_eq(kind, "else") is 1
            emit("    br ")
            emitln(b)
            emit(b)
            emitln(":")
            block_n: block_n - 1
            return 0
        block_n: block_n - 1
    return 0

close_blocks ind:
    as long as block_n > 0
        top: _sov_list_get(block_inds, block_n - 1)
        if ind <= top
            close_one()
        if not
            leave
    return 0

close_all:
    as long as block_n > 0
        close_one()
    return 0

emit_else_line s ind:
    if block_n > 0
        top: _sov_list_get(block_inds, block_n - 1)
        kind: as text _sov_list_get(block_kinds, block_n - 1)
        if ind <= top
            if str_eq(kind, "if") is 1
                el: as text _sov_list_get(block_a, block_n - 1)
                en: as text _sov_list_get(block_b, block_n - 1)
                emit("    br ")
                emitln(en)
                emit(el)
                emitln(":")
                block_n: block_n - 1
                ar: find_arrow(s)
                if ar >= 0
                    body: trim(str_cut(s, ar + 2, str_len(s)))
                    if str_len(body) > 0
                        emit_stmt_parts(body)
                push_block("else", ind, "", en)
                return 1
    close_blocks(ind)
    return 0

emit_print_lit lit reps:
    esc: il_esc(lit)
    i: 0
    as long as i < reps
        emit("    ldstr \"")
        emit(esc)
        emitln("\"")
        emitln("    call void [mscorlib]System.Console::WriteLine(string)")
        i: i + 1
    return 0

parse_reps tail:
    t: trim(tail)
    if str_len(t) is 0
        return 1
    if is_dig(peek_byte(t, 0)) is 0
        return 1
    v: 0
    i: 0
    as long as i < str_len(t)
        c: peek_byte(t, i)
        if is_dig(c) is 1
            v: v * 10 + c - 48
            i: i + 1
        if not
            return v
    if v < 1
        return 1
    return v

emit_stmt st:
    s: trim(st)
    if str_len(s) is 0
        return 0
    if starts(s, "as long as ") is 1
        arw: find_arrow(s)
        condw: ""
        bodyw: ""
        if arw < 0
            condw: trim(str_cut(s, 11, str_len(s)))
        if not
            condw: trim(str_cut(s, 11, arw))
            bodyw: trim(str_cut(s, arw + 2, str_len(s)))
        top: fresh("WH")
        en: fresh("EW")
        emit(top)
        emitln(":")
        emit_cond(condw)
        emit("    brfalse ")
        emitln(en)
        if str_len(bodyw) > 0
            emit_stmt_parts(bodyw)
        last_block_kind: "while"
        last_block_a: top
        last_block_b: en
        return 1
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if str_eq(kw, "print") is 1
        rest: trim(str_cut(s, w, str_len(s)))
        if str_len(rest) > 0
            if peek_byte(rest, 0) is 39
                j: 1
                as long as j < str_len(rest)
                    if peek_byte(rest, j) is 39
                        leave
                    j: j + 1
                emit_print_lit(str_cut(rest, 1, j), parse_reps(str_cut(rest, j + 1, str_len(rest))))
                return 0
            if not
                if peek_byte(rest, 0) is 34
                    j2: 1
                    as long as j2 < str_len(rest)
                        if peek_byte(rest, j2) is 34
                            leave
                        j2: j2 + 1
                    emit_print_lit(str_cut(rest, 1, j2), parse_reps(str_cut(rest, j2 + 1, str_len(rest))))
                    return 0
        emit_expr(rest)
        emitln("    call void [mscorlib]System.Console::WriteLine(int64)")
        return 0
    if str_eq(kw, "return") is 1
        emit_expr(str_cut(s, w, str_len(s)))
        emitln("    ret")
        return 0
    if str_eq(kw, "if") is 1
        ar: find_arrow(s)
        cond: ""
        body: ""
        if ar < 0
            cond: trim(str_cut(s, w, str_len(s)))
        if not
            cond: trim(str_cut(s, w, ar))
            body: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond, "not") is 1
            return 0
        el: fresh("EL")
        en: fresh("EI")
        emit_cond(cond)
        emit("    brfalse ")
        emitln(el)
        if str_len(body) > 0
            emit_stmt_parts(body)
        last_block_kind: "if"
        last_block_a: el
        last_block_b: en
        return 1
    col: find_ch(s, 58)
    if col > 0
        nm: trim(str_cut(s, 0, col))
        local_add(nm)
        emit_expr(str_cut(s, col + 1, str_len(s)))
        emit("    stloc ")
        emitln(num_text(local_idx(nm)))
        return 0
    return 0

emit_stmt_parts s:
    t0: trim(s)
    if starts(t0, "as long as ") is 1
        return emit_stmt(t0)
    if starts(t0, "if ") is 1
        return emit_stmt(t0)
    start: 0
    n: str_len(s)
    opened: 0
    as long as start < n
        i: start
        found: 0
        as long as i + 1 < n
            if peek_byte(s, i) is 59
                if peek_byte(s, i + 1) is 59
                    found: 1
                    leave
            i: i + 1
        if found is 0
            i: n
        one: emit_stmt(str_cut(s, start, i))
        if one is 1
            opened: 1
        if found is 1
            start: i + 2
        if not
            start: n
    return opened

scan_locals body:
    locals: _sov_list_new()
    i: 0
    n: str_len(body)
    as long as i < n
        e: i
        as long as e < n
            if peek_byte(body, e) is 10
                leave
            e: e + 1
        line: trim(str_cut(body, i, e))
        if str_len(line) > 0
            col: find_ch(line, 58)
            if col > 0
                kwend: word_end(line, 0)
                kw: str_cut(line, 0, kwend)
                skip: 0
                if str_eq(kw, "if") is 1
                    skip: 1
                if str_eq(kw, "as") is 1
                    skip: 1
                if str_eq(kw, "print") is 1
                    skip: 1
                if str_eq(kw, "return") is 1
                    skip: 1
                if skip is 0
                    local_add(trim(str_cut(line, 0, col)))
        i: e + 1
    return 0

emit_locals:
    if _sov_list_len(locals) is 0
        return 0
    emit("    .locals init (")
    i: 0
    as long as i < _sov_list_len(locals)
        if i > 0
            emit(", ")
        emit("[")
        emit(num_text(i))
        emit("] int64 ")
        emit(as text _sov_list_get(locals, i))
        i: i + 1
    emitln(")")
    return 0

emit_method nm ps body:
    params: ps
    scan_locals(body)
    pending_if: 0
    block_inds: _sov_list_new()
    block_kinds: _sov_list_new()
    block_a: _sov_list_new()
    block_b: _sov_list_new()
    block_n: 0
    emit("  .method private static int64 ")
    if str_eq(nm, "main") is 1
        emit("sovren_main")
    if not
        emit(nm)
    emit("(")
    pc: param_count(ps)
    i: 0
    as long as i < pc
        if i > 0
            emit(", ")
        emit("int64")
        i: i + 1
    emitln(") cil managed {")
    emitln("    .maxstack 64")
    emit_locals()
    i2: 0
    n: str_len(body)
    as long as i2 < n
        e: i2
        as long as e < n
            if peek_byte(body, e) is 10
                leave
            e: e + 1
        raw: str_cut(body, i2, e)
        line: trim(raw)
        if str_len(line) > 0
            ind: indent_of(raw)
            if starts(line, "if not") is 1
                emit_else_line(line, ind)
            if not
                close_blocks(ind)
                opened: emit_stmt_parts(line)
                if opened is 1
                    push_block(last_block_kind, ind, last_block_a, last_block_b)
        i2: e + 1
    close_all()
    emitln("    ldc.i8 0")
    emitln("    ret")
    emitln("  }")
    return 0

emit_entry:
    emitln("  .method public static int32 Main(string[] args) cil managed {")
    emitln("    .entrypoint")
    emitln("    .maxstack 8")
    emitln("    call int64 SovrenMain::sovren_main()")
    emitln("    conv.i4")
    emitln("    ret")
    emitln("  }")
    return 0

compile_file path:
    src: file_read_all(path)
    if src is 0
        print "cil: cannot read input"
        sys_exit(1)
    il_out: ".assembly extern mscorlib {}\n.assembly SovrenMain {}\n.module SovrenMain.exe\n.class public auto ansi beforefieldinit SovrenMain extends [mscorlib]System.Object {\n"
    n: str_len(src)
    if n >= 4096
        n: 0
    i: 0
    in_fn: 0
    cur_nm: ""
    cur_ps: ""
    cur_body: ""
    as long as i < n
        e: i
        as long as e < n
            if peek_byte(src, e) is 10
                leave
            e: e + 1
        raw: str_cut(src, i, e)
        t: trim(raw)
        if str_len(t) > 0
            if peek_byte(t, 0) is not 35
                if is_sp(peek_byte(raw, 0)) is 0
                    if in_fn is 1
                        emit_method(cur_nm, cur_ps, cur_body)
                    h: str_cut(t, 0, str_len(t) - 1)
                    w: word_end(h, 0)
                    cur_nm: str_cut(h, 0, w)
                    cur_ps: trim(str_cut(h, w, str_len(h)))
                    cur_body: ""
                    in_fn: 1
                if is_sp(peek_byte(raw, 0)) is 1
                    cur_body: str_cat(cur_body, raw)
                    cur_body: str_cat(cur_body, "\n")
        i: e + 1
    if in_fn is 1
        emit_method(cur_nm, cur_ps, cur_body)
    emit_entry()
    emitln("}")
    return 0

