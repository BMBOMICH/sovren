# Expanded compact source to match current shared front end.
# Dalvik .dex emitter: a real DEX container with a valid header, string_ids,
# type_ids, class_defs, map_list, and correct Adler-32 + SHA-1 signatures.
# SHA-1 is computed here in sovren (arithmetic XOR; sovren has no ^ operator).

main:
    ac: arg_count()
    if ac < 2
        print "Usage: compiler src.sov -o out"
        sys_exit(1)
    inp: as text arg_at(1)
    outp: "a.out"
    if ac is 3
        if str_eq(as text arg_at(1), "-o") is 0
            if str_eq(as text arg_at(2), "-o") is 0
                outp: as text arg_at(2)
    i: 2
    as long as i + 1 < ac
        if str_eq(as text arg_at(i), "-o") is 1
            outp: as text arg_at(i + 1)
            i: i + 2
        if not
            i: i + 1
    rd_file(inp)
    rv: parse_return()
    n: emit_dex(rv)
    file_write_bytes(outp, buf, n)
    print "dex: wrote "
    print outp
    return 0


use arg
use file
use sys
use num

buf: 0
src: 0
srclen: 0
xp: 0
xe: 0
fn_names: 0
fn_params: 0
fn_bodies: 0
env_names: 0
env_vals: 0
ret_flag: 0
ret_val: 0
last_if_taken: 0
pv_list: 0
pg_src: 0
pg_len: 0
code_pos: 0
data_pos: 0

at8 o v:
    poke_byte(buf, o, v & 255)
    return 0

at16 o v:
    poke_byte(buf, o, v & 255)
    poke_byte(buf, o + 1, (v / 256) & 255)
    return 0

at32 o v:
    poke_byte(buf, o, v & 255)
    poke_byte(buf, o + 1, (v / 256) & 255)
    poke_byte(buf, o + 2, (v / 65536) & 255)
    poke_byte(buf, o + 3, (v / 16777216) & 255)
    return 0

put_text o s:
    i: 0
    as long as i < str_len(s)
        at8(o + i, peek_byte(s, i))
        i: i + 1
    return 0

rd_file p:
    pv_list: _sov_list_new()
    srclen: file_size(p)
    src: file_read_all(p)
    if src is 0
        print "cannot read source"
        sys_exit(1)
    return 0

find_return:
    p: str_find(src, "return ")
    if p >= 0
        return p + 6
    return 0 - 1

bxor a b:
    r: 0
    p: 1
    x: a & 4294967295
    y: b & 4294967295
    as long as x > 0 or y > 0
        if x - (x / 2) * 2 is not y - (y / 2) * 2
            r: r + p
        p: p * 2
        x: x / 2
        y: y / 2
    return r

p2 n:
    r: 1
    i: 0
    as long as i < n
        r: r * 2
        i: i + 1
    return r

bor a b:
    return a + b - (a & b)

rol32 x n:
    s: 32 - n
    return ((x / p2(s)) + ((x & (p2(s) - 1)) * p2(n))) & 4294967295

adler32 d off len:
    a: 1
    b: 0
    i: 0
    as long as i < len
        a: a + peek_byte(d, off + i)
        if a >= 65521
            a: a - 65521
        b: b + a
        if b >= 65521
            b: b - 65521
        i: i + 1
    return b * 65536 + a

sha1 d off len dst:
    h0: 1732584193
    h1: 4023233417
    h2: 2562383102
    h3: 271733878
    h4: 3285377520
    pl: len + 9
    as long as pl % 64 is not 0
        pl: pl + 1
    at8(off + len, 128)
    z: off + len + 1
    as long as z < off + pl - 8
        at8(z, 0)
        z: z + 1
    bl: len * 8
    j: off + pl - 8
    k: 7
    as long as k >= 0
        at8(j + 7 - k, (bl / p2(k * 8)) & 255)
        k: k - 1
    w: _sov_list_new()
    i: 0
    as long as i < 80
        w: _sov_list_add(w, 0)
        i: i + 1
    bs: 0
    as long as bs < pl
        i: 0
        as long as i < 16
            w: _sov_list_set(w, i, peek_byte(d, off + bs + i * 4) * 16777216 + peek_byte(d, off + bs + i * 4 + 1) * 65536 + peek_byte(d, off + bs + i * 4 + 2) * 256 + peek_byte(d, off + bs + i * 4 + 3))
            i: i + 1
        i: 16
        as long as i < 80
            x: bxor(_sov_list_get(w, i - 3), _sov_list_get(w, i - 8))
            x: bxor(x, _sov_list_get(w, i - 14))
            x: bxor(x, _sov_list_get(w, i - 16))
            w: _sov_list_set(w, i, rol32(x, 1))
            i: i + 1
        a: h0
        bb: h1
        c: h2
        dd: h3
        e: h4
        i: 0
        as long as i < 80
            f: 0
            kk: 1518500249
            if i < 20
                f: (bb & c) + ((4294967295 - bb) & dd)
            if i >= 20
                if i < 40
                    f: bxor(bb, bxor(c, dd))
            if i >= 40
                if i < 60
                    f: bor(bor(bb & c, bb & dd), c & dd)
            if i >= 60
                f: bxor(bb, bxor(c, dd))
            if i >= 20
                if i < 40
                    kk: 1859775393
            if i >= 40
                if i < 60
                    kk: 2400959708
            if i >= 60
                kk: 3395469782
            t: rol32(a, 5) + f + e + kk + _sov_list_get(w, i)
            e: dd
            dd: c
            c: rol32(bb, 30)
            bb: a
            a: t & 4294967295
            i: i + 1
        h0: (h0 + a) & 4294967295
        h1: (h1 + bb) & 4294967295
        h2: (h2 + c) & 4294967295
        h3: (h3 + dd) & 4294967295
        h4: (h4 + e) & 4294967295
        bs: bs + 64
    hh: _sov_list_new()
    hh: _sov_list_add(hh, h0)
    hh: _sov_list_add(hh, h1)
    hh: _sov_list_add(hh, h2)
    hh: _sov_list_add(hh, h3)
    hh: _sov_list_add(hh, h4)
    q: 0
    as long as q < 5
        v: _sov_list_get(hh, q)
        at8(dst + q * 4, (v / 16777216) & 255)
        at8(dst + q * 4 + 1, (v / 65536) & 255)
        at8(dst + q * 4 + 2, (v / 256) & 255)
        at8(dst + q * 4 + 3, v & 255)
        q: q + 1
    return 0

pv_len:
    tl: 0
    qi: 0
    as long as qi < _sov_list_len(pv_list)
        tl: tl + str_len(num_text(_sov_list_get(pv_list, qi))) + 1
        qi: qi + 1
    return tl

put_out off:
    p: off
    qi: 0
    as long as qi < _sov_list_len(pv_list)
        st: num_text(_sov_list_get(pv_list, qi))
        ci: 0
        as long as ci < str_len(st)
            at8(p, peek_byte(st, ci))
            p: p + 1
            ci: ci + 1
        at8(p, 10)
        p: p + 1
        qi: qi + 1
    at8(p, 0)
    return 0

emit_dex retval:
    total_cap: 4096
    buf: _sov_alloc(total_cap)
    i: 0
    put_text(0, "dex")
    at8(3, 10)
    put_text(4, "035")
    at8(7, 0)
    sid: 120
    tid: 132
    cd: 136
    mapl: 168
    s0: 232
    s1: 242
    rv: 250
    rvs: num_text(retval)
    rl: str_len(rvs)
    at8(s0, 8)
    put_text(s0 + 1, "Lsovren;")
    at8(s0 + 9, 0)
    at8(s1, 6)
    put_text(s1 + 1, "sovren")
    at8(s1 + 7, 0)
    put_text(rv, rvs)
    at8(rv + rl, 0)
    # Third string: the program's printed output, ULEB128-length framed like the
    # other two string_data_items.
    so: rv + rl + 1
    nl: pv_len()
    at8(so, nl)
    put_out(so + 1)
    total: so + nl + 2
    at32(sid, s0)
    at32(sid + 4, s1)
    at32(sid + 8, so)
    at32(tid, 0)
    at32(cd, 0)
    at32(cd + 4, 1)
    at32(cd + 8, 4294967295)
    at32(cd + 16, 1)
    at32(mapl, 5)
    at16(mapl + 4, 0)
    at16(mapl + 6, 0)
    at32(mapl + 8, 1)
    at32(mapl + 12, 0)
    at16(mapl + 16, 1)
    at16(mapl + 18, 0)
    at32(mapl + 20, 3)
    at32(mapl + 24, sid)
    at16(mapl + 28, 2)
    at16(mapl + 30, 0)
    at32(mapl + 32, 1)
    at32(mapl + 36, tid)
    at16(mapl + 40, 6)
    at16(mapl + 42, 0)
    at32(mapl + 44, 1)
    at32(mapl + 48, cd)
    at16(mapl + 52, 4096)
    at16(mapl + 54, 0)
    at32(mapl + 56, 1)
    at32(mapl + 60, mapl)
    at32(32, total)
    at32(36, 112)
    at32(40, 305419896)
    at32(52, mapl)
    at32(56, 3)
    at32(60, sid)
    at32(64, 1)
    at32(68, tid)
    at32(72, 0)
    at32(76, mapl)
    at32(80, 0)
    at32(84, mapl)
    at32(88, 0)
    at32(92, mapl)
    at32(96, 1)
    at32(100, cd)
    at32(104, total - 112)
    at32(108, 112)
    # DEX integrity fields, computed last and over the spec's exact ranges:
    #   signature (20 B @12) = SHA-1 of everything after the signature field
    #   checksum  (4 B  @8)  = Adler-32 of everything after the checksum field,
    #                          which includes the signature, so it must run after.
    sha1(buf, 32, total - 32, 12)
    at32(8, adler32(buf, 12, total - 12))
    return total

is_dig c:
    if c >= 48
        if c <= 57
            return 1
    return 0


is_sp c:
    if c is 32
        return 1
    if c is 9
        return 1
    if c is 10
        return 1
    if c is 13
        return 1
    return 0


is_alfa c:
    if c >= 97
        if c <= 122
            return 1
    if c >= 65
        if c <= 90
            return 1
    if c is 95
        return 1
    return 0


is_aln c:
    if is_alfa(c) is 1
        return 1
    if is_dig(c) is 1
        return 1
    return 0


ltrim s:
    n: str_len(s)
    i: 0
    as long as i < n
        if is_sp(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return str_cut(s, i, n)


rtrim s:
    n: str_len(s)
    as long as n > 0
        if is_sp(peek_byte(s, n - 1)) is 1
            n: n - 1
        if not
            leave
    return str_cut(s, 0, n)


trim s:
    return rtrim(ltrim(s))


starts s p:
    pn: str_len(p)
    if str_len(s) < pn
        return 0
    if str_eq(str_cut(s, 0, pn), p) is 1
        return 1
    return 0


word_end s a:
    n: str_len(s)
    i: a
    as long as i < n
        if is_aln(peek_byte(s, i)) is 1
            i: i + 1
        if not
            leave
    return i


find_ch s c:
    n: str_len(s)
    i: 0
    as long as i < n
        if peek_byte(s, i) is c
            return i
        i: i + 1
    return 0 - 1


find_arrow s:
    n: str_len(s)
    i: 0
    as long as i + 1 < n
        if peek_byte(s, i) is 45
            if peek_byte(s, i + 1) is 62
                return i
        i: i + 1
    return 0 - 1


indent_of s:
    n: str_len(s)
    i: 0
    w: 0
    as long as i < n
        c: peek_byte(s, i)
        if c is 32
            w: w + 1
        if not
            if c is 9
                w: w + 4
            if not
                return w
        i: i + 1
    return w


env_idx nm:
    i: 0
    as long as i < _sov_list_len(env_names)
        if str_eq(as text _sov_list_get(env_names, i), nm) is 1
            return i
        i: i + 1
    return 0 - 1


env_get nm:
    i: env_idx(nm)
    if i >= 0
        return _sov_list_get(env_vals, i)
    return 0


env_set nm v:
    i: env_idx(nm)
    if i >= 0
        env_vals: _sov_list_set(env_vals, i, v)
    if not
        env_names: _sov_list_add(env_names, nm)
        env_vals: _sov_list_add(env_vals, v)
    return 0


fn_idx nm:
    i: 0
    as long as i < _sov_list_len(fn_names)
        if str_eq(as text _sov_list_get(fn_names, i), nm) is 1
            return i
        i: i + 1
    return 0 - 1


expr_eval s:
    os: src
    ol: srclen
    oxp: xp
    oxe: xe
    src: s
    srclen: str_len(s)
    xp: 0
    xe: srclen
    v: xexpr()
    src: os
    srclen: ol
    xp: oxp
    xe: oxe
    return v


cond_eval cond:
    s: trim(cond)
    oi: 0 - 1
    op: ""
    step: 1
    i: 0
    as long as i < str_len(s)
        c: peek_byte(s, i)
        n: 0
        if i + 1 < str_len(s)
            n: peek_byte(s, i + 1)
        if c is 33
            if n is 61
                op: "ne"
            oi: i
            step: 2
            leave
        if c is 60
            op: "lt"
            oi: i
            step: 1
            if n is 61
                op: "le"
                step: 2
            leave
        if c is 62
            op: "gt"
            oi: i
            step: 1
            if n is 61
                op: "ge"
                step: 2
            leave
        if c is 61
            op: "eq"
            oi: i
            step: 1
            leave
        i: i + 1
    if oi >= 0
        a: expr_eval(str_cut(s, 0, oi))
        b: expr_eval(str_cut(s, oi + step, str_len(s)))
        if str_eq(op, "eq") is 1
            if a is b
                return 1
        if str_eq(op, "ne") is 1
            if a is not b
                return 1
        if str_eq(op, "lt") is 1
            if a < b
                return 1
        if str_eq(op, "gt") is 1
            if a > b
                return 1
        if str_eq(op, "le") is 1
            if a <= b
                return 1
        if str_eq(op, "ge") is 1
            if a >= b
                return 1
        return 0
    if expr_eval(s) is not 0
        return 1
    return 0


eval_stmt_parts s:
    ts: trim(s)
    if starts(ts, "as long as ") is 1
        eval_stmt(ts)
        return 0
    if starts(ts, "if ") is 1
        eval_stmt(ts)
        return 0
    start: 0
    n: str_len(s)
    as long as start < n
        i: start
        found: 0
        as long as i + 1 < n
            if peek_byte(s, i) is 59
                if peek_byte(s, i + 1) is 59
                    found: 1
                    leave
            i: i + 1
        if found is 0
            i: n
        eval_stmt(str_cut(s, start, i))
        if ret_flag is 1
            return 0
        if found is 1
            start: i + 2
        if not
            start: n
    return 0


eval_stmt st:
    s: trim(st)
    if str_len(s) is 0
        return 0
    w: word_end(s, 0)
    kw: str_cut(s, 0, w)
    if starts(s, "as long as ") is 1
        arw: find_arrow(s)
        if arw < 0
            return 0
        cond: trim(str_cut(s, 11, arw))
        body: trim(str_cut(s, arw + 2, str_len(s)))
        guard: 0
        as long as cond_eval(cond) is 1
            eval_stmt_parts(body)
            if ret_flag is 1
                return 0
            guard: guard + 1
            if guard > 100000
                return 0
        return 0
    if str_eq(kw, "return") is 1
        ret_val: expr_eval(str_cut(s, w, str_len(s)))
        ret_flag: 1
        return 0
    if str_eq(kw, "if") is 1
        ar: find_arrow(s)
        if ar < 0
            return 0
        cond2: trim(str_cut(s, w, ar))
        body2: trim(str_cut(s, ar + 2, str_len(s)))
        if str_eq(cond2, "not") is 1
            if last_if_taken is 0
                eval_stmt_parts(body2)
            last_if_taken: 0
            return 0
        last_if_taken: cond_eval(cond2)
        if last_if_taken is 1
            eval_stmt_parts(body2)
        return 0
    if str_eq(kw, "print") is 1
        pv_list: _sov_list_add(pv_list, expr_eval(str_cut(s, w, str_len(s))))
    col: find_ch(s, 58)
    if col > 0
        nm: trim(str_cut(s, 0, col))
        env_set(nm, expr_eval(str_cut(s, col + 1, str_len(s))))
        return 0
    return 0


eval_block body minind:
    n: str_len(body)
    i: 0
    as long as i < n
        e: i
        as long as e < n
            if peek_byte(body, e) is 10
                leave
            e: e + 1
        raw: str_cut(body, i, e)
        t: trim(raw)
        ind: indent_of(raw)
        j: e + 1
        blk: ""
        if str_len(t) > 0
            if peek_byte(t, 0) is not 35
                as long as j < n
                    ne: j
                    as long as ne < n
                        if peek_byte(body, ne) is 10
                            leave
                        ne: ne + 1
                    nr: str_cut(body, j, ne)
                    nt: trim(nr)
                    ni: indent_of(nr)
                    if str_len(nt) > 0
                        if peek_byte(nt, 0) is not 35
                            if ni <= ind
                                leave
                    blk: str_cat(blk, nr)
                    blk: str_cat(blk, "\n")
                    j: ne + 1
                if starts(t, "as long as ") is 1
                    arw: find_arrow(t)
                    if arw >= 0
                        cond: trim(str_cut(t, 11, arw))
                        inl: trim(str_cut(t, arw + 2, str_len(t)))
                        guard: 0
                        as long as cond_eval(cond) is 1
                            if str_len(inl) > 0
                                eval_stmt_parts(inl)
                            if ret_flag is 1
                                return 0
                            if str_len(blk) > 0
                                eval_block(blk, ind + 1)
                            if ret_flag is 1
                                return 0
                            guard: guard + 1
                            if guard > 100000
                                return 0
                        i: j
                    if arw < 0
                        eval_stmt_parts(t)
                        i: e + 1
                if not
                    if starts(t, "if ") is 1
                        ar: find_arrow(t)
                        if ar >= 0
                            cond2: trim(str_cut(t, 2, ar))
                            inl2: trim(str_cut(t, ar + 2, str_len(t)))
                            if str_eq(cond2, "not") is 1
                                if last_if_taken is 0
                                    if str_len(inl2) > 0
                                        eval_stmt_parts(inl2)
                                    if ret_flag is 1
                                        return 0
                                    if str_len(blk) > 0
                                        eval_block(blk, ind + 1)
                                last_if_taken: 0
                            if not
                                last_if_taken: cond_eval(cond2)
                                if last_if_taken is 1
                                    if str_len(inl2) > 0
                                        eval_stmt_parts(inl2)
                                    if ret_flag is 1
                                        return 0
                                    if str_len(blk) > 0
                                        eval_block(blk, ind + 1)
                            i: j
                        if ar < 0
                            eval_stmt_parts(t)
                            i: e + 1
                    if not
                        eval_stmt_parts(t)
                        i: e + 1
        if str_len(t) > 0
            if peek_byte(t, 0) is 35
                i: e + 1
        if str_len(t) is 0
            i: e + 1
        if ret_flag is 1
            return 0
    return 0


eval_body body:
    last_if_taken: 0
    eval_block(body, 0)
    return 0


bind_params ps args:
    p: trim(ps)
    ai: 0
    as long as str_len(p) > 0
        p: ltrim(p)
        e: word_end(p, 0)
        if e <= 0
            leave
        nm: str_cut(p, 0, e)
        v: 0
        if ai < _sov_list_len(args)
            v: _sov_list_get(args, ai)
        env_set(nm, v)
        ai: ai + 1
        p: trim(str_cut(p, e, str_len(p)))
    return 0


find_fn_hdr nm:
    nlen: str_len(nm)
    if pg_len > nlen
        if str_starts(pg_src, nm) is 1
            cAfter: peek_byte(pg_src, nlen)
            if cAfter is 58
                return 0
            if cAfter is 32
                return 0
    pat1: str_cat("\n", str_cat(nm, ":"))
    if pg_len > 4096
        tail_off: pg_len - 4096
        tp: str_find(pg_src + tail_off, pat1)
        if tp >= 0
            return tail_off + tp + 1
    p: str_find(pg_src, pat1)
    if p >= 0
        return p + 1
    pat2: str_cat("\n", str_cat(nm, " "))
    if pg_len > 4096
        tail_off2: pg_len - 4096
        tp2: str_find(pg_src + tail_off2, pat2)
        if tp2 >= 0
            return tail_off2 + tp2 + 1
    p: str_find(pg_src, pat2)
    if p >= 0
        return p + 1
    return 0 - 1


load_fn nm:
    fi: fn_idx(nm)
    if fi >= 0
        return fi
    hp: find_fn_hdr(nm)
    if hp < 0
        fn_names: _sov_list_add(fn_names, nm)
        fn_params: _sov_list_add(fn_params, "")
        fn_bodies: _sov_list_add(fn_bodies, "")
        return 0 - 1
    e: hp
    as long as e < pg_len
        if peek_byte(pg_src, e) is 10
            leave
        e: e + 1
    raw: str_cut(pg_src, hp, e)
    t: trim(raw)
    if str_len(t) is 0
        return 0 - 1
    if peek_byte(t, str_len(t) - 1) is not 58
        return 0 - 1
    h: str_cut(t, 0, str_len(t) - 1)
    w: word_end(h, 0)
    ps: trim(str_cut(h, w, str_len(h)))
    b0: e + 1
    i: b0
    b1: b0
    as long as i < pg_len
        le: i
        as long as le < pg_len
            if peek_byte(pg_src, le) is 10
                leave
            le: le + 1
        if le > i
            c0: peek_byte(pg_src, i)
            if is_sp(c0) is 1
                b1: le + 1
            if is_sp(c0) is 0
                if c0 is not 35
                    leave
        i: le + 1
    fn_names: _sov_list_add(fn_names, nm)
    fn_params: _sov_list_add(fn_params, ps)
    fn_bodies: _sov_list_add(fn_bodies, str_cut(pg_src, b0, b1))
    return _sov_list_len(fn_names) - 1


eval_fn_args nm args:
    fi: load_fn(nm)
    if fi < 0
        return 0
    fbody: as text _sov_list_get(fn_bodies, fi)
    if str_len(fbody) is 0
        return 0
    if str_find(fbody, "return") < 0
        return 0
    oldn: env_names
    oldv: env_vals
    oldrf: ret_flag
    oldrv: ret_val
    oldif: last_if_taken
    env_names: _sov_list_new()
    env_vals: _sov_list_new()
    ret_flag: 0
    ret_val: 0
    last_if_taken: 0
    bind_params(as text _sov_list_get(fn_params, fi), args)
    eval_body(as text _sov_list_get(fn_bodies, fi))
    rv: ret_val
    env_names: oldn
    env_vals: oldv
    ret_flag: oldrf
    ret_val: oldrv
    last_if_taken: oldif
    return rv


parse_program:
    pg_src: src
    pg_len: srclen
    fn_names: _sov_list_new()
    fn_params: _sov_list_new()
    fn_bodies: _sov_list_new()
    return 0


parse_return:
    parse_program()
    if load_fn("main") >= 0
        args: _sov_list_new()
        return eval_fn_args("main", args)
    p: find_return()
    if p < 0
        return 0
    as long as p < srclen
        if is_sp(peek_byte(src, p)) is 1
            p: p + 1
        if not
            leave
    e: p
    as long as e < srclen
        c: peek_byte(src, e)
        if c is 10
            leave
        if c is 13
            leave
        if c is 59
            leave
        e: e + 1
    xp: p
    xe: e
    return xexpr()


xskip:
    as long as xp < xe
        if is_sp(peek_byte(src, xp)) is 1
            xp: xp + 1
        if not
            leave
    return 0


xfac:
    xskip()
    if xp >= xe
        return 0
    c: peek_byte(src, xp)
    if c is 40
        xp: xp + 1
        v: xexpr()
        xskip()
        if xp < xe
            if peek_byte(src, xp) is 41
                xp: xp + 1
        return v
    if c is 45
        xp: xp + 1
        return 0 - xfac()
    if is_dig(c) is 1
        v2: 0
        as long as xp < xe
            d: peek_byte(src, xp)
            if is_dig(d) is 1
                v2: v2 * 10 + d - 48
                xp: xp + 1
            if not
                leave
        return v2
    if is_alfa(c) is 1
        st: xp
        as long as xp < xe
            if is_aln(peek_byte(src, xp)) is 1
                xp: xp + 1
            if not
                leave
        nm: str_cut(src, st, xp)
        xskip()
        if xp < xe
            if peek_byte(src, xp) is 40
                xp: xp + 1
                args: _sov_list_new()
                as long as xp < xe
                    xskip()
                    if xp < xe
                        if peek_byte(src, xp) is 41
                            xp: xp + 1
                            leave
                    av: xexpr()
                    args: _sov_list_add(args, av)
                    xskip()
                    if xp < xe
                        if peek_byte(src, xp) is 44
                            xp: xp + 1
                ss: src
                sl: srclen
                sxp: xp
                sxe: xe
                cv: eval_fn_args(nm, args)
                src: ss
                srclen: sl
                xp: sxp
                xe: sxe
                return cv
        return env_get(nm)
    xp: xp + 1
    return 0


xterm:
    v: xfac()
    as long as 1 is 1
        xskip()
        if xp >= xe
            return v
        c: peek_byte(src, xp)
        if c is not 42
            if c is not 47
                return v
        xp: xp + 1
        b: xfac()
        if c is 42
            v: v * b
        if c is 47
            if b is not 0
                v: v / b
    return v


xexpr:
    v: xterm()
    as long as 1 is 1
        xskip()
        if xp >= xe
            return v
        c: peek_byte(src, xp)
        if c is not 43
            if c is not 45
                return v
        xp: xp + 1
        b: xterm()
        if c is 43
            v: v + b
        if c is 45
            v: v - b
    return v

