use carm
do_wait_for_thread:
    wait_for_thread
    return 0
code: 0
letters: 0
letter_keys: 0
letters_at: 0
task_names: 0
at_top: 0
task_at: 0
global_names: 0
patch_at: 0
patch_kind: 0
used_guard: 0
patch_value: 0
patch_line: 0
local_names: 0
first_user_line: 0
saw_error: 0
try_depth: 0
inside_if: 0
no_runtime: 0
fold_fib_name: blank
skip_fib: 0
fn_locs: 0
line_of_stmt: 0
line_of_body: 0
line_of_task: 0
user_tasks: 0
names: 0
load_at: 4194304
# pass S3: ehdr + three phdrs (RX code, RW data+globals, GNU_STACK
# RW). phdr0's p_type = never doubled: park
# the table at 56; three headers cannot ride that trick, so the
# table sits at 64 like everyone else and header_size = 232.
header_size: 232
folded_number: 0
folded_from: 0
bump_ptr: 0
bump_end: 0
heap_size: 1073741824
libraries: blank
error_line: 0
file_name: blank
known_name: blank
known_value: 0
frame_at: 0
frame_open: 0
frame_done: 0
frame_holes: 0
dead_alloc_name: blank
used_alloc: 0
compiler_folder: 0
used_text_length: 0
used_texts_equal: 0
used_print: 0
used_print_number: 0
used_fill: 0
tiny_program: 0
pie_walk: 1
needs_heap: 0
needs_private: 0
used_crash: 0
const_names: 0
const_values: 0
const_dirty: 0
letter_boxes: 0
letter_tasks: 0
array_names: 0
array_count: 0
saw_letters: 0
rax_str s:
    at: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    later_fill(at, "str64x0", intern(s))
set_up_call name how_many already_set:
    if how_many = 1
        take_from_stack
        mov_reg(0, 0)
    if not
        if how_many = 2
            pop_reg(1)
            take_from_stack
        if not
            if how_many = 3
                pop_reg(2)
                pop_reg(1)
                take_from_stack
            if not
                if how_many = 4
                    pop_reg(3)
                    pop_reg(2)
                    pop_reg(1)
                    take_from_stack
                if not
                    if how_many = 5
                        pop_reg(4)
                        pop_reg(3)
                        pop_reg(2)
                        pop_reg(1)
                        take_from_stack
                    if not
                        if how_many = 6
                            pop_reg(5)
                            pop_reg(4)
                            pop_reg(3)
                            pop_reg(2)
                            pop_reg(1)
                            take_from_stack
                        if not
                            if how_many = 7
                                pop_reg(6)
                                pop_reg(5)
                                pop_reg(4)
                                pop_reg(3)
                                pop_reg(2)
                                pop_reg(1)
                                take_from_stack
    if same(name, "_sov_alloc") = 1
        used_alloc: 1
    if same(name, "_sov_strlen") = 1
        used_text_length: 1
    if same(name, "_sov_str_eq") = 1
        used_texts_equal: 1
    if same(name, "cfunc") = 1
        # x0 holds the address, x1..x6 the arguments. C wants the
        # arguments in x0..x5, so shift them down and call.
        mov_reg(9, 0)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        emitw(3594453280)
        return
    if same(name, "syscall") = 1
        # arm64 numbers its syscalls differently. the number in x0
        # goes through _sov_sysnum (a plain Sovren job in the
        # runtime) and the answer, in x0 again, becomes x8. The six
        # arguments sit in x1..x6, which the translation job
        # clobbers (they are caller-saved), so they are parked on
        # the stack first and come back after. The emulator keeps
        # x1..x6 across calls, which = why this bug only showed on
        # real arm64 hardware.
        push_reg(6)
        push_reg(5)
        push_reg(4)
        push_reg(3)
        push_reg(2)
        push_reg(1)
        call("_sov_sysnum")
        mov_reg(8, 0)
        pop_reg(1)
        pop_reg(2)
        pop_reg(3)
        pop_reg(4)
        pop_reg(5)
        pop_reg(6)
        mov_reg(0, 1)
        mov_reg(1, 2)
        mov_reg(2, 3)
        mov_reg(3, 4)
        mov_reg(4, 5)
        mov_reg(5, 6)
        ask_kernel
        return
    if same(name, "hlt") = 1
        emitw(3573751935)
        return
    if same(name, "cli") = 1
        emitw(3573760735)
        return
    if same(name, "sti") = 1
        emitw(3573760767)
        return
    if same(name, "peek_raw8") = 1
        ldrb_x0_x0x1
        return
    if same(name, "peek_raw64") = 1
        ldr_x0_x0x1
        return
    if same(name, "poke_raw8") = 1
        strb_x2_x0x1
        return
    if same(name, "poke_raw64") = 1
        str_x2_x0x1
        return
    if same(name, "peek_byte") = 1
        chk_mem(1)
        ldrb_x0_x0x1
        return
    if same(name, "peek_i64") = 1
        chk_mem(8)
        ldr_x0_x0x1
        return
    if same(name, "peek_ptr") = 1
        chk_mem(8)
        ldr_x0_x0x1
        return
    if same(name, "poke_byte") = 1
        chk_mem(1)
        strb_x2_x0x1
        return
    if same(name, "poke_i64") = 1
        chk_mem(8)
        str_x2_x0x1
        return
    if same(name, "stack_pointer") = 1
        # mov x0, sp: orr x0, xzr, sp (the shared runtime's thread
        # entry asks for the stack pointer; dead on machines without
        # threads, valid a64 either way)
        emitw(2854159328)
        return
    call(name)
poke2 p off v:
    dummy: _sov_set_byte(p, off, v % 256)
    dummy: _sov_set_byte(p, off + 1, (v / 256) % 256)
# pass S7, re-landed: the self-relocating walk. The image = ET_DYN
# and the kernel lands it anywhere; the walk - the first code in the
# file - finds the slide from its own anchor, opens the text page
# briefly, adds the slide to every absolute the compiler recorded,
# and closes the page again. The kernel applies nothing else.
emit_walk:
    emitw(268435456)
    # the anchor's own link address: the walk starts the code,
    # so this = the image base plus the whole header
    set_reg(1, load_at + header_size)
    emitw(3405840385)
    wz: here()
    emitw(3025893377)
    # the code page: the walk starts header_size bytes into the first page,
    # so its own address minus header_size = the page base, and a page
    # base = what mprotect takes
    emitw(3506675715)
    # the mprotect call clobbers x1 (its length argument); keep
    # the slide in x9 and restore it after the call, because the
    # loop needs the slide in x1
    emitw(2852193257)
    l1: here()
    emitw(3531603972)
    later_fill(l1, "wlen16", 0)
    l2: here()
    emitw(4070572036)
    later_fill(l2, "wlen32", 0)
    emitw(2852324339)
    emitw(2852389876)
    emitw(3531604194)
    emitw(2852324320)
    emitw(2852389857)
    emitw(3531611208)
    ask_kernel
    emitw(2852717537)
    tt: here()
    emitw(268435458)
    later_fill(tt, "tadr", 2)
    emitw(4181721155)
    emitw(2432704578)
    wz3: here()
    emitw(3025893379)
    lp: here()
    emitw(4181721156)
    emitw(3107981381)
    emitw(2432712770)
    emitw(2332098692)
    emitw(3531606538)
    emitw(1795817663)
    be_q: here()
    emitw(1409286144)
    emitw(3531605258)
    emitw(1795817663)
    be_d: here()
    emitw(1409286144)
    emitw(3531603974)
    emitw(3531603975)
    acc: here()
    emitw(3942973695)
    bg_r: here()
    emitw(1409286154)
    emitw(3093788808)
    emitw(3545585929)
    emitw(3548179753)
    emitw(3544535306)
    emitw(2596872522)
    emitw(2332688582)
    emitw(2432697575)
    b_acc: here()
    emitw(335544320)
    fx: here()
    # acc leaves x7 at the run's end and x6 at the link-time value:
    # add the slide and restart the counter, so rw rewrites every
    # word of the run with the live value
    emitw(2332098758)
    emitw(3531603975)
    rw: here()
    emitw(3942973695)
    bg_n: here()
    emitw(1409286154)
    emitw(3093788808)
    emitw(3545585929)
    emitw(3548179753)
    emitw(2596873418)
    emitw(3544202570)
    emitw(3544191243)
    emitw(3545595148)
    emitw(3547048332)
    emitw(3548113229)
    emitw(2852913512)
    emitw(2852978952)
    emitw(3089594504)
    emitw(2432697575)
    b_rw: here()
    emitw(335544320)
    qwd: here()
    emitw(4181721222)
    emitw(2332098758)
    emitw(4177526918)
    b_n1: here()
    emitw(335544320)
    dwl: here()
    emitw(3107979398)
    emitw(2332098758)
    emitw(3103785094)
    nxt: here()
    emitw(3506439267)
    wnz: here()
    emitw(889192451)
    rst: here()
    emitw(2853372896)
    emitw(2853438433)
    emitw(3531604130)
    emitw(3531611208)
    ask_kernel
    fin: here()
    emitw(335544320)
    later_fill(fin, "walk_jmp", 0)
    put19(wz, fin - wz)
    put19(wz3, rst - wz3)
    put19(be_q, qwd - be_q)
    put19(be_d, dwl - be_d)
    put19(bg_r, fx - bg_r)
    put19(bg_n, nxt - bg_n)
    put26(b_acc, acc - b_acc)
    put26(b_rw, rw - b_rw)
    put26(b_n1, nxt - b_n1)
    put19(wnz, lp - wnz)
    return 0

write_program path:
    if saw_error = 1
        return
    clen: _sov_list_len(code)
    sl: _sov_buf_len(letters)
    # pass S3: READ+EXECUTE holds headers and code only; the
    # literals and globals lead the READ+WRITE LOAD on its own
    # page. literals are data (a user wipe writes them at any
    # moment); the e_ident rider = gone.
    gfoff: header_size + clen
    as long as gfoff % 4096 is not 0
        gfoff: gfoff + 1
    sl8: sl
    as long as sl8 % 8 is not 0
        sl8: sl8 + 1
    str_off: gfoff - header_size
    str_foff: gfoff
    str_addr: load_at + gfoff
    glob_off: gfoff + sl8 - header_size
    pad: _sov_list_len(global_names) * 8
    # pass S7: count the movz/movk runs that carry absolutes. The
    # loader adds the slide to their immediates - the windows model
    rel_n: 0
    reloc_at: _sov_list_new()
    rel_nw: _sov_list_new()
    rc_i: 0
    as long as rc_i < _sov_list_len(patch_at)
        rk: _sov_list_get(patch_kind, rc_i)
        if same(rk, "gw64s_a") = 1
            rel_n: rel_n + 1
        if same(rk, "gw64a") = 1
            rel_n: rel_n + 1
        if same(rk, "glob64") = 1
            rel_n: rel_n + 1
        if same(rk, "task_address64") = 1
            rel_n: rel_n + 1
        if same(rk, "str64") = 1
            rel_n: rel_n + 1
        if same(rk, "str64x0") = 1
            rel_n: rel_n + 1
        if same(rk, "str") = 1
            rel_n: rel_n + 1
        if same(rk, "str32") = 1
            rel_n: rel_n + 1
        if same(rk, "glob") = 1
            rel_n: rel_n + 1
        rc_i: rc_i + 1
    # S7 android: the walk = built and runs clean for programs
    # with no absolutes, but absolute-carrying programs still die
    # with a corrupted text page. gated off until that = found.
    if pie_walk = 0
        rel_n: 0
    relsz: 8 + rel_n * 16
    filesz: gfoff + sl8 + pad + relsz
    flat: _sov_alloc(filesz + 64)
    i: 0
    as long as i < filesz + 16
        dummy: _sov_set_byte(flat, i, 0)
        i: i + 1
    dummy: _sov_set_byte(flat, 0, 127)
    dummy: _sov_set_byte(flat, 1, 69)
    dummy: _sov_set_byte(flat, 2, 76)
    dummy: _sov_set_byte(flat, 3, 70)
    dummy: _sov_set_byte(flat, 4, 2)
    dummy: _sov_set_byte(flat, 5, 1)
    dummy: _sov_set_byte(flat, 6, 1)
    et: 2
    if pie_walk = 1
        et: 3
    poke2(flat, 16, et)
    poke2(flat, 18, 183)
    poke4(flat, 20, 1)
    moff: start_off
    if tiny_program = 1
        mi: idx(task_names, "main")
        if mi > 0 - 1
            moff: _sov_list_get(task_at, mi)
    ent: load_at + header_size + moff
    if pie_walk = 1
        ent: load_at + header_size
    poke8(flat, 24, ent)
    poke8(flat, 32, 64)
    poke2(flat, 52, 64)
    poke2(flat, 54, 56)
    poke2(flat, 56, 3)
    # seg1: headers + code, READ+EXECUTE, never writable
    poke4(flat, 64, 1)
    poke4(flat, 68, 5)
    poke8(flat, 80, load_at)
    poke8(flat, 88, load_at)
    poke8(flat, 96, gfoff)
    poke8(flat, 104, gfoff)
    poke8(flat, 112, 4096)
    # seg2: literals + globals (+ the arena's blank tail),
    # READ+WRITE, never executable
    poke4(flat, 120, 1)
    poke4(flat, 124, 6)
    poke8(flat, 128, gfoff)
    poke8(flat, 136, load_at + gfoff)
    poke8(flat, 144, load_at + gfoff)
    poke8(flat, 152, sl8 + pad + relsz)
    poke8(flat, 160, sl8 + pad + relsz + 65536)
    poke8(flat, 168, 4096)
    # PT_GNU_STACK: READ|WRITE, never EXECUTE
    poke4(flat, 176, 1685382481)
    poke4(flat, 180, 6)
    poke8(flat, 224, 16)
    i: 0
    as long as i < clen
        dummy: _sov_set_byte(flat, header_size + i,  _sov_list_get(code, i))
        i: i + 1
    si: 0
    as long as si < sl
        dummy: _sov_set_byte(flat, str_foff + si, _sov_buf_at(letters, si))
        si: si + 1
    glob_addr: load_at + header_size + glob_off
    i: 0
    as long as i < _sov_list_len(patch_at)
        at: _sov_list_get(patch_at, i)
        kind: _sov_list_get(patch_kind, i)
        val: _sov_list_get(patch_value, i)
        if same(kind, "rel26") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(task_at, fi)
                rel: (tgt - at) / 4
                if rel < 0
                    rel: rel + 67108864
                poke4(flat, header_size + at, 2483027968 + (rel % 67108864))
            if not
                print "Error: no such task" : val
                print _sov_list_get(patch_line, i)
                saw_error: 1
        if same(kind, "b26") = 1
            poke4(flat, header_size + at, 335544320 + (val % 67108864))
        if same(kind, "gw64s_a") = 1
            gsa2: str_addr
            poke4(flat, header_size + at, 3531603968 + (gsa2 % 65536) * 32)
            poke4(flat, header_size + at + 4, 4070572032 + ((gsa2 / 65536) % 65536) * 32)
            poke4(flat, header_size + at + 8, 4072669184 + ((gsa2 / 4294967296) % 65536) * 32)
            poke4(flat, header_size + at + 12, 4074766336 + ((gsa2 / 281474976710656) % 65536) * 32)
        if same(kind, "gw64s_n") = 1
            gsc: (sl + 7) / 8
            poke4(flat, header_size + at, 3531603969 + gsc * 32)
        if same(kind, "gw64a") = 1
            gwa2: glob_addr
            poke4(flat, header_size + at, 3531603968 + (gwa2 % 65536) * 32)
            poke4(flat, header_size + at + 4, 4070572032 + ((gwa2 / 65536) % 65536) * 32)
            poke4(flat, header_size + at + 8, 4072669184 + ((gwa2 / 4294967296) % 65536) * 32)
            poke4(flat, header_size + at + 12, 4074766336 + ((gwa2 / 281474976710656) % 65536) * 32)
        if same(kind, "gw64n") = 1
            poke4(flat, header_size + at, 3531603969 + _sov_list_len(global_names) * 32)
        if same(kind, "glob64") = 1
            gx: idx(global_names, val)
            ga: glob_addr + gx * 8
            poke4(flat, header_size + at, 3531603968 + (ga % 65536) * 32 + 9)
            poke4(flat, header_size + at + 4, 4070572032 + ((ga / 65536) % 65536) * 32 + 9)
            poke4(flat, header_size + at + 8, 4072669184 + ((ga / 4294967296) % 65536) * 32 + 9)
        if same(kind, "str64x0") = 1
            sa: str_addr + val
            poke4(flat, header_size + at, 3531603968 + (sa % 65536) * 32)
            poke4(flat, header_size + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32)
        if same(kind, "task_address64") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                fa: load_at + header_size + _sov_list_get(task_at, fi)
                poke4(flat, header_size + at, 3531603968 + (fa % 65536) * 32)
                poke4(flat, header_size + at + 4, 4070572032 + ((fa / 65536) % 65536) * 32)
                poke4(flat, header_size + at + 8, 4072669184 + ((fa / 4294967296) % 65536) * 32)
                poke4(flat, header_size + at + 12, 4074766336 + ((fa / 281474976710656) % 65536) * 32)
            if not
                print "Error: no such task" : val
                saw_error: 1
        if same(kind, "str64") = 1
            sa: str_addr + val
            poke4(flat, header_size + at, 3531603968 + (sa % 65536) * 32 + 1)
            poke4(flat, header_size + at + 4, 4070572032 + ((sa / 65536) % 65536) * 32 + 1)
        if same(kind, "adr") = 1
            # adr rd, pc + rel21: the string = in the same page, so a
            # one-instruction PC-relative load replaces two movk words
            sa: str_addr + val
            rel: sa - (load_at + header_size + at)
            if rel < 0
                rel: rel + 2097152
            poke4(flat, header_size + at, 268435456 + (rel % 4) * 536870912 + ((rel / 4) % 524288) * 32 + 1)
        if same(kind, "tadr") = 1
            # the walk's adr to the relocation table, rd in val
            rel2: gfoff + sl8 + pad - (header_size + at)
            if rel2 < 0
                rel2: rel2 + 2097152
            if rel2 >= 2097152
                print "Error: the pie table = out of adr range"
                saw_error: 1
            poke4(flat, header_size + at, 268435456 + (rel2 % 4) * 536870912 + ((rel2 / 4) % 524288) * 32 + val)
        if same(kind, "walk_jmp") = 1
            # an arm b targets the branch word itself plus imm*4,
            # not the word after it
            rl2: (moff - at) / 4
            if rl2 < 0
                rl2: rl2 + 67108864
            poke4(flat, header_size + at, 335544320 + (rl2 % 67108864))
        if same(kind, "wlen16") = 1
            sp: (gfoff + 4095) / 4096 * 4096
            poke4(flat, header_size + at, 3531603968 + (sp % 65536) * 32 + 4)
        if same(kind, "wlen32") = 1
            sp2: (gfoff + 4095) / 4096 * 4096
            poke4(flat, header_size + at, 4070572036 + ((sp2 / 65536) % 65536) * 32)
        if same(kind, "cbz_trap") = 1
            ti: idx(task_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(task_at, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, header_size + at, 3019898880 + (rl % 524288) * 32 + val)
        if same(kind, "b19_trap") = 1
            ti: idx(task_names, "_sov_trap")
            if ti > 0 - 1
                tg: _sov_list_get(task_at, ti)
                rl: (tg - at) / 4
                if rl < 0
                    rl: rl + 524288
                poke4(flat, header_size + at, 1409286144 + (rl % 524288) * 32 + 2)
        if same(kind, "rel") = 1
            fi: idx(task_names, val)
            if fi > 0 - 1
                tgt: _sov_list_get(task_at, fi)
                rel: tgt - (at + 4)
                poke4(flat, header_size + at, rel)
            if not
                print "Error: no such task" : val
                print _sov_list_get(patch_line, i)
                saw_error: 1
        if same(kind, "str") = 1
            poke8(flat, header_size + at, str_addr + val)
        if same(kind, "str32") = 1
            poke4(flat, header_size + at, str_addr + val)
        if same(kind, "glob") = 1
            gx: idx(global_names, val)
            poke8(flat, header_size + at, glob_addr + gx * 8)
        if same(kind, "gw64s_a") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "gw64a") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "glob64") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 3)
        if same(kind, "task_address64") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 4)
        if same(kind, "str64") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 2)
        if same(kind, "str64x0") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 2)
        if same(kind, "str") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 80)
        if same(kind, "str32") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 40)
        if same(kind, "glob") = 1
            reloc_at: _sov_list_add(reloc_at, at)
            rel_nw: _sov_list_add(rel_nw, 80)
        i: i + 1
    if saw_error = 1
        return
    # the walk's table: a count, then (link address, kind, spare)
    # triples. kind 80 heals a raw qword, 40 a dword, 2..4 a
    # movz/movk run
    tbl: gfoff + sl8 + pad
    poke8(flat, tbl, rel_n)
    ri: 0
    as long as ri < rel_n
        poke8(flat, tbl + 8 + ri * 16, load_at + header_size + _sov_list_get(reloc_at, ri))
        poke4(flat, tbl + 8 + ri * 16 + 8, _sov_list_get(rel_nw, ri))
        poke4(flat, tbl + 8 + ri * 16 + 12, 0)
        ri: ri + 1
    w: _sov_write_n(path, flat, filesz)
    if w = 0
        print "Error: cannot write output (is it running?)"
        fail
    if needs_private = 1
        # pass 140: a private program's binary carries its secrets -
        # literals, keys - in its string span; it belongs to its
        # owner alone
        _sov_chmod(path, 448)
    if not
        _sov_chmod(path, 493)
# remember where this compiler lives, so its library and runtime
# are found no matter which folder you run it from
start:
    compiler_folder: dirname(tidy_path(peek_ptr(g_argv, 0)))
    if g_argc < 2
        print "Usage: sovren <file.sov> [-o out]"
        print "sovren — native x86-64, self-contained"
        fail
    in_file: blank
    out_file: blank
    i: 1
    as long as i < g_argc
        arg: peek_ptr(g_argv, i)
        if same(arg, "--bare") = 1
            no_runtime: 1
        if not
            if same(arg, "-o") = 1
                i: i + 1
                if i < g_argc
                    out_file: peek_ptr(g_argv, i)
            if not
                if same(arg, "build") = 0
                    in_file: arg
        i: i + 1
    if length(in_file) = 0
        print "Error: no input"
        fail
    if length(out_file) = 0
        if holds(in_file, ".sov") = 1
            out_file: cut(in_file, 0, look(in_file, ".sov"))
        if not
            out_file: join(in_file, ".out")
    file_name: in_file
    print "Compiling" : in_file
    src: load_file(in_file)
    if src = 0
        print "Error: cannot read input"
        fail
    newline: "\n"
    src: join("# skip this line\n", src)
    libraries: blank
    src: expand_use_lines(src)
    extra: pull_uses(src)
    more: pull_uses(extra)
    as long as length(more) > 0
        extra: join(extra, more)
        more: pull_uses(more)
    if length(extra) > 0
        src: join(extra, src)
    heap_size: 12582912
    needs_runtime: uses_runtime(src)
    runtime: blank
    if no_runtime = 1
        needs_runtime: 0
    if needs_runtime = 1
        heap_size: 1073741824
        runtime: load_file("runtime.sov")
        if runtime = 0
            runtime: load_file("linux/runtime.sov")
        if runtime = 0
            runtime: load_file(join(compiler_folder, "/runtime.sov"))
        if runtime = 0
            runtime: load_file(join(compiler_folder, "/../runtime.sov"))
        if runtime = 0
            runtime: load_file(join(dirname(dirname(compiler_folder)), "/runtime.sov"))
        if runtime = 0
            print "Error: cannot read runtime"
            fail
    first_user_line: 1
    if length(runtime) > 0
        first_user_line: first_user_line + _sov_list_len(lines_of(runtime))
    if length(extra) > 0
        first_user_line: first_user_line + _sov_list_len(lines_of(extra))
    newline: "\n"
    all: join(runtime, newline)
    first_user_line: first_user_line + 1
    # the arm64 kernel numbers its syscalls differently. this
    # function = appended to the program being built (not to the
    # shared runtime, so other targets never carry it) and the
    # syscall builtin routes every number through it.
        all: join(all, "# mem_copy and mem_set, injected for the arm targets: the x86 back\n# end has them as one rep movsb / rep stosb each, and a shared library\n# may not use a builtin that only one machine has. written with\n# peek_byte and poke_byte, which are builtins on every target.\n_sov_mem_copy d s n:\n    i: 0\n    as long as i < n\n        poke_byte(d, i, peek_byte(s, i))\n        i: i + 1\n    return d\n\n_sov_mem_set d v n:\n    j: 0\n    as long as j < n\n        poke_byte(d, j, v)\n        j: j + 1\n    return d\n")
        first_user_line: first_user_line + 20
    all: join(all, "# a thread ends itself through this injected task, emitted\n# unconditionally because runtime.sov calls it whether or not the program\n# ever makes a syscall. on arm64 a thread = a detached clone, so ending it\n# = the exit syscall\n_sov_thread_exit:\n    syscall(60, 0, 0, 0, 0, 0, 0)\n    return 0 - 1\n")
    first_user_line: first_user_line + 6
    all: join(all, newline)
    all: join(all, "# x86 syscall number in, arm64 number out (the arm64 kernel\n# numbers its calls differently and has no plain open, pipe or\n# dup2; openat, pipe2 and dup3 stand in). Only the arm64 back end\n# calls this, so only arm64 builds carry it.\n_sov_sysnum n:\n    if n = 0\n        return 63\n    if n = 1\n        return 64\n    if n = 3\n        return 57\n    if n = 7\n        return 73\n    if n = 8\n        return 62\n    if n = 13\n        return 134\n    if n = 9\n        return 222\n    if n = 11\n        return 215\n    if n = 16\n        return 29\n")
    all: join(all, "    if n = 22\n        return 59\n    if n = 33\n        return 24\n    if n = 35\n        return 101\n    if n = 39\n        return 172\n    if n = 41\n        return 198\n    if n = 42\n        return 203\n    if n = 43\n        return 202\n    if n = 44\n        return 206\n    if n = 45\n        return 207\n    if n = 49\n        return 200\n    if n = 50\n        return 201\n    if n = 57\n        return 220\n    if n = 59\n        return 221\n    if n = 60\n        return 93\n    if n = 61\n        return 260\n    if n = 62\n        return 129\n")
    all: join(all, "    if n = 79\n        return 17\n    if n = 80\n        return 49\n    if n = 82\n        return 50\n    if n = 84\n        return 81\n    if n = 90\n        return 34\n    if n = 102\n        return 174\n    if n = 104\n        return 176\n    if n = 107\n        return 175\n    if n = 108\n        return 177\n    if n = 144\n        return 227\n    if n = 217\n        return 61\n    if n = 218\n        return 169\n    if n = 228\n        return 115\n    if n = 231\n        return 94\n    if n = 257\n        return 56\n    if n = 260\n        return 166\n    if n = 302\n        return 261\n    if n = 318\n        return 278\n    if n = 56\n        return 220\n    if n = 202\n        return 98\n    if n = 72\n        return 25\n    if n = 74\n        return 82\n    if n = 77\n        return 46\n    if n = 262\n        return 79\n    if n = 263\n        return 35\n    return n\n")
    all: join(all, newline)
    # these extra lines shift the error-line base, so the jobs
    # after them still count as library jobs, not user jobs
    first_user_line: first_user_line + 81

    all: join(all, src)
    compile(all)
    write_program(out_file)
    if saw_error = 1
        fail
    print "Wrote" : out_file
start
push_reg n:
    emitw(4162785248 + n)

# ldr xN,[sp],#16
emit_write_lit s:
    n: length(s)
    set_reg(0, 1)
    off: intern_nz(s)
    at: here()
    emitw(268435456 + 1)
    later_fill(at, "adr", off)
    set_reg(2, n)
    set_reg(8, sc_write)
    ask_kernel

# mmap(0, sz, RW, PRIVATE|ANON, -1, 0) -> x0
emit_print:
    task_names: _sov_list_add(task_names, "_sov_print")
    task_at: _sov_list_add(task_at, here())
    # a value under 65536 is not a real address. reading from it
    # would crash, so hand it to the number printer instead.
    emitw(4047519775)
    hi: here()
    emitw(1409286146)
    used_print_number: 1
    print_number
    ret
    put_arm(hi, here() - hi)
    emitw(2847702013)
    emitw(2835436531)
    emitw(2835504117)
    emitw(4177533943)
    emitw(2432697341)
    mov_reg(19, 0)
    mov_reg(9, 19)
    set_reg(20, 0)
    top: here()
    emitw(2333344042)
    emitw(960495947)
    emitw(1895825791)
    ex: here()
    emitw(1409286144)
    emitw(2432698004)
    bp: here()
    emitw(335544320)
    put_arm(bp, top - bp)
    put_here(ex)
    set_reg(0, 1)
    mov_reg(1, 19)
    mov_reg(2, 20)
    set_reg(8, sc_write)
    ask_kernel
    set_reg(0, 1)
    nl_at: here()
    emitw(268435456 + 1)
    later_fill(nl_at, "adr", intern_nz("\n"))
    set_reg(2, 1)
    set_reg(8, sc_write)
    ask_kernel
    emitw(2432697279)
    emitw(2839630835)
    emitw(2839698421)
    emitw(4181728247)
    emitw(2831449085)
    ret

# x0 = number, writes it in decimal then a newline
put_sub_sp at n:
    v: n
    if v < 0
        v: 0
    oc_set_word(at, 3506439167 + (v % 4096) * 1024)
    return 0

spawn_emit name how_many:
    if how_many = 1
        take_from_stack
    if not
        if how_many = 2
            pop_reg(1)
            take_from_stack
        if not
            if how_many = 3
                pop_reg(2)
                pop_reg(1)
                take_from_stack
            if not
                if how_many = 4
                    pop_reg(3)
                    pop_reg(2)
                    pop_reg(1)
                    take_from_stack
                if not
                    if how_many = 5
                        pop_reg(4)
                        pop_reg(3)
                        pop_reg(2)
                        pop_reg(1)
                        take_from_stack
                    if not
                        if how_many = 6
                            pop_reg(5)
                            pop_reg(4)
                            pop_reg(3)
                            pop_reg(2)
                            pop_reg(1)
                            take_from_stack
    mov_reg(6, 5)
    mov_reg(5, 4)
    mov_reg(4, 3)
    mov_reg(3, 2)
    mov_reg(2, 1)
    mov_reg(1, 0)
    aat: here()
    movz_x(0, 0, 0)
    movk_x(0, 0, 1)
    movk_x(0, 0, 2)
    movk_x(0, 0, 3)
    later_fill(aat, "task_address64", name)
    start_thread
    return 0
