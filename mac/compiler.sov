load_glob name:
    emit(73)
    emit(187)
    at: here()
    emit8(0)
    addp(at, "glob", name)
    emit(73)
    emit(139)
    emit(3)
store_glob name:
    emit(73)
    emit(187)
    at: here()
    emit8(0)
    addp(at, "glob", name)
    emit(73)
    emit(137)
    emit(3)
slot name:
    i: idx(locals, name)
    if i > 0 - 1
        return i
    locals: _sov_list_add(locals, name)
    return _sov_list_len(locals) - 1
cset name val:
    ci: idx(cnms, name)
    if ci > 0 - 1
        cvls: _sov_list_set(cvls, ci, val)
        cemt: _sov_list_set(cemt, ci, 0)
        return
    cnms: _sov_list_add(cnms, name)
    cvls: _sov_list_add(cvls, val)
    cemt: _sov_list_add(cemt, 0)
cflush name:
    ci: idx(cnms, name)
    if ci < 0
        return
    if _sov_list_get(cemt, ci) is 1
        return
    rax_imm(_sov_list_get(cvls, ci))
    cemt: _sov_list_set(cemt, ci, 1)
    if idx(locals, name) < 0
        if idx(glob_names, name) > 0 - 1
            store_glob(name)
            return
    store_loc(slot(name))
cflush_all:
    i: 0
    as long as i < _sov_list_len(cnms)
        if _sov_list_get(cemt, i) is 0
            cflush(_sov_list_get(cnms, i))
        i: i + 1
loadv name:
    cflush(name)
    g: idx(glob_names, name)
    if g > 0 - 1
        if idx(locals, name) < 0
            load_glob(name)
            return
    i: idx(locals, name)
    if i > 0 - 1
        load_loc(i)
        return
    if g > 0 - 1
        load_glob(name)
        return
    print "Error: no such name"
    _sov_print(name)
    print err_line
    had_err: 1
    load_loc(slot(name))
storev name:
    ci: idx(cnms, name)
    if ci > 0 - 1
        cemt: _sov_list_set(cemt, ci, 1)
    g: idx(glob_names, name)
    if g > 0 - 1
        if idx(locals, name) < 0
            store_glob(name)
            return
    i: idx(locals, name)
    if i > 0 - 1
        store_loc(i)
        return
    if g > 0 - 1
        store_glob(name)
        return
    store_loc(slot(name))
mark_str name:
    if idx(str_vars, name) < 0
        str_vars: _sov_list_add(str_vars, name)
drop_str name:
    di: idx(str_vars, name)
