expr e0:
    ex_depth: ex_depth + 1
    if ex_depth > 150
        if had_err is 0
            print "Error: expression too long, split it up"
            print err_line
            had_err: 1
        ex_depth: ex_depth - 1
        xor_rax()
        return 0
    t: expr_body(e0)
    ex_depth: ex_depth - 1
    return t

expr_body e0:
    e: strip(e0)
    if length(e) is 0
        xor_rax()
        return 0
    if length(e) > 0
        if _sov_byte_at(e, 0) is 34
            if length(e) > 1
                rax_str(cut(e, 1, length(e) - 1))
                return 1
            rax_str("")
            return 1
    if starts(e, "as text ") is 1
        expr(cut(e, 8, length(e)))
        return 1
    # addr_of name -- where a job lives in memory, so a C library
    # can be told to call back into Sovren
    if starts(e, "addr_of ") is 1
        emit(72)
        emit(184)
        aat: here()
        emit8(0)
        addp(aat, "fnaddr", strip(cut(e, 8, length(e))))
        return 0
    if starts(e, "length of ") is 1
        expr(cut(e, 10, length(e)))
        mov_rdi_rax()
        used_sl: 1
        calln("_sov_strlen")
        return 0
    e: strip(cops(e))
    p: fop(e, "||")
    if p > 0 - 1
        expr(cut(e, 0, p))
        test_rax()
        a: jnz()
        expr(cut(e, p + 2, length(e)))
        test_rax()
        b: jnz()
        xor_rax()
        d: jmp()
        patch(a)
        patch(b)
        rax_imm(1)
        patch(d)
        return 0
    p: fop(e, "&&")
    if p > 0 - 1
        expr(cut(e, 0, p))
        test_rax()
        a: jz()
        expr(cut(e, p + 2, length(e)))
        test_rax()
        b: jz()
        rax_imm(1)
        d: jmp()
        patch(a)
        patch(b)
        xor_rax()
        patch(d)
        return 0
    p: fop(e, "==")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "eq")
        return 0
    p: fop(e, "!=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "ne")
        return 0
    p: fop(e, "<=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "le")
        return 0
    p: fop(e, ">=")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 2, length(e)), "ge")
        return 0
    p: fop(e, "<")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "lt")
        return 0
    p: fop(e, ">")
    if p > 0 - 1
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "gt")
        return 0
    p: fop2(e, "+", "-")
    if p > 0
        if same(letter(e, p), "+") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "add")
            return 0
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "sub")
        return 0
    if p is 0
        if same(letter(e, p), "+") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "add")
            return 0
    p: fop3(e)
    if p > 0 - 1
        o: letter(e, p)
        if same(o, "*") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "mul")
            return 0
        if same(o, "/") is 1
            bin(cut(e, 0, p), cut(e, p + 1, length(e)), "div")
            return 0
        bin(cut(e, 0, p), cut(e, p + 1, length(e)), "mod")
        return 0
    if same(e, "blank") is 1
        rax_str("")
        return 1
    if length(e) > 0
        if _sov_byte_at(e, 0) is 34
            rax_str(cut(e, 1, length(e) - 1))
            return 1
    if starts(e, "(") is 1
        if same(letter(e, length(e) - 1), ")") is 1
            expr(cut(e, 1, length(e) - 1))
            return 0
    lp: look(e, "(")
    if lp > 0
        if same(letter(e, length(e) - 1), ")") is 1
            name: strip(cut(e, 0, lp))
            inside: cut(e, lp + 1, length(e) - 1)
            argc: 0
            if length(strip(inside)) > 0
                depth: 0
                ins: 0
                start: 0
                i: 0
                ilen: length(inside)
                as long as i < ilen
                    c: letter(inside, i)
                    if ins is 1
                        if _sov_byte_at(inside, i) is 92
                            i: i + 1
                        if not
                            if _sov_byte_at(inside, i) is 34
                                ins: 0
                    if not
                        if _sov_byte_at(inside, i) is 34
                            ins: 1
                        if not
                            if same(c, "(") is 1
                                depth: depth + 1
                            if not
                                if same(c, ")") is 1
                                    depth: depth - 1
                                if not
                                    if same(c, ",") is 1
                                        if depth is 0
                                            expr(cut(inside, start, i))
                                            push_rax()
                                            argc: argc + 1
                                            start: i + 1
                    i: i + 1
                expr(cut(inside, start, ilen))
                push_rax()
                argc: argc + 1
            axi: idx(ar_names, name)
            if axi > 0 - 1
                if _sov_list_get(ar_cnt, axi) is not argc
                    print "Error: wrong number of values"
                    _sov_print(name)
                    print err_line
                    had_err: 1
            call_args(name, argc)
            if same(name, "cat") is 1
                return 1
            if same(name, "strcat") is 1
                return 1
            if same(name, "_sov_strcat") is 1
                return 1
            if same(name, "sub") is 1
                return 1
            if same(name, "trim") is 1
                return 1
            if same(name, "ch") is 1
                return 1
            if same(name, "_sov_substring") is 1
                return 1
            if idx(str_fns, name) > 0 - 1
                return 1
            return 0
    if digit(letter(e, 0)) is 1
        dq: 0
        as long as dq < length(e)
            if digit(letter(e, dq)) is 0
                print "Error: do not know these words"
                _sov_print(e)
                print err_line
                had_err: 1
                xor_rax()
                return 0
            dq: dq + 1
        rax_imm(_sov_atoi(e))
        return 0
    if starts(e, "-") is 1
        if length(e) > 1
            if digit(letter(e, 1)) is 1
                rax_imm(0 - _sov_atoi(cut(e, 1, length(e))))
                return 0
    if look(e, " ") > 0 - 1
        print "Error: do not know these words"
        _sov_print(e)
        print err_line
        had_err: 1
        xor_rax()
        return 0
    vn: e
    loadv(vn)
    if idx(str_vars, vn) > 0 - 1
        return 1
    return 0
stmt line:
    s: strip(line)
    if length(s) is 0
        return
    if starts(s, "#") is 1
        return
    q: 0
    qi: 0
    as long as qi < length(s)
        if _sov_byte_at(s, qi) is 92
            qi: qi + 1
        if not
            if _sov_byte_at(s, qi) is 34
                q: q + 1
        qi: qi + 1
    if q % 2 is not 0
        print "Error: unterminated text"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    if length(s) > 1000
        print "Error: line too long, split it up"
        print err_line
        had_err: 1
        return
    if bad_eq(s) is 1
        return
    if starts(s, "note:") is 1
        print "Error: note: is not a word, use #"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    if starts(s, "use ") is 1
        return
    if same(s, "private") is 1
        return
    if starts(s, "wipe ") is 1
        expr(strip(cut(s, 5, length(s))))
        mov_rdi_rax()
        emit(72)
        emit(133)
        emit(255)
        wsk: jz()
        emit(87)
        used_sl: 1
        calln("_sov_strlen")
        emit(72)
        emit(137)
        emit(193)
        emit(95)
        xor_rax()
        emit(252)
        emit(243)
        emit(170)
        patch(wsk)
        return
    if starts(s, "print ") is 1
        arg: strip(cut(s, 6, length(s)))
        if ends_times(arg) is 1
            head: strip(cut(arg, 0, length(arg) - 6))
            sp: find_last_sp(head)
            if sp > 0 - 1
                do_print_times(strip(cut(head, 0, sp)), strip(cut(head, sp + 1, length(head))))
                return
        if length(arg) > 1
            if _sov_byte_at(arg, 0) is 34
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
        if starts(arg, "peek_byte(") is 1
            if opt_imm > 0
                emit_write_lit(i2s(opt_imm))
                return
        typ: expr(arg)
        mov_rdi_rax()
        if typ is 1
            used_pr: 1
            calln("_sov_print")
        if not
            used_pi: 1
            calln("_sov_print_int")
        return
    had_col: 0
    col: find_col(s)
    if col > 0
        if col < length(s) - 1
            had_col: 1
            s: join("<-- ", join(strip(cut(s, 0, col)), join(" := ", strip(cut(s, col + 1, length(s))))))
    if starts(s, "<-- ") is 1
        if had_col is 0
            print "Error: bad line"
            _sov_print(s)
            print err_line
            had_err: 1
            return
        rest: cut(s, 4, length(s))
        t: find_sep(rest)
        if t > 0 - 1
            var: repl(strip(cut(rest, 0, t)), " ", "_")
            rhs: strip(cut(rest, t + 4, length(rest)))
            if same(rhs, join(var, " + 1")) is 1
                inc_var(var)
                return
            if same(rhs, join(var, " - 1")) is 1
                dec_var(var)
                return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            pref: join(var, " + ")
            if starts(rhs, pref) is 1
                other: strip(cut(rhs, length(pref), length(rhs)))
                if length(other) > 0
                    if look(other, "(") < 0
                        if look(other, " ") < 0
                            if digit(letter(other, 0)) is 1
                                add_imm(var, _sov_atoi(other))
                                drop_str(var)
                                return
                            add_into(var, repl(other, " ", "_"))
                            drop_str(var)
                            return
            if length(rhs) > 0
                if digit(letter(rhs, 0)) is 1
                    if look(rhs, " ") < 0
                        nv: _sov_atoi(rhs)
                        cset(var, nv)
                        if nv > 0
                            kn: var
                            kv: nv
                        drop_str(var)
                        if has_vm is 0
                            return
            if try_alloc_imm(var, rhs) is 1
                mark_str(var)
                return
            typ: expr(rhs)
            storev(var)
            if typ is 1
                mark_str(var)
            if not
                drop_str(var)
            if starts(rhs, "_sov_strlen(") is 1
                if did_stos is 1
                    if kv > 0
                        kn: var
        return
    if same(s, "return") is 1
        xor_rax()
        leave()
        ret()
        return
    if starts(s, "return ") is 1
        typ: expr(cut(s, 7, length(s)))
        if typ is 1
            saw_str: 1
        leave()
        ret()
        return
    if same(s, "stop") is 1
        emit(49)
        emit(255)
        emit(184)
        emit(60)
        emit(0)
        emit(0)
        emit(0)
        sysc()
        return
    if look(s, "(") < 0
        print "Error: bad line"
        _sov_print(s)
        print err_line
        had_err: 1
        return
    expr(s)
nind line:
    c: 0
    i: 0
    as long as i < length(line)
        if _sov_byte_at(line, i) is 9
            print "Error: tab indent, use spaces"
            _sov_print(line)
            print err_line
            had_err: 1
            return c
        if same(letter(line, i), " ") is 1
            c: c + 1
        if not
            return c
        i: i + 1
    return c
bk: 0
bi: 0
bj: 0
bs: 0
be: 0
br: 0
popblk:
    last: _sov_list_len(bk) - 1
    k: _sov_list_get(bk, last)
    if same(k, "while") is 1
        st: _sov_list_get(bs, last)
        at: jmp()
        put(at, st - (at + 4))
        patch(_sov_list_get(bj, last))
    if not
        if same(k, "forever") is 1
            st: _sov_list_get(bs, last)
            at: jmp()
            put(at, st - (at + 4))
        if not
            if same(k, "repeat") is 1
                rs: _sov_list_get(br, last)
                load_loc(rs)
                emit(72)
                emit(255)
                emit(192)
                store_loc(rs)
                st: _sov_list_get(bs, last)
                at: jmp()
                put(at, st - (at + 4))
                patch(_sov_list_get(bj, last))
            if not
                if same(k, "try") is 1
                    tb2: _sov_list_get(bs, last)
                    if tb2 is 0
                        print "Error: try needs an except"
                        had_err: 1
                    if not
                        patch(tb2)
                if not
                    if same(k, "except") is 1
                        skipme: 0
                    if not
                        z: _sov_list_get(bj, last)
                        if z > 0 - 1
                            patch(z)
                        je: _sov_list_get(be, last)
                        ji: 0
                as long as ji < _sov_list_len(je)
                    patch(_sov_list_get(je, ji))
                    ji: ji + 1
    nk: _sov_list_new()
    ni: _sov_list_new()
    nj: _sov_list_new()
    ns: _sov_list_new()
    ne: _sov_list_new()
    nr: _sov_list_new()
    pi: 0
    as long as pi < last
        nk: _sov_list_add(nk, _sov_list_get(bk, pi))
        ni: _sov_list_add(ni, _sov_list_get(bi, pi))
        nj: _sov_list_add(nj, _sov_list_get(bj, pi))
        ns: _sov_list_add(ns, _sov_list_get(bs, pi))
        ne: _sov_list_add(ne, _sov_list_get(be, pi))
        nr: _sov_list_add(nr, _sov_list_get(br, pi))
        pi: pi + 1
    bk: nk
    bi: ni
    bj: nj
    bs: ns
    be: ne
    br: nr
emit_sum_closed acc iv lim:
    limn: 0
    if same(lim, kn) is 1
        if kv > 0
            limn: kv
    if limn is 0
        if length(lim) > 0
            if digit(letter(lim, 0)) is 1
                if look(lim, " ") < 0
                    limn: _sov_atoi(lim)
    if limn > 0
        total: limn * limn - limn
        total: total / 2
        rax_imm(total)
        storev(acc)
        rax_imm(limn)
        storev(iv)
        kn: acc
        kv: total
        return
    emit_name_or_imm(lim)
    push_rax()
    loadv(iv)
    mov_rcx_rax()
    pop_rax()
    sub_rax_rcx()
    test_rax()
    sk: jle()
    push_rax()
    loadv(iv)
    push_rax()
    emit_name_or_imm(lim)
    mov_rcx_rax()
    pop_rax()
    add_rax_rcx()
    emit(72)
    emit(255)
    emit(200)
    pop_rcx()
    imul_rax_rcx()
    emit(72)
    emit(209)
    emit(232)
    mov_rcx_rax()
    loadv(acc)
    add_rax_rcx()
    storev(acc)
    emit_name_or_imm(lim)
    storev(iv)
    patch(sk)
