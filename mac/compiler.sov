lines_of source:
    lst: _sov_list_new()
    start: 0
    i: 0
    n: length(source)
    as long as i < n
        if _sov_byte_at(source, i) is 10
            lst: _sov_list_add(lst, cut(source, start, i))
            start: i + 1
        i: i + 1
    if start < n
        lst: _sov_list_add(lst, cut(source, start, n))
    return lst
tname line:
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            return repl(strip(cut(s, 0, wp)), " ", "_")
        sp: look(s, " ")
        if sp > 0 - 1
            return strip(cut(s, 0, sp))
        return s
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp > 0 - 1
        return repl(strip(cut(rest, 0, wp)), " ", "_")
    sp: look(rest, " ")
    if sp > 0 - 1
        return repl(strip(cut(rest, 0, sp)), " ", "_")
    return repl(rest, " ", "_")
tparams line:
    lst: _sov_list_new()
    s: strip(line)
    if is_task_hdr(s) is 1
        s: strip(cut(s, 0, length(s) - 1))
        if starts(s, "task ") is 1
            s: strip(cut(s, 5, length(s)))
        wp: look(s, " with ")
        if wp > 0 - 1
            s: strip(cut(s, wp + 6, length(s)))
        if not
            sp: look(s, " ")
            if sp < 0
                return lst
            s: strip(cut(s, sp + 1, length(s)))
        p: repl(s, ",", " ")
        p: repl(p, " and ", " ")
        start: 0
        i: 0
        n: length(p)
        as long as i < n
            if same(letter(p, i), " ") is 1
                one: strip(cut(p, start, i))
                if length(one) > 0
                    lst: _sov_list_add(lst, one)
                start: i + 1
            i: i + 1
        one: strip(cut(p, start, n))
        if length(one) > 0
            lst: _sov_list_add(lst, one)
        return lst
    rest: strip(cut(line, 5, length(line)))
    wp: look(rest, " with ")
    if wp < 0
        return lst
    p: repl(cut(rest, wp + 6, length(rest)), ",", " and ")
    start: 0
    i: 0
    n: length(p)
    as long as i < n
        if starts(cut(p, i, n), " and ") is 1
            one: repl(strip(cut(p, start, i)), " ", "_")
            if length(one) > 0
                lst: _sov_list_add(lst, one)
            start: i + 5
            i: i + 5
        if not
            i: i + 1
    one: repl(strip(cut(p, start, n)), " ", "_")
    if length(one) > 0
        lst: _sov_list_add(lst, one)
    return lst
