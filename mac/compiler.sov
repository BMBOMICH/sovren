try_opt_while cond blines:
    if _sov_list_len(blines) is not 2
        return 0
    c: strip(cops(cond))
    p: look(c, " < ")
    if p < 0
        return 0
    iv: repl(strip(cut(c, 0, p)), " ", "_")
    lim: repl(strip(cut(c, p + 3, length(c))), " ", "_")
    l1: strip(_sov_list_get(blines, 0))
    l2: strip(_sov_list_get(blines, 1))
    inc1: same(l1, join(join("<-- ", iv), " := "))
    inc_a: join(join("<-- ", iv), " := ")
    inc_b: join(iv, " + 1")
    isinc1: 0
    if starts(l1, inc_a) is 1
        if same(cut(l1, length(inc_a), length(l1)), inc_b) is 1
            isinc1: 1
    isinc2: 0
    if starts(l2, inc_a) is 1
        if same(cut(l2, length(inc_a), length(l2)), inc_b) is 1
            isinc2: 1
    if isinc1 is 0
        if isinc2 is 0
            return 0
    work: l1
    if isinc1 is 1
        work: l2
    if starts(work, "<-- ") is 1
        rest: cut(work, 4, length(work))
        t: find_sep(rest)
        if t > 0 - 1
            acc: repl(strip(cut(rest, 0, t)), " ", "_")
            rhs: strip(cut(rest, t + 4, length(rest)))
            if same(rhs, join(join(acc, " + "), iv)) is 1
                emit_sum_closed(acc, iv, lim)
                return 1
            if same(rhs, join(join(acc, " + "), iv)) is 1
                emit_sum_closed(acc, iv, lim)
                return 1
            pfx: join(acc, " + peek_i64(")
            if starts(rhs, pfx) is 1
                if same(letter(rhs, length(rhs) - 1), ")") is 1
                    inn: cut(rhs, length(pfx), length(rhs) - 1)
                    cm: look(inn, ",")
                    if cm > 0
                        ap: strip(cut(inn, 0, cm))
                        ix: strip(cut(inn, cm + 1, length(inn)))
                        if same(ix, join(iv, " times 8")) is 1
                            if same(ap, iota_ptr) is 1
                                if same(lim, iota_lim) is 1
                                    emit_sum_closed(acc, iv, lim)
                                    return 1
                            loadv(ap)
                            push_rax()
                            loadv(iv)
                            emit(72)
                            emit(193)
                            emit(224)
                            emit(3)
                            mov_rcx_rax()
                            pop_rax()
                            add_rax_rcx()
                            mov_rsi_rax()
                            loadv(lim)
                            push_rax()
                            loadv(iv)
                            mov_rcx_rax()
                            pop_rax()
                            sub_rax_rcx()
                            test_rax()
                            skc: jle()
                            mov_rcx_rax()
                            emit(197)
                            emit(253)
                            emit(239)
                            emit(192)
                            lpc: here()
                            emit(72)
                            emit(131)
                            emit(249)
                            emit(4)
                            tlc: jb()
                            emit(197)
                            emit(254)
                            emit(111)
                            emit(14)
                            emit(197)
                            emit(253)
                            emit(212)
                            emit(193)
                            emit(72)
                            emit(131)
                            emit(198)
                            emit(32)
                            emit(72)
                            emit(131)
                            emit(233)
                            emit(4)
                            jbc: jmp()
                            put(jbc, lpc - (jbc + 4))
                            patch(tlc)
                            emit(196)
                            emit(227)
                            emit(125)
                            emit(57)
                            emit(193)
                            emit(1)
                            emit(197)
                            emit(249)
                            emit(212)
                            emit(193)
                            emit(197)
                            emit(249)
                            emit(112)
                            emit(200)
                            emit(78)
                            emit(197)
                            emit(249)
                            emit(212)
                            emit(193)
                            emit(196)
                            emit(225)
                            emit(249)
                            emit(126)
                            emit(192)
                            emit(72)
                            emit(133)
                            emit(201)
                            dnc: jz()
                            lpt: here()
                            emit(72)
                            emit(3)
                            emit(6)
                            emit(72)
                            emit(131)
                            emit(198)
                            emit(8)
                            emit(72)
                            emit(255)
                            emit(201)
                            emit(15)
                            emit(133)
                            ajt: here()
                            emit4(0)
                            put(ajt, lpt - (ajt + 4))
                            patch(dnc)
                            mov_rcx_rax()
                            loadv(acc)
                            add_rax_rcx()
                            storev(acc)
                            emit(197)
                            emit(248)
                            emit(119)
                            loadv(lim)
                            storev(iv)
                            patch(skc)
                            return 1
    if starts(work, "poke_byte(") is 1
        if same(letter(work, length(work) - 1), ")") is 1
            inside: cut(work, 10, length(work) - 1)
            p1: look(inside, ",")
            if p1 > 0
                ptr: strip(cut(inside, 0, p1))
                rest: cut(inside, p1 + 1, length(inside))
                p2: look(rest, ",")
                if p2 > 0
                    ix: strip(cut(rest, 0, p2))
                    bv: strip(cut(rest, p2 + 1, length(rest)))
                    if same(ix, iv) is 1
                        if starts(bv, "peek_byte(") is 1
                            if same(letter(bv, length(bv) - 1), ")") is 1
                                inn: cut(bv, 10, length(bv) - 1)
                                q: look(inn, ",")
                                if q > 0
                                    src: strip(cut(inn, 0, q))
                                    ix2: strip(cut(inn, q + 1, length(inn)))
                                    if same(ix2, iv) is 1
                                        emit_rep_movs(ptr, src, iv, lim)
                                        return 1
                        if digit(letter(bv, 0)) is 1
                            opt_imm: _sov_atoi(bv)
                            emit_rep_stos(ptr, iv, lim)
                            return 1
    if starts(work, "poke_i64(") is 1
        if same(letter(work, length(work) - 1), ")") is 1
            inside: cut(work, 9, length(work) - 1)
            p1: look(inside, ",")
            if p1 > 0
                ptr: strip(cut(inside, 0, p1))
                rest: cut(inside, p1 + 1, length(inside))
                p2: look(rest, ",")
                if p2 > 0
                    ix: strip(cut(rest, 0, p2))
                    vv: strip(cut(rest, p2 + 1, length(rest)))
                    if same(ix, join(iv, " times 8")) is 1
                        if same(vv, iv) is 1
                            iota_ptr: ptr
                            iota_lim: lim
                            if same(lim, kn) is 1
                                if kv > 0
                                    return 1
                            loadv(lim)
                            storev(iv)
                            return 1
    return 0
try_alloc_imm var rhs:
    if starts(rhs, "_sov_alloc(") is 0
        return 0
    if same(var, skip_al) is 1
        return 1
    if has_vm is 0
        if same(letter(rhs, length(rhs) - 1), ")") is 1
            inn: strip(cut(rhs, 11, length(rhs) - 1))
            asz: 0
            if same(inn, kn) is 1
                if kv > 0
                    asz: kv
            if asz is 0
                if length(inn) > 0
                    if digit(letter(inn, 0)) is 1
                        if look(inn, " ") < 0
                            asz: _sov_atoi(inn)
            if asz > 511
                emit_mmap_k(asz)
                storev(var)
                return 1
    return 0
emit_name_or_imm e:
    e: strip(e)
    if length(e) is 0
        xor_rax()
        return
    if digit(letter(e, 0)) is 1
        rax_imm(_sov_atoi(e))
        return
    if starts(e, "-") is 1
        if length(e) > 1
            if digit(letter(e, 1)) is 1
                rax_imm(0 - _sov_atoi(cut(e, 1, length(e))))
                return
    loadv(repl(e, " ", "_"))
emit_cmp_jge cond:
    return 0 - 1
collect_body lines start bind:
    out: _sov_list_new()
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    out: _sov_list_add(out, s)
                    j: j + 1
                if not
                    return out
    return out
skip_body lines start bind:
    j: start
    n: _sov_list_len(lines)
    as long as j < n
        raw: _sov_list_get(lines, j)
        s: strip(raw)
        if length(s) is 0
            j: j + 1
        if not
            if starts(s, "#") is 1
                j: j + 1
            if not
                if nind(raw) > bind
                    j: j + 1
                if not
                    return j
    return j
body lines:
    n: _sov_list_len(lines)
    i: 0
    bk: _sov_list_new()
    bi: _sov_list_new()
    bj: _sov_list_new()
    bs: _sov_list_new()
    be: _sov_list_new()
    br: _sov_list_new()
    as long as i < n
        raw: _sov_list_get(lines, i)
        s: strip(raw)
        err_line: i + 1
        if _sov_list_len(stmt_lns) > i
            err_line: _sov_list_get(stmt_lns, i)
        ind: nind(raw)
        if length(s) is 0
            i: i + 1
        if not
            if starts(s, "#") is 1
                i: i + 1
            if not
                isel: 0
                if same(s, "if not") is 1
                    isel: 1
                if starts(s, "except") is 1
                    isel: 1
                popgo: 1
                as long as popgo is 1
                    if _sov_list_len(bk) is 0
                        popgo: 0
                    if not
                        last: _sov_list_len(bk) - 1
                        if ind > _sov_list_get(bi, last)
                            popgo: 0
                        if not
                            stay: 0
                            if isel is 1
                                if ind is _sov_list_get(bi, last)
                                    if same(_sov_list_get(bk, last), "if") is 1
                                        stay: 1
                                    if same(_sov_list_get(bk, last), "try") is 1
                                        stay: 1
                            if stay is 1
                                popgo: 0
                            if not
                                popblk()
                loop_ok: 0
                if bad_eq(s) is 1
                    s: "if 0"
                if starts(s, "as long as ") is 1
                    s: join("while ", strip(cut(s, 11, length(s))))
                    loop_ok: 1
                if starts(s, "if ") is 1
                    if same(s, "if not") is 0
                        if starts(s, "if not ") is 0
                            expr(cut(s, 3, length(s)))
                            test_rax()
                            z: jz()
                            bk: _sov_list_add(bk, "if")
                            bi: _sov_list_add(bi, ind)
                            bj: _sov_list_add(bj, z)
                            bs: _sov_list_add(bs, 0)
                            be: _sov_list_add(be, _sov_list_new())
                            br: _sov_list_add(br, 0)
                        if not
                            stmt(s)
                    if not
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                if not
                    if same(s, "\x00__removed_and_if_not") is 1
                        last: _sov_list_len(bk) - 1
                        if last > 0 - 1
                            je: jmp()
                            patch(_sov_list_get(bj, last))
                            old: _sov_list_get(be, last)
                            old: _sov_list_add(old, je)
                            be: _sov_list_set(be, last, old)
                            bk: _sov_list_set(bk, last, "else")
                            bj: _sov_list_set(bj, last, 0 - 1)
                    if not
                        if starts(s, "do while ") is 1
                            bln: collect_body(lines, i + 1, ind)
                            if try_opt_while(cut(s, 9, length(s)), bln) is 1
                                i: skip_body(lines, i + 1, ind)
                                i: i - 1
                            if not
                                cflush_all()
                                st: here()
                                z: emit_cmp_jge(cut(s, 9, length(s)))
                                if z is 0 - 1
                                    expr(cut(s, 9, length(s)))
                                    test_rax()
                                    z: jz()
                                bk: _sov_list_add(bk, "while")
                                bi: _sov_list_add(bi, ind)
                                bj: _sov_list_add(bj, z)
                                bs: _sov_list_add(bs, st)
                                be: _sov_list_add(be, _sov_list_new())
                                br: _sov_list_add(br, 0)
                        if not
                            if loop_ok is 1
                                bln: collect_body(lines, i + 1, ind)
                                if try_opt_while(cut(s, 6, length(s)), bln) is 1
                                    i: skip_body(lines, i + 1, ind)
                                    i: i - 1
                                if not
                                    cflush_all()
                                    st: here()
                                    z: emit_cmp_jge(cut(s, 6, length(s)))
                                    if z is 0 - 1
                                        expr(cut(s, 6, length(s)))
                                        test_rax()
                                        z: jz()
                                    bk: _sov_list_add(bk, "while")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, z)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                            if not
                                if same(s, "do forever") is 1
                                    st: here()
                                    bk: _sov_list_add(bk, "forever")
                                    bi: _sov_list_add(bi, ind)
                                    bj: _sov_list_add(bj, 0 - 1)
                                    bs: _sov_list_add(bs, st)
                                    be: _sov_list_add(be, _sov_list_new())
                                    br: _sov_list_add(br, 0)
                                if not
                                    if starts(s, "\x00__removed_repeat ") is 1
                                        cflush_all()
                                        tmp: cut(s, 7, length(s))
                                        tp: look(tmp, " times")
                                        if tp > 0 - 1
                                            tmp: cut(tmp, 0, tp)
                                        expr(tmp)
                                        cn: "__rep_c"
