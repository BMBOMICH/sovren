    emit8(intern(s))
    addp(at, "str", intern(s))
repl text old new:
    n: length(text)
    o: length(old)
    gn: length(new)
    r: _sov_alloc(n + gn + 8)
    p: 0
    j: 0
    ins: 0
    as long as p < n
        b: _sov_byte_at(text, p)
        if ins is 1
            if b is 92
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if p < n
                    poke_byte(r, j, _sov_byte_at(text, p))
                    j: j + 1
                    p: p + 1
            if not
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
                poke_byte(r, j, b)
                j: j + 1
                p: p + 1
            if not
                if starts(cut(text, p, n), old) is 1
                    k: 0
                    as long as k < gn
                        poke_byte(r, j, _sov_byte_at(new, k))
                        j: j + 1
                        k: k + 1
                    p: p + o
                if not
                    poke_byte(r, j, b)
                    j: j + 1
                    p: p + 1
    poke_byte(r, j, 0)
    return r
bad_eq s:
    ep: fop(s, "=")
    if ep > 0
        if same(letter(s, ep - 1), "=") is 1
            print "Error: use is, not =="
            _sov_print(s)
            print err_line
            had_err: 1
            return 1
        if same(letter(s, ep - 1), "!") is 1
            print "Error: use is not, not !="
            _sov_print(s)
            print err_line
            had_err: 1
            return 1
    return 0
cops text:
    r: text
    r: repl(r, " is not ", " != ")
    r: repl(r, " and ", " && ")
    r: repl(r, " or ", " || ")
    r: repl(r, " is ", " == ")
    return r
fop3 e:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
            i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if same(c, "*") is 1
                                f: i
                            if not
                                if same(c, "/") is 1
                                    f: i
                                if not
                                    if same(c, "%") is 1
                                        f: i
                        i: i + 1
    return f
fop2 e a b:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
            i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if same(c, a) is 1
                                f: i
                            if not
                                if same(c, b) is 1
                                    f: i
                        i: i + 1
    return f
fop e op:
    n: length(e)
    d: 0
    ins: 0
    f: 0 - 1
    i: 0
    as long as i < n
        c: letter(e, i)
        if ins is 1
            if _sov_byte_at(e, i) is 92
                i: i + 1
                if i < n
                    i: i + 1
            if not
                if _sov_byte_at(e, i) is 34
                    ins: 0
                i: i + 1
        if not
            if _sov_byte_at(e, i) is 34
                ins: 1
                i: i + 1
            if not
                if same(c, "(") is 1
                    d: d + 1
                    i: i + 1
                if not
                    if same(c, ")") is 1
                        d: d - 1
                        i: i + 1
                    if not
                        if d is 0
                            if starts(cut(e, i, n), op) is 1
                                f: i
                        i: i + 1
    return f
find_sep text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n - 3
        b: _sov_byte_at(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
        if ins is 0
            if same(cut(text, i, i + 4), " := ") is 1
                return i
        i: i + 1
    return 0 - 1
find_col text:
    i: 0
    n: length(text)
    ins: 0
    as long as i < n
        b: _sov_byte_at(text, i)
        if ins is 1
            if b is 92
                i: i + 1
            if not
                if b is 34
                    ins: 0
        if not
            if b is 34
                ins: 1
            if not
                if b is 58
                    return i
        i: i + 1
    return 0 - 1
is_task_hdr s:
    n: length(s)
    if n < 2
        return 0
    if peek_byte(s, 0) is 35
        return 0
    if peek_byte(s, n - 1) is 58
        return 1
    return 0
ends_times s:
    if length(s) < 6
        return 0
    if same(cut(s, length(s) - 6, length(s)), " times") is 1
        return 1
    return 0
find_last_sp text:
    i: length(text) - 1
    as long as i > 0 - 1
        if same(letter(text, i), " ") is 1
            return i
        i: i - 1
    return 0 - 1
do_print_one arg:
    if length(arg) > 1
        if _sov_byte_at(arg, 0) is 34
            if same(letter(arg, length(arg) - 1), "\"") is 1
                lit: unesc(cut(arg, 1, length(arg) - 1))
                emit_write_lit(join(lit, "\n"))
                return
    typ: expr(arg)
    mov_rdi_rax()
    if typ is 1
        used_pr: 1
        calln("_sov_print")
    if not
        used_pi: 1
        calln("_sov_print_int")
do_print_times what nstr:
    expr(nstr)
    storev("__pt_c")
    xor_rax()
    storev("__pt_i")
    st: here()
    loadv("__pt_i")
    push_rax()
    loadv("__pt_c")
    mov_rcx_rax()
    pop_rax()
    cmp_rax_rcx()
    setcc("lt")
    test_rax()
    z: jz()
    do_print_one(what)
    inc_var("__pt_i")
    jb: jmp()
    put(jb, st - (jb + 4))
    patch(z)
digit c:
    b: _sov_byte_at(c, 0)
    if b >= 48
        if b <= 57
            return 1
    return 0
bin L R op:
    expr(L)
    push_rax()
    expr(R)
    mov_rcx_rax()
    pop_rax()
    if same(op, "add") is 1
        add_rax_rcx()
        chk_ov()
        return
    if same(op, "sub") is 1
        sub_rax_rcx()
        chk_ov()
        return
    if same(op, "mul") is 1
        imul_rax_rcx()
        chk_ov()
        return
    if same(op, "div") is 1
        chk_zrcx()
        emit(72)
        emit(153)
        emit(72)
        emit(247)
        emit(249)
        return
    if same(op, "mod") is 1
        chk_zrcx()
        emit(72)
        emit(153)
        emit(72)
        emit(247)
        emit(249)
        emit(72)
        emit(146)
        return
    cmp_rax_rcx()
    setcc(op)
call_args name argc:
    # cfunc(addr, a1..a6) calls a C function at a computed address.
    # C wants its arguments in rdi rsi rdx rcx r8 r9 and the stack
    # aligned to 16 bytes, and rax cleared for a variadic callee.
    if same(name, "cfunc") is 1
        emit(65)
        emit(89)
        emit(65)
        emit(88)
        emit(89)
        emit(90)
        emit(94)
        emit(95)
        emit(65)
        emit(90)
        emit(85)
        emit(72)
        emit(137)
        emit(229)
        emit(72)
        emit(131)
        emit(228)
        emit(240)
        emit(49)
        emit(192)
        emit(65)
        emit(255)
        emit(210)
        emit(72)
        emit(137)
        emit(236)
        emit(93)
        return
    if same(name, "syscall") is 1
        emit(65)
        emit(89)
        emit(65)
        emit(88)
        emit(65)
        emit(90)
        emit(65)
        emit(91)
        emit(90)
        emit(94)
        pop_rax()
        emit(72)
        emit(137)
        emit(247)
        emit(72)
        emit(137)
        emit(214)
        emit(76)
        emit(137)
        emit(218)
        sysc()
