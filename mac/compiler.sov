dead_iota lines:
    an: blank
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        if starts(s, "<-- ") is 1
            if look(s, "_sov_alloc(") > 0 - 1
                rest: cut(s, 4, length(s))
                t: find_sep(rest)
                if t > 0 - 1
                    an: repl(strip(cut(rest, 0, t)), " ", "_")
        i: i + 1
    if length(an) is 0
        return blank
    hits: 0
    ok: 1
    i: 0
    as long as i < _sov_list_len(lines)
        s: strip(_sov_list_get(lines, i))
        mark: join(an, ",")
        hit: 0
        if look(s, mark) > 0 - 1
            hit: 1
        if starts(s, join("<-- ", an)) is 1
            hit: 1
        if hit is 1
            hits: hits + 1
            good: 0
            if look(s, "_sov_alloc(") > 0 - 1
                good: 1
            if look(s, "poke_i64(") > 0 - 1
                good: 1
            if look(s, "peek_i64(") > 0 - 1
                good: 1
            if good is 0
                ok: 0
        i: i + 1
    if ok is 0
        return blank
    if hits < 3
        return blank
    return an
i2s n:
    r: ""
    v: n
    if v is 0
        return "0\n"
    as long as v > 0
        d: v % 10
        r: join(cut("0123456789", d, d + 1), r)
        v: v / 10
    return join(r, "\n")
intern_nz s:
    s: unesc(s)
    i: 0
    as long as i < _sov_list_len(str_keys)
        if same(_sov_list_get(str_keys, i), s) is 1
            return _sov_list_get(str_pos, i)
        i: i + 1
    off: _sov_buf_len(strb)
    k: 0
    as long as k < length(s)
        strb: _sov_buf_u8(strb, _sov_byte_at(s, k))
        k: k + 1
    str_keys: _sov_list_add(str_keys, s)
    str_pos: _sov_list_add(str_pos, off)
    return off
emit_write_lit s:
    n: length(s)
    emit(191)
    emit4(1)
    off: intern_nz(s)
    # mac loads at 0x100000000, so a string address needs all 64 bits
    emit(72)
    emit(190)
    at: here()
    emit8(off)
    addp(at, "str", off)
    emit(186)
    emit4(n)
    emit(184)
    emit4(1)
    sysc()
# windows hands back argv[0] wrapped in quotes, as a drive path with
# backslashes. turn it into the plain form the file calls understand.
tidy_path s:
    r: unquote(s)
    n: length(r)
    # drop a leading drive letter such as Z:
    if n > 2
        if _sov_byte_at(r, 1) is 58
            r: cut(r, 2, n)
            n: n - 2
    # backslash to slash
    o: _sov_alloc(n + 1)
    i: 0
    as long as i < n
        b: _sov_byte_at(r, i)
        if b is 92
            b: 47
        dummy: _sov_set_byte(o, i, b)
        i: i + 1
    dummy: _sov_set_byte(o, n, 0)
    return as text o

unquote s:
    n: length(s)
    if n < 2
        return s
    if _sov_byte_at(s, 0) is not 34
        return s
    e: n
    if _sov_byte_at(s, n - 1) is 34
        e: n - 1
    return cut(s, 1, e)
dirname p:
    n: length(p)
    if n is 0
        return "."
    i: n
    as long as i > 0
        i: i - 1
        b: _sov_byte_at(p, i)
        # windows writes paths with a backslash
        if b is 92
            b: 47
        if b is 47
            if i is 0
                return "/"
            return cut(p, 0, i)
    return "."
emit_nodump:
    rax_imm(157)
    rdi_imm(4)
    emit(49)
    emit(246)
    sysc()
emit_trap_stub:
    fn_names: _sov_list_add(fn_names, "_sov_trap")
    fn_offs: _sov_list_add(fn_offs, here())
    emit_write_lit("trap\n")
    emit(106)
    emit(1)
    emit(95)
    emit(184)
    emit(60)
    emit(0)
    emit(0)
    emit(0)
    sysc()
chk_ov:
    if has_vm is 1
        return
    used_tr: 1
    emit(15)
    emit(128)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")
chk_zrcx:
    if has_vm is 1
        return
    used_tr: 1
    emit(72)
    emit(133)
    emit(201)
    emit(15)
    emit(132)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")
chk_mem extra:
    if has_vm is 1
        return
    used_tr: 1
    emit(72)
    emit(133)
    emit(255)
    emit(15)
    emit(132)
    at: here()
    emit4(0)
    addp(at, "rel", "_sov_trap")
    if extra is 1
        emit(72)
        emit(59)
        emit(119)
        emit(248)
        emit(15)
        emit(131)
        at: here()
        emit4(0)
        addp(at, "rel", "_sov_trap")
    if not
        emit(72)
        emit(141)
        emit(70)
        emit(8)
        emit(72)
        emit(59)
        emit(71)
        emit(248)
        emit(15)
        emit(135)
        at: here()
        emit4(0)
        addp(at, "rel", "_sov_trap")
