    cb: s - 262272
    dummy: _sov_ctx_setup(cb)
    f: peek_i64(cb, 8)
    dummy: cfunc(f, peek_i64(cb, 16), peek_i64(cb, 24), peek_i64(cb, 32), peek_i64(cb, 40), peek_i64(cb, 48), peek_i64(cb, 56))
