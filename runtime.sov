_sov_thread_spawn fn a0 a1 a2 a3 a4 a5:
    base: syscall(9, 0, 262272, 3, 33, 0 - 1, 0)
    if base < 0
        return base
    top: base + 262272
    poke_i64(base, 0, 0)
    poke_i64(base, 8, fn)
    poke_i64(base, 16, a0)
    poke_i64(base, 24, a1)
    poke_i64(base, 32, a2)
    poke_i64(base, 40, a3)
    poke_i64(base, 48, a4)
    poke_i64(base, 56, a5)
