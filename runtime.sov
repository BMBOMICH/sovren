# pad line so main is not first
heap_ptr: 0
heap_end: 0
g_argc: g_argc
g_argv: g_argv
heap_ptr: 0
heap_end: 0
g_meta: 0
g_meta_bump: 0
g_ndesc: 0
g_desc2: 0
g_lcg: 0
g_alloc_dbg: 0
g_out_budget: 0
g_jl: 0
g_ji: 0
g_flog: 0
g_cpu_feat: 0
g_fi: 0
g_mc_cur: 0
g_mc_end: 0
g_alloc_lk: 0
g_ctx_tab: 0
g_ctx_n: 0
g_z_ring: 0
g_z_n: 0
_sov_thread_gone:
    ci: _sov_ctx_find()
    if ci < 0
        return 0
    cb: peek_i64(g_ctx_tab + ci * 64 + 8, 0)
    if cb < 4096
        return 0
    if peek_i64(cb, 80) is not 773411
        return 0
    dummy: poke_i64(cb, 0, 1)
    dummy: syscall(202, cb, 1, 1, 0, 0, 0)
    return 0
_sov_oom:
    dummy: _sov_thread_gone()
    syscall(1, 1, "out of memory\n", 14)
    pd_pid: syscall(39, 0, 0, 0, 0, 0)
    print pd_pid
    print g_ndesc
    syscall(60, 7)
_sov_alloc_abort msg code:
    dummy: _sov_thread_gone()
    n: 0
    as long as _sov_byte_at(msg, n) is not 0
        n: n + 1
    syscall(1, 1, msg, n)
    syscall(1, 1, "\n", 1)
    syscall(60, code)
_sov_lock:
    if g_alloc_lk is 0
        return 0
    w: 1
    as long as w is 1
        old: atomic_swap(g_alloc_lk, 1)
        if old is 0
            w: 0
_sov_unlock:
    if g_alloc_lk is 0
        return 0
    atomic_store(g_alloc_lk, 0)
_sov_jlog op a n:
    if g_jl is 0
        return 0
    qq: 0
    if g_ji < 65536
        qq: g_ji % 65536
        poke_i64(g_jl + qq * 24, 0, (op * 65536) + g_ji)
        poke_i64(g_jl + qq * 24 + 8, 0, a)
        poke_i64(g_jl + qq * 24 + 16, 0, n)
    g_ji: g_ji + 1
_sov_mmap_anon sz:
    p: syscall(9, 0, sz, 3, 34, 0 - 1, 0)
    if p < 65536
        if p > 0 - 65536
            dummy: _sov_oom()
    return p
_sov_munmap p n:
    dummy: _sov_jlog(2, p, n)
    return syscall(11, p, n)
_sov_guard_none p:
    dummy: _sov_jlog(4, p, 4096)
    return syscall(10, p, 4096, 0)
_sov_dget i q:
    if i < 512
        return peek_i64(g_meta + 1024 + i * 128 + q * 8, 0)
    return peek_i64(g_desc2 + (i - 512) * 128 + q * 8, 0)
_sov_dset i q v:
    if i < 512
        dummy: poke_i64(g_meta + 1024 + i * 128 + q * 8, 0, v)
    if not
        dummy: poke_i64(g_desc2 + (i - 512) * 128 + q * 8, 0, v)
    return v
_sov_meta_chain n:
    if g_mc_cur is 0
        g_mc_cur: _sov_mmap_anon(16777216)
        g_mc_end: g_mc_cur + 16777216
    if g_mc_cur + n > g_mc_end
        if n > 16777216
            return _sov_mmap_anon(n)
        g_mc_cur: _sov_mmap_anon(16777216)
        g_mc_end: g_mc_cur + 16777216
    r: g_mc_cur
    g_mc_cur: g_mc_cur + n
    return r
_sov_meta_take n:
    if n % 16 is not 0
        n: (n / 16 + 1) * 16
    if g_meta_bump + n > g_meta + 16777216
        return _sov_meta_chain(n)
    r: g_meta_bump
    g_meta_bump: g_meta_bump + n
    return r
_sov_bzero p n:
    i: 0
    as long as i + 8 <= n
        poke_i64(p + i, 0, 0)
        i: i + 8
    as long as i < n
        poke_byte(p, i, 0)
        i: i + 1
    return p
_sov_lcg:
    g_lcg: g_lcg * 6364136223846793005 + 1442695040888963407
    return band(g_lcg / 65536, 2147483647)
_sov_flog p n:
    if g_flog is 0
        return 0
    slot: (g_fi % 131072) * 16
    poke_i64(g_flog + slot, 0, p)
    poke_i64(g_flog + slot + 8, 0, n)
    g_fi: g_fi + 1
_sov_desc_new kind:
    j: 0
    as long as j < g_ndesc
        if _sov_dget(j, 1) is 0
            dummy: _sov_dset(j, 1, kind)
            return j
        j: j + 1
    if g_ndesc >= 512
        if g_desc2 is 0
            g_desc2: _sov_mmap_anon(8323072)
    if g_ndesc >= 65536
        dummy: _sov_oom()
    i: g_ndesc
    g_ndesc: g_ndesc + 1
    j: 0
    as long as j < 16
        dummy: _sov_dset(i, j, 0)
        j: j + 1
    dummy: _sov_dset(i, 1, kind)
    return i
rt_heap:
    if g_meta is not 0
        return g_meta
    m: _sov_mmap_anon(16777216)
    g_meta: m
    g_meta_bump: m + 1024 + 65536
    g_ndesc: 0
    g_lcg: _sov_meta_take(16)
    g_alloc_lk: m + 512
    atomic_store(m + 512, 0)
    i: 0
    as long as i < 64
        poke_i64(m + i * 8, 0, 0 - 1)
        i: i + 1
    g_jl: _sov_meta_take(1572864)
    g_ji: 0
    g_ctx_tab: _sov_meta_take(1024)
    g_z_ring: _sov_meta_take(128)
    g_z_n: 0
    return m
rt_init argc argv:
    g_argc: argc
    g_argv: argv
    return rt_heap()
_sov_small_region c:
    unit: (c + 1) * 16
    base: _sov_meta_take(2097152)
    d: _sov_desc_new(1)
    dummy: _sov_dset(d, 0, base)
    dummy: _sov_dset(d, 2, unit)
    nslots: 2097152 / unit
    dummy: _sov_dset(d, 3, nslots)
    dummy: _sov_dset(d, 7, _sov_meta_take(256))
    gen: _sov_meta_take(nslots)
    dummy: _sov_dset(d, 10, gen)
    return d
_sov_small_try d:
    unit: _sov_dget(d, 2)
    base: _sov_dget(d, 0)
    fh: _sov_dget(d, 5)
    if fh is not 0
        nxt: peek_i64(fh, 0)
        if nxt is not 0
            if nxt < base
                dummy: _sov_alloc_abort("heap corrupt", 10)
            if nxt >= base + 2097152
                dummy: _sov_alloc_abort("heap corrupt", 10)
            if (nxt - base) % unit is not 0
                dummy: _sov_alloc_abort("heap corrupt", 10)
        dummy: _sov_dset(d, 5, nxt)
        if g_alloc_dbg is 1
            dummy: _sov_dbg_fill(fh, unit)
        return fh
    carve: _sov_dget(d, 4)
    if carve < _sov_dget(d, 3)
        dummy: _sov_dset(d, 4, carve + 1)
        p: base + carve * unit
        if g_alloc_dbg is 1
            dummy: _sov_dbg_fill(p, unit)
        return p
_sov_alloc_small c:
    d: peek_i64(g_meta + c * 8, 0)
    if d >= 0
        p: _sov_small_try(d)
        if p > 0
            return p

    d2: 0
    as long as d2 < g_ndesc
        if _sov_dget(d2, 1) is 1
            if _sov_dget(d2, 2) is (c + 1) * 16
                p: _sov_small_try(d2)
                if p > 0
                    poke_i64(g_meta + c * 8, 0, d2)
                    return p
        d2: d2 + 1
    d3: _sov_small_region(c)
    poke_i64(g_meta + c * 8, 0, d3)
    return _sov_small_try(d3)
_sov_free_small d p:
    base: _sov_dget(d, 0)
    unit: _sov_dget(d, 2)
    idx: (p - base) / unit
    if (p - base) % unit is not 0
        dummy: _sov_alloc_abort("invalid free", 9)
    if idx >= _sov_dget(d, 3)
        dummy: _sov_alloc_abort("invalid free", 9)
    gen: _sov_dget(d, 10)
    if peek_byte(gen, idx) is 1
        dummy: _sov_alloc_abort("double free", 8)
    poke_byte(gen, idx, 1)
    if g_flog is not 0
        dummy: _sov_flog(p, unit)
    dummy: _sov_bzero(p, unit)
    ring: _sov_dget(d, 7)
    rc: _sov_dget(d, 8)
    if rc < 32
        pos: (_sov_dget(d, 9) + rc) % 32
        poke_i64(ring + pos * 8, 0, p)
        dummy: _sov_dset(d, 8, rc + 1)
        return 0
    r: band(_sov_lcg(), 31)
    victim: peek_i64(ring + r * 8, 0)
    vidx: (victim - base) / unit
    poke_byte(gen, vidx, 0)
    nxt: _sov_dget(d, 5)
    poke_i64(victim, 0, nxt)
    dummy: _sov_dset(d, 5, victim)
    poke_i64(ring + r * 8, 0, p)
    dummy: _sov_dset(d, 9, (_sov_dget(d, 9) + 1) % 32)
_sov_med_region:
    base: _sov_meta_take(2097152)
    dummy: _sov_jlog(1, base, 2097152)
    d: _sov_desc_new(2)
    dummy: _sov_dset(d, 0, base)
    bm: _sov_meta_take(512)
    dummy: _sov_dset(d, 10, bm)
    ln: _sov_meta_take(512)
    dummy: _sov_dset(d, 11, ln)
    return d
_sov_med_try d k:
    base: _sov_dget(d, 0)
    bm: _sov_dget(d, 10)
    ln: _sov_dget(d, 11)
    i: 0
    as long as i + k <= 512
        ok: 1
        j: 0
        as long as j < k
            if peek_byte(bm, i + j) is 1
                ok: 0
                j: k + 1
            j: j + 1
        if ok is 1
            j: 0
            as long as j < k
                poke_byte(bm, i + j, 1)
                j: j + 1
            poke_byte(ln, i, k)
            p: base + i * 4096
            if g_alloc_dbg is 1
                dummy: _sov_dbg_fill(p, k * 4096)
            return p
        i: i + 1
_sov_alloc_med n:
    k: (n + 4095) / 4096
    d: 0
    as long as d < g_ndesc
        if _sov_dget(d, 1) is 2
            p: _sov_med_try(d, k)
            if p > 0
                return p
        d: d + 1
    d2: _sov_med_region()
    return _sov_med_try(d2, k)
_sov_free_med d p:
    base: _sov_dget(d, 0)
    if (p - base) % 4096 is not 0
        dummy: _sov_alloc_abort("invalid free", 9)
    idx: (p - base) / 4096
    if idx >= 512
        dummy: _sov_alloc_abort("invalid free", 9)
    ln: _sov_dget(d, 11)
    bm: _sov_dget(d, 10)
    k: peek_byte(ln, idx)
    if k is 0
        dummy: _sov_alloc_abort("double free", 8)
    j: 0
    as long as j < k
        if peek_byte(bm, idx + j) is 0
            dummy: _sov_alloc_abort("heap corrupt", 10)
        j: j + 1
    if g_flog is not 0
        dummy: _sov_flog(p, k * 4096)
    if g_jl is not 0
        dummy: _sov_jlog(3, p, k * 4096)
    dummy: _sov_bzero(p, k * 4096)
    j: 0
    as long as j < k
        poke_byte(bm, idx + j, 0)
        j: j + 1
    poke_byte(ln, idx, 0)
_sov_alloc_large n:
    pay: (n + 4095) / 4096 * 4096
    total: pay + 8192
    # Reserve VA geometrically (pow2, at least 4MB) so later growth is an
    # mprotect-commit inside the reservation: pointer-stable, no copy.
    # (mremap in-place is not an option: top-down mmap adjacency blocks
    # it, and the guard mprotects split the span into multiple VMAs,
    # which mremap rejects with EFAULT.)
    res: 4194304
    as long as res < total
        res: res * 2
    # Geometric builders double repeatedly; a reserve ending exactly at a
    # pow2 boundary still exhausts on the final step, so grant up to 16x
    # headroom (MAP_NORESERVE keeps overcommit accounting sane).
    res: res * 16
    if res > 1073741824
        res: 1073741824
    map: syscall(9, 0, res, 3, 16418, 0 - 1, 0)
    if map < 65536
        res: total
        map: _sov_mmap_anon(total)
    dummy: _sov_jlog(1, map, total)
    if total >= 2097152
        dummy: syscall(28, map, total, 14)
    dummy: _sov_guard_none(map)
    dummy: _sov_guard_none(map + total - 4096)
    if res > total
        dummy: syscall(10, map + total, res - total, 0)
    d: _sov_desc_new(3)
    dummy: _sov_dset(d, 0, map)
    dummy: _sov_dset(d, 2, total)
    dummy: _sov_dset(d, 6, map + 4096)
    dummy: _sov_dset(d, 7, pay)
    dummy: _sov_dset(d, 13, res)
    p: map + 4096
    if g_alloc_dbg is 1
        dummy: _sov_dbg_fill(p, pay)
    return p
_sov_free_large d:
    pay: _sov_dget(d, 6)
    n: _sov_dget(d, 7)
    m: _sov_dget(d, 0)
    t: _sov_dget(d, 2)
    rs: _sov_dget(d, 13)
    if rs > t
        t: rs
    dummy: _sov_munmap(m, t)
    dummy: _sov_dset(d, 1, 0)
    dummy: _sov_dset(d, 0, 0)
    dummy: _sov_dset(d, 6, 0)
    dummy: _sov_dset(d, 7, 0)
_sov_fast_alloc size:
    if g_ctx_n is not 0
        return 0
    if g_meta is 0
        return 0
    if g_alloc_dbg is not 0
        return 0
    if size < 1
        return 0
    if size > 1024
        return 0
    d: peek_i64(g_meta + ((size + 15) / 16 - 1) * 8, 0)
    if d < 0
        return 0
    db: g_meta + 1024 + d * 128
    if d >= 512
        db: g_desc2 + (d - 512) * 128
    fh: peek_i64(db + 40, 0)
    if fh is not 0
        dummy: poke_i64(db + 40, 0, peek_i64(fh, 0))
        return fh
    carve: peek_i64(db + 32, 0)
    if carve < peek_i64(db + 24, 0)
        dummy: poke_i64(db + 32, 0, carve + 1)
        return peek_i64(db + 0, 0) + carve * peek_i64(db + 16, 0)
    return 0
_sov_heap_alloc size:
    fp: _sov_fast_alloc(size)
    if fp is not 0
        return fp
    ci: 0 - 1
    if g_ctx_n > 0
        ci: _sov_ctx_find()
    if ci >= 0
        if size <= 1024
            tp: _sov_ctx_alloc_small(ci, size)
            if tp > 0
                return tp
    if g_meta is 0
        rt_heap()
    locked: 0
    if g_ctx_n > 0
        dummy: _sov_lock()
        locked: 1
    n: size
    if n < 1
        n: 16
    p: 0
    if n <= 1024
        p: _sov_alloc_small((n + 15) / 16 - 1)
    if n > 1024
        if n <= 65536
            p: _sov_alloc_med(n)
    if n > 65536
        p: _sov_alloc_large(n)
    if p is 0
        if locked is 1
            dummy: _sov_unlock()
        dummy: _sov_oom()
    if locked is 1
        dummy: _sov_unlock()
    return p
_sov_alloc size:
    return _sov_heap_alloc(size)
_sov_heap_wipe:
    if g_meta is 0
        return 0
    d: 0
    as long as d < g_ndesc
        k: _sov_dget(d, 1)
        if k is 1
            dummy: _sov_bzero(_sov_dget(d, 0), 2097152)
        if k is 2
            dummy: _sov_bzero(_sov_dget(d, 0), 2097152)
        if k is 3
            dummy: _sov_bzero(_sov_dget(d, 6), _sov_dget(d, 7))
        if k is 4
            dummy: _sov_bzero(_sov_dget(d, 0), _sov_dget(d, 2))
        d: d + 1
    i: 0
    as long as i < 16
        wb: peek_i64(g_ctx_tab + i * 64 + 16, 0)
        if wb > 0
            dummy: _sov_bzero(wb, 2097152)
        i: i + 1
    j: 0
    as long as j < g_z_n
        zb: peek_i64(g_z_ring + j * 16, 0)
        if zb > 0
            dummy: _sov_bzero(zb, 2097152)
        j: j + 1
    dummy: _sov_bzero(g_meta, 4194304)
    if g_desc2 is not 0
        dummy: _sov_bzero(g_desc2, 458752)
_sov_free p:
    if p is 0
        return 0
    if g_meta is 0
        dummy: _sov_alloc_abort("invalid free", 9)
    if g_ctx_tab is not 0
        ci: _sov_ctx_find()
        if ci >= 0
            if _sov_ctx_release(ci, p) is 0
                return 0
    dummy: _sov_lock()
    d: 0
    hit: 0
    as long as d < g_ndesc
        k: _sov_dget(d, 1)
        if k is 1
            b: _sov_dget(d, 0)
            if p >= b
                if p < b + 2097152
                    dummy: _sov_free_small(d, p)
                    hit: 1
                    d: g_ndesc
        if k is 2
            b: _sov_dget(d, 0)
            if p >= b
                if p < b + 2097152
                    dummy: _sov_free_med(d, p)
                    hit: 1
                    d: g_ndesc
        if k is 3
            if p is _sov_dget(d, 6)
                dummy: _sov_free_large(d)
                hit: 1
                d: g_ndesc
        if k is 4
            b: _sov_dget(d, 0)
            if p >= b
                if p < b + _sov_dget(d, 2)
                    dummy: _sov_alloc_abort("arena payload is freed by arena_destroy", 11)
        d: d + 1
    if hit is 0
        dummy: _sov_alloc_abort("invalid free", 9)
    dummy: _sov_unlock()
_sov_try_grow_large p n:
    # In-place growth for kind-3 (large mmap) blocks via mremap(flags=0):
    # the kernel extends the mapping at the same address when it can, so
    # list growth becomes O(1) page-table work instead of alloc+memcpy of
    # the whole buffer on every doubling (the copy traffic that put
    # list-heavy programs far behind glibc realloc).  The old trailing
    # guard page ends up mid-mapping after the remap: unguard it, then
    # guard the new last page.  Returns p on success, 0 to let the caller
    # fall back to alloc+copy (block not kind-3, or cannot grow in place).
    if p is 0
        return 0
    if g_meta is 0
        return 0
    d: 0
    fd: 0 - 1
    as long as d < g_ndesc
        if _sov_dget(d, 1) is 3
            if _sov_dget(d, 6) is p
                fd: d
                d: g_ndesc
        d: d + 1
    if fd < 0
        return 0
    pay: _sov_dget(fd, 7)
    if n <= pay
        return p
    map: _sov_dget(fd, 0)
    total: _sov_dget(fd, 2)
    res: _sov_dget(fd, 13)
    npay: (n + 4095) / 4096 * 4096
    ntotal: npay + 8192
    if ntotal > res
        return 0
    # Commit more of the reservation: the old trailing guard page
    # becomes payload, a fresh guard goes at the new end.
    dummy: syscall(10, map + total - 4096, ntotal - total, 3)
    dummy: _sov_guard_none(map + ntotal - 4096)
    if ntotal >= 2097152
        dummy: syscall(28, map, ntotal, 14)
    dummy: _sov_jlog(7, map, ntotal)
    dummy: _sov_dset(fd, 2, ntotal)
    dummy: _sov_dset(fd, 7, npay)
    return p
_sov_realloc p n:
    if p is 0
        return _sov_heap_alloc(n)
    if n is 0
        dummy: _sov_free(p)
        return 0
    ci: _sov_ctx_find()
    if ci >= 0
        rp: _sov_ctx_realloc(ci, p, n)
        if rp > 0
            return rp
    gp: _sov_try_grow_large(p, n)
    if gp is not 0
        return gp
    old: 0
    d: 0
    as long as d < g_ndesc
        k: _sov_dget(d, 1)
        if k is 1
            b: _sov_dget(d, 0)
            if p >= b
                if p < b + 2097152
                    u: _sov_dget(d, 2)
                    idx: (p - b) / u
                    if (p - b) % u is not 0
                        dummy: _sov_alloc_abort("invalid realloc", 9)
                    if idx < _sov_dget(d, 3)
                        old: u
        if k is 2
            b: _sov_dget(d, 0)
            if p >= b
                if p < b + 2097152
                    idx: (p - b) / 4096
                    if idx < 512
                        lk: peek_byte(_sov_dget(d, 11), idx)
                        if lk > 0
                            old: lk * 4096
        if k is 3
            if p is _sov_dget(d, 6)
                old: _sov_dget(d, 7)
        d: d + 1
    if old is 0
        dummy: _sov_alloc_abort("invalid realloc", 9)
    if n <= 1024
        if old <= 1024
            if (n + 15) / 16 is (old + 15) / 16
                return p
    if n > 1024
        if n <= old
            if n + 4096 > old
                return p
    if n > 65536
        if old > 65536
            if (n + 4095) / 4096 * 4096 is old
                return p
    np: _sov_heap_alloc(n)
    cp: n
    if old < n
        cp: old
    dummy: _sov_memcpy(np, p, cp)
    dummy: _sov_free(p)
    return np
_sov_arena_new cap:
    if g_meta is 0
        rt_heap()
    dummy: _sov_lock()
    t: (cap + 4095) / 4096 * 4096
    if t < 4096
        t: 4096
    base: _sov_mmap_anon(t)
    d: _sov_desc_new(4)
    dummy: _sov_dset(d, 0, base)
    dummy: _sov_dset(d, 2, t)
    dummy: _sov_dset(d, 12, 0)
    dummy: _sov_unlock()
    return d
_sov_arena_alloc a n:
    if g_meta is 0
        rt_heap()
    dummy: _sov_lock()
    if _sov_dget(a, 1) is not 4
        dummy: _sov_alloc_abort("bad arena", 12)
    if n % 16 is not 0
        n: (n / 16 + 1) * 16
    u: _sov_dget(a, 12)
    if u + n > _sov_dget(a, 2)
        dummy: _sov_unlock()
        dummy: _sov_oom()
    dummy: _sov_dset(a, 12, u + n)
    p: _sov_dget(a, 0) + u
    dummy: _sov_unlock()
    return p
_sov_arena_destroy a:
    if g_meta is 0
        return 0
    dummy: _sov_lock()
    if _sov_dget(a, 1) is not 4
        dummy: _sov_alloc_abort("bad arena", 12)
    dummy: _sov_munmap(_sov_dget(a, 0), _sov_dget(a, 2))
    dummy: _sov_dset(a, 1, 0)
    dummy: _sov_dset(a, 0, 0)
    dummy: _sov_unlock()
_sov_dbg_fill p n:
    if n > 65536
        return p
    i: 0
    as long as i < n
        poke_byte(p, i, 165)
        i: i + 1
