// Test canary elision
// Run with: sovereign build bench/canary_test.sov --report

// This task uses ONLY local variables and constants
// Borrow checker proves it is stack-safe
// SOE should elide its canary → 0% overhead
task add_safe(a: int, b: int) -> int {
    set result = a + b
    return result
}

// This task uses override (raw pointers)
// SOE CANNOT prove safety
// Canary is REQUIRED and emitted
task raw_op(p: ptr) -> int {
    override {
        return ptr_get_int(p, 0)
    }
    return 0
}

// Loop test — SOE finds loop invariant
task process(arr: [int], n: int, name: string) -> int {
    set total = 0
    loop i from 0 to n - 1 {
        // str_len(name) is loop-invariant
        // SOE hoists it outside the loop
        set len = str_len(name)
        total += arr[i] * len
    }
    return total
}

set x = add_safe(3, 7)
print x