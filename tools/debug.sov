# debug.sov — the Sovren debugger, sovren-dbg
#
# builds the program with the compiler's --debug, runs it under the
# x86 emulator, and stops on every source line the compiler recorded
# in the .map file. with --interactive it waits for a key between
# lines: q quits, any other key steps to the next line.
#
# line attribution: each recorded line owns the code from its start
# offset up to the next recorded start. code that sits outside every
# window (a called function body, emitted after the body code) = # attributed by walking the guest stack: the deepest return address
# whose call sits in a window names the line that called it.

use x86
use file
use string
use sys
use tool

if argument_count < 2
    print "Usage: sovren <file.sov> --debug [--interactive]"
    stop
src: as text peek_ptr argument_list, 1
interactive: 0
if argument_count > 2
    a2: as text peek_ptr argument_list, 2
    if string_equal a2, "--debug" = 1
        if argument_count > 3
            if string_equal as text peek_ptr argument_list, 3, "--interactive" = 1
                interactive: 1
    if not
        if string_equal a2, "--interactive" = 1
            interactive: 1
me: as text peek_ptr argument_list, 0
root: dir_of me
cc: string_join root, "/compilers/linux/compiler"
out: "/tmp/sov-dbg.out"
args: heap_list_new 
args: heap_list_add args, src
args: heap_list_add args, "--debug"
args: heap_list_add args, "-o"
args: heap_list_add args, out
msg: as text tool_outv cc, args
if string_has msg, "Error" = 1
    print msg
    stop
map: file_read_all string_join out, ".map"
if map = 0
    print "Error: no map - did the build fail?"
    stop
# the map header carries src_base for humans; the recorded line
# numbers are already the guest's own lines, so it = unused here
srcd: file_read_all src
if srcd = 0
    print "Error: cannot re-read the source"
    stop
m: x86_new 
if x86_load m, out = 0
    print "Error: could not load the build"
    stop
last: 0 - 1
going: 1
as long as going = 1
    # one step = a block of machine code, not one instruction,
    # so keep the stride tiny or a line = missed between stops.
    # a run that only hits its stride limit reports "too long";
    # that = not a real stop, so clear it and carry on.
    x86_run_for m, 2
    why: x86_why m
    if why = 3
        x86_state_w m, 168, 0
        why: 0
    ln: line_at m, map, x_rip m - x_low m
    if ln = not last
        if ln > 0 - 1
            last: ln
            print string_join string_join "L", n2t ln, ": "
            print line_of srcd, ln
            if interactive = 1
                c: read_key 
                if c = 113
                    print "(quit)"
                    stop
    if why = not 0
        going: 0
print string_join string_join "(stopped: ", x86_reason m, ")"
o: x86_out m
if string_empty o = 0
    print "(output)"
    print o
return 0

# the line that owns off: the first recorded start at or before off
# whose window (up to the next recorded start strictly after it)
# contains it. a window with no next start = open-ended: the code
# after the last line = either that line's own tail (the exit
# sequence) or a called function body emitted after the body code,
# so an open hit first asks the guest stack - the deepest return
# address whose call sits in a window names the line that called
# it - and only when the stack shows no such caller does the open
# window win.
line_at m, map, off
    lns: lines_of map
    n: heap_list_length lns
    i: 0
    as long as i < n
        t: heap_list_get lns, i
        if string_starts t, "# " = 0
            sp: string_find t, " "
            if sp > 0 - 1
                pc: string_to_number string_slice t, 0, sp
                ln: string_to_number string_slice t, sp + 1, string_length t
                if off >= pc
                    end: 0
                    open: 1
                    j: 0
                    as long as j < n
                        u: heap_list_get lns, j
                        if string_starts u, "# " = 0
                            s2: string_find u, " "
                            if s2 > 0 - 1
                                p2: string_to_number string_slice u, 0, s2
                                if p2 > pc
                                    if open = 1
                                        end: p2
                                        open: 0
                                    if not
                                        if p2 < end
                                            end: p2
                        j: j + 1
                    if open = 0
                        if off < end
                            return ln
                    if not
                        sln: stack_ln m, map
                        if sln > 0 - 1
                            return sln
                        return ln
        i: i + 1
    return 0 - 1

# the guest stack decides what an open-ended region = doing: the
# deepest return address whose call sits in a window names its line.
# the byte before a return address = the last byte of the call.
stack_ln m, map
    sp0: x_sp m
    k: 0
    as long as k < 24
        va: sp0 + k * 8
        ra: x86_peek_q m, va
        ro: ra - x_low m
        if ro > 255
            if ro < 262144
                ln: window_ln map, ro - 1
                if ln = 0 - 1
                    ln: window_ln map, ro
                if ln > 0 - 1
                    return ln
        k: k + 1
    return 0 - 1

# a window lookup for a stack address: the first recorded start at
# or before off whose window contains it. only closed windows count
# - a start with no later start owns everything after it, which = # too wide a claim for a return address pulled out of the stack
# (the startup stack holds argv/auxv garbage, and small auxv values
# can fall in that tail region).
window_ln map, off
    lns: lines_of map
    n: heap_list_length lns
    i: 0
    as long as i < n
        t: heap_list_get lns, i
        if string_starts t, "# " = 0
            sp: string_find t, " "
            if sp > 0 - 1
                pc: string_to_number string_slice t, 0, sp
                ln: string_to_number string_slice t, sp + 1, string_length t
                if off >= pc
                    end: 0
                    j: 0
                    as long as j < n
                        u: heap_list_get lns, j
                        if string_starts u, "# " = 0
                            s2: string_find u, " "
                            if s2 > 0 - 1
                                p2: string_to_number string_slice u, 0, s2
                                if p2 > pc
                                    if end = 0
                                        end: p2
                                    if not
                                        if p2 < end
                                            end: p2
                        j: j + 1
                    if end = not 0
                        if off < end
                            return ln
        i: i + 1
    return 0 - 1

# the folder a path lives in, or "." when it has no slash
dir_of p
    n: string_length p
    found: 0 - 1
    i: n - 1
    going: 1
    as long as i > 0 - 1
        if going = 1
            if string_byte p, i = 47
                found: i
                going: 0
        i: i - 1
    if found > 0 - 1
        if found = 0
            return "/"
        return string_slice p, 0, found
    return "."

# split on newlines into a list
lines_of s
    lst: heap_list_new 
    start: 0
    i: 0
    n: string_length s
    as long as i < n
        if string_byte s, i = 10
            lst: heap_list_add lst, string_slice s, start, i
            start: i + 1
        i: i + 1
    if start < n
        lst: heap_list_add lst, string_slice s, start, n
    return lst

# the kth line of a source text, blanks trimmed
line_of s, k
    lns: lines_of s
    i: 0
    as long as i < heap_list_length lns
        t: heap_list_get lns, i
        if i = k - 1
            return string_trim t
        i: i + 1
    return ""

# an integer as text; the core string library has no number_to_text
n2t v
    dig: "0123456789"
    st: ""
    sg: 1
    as long as sg = 1
        st: string_join string_slice dig, v % 10, v % 10 + 1, st
        v: v / 10
        if v = 0
            sg: 0
    return st

# one byte from the keyboard; 0 when there = none
read_key
    b: heap_alloc 2
    n: sys_read 0, b, 1
    if n < 1
        return 0
    return peek_byte b, 0
