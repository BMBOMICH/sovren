# unsafe-module
use:
    x86
    tool
    string
    file
    num
    arg
    sys
main argc argv:
    if argc < 2 -> print 'Usage: sovren <file.sov> --debug [--interactive]'
        stop
    src: as text peek_ptr(argv, 1) ;; interactive: 0
    if argc > 2 -> a2: as text peek_ptr(argv, 2)
        if str_eq(a2, '--debug') = 1 -> if argc > 3
                if str_eq(as text peek_ptr(argv, 3), '--interactive') = 1 -> interactive: 1
        if not -> if str_eq(a2, '--interactive') = 1
                interactive: 1
    me: as text peek_ptr(argv, 0) ;; root: dir_of(me)
    cc: str_cat(root, '/compilers/linux/compiler')
    out: '/tmp/sov-dbg.out'
    args: _sov_list_new()
    args: _sov_list_add:
        src
        '--debug'
        '-o'
        out
    msg: as text tool_outv(cc, args)
    if str_has(msg, 'Error') = 1 -> print msg
        stop
    map: file_read_all(str_cat(out, '.map'))
    if map = 0 -> print 'Error: no map - did the build fail?'
        stop
    srcd: file_read_all(src)
    if srcd = 0 -> print 'Error: cannot re-read the source'
        stop
    m: x86_new()
    if x86_load(m, out) = 0 -> print 'Error: could not load the build'
        stop
    last: 0 - 1 ;; going: 1
    as long as going = 1
        x86_run_for(m, 2)
        why: x86_why(m)
        if why = 3
            x86_state_w(m, 168, 0)
            why: 0
        ln: line_at(m, map, x_rip(m) - x_low(m))
        tr: 1
        if ln = last -> tr: 0
        if ln < 0 -> tr: 0
        if tr = 1
            last: ln
            print str_cat(str_cat('L', n2t(ln)), ': ')
            print as text line_of(srcd, ln)
            if interactive = 1
                c: read_key()
                if c = 113
                    print '(quit)'
                    stop
        if why != 0
            going: 0
    rs: x86_reason(m)
    if str_eq(rs, 'the program exited') = 1 -> rs: 'done'
    print str_cat(str_cat('(stopped: ', rs), ')')
    o: x86_out(m)
    if str_empty(o) = 0 -> print '(output)'
        print o
line_at m map off:
    # .map format (written by the compiler in --debug mode):
    #   "# src_base <n>\n" then per user-task line-start: "<pc> <ln>\n"
    # pc values are file offsets; the caller passes rip - image_base.
    # classic line-table lookup: last entry with pc <= off wins.
    n: str_len(map)
    best: 0 - 1
    i: 0
    inhdr: 1
    curpc: 0 - 1
    as long as i < n
        e: i
        fnd: 0
        g5: 1
        as long as g5 = 1
            st5: fnd + band(e / n, 1)
            g5: 1 - band(st5, 1)
            if g5 = 1
                if peek_byte(map, e) = 10 -> fnd: 1
                if not -> e: e + 1
        endl: e
        txt: str_cut(map, i, endl)
        if inhdr = 1
            inhdr: 0
        if not
            sp: str_find(txt, ' ')
            if sp > 0 - 1
                pv: str_num(str_cut(txt, 0, sp))
                lv: str_num(str_cut(txt, sp + 1, str_len(txt)))
                if pv >= 0
                    if off >= pv
                        if lv > 0
                            best: lv
                curpc: pv
        i: endl + 1
    return best
n2t v:
    if v = 0 -> return '0'
    neg: 0
    if v < 0
        neg: 1
        v: 0 - v
    d: _sov_alloc(24)
    i: 0
    as long as v > 0
        c: 48 + v % 10
        j: i
        as long as j > 0
            poke_byte(d, j, peek_byte(d, j - 1))
            j: j - 1
        poke_byte(d, 0, c)
        v: v / 10
        i: i + 1
    if neg = 1
        j: i
        as long as j > 0
            poke_byte(d, j, peek_byte(d, j - 1))
            j: j - 1
        poke_byte(d, 0, 45)
        i: i + 1
    poke_byte(d, i, 0)
    return as text d
line_of src want:
    ns: str_len(src)
    ln: 1
    i: 0
    st: 0
    en: 0
    fnd: 0
    go: 1
    as long as go = 1
        m9: 1 - band(i / (ns + 1), 1)
        go: m9 * (1 - fnd)
        if go = 1
            e: lof_end(src, i, ns)
            if ln = want
                st: i
                en: e
                fnd: 1
            i: e + 1
            ln: ln + 1
    w: en - st
    if w < 0 -> w: 0
    out: _sov_alloc(w + 2)
    jj: 0
    as long as jj < w
        poke_byte(out, jj, peek_byte(src, st + jj))
        jj: jj + 1
    poke_byte(out, w, 0)
    return as text out

dir_of p:
    n: str_len(p)
    i: n - 1
    as long as i >= 0
        if peek_byte(p, i) = 47 -> return str_cut(p, 0, i)
        i: i - 1
    return '.'
lof_end src i ns:
    e: i
    fnd: 0
    g7: 1
    as long as g7 = 1
        st7: fnd + band(e / ns, 1)
        g7: 1 - band(st7, 1)
        if g7 = 1
            if peek_byte(src, e) = 10 -> fnd: 1
            if not -> e: e + 1
    if e > ns -> e: ns
    return e
read_key:
    b: _sov_alloc(2)
    got: sys_read(0, b, 1)
    if got < 1 -> return 0 - 1
    return peek_byte(b, 0)
