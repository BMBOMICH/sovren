import "../stdlib/native.sov"
import "../stdlib/ast.sov"

struct Optimizer {
    program:        Program
    stack_safe:     HashMap
    soa_opps:       Vec
    move_elisions:  Vec
    hoistable:      HashMap
    stats:          OptStats
}

struct SoAOpportunity {
    struct_name:    string
    fields:         VecStr
    array_name:     string
    speedup:        float
}

struct MoveElision {
    source:         string
    dest:           string
    type_name:      string
}

struct OptStats {
    canaries_removed:    int
    soa_transforms:      int
    moves_elided:        int
    invariants_hoisted:  int
}

task analyze_stack_safety(opt: Optimizer, task_stmt: ptr) -> bool {
    set name = stmt_get_name(task_stmt)
    set body = stmt_get_block(task_stmt)
    check block_contains_override(body) { return false }
    check block_contains_call(body, name) { return false }
    check block_contains_alloc(body) { return false }
    check block_contains_ptr_arith(body) { return false }
    return true
}

task detect_soa_opportunities(opt: Optimizer, task_stmt: ptr) -> Vec {
    set opps = vec_new()
    set body = stmt_get_block(task_stmt)
    set n = block_stmt_count(body)
    loop i from 0 to n - 1 {
        set s = block_get_stmt(body, i)
        check stmt_kind(s) == STMT_LOOP_RANGE {
            set loop_body = stmt_get_block(s)
            set accessed = collect_struct_field_accesses(loop_body)
            check vec_len(accessed) > 0 and vec_len(accessed) <= 2 {
                set opp = SoAOpportunity { struct_name: "", fields: accessed, array_name: stmt_get_loop_var(s), speedup: 0.0 }
                opps = vec_push(opps, opp)
            }
        }
    }
    return opps
}

task detect_move_elisions(opt: Optimizer, task_stmt: ptr) -> Vec {
    set elisions = vec_new()
    set body = stmt_get_block(task_stmt)
    set n = block_stmt_count(body)
    set used_after_assign = hashmap_new()
    loop i from 0 to n - 1 {
        set s = block_get_stmt(body, i)
        check stmt_kind(s) == STMT_ASSIGN {
            set src = stmt_get_assign_source(s)
            set dest_name = stmt_get_name(s)
            set used_later = false
            loop j from i + 1 to n - 1 {
                set later_s = block_get_stmt(body, j)
                check stmt_references_var(later_s, src) { used_later = true; break }
            }
            check not used_later {
                set elision = MoveElision { source: src, dest: dest_name, type_name: "" }
                elisions = vec_push(elisions, elision)
            }
        }
    }
    return elisions
}

task hoist_loop_invariants(opt: Optimizer, task_stmt: ptr) -> Vec {
    set hoisted = vec_new()
    set body = stmt_get_block(task_stmt)
    set n = block_stmt_count(body)
    loop i from 0 to n - 1 {
        set s = block_get_stmt(body, i)
        check stmt_kind(s) == STMT_LOOP_RANGE {
            set loop_body = stmt_get_block(s)
            set loop_n = block_stmt_count(loop_body)
            set loop_var = stmt_get_loop_var(s)
            loop j from 0 to loop_n - 1 {
                set ls = block_get_stmt(loop_body, j)
                check stmt_kind(ls) == STMT_EXPR {
                    set e = stmt_get_expr(ls)
                    check not expr_depends_on_var(e, loop_var) { hoisted = vec_push(hoisted, e) }
                }
            }
        }
    }
    return hoisted
}

task optimize(prog: Program) -> Optimizer {
    set opt = Optimizer { program: prog, stack_safe: hashmap_new(), soa_opps: vec_new(), move_elisions: vec_new(), hoistable: hashmap_new(), stats: OptStats { canaries_removed: 0, soa_transforms: 0, moves_elided: 0, invariants_hoisted: 0 } }
    set n = program_stmt_count(prog)
    loop i from 0 to n - 1 {
        set s = program_get_stmt(prog, i)
        check stmt_kind(s) == STMT_TASK_DECL {
            set name = stmt_get_name(s)
            check analyze_stack_safety(opt, s) { hashmap_insert(opt.stack_safe, name, true); opt.stats.canaries_removed = opt.stats.canaries_removed + 1 }
            set soa = detect_soa_opportunities(opt, s)
            opt.soa_opps = vec_concat(opt.soa_opps, soa)
            opt.stats.soa_transforms = opt.stats.soa_transforms + vec_len(soa)
            set moves = detect_move_elisions(opt, s)
            opt.move_elisions = vec_concat(opt.move_elisions, moves)
            opt.stats.moves_elided = opt.stats.moves_elided + vec_len(moves)
            set hoisted = hoist_loop_invariants(opt, s)
            hashmap_insert(opt.hoistable, name, hoisted)
            opt.stats.invariants_hoisted = opt.stats.invariants_hoisted + vec_len(hoisted)
        }
    }
    return opt
}

task print_optimization_report(opt: Optimizer) {
    println("Sovereign Optimization Report")
    print_fmt("  Stack canaries removed:    %d", opt.stats.canaries_removed)
    println("")
    print_fmt("  SoA transformations:       %d", opt.stats.soa_transforms)
    println("")
    print_fmt("  Move elisions:             %d", opt.stats.moves_elided)
    println("")
    print_fmt("  Loop invariants hoisted:   %d", opt.stats.invariants_hoisted)
    println("")
}
