/// Sovereign Self-Hosted Compiler - Main Entry Point
/// 
/// This is the complete self-hosted compiler for Sovereign.
/// It reads Sovereign source code and outputs C code that can be
/// compiled with gcc or clang.
///
/// Usage:
///   sovereign compile <input.sov> [-o output.c]
///   sovereign run <input.sov>
///   sovereign check <input.sov>
///   sovereign fmt <input.sov>
///
/// Bootstrap Process:
///   1. Use Rust compiler to compile this file to C:
///      sovereign compile compiler_self.sov -o compiler.c
///   2. Compile the C output:
///      gcc -O2 compiler.c -o sovereign_new
///   3. Use the new compiler to recompile itself:
///      ./sovereign_new compile compiler_self.sov -o compiler2.c
///   4. Verify convergence:
///      diff compiler.c compiler2.c

// Include all standard library components
// (In practice, these would be concatenated or imported)

// ============================================================================
// COMMAND LINE INTERFACE
// ============================================================================

task print_usage() {
    println("Sovereign Self-Hosted Compiler v1.0.0")
    println("")
    println("Usage:")
    println("  sovereign compile <input.sov> [-o output.c]   Compile to C")
    println("  sovereign run <input.sov>                     Compile and run")
    println("  sovereign check <input.sov>                   Type check only")
    println("  sovereign fmt <input.sov>                     Format source")
    println("  sovereign lex <input.sov>                     Print tokens")
    println("  sovereign parse <input.sov>                   Print AST")
    println("")
    println("Options:")
    println("  -o <file>    Output file (default: output.c)")
    println("  -v           Verbose output")
    println("  -h, --help   Show this help")
}

task print_version() {
    println("Sovereign Self-Hosted Compiler v1.0.0")
    println("Target: C (gcc/clang compatible)")
    println("Self-hosted implementation in Sovereign")
}

/// Parse command line arguments
struct Args {
    command:  string    // compile, run, check, fmt, lex, parse
    input:    string    // Input file
    output:   string    // Output file
    verbose:  bool      // Verbose mode
    help:     bool      // Show help
}

task parse_args(argv: VecStr) -> Args {
    set args = Args {
        command:  "",
        input:    "",
        output:   "output.c",
        verbose:  false,
        help:     false
    }
    
    set argc = vecstr_len(argv)
    
    // Skip program name (argv[0])
    set i = 1
    
    loop i < argc {
        set arg = vecstr_get(argv, i)
        
        check str_eq(arg, "-h") or str_eq(arg, "--help") {
            args.help = true
            i = i + 1
            continue
        }
        
        check str_eq(arg, "-v") or str_eq(arg, "--verbose") {
            args.verbose = true
            i = i + 1
            continue
        }
        
        check str_eq(arg, "-o") or str_eq(arg, "--output") {
            check i + 1 < argc {
                args.output = vecstr_get(argv, i + 1)
                i = i + 2
            } else {
                eprintln("Error: -o requires an argument")
                i = i + 1
            }
            continue
        }
        
        // Command or input file
        check str_len(args.command) == 0 {
            args.command = arg
        } else check str_len(args.input) == 0 {
            args.input = arg
        }
        
        i = i + 1
    }
    
    return args
}

/// Compile command
task cmd_compile(args: Args) -> int {
    check str_len(args.input) == 0 {
        eprintln("Error: no input file specified")
        return 1
    }
    
    check not file_exists(args.input) {
        eprintln("Error: input file not found")
        return 1
    }
    
    check args.verbose {
        print_str("Compiling: ")
        println(args.input)
    }
    
    check compile_to_c(args.input, args.output) {
        return 0
    }
    
    return 1
}

/// Lex command - print tokens
task cmd_lex(args: Args) -> int {
    check str_len(args.input) == 0 {
        eprintln("Error: no input file specified")
        return 1
    }
    
    set tokens = tokenize_file(args.input)
    print_tokens(tokens)
    vectok_free(tokens)
    
    return 0
}

/// Parse command - print AST
task cmd_parse(args: Args) -> int {
    check str_len(args.input) == 0 {
        eprintln("Error: no input file specified")
        return 1
    }
    
    set prog = parse_file(args.input)
    print_program(prog)
    program_free(prog)
    
    return 0
}

/// Check command - type check only
task cmd_check(args: Args) -> int {
    check str_len(args.input) == 0 {
        eprintln("Error: no input file specified")
        return 1
    }
    
    set prog = parse_file(args.input)
    
    check program_stmt_count(prog) == 0 {
        eprintln("Error: parse failed")
        return 1
    }
    
    println("Check passed (parsing successful)")
    program_free(prog)
    return 0
}

/// Format command - format source code
task cmd_fmt(args: Args) -> int {
    check str_len(args.input) == 0 {
        eprintln("Error: no input file specified")
        return 1
    }
    
    set source = file_read_all(args.input)
    check str_len(source) == 0 {
        eprintln("Error: could not read file")
        return 1
    }
    
    // Simple formatter - normalize indentation
    set formatted = format_source(source)
    
    // Write back
    file_write_all(args.input, formatted)
    println("Formatted successfully")
    
    free source
    free formatted
    return 0
}

/// Simple source formatter
task format_source(source: string) -> string {
    set result = sb_new()
    set indent = 0
    set lines = str_split(source, "\n")
    
    loop i from 0 to vecstr_len(lines) - 1 {
        set line = str_trim(vecstr_get(lines, i))
        
        // Skip empty lines (but keep one)
        check str_len(line) == 0 {
            result = sb_append(result, "\n")
            continue
        }
        
        // Decrease indent before }
        check str_starts_with(line, "}") and indent > 0 {
            indent = indent - 1
        }
        
        // Add indentation
        loop j from 0 to indent - 1 {
            result = sb_append(result, "    ")
        }
        
        // Add line
        result = sb_append(result, line)
        result = sb_append(result, "\n")
        
        // Increase indent after {
        check str_ends_with(line, "{") {
            indent = indent + 1
        }
    }
    
    vecstr_free(lines)
    return sb_to_string(result)
}

/// Main entry point
task main() -> int {
    // In a real implementation, we'd get argv from the runtime
    // For now, this is a placeholder showing the structure
    
    set argv = vecstr_new()
    argv = vecstr_push(argv, "sovereign")
    argv = vecstr_push(argv, "compile")
    argv = vecstr_push(argv, "test.sov")
    
    set args = parse_args(argv)
    
    check args.help {
        print_usage()
        return 0
    }
    
    check str_len(args.command) == 0 {
        print_usage()
        return 1
    }
    
    check str_eq(args.command, "compile") {
        return cmd_compile(args)
    }
    
    check str_eq(args.command, "lex") {
        return cmd_lex(args)
    }
    
    check str_eq(args.command, "parse") {
        return cmd_parse(args)
    }
    
    check str_eq(args.command, "check") {
        return cmd_check(args)
    }
    
    check str_eq(args.command, "fmt") {
        return cmd_fmt(args)
    }
    
    check str_eq(args.command, "version") or str_eq(args.command, "--version") {
        print_version()
        return 0
    }
    
    // Unknown command - try to treat as file
    check file_exists(args.command) {
        args.input = args.command
        args.command = "compile"
        return cmd_compile(args)
    }
    
    eprintln("Unknown command")
    print_usage()
    return 1
}
