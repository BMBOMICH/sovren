/// Sovereign AST Types - For Self-Hosted Compiler
/// These types mirror the Rust AST definitions to enable writing a compiler in Sovereign.
/// Used by: lexer_self.sov, parser_self.sov, codegen_self.sov

// ============================================================================
// SECTION 1: TOKEN TYPES
// ============================================================================

/// Token type enumeration - represents all possible tokens
/// We use integers as enum discriminants for simplicity
const TOK_EOF           = 0
const TOK_NEWLINE       = 1
const TOK_INDENT        = 2
const TOK_DEDENT        = 3

// Literals
const TOK_INTEGER       = 10
const TOK_FLOAT         = 11
const TOK_STRING        = 12
const TOK_IDENTIFIER    = 13

// Keywords
const TOK_SET           = 20
const TOK_TASK          = 21
const TOK_CHECK         = 22
const TOK_LOOP          = 23
const TOK_RETURN        = 24
const TOK_BREAK         = 25
const TOK_CONTINUE      = 26
const TOK_CONST         = 27
const TOK_STRUCT        = 28
const TOK_ENUM          = 29
const TOK_MATCH         = 30
const TOK_IMPORT        = 31
const TOK_FROM          = 32
const TOK_TO            = 33
const TOK_TIMES         = 34
const TOK_IN            = 35
const TOK_ELSE          = 36
const TOK_AND           = 37
const TOK_OR            = 38
const TOK_NOT           = 39
const TOK_TRUE          = 40
const TOK_FALSE         = 41
const TOK_NULL          = 42
const TOK_ASSERT        = 43
const TOK_STATIC_ASSERT = 44
const TOK_EXTERN        = 45
const TOK_INLINE        = 46
const TOK_SENSITIVE     = 47
const TOK_CONSTANT_TIME = 48
const TOK_OVERRIDE      = 49
const TOK_PURGE         = 50
const TOK_COPY          = 51
const TOK_ALLOC         = 52
const TOK_FREE          = 53
const TOK_SPAWN         = 54
const TOK_ASYNC         = 55
const TOK_AWAIT         = 56
const TOK_CHAN          = 57
const TOK_MAKE_CHAN     = 58
const TOK_DEFER         = 59
const TOK_TYPE          = 60
const TOK_COMPTIME      = 61
const TOK_NAMESPACE     = 62
const TOK_USE           = 63
const TOK_WHERE         = 64
const TOK_TEST          = 65
const TOK_OK            = 66
const TOK_ERR           = 67
const TOK_AS            = 68
const TOK_ASM           = 69

// Type keywords
const TOK_INT8          = 80
const TOK_INT16         = 81
const TOK_INT64         = 82
const TOK_UINT8         = 83
const TOK_UINT16        = 84
const TOK_UINT32        = 85
const TOK_UINT64        = 86

// Operators
const TOK_PLUS          = 100
const TOK_MINUS         = 101
const TOK_STAR          = 102
const TOK_SLASH         = 103
const TOK_PERCENT       = 104
const TOK_AMPERSAND     = 105
const TOK_PIPE          = 106
const TOK_CARET         = 107
const TOK_TILDE         = 108
const TOK_LSHIFT        = 109
const TOK_RSHIFT        = 110

// Comparison
const TOK_EQUAL         = 120
const TOK_NOT_EQUAL     = 121
const TOK_LESS          = 122
const TOK_LESS_EQUAL    = 123
const TOK_GREATER       = 124
const TOK_GREATER_EQUAL = 125

// Assignment
const TOK_ASSIGN        = 130
const TOK_PLUS_ASSIGN   = 131
const TOK_MINUS_ASSIGN  = 132
const TOK_STAR_ASSIGN   = 133
const TOK_SLASH_ASSIGN  = 134

// Punctuation
const TOK_LPAREN        = 140
const TOK_RPAREN        = 141
const TOK_LBRACE        = 142
const TOK_RBRACE        = 143
const TOK_LBRACKET      = 144
const TOK_RBRACKET      = 145
const TOK_COMMA         = 146
const TOK_DOT           = 147
const TOK_COLON         = 148
const TOK_SEMICOLON     = 149
const TOK_ARROW         = 150
const TOK_FAT_ARROW     = 151
const TOK_DOUBLE_COLON  = 152
const TOK_QUESTION      = 153
const TOK_AT            = 154
const TOK_HASH          = 155

/// Token structure - represents a single token from source
struct Token {
    kind:     int       // One of TOK_* constants
    str_val:  string    // String value (for identifiers, strings)
    int_val:  int       // Integer value (for numbers)
    float_val: float    // Float value (for floats)
    line:     int       // Source line number
    col:      int       // Source column number
}

/// Create a simple token (no value)
task token_new(kind: int, line: int, col: int) -> Token {
    return Token {
        kind:     kind,
        str_val:  "",
        int_val:  0,
        float_val: 0.0,
        line:     line,
        col:      col
    }
}

/// Create a token with string value
task token_with_str(kind: int, str_val: string, line: int, col: int) -> Token {
    return Token {
        kind:     kind,
        str_val:  str_val,
        int_val:  0,
        float_val: 0.0,
        line:     line,
        col:      col
    }
}

/// Create a token with integer value
task token_with_int(kind: int, int_val: int, line: int, col: int) -> Token {
    return Token {
        kind:     kind,
        str_val:  "",
        int_val:  int_val,
        float_val: 0.0,
        line:     line,
        col:      col
    }
}

/// Create a token with float value
task token_with_float(kind: int, float_val: float, line: int, col: int) -> Token {
    return Token {
        kind:     kind,
        str_val:  "",
        int_val:  0,
        float_val: float_val,
        line:     line,
        col:      col
    }
}

/// Get token kind name for debugging
task token_kind_name(kind: int) -> string {
    check kind == TOK_EOF { return "EOF" }
    check kind == TOK_NEWLINE { return "NEWLINE" }
    check kind == TOK_INTEGER { return "INTEGER" }
    check kind == TOK_FLOAT { return "FLOAT" }
    check kind == TOK_STRING { return "STRING" }
    check kind == TOK_IDENTIFIER { return "IDENTIFIER" }
    check kind == TOK_SET { return "SET" }
    check kind == TOK_TASK { return "TASK" }
    check kind == TOK_CHECK { return "CHECK" }
    check kind == TOK_LOOP { return "LOOP" }
    check kind == TOK_RETURN { return "RETURN" }
    check kind == TOK_STRUCT { return "STRUCT" }
    check kind == TOK_ENUM { return "ENUM" }
    check kind == TOK_MATCH { return "MATCH" }
    check kind == TOK_PLUS { return "PLUS" }
    check kind == TOK_MINUS { return "MINUS" }
    check kind == TOK_STAR { return "STAR" }
    check kind == TOK_SLASH { return "SLASH" }
    check kind == TOK_ASSIGN { return "ASSIGN" }
    check kind == TOK_EQUAL { return "EQUAL" }
    check kind == TOK_LPAREN { return "LPAREN" }
    check kind == TOK_RPAREN { return "RPAREN" }
    check kind == TOK_LBRACE { return "LBRACE" }
    check kind == TOK_RBRACE { return "RBRACE" }
    check kind == TOK_COMMA { return "COMMA" }
    check kind == TOK_DOT { return "DOT" }
    check kind == TOK_COLON { return "COLON" }
    check kind == TOK_ARROW { return "ARROW" }
    return "UNKNOWN"
}

// ============================================================================
// SECTION 2: TOKEN VECTOR (VecToken)
// ============================================================================

struct VecToken {
    data:     ptr
    length:   int
    capacity: int
}

/// Size of Token struct in bytes (approximation for alloc)
const TOKEN_SIZE = 48

/// Create a new token vector
task vectok_new() -> VecToken {
    return VecToken {
        data:     alloc(4, TOKEN_SIZE),
        length:   0,
        capacity: 4
    }
}

/// Push a token onto the vector
task vectok_push(v: VecToken, tok: Token) -> VecToken {
    check v.length >= v.capacity {
        set new_cap = v.capacity * 2
        set new_data = alloc(new_cap, TOKEN_SIZE)
        override {
            memcpy(new_data, v.data, v.length * TOKEN_SIZE)
        }
        free v.data
        v.data = new_data
        v.capacity = new_cap
    }
    
    // Store token fields
    set base = ptr_offset(v.data, v.length * TOKEN_SIZE)
    override {
        ptr_set_int(base, 0, tok.kind)
        ptr_set_int(base, 1, tok.str_val)
        ptr_set_int(base, 2, tok.int_val)
        // float_val stored as bits
        ptr_set_int(base, 4, tok.line)
        ptr_set_int(base, 5, tok.col)
    }
    v.length = v.length + 1
    return v
}

/// Get token at index
task vectok_get(v: VecToken, index: int) -> Token {
    assert(index >= 0 and index < v.length, "VecToken index out of bounds")
    set base = ptr_offset(v.data, index * TOKEN_SIZE)
    set tok = Token {
        kind:      0,
        str_val:   "",
        int_val:   0,
        float_val: 0.0,
        line:      0,
        col:       0
    }
    override {
        tok.kind = ptr_get_int(base, 0)
        tok.str_val = ptr_get_int(base, 1)
        tok.int_val = ptr_get_int(base, 2)
        tok.line = ptr_get_int(base, 4)
        tok.col = ptr_get_int(base, 5)
    }
    return tok
}

/// Get length of token vector
task vectok_len(v: VecToken) -> int {
    return v.length
}

/// Free token vector
task vectok_free(v: VecToken) {
    free v.data
}

// ============================================================================
// SECTION 3: TYPE REPRESENTATION
// ============================================================================

/// Type kinds
const TYPE_INT      = 1
const TYPE_FLOAT    = 2
const TYPE_BOOL     = 3
const TYPE_STRING   = 4
const TYPE_VOID     = 5
const TYPE_PTR      = 6
const TYPE_ARRAY    = 7
const TYPE_STRUCT   = 8
const TYPE_ENUM     = 9
const TYPE_FUNC     = 10
const TYPE_GENERIC  = 11
const TYPE_INT8     = 12
const TYPE_INT16    = 13
const TYPE_INT64    = 14
const TYPE_UINT8    = 15
const TYPE_UINT16   = 16
const TYPE_UINT32   = 17
const TYPE_UINT64   = 18

struct TypeInfo {
    kind:      int      // One of TYPE_* constants
    name:      string   // For struct/enum/generic names
    inner:     ptr      // For ptr/array: points to inner TypeInfo
    size:      int      // Array size (-1 for dynamic)
}

/// Create a basic type
task type_new(kind: int) -> TypeInfo {
    return TypeInfo {
        kind:  kind,
        name:  "",
        inner: null,
        size:  -1
    }
}

/// Create a named type (struct, enum, generic)
task type_named(kind: int, name: string) -> TypeInfo {
    return TypeInfo {
        kind:  kind,
        name:  name,
        inner: null,
        size:  -1
    }
}

/// Create a pointer type
task type_ptr(inner: ptr) -> TypeInfo {
    return TypeInfo {
        kind:  TYPE_PTR,
        name:  "",
        inner: inner,
        size:  -1
    }
}

/// Create an array type
task type_array(inner: ptr, size: int) -> TypeInfo {
    return TypeInfo {
        kind:  TYPE_ARRAY,
        name:  "",
        inner: inner,
        size:  size
    }
}

/// Get type name for debugging/codegen
task type_to_string(t: TypeInfo) -> string {
    check t.kind == TYPE_INT { return "int" }
    check t.kind == TYPE_FLOAT { return "float" }
    check t.kind == TYPE_BOOL { return "bool" }
    check t.kind == TYPE_STRING { return "string" }
    check t.kind == TYPE_VOID { return "void" }
    check t.kind == TYPE_INT8 { return "int8" }
    check t.kind == TYPE_INT16 { return "int16" }
    check t.kind == TYPE_INT64 { return "int64" }
    check t.kind == TYPE_UINT8 { return "uint8" }
    check t.kind == TYPE_UINT16 { return "uint16" }
    check t.kind == TYPE_UINT32 { return "uint32" }
    check t.kind == TYPE_UINT64 { return "uint64" }
    check t.kind == TYPE_PTR { return "ptr" }
    check t.kind == TYPE_STRUCT or t.kind == TYPE_ENUM or t.kind == TYPE_GENERIC {
        return t.name
    }
    return "unknown"
}

// ============================================================================
// SECTION 4: EXPRESSION AST
// ============================================================================

/// Expression kinds
const EXPR_INT          = 1
const EXPR_FLOAT        = 2
const EXPR_BOOL         = 3
const EXPR_STRING       = 4
const EXPR_NULL         = 5
const EXPR_VAR          = 6
const EXPR_BINARY       = 7
const EXPR_UNARY        = 8
const EXPR_CALL         = 9
const EXPR_INDEX        = 10
const EXPR_FIELD        = 11
const EXPR_STRUCT_INIT  = 12
const EXPR_ARRAY_INIT   = 13
const EXPR_CAST         = 14
const EXPR_SIZEOF       = 15
const EXPR_ALLOC        = 16
const EXPR_DEREF        = 17
const EXPR_ADDR_OF      = 18
const EXPR_TERNARY      = 19
const EXPR_LAMBDA       = 20
const EXPR_MATCH        = 21
const EXPR_RANGE        = 22
const EXPR_CHAN_RECV    = 23
const EXPR_AWAIT        = 24

/// Binary operators
const OP_ADD      = 1
const OP_SUB      = 2
const OP_MUL      = 3
const OP_DIV      = 4
const OP_MOD      = 5
const OP_AND      = 6
const OP_OR       = 7
const OP_BIT_AND  = 8
const OP_BIT_OR   = 9
const OP_BIT_XOR  = 10
const OP_LSHIFT   = 11
const OP_RSHIFT   = 12
const OP_EQ       = 13
const OP_NE       = 14
const OP_LT       = 15
const OP_LE       = 16
const OP_GT       = 17
const OP_GE       = 18

/// Unary operators
const UNOP_NEG    = 1
const UNOP_NOT    = 2
const UNOP_BITNOT = 3

/// Expression node - union-like struct
struct Expr {
    kind:       int         // One of EXPR_* constants
    int_val:    int         // For EXPR_INT
    float_val:  float       // For EXPR_FLOAT
    bool_val:   bool        // For EXPR_BOOL
    str_val:    string      // For EXPR_STRING, EXPR_VAR, EXPR_FIELD
    op:         int         // For EXPR_BINARY (OP_*), EXPR_UNARY (UNOP_*)
    left:       ptr         // For binary: left operand (Expr*)
    right:      ptr         // For binary: right operand (Expr*)
    callee:     string      // For EXPR_CALL: function name
    args:       ptr         // For EXPR_CALL: arguments (VecExpr*)
    type_info:  ptr         // For EXPR_CAST, EXPR_ALLOC: target type (TypeInfo*)
    line:       int         // Source location
    col:        int
}

/// Create integer literal expression
task expr_int(val: int, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_INT)
        ptr_set_int(e, 1, val)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create float literal expression
task expr_float(val: float, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_FLOAT)
        // Store float bits - simplified
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create boolean literal expression
task expr_bool(val: bool, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    set v = 0
    check val { v = 1 }
    override {
        ptr_set_int(e, 0, EXPR_BOOL)
        ptr_set_int(e, 3, v)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create string literal expression
task expr_string(val: string, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_STRING)
        ptr_set_int(e, 4, val)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create variable reference expression
task expr_var(name: string, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_VAR)
        ptr_set_int(e, 4, name)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create binary operation expression
task expr_binary(op: int, left: ptr, right: ptr, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_BINARY)
        ptr_set_int(e, 5, op)
        ptr_set_int(e, 6, left)
        ptr_set_int(e, 7, right)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create unary operation expression
task expr_unary(op: int, operand: ptr, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_UNARY)
        ptr_set_int(e, 5, op)
        ptr_set_int(e, 6, operand)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create function call expression
task expr_call(callee: string, args: ptr, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_CALL)
        ptr_set_int(e, 8, callee)
        ptr_set_int(e, 9, args)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create null expression
task expr_null(line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_NULL)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create field access expression (expr.field)
task expr_field(obj: ptr, field: string, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_FIELD)
        ptr_set_int(e, 6, obj)
        ptr_set_int(e, 4, field)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Create index expression (expr[index])
task expr_index(obj: ptr, index: ptr, line: int, col: int) -> ptr {
    set e = alloc(1, 128)
    override {
        ptr_set_int(e, 0, EXPR_INDEX)
        ptr_set_int(e, 6, obj)
        ptr_set_int(e, 7, index)
        ptr_set_int(e, 10, line)
        ptr_set_int(e, 11, col)
    }
    return e
}

/// Get expression kind
task expr_kind(e: ptr) -> int {
    check e == null { return 0 }
    override {
        return ptr_get_int(e, 0)
    }
    return 0
}

/// Get expression int value
task expr_get_int(e: ptr) -> int {
    override {
        return ptr_get_int(e, 1)
    }
    return 0
}

/// Get expression string value
task expr_get_str(e: ptr) -> string {
    override {
        return ptr_get_int(e, 4)
    }
    return ""
}

/// Get expression operator
task expr_get_op(e: ptr) -> int {
    override {
        return ptr_get_int(e, 5)
    }
    return 0
}

/// Get expression left operand
task expr_get_left(e: ptr) -> ptr {
    override {
        return ptr_get_int(e, 6)
    }
    return null
}

/// Get expression right operand
task expr_get_right(e: ptr) -> ptr {
    override {
        return ptr_get_int(e, 7)
    }
    return null
}

/// Get function call callee
task expr_get_callee(e: ptr) -> string {
    override {
        return ptr_get_int(e, 8)
    }
    return ""
}

/// Get function call args
task expr_get_args(e: ptr) -> ptr {
    override {
        return ptr_get_int(e, 9)
    }
    return null
}

/// Get expression source line
task expr_get_line(e: ptr) -> int {
    override {
        return ptr_get_int(e, 10)
    }
    return 0
}

/// Get expression source column
task expr_get_col(e: ptr) -> int {
    override {
        return ptr_get_int(e, 11)
    }
    return 0
}

// ============================================================================
// EXPRESSION ACCESSOR ALIASES (convenience wrappers)
// ============================================================================

/// Get expression name (for EXPR_VAR: variable name, EXPR_CALL: function name)
/// Alias for expr_get_str
task expr_get_name(e: ptr) -> string {
    return expr_get_str(e)
}

/// Get expression operand (for EXPR_UNARY: the operand expression)
/// Alias for expr_get_left
task expr_get_operand(e: ptr) -> ptr {
    return expr_get_left(e)
}

/// Get expression object (for EXPR_FIELD: the object being accessed)
/// Alias for expr_get_left
task expr_get_object(e: ptr) -> ptr {
    return expr_get_left(e)
}

/// Get expression field name (for EXPR_FIELD: the field name string)
/// Alias for expr_get_str
task expr_get_field(e: ptr) -> string {
    return expr_get_str(e)
}

/// Get expression array (for EXPR_INDEX: the array expression)
/// Alias for expr_get_left
task expr_get_array(e: ptr) -> ptr {
    return expr_get_left(e)
}

/// Get expression index (for EXPR_INDEX: the index expression)
/// Alias for expr_get_right
task expr_get_index(e: ptr) -> ptr {
    return expr_get_right(e)
}

/// Get expression type name (for EXPR_STRUCT_INIT, etc.)
/// Alias for expr_get_str
task expr_get_type_name(e: ptr) -> string {
    return expr_get_str(e)
}

/// Get expression cast target type (for EXPR_CAST: type info pointer)
/// The type_info is stored at position 10 (before line/col were added)
/// Actually type_info is stored differently; use a separate field
/// For now, alias to callee position
task expr_get_cast_type(e: ptr) -> string {
    return expr_get_callee(e)
}

// ============================================================================
// CONVENIENCE ACCESSORS FOR PARAM/ARGS VECTORS
// ============================================================================

/// Get number of parameters in a VecParam
task params_count(p: ptr) -> int {
    check p == null { return 0 }
    // VecParam stores data at offset 0
    override { return ptr_get_int(p, 4) }
    return 0
}

/// Get parameter at index
task params_get(p: ptr, index: int) -> ptr {
    check p == null { return null }
    set data = 0
    set length = 0
    override { 
        data = ptr_get_int(p, 0)
        length = ptr_get_int(p, 4)
    }
    check index >= 0 and index < length { return null }
    // Each param is 16 bytes: name(string) at offset 0, type_info(ptr) at offset 8
    set base = ptr_offset(data, index * 16)
    return base
}

/// Get parameter name
task param_get_name(param: ptr) -> string {
    override { return ptr_get_int(param, 0) }
    return ""
}

/// Get parameter type
task param_get_type(param: ptr) -> string {
    set ti = 0
    override { ti = ptr_get_int(param, 8) }
    // TypeInfo: kind at offset 0, name at offset 8
    check ti != 0 {
        set kind = 0
        override { kind = ptr_get_int(ti, 0) }
        check kind == TYPE_INT { return "int" }
        check kind == TYPE_FLOAT { return "float" }
        check kind == TYPE_BOOL { return "bool" }
        check kind == TYPE_STRING { return "string" }
        check kind == TYPE_INT8 { return "int8" }
        check kind == TYPE_INT16 { return "int16" }
        check kind == TYPE_INT64 { return "int64" }
        check kind == TYPE_UINT8 { return "uint8" }
        check kind == TYPE_UINT16 { return "uint16" }
        check kind == TYPE_UINT32 { return "uint32" }
        check kind == TYPE_UINT64 { return "uint64" }
        set name = 0
        override { name = ptr_get_int(ti, 8) }
        check name != 0 { return name }
    }
    return ""
}

/// Get number of args in a VecExpr (args is a pointer to VecExpr)
task args_count(args: ptr) -> int {
    check args == null { return 0 }
    // VecExpr layout: data at offset 0, length at offset 8, capacity at offset 16
    set len = 0
    override { len = ptr_get_int(args, 1) }
    return len
}

/// Get argument at index (args is a pointer to VecExpr)
task args_get(args: ptr, index: int) -> ptr {
    check args == null { return null }
    set len = 0
    set data = 0
    override { 
        data = ptr_get_int(args, 0)
        len = ptr_get_int(args, 1)
    }
    check index >= 0 and index < len { return null }
    set result = 0
    override { result = ptr_get_int(data, index) }
    return result
}

/// Get number of statements in a block (uses raw ptr access since block is ptr to VecStmt)
task block_stmt_count(block: ptr) -> int {
    check block == null { return 0 }
    // VecStmt layout: data at offset 0, length at offset 8, capacity at offset 16
    set len = 0
    override { len = ptr_get_int(block, 1) }
    return len
}

/// Get statement at index from a block
task block_get_stmt(block: ptr, index: int) -> ptr {
    check block == null { return null }
    set len = 0
    set data = 0
    override { 
        data = ptr_get_int(block, 0)
        len = ptr_get_int(block, 1)
    }
    check index >= 0 and index < len { return null }
    set result = 0
    override { result = ptr_get_int(data, index) }
    return result
}

// ============================================================================
// SECTION 5: EXPRESSION VECTOR (VecExpr)
// ============================================================================

struct VecExpr {
    data:     ptr
    length:   int
    capacity: int
}

/// Create a new expression vector
task vecexpr_new() -> VecExpr {
    return VecExpr {
        data:     alloc(4, 8),
        length:   0,
        capacity: 4
    }
}

/// Push an expression pointer onto the vector
task vecexpr_push(v: VecExpr, e: ptr) -> VecExpr {
    check v.length >= v.capacity {
        set new_cap = v.capacity * 2
        set new_data = alloc(new_cap, 8)
        override {
            memcpy(new_data, v.data, v.length * 8)
        }
        free v.data
        v.data = new_data
        v.capacity = new_cap
    }
    override {
        ptr_set_int(v.data, v.length, e)
    }
    v.length = v.length + 1
    return v
}

/// Get expression at index
task vecexpr_get(v: VecExpr, index: int) -> ptr {
    assert(index >= 0 and index < v.length, "VecExpr index out of bounds")
    override {
        return ptr_get_int(v.data, index)
    }
    return null
}

/// Get length
task vecexpr_len(v: VecExpr) -> int {
    return v.length
}

/// Free vector (does not free expressions)
task vecexpr_free(v: VecExpr) {
    free v.data
}

// ============================================================================
// SECTION 6: STATEMENT AST
// ============================================================================

/// Statement kinds
const STMT_VAR_DECL     = 1
const STMT_CONST_DECL   = 2
const STMT_TASK_DECL    = 3
const STMT_STRUCT_DECL  = 4
const STMT_ENUM_DECL    = 5
const STMT_RETURN       = 6
const STMT_EXPR         = 7
const STMT_ASSIGN       = 8
const STMT_IF           = 9
const STMT_LOOP         = 10
const STMT_LOOP_TIMES   = 11
const STMT_LOOP_RANGE   = 12
const STMT_LOOP_COND    = 13
const STMT_BREAK        = 14
const STMT_CONTINUE     = 15
const STMT_BLOCK        = 16
const STMT_ASSERT       = 17
const STMT_MATCH        = 18
const STMT_IMPORT       = 19
const STMT_EXTERN       = 20
const STMT_SPAWN        = 21
const STMT_CHAN_SEND    = 22
const STMT_DEFER        = 23
const STMT_PURGE        = 24
const STMT_FREE         = 25
const STMT_OVERRIDE     = 26
const STMT_CONSTANT_TIME = 27
const STMT_TYPE_ALIAS   = 28
const STMT_ASYNC        = 29
const STMT_AWAIT        = 30
const STMT_MAKE_CHAN    = 31
const STMT_CHAN_DECL    = 32
const STMT_CHAN_RECV    = 33
const STMT_COMPTIME     = 34
const STMT_NAMESPACE    = 35
const STMT_USE          = 36
const STMT_TEST         = 37
const STMT_EXTERN_DECL  = 38
const STMT_ASM          = 39

/// Statement node
struct Stmt {
    kind:        int        // One of STMT_* constants
    name:        string     // For declarations
    expr:        ptr        // For STMT_EXPR, STMT_RETURN, etc. (Expr*)
    expr2:       ptr        // For STMT_ASSIGN (rhs), STMT_LOOP_RANGE (end)
    block:       ptr        // For control flow (VecStmt*)
    else_block:  ptr        // For STMT_IF (VecStmt*)
    params:      ptr        // For STMT_TASK_DECL (VecParam*)
    return_type: ptr        // For STMT_TASK_DECL (TypeInfo*)
    type_info:   ptr        // For STMT_VAR_DECL (TypeInfo*)
    is_sensitive: bool
    is_inline:   bool
    is_async:    bool
    is_extern:   bool
    line:        int
    col:         int
}

/// Create a variable declaration statement
task stmt_var_decl(name: string, type_info: ptr, init: ptr, is_sensitive: bool, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_VAR_DECL)
        ptr_set_int(s, 1, name)
        ptr_set_int(s, 2, init)
        ptr_set_int(s, 7, type_info)
        ptr_set_int(s, 8, is_sensitive)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create a constant declaration statement
task stmt_const_decl(name: string, init: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_CONST_DECL)
        ptr_set_int(s, 1, name)
        ptr_set_int(s, 2, init)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create a return statement
task stmt_return(expr: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_RETURN)
        ptr_set_int(s, 2, expr)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create an expression statement
task stmt_expr(expr: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_EXPR)
        ptr_set_int(s, 2, expr)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create an assignment statement
task stmt_assign(target: ptr, value: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_ASSIGN)
        ptr_set_int(s, 2, target)
        ptr_set_int(s, 3, value)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create an if statement
task stmt_if(condition: ptr, then_block: ptr, else_block: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_IF)
        ptr_set_int(s, 2, condition)
        ptr_set_int(s, 4, then_block)
        ptr_set_int(s, 5, else_block)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create a loop-times statement (loop N times { })
task stmt_loop_times(count: ptr, body: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_LOOP_TIMES)
        ptr_set_int(s, 2, count)
        ptr_set_int(s, 4, body)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create a loop-range statement (loop i from a to b { })
task stmt_loop_range(var_name: string, start: ptr, end_expr: ptr, body: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_LOOP_RANGE)
        ptr_set_int(s, 1, var_name)
        ptr_set_int(s, 2, start)
        ptr_set_int(s, 3, end_expr)
        ptr_set_int(s, 4, body)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create a conditional loop (loop condition { })
task stmt_loop_cond(condition: ptr, body: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_LOOP_COND)
        ptr_set_int(s, 2, condition)
        ptr_set_int(s, 4, body)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create a break statement
task stmt_break(line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_BREAK)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create a continue statement
task stmt_continue(line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_CONTINUE)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Create a block statement
task stmt_block(stmts: ptr, line: int, col: int) -> ptr {
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_BLOCK)
        ptr_set_int(s, 4, stmts)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Get statement kind
task stmt_kind(s: ptr) -> int {
    check s == null { return 0 }
    override {
        return ptr_get_int(s, 0)
    }
    return 0
}

/// Get statement name
task stmt_get_name(s: ptr) -> string {
    override {
        return ptr_get_int(s, 1)
    }
    return ""
}

/// Get statement expression
task stmt_get_expr(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 2)
    }
    return null
}

/// Get statement second expression
task stmt_get_expr2(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 3)
    }
    return null
}

/// Get statement block
task stmt_get_block(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 4)
    }
    return null
}

/// Get statement else block
task stmt_get_else_block(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 5)
    }
    return null
}

/// Get statement params (for task/fn declarations)
task stmt_get_params(s: ptr) -> ptr {
    override {
        return ptr_get_int(s, 6)
    }
    return null
}

/// Get statement return type (for task/fn declarations)
/// Returns type name string - the type_info pointer is stored at slot 7
task stmt_get_return_type(s: ptr) -> string {
    set ti = 0
    override { ti = ptr_get_int(s, 7) }
    check ti != 0 {
        set kind = 0
        override { kind = ptr_get_int(ti, 0) }
        check kind == TYPE_INT { return "int" }
        check kind == TYPE_FLOAT { return "float" }
        check kind == TYPE_BOOL { return "bool" }
        check kind == TYPE_STRING { return "string" }
        check kind == TYPE_VOID { return "void" }
        check kind == TYPE_INT8 { return "int8" }
        check kind == TYPE_INT16 { return "int16" }
        check kind == TYPE_INT64 { return "int64" }
        check kind == TYPE_UINT8 { return "uint8" }
        check kind == TYPE_UINT16 { return "uint16" }
        check kind == TYPE_UINT32 { return "uint32" }
        check kind == TYPE_UINT64 { return "uint64" }
        return ""
    }
    return ""
}

/// Get statement type (for var declarations) - stored at slot 7
task stmt_get_type(s: ptr) -> string {
    return stmt_get_return_type(s)
}

/// Get statement condition expression (for if, loop)
/// Stored at slot 2 (expr field)
task stmt_get_condition(s: ptr) -> ptr {
    return stmt_get_expr(s)
}

/// Get statement then block (for if)
/// Stored at slot 4 (block field)
task stmt_get_then_block(s: ptr) -> ptr {
    return stmt_get_block(s)
}

/// Get loop variable name (for loop i from...)
/// Stored at slot 1 (name field)
task stmt_get_loop_var(s: ptr) -> string {
    return stmt_get_name(s)
}

/// Get loop start expression (for loop i from start to end)
/// Stored at slot 2 (expr field)
task stmt_get_start_expr(s: ptr) -> ptr {
    return stmt_get_expr(s)
}

/// Get loop end expression (for loop i from start to end)
/// Stored at slot 3 (expr2 field)
task stmt_get_end_expr(s: ptr) -> ptr {
    return stmt_get_expr2(s)
}

/// Check if statement is marked sensitive
task stmt_is_sensitive(s: ptr) -> bool {
    set val = 0
    override { val = ptr_get_int(s, 8) }
    return val != 0
}

// ============================================================================
// SECTION 7: STATEMENT VECTOR (VecStmt)
// ============================================================================

struct VecStmt {
    data:     ptr
    length:   int
    capacity: int
}

/// Create a new statement vector
task vecstmt_new() -> VecStmt {
    return VecStmt {
        data:     alloc(8, 8),
        length:   0,
        capacity: 8
    }
}

/// Push a statement pointer onto the vector
task vecstmt_push(v: VecStmt, s: ptr) -> VecStmt {
    check v.length >= v.capacity {
        set new_cap = v.capacity * 2
        set new_data = alloc(new_cap, 8)
        override {
            memcpy(new_data, v.data, v.length * 8)
        }
        free v.data
        v.data = new_data
        v.capacity = new_cap
    }
    override {
        ptr_set_int(v.data, v.length, s)
    }
    v.length = v.length + 1
    return v
}

/// Get statement at index
task vecstmt_get(v: VecStmt, index: int) -> ptr {
    assert(index >= 0 and index < v.length, "VecStmt index out of bounds")
    override {
        return ptr_get_int(v.data, index)
    }
    return null
}

/// Get length
task vecstmt_len(v: VecStmt) -> int {
    return v.length
}

/// Free vector (does not free statements)
task vecstmt_free(v: VecStmt) {
    free v.data
}

// ============================================================================
// SECTION 8: PROGRAM AND PARAMETER TYPES
// ============================================================================

struct Param {
    name:      string
    type_info: ptr      // TypeInfo*
}

struct VecParam {
    data:     ptr
    length:   int
    capacity: int
}

/// Create a new parameter vector
task vecparam_new() -> VecParam {
    return VecParam {
        data:     alloc(4, 16),
        length:   0,
        capacity: 4
    }
}

/// Push a parameter
task vecparam_push(v: VecParam, name: string, type_info: ptr) -> VecParam {
    check v.length >= v.capacity {
        set new_cap = v.capacity * 2
        set new_data = alloc(new_cap, 16)
        override {
            memcpy(new_data, v.data, v.length * 16)
        }
        free v.data
        v.data = new_data
        v.capacity = new_cap
    }
    override {
        ptr_set_int(v.data, v.length * 2, name)
        ptr_set_int(v.data, v.length * 2 + 1, type_info)
    }
    v.length = v.length + 1
    return v
}

/// Get parameter name at index
task vecparam_get_name(v: VecParam, index: int) -> string {
    assert(index >= 0 and index < v.length, "VecParam index out of bounds")
    override {
        return ptr_get_int(v.data, index * 2)
    }
    return ""
}

/// Get parameter type at index
task vecparam_get_type(v: VecParam, index: int) -> ptr {
    assert(index >= 0 and index < v.length, "VecParam index out of bounds")
    override {
        return ptr_get_int(v.data, index * 2 + 1)
    }
    return null
}

/// Get length
task vecparam_len(v: VecParam) -> int {
    return v.length
}

/// Free vector
task vecparam_free(v: VecParam) {
    free v.data
}

/// Program - the root AST node
struct Program {
    statements: VecStmt
    filename:   string
}

/// Create a new program
task program_new(filename: string) -> Program {
    return Program {
        statements: vecstmt_new(),
        filename:   filename
    }
}

/// Add a statement to the program
task program_add_stmt(p: Program, s: ptr) -> Program {
    p.statements = vecstmt_push(p.statements, s)
    return p
}

/// Get number of statements
task program_stmt_count(p: Program) -> int {
    return vecstmt_len(p.statements)
}

/// Get statement at index
task program_get_stmt(p: Program, index: int) -> ptr {
    return vecstmt_get(p.statements, index)
}

/// Free program
task program_free(p: Program) {
    vecstmt_free(p.statements)
}
