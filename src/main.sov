// ============================================================================
// Sovereign Compiler - Main Entry Point
// Written entirely in Sovereign
// ============================================================================

import "stdlib_native.sov"
import "stdlib_ast.sov"
import "lexer_self.sov"
import "parser_self.sov"
import "semantic_self.sov"
import "codegen_self.sov"

// ── Version Info ──────────────────────────────────────────────────────────
const VERSION = "1.0.0"
const PROGRAM_NAME = "sovereign"

// ── CLI Arguments Structure ───────────────────────────────────────────────
struct CliArgs {
    command: string,
    input_file: string,
    output_file: string,
    target: string,
    optimize: bool,
    debug_mode: bool,
    show_help: bool,
    show_version: bool,
    format_mode: bool,
    check_only: bool,
    run_tests: bool,
    repl_mode: bool
}

// ── Print Usage ───────────────────────────────────────────────────────────
task print_usage() {
    print "Sovereign v1.0.0 - The privacy-first systems language"
    print ""
    print "Usage: sovereign <command> [options] [file.sov]"
    print ""
    print "Commands:"
    print "  build <file.sov>      Compile to native binary"
    print "  run <file.sov>        Interpret/run directly"
    print "  check <file.sov>      Type-check only (no output)"
    print "  fmt <file.sov>        Format source code"
    print "  test <file.sov>       Run tests in file"
    print "  repl                  Interactive REPL"
    print ""
    print "Build Options:"
    print "  -o <file>             Output file name"
    print "  --target <target>     Cross-compile target:"
    print "                          c, llvm, wasm, evm"
    print "                          windows-x64, linux-x64, linux-arm64"
    print "                          macos-x64, macos-arm64"
    print "  --optimize            Enable optimizations"
    print "  --debug               Include debug symbols"
    print "  --size                Optimize for size"
    print ""
    print "Other Options:"
    print "  --help, -h            Show this help"
    print "  --version, -v         Show version"
    print ""
    print "Examples:"
    print "  sovereign build hello.sov"
    print "  sovereign build app.sov -o myapp --optimize"
    print "  sovereign build lib.sov --target wasm"
    print "  sovereign run script.sov"
    print "  sovereign check myfile.sov"
    print "  sovereign fmt myfile.sov"
}

// ── Print Version ─────────────────────────────────────────────────────────
task print_version() {
    print_fmt("Sovereign %s", VERSION)
    print ""
    print "The privacy-first systems programming language"
    print ""
    print "Features:"
    print "  - Zero-cost abstractions"
    print "  - Memory safety without garbage collection"
    print "  - Sensitive data auto-zeroing"
    print "  - Constant-time security blocks"
    print "  - Native compilation via C backend"
    print "  - Cross-compilation to 7 targets"
    print ""
    print "Written entirely in Sovereign (self-hosting)"
    print "https://github.com/example/sovereign"
}

// ── Parse CLI Arguments ───────────────────────────────────────────────────
task parse_args(argc: int, argv: ptr) -> CliArgs {
    set args = CliArgs {
        command: "",
        input_file: "",
        output_file: "",
        target: "c",
        optimize: false,
        debug_mode: false,
        show_help: false,
        show_version: false,
        format_mode: false,
        check_only: false,
        run_tests: false,
        repl_mode: false
    }
    
    check argc < 2 {
        args.show_help = true
        return args
    }
    
    set i = 1
    loop i < argc {
        set arg = argv_get_string(argv, i)
        
        check str_eq(arg, "--help") or str_eq(arg, "-h") {
            args.show_help = true
            return args
        }
        
        check str_eq(arg, "--version") or str_eq(arg, "-v") {
            args.show_version = true
            return args
        }
        
        check str_eq(arg, "build") {
            args.command = "build"
            i = i + 1
            continue
        }
        
        check str_eq(arg, "run") {
            args.command = "run"
            i = i + 1
            continue
        }
        
        check str_eq(arg, "check") {
            args.command = "check"
            args.check_only = true
            i = i + 1
            continue
        }
        
        check str_eq(arg, "fmt") {
            args.command = "fmt"
            args.format_mode = true
            i = i + 1
            continue
        }
        
        check str_eq(arg, "test") {
            args.command = "test"
            args.run_tests = true
            i = i + 1
            continue
        }
        
        check str_eq(arg, "repl") {
            args.command = "repl"
            args.repl_mode = true
            i = i + 1
            continue
        }
        
        check str_eq(arg, "-o") {
            i = i + 1
            check i < argc {
                args.output_file = argv_get_string(argv, i)
            }
            i = i + 1
            continue
        }
        
        check str_eq(arg, "--target") {
            i = i + 1
            check i < argc {
                args.target = argv_get_string(argv, i)
            }
            i = i + 1
            continue
        }
        
        check str_eq(arg, "--optimize") {
            args.optimize = true
            i = i + 1
            continue
        }
        
        check str_eq(arg, "--debug") {
            args.debug_mode = true
            i = i + 1
            continue
        }
        
        // If not a flag, treat as input file
        check str_starts_with(arg, "-") == false {
            check args.input_file == "" {
                args.input_file = arg
            }
        }
        
        i = i + 1
    }
    
    return args
}

// ── Read Source File ──────────────────────────────────────────────────────
task read_source_file(path: string) -> string {
    set file = file_open(path, "r")
    check file == null {
        print_fmt("Error: Cannot open file '%s'", path)
        return ""
    }
    
    set content = file_read_all(file)
    file_close(file)
    return content
}

// ── Write Output File ─────────────────────────────────────────────────────
task write_output_file(path: string, content: string) -> bool {
    set file = file_open(path, "w")
    check file == null {
        print_fmt("Error: Cannot create file '%s'", path)
        return false
    }
    
    file_write_string(file, content)
    file_close(file)
    return true
}

// ── Compile Source ────────────────────────────────────────────────────────
task compile_source(source: string, filename: string, target: string, optimize: bool) -> string {
    // Phase 1: Lexical Analysis
    set lexer = lexer_new(source, filename)
    set tokens = lexer_tokenize(lexer)
    
    check tokens.len == 0 {
        print "Error: Lexer produced no tokens"
        return ""
    }
    
    // Phase 2: Parsing
    set parser = parser_new(tokens, filename)
    set program = parser_parse(parser)
    
    check program.statements.len == 0 and parser.errors.len > 0 {
        print "Parse errors:"
        set i = 0
        loop i < parser.errors.len {
            print_fmt("  %s", vec_get_string(parser.errors, i))
            i = i + 1
        }
        return ""
    }
    
    // Phase 3: Semantic Analysis
    set analyzer = analyzer_new()
    set sem_result = analyzer_check(analyzer, program)
    
    check sem_result.has_errors {
        print "Semantic errors:"
        set i = 0
        loop i < sem_result.errors.len {
            print_fmt("  %s", vec_get_string(sem_result.errors, i))
            i = i + 1
        }
        return ""
    }
    
    // Phase 4: Code Generation
    set codegen = codegen_new(target, optimize)
    set output = codegen_generate(codegen, program)
    
    return output
}

// ── Format Source ─────────────────────────────────────────────────────────
task format_source(source: string) -> string {
    set result = string_builder_new()
    set lines = str_split(source, "\n")
    set indent = 0
    set prev_blank = false
    
    set i = 0
    loop i < lines.len {
        set line = vec_get_string(lines, i)
        set trimmed = str_trim(line)
        
        // Handle blank lines
        check str_len(trimmed) == 0 {
            check prev_blank == false {
                string_builder_append(result, "\n")
            }
            prev_blank = true
            i = i + 1
            continue
        }
        prev_blank = false
        
        // Decrease indent for closing braces
        check str_starts_with(trimmed, "}") {
            check indent > 0 {
                indent = indent - 1
            }
        }
        
        // Write indentation
        set j = 0
        loop j < indent {
            string_builder_append(result, "    ")
            j = j + 1
        }
        
        // Write line content
        string_builder_append(result, trimmed)
        string_builder_append(result, "\n")
        
        // Increase indent after opening braces
        check str_ends_with(trimmed, "{") {
            indent = indent + 1
        }
        
        i = i + 1
    }
    
    return string_builder_to_string(result)
}

// ── Run REPL ──────────────────────────────────────────────────────────────
task run_repl() {
    print "Sovereign v1.0.0 REPL - type 'exit' to quit"
    print "All language features available."
    print ""
    
    // Simple interpreter state
    set vars = hashmap_new()
    
    loop {
        print_raw(">>> ")
        set line = read_line()
        
        check line == null or str_eq(str_trim(line), "exit") {
            break
        }
        
        set trimmed = str_trim(line)
        check str_len(trimmed) == 0 {
            continue
        }
        
        check str_eq(trimmed, "help") {
            print "Commands:"
            print "  exit          - Exit REPL"
            print "  help          - Show this help"
            print "  set x = 42    - Declare variable"
            print "  print x       - Print variable"
            print "  x + y         - Evaluate expression"
            continue
        }
        
        // Try to compile and evaluate the line
        set result = compile_source(trimmed, "<repl>", "eval", false)
        check str_len(result) > 0 {
            print result
        }
    }
    
    print "Goodbye."
}

// ── Run Tests ─────────────────────────────────────────────────────────────
task run_tests(source: string, filename: string) -> int {
    print_fmt("Running tests in %s...", filename)
    print ""
    
    // Parse the source to find test functions
    set lexer = lexer_new(source, filename)
    set tokens = lexer_tokenize(lexer)
    set parser = parser_new(tokens, filename)
    set program = parser_parse(parser)
    
    set passed = 0
    set failed = 0
    set total = 0
    
    // Find all test functions (functions starting with "test_")
    set i = 0
    loop i < program.statements.len {
        set stmt = vec_get_ptr(program.statements, i)
        set stmt_kind = stmt_get_kind(stmt)
        
        check stmt_kind == STMT_TASK {
            set name = stmt_get_task_name(stmt)
            check str_starts_with(name, "test_") {
                total = total + 1
                print_fmt("  Running %s...", name)
                
                // Compile and run the test
                set test_result = compile_source(source, filename, "eval", false)
                check str_contains(test_result, "FAIL") {
                    print_fmt("    FAILED")
                    failed = failed + 1
                } else {
                    print_fmt("    PASSED")
                    passed = passed + 1
                }
            }
        }
        
        i = i + 1
    }
    
    print ""
    print_fmt("Results: %d passed, %d failed, %d total", passed, failed, total)
    
    check failed > 0 {
        return 1
    }
    return 0
}

// ── Main Entry Point ──────────────────────────────────────────────────────
task main(argc: int, argv: ptr) -> int {
    set args = parse_args(argc, argv)
    
    // Handle --help
    check args.show_help {
        print_usage()
        return 0
    }
    
    // Handle --version
    check args.show_version {
        print_version()
        return 0
    }
    
    // Handle REPL
    check args.repl_mode {
        run_repl()
        return 0
    }
    
    // Require input file for other commands
    check args.input_file == "" {
        print "Error: No input file specified"
        print "Use 'sovereign --help' for usage information"
        return 1
    }
    
    // Read source file
    set source = read_source_file(args.input_file)
    check str_len(source) == 0 {
        return 1
    }
    
    // Handle fmt command
    check args.format_mode {
        set formatted = format_source(source)
        check args.output_file != "" {
            write_output_file(args.output_file, formatted)
            print_fmt("Formatted: %s -> %s", args.input_file, args.output_file)
        } else {
            // Write back to same file
            write_output_file(args.input_file, formatted)
            print_fmt("Formatted: %s", args.input_file)
        }
        return 0
    }
    
    // Handle test command
    check args.run_tests {
        return run_tests(source, args.input_file)
    }
    
    // Handle check command
    check args.check_only {
        set lexer = lexer_new(source, args.input_file)
        set tokens = lexer_tokenize(lexer)
        set parser = parser_new(tokens, args.input_file)
        set program = parser_parse(parser)
        
        check parser.errors.len > 0 {
            print "Parse errors:"
            set i = 0
            loop i < parser.errors.len {
                print_fmt("  %s", vec_get_string(parser.errors, i))
                i = i + 1
            }
            return 1
        }
        
        set analyzer = analyzer_new()
        set sem_result = analyzer_check(analyzer, program)
        
        check sem_result.has_errors {
            print "Type errors:"
            set i = 0
            loop i < sem_result.errors.len {
                print_fmt("  %s", vec_get_string(sem_result.errors, i))
                i = i + 1
            }
            return 1
        }
        
        print_fmt("OK: %s type-checks successfully", args.input_file)
        return 0
    }
    
    // Handle build command (default)
    set output = compile_source(source, args.input_file, args.target, args.optimize)
    check str_len(output) == 0 {
        return 1
    }
    
    // Determine output filename
    set out_file = args.output_file
    check out_file == "" {
        out_file = str_replace(args.input_file, ".sov", "")
        check str_eq(args.target, "c") {
            out_file = str_concat(out_file, ".c")
        } else check str_eq(args.target, "wasm") {
            out_file = str_concat(out_file, ".wasm")
        } else {
            // Native binary - no extension on Unix
        }
    }
    
    // Write output
    check write_output_file(out_file, output) {
        print_fmt("Compiled: %s -> %s", args.input_file, out_file)
        
        // For C target, remind about compiling
        check str_eq(args.target, "c") {
            print ""
            print "To create executable:"
            print_fmt("  gcc -O2 %s runtime/runtime.c -o %s", out_file, str_replace(out_file, ".c", ""))
        }
        
        return 0
    }
    
    return 1
}
