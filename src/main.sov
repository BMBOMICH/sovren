import "stdlib_native.sov"
import "stdlib_ast.sov"
import "lexer_self.sov"
import "parser_self.sov"
import "codegen_self.sov"

task main(argc: int, argv: ptr) -> int {
    check argc < 2 {
        return 1
    }
    set i = 1
    set in_file = 0
    set out_file = 0
    loop i < argc {
        check str_eq(argv_get_string(argv, i), "-o") {
            i = i + 1
            check i < argc {
                out_file = 1
            }
            i = i + 1
            continue
        }
        check in_file == 0 {
            in_file = i
        }
        i = i + 1
    }
    check in_file == 0 {
        return 1
    }
    set source = file_read_all(argv_get_string(argv, in_file))
    check str_len(source) == 0 {
        return 1
    }
    set lexer = lexer_new(source, argv_get_string(argv, in_file))
    set tokens = lexer_tokenize(lexer)
    set parser = parser_new(tokens, argv_get_string(argv, in_file))
    set program = parser_parse(parser)
    set codegen = codegen_new()
    set output = codegen_generate(codegen, program)
    file_write_all(str_concat(str_replace(argv_get_string(argv, in_file), ".sov", ""), ".c"), output)
    return 0
}
