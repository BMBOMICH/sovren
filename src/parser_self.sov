/// Sovereign Self-Hosted Parser
/// Parses a token stream into an AST (Abstract Syntax Tree).
///
/// Dependencies:
///   - stdlib_native.sov (string operations, collections)
///   - stdlib_ast.sov (AST types)
///   - lexer_self.sov (Token types, VecToken)
///
/// Usage:
///   set tokens = tokenize_file("program.sov")
///   set parser = parser_new(tokens, "program.sov")
///   set program = parser_parse(parser)

// ============================================================================
// PARSER STATE
// ============================================================================

struct Parser {
    tokens:   VecToken    // Token stream
    pos:      int         // Current position
    length:   int         // Number of tokens
    filename: string      // For error messages
    errors:   VecStr      // Accumulated errors
}

/// Create a new parser
task parser_new(tokens: VecToken, filename: string) -> Parser {
    return Parser {
        tokens:   tokens,
        pos:      0,
        length:   vectok_len(tokens),
        filename: filename,
        errors:   vecstr_new()
    }
}

/// Check if at end of token stream
task parser_at_end(p: Parser) -> bool {
    return p.pos >= p.length
}

/// Get current token
task parser_current(p: Parser) -> Token {
    check p.pos >= p.length {
        return token_new(TOK_EOF, 0, 0)
    }
    return vectok_get(p.tokens, p.pos)
}

/// Peek at next token
task parser_peek(p: Parser) -> Token {
    check p.pos + 1 >= p.length {
        return token_new(TOK_EOF, 0, 0)
    }
    return vectok_get(p.tokens, p.pos + 1)
}

/// Advance to next token
task parser_advance(p: Parser) -> Parser {
    check p.pos < p.length {
        p.pos = p.pos + 1
    }
    return p
}

/// Check if current token is of given kind
task parser_check(p: Parser, kind: int) -> bool {
    check parser_at_end(p) { return false }
    set tok = parser_current(p)
    return tok.kind == kind
}

/// Check current token and advance if match
task parser_match(p: Parser, kind: int) -> bool {
    check parser_check(p, kind) {
        p = parser_advance(p)
        return true
    }
    return false
}

/// Expect a token of given kind, error if not found
task parser_expect(p: Parser, kind: int, msg: string) -> Parser {
    check parser_check(p, kind) {
        return parser_advance(p)
    }
    
    set tok = parser_current(p)
    set err = sb_new()
    err = sb_append(err, p.filename)
    err = sb_append(err, ":")
    err = sb_append_int(err, tok.line)
    err = sb_append(err, ":")
    err = sb_append_int(err, tok.col)
    err = sb_append(err, ": expected ")
    err = sb_append(err, msg)
    err = sb_append(err, ", got ")
    err = sb_append(err, token_kind_name(tok.kind))
    
    p.errors = vecstr_push(p.errors, sb_to_string(err))
    return p
}

/// Skip newlines
task parser_skip_newlines(p: Parser) -> Parser {
    loop parser_check(p, TOK_NEWLINE) {
        p = parser_advance(p)
    }
    return p
}

/// Report an error
task parser_error(p: Parser, msg: string) -> Parser {
    set tok = parser_current(p)
    set err = sb_new()
    err = sb_append(err, p.filename)
    err = sb_append(err, ":")
    err = sb_append_int(err, tok.line)
    err = sb_append(err, ":")
    err = sb_append_int(err, tok.col)
    err = sb_append(err, ": ")
    err = sb_append(err, msg)
    
    p.errors = vecstr_push(p.errors, sb_to_string(err))
    return p
}

// ============================================================================
// EXPRESSION PARSING (Pratt Parser / Precedence Climbing)
// ============================================================================

/// Get precedence of binary operator
task op_precedence(kind: int) -> int {
    check kind == TOK_OR { return 1 }
    check kind == TOK_AND { return 2 }
    check kind == TOK_PIPE { return 3 }
    check kind == TOK_CARET { return 4 }
    check kind == TOK_AMPERSAND { return 5 }
    check kind == TOK_EQUAL or kind == TOK_NOT_EQUAL { return 6 }
    check kind == TOK_LESS or kind == TOK_LESS_EQUAL or kind == TOK_GREATER or kind == TOK_GREATER_EQUAL { return 7 }
    check kind == TOK_LSHIFT or kind == TOK_RSHIFT { return 8 }
    check kind == TOK_PLUS or kind == TOK_MINUS { return 9 }
    check kind == TOK_STAR or kind == TOK_SLASH or kind == TOK_PERCENT { return 10 }
    return 0
}

/// Convert token kind to binary operator
task token_to_binop(kind: int) -> int {
    check kind == TOK_PLUS { return OP_ADD }
    check kind == TOK_MINUS { return OP_SUB }
    check kind == TOK_STAR { return OP_MUL }
    check kind == TOK_SLASH { return OP_DIV }
    check kind == TOK_PERCENT { return OP_MOD }
    check kind == TOK_AND { return OP_AND }
    check kind == TOK_OR { return OP_OR }
    check kind == TOK_AMPERSAND { return OP_BIT_AND }
    check kind == TOK_PIPE { return OP_BIT_OR }
    check kind == TOK_CARET { return OP_BIT_XOR }
    check kind == TOK_LSHIFT { return OP_LSHIFT }
    check kind == TOK_RSHIFT { return OP_RSHIFT }
    check kind == TOK_EQUAL { return OP_EQ }
    check kind == TOK_NOT_EQUAL { return OP_NE }
    check kind == TOK_LESS { return OP_LT }
    check kind == TOK_LESS_EQUAL { return OP_LE }
    check kind == TOK_GREATER { return OP_GT }
    check kind == TOK_GREATER_EQUAL { return OP_GE }
    return 0
}

/// Parse a primary expression (literals, identifiers, parenthesized)
task parse_primary(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    // Integer literal
    check tok.kind == TOK_INTEGER {
        p = parser_advance(p)
        return expr_int(tok.int_val, line, col)
    }
    
    // Float literal
    check tok.kind == TOK_FLOAT {
        p = parser_advance(p)
        return expr_float(tok.float_val, line, col)
    }
    
    // String literal
    check tok.kind == TOK_STRING {
        p = parser_advance(p)
        return expr_string(tok.str_val, line, col)
    }
    
    // Boolean literals
    check tok.kind == TOK_TRUE {
        p = parser_advance(p)
        return expr_bool(true, line, col)
    }
    check tok.kind == TOK_FALSE {
        p = parser_advance(p)
        return expr_bool(false, line, col)
    }
    
    // Null
    check tok.kind == TOK_NULL {
        p = parser_advance(p)
        return expr_null(line, col)
    }
    
    // Parenthesized expression
    check tok.kind == TOK_LPAREN {
        p = parser_advance(p)
        set inner = parse_expression(p)
        p = parser_expect(p, TOK_RPAREN, "')'")
        return inner
    }
    
    // Unary operators
    check tok.kind == TOK_MINUS {
        p = parser_advance(p)
        set operand = parse_unary(p)
        return expr_unary(UNOP_NEG, operand, line, col)
    }
    check tok.kind == TOK_NOT {
        p = parser_advance(p)
        set operand = parse_unary(p)
        return expr_unary(UNOP_NOT, operand, line, col)
    }
    check tok.kind == TOK_TILDE {
        p = parser_advance(p)
        set operand = parse_unary(p)
        return expr_unary(UNOP_BITNOT, operand, line, col)
    }
    
    // Identifier (variable reference or function call)
    check tok.kind == TOK_IDENTIFIER {
        set name = tok.str_val
        p = parser_advance(p)
        
        // Check for function call
        check parser_check(p, TOK_LPAREN) {
            p = parser_advance(p)
            set args = parse_arg_list(p)
            p = parser_expect(p, TOK_RPAREN, "')'")
            return expr_call(name, args, line, col)
        }
        
        return expr_var(name, line, col)
    }
    
    // Alloc expression
    check tok.kind == TOK_ALLOC {
        p = parser_advance(p)
        p = parser_expect(p, TOK_LPAREN, "'('")
        set count = parse_expression(p)
        p = parser_expect(p, TOK_COMMA, "','")
        set size = parse_expression(p)
        p = parser_expect(p, TOK_RPAREN, "')'")
        
        // Create alloc as a call for simplicity
        set args = vecexpr_new()
        args = vecexpr_push(args, count)
        args = vecexpr_push(args, size)
        return expr_call("alloc", args, line, col)
    }
    
    // Unknown - error
    p = parser_error(p, "expected expression")
    p = parser_advance(p)
    return expr_null(line, col)
}

/// Parse unary expression
task parse_unary(p: Parser) -> ptr {
    set tok = parser_current(p)
    
    check tok.kind == TOK_MINUS or tok.kind == TOK_NOT or tok.kind == TOK_TILDE {
        return parse_primary(p)
    }
    
    return parse_primary(p)
}

/// Parse postfix expressions (calls, field access, indexing)
task parse_postfix(p: Parser) -> ptr {
    set expr = parse_primary(p)
    
    loop {
        set tok = parser_current(p)
        
        // Field access: expr.field
        check tok.kind == TOK_DOT {
            p = parser_advance(p)
            set field_tok = parser_current(p)
            check field_tok.kind != TOK_IDENTIFIER {
                p = parser_error(p, "expected field name after '.'")
                break
            }
            set field_name = field_tok.str_val
            p = parser_advance(p)
            
            // Check for method call: expr.method(args)
            check parser_check(p, TOK_LPAREN) {
                p = parser_advance(p)
                set args = parse_arg_list(p)
                p = parser_expect(p, TOK_RPAREN, "')'")
                
                // Desugar to method_call(expr, args)
                set all_args = vecexpr_new()
                all_args = vecexpr_push(all_args, expr)
                set nargs = vecexpr_len(args)
                loop i from 0 to nargs - 1 {
                    all_args = vecexpr_push(all_args, vecexpr_get(args, i))
                }
                expr = expr_call(field_name, all_args, field_tok.line, field_tok.col)
            } else {
                expr = expr_field(expr, field_name, field_tok.line, field_tok.col)
            }
            continue
        }
        
        // Index: expr[index]
        check tok.kind == TOK_LBRACKET {
            p = parser_advance(p)
            set index = parse_expression(p)
            p = parser_expect(p, TOK_RBRACKET, "']'")
            expr = expr_index(expr, index, tok.line, tok.col)
            continue
        }
        
        // Function call (for identifiers that weren't caught in primary)
        check tok.kind == TOK_LPAREN {
            // This shouldn't happen if parse_primary handles calls
            break
        }
        
        break
    }
    
    return expr
}

/// Parse binary expression with precedence climbing
task parse_binary(p: Parser, min_prec: int) -> ptr {
    set left = parse_postfix(p)
    
    loop {
        set tok = parser_current(p)
        set prec = op_precedence(tok.kind)
        
        check prec < min_prec or prec == 0 { break }
        
        set op = token_to_binop(tok.kind)
        p = parser_advance(p)
        
        set right = parse_binary(p, prec + 1)
        left = expr_binary(op, left, right, tok.line, tok.col)
    }
    
    return left
}

/// Parse an expression
task parse_expression(p: Parser) -> ptr {
    return parse_binary(p, 1)
}

/// Parse argument list (for function calls)
task parse_arg_list(p: Parser) -> ptr {
    set args = vecexpr_new()
    
    // Empty argument list
    check parser_check(p, TOK_RPAREN) {
        return args
    }
    
    // First argument
    set first = parse_expression(p)
    args = vecexpr_push(args, first)
    
    // Rest of arguments
    loop parser_check(p, TOK_COMMA) {
        p = parser_advance(p)
        set arg = parse_expression(p)
        args = vecexpr_push(args, arg)
    }
    
    return args
}

// ============================================================================
// TYPE PARSING
// ============================================================================

/// Parse a type annotation
task parse_type(p: Parser) -> ptr {
    set tok = parser_current(p)
    
    // Basic types
    check tok.kind == TOK_IDENTIFIER {
        set name = tok.str_val
        p = parser_advance(p)
        
        check str_eq(name, "int") { return type_new(TYPE_INT) }
        check str_eq(name, "float") { return type_new(TYPE_FLOAT) }
        check str_eq(name, "bool") { return type_new(TYPE_BOOL) }
        check str_eq(name, "string") { return type_new(TYPE_STRING) }
        check str_eq(name, "void") { return type_new(TYPE_VOID) }
        check str_eq(name, "ptr") { return type_new(TYPE_PTR) }
        
        // User-defined type (struct, enum, generic)
        set t = alloc(1, 32)
        override {
            ptr_set_int(t, 0, TYPE_STRUCT)
            ptr_set_int(t, 1, name)
        }
        return t
    }
    
    // Type keywords
    check tok.kind == TOK_INT8 { p = parser_advance(p); return type_new(TYPE_INT8) }
    check tok.kind == TOK_INT16 { p = parser_advance(p); return type_new(TYPE_INT16) }
    check tok.kind == TOK_INT64 { p = parser_advance(p); return type_new(TYPE_INT64) }
    check tok.kind == TOK_UINT8 { p = parser_advance(p); return type_new(TYPE_UINT8) }
    check tok.kind == TOK_UINT16 { p = parser_advance(p); return type_new(TYPE_UINT16) }
    check tok.kind == TOK_UINT32 { p = parser_advance(p); return type_new(TYPE_UINT32) }
    check tok.kind == TOK_UINT64 { p = parser_advance(p); return type_new(TYPE_UINT64) }
    
    p = parser_error(p, "expected type")
    return type_new(TYPE_VOID)
}

// ============================================================================
// STATEMENT PARSING
// ============================================================================

/// Parse a block of statements { ... }
task parse_block(p: Parser) -> ptr {
    set stmts = vecstmt_new()
    
    p = parser_expect(p, TOK_LBRACE, "'{'")
    p = parser_skip_newlines(p)
    
    loop not parser_check(p, TOK_RBRACE) and not parser_at_end(p) {
        set stmt = parse_statement(p)
        stmts = vecstmt_push(stmts, stmt)
        p = parser_skip_newlines(p)
    }
    
    p = parser_expect(p, TOK_RBRACE, "'}'")
    
    return stmts
}

/// Parse a variable declaration: set name [: type] = expr
task parse_var_decl(p: Parser, is_sensitive: bool) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'set'
    
    // Variable name
    set name_tok = parser_current(p)
    check name_tok.kind != TOK_IDENTIFIER {
        p = parser_error(p, "expected variable name")
        return stmt_expr(expr_null(line, col), line, col)
    }
    set name = name_tok.str_val
    p = parser_advance(p)
    
    // Optional type annotation
    set type_info = null
    check parser_check(p, TOK_COLON) {
        p = parser_advance(p)
        type_info = parse_type(p)
    }
    
    // Initializer
    p = parser_expect(p, TOK_ASSIGN, "'='")
    set init = parse_expression(p)
    
    return stmt_var_decl(name, type_info, init, is_sensitive, line, col)
}

/// Parse a const declaration: const NAME = expr
task parse_const_decl(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'const'
    
    set name_tok = parser_current(p)
    check name_tok.kind != TOK_IDENTIFIER {
        p = parser_error(p, "expected constant name")
        return stmt_expr(expr_null(line, col), line, col)
    }
    set name = name_tok.str_val
    p = parser_advance(p)
    
    p = parser_expect(p, TOK_ASSIGN, "'='")
    set init = parse_expression(p)
    
    return stmt_const_decl(name, init, line, col)
}

/// Parse a task declaration: task name(params) [-> return_type] { body }
task parse_task_decl(p: Parser, is_inline: bool, is_async: bool, is_extern: bool) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'task'
    
    // Function name
    set name_tok = parser_current(p)
    check name_tok.kind != TOK_IDENTIFIER {
        p = parser_error(p, "expected function name")
        return stmt_expr(expr_null(line, col), line, col)
    }
    set name = name_tok.str_val
    p = parser_advance(p)
    
    // Parameters
    p = parser_expect(p, TOK_LPAREN, "'('")
    set params = parse_param_list(p)
    p = parser_expect(p, TOK_RPAREN, "')'")
    
    // Return type
    set return_type = type_new(TYPE_VOID)
    check parser_check(p, TOK_ARROW) {
        p = parser_advance(p)
        return_type = parse_type(p)
    }
    
    // Body (or none for extern)
    set body = null
    check not is_extern {
        p = parser_skip_newlines(p)
        body = parse_block(p)
    }
    
    // Build task declaration statement
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_TASK_DECL)
        ptr_set_int(s, 1, name)
        ptr_set_int(s, 4, body)
        ptr_set_int(s, 6, params)
        ptr_set_int(s, 7, return_type)
        ptr_set_int(s, 9, is_inline)
        ptr_set_int(s, 10, is_async)
        ptr_set_int(s, 11, is_extern)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Parse parameter list: (name: type, name: type, ...)
task parse_param_list(p: Parser) -> ptr {
    set params = vecparam_new()
    
    check parser_check(p, TOK_RPAREN) {
        return params
    }
    
    // First parameter
    set name_tok = parser_current(p)
    check name_tok.kind != TOK_IDENTIFIER {
        p = parser_error(p, "expected parameter name")
        return params
    }
    set name = name_tok.str_val
    p = parser_advance(p)
    
    // Type annotation (optional in some contexts, but usually required)
    set type_info = type_new(TYPE_INT)  // default
    check parser_check(p, TOK_COLON) {
        p = parser_advance(p)
        type_info = parse_type(p)
    }
    
    params = vecparam_push(params, name, type_info)
    
    // Rest of parameters
    loop parser_check(p, TOK_COMMA) {
        p = parser_advance(p)
        
        set pname_tok = parser_current(p)
        check pname_tok.kind != TOK_IDENTIFIER {
            p = parser_error(p, "expected parameter name")
            break
        }
        set pname = pname_tok.str_val
        p = parser_advance(p)
        
        set ptype = type_new(TYPE_INT)
        check parser_check(p, TOK_COLON) {
            p = parser_advance(p)
            ptype = parse_type(p)
        }
        
        params = vecparam_push(params, pname, ptype)
    }
    
    return params
}

/// Parse a check (if) statement
task parse_check(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'check'
    
    // Condition
    set cond = parse_expression(p)
    
    // Then block
    p = parser_skip_newlines(p)
    set then_block = parse_block(p)
    
    // Optional else block
    set else_block = null
    p = parser_skip_newlines(p)
    check parser_check(p, TOK_ELSE) {
        p = parser_advance(p)
        p = parser_skip_newlines(p)
        
        // else check (elif)
        check parser_check(p, TOK_CHECK) {
            set elif_stmt = parse_check(p)
            set elif_block = vecstmt_new()
            elif_block = vecstmt_push(elif_block, elif_stmt)
            else_block = elif_block
        } else {
            else_block = parse_block(p)
        }
    }
    
    return stmt_if(cond, then_block, else_block, line, col)
}

/// Parse a loop statement (multiple forms)
task parse_loop(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'loop'
    
    // Check for loop forms:
    // 1. loop { } - infinite loop
    // 2. loop N times { }
    // 3. loop i from A to B { }
    // 4. loop condition { }
    
    p = parser_skip_newlines(p)
    
    // Infinite loop
    check parser_check(p, TOK_LBRACE) {
        set body = parse_block(p)
        return stmt_loop_cond(expr_bool(true, line, col), body, line, col)
    }
    
    // Get first expression or identifier
    set first_tok = parser_current(p)
    
    // Check for: loop i from ...
    check first_tok.kind == TOK_IDENTIFIER {
        set var_name = first_tok.str_val
        set next_tok = parser_peek(p)
        
        check next_tok.kind == TOK_FROM {
            p = parser_advance(p)  // skip var name
            p = parser_advance(p)  // skip 'from'
            
            set start_expr = parse_expression(p)
            p = parser_expect(p, TOK_TO, "'to'")
            set end_expr = parse_expression(p)
            
            p = parser_skip_newlines(p)
            set body = parse_block(p)
            
            return stmt_loop_range(var_name, start_expr, end_expr, body, line, col)
        }
    }
    
    // Parse as expression
    set first_expr = parse_expression(p)
    
    // Check for: loop N times { }
    check parser_check(p, TOK_TIMES) {
        p = parser_advance(p)
        p = parser_skip_newlines(p)
        set body = parse_block(p)
        return stmt_loop_times(first_expr, body, line, col)
    }
    
    // Otherwise: loop condition { }
    p = parser_skip_newlines(p)
    set body = parse_block(p)
    return stmt_loop_cond(first_expr, body, line, col)
}

/// Parse a return statement
task parse_return(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'return'
    
    // Check for value
    set expr = null
    check not parser_check(p, TOK_NEWLINE) and not parser_check(p, TOK_RBRACE) {
        expr = parse_expression(p)
    }
    
    return stmt_return(expr, line, col)
}

/// Parse a print statement
task parse_print(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'print'
    set expr = parse_expression(p)
    
    return stmt_print(expr, line, col)
}

/// Parse a struct declaration
task parse_struct_decl(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'struct'
    
    // Name
    set name_tok = parser_current(p)
    check name_tok.kind != TOK_IDENTIFIER {
        p = parser_error(p, "expected struct name")
        return stmt_expr(expr_null(line, col), line, col)
    }
    set name = name_tok.str_val
    p = parser_advance(p)
    
    // Fields
    p = parser_skip_newlines(p)
    p = parser_expect(p, TOK_LBRACE, "'{'")
    p = parser_skip_newlines(p)
    
    set fields = vecparam_new()
    
    loop not parser_check(p, TOK_RBRACE) and not parser_at_end(p) {
        set field_tok = parser_current(p)
        check field_tok.kind != TOK_IDENTIFIER {
            p = parser_error(p, "expected field name")
            break
        }
        set field_name = field_tok.str_val
        p = parser_advance(p)
        
        p = parser_expect(p, TOK_COLON, "':'")
        set field_type = parse_type(p)
        
        fields = vecparam_push(fields, field_name, field_type)
        p = parser_skip_newlines(p)
    }
    
    p = parser_expect(p, TOK_RBRACE, "'}'")
    
    // Build struct decl statement
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_STRUCT_DECL)
        ptr_set_int(s, 1, name)
        ptr_set_int(s, 6, fields)  // use params slot for fields
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Parse an import statement
task parse_import(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    p = parser_advance(p)  // skip 'import'
    
    set path_tok = parser_current(p)
    check path_tok.kind != TOK_STRING {
        p = parser_error(p, "expected import path string")
        return stmt_expr(expr_null(line, col), line, col)
    }
    set path = path_tok.str_val
    p = parser_advance(p)
    
    // Build import statement
    set s = alloc(1, 160)
    override {
        ptr_set_int(s, 0, STMT_IMPORT)
        ptr_set_int(s, 1, path)
        ptr_set_int(s, 12, line)
        ptr_set_int(s, 13, col)
    }
    return s
}

/// Parse a single statement
task parse_statement(p: Parser) -> ptr {
    p = parser_skip_newlines(p)
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    // Variable declaration
    check tok.kind == TOK_SET {
        return parse_var_decl(p, false)
    }
    
    // Sensitive variable
    check tok.kind == TOK_SENSITIVE {
        p = parser_advance(p)
        check parser_check(p, TOK_SET) {
            return parse_var_decl(p, true)
        }
        p = parser_error(p, "expected 'set' after 'sensitive'")
        return stmt_expr(expr_null(line, col), line, col)
    }
    
    // Const declaration
    check tok.kind == TOK_CONST {
        return parse_const_decl(p)
    }
    
    // Task declaration
    check tok.kind == TOK_TASK or tok.kind == TOK_FN {
        return parse_task_decl(p, false, false, false)
    }
    
    // Inline task
    check tok.kind == TOK_INLINE {
        p = parser_advance(p)
        check parser_check(p, TOK_TASK) or parser_check(p, TOK_FN) {
            return parse_task_decl(p, true, false, false)
        }
        p = parser_error(p, "expected 'task' after 'inline'")
        return stmt_expr(expr_null(line, col), line, col)
    }
    
    // Async task
    check tok.kind == TOK_ASYNC {
        p = parser_advance(p)
        check parser_check(p, TOK_TASK) or parser_check(p, TOK_FN) {
            return parse_task_decl(p, false, true, false)
        }
        p = parser_error(p, "expected 'task' after 'async'")
        return stmt_expr(expr_null(line, col), line, col)
    }
    
    // Extern declaration
    check tok.kind == TOK_EXTERN {
        p = parser_advance(p)
        check parser_check(p, TOK_TASK) or parser_check(p, TOK_FN) {
            return parse_task_decl(p, false, false, true)
        }
        p = parser_error(p, "expected 'task' after 'extern'")
        return stmt_expr(expr_null(line, col), line, col)
    }
    
    // Struct declaration
    check tok.kind == TOK_STRUCT {
        return parse_struct_decl(p)
    }
    
    // Import
    check tok.kind == TOK_IMPORT {
        return parse_import(p)
    }
    
    // Check (if)
    check tok.kind == TOK_CHECK {
        return parse_check(p)
    }
    
    // Loop
    check tok.kind == TOK_LOOP {
        return parse_loop(p)
    }
    
    // Return
    check tok.kind == TOK_RETURN {
        return parse_return(p)
    }
    
    // Break
    check tok.kind == TOK_BREAK {
        p = parser_advance(p)
        return stmt_break(line, col)
    }
    
    // Continue
    check tok.kind == TOK_CONTINUE {
        p = parser_advance(p)
        return stmt_continue(line, col)
    }
    
    // Print
    check tok.kind == TOK_PRINT {
        return parse_print(p)
    }
    
    // Override block
    check tok.kind == TOK_OVERRIDE {
        p = parser_advance(p)
        p = parser_skip_newlines(p)
        set body = parse_block(p)
        
        set s = alloc(1, 160)
        override {
            ptr_set_int(s, 0, STMT_OVERRIDE)
            ptr_set_int(s, 4, body)
            ptr_set_int(s, 12, line)
            ptr_set_int(s, 13, col)
        }
        return s
    }
    
    // Constant_time block
    check tok.kind == TOK_CONSTANT_TIME {
        p = parser_advance(p)
        p = parser_skip_newlines(p)
        set body = parse_block(p)
        
        set s = alloc(1, 160)
        override {
            ptr_set_int(s, 0, STMT_CONSTANT_TIME)
            ptr_set_int(s, 4, body)
            ptr_set_int(s, 12, line)
            ptr_set_int(s, 13, col)
        }
        return s
    }
    
    // Free statement
    check tok.kind == TOK_FREE {
        p = parser_advance(p)
        set expr = parse_expression(p)
        
        set s = alloc(1, 160)
        override {
            ptr_set_int(s, 0, STMT_FREE)
            ptr_set_int(s, 2, expr)
            ptr_set_int(s, 12, line)
            ptr_set_int(s, 13, col)
        }
        return s
    }
    
    // Expression statement (including assignment)
    set expr = parse_expression(p)
    
    // Check for assignment
    check parser_check(p, TOK_ASSIGN) {
        p = parser_advance(p)
        set value = parse_expression(p)
        return stmt_assign(expr, value, line, col)
    }
    
    // Compound assignment
    check parser_check(p, TOK_PLUS_ASSIGN) or parser_check(p, TOK_MINUS_ASSIGN) or parser_check(p, TOK_STAR_ASSIGN) or parser_check(p, TOK_SLASH_ASSIGN) {
        set op_tok = parser_current(p)
        p = parser_advance(p)
        set rhs = parse_expression(p)
        
        // Desugar: x += y  ->  x = x + y
        set binop = OP_ADD
        check op_tok.kind == TOK_MINUS_ASSIGN { binop = OP_SUB }
        check op_tok.kind == TOK_STAR_ASSIGN { binop = OP_MUL }
        check op_tok.kind == TOK_SLASH_ASSIGN { binop = OP_DIV }
        
        set value = expr_binary(binop, expr, rhs, line, col)
        return stmt_assign(expr, value, line, col)
    }
    
    return stmt_expr(expr, line, col)
}

// ============================================================================
// MAIN PARSE FUNCTION
// ============================================================================

/// Parse the entire program
task parser_parse(p: Parser) -> Program {
    set prog = program_new(p.filename)
    
    loop not parser_at_end(p) {
        p = parser_skip_newlines(p)
        check parser_at_end(p) { break }
        
        set stmt = parse_statement(p)
        prog = program_add_stmt(prog, stmt)
    }
    
    // Print any errors
    set nerrors = vecstr_len(p.errors)
    check nerrors > 0 {
        loop i from 0 to nerrors - 1 {
            eprintln(vecstr_get(p.errors, i))
        }
    }
    
    return prog
}

/// Parse a file
task parse_file(path: string) -> Program {
    set tokens = tokenize_file(path)
    set parser = parser_new(tokens, path)
    return parser_parse(parser)
}

// ============================================================================
// DEBUG UTILITIES
// ============================================================================

/// Print the AST for debugging
task print_program(prog: Program) {
    println("=== Program AST ===")
    set n = program_stmt_count(prog)
    loop i from 0 to n - 1 {
        set stmt = program_get_stmt(prog, i)
        print_stmt(stmt, 0)
    }
}

/// Print a statement with indentation
task print_stmt(s: ptr, indent: int) {
    set prefix = str_repeat("  ", indent)
    set kind = stmt_kind(s)
    
    check kind == STMT_VAR_DECL {
        print_str(prefix)
        print_str("VarDecl: ")
        println(stmt_get_name(s))
    }
    check kind == STMT_CONST_DECL {
        print_str(prefix)
        print_str("ConstDecl: ")
        println(stmt_get_name(s))
    }
    check kind == STMT_TASK_DECL {
        print_str(prefix)
        print_str("TaskDecl: ")
        println(stmt_get_name(s))
    }
    check kind == STMT_STRUCT_DECL {
        print_str(prefix)
        print_str("StructDecl: ")
        println(stmt_get_name(s))
    }
    check kind == STMT_RETURN {
        print_str(prefix)
        println("Return")
    }
    check kind == STMT_EXPR {
        print_str(prefix)
        println("ExprStmt")
    }
    check kind == STMT_IF {
        print_str(prefix)
        println("If")
    }
    check kind == STMT_LOOP_TIMES or kind == STMT_LOOP_RANGE or kind == STMT_LOOP_COND {
        print_str(prefix)
        println("Loop")
    }
    check kind == STMT_PRINT {
        print_str(prefix)
        println("Print")
    }
    
    free prefix
}
