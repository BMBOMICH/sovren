struct Parser {
    tokens:   VecToken
    pos:      int
    length:   int
    filename: string
    errors:   VecStr
}

task parser_new(tokens: VecToken, filename: string) -> Parser {
    return Parser {
        tokens:   tokens,
        pos:      0,
        length:   vectok_len(tokens),
        filename: filename,
        errors:   vecstr_new()
    }
}

task parser_at_end(p: Parser) -> bool {
    return p.pos >= p.length
}

task parser_current(p: Parser) -> Token {
    check p.pos >= p.length { return token_new(TOK_EOF, 0, 0) }
    return vectok_get(p.tokens, p.pos)
}

task parser_peek(p: Parser) -> Token {
    check p.pos + 1 >= p.length { return token_new(TOK_EOF, 0, 0) }
    return vectok_get(p.tokens, p.pos + 1)
}

task parser_advance(p: Parser) -> Parser {
    check p.pos < p.length { p.pos = p.pos + 1 }
    return p
}

task parser_check(p: Parser, kind: int) -> bool {
    check parser_at_end(p) { return false }
    set tok = parser_current(p)
    return tok.kind == kind
}

task parser_match(p: Parser, kind: int) -> bool {
    check parser_check(p, kind) { p = parser_advance(p); return true }
    return false
}

task parser_expect(p: Parser, kind: int, msg: string) -> Parser {
    check parser_check(p, kind) { return parser_advance(p) }
    set tok = parser_current(p)
    set err = sb_new()
    err = sb_append(err, p.filename)
    err = sb_append(err, ":")
    err = sb_append_int(err, tok.line)
    err = sb_append(err, ":")
    err = sb_append_int(err, tok.col)
    err = sb_append(err, ": expected ")
    err = sb_append(err, msg)
    err = sb_append(err, ", got ")
    err = sb_append(err, token_kind_name(tok.kind))
    p.errors = vecstr_push(p.errors, sb_to_string(err))
    return p
}

task parser_skip_newlines(p: Parser) -> Parser {
    loop parser_check(p, TOK_NEWLINE) { p = parser_advance(p) }
    return p
}

task parser_error(p: Parser, msg: string) -> Parser {
    set tok = parser_current(p)
    set err = sb_new()
    err = sb_append(err, p.filename)
    err = sb_append(err, ":")
    err = sb_append_int(err, tok.line)
    err = sb_append(err, ":")
    err = sb_append_int(err, tok.col)
    err = sb_append(err, ": ")
    err = sb_append(err, msg)
    p.errors = vecstr_push(p.errors, sb_to_string(err))
    return p
}

task op_precedence(kind: int) -> int {
    check kind == TOK_OR { return 1 }
    check kind == TOK_AND { return 2 }
    check kind == TOK_PIPE { return 3 }
    check kind == TOK_CARET { return 4 }
    check kind == TOK_AMPERSAND { return 5 }
    check kind == TOK_EQUAL or kind == TOK_NOT_EQUAL { return 6 }
    check kind == TOK_LESS or kind == TOK_LESS_EQUAL or kind == TOK_GREATER or kind == TOK_GREATER_EQUAL { return 7 }
    check kind == TOK_LSHIFT or kind == TOK_RSHIFT { return 8 }
    check kind == TOK_PLUS or kind == TOK_MINUS { return 9 }
    check kind == TOK_STAR or kind == TOK_SLASH or kind == TOK_PERCENT { return 10 }
    return 0
}

task token_to_binop(kind: int) -> int {
    check kind == TOK_PLUS { return OP_ADD }
    check kind == TOK_MINUS { return OP_SUB }
    check kind == TOK_STAR { return OP_MUL }
    check kind == TOK_SLASH { return OP_DIV }
    check kind == TOK_PERCENT { return OP_MOD }
    check kind == TOK_AND { return OP_AND }
    check kind == TOK_OR { return OP_OR }
    check kind == TOK_AMPERSAND { return OP_BIT_AND }
    check kind == TOK_PIPE { return OP_BIT_OR }
    check kind == TOK_CARET { return OP_BIT_XOR }
    check kind == TOK_LSHIFT { return OP_LSHIFT }
    check kind == TOK_RSHIFT { return OP_RSHIFT }
    check kind == TOK_EQUAL { return OP_EQ }
    check kind == TOK_NOT_EQUAL { return OP_NE }
    check kind == TOK_LESS { return OP_LT }
    check kind == TOK_LESS_EQUAL { return OP_LE }
    check kind == TOK_GREATER { return OP_GT }
    check kind == TOK_GREATER_EQUAL { return OP_GE }
    return 0
}

task parse_primary(p: Parser) -> ptr {
    set tok = parser_current(p)
    set line = tok.line
    set col = tok.col
    
    check tok.kind == TOK_INTEGER {
        p = parser_advance(p)
        return expr_int(tok.int_val, line, col)
    }
    
    check tok.kind == TOK_FLOAT {
        p = parser_advance(p)
        return expr_float(tok.float_val, line, col)
    }
    
    check tok.kind == TOK_STRING {
        p = parser_advance(p)
        return expr_string(tok.str_val, line, col)
    }
    
    check tok.kind == TOK_TRUE {
        p = parser_advance(p)
        return expr_bool(true, line, col)
    }
    check tok.kind == TOK_FALSE {
        p = parser_advance(p)
        return expr_bool(false, line, col)
    }
    
    check tok.kind == TOK_NULL {
        p = parser_advance(p)
        return expr_null(line, col)
    }
    
    check tok.kind == TOK_LPAREN {
        p = parser_advance(p)
        set inner = parse_expression(p)
        p = parser_expect(p, TOK_RPAREN, "')'")
        return inner
    }
    
    check tok.kind == TOK_MINUS {
        p = parser_advance(p)
        set operand = parse_unary(p)
        return expr_unary(UNOP_NEG, operand, line, col)
    }
    check tok.kind == TOK_NOT {
        p = parser_advance(p)
        set operand = parse_unary(p)
        return expr_unary(UNOP_NOT, operand, line, col)
    }
    check tok.kind == TOK_TILDE {
        p = parser_advance(p)
        set operand = parse_unary(p)
        return expr_unary(UNOP_BITNOT, operand, line, col)
    }
    
    check tok.kind == TOK_IDENTIFIER {
        set name = tok.str_val
        p = parser_advance(p)
        check parser_check(p, TOK_LPAREN) {
            p = parser_advance(p)
            set args = parse_arg_list(p)
            p = parser_expect(p, TOK_RPAREN, "')'")
            return expr_call(name, args, line, col)
        }
        return expr_var(name, line, col)
    }
    
    check tok.kind == TOK_ALLOC {
        p = parser_advance(p)
        p = parser_expect(p, TOK_LPAREN, "'('")
        set count = parse_expression(p)
        p = parser_expect(p, TOK_COMMA, "','")
        set size = parse_expression(p)
        p = parser_expect(p, TOK_RPAREN, "')'")
        set args = vecexpr_new()
        args = vecexpr_push(args, count)
        args = vecexpr_push(args, size)
        return expr_call("alloc", args, line, col)
    }
    
    p = parser_error(p, "expected expression")
    p = parser_advance(p)
    return expr_null(line, col)
}

task parse_unary(p: Parser) -> ptr {
    set tok = parser_current(p)
    check tok.kind == TOK_MINUS or tok.kind == TOK_NOT or tok.kind == TOK_TILDE {
        return parse_primary(p)
    }
    return parse_primary(p)
}

task parse_postfix(p: Parser) -> ptr {
    set expr = parse_primary(p)
    
    loop {
        set tok = parser_current(p)
        
        check tok.kind == TOK_DOT {
            p = parser_advance(p)
            set field_tok = parser_current(p)
            check field_tok.kind != TOK_IDENTIFIER {
                p = parser_error(p, "expected field name after '.'")
                break
            }
            set field_name = field_tok.str_val
            p = parser_advance(p)
            check parser_check(p, TOK_LPAREN) {
                p = parser_advance(p)
                set args = parse_arg_list(p)
                p = parser_expect(p, TOK_RPAREN, "')'")
                set all_args = vecexpr_new()
                all_args = vecexpr_push(all_args, expr)
                set nargs = vecexpr_len(args)
                loop i from 0 to nargs - 1 {
                    all_args = vecexpr_push(all_args, vecexpr_get(args, i))
                }
                expr = expr_call(field_name, all_args, field_tok.line, field_tok.col)
            } else {
                expr = expr_field(expr, field_name, field_tok.line, field_tok.col)
            }
            continue
        }
        
        check tok.kind == TOK_LBRACKET {
            p = parser_advance(p)
            set index = parse_expression(p)
            p = parser_expect(p, TOK_RBRACKET, "']'")
            expr = expr_index(expr, index, tok.line, tok.col)
            continue
        }
        
        check tok.kind == TOK_LPAREN { break }
        break
    }
    
    return expr
}

task parse_binary(p: Parser, min_prec: int) -> ptr {
    set left = parse_postfix(p)
    
    loop {
        set tok = parser_current(p)
        set prec = op_precedence(tok.kind)
        check prec < min_prec or prec == 0 { break }
        set op = token_to_binop(tok.kind)
        p = parser_advance(p)
        set right = parse_binary(p, prec + 1)
        left = expr_binary(op, left, right, tok.line, tok.col)
    }
    
    return left
}

task parse_expression(p: Parser) -> ptr {
    return parse_binary(p, 1)
}

task parse_arg_list(p: Parser) -> ptr {
    set args = vecexpr_new()
    check parser_check(p, TOK_RPAREN) { return args }
    set first = parse_expression(p)
    args = vecexpr_push(args, first)
    loop parser_check(p, TOK_COMMA) {
        p = parser_advance(p)
        set arg = parse_expression(p)
        args = vecexpr_push(args, arg)
    }
    return args
}

task parse_type(p: Parser) -> ptr {
    set tok = parser_current(p)
    
    check tok.kind == TOK_IDENTIFIER {
        set name = tok.str_val
        p = parser_advance(p)
        return type_named(name)
    }
    
    check tok.kind == TOK_INT8 { p = parser_advance(p); return type_int8() }
    check tok.kind == TOK_INT16 { p = parser_advance(p); return type_int16() }
    check tok.kind == TOK_INT64 { p = parser_advance(p); return type_int64() }
    check tok.kind == TOK_UINT8 { p = parser_advance(p); return type_uint8() }
    check tok.kind == TOK_UINT16 { p = parser_advance(p); return type_uint16() }
    check tok.kind == TOK_UINT32 { p = parser_advance(p); return type_uint32() }
    check tok.kind == TOK_UINT64 { p = parser_advance(p); return type_uint64() }
    
    check tok.kind == TOK_AMPERSAND {
        p = parser_advance(p)
        set inner = parse_type(p)
        return type_reference(inner)
    }
    
    check tok.kind == TOK_LBRACKET {
        p = parser_advance(p)
        set inner = parse_type(p)
        p = parser_expect(p, TOK_RBRACKET, "']'")
        return type_array(inner)
    }
    
    p = parser_error(p, "expected type")
    return type_named("void")
}

task parse_params(p: Parser) -> ptr {
    set params = vecparam_new()
    check parser_check(p, TOK_RPAREN) { return params }
    
    loop {
        set name_tok = parser_current(p)
        check name_tok.kind == TOK_IDENTIFIER {
            set name = name_tok.str_val
            p = parser_advance(p)
            p = parser_expect(p, TOK_COLON, "':'")
            set ptype = parse_type(p)
            params = vecparam_push(params, param_new(name, ptype))
        } else { break }
        
        check parser_check(p, TOK_COMMA) { p = parser_advance(p) }
        else { break }
    }
    
    return params
}

task parse_block(p: Parser) -> ptr {
    p = parser_expect(p, TOK_LBRACE, "'{'")
    p = parser_skip_newlines(p)
    
    set stmts = vecstmt_new()
    
    loop not parser_check(p, TOK_RBRACE) and not parser_at_end(p) {
        p = parser_skip_newlines(p)
        check parser_check(p, TOK_RBRACE) { break }
        set stmt = parse_statement(p)
        check stmt != null { stmts = vecstmt_push(stmts, stmt) }
        p = parser_skip_newlines(p)
    }
    
    p = parser_expect(p, TOK_RBRACE, "'}'")
    return block_new(stmts)
}

task parse_statement(p: Parser) -> ptr {
    set tok = parser_current(p)
    
    check tok.kind == TOK_TASK {
        return parse_task_decl(p)
    }
    
    check tok.kind == TOK_EXTERN {
        p = parser_advance(p)
        set task = parse_task_decl(p)
        return stmt_set_extern(task, true)
    }
    
    check tok.kind == TOK_INLINE {
        p = parser_advance(p)
        set task = parse_task_decl(p)
        return stmt_set_inline(task, true)
    }
    
    check tok.kind == TOK_STRUCT {
        return parse_struct_decl(p)
    }
    
    check tok.kind == TOK_ENUM {
        return parse_enum_decl(p)
    }
    
    check tok.kind == TOK_CONST {
        return parse_const_decl(p)
    }
    
    check tok.kind == TOK_SET {
        return parse_var_decl(p)
    }
    
    check tok.kind == TOK_SENSITIVE {
        p = parser_advance(p)
        check parser_check(p, TOK_SET) {
            set var = parse_var_decl(p)
            return stmt_set_sensitive(var, true)
        } else {
            return parse_expression(p)
        }
    }
    
    check tok.kind == TOK_CHECK {
        return parse_if_stmt(p)
    }
    
    check tok.kind == TOK_LOOP {
        return parse_loop_stmt(p)
    }
    
    check tok.kind == TOK_RETURN {
        p = parser_advance(p)
        check parser_check(p, TOK_NEWLINE) or parser_check(p, TOK_RBRACE) {
            return stmt_return(null, tok.line, tok.col)
        }
        set expr = parse_expression(p)
        return stmt_return(expr, tok.line, tok.col)
    }
    
    check tok.kind == TOK_BREAK {
        p = parser_advance(p)
        return stmt_break(tok.line, tok.col)
    }
    
    check tok.kind == TOK_CONTINUE {
        p = parser_advance(p)
        return stmt_continue(tok.line, tok.col)
    }
    
    check tok.kind == TOK_IMPORT {
        p = parser_advance(p)
        set path_tok = parser_current(p)
        check path_tok.kind == TOK_STRING {
            p = parser_advance(p)
            return stmt_import(path_tok.str_val, path_tok.line, path_tok.col)
        }
        p = parser_error(p, "expected import path string")
        return null
    }
    
    check tok.kind == TOK_CONSTANT_TIME {
        p = parser_advance(p)
        set body = parse_block(p)
        return stmt_constant_time(body, tok.line, tok.col)
    }
    
    check tok.kind == TOK_OVERRIDE {
        p = parser_advance(p)
        set body = parse_block(p)
        return stmt_override(body, tok.line, tok.col)
    }
    
    check tok.kind == TOK_PURGE {
        p = parser_advance(p)
        set name_tok = parser_current(p)
        p = parser_expect(p, TOK_IDENTIFIER, "variable name")
        return stmt_purge(name_tok.str_val, name_tok.line, name_tok.col)
    }
    
    check tok.kind == TOK_TEST {
        p = parser_advance(p)
        set task = parse_task_decl(p)
        return stmt_set_test(task, true)
    }
    
    check tok.kind == TOK_NAMESPACE {
        p = parser_advance(p)
        set name_tok = parser_current(p)
        p = parser_expect(p, TOK_IDENTIFIER, "namespace name")
        set body = parse_block(p)
        return stmt_namespace(name_tok.str_val, body, name_tok.line, name_tok.col)
    }
    
    set expr = parse_expression(p)
    check expr != null {
        check parser_check(p, TOK_ASSIGN) {
            p = parser_advance(p)
            set value = parse_expression(p)
            return stmt_assign(expr, value, tok.line, tok.col)
        }
        return stmt_expr(expr, tok.line, tok.col)
    }
    
    p = parser_error(p, "expected statement")
    p = parser_advance(p)
    return null
}

task parse_var_decl(p: Parser) -> ptr {
    set tok = parser_current(p)
    p = parser_expect(p, TOK_SET, "'set'")
    
    set name_tok = parser_current(p)
    p = parser_expect(p, TOK_IDENTIFIER, "variable name")
    set name = name_tok.str_val
    
    set type_annotation = null
    check parser_check(p, TOK_COLON) {
        p = parser_advance(p)
        type_annotation = parse_type(p)
    }
    
    check parser_check(p, TOK_ASSIGN) {
        p = parser_advance(p)
        set init = parse_expression(p)
        return stmt_var_decl(name, type_annotation, init, tok.line, tok.col)
    }
    
    return stmt_var_decl(name, type_annotation, null, tok.line, tok.col)
}

task parse_task_decl(p: Parser) -> ptr {
    set tok = parser_current(p)
    p = parser_expect(p, TOK_TASK, "'task'")
    
    set name_tok = parser_current(p)
    p = parser_expect(p, TOK_IDENTIFIER, "task name")
    set name = name_tok.str_val
    
    p = parser_expect(p, TOK_LPAREN, "'('")
    set params = parse_params(p)
    p = parser_expect(p, TOK_RPAREN, "')'")
    
    set return_type = null
    check parser_check(p, TOK_ARROW) {
        p = parser_advance(p)
        return_type = parse_type(p)
    }
    
    set body = parse_block(p)
    return stmt_task(name, params, return_type, body, tok.line, tok.col)
}

task parse_struct_decl(p: Parser) -> ptr {
    set tok = parser_current(p)
    p = parser_expect(p, TOK_STRUCT, "'struct'")
    
    set name_tok = parser_current(p)
    p = parser_expect(p, TOK_IDENTIFIER, "struct name")
    set name = name_tok.str_val
    
    p = parser_expect(p, TOK_LBRACE, "'{'")
    p = parser_skip_newlines(p)
    
    set fields = vecfield_new()
    loop not parser_check(p, TOK_RBRACE) {
        set field_name_tok = parser_current(p)
        p = parser_expect(p, TOK_IDENTIFIER, "field name")
        p = parser_expect(p, TOK_COLON, "':'")
        set ftype = parse_type(p)
        fields = vecfield_push(fields, field_new(field_name_tok.str_val, ftype))
        p = parser_skip_newlines(p)
        check parser_check(p, TOK_COMMA) { p = parser_advance(p); p = parser_skip_newlines(p) }
    }
    
    p = parser_expect(p, TOK_RBRACE, "'}'")
    return stmt_struct(name, fields, tok.line, tok.col)
}

task parse_enum_decl(p: Parser) -> ptr {
    set tok = parser_current(p)
    p = parser_expect(p, TOK_ENUM, "'enum'")
    
    set name_tok = parser_current(p)
    p = parser_expect(p, TOK_IDENTIFIER, "enum name")
    set name = name_tok.str_val
    
    p = parser_expect(p, TOK_LBRACE, "'{'")
    p = parser_skip_newlines(p)
    
    set variants = vecvariant_new()
    loop not parser_check(p, TOK_RBRACE) {
        set var_name_tok = parser_current(p)
        p = parser_expect(p, TOK_IDENTIFIER, "variant name")
        set var_name = var_name_tok.str_val
        
        set data_type = null
        check parser_check(p, TOK_LPAREN) {
            p = parser_advance(p)
            data_type = parse_type(p)
            p = parser_expect(p, TOK_RPAREN, "')'")
        }
        
        variants = vecvariant_push(variants, variant_new(var_name, data_type))
        p = parser_skip_newlines(p)
        check parser_check(p, TOK_COMMA) { p = parser_advance(p); p = parser_skip_newlines(p) }
    }
    
    p = parser_expect(p, TOK_RBRACE, "'}'")
    return stmt_enum(name, variants, tok.line, tok.col)
}

task parse_const_decl(p: Parser) -> ptr {
    set tok = parser_current(p)
    p = parser_expect(p, TOK_CONST, "'const'")
    
    set name_tok = parser_current(p)
    p = parser_expect(p, TOK_IDENTIFIER, "constant name")
    set name = name_tok.str_val
    
    p = parser_expect(p, TOK_ASSIGN, "'='")
    set value = parse_expression(p)
    return stmt_const(name, value, tok.line, tok.col)
}

task parse_if_stmt(p: Parser) -> ptr {
    set tok = parser_current(p)
    p = parser_expect(p, TOK_CHECK, "'check'")
    set condition = parse_expression(p)
    set then_block = parse_block(p)
    
    check parser_check(p, TOK_ELSE) {
        p = parser_advance(p)
        check parser_check(p, TOK_CHECK) {
            set else_branch = parse_if_stmt(p)
            return stmt_if_else(condition, then_block, else_branch, tok.line, tok.col)
        } else {
            set else_block = parse_block(p)
            return stmt_if_else(condition, then_block, else_block, tok.line, tok.col)
        }
    }
    
    return stmt_if(condition, then_block, tok.line, tok.col)
}

task parse_loop_stmt(p: Parser) -> ptr {
    set tok = parser_current(p)
    p = parser_expect(p, TOK_LOOP, "'loop'")
    
    check parser_check(p, TOK_IDENTIFIER) {
        set var_tok = parser_current(p)
        set var_name = var_tok.str_val
        p = parser_advance(p)
        
        check parser_check(p, TOK_FROM) {
            p = parser_advance(p)
            set start = parse_expression(p)
            p = parser_expect(p, TOK_TO, "'to'")
            set end = parse_expression(p)
            set body = parse_block(p)
            return stmt_loop_range(var_name, start, end, body, tok.line, tok.col)
        }
        
        check parser_check(p, TOK_IN) {
            p = parser_advance(p)
            set iterable = parse_expression(p)
            set body = parse_block(p)
            return stmt_loop_in(var_name, iterable, body, tok.line, tok.col)
        }
    }
    
    check parser_check(p, TOK_TIMES) {
        p = parser_advance(p)
        set count = parse_expression(p)
        set body = parse_block(p)
        return stmt_loop_times(count, body, tok.line, tok.col)
    }
    
    set cond_expr = null
    check not parser_check(p, TOK_LBRACE) {
        set cond_expr = parse_expression(p)
    }
    
    set body = parse_block(p)
    check cond_expr != null {
        return stmt_loop_while(cond_expr, body, tok.line, tok.col)
    }
    
    return stmt_loop_infinite(body, tok.line, tok.col)
}

task parser_parse(p: Parser) -> Program {
    set statements = vecstmt_new()
    
    loop not parser_at_end(p) {
        p = parser_skip_newlines(p)
        check parser_at_end(p) { break }
        
        set stmt = parse_statement(p)
        check stmt != null {
            statements = vecstmt_push(statements, stmt)
        }
        
        p = parser_skip_newlines(p)
    }
    
    return program_new(statements, p.filename)
}

task parse_file(path: string) -> Program {
    set source = file_read_all(path)
    check str_len(source) == 0 {
        eprintln("Error: could not read file")
        return program_new(vecstmt_new(), path)
    }
    set tokens = tokenize_file(path)
    set parser = parser_new(tokens, path)
    return parser_parse(parser)
}
