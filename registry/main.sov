/// Sovereign Package Registry Server
/// Runs on port 8080
/// API:
///   GET  /api/package/:name     — package info JSON
///   GET  /api/search?q=query    — search results
///   POST /api/publish           — upload package (requires API key)
///   GET  /packages/:name.sov    — download package file
///   GET  /                      — web UI

// TCP server via C socket API
extern task socket(int, int, int) -> int
extern task bind(int, ptr, int) -> int
extern task listen(int, int) -> int
extern task accept(int, ptr, ptr) -> int
extern task recv(int, ptr, int, int) -> int
extern task send(int, ptr, int, int) -> int
extern task close(int) -> void
extern task htons(int) -> int
extern task memset(ptr, int, int) -> ptr

// String ops
extern task strcmp(string, string) -> int
extern task strncmp(string, string, int) -> int
extern task strlen(string) -> int
extern task strstr(string, string) -> ptr
extern task sprintf(ptr, string) -> int
extern task atoi(string) -> int

// File ops
extern task fopen(string, string) -> ptr
extern task fclose(ptr) -> int
extern task fread(ptr, int, int, ptr) -> int
extern task fwrite(ptr, int, int, ptr) -> int

// Stdlib
extern task malloc(int) -> ptr
extern task free(ptr) -> void
extern task puts(string) -> int
extern task printf(string) -> int
extern task exit(int) -> void

const PORT = 8080
const BACKLOG = 128
const BUF_SIZE = 65536

task start_server() {
    // AF_INET=2, SOCK_STREAM=1, 0
    set server_fd = socket(2, 1, 0)
    check server_fd < 0 {
        puts("Failed to create socket")
        exit(1)
    }

    // sockaddr_in: family(2) + port(2) + addr(4) + padding(8) = 16 bytes
    set addr_buf = alloc(1, 16)
    memset(addr_buf, 0, 16)
    // This is simplified — full sockaddr_in setup needs override block
    override {
        // sin_family = AF_INET (2)
        // sin_port = htons(PORT)
        // sin_addr = INADDR_ANY (0)
        // Platform-specific struct layout handled here
    }

    check bind(server_fd, addr_buf, 16) < 0 {
        puts("Bind failed")
        exit(1)
    }
    check listen(server_fd, BACKLOG) < 0 {
        puts("Listen failed")
        exit(1)
    }

    print_fmt("Sovereign Registry listening on port %d\n", PORT)

    loop {
        set client_fd = accept(server_fd, null, null)
        check client_fd < 0 { continue }

        // Spawn a thread for each connection
        spawn {
            handle_connection(client_fd)
        }
    }
}

task handle_connection(fd: int) {
    set buf = alloc(1, BUF_SIZE)
    set bytes = recv(fd, buf, BUF_SIZE, 0)
    check bytes <= 0 {
        close(fd)
        free(buf)
        return
    }

    // Parse HTTP method and path (simplified)
    // Real implementation would parse the full HTTP/1.1 request
    route_request(fd, buf)

    close(fd)
    free(buf)
}

task route_request(fd: int, request: ptr) {
    // Respond with JSON for API endpoints
    // Full routing would parse GET/POST and path
    // This is the structure — a real implementation uses the string ops

    set response = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{\"status\":\"ok\"}"
    send(fd, response, strlen(response), 0)
}

// ── Package database (file-based) ─────────────────────────────────────────
// In production: PostgreSQL via libpq
// For registry MVP: JSON files in ./packages/ directory

task get_package_info(name: string) -> string {
    set path_buf = alloc(1, 256)
    sprintf(path_buf, "./packages/{name}.json")
    set f = fopen(path_buf, "r")
    check f == null {
        free(path_buf)
        return "{\"error\":\"not found\"}"
    }
    set content = alloc(1, 4096)
    fread(content, 1, 4096, f)
    fclose(f)
    free(path_buf)
    return content
}

// Entry point
start_server()